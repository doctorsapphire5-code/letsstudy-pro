<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Leadership Skills</title>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

  <style>
    :root {
      --primary: #7c3aed;
      --primary-dark: #6d28d9;
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --success: #16a34a;
      --shadow: 0 10px 30px rgba(15, 23, 42, .08);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    button,
    input,
    select {
      font: inherit;
    }

    .container {
      width: min(1150px, 92%);
      margin: auto;
    }

    /* =========================================
       HERO
    ========================================= */

    header {
      padding: 70px 0;
      color: #fff;
      background:
        linear-gradient(
          135deg,
          #1e1b4b,
          #7c3aed,
          #c026d3
        );
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      margin-bottom: 18px;
      border-radius: 30px;
      background: rgba(255,255,255,.13);
      border: 1px solid rgba(255,255,255,.2);
      font-size: .85rem;
      font-weight: 700;
    }

    header h1 {
      margin: 0 0 15px;
      font-size: clamp(2.3rem, 6vw, 4rem);
    }

    header p {
      max-width: 780px;
      margin: 0;
      color: #f3e8ff;
      line-height: 1.75;
    }

    /* =========================================
       MAIN
    ========================================= */

    main {
      padding: 40px 0;
    }

    /* =========================================
       FILTERS
    ========================================= */

    .filters {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 15px;
      padding: 20px;
      margin-bottom: 25px;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: var(--shadow);
    }

    .filter-group label {
      display: block;
      margin-bottom: 8px;
      font-size: .9rem;
      font-weight: 700;
    }

    .input-wrap {
      position: relative;
    }

    .input-wrap i {
      position: absolute;
      top: 50%;
      left: 14px;
      transform: translateY(-50%);
      color: var(--muted);
    }

    input,
    select {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--border);
      border-radius: 9px;
      outline: none;
      background: #fff;
      color: var(--text);
    }

    .input-wrap input {
      padding-left: 40px;
    }

    input:focus,
    select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(124, 58, 237, .1);
    }

    /* =========================================
       RESULT BAR
    ========================================= */

    .result-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 20px;
    }

    .result-count {
      color: var(--muted);
    }

    .result-count strong {
      color: var(--text);
    }

    .result-bar select {
      width: auto;
      min-width: 190px;
    }

    /* =========================================
       SKILLS GRID
    ========================================= */

    .skills-grid {
      display: grid;
      grid-template-columns:
        repeat(auto-fit, minmax(280px, 1fr));
      gap: 22px;
    }

    .skill-card {
      overflow: hidden;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: var(--shadow);
      transition:
        transform .25s ease,
        box-shadow .25s ease;
    }

    .skill-card:hover {
      transform: translateY(-6px);
      box-shadow:
        0 16px 40px rgba(15, 23, 42, .13);
    }

    .skill-cover {
      height: 175px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 4rem;
    }

    .cover-fundamentals {
      background: linear-gradient(135deg,#312e81,#7c3aed);
    }

    .cover-strategy {
      background: linear-gradient(135deg,#0369a1,#1e3a8a);
    }

    .cover-decision {
      background: linear-gradient(135deg,#ea580c,#9a3412);
    }

    .cover-team {
      background: linear-gradient(135deg,#059669,#065f46);
    }

    .cover-motivation {
      background: linear-gradient(135deg,#db2777,#831843);
    }

    .cover-conflict {
      background: linear-gradient(135deg,#dc2626,#7f1d1d);
    }

    .cover-delegation {
      background: linear-gradient(135deg,#0891b2,#164e63);
    }

    .cover-executive {
      background: linear-gradient(135deg,#475569,#0f172a);
    }

    .skill-content {
      padding: 20px;
    }

    .skill-content h3 {
      margin: 10px 0;
      line-height: 1.35;
    }

    .skill-content p {
      min-height: 76px;
      margin: 0 0 15px;
      color: var(--muted);
      line-height: 1.6;
    }

    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-bottom: 12px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 10px;
      border-radius: 20px;
      background: #f5f3ff;
      color: #6d28d9;
      font-size: .77rem;
      font-weight: 700;
    }

    .btn {
      width: 100%;
      padding: 12px 16px;
      border: 0;
      border-radius: 9px;
      cursor: pointer;
      font-weight: 700;
    }

    .btn-primary {
      color: #fff;
      background: var(--primary);
    }

    .btn-primary:hover {
      background: var(--primary-dark);
    }

    /* =========================================
       EMPTY
    ========================================= */

    .empty {
      grid-column: 1 / -1;
      padding: 60px 20px;
      text-align: center;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 16px;
      color: var(--muted);
    }

    .empty i {
      margin-bottom: 15px;
      font-size: 3rem;
    }

    .empty h2 {
      color: var(--text);
    }

    /* =========================================
       MODAL
    ========================================= */

    .modal {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(15,23,42,.75);
    }

    .modal.active {
      display: flex;
    }

    .modal-box {
      position: relative;
      width: min(700px, 100%);
      max-height: 90vh;
      overflow-y: auto;
      padding: 28px;
      border-radius: 18px;
      background: #fff;
    }

    .close {
      position: absolute;
      top: 12px;
      right: 16px;
      border: 0;
      background: transparent;
      color: var(--muted);
      font-size: 30px;
      cursor: pointer;
    }

    .modal-box p {
      color: var(--muted);
      line-height: 1.7;
    }

    .modal-box li {
      margin: 10px 0;
      color: var(--muted);
      line-height: 1.5;
    }

    .learning-box {
      margin-top: 20px;
      padding: 16px;
      border-radius: 12px;
      background: #f5f3ff;
      color: #5b21b6;
    }

    footer {
      padding: 35px 20px;
      text-align: center;
      color: var(--muted);
    }

    @media (max-width: 750px) {
      .filters {
        grid-template-columns: 1fr;
      }

      .result-bar {
        flex-direction: column;
        align-items: stretch;
      }

      .result-bar select {
        width: 100%;
      }

      .skill-content p {
        min-height: auto;
      }

      header {
        padding: 55px 0;
      }
    }
  </style>
</head>

<body>

<header>

  <div class="container">

    <div class="eyebrow">
      <i class="fa-solid fa-crown"></i>
      Career Skills
    </div>

    <h1>
      Leadership Skills
    </h1>

    <p>
      Build the skills needed to lead people, make confident
      decisions, manage teams, resolve conflicts, delegate
      effectively, and create a positive professional environment.
    </p>

  </div>

</header>


<main class="container">

  <!-- =========================================
       FILTERS
  ========================================= -->

  <section class="filters">

    <div class="filter-group">

      <label for="search">
        Search Skills
      </label>

      <div class="input-wrap">

        <i class="fa-solid fa-magnifying-glass"></i>

        <input
          type="search"
          id="search"
          placeholder="Search leadership skills..."
        >

      </div>

    </div>


    <div class="filter-group">

      <label for="level">
        Level
      </label>

      <select id="level">

        <option value="all">
          All Levels
        </option>

        <option value="Beginner">
          Beginner
        </option>

        <option value="Intermediate">
          Intermediate
        </option>

        <option value="Advanced">
          Advanced
        </option>

      </select>

    </div>


    <div class="filter-group">

      <label for="category">
        Category
      </label>

      <select id="category">

        <option value="all">
          All Categories
        </option>

        <option value="Leadership">
          Leadership
        </option>

        <option value="Strategy">
          Strategy
        </option>

        <option value="Decision Making">
          Decision Making
        </option>

        <option value="Team Leadership">
          Team Leadership
        </option>

        <option value="Motivation">
          Motivation
        </option>

        <option value="Conflict Management">
          Conflict Management
        </option>

        <option value="Delegation">
          Delegation
        </option>

        <option value="Executive Leadership">
          Executive Leadership
        </option>

      </select>

    </div>

  </section>


  <!-- =========================================
       RESULTS
  ========================================= -->

  <div class="result-bar">

    <div class="result-count">

      Showing
      <strong id="resultCount">0</strong>
      leadership skills

    </div>


    <select id="sort">

      <option value="popularity">
        Most Popular
      </option>

      <option value="az">
        A-Z
      </option>

      <option value="level">
        Level
      </option>

    </select>

  </div>


  <!-- =========================================
       SKILLS
  ========================================= -->

  <section
    class="skills-grid"
    id="skillsGrid"
  ></section>

</main>


<!-- =========================================
     MODAL
========================================= -->

<div
  class="modal"
  id="detailsModal"
  aria-hidden="true"
>

  <div class="modal-box">

    <button
      type="button"
      class="close"
      id="closeModal"
      aria-label="Close"
    >
      &times;
    </button>

    <div id="modalContent"></div>

  </div>

</div>


<footer>

  <p>
    © 2026 Leadership Skills Platform
  </p>

</footer>


<script>

  /* =========================================
     LEADERSHIP SKILLS DATA
  ========================================= */

  const leadershipSkills = [

    {
      id: 1,
      title: "Leadership Fundamentals",
      category: "Leadership",
      level: "Beginner",
      duration: "4 weeks",
      popularity: 100,
      icon: "fa-solid fa-crown",
      cover: "fundamentals",
      description:
        "Learn the foundations of effective leadership, responsibility, integrity, influence, and professional leadership behavior.",
      skills: [
        "Leadership principles",
        "Self-awareness",
        "Integrity",
        "Leadership mindset",
        "Building trust"
      ]
    },


    {
      id: 2,
      title: "Strategic Leadership",
      category: "Strategy",
      level: "Advanced",
      duration: "8 weeks",
      popularity: 97,
      icon: "fa-solid fa-chess",
      cover: "strategy",
      description:
        "Learn how leaders create vision, set priorities, manage resources, and guide organizations toward long-term goals.",
      skills: [
        "Strategic thinking",
        "Vision setting",
        "Goal planning",
        "Resource management",
        "Long-term planning"
      ]
    },


    {
      id: 3,
      title: "Decision Making",
      category: "Decision Making",
      level: "Intermediate",
      duration: "5 weeks",
      popularity: 96,
      icon: "fa-solid fa-scale-balanced",
      cover: "decision",
      description:
        "Develop structured decision-making skills for solving problems and making confident choices under pressure.",
      skills: [
        "Problem solving",
        "Risk assessment",
        "Critical thinking",
        "Decision frameworks",
        "Managing uncertainty"
      ]
    },


    {
      id: 4,
      title: "Team Leadership",
      category: "Team Leadership",
      level: "Intermediate",
      duration: "6 weeks",
      popularity: 99,
      icon: "fa-solid fa-people-group",
      cover: "team",
      description:
        "Learn how to build high-performing teams through collaboration, communication, accountability, and trust.",
      skills: [
        "Team building",
        "Collaboration",
        "Team communication",
        "Accountability",
        "Performance management"
      ]
    },


    {
      id: 5,
      title: "Motivating Others",
      category: "Motivation",
      level: "Intermediate",
      duration: "5 weeks",
      popularity: 94,
      icon: "fa-solid fa-bolt",
      cover: "motivation",
      description:
        "Learn practical ways to motivate individuals and teams while creating an environment where people can perform at their best.",
      skills: [
        "Employee motivation",
        "Recognition",
        "Goal alignment",
        "Positive leadership",
        "Employee engagement"
      ]
    },


    {
      id: 6,
      title: "Conflict Management",
      category: "Conflict Management",
      level: "Advanced",
      duration: "6 weeks",
      popularity: 93,
      icon: "fa-solid fa-handshake",
      cover: "conflict",
      description:
        "Develop the ability to handle disagreements constructively and turn workplace conflict into productive conversations.",
      skills: [
        "Conflict identification",
        "Mediation",
        "Difficult conversations",
        "Negotiation",
        "Resolution strategies"
      ]
    },


    {
      id: 7,
      title: "Delegation & Empowerment",
      category: "Delegation",
      level: "Intermediate",
      duration: "4 weeks",
      popularity: 91,
      icon: "fa-solid fa-arrows-turn-to-dots",
      cover: "delegation",
      description:
        "Learn how to delegate responsibilities effectively, develop team members, and empower others to take ownership.",
      skills: [
        "Task delegation",
        "Setting expectations",
        "Trust building",
        "Coaching",
        "Empowering employees"
      ]
    },


    {
      id: 8,
      title: "Executive Leadership",
      category: "Executive Leadership",
      level: "Advanced",
      duration: "10 weeks",
      popularity: 89,
      icon: "fa-solid fa-briefcase",
      cover: "executive",
      description:
        "Develop advanced leadership capabilities for senior roles, organizational change, stakeholder management, and executive communication.",
      skills: [
        "Executive communication",
        "Organizational leadership",
        "Change management",
        "Stakeholder management",
        "Leadership influence"
      ]
    }

  ];


  /* =========================================
     DOM ELEMENTS
  ========================================= */

  const skillsGrid =
    document.getElementById("skillsGrid");

  const searchInput =
    document.getElementById("search");

  const levelSelect =
    document.getElementById("level");

  const categorySelect =
    document.getElementById("category");

  const sortSelect =
    document.getElementById("sort");

  const resultCount =
    document.getElementById("resultCount");

  const modal =
    document.getElementById("detailsModal");

  const modalContent =
    document.getElementById("modalContent");

  const closeModal =
    document.getElementById("closeModal");


  /* =========================================
     ESCAPE HTML
  ========================================= */

  function escapeHTML(value) {

    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

  }


  /* =========================================
     RENDER SKILLS
  ========================================= */

  function renderSkills(list) {

    if (!list.length) {

      skillsGrid.innerHTML = `

        <div class="empty">

          <i class="fa-solid fa-crown"></i>

          <h2>
            No leadership skills found
          </h2>

          <p>
            Try another search term or change your filters.
          </p>

        </div>

      `;

      resultCount.textContent = "0";

      return;

    }


    skillsGrid.innerHTML =
      list.map(skill => `

        <article class="skill-card">

          <div
            class="skill-cover cover-${skill.cover}"
          >

            <i class="${skill.icon}"></i>

          </div>


          <div class="skill-content">

            <div class="meta">

              <span class="badge">
                ${escapeHTML(skill.level)}
              </span>

              <span class="badge">
                ${escapeHTML(skill.category)}
              </span>

            </div>


            <h3>
              ${escapeHTML(skill.title)}
            </h3>


            <p>
              ${escapeHTML(skill.description)}
            </p>


            <div class="meta">

              <span class="badge">

                <i class="fa-regular fa-clock"></i>

                ${escapeHTML(skill.duration)}

              </span>


              <span class="badge">

                <i class="fa-solid fa-fire"></i>

                ${skill.popularity}%

              </span>

            </div>


            <button
              type="button"
              class="btn btn-primary"
              onclick="showDetails(${skill.id})"
            >
              View Details
            </button>

          </div>

        </article>

      `).join("");


    resultCount.textContent =
      list.length;

  }


  /* =========================================
     FILTER SKILLS
  ========================================= */

  function filterSkills() {

    const search =
      searchInput.value
        .trim()
        .toLowerCase();

    const level =
      levelSelect.value;

    const category =
      categorySelect.value;


    let filtered =
      leadershipSkills.filter(skill => {

        const searchableText = [

          skill.title,
          skill.category,
          skill.level,
          skill.description,
          skill.duration,
          ...skill.skills

        ]
          .join(" ")
          .toLowerCase();


        const matchesSearch =
          !search ||
          searchableText.includes(search);


        const matchesLevel =
          level === "all" ||
          skill.level === level;


        const matchesCategory =
          category === "all" ||
          skill.category === category;


        return (
          matchesSearch &&
          matchesLevel &&
          matchesCategory
        );

      });


    if (sortSelect.value === "az") {

      filtered.sort(
        (a, b) =>
          a.title.localeCompare(b.title)
      );

    }

    else if (sortSelect.value === "level") {

  const levelOrder = {
    Beginner: 1,
    Intermediate: 2,
    Advanced: 3
  };

  filtered.sort(
    (a, b) =>
      levelOrder[a.level] -
      levelOrder[b.level]
  );

} else {

  filtered.sort(
    (a, b) =>
      b.popularity -
      a.popularity
  );

}


renderSkills(filtered);

}


/* =========================================
   SHOW DETAILS
========================================= */

function showDetails(id) {

  const skill =
    leadershipSkills.find(
      item => item.id === id
    );

  if (!skill) {
    return;
  }


  modalContent.innerHTML = `

    <div
      class="skill-cover cover-${skill.cover}"
      style="
        border-radius:12px;
        margin-bottom:20px;
      "
    >

      <i class="${skill.icon}"></i>

    </div>


    <span class="badge">
      ${escapeHTML(skill.category)}
    </span>


    <h2>
      ${escapeHTML(skill.title)}
    </h2>


    <p>
      ${escapeHTML(skill.description)}
    </p>


    <p>
      <strong>Level:</strong>
      ${escapeHTML(skill.level)}
    </p>


    <p>
      <strong>Duration:</strong>
      ${escapeHTML(skill.duration)}
    </p>


    <h3>
      Key Skills
    </h3>


    <ul>

      ${skill.skills.map(item => `

        <li>

          <i class="fa-solid fa-check"></i>

          ${escapeHTML(item)}

        </li>

      `).join("")}

    </ul>


    <button
      type="button"
      class="btn btn-primary"
      onclick="startLearning(${skill.id})"
    >
      Start Learning
    </button>

  `;


  modal.classList.add("active");

  modal.setAttribute(
    "aria-hidden",
    "false"
  );

  document.body.style.overflow =
    "hidden";

}


/* =========================================
   START LEARNING
========================================= */

function startLearning(id) {

  const skill =
    leadershipSkills.find(
      item => item.id === id
    );

  if (!skill) {
    return;
  }


  modalContent.innerHTML = `

    <div
      class="skill-cover cover-${skill.cover}"
      style="
        border-radius:12px;
        margin-bottom:20px;
      "
    >

      <i class="${skill.icon}"></i>

    </div>


    <span class="badge">
      ${escapeHTML(skill.category)}
    </span>


    <h2>
      Start Learning:
      ${escapeHTML(skill.title)}
    </h2>


    <p>
      Follow this learning path to develop
      practical leadership skills.
    </p>


    <h3>
      Learning Path
    </h3>


    <ol>

      ${skill.skills.map((item, index) => `

        <li>

          <strong>
            Step ${index + 1}:
          </strong>

          ${escapeHTML(item)}

        </li>

      `).join("")}

    </ol>


    <div class="learning-box">

      <strong>
        Recommended Level:
      </strong>

      ${escapeHTML(skill.level)}

      <br><br>

      <strong>
        Estimated Duration:
      </strong>

      ${escapeHTML(skill.duration)}

    </div>


    <button
      type="button"
      class="btn btn-primary"
      style="margin-top:20px;"
      onclick="completeLearning(${skill.id})"
    >

      <i class="fa-solid fa-play"></i>

      Begin Course

    </button>

  `;

}


/* =========================================
   COURSE READY
========================================= */

function completeLearning(id) {

  const skill =
    leadershipSkills.find(
      item => item.id === id
    );

  if (!skill) {
    return;
  }


  modalContent.innerHTML = `

    <div
      style="
        text-align:center;
        padding:20px 0;
      "
    >

      <div
        style="
          width:80px;
          height:80px;
          margin:0 auto 20px;
          display:flex;
          align-items:center;
          justify-content:center;
          border-radius:50%;
          background:#dcfce7;
          color:#16a34a;
          font-size:2rem;
        "
      >

        <i class="fa-solid fa-check"></i>

      </div>


      <h2>
        Course Ready!
      </h2>


      <p>
        You are ready to begin
        <strong>
          ${escapeHTML(skill.title)}
        </strong>.
      </p>


      <button
        type="button"
        class="btn btn-primary"
        onclick="closeDetails()"
      >
        Continue
      </button>

    </div>

  `;

}


/* =========================================
   CLOSE MODAL
========================================= */

function closeDetails() {

  modal.classList.remove("active");

  modal.setAttribute(
    "aria-hidden",
    "true"
  );

  document.body.style.overflow = "";

}


closeModal.addEventListener(
  "click",
  closeDetails
);


modal.addEventListener(
  "click",
  function(event) {

    if (event.target === modal) {
      closeDetails();
    }

  }
);


/* =========================================
   ESC KEY
========================================= */

document.addEventListener(
  "keydown",
  function(event) {

    if (event.key === "Escape") {
      closeDetails();
    }

  }
);


/* =========================================
   EVENTS
========================================= */

searchInput.addEventListener(
  "input",
  filterSkills
);

levelSelect.addEventListener(
  "change",
  filterSkills
);

categorySelect.addEventListener(
  "change",
  filterSkills
);

sortSelect.addEventListener(
  "change",
  filterSkills
);


/* =========================================
   KEYBOARD SEARCH
========================================= */

document.addEventListener(
  "keydown",
  function(event) {

    if (
      event.key === "/" &&
      document.activeElement.tagName !== "INPUT" &&
      document.activeElement.tagName !== "SELECT" &&
      !modal.classList.contains("active")
    ) {

      event.preventDefault();

      searchInput.focus();

    }

  }
);


/* =========================================
   RESET FILTERS
========================================= */

function resetFilters() {

  searchInput.value = "";
  levelSelect.value = "all";
  categorySelect.value = "all";
  sortSelect.value = "popularity";

  filterSkills();

}


/* =========================================
   INITIAL LOAD
========================================= */

renderSkills(
  [...leadershipSkills].sort(
    (a, b) =>
      b.popularity -
      a.popularity
  )
);

</script>

</body>
</html>