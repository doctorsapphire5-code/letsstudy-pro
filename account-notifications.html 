<script type="module">

import {
  initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";


import {
  getAuth,
  onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-auth.js";


import {
  getDatabase,
  ref,
  get,
  update
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-database.js";


/* =========================
   FIREBASE CONFIG
========================= */

const firebaseConfig = {

  apiKey:
  "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
  "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
  "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
  "let-s-study-pro-course",

  storageBucket:
  "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
  "474928293390",

  appId:
  "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
  "G-85B7V5H5J0"

};


const app =
initializeApp(
  firebaseConfig
);

const auth =
getAuth(app);

const db =
getDatabase(app);


/* =========================
   ELEMENTS
========================= */

const loginCard =
document.getElementById(
  "loginCard"
);

const mainContent =
document.getElementById(
  "mainContent"
);

const message =
document.getElementById(
  "message"
);

const saveBtn =
document.getElementById(
  "saveBtn"
);

const resetBtn =
document.getElementById(
  "resetBtn"
);


/* =========================
   DEFAULT SETTINGS
========================= */

const defaults = {

  accountNotifications:
  true,

  systemNotifications:
  true,

  courseNotifications:
  true,

  quizNotifications:
  true,

  progressNotifications:
  true,

  newCourseNotifications:
  true,

  offerNotifications:
  false

};


/* =========================
   INPUTS
========================= */

const notificationInputs = {

  accountNotifications:
  document.getElementById(
    "accountNotifications"
  ),

  systemNotifications:
  document.getElementById(
    "systemNotifications"
  ),

  courseNotifications:
  document.getElementById(
    "courseNotifications"
  ),

  quizNotifications:
  document.getElementById(
    "quizNotifications"
  ),

  progressNotifications:
  document.getElementById(
    "progressNotifications"
  ),

  newCourseNotifications:
  document.getElementById(
    "newCourseNotifications"
  ),

  offerNotifications:
  document.getElementById(
    "offerNotifications"
  )

};


/* =========================
   MESSAGE
========================= */

function showMessage(
text,
type
){

  message.textContent =
  text;

  message.className =
  "message " +
  type;

}


/* =========================
   APPLY SETTINGS
========================= */

function applySettings(
settings
){

  Object.keys(
    notificationInputs
  )
  .forEach(
    key => {

      notificationInputs[key]
      .checked =
      settings[key] === true;

    }
  );

}


/* =========================
   GET SETTINGS
========================= */

function getSettings(){

  const settings = {};


  Object.keys(
    notificationInputs
  )
  .forEach(
    key => {

      settings[key] =
      notificationInputs[key]
      .checked;

    }
  );


  return settings;

}


/* =========================
   LOAD SETTINGS
========================= */

async function loadSettings(
user
){

  try{

    const snapshot =
    await get(
      ref(
        db,
        "users/" +
        user.uid +
        "/notifications"
      )
    );


    if(
      snapshot.exists()
    ){

      const data =
      snapshot.val();


      applySettings({

        ...defaults,

        ...data

      });

    }else{

      applySettings(
        defaults
      );

    }


  }catch(error){

    console.error(
      "Notification load error:",
      error
    );


    applySettings(
      defaults
    );


    showMessage(
      "Unable to load notification preferences.",
      "error"
    );

  }

}


/* =========================
   AUTH
========================= */

onAuthStateChanged(
  auth,
  async user => {

    if(!user){

      loginCard.style.display =
      "block";

      mainContent.style.display =
      "none";

      return;

    }


    loginCard.style.display =
    "none";

    mainContent.style.display =
    "block";


    await loadSettings(
      user
    );

  }
);


/* =========================
   SAVE
========================= */

saveBtn.addEventListener(
  "click",
  async () => {

    const user =
    auth.currentUser;


    if(!user){

      window.location.href =
      "/login.html";

      return;

    }


    try{

      saveBtn.disabled =
      true;

      saveBtn.textContent =
      "Saving...";


      const settings =
      getSettings();


      settings.updatedAt =
      Date.now();


      await update(
        ref(
          db,
          "users/" +
          user.uid +
          "/notifications"
        ),
        settings
      );


      showMessage(
        "Notification preferences saved successfully.",
        "success"
      );


    }catch(error){

      console.error(
        "Notification save error:",
        error
      );


      showMessage(
        "Unable to save notification preferences. Please try again.",
        "error"
      );


    }finally{

      saveBtn.disabled =
      false;

      saveBtn.textContent =
      "Save Preferences";

    }

  }
);


/* =========================
   RESET
========================= */

resetBtn.addEventListener(
  "click",
  () => {

    applySettings(
      defaults
    );


    showMessage(
      "Default notification settings restored. Click Save Preferences to apply them.",
      "info"
    );

  }
);


/* =========================
   MOBILE MENU
========================= */

document
.getElementById(
  "menuBtn"
)
.addEventListener(
  "click",
  () => {

    document
    .querySelector(
      ".nav-links"
    )
    .classList.toggle(
      "active"
    );

  }
);

</script>

</body>

