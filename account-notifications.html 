<!-- =====================================================
     FIREBASE
===================================================== -->

<script type="module">

import {
  initializeApp
}
from
"https://www.gstatic.com/firebasejs/11.0.2/firebase-app.js";


import {
  getFirestore,
  doc,
  getDoc,
  setDoc,
  serverTimestamp
}
from
"https://www.gstatic.com/firebasejs/11.0.2/firebase-firestore.js";


/* =====================================================
   FIREBASE CONFIG
===================================================== */

const firebaseConfig = {

  apiKey:
    "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-85B7V5H5J0"

};


const app =
  initializeApp(
    firebaseConfig
  );


const db =
  getFirestore(
    app
  );


/* =====================================================
   PREFERENCE IDS
===================================================== */

const preferenceIds = [

  "securityAlerts",

  "loginAlerts",

  "passwordChanges",

  "emailChanges",

  "profileUpdates",

  "verificationAlerts",

  "accountActivity"

];


/* =====================================================
   LOAD DEFAULT PREFERENCES
===================================================== */

async function loadPreferences(){

  try{

    const reference =
      doc(
        db,
        "accountNotificationPreferences",
        "default"
      );


    const snapshot =
      await getDoc(
        reference
      );


    if(
      !snapshot.exists()
    ){

      return;

    }


    const data =
      snapshot.data();


    preferenceIds.forEach(
      id => {

        if(
          typeof data[id] ===
          "boolean"
        ){

          document.getElementById(
            id
          ).checked =
            data[id];

        }

      }
    );

  }

  catch(error){

    console.error(
      "Unable to load preferences:",
      error
    );

  }

}


/* =====================================================
   SAVE
===================================================== */

document
  .getElementById(
    "saveBtn"
  )
  .addEventListener(
    "click",
    async () => {

      const button =
        document.getElementById(
          "saveBtn"
        );


      button.disabled =
  true;

button.textContent =
  "Saving...";


try{

  const preferences = {

    securityAlerts:
      document.getElementById(
        "securityAlerts"
      ).checked,

    loginAlerts:
      document.getElementById(
        "loginAlerts"
      ).checked,

    passwordChanges:
      document.getElementById(
        "passwordChanges"
      ).checked,

    emailChanges:
      document.getElementById(
        "emailChanges"
      ).checked,

    profileUpdates:
      document.getElementById(
        "profileUpdates"
      ).checked,

    verificationAlerts:
      document.getElementById(
        "verificationAlerts"
      ).checked,

    accountActivity:
      document.getElementById(
        "accountActivity"
      ).checked,

    updatedAt:
      serverTimestamp()

  };


  await setDoc(

    doc(
      db,
      "accountNotificationPreferences",
      "default"
    ),

    preferences,

    {
      merge:true
    }

  );


  showToast(
    "Notification preferences saved successfully.",
    "success"
  );

}

catch(error){

  console.error(
    "Save preferences error:",
    error
  );


  showToast(
    error.message ||
    "Unable to save notification preferences.",
    "error"
  );

}

finally{

  button.disabled =
    false;

  button.textContent =
    "Save Notification Preferences";

}

});


/* =====================================================
   TOAST
===================================================== */

function showToast(
  message,
  type = "success"
){

  const toast =
    document.getElementById(
      "toast"
    );


  toast.textContent =
    message;


  toast.className =
    "toast show " +
    type;


  setTimeout(
    () => {

      toast.className =
        "toast";

    },
    3000
  );

}


/* =====================================================
   MOBILE MENU
===================================================== */

document
  .getElementById(
    "menuBtn"
  )
  .addEventListener(
    "click",
    () => {

      document
        .getElementById(
          "nav"
        )
        .classList.toggle(
          "open"
        );

    }
  );


/* =====================================================
   CLOSE MOBILE MENU AFTER LINK CLICK
===================================================== */

document
  .querySelectorAll(
    "#nav a"
  )
  .forEach(
    link => {

      link.addEventListener(
        "click",
        () => {

          document
            .getElementById(
              "nav"
            )
            .classList.remove(
              "open"
            );

        }
      );

    }
  );


/* =====================================================
   INITIALIZE PAGE
===================================================== */

loadPreferences();

</script>

