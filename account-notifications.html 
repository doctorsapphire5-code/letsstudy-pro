<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Account Notifications | LetsStudy Pro</title><style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,Helvetica,sans-serif;
  background:#f5f7fb;
  color:#172033
}
header{
  height:62px;
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  display:flex;
  align-items:center;
  gap:12px;
  padding:0 16px;
  position:sticky;
  top:0;
  z-index:20
}
header h1{
  flex:1;
  margin:0;
  font-size:18px
}
main{
  max-width:850px;
  margin:auto;
  padding:18px
}
button{
  border:0;
  border-radius:9px;
  padding:9px 12px;
  cursor:pointer
}
.back{
  background:#eef2ff;
  color:#1d4ed8
}
.primary{
  background:#2563eb;
  color:#fff
}
.card{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:15px;
  overflow:hidden
}
.tabs{
  display:flex;
  gap:7px;
  padding:12px;
  overflow:auto;
  border-bottom:1px solid #edf0f4
}
.tab{
  background:#f1f5f9;
  color:#475569;
  white-space:nowrap
}
.tab.active{
  background:#2563eb;
  color:#fff
}
.notification{
  display:flex;
  gap:12px;
  padding:15px;
  border-bottom:1px solid #edf0f4;
  cursor:pointer;
  transition:.2s
}
.notification:hover{
  background:#f8fafc
}
.notification.unread{
  background:#eff6ff
}
.icon{
  width:42px;
  height:42px;
  min-width:42px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#eef2ff;
  font-size:19px
}
.content{
  flex:1;
  min-width:0
}
.title{
  font-size:14px;
  font-weight:bold;
  margin-bottom:4px
}
.message{
  color:#64748b;
  font-size:12px;
  line-height:1.5
}
.meta{
  color:#94a3b8;
  font-size:10px;
  margin-top:6px
}
.dot{
  width:8px;
  height:8px;
  border-radius:50%;
  background:#2563eb;
  margin-top:6px
}
.empty{
  text-align:center;
  padding:50px 20px;
  color:#64748b
}
.empty-icon{
  font-size:40px;
  margin-bottom:10px
}
.topbar{
  display:flex;
  align-items:center;
  gap:10px;
  padding:15px;
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:15px;
  margin-bottom:14px
}
.topbar strong{
  flex:1
}
.badge{
  background:#ef4444;
  color:#fff;
  border-radius:20px;
  padding:3px 8px;
  font-size:10px
}
.modal{
  display:none;
  position:fixed;
  inset:0;
  background:#0008;
  align-items:center;
  justify-content:center;
  padding:15px;
  z-index:50
}
.modal.show{
  display:flex
}
.box{
  width:100%;
  max-width:520px;
  background:#fff;
  border-radius:16px;
  padding:20px
}
.box-head{
  display:flex;
  gap:10px;
  align-items:center;
  margin-bottom:15px
}
.box-head h2{
  flex:1;
  margin:0;
  font-size:18px
}
.box-message{
  color:#475569;
  line-height:1.6;
  font-size:14px;
  white-space:pre-wrap
}
.action{
  margin-top:18px
}
.toast{
  position:fixed;
  right:20px;
  bottom:20px;
  background:#172033;
  color:#fff;
  padding:12px 15px;
  border-radius:9px;
  display:none;
  z-index:100;
  font-size:12px
}
.toast.show{
  display:block
}
@media(max-width:600px){
  main{padding:10px}
  header{padding:0 10px}
}
</style></head><body><header><button class="back"
onclick="history.back()">
←
</button>

<h1>🔔 Notifications</h1><button class="back"
onclick="markAllRead()">
Mark all read
</button>

</header><main><div class="topbar"><strong>
Account Notifications
</strong><span
id="unreadBadge"
class="badge"
style="display:none">
0
</span>

</div><section class="card"><div class="tabs"><button
class="tab active"
data-filter="all"
onclick="setFilter('all',this)">
All
</button>

<button
class="tab"
data-filter="unread"
onclick="setFilter('unread',this)">
Unread
</button>

<button
class="tab"
data-filter="payment"
onclick="setFilter('payment',this)">
Payments
</button>

<button
class="tab"
data-filter="course"
onclick="setFilter('course',this)">
Courses
</button>

<button
class="tab"
data-filter="community"
onclick="setFilter('community',this)">
Community
</button>

<button
class="tab"
data-filter="security"
onclick="setFilter('security',this)">
Security
</button>

</div><div id="notificationList"><div class="empty">
Loading notifications...
</div></div></section></main><!-- NOTIFICATION VIEW --><div
id="modal"
class="modal"><div class="box"><div class="box-head"><h2 id="modalTitle">
Notification
</h2><button
class="back"
onclick="closeModal()">
✕
</button>

</div><div
id="modalMessage"
class="box-message">
</div><div
id="modalMeta"
class="meta">
</div><div
id="modalAction"
class="action">
</div></div></div><div id="toast" class="toast"></div><script type="module">

import{
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

import{
getAuth,
onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

import{
getFirestore,
collection,
query,
where,
orderBy,
getDocs,
doc,
updateDoc,
writeBatch
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


/* =========================================
 FIREBASE CONFIG
========================================= */

const firebaseConfig={

apiKey:"YOUR_API_KEY",

authDomain:
"YOUR_PROJECT.firebaseapp.com",

projectId:
"YOUR_PROJECT_ID",

storageBucket:
"YOUR_PROJECT.firebasestorage.app",

messagingSenderId:
"YOUR_MESSAGING_SENDER_ID",

appId:
"YOUR_APP_ID"

};


const app=initializeApp(firebaseConfig);
const auth=getAuth(app);
const db=getFirestore(app);

let currentUser=null;
let notifications=[];
let currentFilter="all";


/* =========================================
 AUTH
========================================= */

onAuthStateChanged(
auth,
async user=>{

if(!user){

location.href="login.html";
return;

}

currentUser=user;

loadNotifications();

});


/* =========================================
 LOAD USER NOTIFICATIONS
========================================= */

async function loadNotifications(){

try{

const q=query(

collection(db,"notifications"),

where(
"userId",
"==",
currentUser.uid
),

orderBy(
"createdAt",
"desc"
)

);

const snap=
await getDocs(q);

notifications=
snap.docs.map(
d=>({
id:d.id,
...d.data()
})
);

updateUnread();
render();

}catch(error){

console.error(error);

document.getElementById(
"notificationList"
).innerHTML=`

<div class="empty">

<div class="empty-icon">
⚠️
</div>

Unable to load notifications.

</div>

`;

}

}


/* =========================================
 UNREAD
========================================= */

function updateUnread(){

const count=
notifications.filter(
x=>x.read!==true
).length;

const badge=
document.getElementById(
"unreadBadge"
);

if(count>0){

badge.style.display="inline-block";
badge.textContent=count;

}else{

badge.style.display="none";

}

}


/* =========================================
 FILTER
========================================= */

window.setFilter=function(
filter,
button
){

currentFilter=filter;

document
.querySelectorAll(".tab")
.forEach(x=>
x.classList.remove("active")
);

button.classList.add("active");

render();

};


/* =========================================
 RENDER
========================================= */

function render(){

let data=[...notifications];

if(currentFilter==="unread"){

data=data.filter(
x=>x.read!==true
);

}else if(
currentFilter!=="all"
){

data=data.filter(
x=>
String(x.type||"general")
.toLowerCase()
===currentFilter
);

}


const container=
document.getElementById(
"notificationList"
);


if(!data.length){

container.innerHTML=`

<div class="empty">

<div class="empty-icon">
🔔
</div>

<strong>
You're all caught up
</strong>

<br>

No notifications here.

</div>

`;

return;

}


container.innerHTML=
data.map(x=>`

<div
class="notification ${
x.read===true?"":"unread"
}"
onclick="openNotification('${x.id}')">

<div class="icon">

${getIcon(x.type)}

</div>

<div class="content">

<div class="title">

${esc(x.title||"Notification")}

</div>

<div class="message">

${esc(
truncate(x.message||"",120)
)}

</div>

<div class="meta">

${esc(
x.type||"general"
)}
&nbsp; • &nbsp;
${formatDate(x.createdAt)}

</div>

</div>

${
x.read!==true
?'<div class="dot"></div>'
:""
}

</div>

`).join("");

}


/* =========================================
 OPEN
========================================= */

window.openNotification=
async function(id){

const item=
notifications.find(
x=>x.id===id
);

if(!item)return;


if(item.read!==true){

try{

await updateDoc(
doc(
db,
"notifications",
id
),
{
read:true,
readAt:
new Date()
}
);

item.read=true;

updateUnread();
render();

}catch(error){

console.error(error);

}

}


document.getElementById(
"modalTitle"
).textContent=
item.title||"Notification";

document.getElementById(
"modalMessage"
).textContent=
item.message||"";

document.getElementById(
"modalMeta"
).textContent=
`${item.type||"general"} • ${
formatDate(item.createdAt)
}`;


const action=
document.getElementById(
"modalAction"
);

if(item.actionUrl){

action.innerHTML=`

<button
class="primary"
onclick="location.href='${safeUrl(item.actionUrl)}'">

Open

</button>

`;

}else{

action.innerHTML="";

}


document.getElementById(
"modal"
).classList.add("show");

};


/* =========================================
 MARK ALL READ
========================================= */

window.markAllRead=
async function(){

const unread=
notifications.filter(
x=>x.read!==true
);

if(!unread.length){

toast(
"No unread notifications."
);

return;

}


try{

const batch=
writeBatch(db);

unread.forEach(x=>{

batch.update(
doc(
db,
"notifications",
x.id
),
{
read:true,
readAt:new Date()
}
);

});

await batch.commit();

notifications.forEach(
x=>x.read=true
);

updateUnread();
render();

toast(
"All notifications marked as read."
);

}catch(error){

console.error(error);

toast(
"Unable to update notifications."
);

}

};


/* =========================================
 MODAL
========================================= */

window.closeModal=function(){

document.getElementById(
"modal"
).classList.remove("show");

};


/* =========================================
 ICON
========================================= */

function getIcon(type){

switch(
String(type||"").toLowerCase()
){

case"payment":
return"💳";

case"course":
return"📚";

case"community":
return"👥";

case"security":
return"🔐";

case"promotion":
return"🎁";

case"account":
return"👤";

default:
return"🔔";

}

}


/* =========================================
 DATE
========================================= */

function formatDate(timestamp){

if(!timestamp)
return"";

try{

const date=
timestamp.toDate
?timestamp.toDate()
:new Date(timestamp);

return date.toLocaleString();

}catch{

return"";

}

}


/* =========================================
 HELPERS
========================================= */

function truncate(text,length){

return text.length>length
?text.substring(0,length)+"..."
:text;

}


function esc(value){

return String(value??"")
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}


function safeUrl(url){

return String(url)
.replace(/'/g,"%27")
.replace(/"/g,"%22");

}


function toast(text){

const el=
document.getElementById("toast");

el.textContent=text;

el.classList.add("show");

clearTimeout(
window.toastTimer
);

window.toastTimer=setTimeout(
()=>{
el.classList.remove("show");
},
3000
);

}

</script></body>
</html>