<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Notifications | LetsStudy Pro</title><style>

*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,Helvetica,sans-serif;
  background:#f5f7fb;
  color:#172033;
}

header{
  height:64px;
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  display:flex;
  align-items:center;
  gap:12px;
  padding:0 16px;
  position:sticky;
  top:0;
  z-index:20;
}

header h1{
  flex:1;
  margin:0;
  font-size:18px;
}

button{
  border:0;
  border-radius:9px;
  padding:10px 13px;
  cursor:pointer;
  font-weight:600;
}

.back{
  background:#eef2ff;
  color:#1d4ed8;
}

.primary{
  background:#2563eb;
  color:white;
}

main{
  width:100%;
  max-width:850px;
  margin:auto;
  padding:18px;
}

.topbar{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:15px;
  padding:15px;
  margin-bottom:14px;
  display:flex;
  align-items:center;
  gap:10px;
}

.topbar strong{
  flex:1;
  font-size:16px;
}

.badge{
  background:#ef4444;
  color:white;
  border-radius:20px;
  padding:4px 9px;
  font-size:10px;
  font-weight:bold;
}

.card{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:15px;
  overflow:hidden;
}

.tabs{
  display:flex;
  gap:7px;
  padding:12px;
  border-bottom:1px solid #edf0f4;
  overflow-x:auto;
}

.tab{
  background:#f1f5f9;
  color:#475569;
  white-space:nowrap;
}

.tab.active{
  background:#2563eb;
  color:#fff;
}

.notification{
  display:flex;
  gap:12px;
  padding:15px;
  border-bottom:1px solid #edf0f4;
  cursor:pointer;
  transition:.2s;
}

.notification:hover{
  background:#f8fafc;
}

.notification.unread{
  background:#eff6ff;
}

.icon{
  width:44px;
  height:44px;
  min-width:44px;
  border-radius:50%;
  background:#eef2ff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:20px;
}

.content{
  flex:1;
  min-width:0;
}

.title{
  font-size:14px;
  font-weight:bold;
  margin-bottom:5px;
}

.message{
  color:#64748b;
  font-size:12px;
  line-height:1.5;
}

.meta{
  color:#94a3b8;
  font-size:10px;
  margin-top:7px;
}

.dot{
  width:8px;
  height:8px;
  min-width:8px;
  border-radius:50%;
  background:#2563eb;
  margin-top:6px;
}

.empty{
  text-align:center;
  padding:55px 20px;
  color:#64748b;
}

.empty-icon{
  font-size:42px;
  margin-bottom:10px;
}

.error{
  color:#b91c1c;
}

.modal{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.55);
  align-items:center;
  justify-content:center;
  padding:15px;
  z-index:100;
}

.modal.show{
  display:flex;
}

.modal-box{
  width:100%;
  max-width:520px;
  background:#fff;
  border-radius:17px;
  padding:20px;
  max-height:90vh;
  overflow:auto;
}

.modal-head{
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:15px;
}

.modal-head h2{
  flex:1;
  margin:0;
  font-size:18px;
}

.modal-message{
  font-size:14px;
  color:#475569;
  line-height:1.7;
  white-space:pre-wrap;
}

.modal-meta{
  color:#94a3b8;
  font-size:11px;
  margin-top:15px;
}

.modal-action{
  margin-top:18px;
}

.toast{
  position:fixed;
  right:18px;
  bottom:18px;
  background:#172033;
  color:#fff;
  padding:12px 15px;
  border-radius:9px;
  display:none;
  z-index:200;
  font-size:12px;
}

.toast.show{
  display:block;
}

.loading{
  text-align:center;
  padding:45px;
  color:#64748b;
}

@media(max-width:600px){

  main{
    padding:10px;
  }

  header{
    padding:0 10px;
  }

  header h1{
    font-size:16px;
  }

  .notification{
    padding:13px;
  }

}

</style></head><body><header><button
class="back"
onclick="history.back()">
←
</button>

<h1>🔔 Notifications</h1><button
class="back"
onclick="markAllRead()">
Mark all
</button>

</header><main><div class="topbar"><strong>
Account Notifications
</strong><span
id="unreadBadge"
class="badge"
style="display:none">
0
</span>

</div><section class="card"><div class="tabs"><button
class="tab active"
onclick="setFilter('all',this)">
All
</button>

<button
class="tab"
onclick="setFilter('unread',this)">
Unread
</button>

<button
class="tab"
onclick="setFilter('payment',this)">
Payments
</button>

<button
class="tab"
onclick="setFilter('course',this)">
Courses
</button>

<button
class="tab"
onclick="setFilter('community',this)">
Community
</button>

<button
class="tab"
onclick="setFilter('security',this)">
Security
</button>

</div><div id="notificationList"><div class="loading">
Loading notifications...
</div></div></section></main><!-- VIEW NOTIFICATION --><div
id="modal"
class="modal"><div class="modal-box"><div class="modal-head"><h2 id="modalTitle">
Notification
</h2><button
class="back"
onclick="closeModal()">
✕
</button>

</div><div
id="modalMessage"
class="modal-message">
</div><div
id="modalMeta"
class="modal-meta">
</div><div
id="modalAction"
class="modal-action">
</div></div></div><div
id="toast"
class="toast">
</div><script type="module">


/* =========================================
 FIREBASE
========================================= */

import{
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";


import{
getAuth,
onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";


import{
getFirestore,
collection,
query,
where,
getDocs,
doc,
updateDoc,
writeBatch
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


/* =========================================
 YOUR FIREBASE CONFIG
========================================= */

const firebaseConfig={

apiKey:
"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:89eef78b2ccfbcf0a9fe5f",

measurementId:
"G-NCZNKYB3YB"

};


const app=
initializeApp(firebaseConfig);

const auth=
getAuth(app);

const db=
getFirestore(app);


/* =========================================
 VARIABLES
========================================= */

let currentUser=null;

let notifications=[];

let currentFilter="all";


/* =========================================
 AUTH
========================================= */

onAuthStateChanged(
auth,
async user=>{

if(!user){

location.href="login.html";

return;

}

currentUser=user;

await loadNotifications();

});


/* =========================================
 LOAD NOTIFICATIONS
========================================= */

async function loadNotifications(){

const container=
document.getElementById(
"notificationList"
);

container.innerHTML=`

<div class="loading">
Loading notifications...
</div>

`;


try{

/*
IMPORTANT:

No orderBy() here.
This avoids Firestore index errors.
*/

const q=query(

collection(
db,
"notifications"
),

where(
"userId",
"==",
currentUser.uid
)

);


const snap=
await getDocs(q);


notifications=
snap.docs.map(
item=>({

id:item.id,

...item.data()

})
);


/*
Sort locally instead of
Firestore orderBy()
*/

notifications.sort(
(a,b)=>{

const dateA=
getTime(a.createdAt);

const dateB=
getTime(b.createdAt);

return dateB-dateA;

}
);


updateUnread();

render();


}catch(error){

console.error(
"Notifications error:",
error
);


container.innerHTML=`

<div class="empty error">

<div class="empty-icon">
⚠️
</div>

<strong>
Unable to load notifications
</strong>

<br><br>

Please check your internet connection
or try again.

<br><br>

<button
class="primary"
onclick="loadNotifications()">

Try Again

</button>

</div>

`;

}

}


/* =========================================
 FILTER
========================================= */

window.setFilter=function(
filter,
button
){

currentFilter=filter;


document
.querySelectorAll(".tab")
.forEach(
tab=>
tab.classList.remove("active")
);


button.classList.add("active");


render();

};


/* =========================================
 RENDER
========================================= */

function render(){

let list=[
...notifications
];


if(
currentFilter==="unread"
){

list=list.filter(
item=>
item.read!==true
);

}


else if(
currentFilter!=="all"
){

list=list.filter(
item=>
String(
item.type||"general"
).toLowerCase()
===
currentFilter
);

}


const container=
document.getElementById(
"notificationList"
);


if(!list.length){

container.innerHTML=`

<div class="empty">

<div class="empty-icon">
🔔
</div>

<strong>
You're all caught up
</strong>

<br>

No notifications available.

</div>

`;

return;

}


container.innerHTML=
list.map(
item=>`

<div

class="notification ${
item.read===true
?""
:"unread"
}"

onclick=
"openNotification('${item.id}')"

>


<div class="icon">

${getIcon(item.type)}

</div>


<div class="content">


<div class="title">

${escapeHtml(
item.title||
"Notification"
)}

</div>


<div class="message">

${escapeHtml(
truncate(
item.message||"",
130
)
)}

</div>


<div class="meta">

${escapeHtml(
item.type||
"general"
)}

&nbsp; • &nbsp;

${formatDate(
item.createdAt
)}

</div>


</div>


${
item.read!==true
?
`<div class="dot"></div>`
:
""
}


</div>

`
).join("");

}


/* =========================================
 OPEN NOTIFICATION
========================================= */

window.openNotification=
async function(id){

const item=
notifications.find(
x=>x.id===id
);


if(!item)
return;


/*
Mark as read
*/

if(item.read!==true){

try{

await updateDoc(

doc(
db,
"notifications",
id
),

{

read:true,

readAt:
new Date()

}

);


item.read=true;

updateUnread();

render();


}catch(error){

console.error(
"Read update error:",
error
);

}

}


/*
Show modal
*/

document.getElementById(
"modalTitle"
).textContent=
item.title||
"Notification";


document.getElementById(
"modalMessage"
).textContent=
item.message||
"";


document.getElementById(
"modalMeta"
).textContent=
`${item.type||"general"} • ${
formatDate(item.createdAt)
}`;


/*
Action button
*/

const action=
document.getElementById(
"modalAction"
);


action.innerHTML="";


if(
item.actionUrl
){

const button=
document.createElement(
"button"
);

button.className=
"primary";

button.textContent=
"Open";

button.onclick=()=>{

window.location.href=
item.actionUrl;

};

action.appendChild(
button
);

}


document.getElementById(
"modal"
).classList.add("show");

};


/* =========================================
 MARK ALL READ
========================================= */

window.markAllRead=
async function(){

const unread=
notifications.filter(
x=>x.read!==true
);


if(!unread.length){

toast(
"No unread notifications."
);

return;

}


try{

const batch=
writeBatch(db);


unread.forEach(
item=>{

batch.update(

doc(
db,
"notifications",
item.id
),

{

read:true,

readAt:
new Date()

}

);

});


await batch.commit();


notifications.forEach(
item=>{
item.read=true;
}
);


updateUnread();

render();


toast(
"All notifications marked as read."
);


}catch(error){

console.error(
"Mark all error:",
error
);


toast(
"Unable to mark notifications."
);

}

};


/* =========================================
 UNREAD COUNT
========================================= */

function updateUnread(){

const count=
notifications.filter(
x=>x.read!==true
).length;


const badge=
document.getElementById(
"unreadBadge"
);


if(count>0){

badge.style.display=
"inline-block";

badge.textContent=
count;

}else{

badge.style.display=
"none";

}

}


/* =========================================
 ICONS
========================================= */

function getIcon(type){

switch(
String(type||"")
.toLowerCase()
){

case"payment":
return"💳";

case"course":
return"📚";

case"community":
return"👥";

case"security":
return"🔐";

case"promotion":
return"🎁";

case"account":
return"👤";

case"system":
return"⚙️";

default:
return"🔔";

}

}


/* =========================================
 DATE
========================================= */

function getTime(timestamp){

if(!timestamp)
return 0;


try{

if(
typeof timestamp.toDate===
"function"
){

return timestamp
.toDate()
.getTime();

}


if(
timestamp.seconds
){

return Number(
timestamp.seconds
)*1000;

}


return new Date(
timestamp
).getTime();

}catch{

return 0;

}

}


function formatDate(timestamp){

const time=
getTime(timestamp);


if(!time)
return"";


const date=
new Date(time);


return date.toLocaleString();

}


/* =========================================
 HELPERS
========================================= */

function truncate(
text,
length
){

return text.length>length
?text.substring(
0,
length
)+"..."
:text;

}


function escapeHtml(value){

return String(
value??""
)

.replace(
/&/g,
"&amp;"
)

.replace(
/</g,
"&lt;"
)

.replace(
/>/g,
"&gt;"
)

.replace(
/"/g,
"&quot;"
)

.replace(
/'/g,
"&#039;"
);

}


/* =========================================
 MODAL
========================================= */

window.closeModal=function(){

document.getElementById(
"modal"
).classList.remove("show");

};


/* =========================================
 TOAST
========================================= */

function toast(message){

const element=
document.getElementById(
"toast"
);

element.textContent=
message;

element.classList.add(
"show"
);


clearTimeout(
window.toastTimer
);


window.toastTimer=
setTimeout(
()=>{

element.classList.remove(
"show"
);

},
3000
);

}


</script></body>
</html>