/* =========================
   SWITCH
========================= */

.switch{
  position:relative;

  display:inline-block;

  width:45px;
  height:25px;

  flex-shrink:0;
}

.switch input{
  opacity:0;

  width:0;
  height:0;
}

.slider{
  position:absolute;

  cursor:pointer;

  inset:0;

  background:#cbd5e1;

  border-radius:999px;

  transition:.2s;
}

.slider:before{
  content:"";

  position:absolute;

  width:19px;
  height:19px;

  left:3px;
  top:3px;

  background:#fff;

  border-radius:50%;

  transition:.2s;

  box-shadow:
  0 1px 3px
  rgba(0,0,0,.2);
}

.switch input:checked + .slider{
  background:#2563eb;
}

.switch input:checked + .slider:before{
  transform:translateX(20px);
}


/* =========================
   ACTIONS
========================= */

.actions{
  display:flex;

  justify-content:flex-end;

  gap:10px;

