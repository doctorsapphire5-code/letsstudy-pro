<!-- =========================
     FIREBASE
========================= -->

<script type="module">

import {
  initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";


import {
  getAuth,
  onAuthStateChanged,
  reload,
  sendEmailVerification,
  sendPasswordResetEmail,
  signOut
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-auth.js";


/* =========================
   FIREBASE CONFIG
========================= */

const firebaseConfig = {

  apiKey:
  "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
  "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
  "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
  "let-s-study-pro-course",

  storageBucket:
  "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
  "474928293390",

  appId:
  "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
  "G-85B7V5H5J0"

};


const app =
initializeApp(
  firebaseConfig
);

const auth =
getAuth(app);


/* =========================
   ELEMENTS
========================= */

const loginCard =
document.getElementById(
  "loginCard"
);

const mainContent =
document.getElementById(
  "mainContent"
);

const message =
document.getElementById(
  "message"
);

const emailStatus =
document.getElementById(
  "emailStatus"
);

const emailDescription =
document.getElementById(
  "emailDescription"
);

const accountEmail =
document.getElementById(
  "accountEmail"
);

const accountUid =
document.getElementById(
  "accountUid"
);

const securityTitle =
document.getElementById(
  "securityTitle"
);

const securityDescription =
document.getElementById(
  "securityDescription"
);

const securityIcon =
document.getElementById(
  "securityIcon"
);

const progressBar =
document.getElementById(
  "progressBar"
);

const scoreElement =
document.getElementById(
  "score"
);

const passwordBtn =
document.getElementById(
  "passwordBtn"
);

const logoutBtn =
document.getElementById(
  "logoutBtn"
);

const secureLogoutBtn =
document.getElementById(
  "secureLogoutBtn"
);


/* =========================
   MESSAGE
========================= */

function showMessage(
text,
type
){

  message.textContent =
  text;

  message.className =
  "message " +
  type;

}


/* =========================
   SECURITY SCORE
========================= */

function calculateSecurityScore(
user
){

  let score = 0;


  /*
    Verified email
  */

  if(
    user.emailVerified
  ){

    score += 50;

  }


  /*
    Email exists
  */

  if(
    user.email
  ){

    score += 25;

  }


  /*
    Account has provider
  */

  if(
    user.providerData &&
    user.providerData.length > 0
  ){

    score += 25;

  }


  return score;

}


/* =========================
   UPDATE SECURITY UI
========================= */

function updateSecurityUI(
user
){

  const score =
  calculateSecurityScore(
    user
  );


  progressBar.style.width =
  score + "%";


  scoreElement.textContent =
  score + "%";


  if(score >= 75){

    securityTitle.textContent =
    "Your account is protected";

    securityDescription.textContent =
    "Your LetsStudy Pro account has good security protection.";

    securityIcon.textContent =
    "✓";

    securityIcon.style.background =
    "#dcfce7";

    securityIcon.style.color =
    "#16a34a";

  }else{

    securityTitle.textContent =
    "Improve your account security";

    securityDescription.textContent =
    "Verify your email to improve your account protection.";

    securityIcon.textContent =
    "!";

    securityIcon.style.background =
    "#fef3c7";

    securityIcon.style.color =
    "#d97706";

  }


  if(
    user.emailVerified
  ){

    emailStatus.textContent =
    "Verified";

    emailStatus.className =
    "status verified";

    emailDescription.textContent =
    "Your email address has been verified.";

  }else{

    emailStatus.textContent =
    "Not Verified";

    emailStatus.className =
    "status warning";

    emailDescription.textContent =
    "Your email address still needs verification.";

  }

}


/* =========================
   AUTH STATE
========================= */

onAuthStateChanged(
  auth,
  async user => {

    if(!user){

      loginCard.style.display =
      "block";

      mainContent.style.display =
      "none";

      return;

    }


    loginCard.style.display =
    "none";

    mainContent.style.display =
    "block";


    try{

      await reload(
        user
      );

    }catch(error){

      console.error(
        error
      );

    }


    const currentUser =
    auth.currentUser;


    accountEmail.textContent =
    currentUser.email ||
    "No email";


    accountUid.textContent =
    "User ID: " +
    currentUser.uid;


    updateSecurityUI(
      currentUser
    );

  }
);


/* =========================
   PASSWORD RESET
========================= */

passwordBtn.addEventListener(
  "click",
  async () => {

    const user =
    auth.currentUser;


    if(!user){

      window.location.href =
      "/login.html";

      return;

    }


    if(!user.email){

      showMessage(
        "No email address is connected to this account.",
        "error"
      );

      return;

    }


    try{

      passwordBtn.disabled =
      true;

      passwordBtn.textContent =
      "Sending...";


      await sendPasswordResetEmail(
        auth,
        user.email
      );


      showMessage(
        "Password reset email sent to " +
        user.email +
        ". Check your inbox.",
        "success"
      );


    }catch(error){

      console.error(
        "Password reset error:",
        error
      );


      let text =
      "Unable to send password reset email.";


      if(
        error.code ===
        "auth/too-many-requests"
      ){

        text =
        "Too many requests. Please wait and try again later.";

      }


      showMessage(
        text,
        "error"
      );


    }finally{

      passwordBtn.disabled =
      false;

      passwordBtn.textContent =
      "Reset Password";

    }

  }
);


/* =========================
   LOGOUT
========================= */

async function logout(){

  try{

    await signOut(
      auth
    );


    window.location.href =
    "/login.html";


  }catch(error){

    console.error(
      "Logout error:",
      error
    );


    showMessage(
      "Unable to sign out. Please try again.",
      "error"
    );

  }

}


logoutBtn.addEventListener(
  "click",
  logout
);


secureLogoutBtn.addEventListener(
  "click",
  logout
);


/* =========================
   MOBILE MENU
========================= */

document
.getElementById(
  "menuBtn"
)
.addEventListener(
  "click",
  () => {

    document
    .querySelector(
      ".nav-links"
    )
    .classList.toggle(
      "active"
    );

  }
);

</script>

</body>

</html>