}


/* =========================
   SECURITY SCORE
========================= */

.security-card{
  background:#fff;

  border:
  1px solid #e2e8f0;

  border-radius:17px;

  padding:24px;

  margin-bottom:18px;
}

.security-top{
  display:flex;

  align-items:center;

  gap:18px;
}

.security-icon{
  width:58px;
  height:58px;

  flex-shrink:0;

  background:#dcfce7;

  color:#16a34a;

  border-radius:50%;

  display:flex;

  align-items:center;
  justify-content:center;

  font-size:26px;
}

.security-top h2{
  font-size:17px;

  margin-bottom:4px;
}

.security-top p{
  color:#64748b;

  font-size:11px;
}

.progress{
  height:8px;

  background:#e2e8f0;

  border-radius:999px;

  overflow:hidden;

  margin-top:20px;
}

.progress-bar{
  width:0%;

  height:100%;

  background:#16a34a;

  border-radius:999px;

  transition:.4s;
}

.score-text{
  display:flex;

  justify-content:space-between;

  margin-top:8px;

  color:#64748b;

  font-size:10px;
}


/* =========================
   SECURITY ITEMS
========================= */

.card{
  background:#fff;

  border:
  1px solid #e2e8f0;

  border-radius:17px;

  overflow:hidden;

  margin-bottom:18px;
}

.card-title{
  padding:20px 22px;

  border-bottom:
  1px solid #f1f5f9;

  font-size:15px;

  font-weight:800;
}

.security-item{
  display:flex;

  align-items:center;

  justify-content:space-between;

  gap:15px;

  padding:18px 22px;

  border-bottom:
  1px solid #f1f5f9;
}

.security-item:last-child{
  border-bottom:0;
}

.item-left{
  display:flex;

  align-items:center;

  gap:13px;

  min-width:0;
}

.item-icon{
  width:42px;
  height:42px;

  flex-shrink:0;

  background:#eff6ff;

  color:#2563eb;

  border-radius:10px;

  display:flex;

  align-items:center;
  justify-content:center;

  font-size:19px;
}

.item-info h3{
  font-size:12px;

  margin-bottom:4px;
}

.item-info p{
  color:#64748b;

  font-size:10px;

  line-height:1.5;
}

.status{
  flex-shrink:0;

  padding:5px 9px;

  border-radius:999px;

  font-size:9px;

  font-weight:800;
}

.status.verified{
  background:#dcfce7;

  color:#166534;
}

.status.warning{
  background:#fef3c7;

  color:#92400e;
}

.status.neutral{
  background:#f1f5f9;

  color:#475569;
}


/* =========================
   BUTTONS
========================= */

.action-btn{
  border:0;

  padding:9px 13px;

  border-radius:8px;

  background:#2563eb;

  color:#fff;

  font-size:10px;

  font-weight:800;

  cursor:pointer;

  white-space:nowrap;
}

.action-btn:hover{
  background:#1d4ed8;
}

.secondary-btn{
  background:#f1f5f9;

  color:#334155;
}

.secondary-btn:hover{
  background:#e2e8f0;
}

.danger-btn{
  background:#fee2e2;

  color:#b91c1c;
}

.danger-btn:hover{
  background:#fecaca;
}


/* =========================
   ACCOUNT
========================= */

.account-box{
  padding:20px 22px;
}

.account-email{
  font-size:13px;

  font-weight:800;

  word-break:break-all;

  margin-bottom:5px;
}

.account-uid{
  color:#94a3b8;

  font-size:9px;

  word-break:break-all;
}


/* =========================
   MESSAGE
========================= */

.message{
  display:none;

  margin-bottom:18px;

  padding:12px;

  border-radius:9px;

  font-size:11px;

  line-height:1.5;
}

.message.success{
  display:block;

  background:#dcfce7;

  color:#166534;

  border:
  1px solid #bbf7d0;
}

.message.error{
  display:block;

  background:#fee2e2;

  color:#991b1b;

  border:
  1px solid #fecaca;
}

.message.info{
  display:block;

  background:#eff6ff;

  color:#1d4ed8;

  border:
  1px solid #bfdbfe;
}


/* =========================
   LOGIN
========================= */

.login-card{
  max-width:500px;

  margin:70px auto;

  padding:35px 25px;

  background:#fff;

  border:
  1px solid #e2e8f0;

  border-radius:17px;

  text-align:center;
}

.login-card h2{
  font-size:20px;

  margin-bottom:8px;
}

.login-card p{
  color:#64748b;

  font-size:12px;

  margin-bottom:18px;
}

.login-btn{
  display:inline-block;

  padding:11px 20px;

  background:#2563eb;

  color:#fff;

  border-radius:8px;

  font-size:11px;

  font-weight:800;
}


/* =========================
   FOOTER
========================= */

footer{
  text-align:center;

  padding:28px;

  color:#94a3b8;

  font-size:10px;
}


/* =========================
   MOBILE
========================= */

@media(max-width:700px){

  .nav-links{
    display:none;
  }

  .menu-btn{
    display:block;
  }

  .security-item{
    align-items:flex-start;

    flex-direction:column;
  }

  .item-left{
    width:100%;
  }

  .security-item > .action-btn{
    width:100%;
  }

}

</style>

</head>


