/* =====================================================
   HELPERS
===================================================== */

function number(value){

  const n =
    Number(value);

  return Number.isNaN(n)
    ? 0
    : n;

}


function money(
  value,
  currency = "TZS"
){

  return (
    number(value)
      .toLocaleString()
  ) +
  " " +
  currency;

}


function escapeHTML(value){

  return String(
    value ?? ""
  )

  .replaceAll(
    "&",
    "&amp;"
  )

  .replaceAll(
    "<",
    "&lt;"
  )

  .replaceAll(
    ">",
    "&gt;"
  )

  .replaceAll(
    '"',
    "&quot;"
  )

      .replaceAll(
      "'",
      "&#039;"
    );

}


/* =====================================================
   ERROR
===================================================== */

function showError(message){

  errorBox.textContent =
    message;

  errorBox.style.display =
    "block";

}


function hideError(){

  errorBox.style.display =
    "none";

}


/* =====================================================
   ADMIN CHECK
===================================================== */

async function checkAdmin(user){

  if(!user){

    window.location.href =
      "login-admin.html";

    return false;

  }


  try{

    const adminRef =
      doc(
        db,
        "admins",
        user.uid
      );


    const adminSnap =
      await getDoc(
        adminRef
      );


    if(
      !adminSnap.exists()
    ){

      alert(
        "Access denied. Admin account required."
      );

      window.location.href =
        "index.html";

      return false;

    }


    return true;

  }
  catch(error){

    console.error(
      "Admin check error:",
      error
    );

    showError(
      "Unable to verify admin account."
    );

    return false;

  }

}


/* =====================================================
   LOAD COMMISSIONS
===================================================== */

async function loadCommissions(){

  hideError();

  try{

    const snapshot =
      await getDocs(
        collection(
          db,
          "affiliateCommissions"
        )
      );


    commissions = [];


    snapshot.forEach(
      commissionDoc => {

        const data =
          commissionDoc.data() || {};


        commissions.push({

          id:
            commissionDoc.id,

          ...data,

          orderAmount:
            number(
              data.orderAmount
            ),

          commissionRate:
            number(
              data.commissionRate
            ),

          commissionAmount:
            number(
              data.commissionAmount
            ),

          status:
            String(
              data.status ||
              "pending"
            ).toLowerCase(),

          currency:
            data.currency ||
            "TZS"

        });

      }
    );


    commissions.sort(
      (
        a,
        b
      ) => {

        const aTime =
          a.createdAt?.seconds ||
          0;

        const bTime =
          b.createdAt?.seconds ||
          0;

        return bTime - aTime;

      }
    );


    updateStatistics();

    renderTable();

  }
  catch(error){

    console.error(
      "Commission error:",
      error
    );

    showError(
      "Unable to load commission records. Make sure the affiliateCommissions collection exists and Firestore permissions allow admin access."
    );

  }

}


/* =====================================================
   UPDATE STATISTICS
===================================================== */

function updateStatistics(){

  let sales = 0;

  let total = 0;

  let pending = 0;

  let approved = 0;

  let paid = 0;

  let rejected = 0;


  commissions.forEach(
    commission => {

      const saleAmount =
        number(
          commission.orderAmount
        );


      const commissionAmount =
        number(
          commission.commissionAmount
        );


      sales +=
        saleAmount;


      total +=
        commissionAmount;


      switch(
        commission.status
      ){

        case "pending":

          pending +=
            commissionAmount;

          break;


        case "approved":

          approved +=
            commissionAmount;

          break;


        case "paid":

          paid +=
            commissionAmount;

          break;


        case "rejected":

          rejected +=
            commissionAmount;

          break;

      }

    }
  );


  totalSales.textContent =
    money(
      sales
    );


  totalCommission.textContent =
    money(
      total
    );


  pendingCommission.textContent =
    money(
      pending
    );


  approvedCommission.textContent =
    money(
      approved
    );


  paidCommission.textContent =
    money(
      paid
    );


  rejectedCommission.textContent =
    money(
      rejected
    );


  totalRecords.textContent =
    commissions
      .length
      .toLocaleString();

}


/* =====================================================
   RENDER COMMISSION TABLE
===================================================== */

function renderTable(){

  const query =
    searchInput.value
      .trim()
      .toLowerCase();


  const selectedStatus =
    statusFilter.value;


  let data =
    [...commissions];


  /* SEARCH */

  if(query){

    data =
      data.filter(
        commission => {

          const affiliateName =
            String(
              commission.affiliateName ||
              ""
            ).toLowerCase();


          const productName =
            String(
              commission.productName ||
              ""
            ).toLowerCase();


          const orderId =
            String(
              commission.orderId ||
              ""
            ).toLowerCase();


          const customerId =
            String(
              commission.customerId ||
              ""
            ).toLowerCase();


          return (

            affiliateName.includes(
              query
            )

            ||

            productName.includes(
              query
            )

            ||

            orderId.includes(
              query
            )

            ||

            customerId.includes(
              query
            )

          );

        }
      );

  }


  /* STATUS FILTER */

  if(
    selectedStatus !==
    "all"
  ){

    data =
      data.filter(
        commission =>
          commission.status ===
          selectedStatus
      );

  }


  /* SORT NEWEST FIRST */

  data.sort(
    (
      a,
      b
    ) => {

      const aTime =
        a.createdAt?.seconds ||
        0;

      const bTime =
        b.createdAt?.seconds ||
        0;

      return bTime - aTime;

    }
  );


  /* EMPTY */

  if(
    data.length === 0
  ){

    commissionTable.innerHTML = `

      <tr>

        <td
          colspan="8"
          class="empty"
        >

          No commission records found.

        </td>

      </tr>

    `;

    return;

  }


  /* TABLE */

  commissionTable.innerHTML =
    data
      .map(
        commission => {

          const status =
            commission.status;


          const rate =
            number(
              commission.commissionRate
            );


          let statusClass =
            "pending";


          if(
            status ===
            "approved"
          ){

            statusClass =
              "approved";

          }


          if(
            status ===
            "paid"
          ){

            statusClass =
              "paid";

          }


          if(
            status ===
            "rejected"
          ){

            statusClass =
              "rejected";

          }


          let actions =
            `
              <span
                style="
                  color:#9ca3af;
                  font-size:11px;
                "
              >
                No action
              </span>
            `;


          /* PENDING ACTIONS */

          if(
            status ===
            "pending"
          ){

            actions = `

              <button
                type="button"
                class="action-btn approve-btn"
                data-action="approve"
                data-id="${escapeHTML(
                  commission.id
                )}"
              >
                Approve
              </button>


              <button
                type="button"
                class="action-btn reject-btn"
                data-action="reject"
                data-id="${escapeHTML(
                  commission.id
                )}"
              >
                Reject
              </button>

            `;

          }


          /* APPROVED ACTIONS */

          else if(
            status ===
            "approved"
          ){

            actions = `

              <button
                type="button"
                class="action-btn paid-btn"
                data-action="paid"
                data-id="${escapeHTML(
                  commission.id
                )}"
              >
                Mark Paid
              </button>


              <button
                type="button"
                class="action-btn reject-btn"
                data-action="reject"
                data-id="${escapeHTML(
                  commission.id
                )}"
              >
                Reject
              </button>

            `;

          }


          return `

            <tr>

              <td>

                <div class="affiliate-name">

                  ${escapeHTML(
                    commission.affiliateName ||
                    "Unknown Affiliate"
                  )}

                </div>

              </td>


              <td>

                <div class="affiliate-name">

                  ${escapeHTML(
                    commission.productName ||
                    "Unknown Product"
                  )}

                </div>


                <div class="order-name">

                  Order:
                  ${escapeHTML(
                    commission.orderId ||
                    "—"
                  )}

                </div>

              </td>


              <td>

                <span class="amount">

                  ${money(
                    commission.orderAmount,
                    commission.currency
                  )}

                </span>

              </td>


              <td>

                ${rate.toFixed(2)}%

              </td>


              <td>

                <span class="commission">

                  ${money(
                    commission.commissionAmount,
                    commission.currency
                  )}

                </span>

              </td>


              <td>

                <span
                  class="status ${statusClass}"
                >

                  ${escapeHTML(
                    status
                  )}

                </span>

              </td>


              <td>

                ${getDate(
                  commission.createdAt
                )}

              </td>


              <td>

                <div class="action-group">

                  ${actions}

                </div>

              </td>

            </tr>

          `;

        }
      )
      .join("");

}


/* =====================================================
   UPDATE COMMISSION STATUS
===================================================== */

async function updateCommissionStatus(
  id,
  newStatus
){

  try{

    const commissionRef =
      doc(
        db,
        "affiliateCommissions",
        id
      );


    const updates = {

      status:
        newStatus,

      updatedAt:
        serverTimestamp()

    };


    if(
      newStatus ===
      "approved"
    ){

      updates.approvedAt =
        serverTimestamp();

    }


    if(
      newStatus ===
      "paid"
    ){

      updates.paidAt =
        serverTimestamp();

    }


    if(
      newStatus ===
      "rejected"
    ){

      updates.rejectedAt =
        serverTimestamp();

    }


    await updateDoc(
      commissionRef,
      updates
    );


    await loadCommissions();

  }
  catch(error){

    console.error(
      "Status update error:",
      error
    );

    showError(
      "Unable to update commission status."
    );

  }

}


/* =====================================================
   TABLE ACTIONS
===================================================== */

commissionTable.addEventListener(
  "click",
  async event => {

    const button =
      event.target.closest(
        "[data-action]"
      );


    if(!button){
      return;
    }


    const action =
      button.dataset.action;


    const id =
      button.dataset.id;


    if(!id){
      return;
    }


    if(
      action ===
      "approve"
    ){

      const confirmed =
        confirm(
          "Approve this commission?"
        );


      if(!confirmed){
        return;
      }


      await updateCommissionStatus(
        id,
        "approved"
      );

      return;

    }


    if(
      action ===
      "reject"
    ){

      const confirmed =
        confirm(
          "Reject this commission?"
        );


      if(!confirmed){
        return;
      }


      await updateCommissionStatus(
        id,
        "rejected"
      );

      return;

    }


    if(
      action ===
      "paid"
    ){

      const confirmed =
        confirm(
          "Mark this commission as paid?"
        );


      if(!confirmed){
        return;
      }


      await updateCommissionStatus(
        id,
        "paid"
      );

    }

  }
);


/* =====================================================
   SEARCH
===================================================== */

searchInput.addEventListener(
  "input",
  renderTable
);


/* =====================================================
   FILTER
===================================================== */

statusFilter.addEventListener(
  "change",
  renderTable
);


/* =====================================================
   REFRESH
===================================================== */

refreshBtn.addEventListener(
  "click",
  async () => {

    await loadCommissions();

  }
);


/* =====================================================
   MOBILE SIDEBAR
===================================================== */

menuBtn.addEventListener(
  "click",
  () => {

    sidebar.classList.add(
      "open"
    );

    overlay.classList.add(
      "show"
    );

  }
);


overlay.addEventListener(
  "click",
  () => {

    sidebar.classList.remove(
      "open"
    );

    overlay.classList.remove(
      "show"
    );

  }
);


document
  .querySelectorAll(
    ".nav-link"
  )
  .forEach(
    link => {

      link.addEventListener(
        "click",
        () => {

          sidebar.classList.remove(
            "open"
          );

          overlay.classList.remove(
            "show"
          );

        }
      );

    }
  );


/* =====================================================
   AUTHENTICATION
===================================================== */

onAuthStateChanged(
  auth,
  async user => {

    const allowed =
      await checkAdmin(
        user
      );


    if(!allowed){
      return;
    }


    await loadCommissions();

  }
);

</script>

