      font-weight:800;
      margin-bottom:5px;
    }

    .stat-label{
      color:#6b7280;
      font-size:13px;
    }

    /* ===============================
       GRID
    =============================== */

    .grid{
      display:grid;
      grid-template-columns:
        minmax(320px,380px)
        1fr;
      gap:20px;
      align-items:start;
    }

    .card{
      background:white;
      border:1px solid #e5e7eb;
      border-radius:15px;
      padding:22px;
