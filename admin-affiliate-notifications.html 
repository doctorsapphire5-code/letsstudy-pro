          return "💸";

        case "referral":
          return "👥";

        case "sale":
          return "🛍️";

        case "announcement":
          return "📢";

        case "system":
          return "⚙️";

        default:
          return "🔔";

      }

    }


    /* =================================
       FORMAT DATE
    ================================= */

    function formatDate(
      timestamp
    ){

      if(
        !timestamp
      ){

        return "Just now";

      }


      try{

        const date =
          timestamp.toDate
            ? timestamp.toDate()
            : new Date(timestamp);


        if(
          Number.isNaN(
            date.getTime()
          )
        ){

          return "Recently";

        }


        return date.toLocaleString(
          undefined,
          {
            year:"numeric",
            month:"short",
            day:"numeric",
            hour:"2-digit",
            minute:"2-digit"
          }
        );

      }catch(error){

        return "Recently";

      }

    }


    /* =================================
       TYPE BADGE
    ================================= */

    function getTypeBadge(
      type
    ){

      const safeType =
        String(
          type || "system"
        ).toLowerCase();


      const labels = {

        commission:
          "💰 Commission",

        withdrawal:
          "💸 Withdrawal",

        referral:
          "👥 Referral",

        sale:
          "🛍️ Sale",

        announcement:
          "📢 Announcement",

        system:
          "⚙️ System"

      };


      return `

        <span
          class="
            badge
            badge-${escapeHTML(
              safeType
            )}
          "
        >
          ${escapeHTML(
            labels[safeType] ||
            safeType
          )}
        </span>

      `;

    }


    /* =================================
       LOAD NOTIFICATIONS
    ================================= */

    async function loadNotifications(){

      tableContainer.innerHTML = `

        <div class="loading">
          Loading notifications...
        </div>

      `;


      try{

        const snapshot =
          await getDocs(
            collection(
              db,
              "affiliateNotifications"
            )
          );


        notifications =
          snapshot.docs.map(
            item => ({

              id:
                item.id,

              ...item.data()

            })
          );


        notifications.sort(
          (a,b) => {

            const timeA =
              a.createdAt?.toMillis
                ? a.createdAt.toMillis()
                : 0;


            const timeB =
              b.createdAt?.toMillis
                ? b.createdAt.toMillis()
                : 0;


            return timeB - timeA;

          }
        );


        updateStats();

        renderTable();

      }catch(error){

        console.error(
          "Notification loading error:",
          error
        );


        tableContainer.innerHTML = `

          <div class="empty">

            <div class="empty-icon">
              ⚠️
            </div>

            <strong>
              Unable to load notifications
            </strong>

            <p>
              ${escapeHTML(
                error.message
              )}
            </p>

          </div>

        `;

      }

    }


    /* =================================
       UPDATE STATS
    ================================= */

    function updateStats(){

      const total =
        notifications.length;


      const read =
        notifications.filter(
          item =>
            item.read === true
        ).length;


      const unread =
        total - read;


      const announcements =
        notifications.filter(
          item =>
            item.type ===
            "announcement"
        ).length;


      document.getElementById(
        "totalNotifications"
      ).textContent =
        total;


      document.getElementById(
        "readNotifications"
      ).textContent =
        read;


      document.getElementById(
        "unreadNotifications"
      ).textContent =
        unread;


      document.getElementById(
        "announcementCount"
      ).textContent =
        announcements;

    }


    /* =================================
       FILTER
    ================================= */

    function getFilteredNotifications(){

      const search =
        searchInput.value
          .trim()
          .toLowerCase();


      const type =
        typeFilter.value;


      return notifications.filter(
        item => {

          const title =
            String(
              item.title || ""
            ).toLowerCase();


          const message =
            String(
              item.message || ""
            ).toLowerCase();


          const userId =
            String(
              item.userId || ""
            ).toLowerCase();


          const matchesSearch =
            !search ||
            title.includes(search) ||
            message.includes(search) ||
            userId.includes(search);


          const matchesType =
            type === "all" ||
            item.type === type;


          return (
            matchesSearch &&
            matchesType
          );

        }
      );

    }


    /* =================================
       RENDER TABLE
    ================================= */

    function renderTable(){

      const filtered =
        getFilteredNotifications();


      if(
        filtered.length === 0
      ){

        tableContainer.innerHTML = `

          <div class="empty">

            <div class="empty-icon">
              🔔
            </div>

            <strong>
              No notifications found
            </strong>

            <p>
              Create a notification to get started.
            </p>

          </div>

        `;

        return;

      }


      tableContainer.innerHTML = `

        <table>

          <thead>

            <tr>

              <th>
                Notification
              </th>

              <th>
                Type
              </th>

              <th>
                Recipient
              </th>

              <th>
                Status
              </th>

              <th>
                Priority
              </th>

              <th>
                Date
              </th>

              <th>
                Actions
              </th>

            </tr>

          </thead>


          <tbody>

            ${filtered.map(
              item => {

                const recipient =
                  item.recipientType ===
                  "all"
                    ? "All Affiliates"
                    : (
                        item.userId ||
                        "Specific Affiliate"
                      );


                return `

                  <tr>

                    <td>

                      <div
                        class="notification-title"
                      >

                        ${escapeHTML(
                          item.icon ||
                          "🔔"
                        )}

                        ${escapeHTML(
                          item.title ||
                          "Notification"
                        )}

                      </div>


                      <div
                        class="notification-message"
                      >

                        ${escapeHTML(
                          item.message ||
                          ""
                        )}

                      </div>

                    </td>


                    <td>

                      ${getTypeBadge(
                        item.type
                      )}

                    </td>


                    <td>

                      ${escapeHTML(
                        recipient
                      )}

                    </td>


                    <td>

                      <span
                        class="badge"
                        style="
                          background:${
                            item.read === true
                              ? "#dcfce7"
                              : "#dbeafe"
                          };
                          color:${
                            item.read === true
                              ? "#166534"
                              : "#1e40af"
                          };
                        "
                      >

                        ${
                          item.read === true
                            ? "Read"
                            : "Unread"
                        }

                      </span>

                    </td>


                    <td>

                      <span
                        style="
                          font-weight:700;
                          font-size:12px;
                        "
                      >

                        ${escapeHTML(
                          item.priority ||
                          "normal"
                        )}

                      </span>

                    </td>


                    <td>

                      ${escapeHTML(
                        formatDate(
                          item.createdAt
                        )
                      )}

                    </td>


                    <td>

                      <div
                        class="actions"
                      >

                        <button
                          class="
                            btn
                            btn-secondary
                            btn-small
                          "
                          data-edit-id="${escapeHTML(
                            item.id
                          )}"
                        >
                          Edit
                        </button>


                        <button
                          class="
                            btn
                            btn-danger
                            btn-small
                          "
                          data-delete-id="${escapeHTML(
                            item.id
                          )}"
                        >
                          Delete
                        </button>

                      </div>

                    </td>

                  </tr>

                `;

              }
            ).join("")}

          </tbody>

        </table>

      `;


      /* =================================
         EDIT BUTTONS
      ================================= */

      document
        .querySelectorAll(
          "[data-edit-id]"
        )
        .forEach(
          button => {

            button.addEventListener(
              "click",
              () => {

                editNotification(
                  button.dataset.editId
                );

              }
            );

          }
        );


      /* =================================
         DELETE BUTTONS
      ================================= */

      document
        .querySelectorAll(
          "[data-delete-id]"
        )
        .forEach(
          button => {

            button.addEventListener(
              "click",
              () => {

                deleteNotification(
                  button.dataset.deleteId
                );

              }
            );

          }
        );

    }


    /* =================================
       EDIT
    ================================= */

    function editNotification(
      id
    ){

      const item =
        notifications.find(
          notification =>
            notification.id === id
        );


      if(
        !item
      ){

        return;

      }


      editingId =
        id;


      formTitle.textContent =
        "✏️ Edit Notification";


      notificationType.value =
        item.type ||
        "system";


      notificationTitle.value =
        item.title ||
        "";


      notificationMessage.value =
        item.message ||
        "";


      notificationIcon.value =
        item.icon ||
        "";


      notificationLink.value =
        item.link ||
        "";


      notificationPriority.value =
        item.priority ||
        "normal";


      selectedRecipient =
        item.recipientType ===
        "specific"
          ? "specific"
          : "all";


      specificUserId.value =
        item.userId &&
        item.userId !== "all"
          ? item.userId
          : "";


      document
        .querySelectorAll(
          ".recipient-option"
        )
        .forEach(
          option => {

            option.classList.toggle(
              "active",
              option.dataset.recipient ===
              selectedRecipient
            );

          }
        );


      if(
        selectedRecipient ===
        "specific"
      ){

        specificUserBox.classList.add(
          "show"
        );

      }else{

        specificUserBox.classList.remove(
          "show"
        );

      }


      saveBtn.textContent =
        "💾 Update Notification";


      cancelBtn.style.display =
        "block";


      window.scrollTo({
        top:0,
        behavior:"smooth"
      });

    }


    /* =================================
       RESET FORM
    ================================= */

    function resetForm(){

      editingId =
        null;


      formTitle.textContent =
        "➕ New Notification";


      notificationType.value =
        "commission";


      notificationTitle.value =
        "";


      notificationMessage.value =
        "";


      notificationIcon.value =
        "";


      notificationLink.value =
        "";


      notificationPriority.value =
        "normal";


      specificUserId.value =
        "";


      selectedRecipient =
        "all";


      specificUserBox.classList.remove(
        "show"
      );


      document
        .querySelectorAll(
          ".recipient-option"
        )
        .forEach(
          option => {

            option.classList.toggle(
              "active",
              option.dataset.recipient ===
              "all"
            );

          }
        );


      saveBtn.textContent =
        "📤 Send Notification";


      cancelBtn.style.display =
        "none";

    }


    /* =================================
       RECIPIENT SELECT
    ================================= */

    document
      .querySelectorAll(
        ".recipient-option"
      )
      .forEach(
        option => {

          option.addEventListener(
            "click",
            () => {

              selectedRecipient =
                option.dataset.recipient;


              document
                .querySelectorAll(
                  ".recipient-option"
                )
                .forEach(
                  item => {

                    item.classList.toggle(
                      "active",
                      item === option
                    );

                  }
                );


              if(
                selectedRecipient ===
                "specific"
              ){

                specificUserBox.classList.add(
                  "show"
                );

              }else{

                specificUserBox.classList.remove(
                  "show"
                );

              }

            }
          );

        }
      );


    /* =================================
       SAVE NOTIFICATION
    ================================= */

    saveBtn.addEventListener(
      "click",
      async () => {

        const title =
          notificationTitle.value.trim();


        const message =
          notificationMessage.value.trim();


        const type =
          notificationType.value;


        const icon =
          notificationIcon.value.trim() ||
          getDefaultIcon(type);


        const link =
          notificationLink.value.trim();


        const priority =
          notificationPriority.value;


        const affiliateUid =
          specificUserId.value.trim();


                 if (
          !title
        ){

          showToast(
            "Please enter notification title.",
            "error"
          );

          return;
        }

        if (
          !message
        ){

          showToast(
            "Please enter notification message.",
            "error"
          );

          return;
        }

        if (
          recipientType === "specific" &&
          !specificUserId
        ){

          showToast(
            "Please enter the affiliate User ID.",
            "error"
          );

          return;
        }

        const notificationData = {
          type:
            type || "system",

          title:
            title,

          message:
            message,

          icon:
            icon || "🔔",

          link:
            link || "",

          priority:
            priority || "normal",

          recipientType:
            recipientType,

          userId:
            recipientType === "specific"
              ? specificUserId
              : "all",

          read:
            false,

          updatedAt:
            serverTimestamp()
        };

        try {

          const wasEditing =
            Boolean(editingId);

          if (wasEditing) {

            await updateDoc(
              doc(
                db,
                "affiliateNotifications",
                editingId
              ),
              notificationData
            );

            showToast(
              "Notification updated successfully.",
              "success"
            );

          } else {

            notificationData.createdBy =
              currentUser.uid;

            notificationData.createdAt =
              serverTimestamp();

            await addDoc(
              collection(
                db,
                "affiliateNotifications"
              ),
              notificationData
            );

            showToast(
              "Notification sent successfully.",
              "success"
            );
          }

          resetForm();

          await loadNotifications();

        } catch (error) {

          console.error(
            "Notification save error:",
            error
          );

          showToast(
            "Failed to save notification. Please try again.",
            "error"
          );

        } finally {

          saveBtn.disabled = false;

          saveBtn.innerHTML =
            editingId
              ? "Update Notification"
              : "Send Notification";
        }

      });

      /* =========================================
         DELETE NOTIFICATION
      ========================================= */

      async function deleteNotification(id){

        if(!id) return;

        const confirmed =
          confirm(
            "Are you sure you want to delete this notification?"
          );

        if(!confirmed) return;

        try {

          await deleteDoc(
            doc(
              db,
              "affiliateNotifications",
              id
            )
          );

          showToast(
            "Notification deleted successfully.",
            "success"
          );

          await loadNotifications();

        } catch(error){

          console.error(
            "Delete notification error:",
            error
          );

          showToast(
            "Failed to delete notification.",
            "error"
          );
        }
      }

      /* =========================================
         CANCEL EDIT
      ========================================= */

      cancelBtn.addEventListener(
        "click",
        () => {

          resetForm();

          window.scrollTo({
            top: 0,
            behavior: "smooth"
          });

        }
      );

      /* =========================================
         SEARCH
      ========================================= */

      searchInput.addEventListener(
        "input",
        () => {

          currentSearch =
            searchInput.value
              .trim()
              .toLowerCase();

          renderNotifications();

        }
      );

      /* =========================================
         TYPE FILTER
      ========================================= */

      typeFilter.addEventListener(
        "change",
        () => {

          currentType =
            typeFilter.value;

          renderNotifications();

        }
      );

      /* =========================================
         RECIPIENT TYPE
      ========================================= */

      recipientSelect.addEventListener(
        "change",
        () => {

          if(
            recipientSelect.value ===
            "specific"
          ){

            specificRecipientGroup
              .style.display = "block";

          } else {

            specificRecipientGroup
              .style.display = "none";

            specificUserInput.value = "";

          }

        }
      );

      /* =========================================
         MOBILE SIDEBAR
      ========================================= */

      menuBtn.addEventListener(
        "click",
        () => {

          sidebar.classList.toggle(
            "open"
          );

          overlay.classList.toggle(
            "show"
          );

        }
      );

      overlay.addEventListener(
        "click",
        () => {

          sidebar.classList.remove(
            "open"
          );

          overlay.classList.remove(
            "show"
          );

        }
      );

      /* =========================================
         CLOSE SIDEBAR ON LINK CLICK
      ========================================= */

      document
        .querySelectorAll(
          ".sidebar a"
        )
        .forEach(link => {

          link.addEventListener(
            "click",
            () => {

              sidebar.classList.remove(
                "open"
              );

              overlay.classList.remove(
                "show"
              );

            }
          );

        });

      /* =========================================
         LOGOUT
      ========================================= */

      logoutBtn.addEventListener(
        "click",
        async () => {

          try {

            await signOut(auth);

            window.location.href =
              "login-admin.html";

          } catch(error){

            console.error(
              "Logout error:",
              error
            );

            showToast(
              "Logout failed.",
              "error"
            );

          }

        }
      );

      /* =========================================
         ADMIN VERIFICATION
      ========================================= */

      async function verifyAdmin(user){

        if(!user){

          window.location.href =
            "login-admin.html";

          return false;
        }

        try {

          const adminRef =
            doc(
              db,
              "admins",
              user.uid
            );

          const adminSnap =
            await getDoc(adminRef);

          if(!adminSnap.exists()){

            alert(
              "Access denied. Admin account required."
            );

            window.location.href =
              "index.html";

            return false;
          }

          return true;

        } catch(error){

          console.error(
            "Admin verification error:",
            error
          );

          alert(
            "Unable to verify admin account."
          );

          return false;
        }
      }

      /* =========================================
         AUTH STATE
      ========================================= */

      onAuthStateChanged(
        auth,
        async user => {

          const allowed =
            await verifyAdmin(user);

          if(!allowed) return;

          currentUser = user;

          await loadNotifications();

        }
      );

      /* =========================================
         ESC KEY
      ========================================= */

      document.addEventListener(
        "keydown",
        event => {

          if(
            event.key === "Escape"
          ){

            sidebar.classList.remove(
              "open"
            );

            overlay.classList.remove(
              "show"
            );

          }

        }
      );

    </script>

  </body>

</html>