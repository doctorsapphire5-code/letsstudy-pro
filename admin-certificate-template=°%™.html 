<script type="module">

import {
  initializeApp,
  getApps,
  getApp
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

import {
  getAuth,
  onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

import {
  getFirestore,
  collection,
  getDocs,
  addDoc,
  updateDoc,
  deleteDoc,
  doc,
  serverTimestamp
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

const firebaseConfig = {
  apiKey: "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",
  authDomain: "let-s-study-pro-course.firebaseapp.com",
  databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
  projectId: "let-s-study-pro-course",
  storageBucket: "let-s-study-pro-course.firebasestorage.app",
  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
};

const app =
  getApps().length
    ? getApp()
    : initializeApp(firebaseConfig);

const auth = getAuth(app);
const db = getFirestore(app);

let templates = [];
let editingId = null;

const $ = id => document.getElementById(id);

function escapeHTML(value){
  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}

function formatDate(value){

  if(!value) return "—";

  try{

    if(typeof value.toDate === "function"){
      return value.toDate().toLocaleDateString();
    }

    return new Date(value).toLocaleDateString();

  }catch{
    return "—";
  }
}

function toast(message,error=false){

  const el = $("toast");

  el.textContent = message;
  el.className = "toast show" + (error ? " error" : "");

  setTimeout(()=>{
    el.classList.remove("show");
  },3000);

}

async function loadTemplates(){

  const body = $("templateBody");

  body.innerHTML = `
    <tr>
      <td colspan="7">
        <div class="loading">
          <i class="fa-solid fa-spinner spinner"></i>
          Loading templates...
        </div>
      </td>
    </tr>
  `;

  try{

    const snapshot =
      await getDocs(
        collection(db,"certificateTemplates")
      );

    templates =
      snapshot.docs.map(item => ({
        id:item.id,
        ...item.data()
      }));

    renderTemplates();
    updateStats();

  }catch(error){

    console.error("Load templates:",error);

    body.innerHTML = `
      <tr>
        <td colspan="7">
          <div class="empty">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <p>Unable to load certificate templates.</p>
          </div>
        </td>
      </tr>
    `;

    toast("Failed to load templates.",true);

  }

}

function getFiltered(){

  const search =
    $("searchInput").value
      .trim()
      .toLowerCase();

  const orientation =
    $("orientationFilter").value;

  return templates.filter(t => {

    const matchesSearch =
      !search ||
      String(t.name || "").toLowerCase().includes(search) ||
      String(t.issuerName || "").toLowerCase().includes(search) ||
      String(t.courseId || "").toLowerCase().includes(search) ||
      String(t.type || "").toLowerCase().includes(search);

    const matchesOrientation =
      !orientation ||
      String(t.orientation || "").toLowerCase() === orientation;

    return matchesSearch && matchesOrientation;

  });

}

function renderTemplates(){

  const body = $("templateBody");
  const list = getFiltered();

  $("resultCount").textContent =
    `${list.length} template${list.length === 1 ? "" : "s"}`;

  if(!list.length){

    body.innerHTML = `
      <tr>
        <td colspan="7">
          <div class="empty">
            <i class="fa-solid fa-certificate"></i>
            <h3>No templates found</h3>
            <p>Create your first certificate template.</p>
          </div>
        </td>
      </tr>
    `;

    return;
  }

  body.innerHTML = list.map(t => `

    <tr>

      <td>
        <div class="template-name">
          ${escapeHTML(t.name || "Untitled")}
        </div>
        <div class="muted">
          ${escapeHTML(t.id)}
        </div>
      </td>

      <td>
        <span class="badge">
          ${escapeHTML(t.type || "completion")}
        </span>
      </td>

      <td>
        <span class="orientation">
          ${escapeHTML(t.orientation || "landscape")}
        </span>
      </td>

      <td>
        ${escapeHTML(t.issuerName || "—")}
        <div class="muted">
          ${escapeHTML(t.issuerTitle || "")}
        </div>
      </td>

      <td>
        <span class="muted">
          ${escapeHTML(t.courseId || "Global")}
        </span>
      </td>

      <td>
        ${formatDate(t.createdAt)}
      </td>

      <td>

        <div class="row-actions">

          <button
            class="action"
            onclick="viewTemplate('${t.id}')"
            title="Preview"
          >
            <i class="fa-solid fa-eye"></i>
          </button>

          <button
            class="action"
            onclick="editTemplate('${t.id}')"
            title="Edit"
          >
            <i class="fa-solid fa-pen"></i>
          </button>

          <button
            class="action delete"
            onclick="removeTemplate('${t.id}')"
            title="Delete"
          >
            <i class="fa-solid fa-trash"></i>
          </button>

        </div>

      </td>

    </tr>

  `).join("");

}

function updateStats(){

  $("totalCount").textContent =
    templates.length;

  $("courseCount").textContent =
    templates.filter(t => t.courseId).length;

  $("logoCount").textContent =
    templates.filter(t => t.logo).length;

  <script>
$("landscapeCount").textContent =
    templates.filter(
      t => String(t.orientation).toLowerCase() === "landscape"
    ).length;

$("portraitCount").textContent =
    templates.filter(
      t => String(t.orientation).toLowerCase() === "portrait"
    ).length;

$("courseCount").textContent =
    new Set(
      templates
        .map(t => t.courseId)
        .filter(Boolean)
    ).size;

$("templateCount").textContent = templates.length;


/* =====================================================
   RENDER TEMPLATES
===================================================== */

const grid = $("templateGrid");

if (!templates.length) {

  grid.innerHTML = `
    <div class="empty">
      <i class="fa-solid fa-certificate"></i>
      <h3>No certificate templates found</h3>
      <p>Create your first certificate template to get started.</p>

      <button class="btn btn-primary" onclick="openModal()">
        <i class="fa-solid fa-plus"></i>
        Create Template
      </button>
    </div>
  `;

} else {

  grid.innerHTML = templates.map(t => {

    const orientation =
      String(t.orientation || "landscape").toLowerCase();

    const type =
      String(t.type || "Certificate");

    const background =
      t.background ||
      "linear-gradient(135deg,#eff6ff,#ffffff)";

    const logo =
      t.logo
        ? `<img src="${escapeHtml(t.logo)}" alt="Logo">`
        : `<i class="fa-solid fa-graduation-cap"></i>`;

    return `
      <article class="template-card">

        <div
          class="certificate-preview ${orientation}"
          style="background:${escapeHtml(background)}"
        >

          <div class="preview-border">

            <div class="preview-logo">
              ${logo}
            </div>

            <div class="preview-small">
              ${escapeHtml(t.issuerName || "LetsStudy Pro")}
            </div>

            <div class="preview-title">
              Certificate of Completion
            </div>

            <div class="preview-name">
              Student Name
            </div>

            <div class="preview-text">
              This certificate is awarded for successfully
              completing the course.
            </div>

            <div class="preview-line"></div>

            <div class="preview-signature">
              ${escapeHtml(t.issuerTitle || "Authorized Issuer")}
            </div>

          </div>

        </div>

        <div class="template-body">

          <div class="template-heading">

            <div>
              <h3>
                ${escapeHtml(t.name || "Untitled Template")}
              </h3>

              <span class="template-id">
                ID: ${escapeHtml(t.id)}
              </span>
            </div>

            <span class="status-badge">
              ${escapeHtml(type)}
            </span>

          </div>

          <p class="description">
            ${escapeHtml(
              t.description ||
              "No description provided."
            )}
          </p>

          <div class="template-meta">

            <span>
              <i class="fa-solid fa-ruler-combined"></i>
              ${escapeHtml(
                orientation.charAt(0).toUpperCase() +
                orientation.slice(1)
              )}
            </span>

            <span>
              <i class="fa-solid fa-book"></i>
              ${t.courseId ? "Course linked" : "Global"}
            </span>

          </div>

          <div class="card-actions">

            <button
              class="btn btn-light"
              onclick="viewTemplate('${escapeHtml(t.id)}')"
            >
              <i class="fa-solid fa-eye"></i>
              View
            </button>

            <button
              class="btn btn-primary"
              onclick="editTemplate('${escapeHtml(t.id)}')"
            >
              <i class="fa-solid fa-pen"></i>
              Edit
            </button>

            <button
              class="icon-btn danger"
              onclick="deleteTemplate('${escapeHtml(t.id)}')"
              title="Delete"
            >
              <i class="fa-solid fa-trash"></i>
            </button>

          </div>

        </div>

      </article>
    `;

  }).join("");

}


/* =====================================================
   CREATE / EDIT MODAL
===================================================== */

function openModal(template = null) {

  $("templateModal").classList.add("show");

  $("modalTitle").textContent =
    template
      ? "Edit Certificate Template"
      : "Create Certificate Template";

  $("templateId").value =
    template?.id || "";

  $("name").value =
    template?.name || "";

  $("type").value =
    template?.type || "Completion";

  $("orientation").value =
    template?.orientation || "landscape";

  $("description").value =
    template?.description || "";

  $("issuerName").value =
    template?.issuerName || "LetsStudy Pro";

  $("issuerTitle").value =
    template?.issuerTitle || "";

  $("background").value =
    template?.background || "";

  $("logo").value =
    template?.logo || "";

  $("courseId").value =
    template?.courseId || "";

}


function closeModal() {

  $("templateModal").classList.remove("show");

}


/* =====================================================
   SAVE TEMPLATE
===================================================== */

async function saveTemplate(event) {

  event.preventDefault();

  const id =
    $("templateId").value.trim();

  const payload = {

    name:
      $("name").value.trim(),

    type:
      $("type").value.trim(),

    orientation:
      $("orientation").value,

    description:
      $("description").value.trim(),

    issuerName:
      $("issuerName").value.trim(),

    issuerTitle:
      $("issuerTitle").value.trim(),

    background:
      $("background").value.trim(),

    logo:
      $("logo").value.trim(),

    courseId:
      $("courseId").value.trim(),

    updatedAt:
      serverTimestamp()

  };


  try {

    $("saveBtn").disabled = true;

    $("saveBtn").innerHTML = `
      <i class="fa-solid fa-spinner fa-spin"></i>
      Saving...
    `;


    if (id) {

      await updateDoc(
        doc(db, "certificateTemplates", id),
        payload
      );

      showToast(
        "Certificate template updated successfully."
      );

    } else {

      await addDoc(
        collection(db, "certificateTemplates"),
        {
          ...payload,

          createdBy:
            currentUser?.uid || "admin",

          createdAt:
            serverTimestamp()
        }
      );

      showToast(
        "Certificate template created successfully."
      );

    }


    closeModal();

    await loadTemplates();

  } catch (error) {

    console.error(
      "Save template error:",
      error
    );

    showToast(
      error.message || "Failed to save template.",
      true
    );

  } finally {

    $("saveBtn").disabled = false;

    $("saveBtn").innerHTML = `
      <i class="fa-solid fa-save"></i>
      Save Template
    `;

  }

}


/* =====================================================
   VIEW TEMPLATE
===================================================== */

function viewTemplate(id) {

  const template =
    templates.find(t => t.id === id);

  if (!template) return;

  $("viewContent").innerHTML = `

    <div class="view-preview">

      <div
        class="certificate-preview ${escapeHtml(
          String(
            template.orientation ||
            "landscape"
          ).toLowerCase()
        )}"
        style="background:${escapeHtml(
          template.background ||
          "linear-gradient(135deg,#eff6ff,#fff)"
        )}"
      >

        <div class="preview-border">

          <div class="preview-logo">

            ${
              template.logo
                ? `<img
                    src="${escapeHtml(template.logo)}"
                    alt="Logo"
                  >`
                : `<i class="fa-solid fa-graduation-cap"></i>`
            }

          </div>

          <div class="preview-small">
            ${escapeHtml(
              template.issuerName ||
              "LetsStudy Pro"
            )}
          </div>

          <div class="preview-title">
            Certificate of Completion
          </div>

          <div class="preview-name">
            Student Name
          </div>

          <div class="preview-text">
            ${escapeHtml(
              template.description ||
              "Certificate of successful completion."
            )}
          </div>

          <div class="preview-line"></div>

          <div class="preview-signature">
            ${escapeHtml(
              template.issuerTitle ||
              "Authorized Issuer"
            )}
          </div>

        </div>

      </div>

    </div>

    <div class="details-list">

      <div>
        <strong>Name</strong>
        <span>${escapeHtml(template.name || "-")}</span>
      </div>

      <div>
        <strong>Type</strong>
        <span>${escapeHtml(template.type || "-")}</span>
      </div>

      <div>
        <strong>Orientation</strong>
        <span>${escapeHtml(template.orientation || "-")}</span>
      </div>

      <div>
        <strong>Issuer</strong>
        <span>${escapeHtml(template.issuerName || "-")}</span>
      </div>

      <div>
        <strong>Issuer Title</strong>
        <span>${escapeHtml(template.issuerTitle || "-")}</span>
      </div>

      <div>
        <strong>Course ID</strong>
        <span>${escapeHtml(template.courseId || "Global")}</span>
      </div>

    </div>
  `;

  $("viewModal").classList.add("show");

}


function closeViewModal() {

  $("viewModal").classList.remove("show");

}


/* =====================================================
   EDIT
===================================================== */

function editTemplate(id) {

  const template =
    templates.find(t => t.id === id);

  if (!template) return;

  openModal(template);

}


/* =====================================================
   DELETE
===================================================== */

async function deleteTemplate(id) {

  const template =
    templates.find(t => t.id === id);

  if (!template) return;

  const confirmed =
    confirm(
      `Delete "${template.name || "this template"}"?\n\nThis action cannot be undone.`
    );

  if (!confirmed) return;


  try {

    await deleteDoc(
      doc(
        db,
        "certificateTemplates",
        id
      )
    );

    showToast(
      "Certificate template deleted."
    );

    await loadTemplates();

  } catch (error) {

    console.error(
      "Delete template error:",
      error
    );

    showToast(
      error.message ||
      "Failed to delete template.",
      true
    );

  }

}


/* =====================================================
   SEARCH
===================================================== */

$("searchInput").addEventListener(
  "input",
  function () {

    const term =
      this.value
        .trim()
        .toLowerCase();

    document
      .querySelectorAll(".template-card")
      .forEach(card => {

        card.style.display =
          card.textContent
            .toLowerCase()
            .includes(term)
            ? ""
            : "none";

      });

  }
);


/* =====================================================
   REFRESH
===================================================== */

$("refreshBtn").addEventListener(
  "click",
  async () => {

    $("refreshBtn").innerHTML = `
      <i class="fa-solid fa-spinner fa-spin"></i>
    `;

    await loadTemplates();

    $("refreshBtn").innerHTML = `
      <i class="fa-solid fa-rotate"></i>
      Refresh
    `;

  }
);


/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHtml(value) {

  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");

}


/* =====================================================
   ELEMENT HELPER
===================================================== */

function $(id) {

  return document.getElementById(id);

}


/* =====================================================
   TOAST
===================================================== */

let toastTimer;

function showToast(
  message,
  error = false
) {

  const toast =
    $("toast");

  toast.textContent =
    message;

  toast.className =
    "toast show" +
    (error ? " error" : "");

  clearTimeout(toastTimer);

  toastTimer =
    setTimeout(
      () => {
        toast.className =
          "toast";
      },
      3500
    );

}


/* =====================================================
   MODAL OUTSIDE CLICK
===================================================== */

window.addEventListener(
  "click",
  event => {

    if (
      event.target ===
      $("templateModal")
    ) {
      closeModal();
    }

    if (
      event.target ===
      $("viewModal")
    ) {
      closeViewModal();
    }

  }
);


/* =====================================================
   ESC KEY
===================================================== */

document.addEventListener(
  "keydown",
  event => {

    if (event.key !== "Escape")
      return;

    closeModal();
    closeViewModal();

  }
);


/* =====================================================
   AUTH
===================================================== */

onAuthStateChanged(
  auth,
  async user => {

    if (!user) {

      currentUser = null;

      /*
       * Keep page accessible.
       * Firestore rules should control
       * write permissions.
       */

      await loadTemplates();

      return;
    }

    currentUser = user;

    $("adminEmail").textContent =
      user.email ||
      "Administrator";

    await loadTemplates();

  }
);


/* =====================================================
   GLOBAL ERROR HANDLING
===================================================== */

window.addEventListener(
  "unhandledrejection",
  event => {

    console.error(
      "Promise error:",
      event.reason
    );

    showToast(
      "Something went wrong. Check the browser console.",
      true
    );

  }
);

window.addEventListener(
  "error",
  event => {

    console.error(
      "JavaScript error:",
      event.error || event.message
    );

  }
);

</script>

</body>
</html>