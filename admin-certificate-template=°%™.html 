<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Admin Certificate Templates | Let'sStudy Pro</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
*{box-sizing:border-box}

body{
margin:0;
font-family:Arial,Helvetica,sans-serif;
background:#f5f7fb;
color:#172033;
}

.container{
max-width:1150px;
margin:auto;
padding:20px;
}

.admin{
display:inline-flex;
align-items:center;
gap:8px;
background:#172033;
color:#fff;
padding:8px 13px;
border-radius:20px;
font-size:12px;
font-weight:bold;
margin-bottom:15px;
}

.card{
background:#fff;
border-radius:16px;
padding:20px;
margin-bottom:18px;
box-shadow:0 4px 18px rgba(0,0,0,.06);
}

h1,h2{
margin-top:0;
}

.subtitle{
color:#64748b;
font-size:13px;
}

.grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:15px;
}

.full{
grid-column:1/-1;
}

label{
display:block;
font-size:13px;
font-weight:bold;
margin-bottom:7px;
}

input,
select,
textarea{
width:100%;
padding:12px;
border:1px solid #dbe2ea;
border-radius:9px;
outline:none;
font-family:inherit;
}

textarea{
min-height:110px;
resize:vertical;
}

input:focus,
select:focus,
textarea:focus{
border-color:#2563eb;
}

.actions{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-top:15px;
}

button{
border:0;
border-radius:9px;
padding:11px 16px;
cursor:pointer;
font-weight:bold;
}

.primary{
background:#2563eb;
color:#fff;
}

.secondary{
background:#e2e8f0;
color:#334155;
}

.danger{
background:#fee2e2;
color:#dc2626;
}

.search{
margin-bottom:15px;
}

.search input{
max-width:500px;
}

.template{
border:1px solid #e5e7eb;
border-radius:14px;
padding:16px;
margin-bottom:12px;
}

.template-top{
display:flex;
justify-content:space-between;
align-items:flex-start;
gap:15px;
}

.template-name{
font-size:18px;
font-weight:bold;
margin-bottom:7px;
}

.description{
color:#64748b;
font-size:13px;
line-height:1.6;
}

.meta{
display:flex;
flex-wrap:wrap;
gap:7px;
margin-top:12px;
}

.badge{
background:#f1f5f9;
color:#475569;
padding:6px 9px;
border-radius:20px;
font-size:11px;
}

.item-actions{
display:flex;
gap:7px;
flex-wrap:wrap;
}

.message{
display:none;
padding:12px;
border-radius:9px;
margin-bottom:15px;
font-size:13px;
}

.message.success{
display:block;
background:#dcfce7;
color:#166534;
}

.message.error{
display:block;
background:#fee2e2;
color:#991b1b;
}

.empty{
text-align:center;
padding:40px 20px;
color:#64748b;
}

.preview{
margin-top:15px;
border:1px dashed #cbd5e1;
border-radius:12px;
padding:20px;
text-align:center;
display:none;
}

.preview img{
max-width:100%;
max-height:180px;
object-fit:contain;
border-radius:8px;
}

@media(max-width:700px){

.grid{
grid-template-columns:1fr;
}

.full{
grid-column:auto;
}

.template-top{
flex-direction:column;
}

}
</style>
</head>

<body>

<div class="container">

<div class="admin">
<i class="fa-solid fa-shield-halved"></i>
ADMIN
</div>


<div class="card">

<h1>
<i class="fa-solid fa-certificate"></i>
Certificate Templates
</h1>

<p class="subtitle">
Create and manage certificate templates for courses.
</p>

</div>


<div id="message" class="message"></div>


<!-- FORM -->

<div class="card">

<h2 id="formTitle">
Add Certificate Template
</h2>

<form id="templateForm">

<div class="grid">


<div>

<label>
Template Name
</label>

<input
id="name"
type="text"
placeholder="e.g. Professional Course Certificate"
required>

</div>


<div>

<label>
Type
</label>

<select id="type">

<option value="course">
Course Certificate
</option>

<option value="completion">
Completion Certificate
</option>

<option value="achievement">
Achievement Certificate
</option>

<option value="professional">
Professional Certificate
</option>

<option value="custom">
Custom
</option>

</select>

</div>


<div>

<label>
Orientation
</label>

<select id="orientation">

<option value="landscape">
Landscape
</option>

<option value="portrait">
Portrait
</option>

</select>

</div>


<div>

<label>
Course ID
</label>

<input
id="courseId"
type="text"
placeholder="Course ID">

</div>


<div>

<label>
Issuer Name
</label>

<input
id="issuerName"
type="text"
placeholder="Let'sStudy Pro"
required>

</div>


<div>

<label>
Issuer Title
</label>

<input
id="issuerTitle"
type="text"
placeholder="Director / CEO / Instructor"
required>

</div>


<div>

<label>
Background URL
</label>

<input
id="background"
type="url"
placeholder="https://...">

</div>


<div>

<label>
Logo URL
</label>

<input
id="logo"
type="url"
placeholder="https://...">

</div>


<div class="full">

<label>
Description
</label>

<textarea
id="description"
placeholder="Describe this certificate template..."></textarea>

</div>

</div>


<div
id="preview"
class="preview">

<strong>
Template Preview
</strong>

<br><br>

<img
id="logoPreview"
style="display:none">

<br>

<span id="previewName">
Certificate Template
</span>

</div>


<div class="actions">

<button
type="submit"
id="saveBtn"
class="primary">

<i class="fa-solid fa-plus"></i>

Add Template

</button>


<button
type="button"
id="cancelBtn"
class="secondary"
style="display:none">

Cancel

</button>

</div>

</form>

</div>


<!-- LIST -->

<div class="card">

<h2>
All Certificate Templates
</h2>

<div class="search">

<input
id="searchInput"
type="search"
placeholder="Search templates...">

</div>


<div id="templateList">

<div class="empty">

<i class="fa-solid fa-spinner fa-spin"></i>

<br><br>

Loading templates...

</div>

</div>

</div>

</div>


<script type="module">

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.7.0/firebase-app.js";

import {
getFirestore,
collection,
addDoc,
getDocs,
doc,
updateDoc,
deleteDoc,
serverTimestamp
}
from
"https://www.gstatic.com/firebasejs/12.7.0/firebase-firestore.js";

import {
getAuth,
onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.7.0/firebase-auth.js";


/* ==========================================
   FIREBASE
========================================== */

const firebaseConfig={

apiKey:
"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};


const app=
initializeApp(firebaseConfig);

const db=
getFirestore(app);

const auth=
getAuth(app);


/* ==========================================
   ELEMENTS
========================================== */

const form=
document.getElementById(
"templateForm"
);

const nameInput=
document.getElementById(
"name"
);

const typeInput=
document.getElementById(
"type"
);

const orientationInput=
document.getElementById(
"orientation"
);

const descriptionInput=
document.getElementById(
"description"
);

const issuerNameInput=
document.getElementById(
"issuerName"
);

const issuerTitleInput=
document.getElementById(
"issuerTitle"
);

const backgroundInput=
document.getElementById(
"background"
);

const logoInput=
document.getElementById(
"logo"
);

const courseIdInput=
document.getElementById(
"courseId"
);

const templateList=
document.getElementById(
"templateList"
);

const searchInput=
document.getElementById(
"searchInput"
);

const saveBtn=
document.getElementById(
"saveBtn"
);

const cancelBtn=
document.getElementById(
"cancelBtn"
);

const formTitle=
document.getElementById(
"formTitle"
);

const message=
document.getElementById(
"message"
);

const preview=
document.getElementById(
"preview"
);

const logoPreview=
document.getElementById(
"logoPreview"
);

const previewName=
document.getElementById(
"previewName"
);


let templates=[];

let editId=null;

let currentUser=null;


/* ==========================================
   ESCAPE
========================================== */

function esc(value){

return String(value ?? "")
.replaceAll("&","&amp;")
.replaceAll("<","&lt;")
.replaceAll(">","&gt;")
.replaceAll('"',"&quot;")
.replaceAll("'","&#039;");

}


/* ==========================================
   MESSAGE
========================================== */

function showMessage(
text,
error=false
){

message.textContent=text;

message.className=
"message "+
(error?"error":"success");

setTimeout(()=>{

message.className=
"message";

},4000);

}


/* ==========================================
   LOAD
========================================== */

async function loadTemplates(){

templateList.innerHTML=`

<div class="empty">

<i class="fa-solid fa-spinner fa-spin"></i>

<br><br>

Loading templates...

</div>

`;


try{

const snapshot=
await getDocs(
collection(
db,
"certificateTemplates"
)
);


templates=
snapshot.docs.map(
d=>({

id:d.id,

...d.data()

})
);


renderTemplates();

}catch(error){

console.error(error);

templateList.innerHTML=`

<div class="empty">

<i class="fa-solid fa-triangle-exclamation"></i>

<br><br>

${esc(error.message)}

</div>

`;

}

}


/* ==========================================
   RENDER
========================================== */

function renderTemplates(){

const q=
searchInput.value
.trim()
.toLowerCase();


const filtered=
templates.filter(t=>{

return(

String(
t.name||""
)
.toLowerCase()
.includes(q)

||

String(
t.courseId||""
)
.toLowerCase()
.includes(q)

||

String(
t.type||""
)
.toLowerCase()
.includes(q)

||

String(
t.issuerName||""
)
.toLowerCase()
.includes(q)

);

});


if(!filtered.length){

templateList.innerHTML=`

<div class="empty">

<i class="fa-solid fa-folder-open"></i>

<br><br>

No certificate templates found.

</div>

`;

return;

}


templateList.innerHTML=
filtered.map(t=>`

<div class="template">

<div class="template-top">

<div>

<div class="template-name">

<i class="fa-solid fa-certificate"></i>

${esc(t.name)}

</div>


<div class="description">

${esc(
t.description||
"No description."
)}

</div>


<div class="meta">

<span class="badge">

Type:
${esc(t.type||"-")}

</span>


<span class="badge">

Orientation:
${esc(t.orientation||"-")}

</span>


<span class="badge">

Course:
${esc(t.courseId||"All Courses")}

</span>


<span class="badge">

Issuer:
${esc(t.issuerName||"-")}

</span>


<span class="badge">

ID:
${esc(t.id)}

</span>

</div>

</div>


<div class="item-actions">

<button
class="secondary"
title="Edit"
onclick="editTemplate('${t.id}')">

<i class="fa-solid fa-pen"></i>

</button>


<button
class="danger"
title="Delete"
onclick="deleteTemplate('${t.id}')">

<i class="fa-solid fa-trash"></i>

</button>

</div>

</div>

</div>

`).join("");

}


/* ==========================================
   CREATE / UPDATE
========================================== */

form.addEventListener(
"submit",
async e=>{

e.preventDefault();


if(!currentUser){

showMessage(
"Admin login required.",
true
);

return;

}


const data={

name:
nameInput.value.trim(),

type:
typeInput.value,

orientation:
orientationInput.value,

description:
descriptionInput.value.trim(),

issuerName:
issuerNameInput.value.trim(),

issuerTitle:
issuerTitleInput.value.trim(),

background:
backgroundInput.value.trim(),

logo:
logoInput.value.trim(),

courseId:
courseIdInput.value.trim()

};


if(!data.name){

showMessage(
"Template name is required.",
true
);

return;

}


if(!data.issuerName){

showMessage(
"Issuer name is required.",
true
);

return;

}


if(!data.issuerTitle){

showMessage(
"Issuer title is required.",
true
);

return;

}


saveBtn.disabled=true;


try{


/* UPDATE */

if(editId){

await updateDoc(

doc(
db,
"certificateTemplates",
editId
),

{

...data,

updatedAt:
serverTimestamp()

}

);


showMessage(
"Certificate template updated successfully."
);

}


/* CREATE */

else{

const templateRef=
await addDoc(

collection(
db,
"certificateTemplates"
),

{

name:
data.name,

type:
data.type,

orientation:
data.orientation,

description:
data.description,

issuerName:
data.issuerName,

issuerTitle:
data.issuerTitle,

background:
data.background,

logo:
data.logo,

courseId:
data.courseId,

createdBy:
currentUser.uid,

createdAt:
serverTimestamp(),

updatedAt:
serverTimestamp()

}

);


console.log(
"Automatic Template ID:",
templateRef.id
);


showMessage(
"Certificate template created successfully."
);

}


resetForm();

await loadTemplates();

}catch(error){

console.error(error);

showMessage(
error.message,
true
);

}


saveBtn.disabled=false;

});


/* ==========================================
   EDIT
========================================== */

window.editTemplate=function(id){

const t=
templates.find(
x=>x.id===id
);

if(!t)return;


editId=id;

nameInput.value=
t.name||"";

typeInput.value=
t.type||"course";

orientationInput.value=
t.orientation||"landscape";

descriptionInput.value=
t.description||"";

issuerNameInput.value=
t.issuerName||"";

issuerTitleInput.value=
t.issuerTitle||"";

backgroundInput.value=
t.background||"";

logoInput.value=
t.logo||"";

courseIdInput.value=
t.courseId||"";


formTitle.textContent=
"Edit Certificate Template";


saveBtn.innerHTML=`

<i class="fa-solid fa-save"></i>

Update Template

`;

cancelBtn.style.display=
"inline-block";


updatePreview();


window.scrollTo({

top:0,

behavior:"smooth"

});

};


/* ==========================================
   DELETE
========================================== */

window.deleteTemplate=
async function(id){

const t=
templates.find(
x=>x.id===id
);

if(!t)return;


if(
!confirm(
`Delete "${t.name}"?`
)
)return;


try{

await deleteDoc(

doc(
db,
"certificateTemplates",
id
)

);


showMessage(
"Certificate template deleted."
);


await loadTemplates();

}catch(error){

console.error(error);

showMessage(
error.message,
true
);

}

};


/* ==========================================
   RESET
========================================== */

function resetForm(){

editId=null;

form.reset();

typeInput.value="course";

orientationInput.value="landscape";

formTitle.textContent=
"Add Certificate Template";


saveBtn.innerHTML=`

<i class="fa-solid fa-plus"></i>

Add Template

`;

cancelBtn.style.display=
"none";

preview.style.display=
"none";

}


cancelBtn.addEventListener(
"click",
resetForm
);


/* ==========================================
   PREVIEW
========================================== */

function updatePreview(){

if(
!nameInput.value &&
!logoInput.value
){

preview.style.display=
"none";

return;

}


preview.style.display=
"block";

previewName.textContent=
nameInput.value||
"Certificate Template";


if(logoInput.value){

logoPreview.src=
logoInput.value;

logoPreview.style.display=
"inline-block";

logoPreview.onerror=()=>{
logoPreview.style.display="none";
};

}else{

logoPreview.style.display=
"none";

}

}


nameInput.addEventListener(
"input",
updatePreview
);

logoInput.addEventListener(
"input",
updatePreview
);


/* ==========================================
   SEARCH
========================================== */

searchInput.addEventListener(
"input",
renderTemplates
);


/* ==========================================
   AUTH
========================================== */

onAuthStateChanged(
auth,
async user=>{

if(!user){

currentUser=null;

templateList.innerHTML=`

<div class="empty">

<i class="fa-solid fa-lock"></i>

<br><br>

Admin login required.

</div>

`;

return;

}


currentUser=user;

await loadTemplates();

});

</script>

</body>
</html>