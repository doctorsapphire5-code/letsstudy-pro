<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Inter,Arial,sans-serif;background:#f8fafc;color:#0f172a}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
.topbar{height:68px;background:#fff;border-bottom:1px solid #e5e7eb;display:flex;align-items:center;justify-content:space-between;padding:0 25px;position:sticky;top:0;z-index:100}
.brand{display:flex;align-items:center;gap:9px;font-weight:800;color:#111827;text-decoration:none}
.brand-icon{width:38px;height:38px;border-radius:10px;background:#2563eb;color:#fff;display:grid;place-items:center}
.brand span{color:#2563eb}
.actions{display:flex;gap:8px}
.icon-btn{width:40px;height:40px;border:1px solid #e5e7eb;background:#fff;border-radius:9px;color:#475569}
.layout{display:flex;min-height:calc(100vh - 68px)}
.sidebar{width:235px;background:#fff;border-right:1px solid #e5e7eb;padding:20px 13px}
.nav-title{font-size:10px;font-weight:800;color:#94a3b8;text-transform:uppercase;margin:14px 10px 8px}
.nav{display:flex;align-items:center;gap:10px;padding:11px 12px;border-radius:9px;color:#64748b;text-decoration:none;font-size:12px;font-weight:600;margin-bottom:3px}
.nav:hover,.nav.active{background:#eff6ff;color:#2563eb}
.nav i{width:18px;text-align:center}
.main{flex:1;padding:28px;min-width:0}
.header{display:flex;justify-content:space-between;align-items:flex-start;gap:15px;margin-bottom:22px}
.header h1{font-size:25px;font-weight:800;margin-bottom:6px}
.header p{font-size:12px;color:#64748b}
.btn{border:0;border-radius:9px;padding:11px 15px;font-size:11px;font-weight:700;display:inline-flex;align-items:center;gap:7px}
.primary{background:#2563eb;color:#fff}
.primary:hover{background:#1d4ed8}
.light{background:#fff;color:#475569;border:1px solid #e5e7eb}
.toolbar{background:#fff;border:1px solid #e5e7eb;border-radius:13px;padding:14px;display:flex;gap:10px;margin-bottom:18px}
.search{position:relative;flex:1}
.search i{position:absolute;left:12px;top:12px;color:#94a3b8;font-size:12px}
.search input{width:100%;height:38px;border:1px solid #e5e7eb;border-radius:8px;padding:0 12px 0 34px;outline:0;font-size:11px}
.search input:focus,select:focus,input:focus,textarea:focus{border-color:#2563eb;box-shadow:0 0 0 3px #2563eb12}
select{height:38px;border:1px solid #e5e7eb;border-radius:8px;padding:0 12px;background:#fff;color:#475569;font-size:11px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}
.stat{background:#fff;border:1px solid #e5e7eb;border-radius:13px;padding:17px}
.stat-icon{width:35px;height:35px;border-radius:9px;background:#eff6ff;color:#2563eb;display:grid;place-items:center;margin-bottom:10px}
.stat-label{font-size:10px;color:#64748b;margin-bottom:4px}
.stat-value{font-size:19px;font-weight:800}
.card{background:#fff;border:1px solid #e5e7eb;border-radius:14px;overflow:hidden}
.card-head{padding:17px 18px;border-bottom:1px solid #e5e7eb;display:flex;justify-content:space-between;align-items:center}
.card-head h2{font-size:14px}
.table-wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse}
th{background:#f8fafc;text-align:left;font-size:10px;color:#64748b;padding:12px 15px;white-space:nowrap}
td{padding:13px 15px;border-top:1px solid #f1f5f9;font-size:11px;vertical-align:middle}
.template-name{font-weight:700}
.muted{color:#64748b;font-size:10px}
.badge{display:inline-flex;padding:5px 8px;border-radius:999px;background:#eff6ff;color:#2563eb;font-size:9px;font-weight:700}
.orientation{font-size:10px;color:#64748b;text-transform:capitalize}
.row-actions{display:flex;gap:5px}
.action{width:32px;height:32px;border:1px solid #e5e7eb;background:#fff;border-radius:7px;color:#64748b}
.action:hover{background:#f8fafc;color:#2563eb}
.action.delete:hover{color:#dc2626}
.empty,.loading{text-align:center;padding:65px 20px;color:#64748b;font-size:11px}
.empty i,.loading i{font-size:30px;margin-bottom:12px;color:#94a3b8}
.spinner{animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.modal{position:fixed;inset:0;background:#0f172a99;display:none;align-items:center;justify-content:center;padding:20px;z-index:1000}
.modal.show{display:flex}
.modal-box{width:min(700px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:16px}
.modal-head{padding:18px 20px;border-bottom:1px solid #e5e7eb;display:flex;justify-content:space-between;align-items:center}
.modal-head h2{font-size:16px}
.close{border:0;background:none;font-size:20px;color:#64748b}
.modal-body{padding:20px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}
.field{display:flex;flex-direction:column;gap:6px}
.field.full{grid-column:1/-1}
.field label{font-size:10px;font-weight:700;color:#475569}
.field input,.field select,.field textarea{width:100%;border:1px solid #e5e7eb;border-radius:8px;padding:10px;font-size:11px;outline:0}
.field textarea{min-height:90px;resize:vertical}
.modal-foot{padding:15px 20px;border-top:1px solid #e5e7eb;display:flex;justify-content:flex-end;gap:8px}
.preview{background:#f1f5f9;padding:25px;border-radius:10px;margin-top:15px}
.certificate-preview{background:#fff;border:8px solid #d4af37;min-height:280px;padding:30px;text-align:center;display:flex;flex-direction:column;justify-content:center}
.certificate-preview img{max-width:90px;max-height:55px;object-fit:contain;margin:0 auto 10px}
.certificate-preview h2{font-family:Georgia,serif;font-size:25px;margin:8px 0}
.certificate-preview h3{font-size:17px;margin-top:12px}
.certificate-preview p{font-size:10px;color:#64748b;line-height:1.6}
.toast{position:fixed;right:20px;bottom:20px;background:#0f172a;color:#fff;padding:12px 16px;border-radius:9px;font-size:11px;transform:translateY(100px);opacity:0;transition:.3s;z-index:2000}
.toast.show{transform:translateY(0);opacity:1}
.toast.error{background:#dc2626}
@media(max-width:900px){
.sidebar{width:200px}.stats{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:700px){
.sidebar{display:none}.main{padding:17px}.header{flex-direction:column}.toolbar{flex-direction:column}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}
}
@media(max-width:450px){.stats{grid-template-columns:1fr}}
</style>
</head>

