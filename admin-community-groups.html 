/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHtml(
  value
){

  return String(
    value ?? ""
  )
  .replace(
    /&/g,
    "&amp;"
  )
  .replace(
    /</g,
    "&lt;"
  )
  .replace(
    />/g,
    "&gt;"
  )
  .replace(
    /"/g,
    "&quot;"
  )
  .replace(
    /'/g,
    "&#039;"
  );

}


/* =====================================================
   CREATE GROUP
===================================================== */

async function createGroup(){

  const name =
    document.getElementById(
      "groupName"
    )?.value.trim();

  const description =
    document.getElementById(
      "groupDescription"
    )?.value.trim();


  if(!name){

    showToast(
      "Enter a group name.",
      "error"
    );

    return;

  }


  try{

    const groupRef =
      push(
        ref(
          db,
          "groups"
        )
      );

    await set(
      groupRef,
      {

        id:
          groupRef.key,

        name,

        description,

        memberCount:
          0,

        createdAt:
          Date.now(),

        updatedAt:
          Date.now(),

        createdBy:
          auth.currentUser.uid

      }
    );


    showToast(
      "Community group created successfully.",
      "success"
    );


    document.getElementById(
      "groupName"
    ).value = "";

    document.getElementById(
      "groupDescription"
    ).value = "";


    await refreshGroups();

  }catch(error){

    console.error(
      error
    );

    showToast(
      "Failed to create group.",
      "error"
    );

  }

}


/* =====================================================
   DELETE GROUP
===================================================== */

async function deleteGroup(
  groupId
){

  if(
    !confirm(
      "Delete this community group?"
    )
  ){

    return;

  }


  try{

    await remove(
      ref(
        db,
        "groups/" +
        groupId
      )
    );


    showToast(
      "Group deleted.",
      "success"
    );


    await refreshGroups();

  }catch(error){

    console.error(
      error
    );

    showToast(
      "Unable to delete group.",
      "error"
    );

  }

}


/* =====================================================
   REFRESH
===================================================== */

async function refreshGroups(){

  try{

    const groups =
      await loadGroups();

    renderGroups(
      groups
    );

  }catch(error){

    console.error(
      "Loading groups failed:",
      error
    );

    showToast(
      "Unable to load community groups.",
      "error"
    );

  }

}


/* =====================================================
   AUTH STATE
===================================================== */

onAuthStateChanged(
  auth,
  async user => {

    try{

      if(!user){

        window.location.replace(
          "login.html?redirect=" +
          encodeURIComponent(
            "admin-community-groups.html"
          )
        );

        return;

      }


      const isAdmin =
        await checkAdminAccess(
          user
        );


      if(!isAdmin){

        if(loadingScreen)
          loadingScreen.style.display =
            "none";

        if(accessDenied)
          accessDenied.style.display =
            "block";

        return;

      }


      if(accessDenied)
        accessDenied.style.display =
          "none";

      if(adminContent)
        adminContent.style.display =
          "block";

      if(loadingScreen)
        loadingScreen.style.display =
          "none";


      await refreshGroups();


    }catch(error){

      console.error(
        "Admin initialization error:",
        error
      );

      showToast(
        "Unable to initialize admin page.",
        "error"
      );

    }

  }
);


/* =====================================================
   EVENTS
===================================================== */

document.addEventListener(
  "click",
  event => {

    const button =
      event.target.closest(
        "[data-action]"
      );

    if(!button){

      return;

    }

    const action =
      button.dataset.action;

    const id =
      button.dataset.id;


    if(
      action === "delete"
    ){

      deleteGroup(id);

    }


    if(
      action === "view"
    ){

      window.location.href =
        "community-group.html?id=" +
        encodeURIComponent(id);

    }


    if(
      action === "edit"
    ){

      window.location.href =
        "admin-community.html?id=" +
        encodeURIComponent(id);

    }

  }
);


