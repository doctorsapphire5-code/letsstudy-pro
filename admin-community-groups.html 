<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Community Groups Admin | LetsStudy Pro</title>

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Inter,Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
}

header{
  background:linear-gradient(135deg,#111827,#2563eb);
  color:white;
  padding:22px;
}

.header-inner{
  max-width:1250px;
  margin:auto;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
}

.brand h1{
  font-size:24px;
}

.brand p{
  opacity:.8;
  margin-top:4px;
  font-size:13px;
}

.container{
  max-width:1250px;
  margin:25px auto;
  padding:0 16px;
}

.toolbar{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-bottom:20px;
}

button,
input,
select,
textarea{
  font:inherit;
}

button{
  border:0;
  cursor:pointer;
}

.btn{
  padding:11px 16px;
  border-radius:10px;
  font-weight:600;
}

.btn-primary{
  background:#2563eb;
  color:white;
}

.btn-success{
  background:#16a34a;
  color:white;
}

.btn-danger{
  background:#dc2626;
  color:white;
}

.btn-secondary{
  background:#e5e7eb;
  color:#111827;
}

.search{
  flex:1;
  min-width:220px;
  padding:12px 14px;
  border:1px solid #d1d5db;
  border-radius:10px;
  background:white;
}

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
  margin-bottom:22px;
}

.stat{
  background:white;
  border-radius:15px;
  padding:20px;
  box-shadow:0 4px 15px rgba(0,0,0,.06);
}

.stat span{
  display:block;
  color:#6b7280;
  font-size:13px;
}

.stat strong{
  display:block;
  font-size:28px;
  margin-top:7px;
}

.groups{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(280px,1fr));
  gap:18px;
}

.group-card{
  background:white;
  border-radius:16px;
  overflow:hidden;
  box-shadow:0 4px 18px rgba(0,0,0,.07);
  border:1px solid #edf0f5;
}

.group-image{
  height:150px;
  background:#dbeafe;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:48px;
  overflow:hidden;
}

.group-image img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.group-body{
  padding:17px;
}

.group-title{
  font-size:19px;
  font-weight:700;
  margin-bottom:7px;
}

.group-description{
  color:#6b7280;
  font-size:14px;
  line-height:1.5;
  min-height:42px;
}

.badges{
  display:flex;
  gap:7px;
  flex-wrap:wrap;
  margin:12px 0;
}

.badge{
  padding:5px 9px;
  border-radius:20px;
  font-size:11px;
  font-weight:700;
  background:#eff6ff;
  color:#2563eb;
}

.badge.private{
  background:#fff7ed;
  color:#ea580c;
}

.group-meta{
  display:flex;
  justify-content:space-between;
  color:#6b7280;
  font-size:12px;
  margin-bottom:14px;
}

.actions{
  display:flex;
  gap:8px;
}

.actions button{
  flex:1;
  padding:9px;
  border-radius:8px;
}

.empty{
  background:white;
  padding:50px;
  text-align:center;
  border-radius:15px;
  color:#6b7280;
}

.loading{
  text-align:center;
  padding:40px;
  color:#6b7280;
}

.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.55);
  display:none;
  align-items:center;
  justify-content:center;
  padding:20px;
  z-index:999;
}

.modal.show{
  display:flex;
}

.modal-box{
  background:white;
  width:100%;
  max-width:600px;
  max-height:90vh;
  overflow:auto;
  border-radius:18px;
  padding:24px;
}

.modal-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
}

.close{
  width:36px;
  height:36px;
  border-radius:50%;
  background:#f3f4f6;
}

.form-group{
  margin-bottom:15px;
}

.form-group label{
  display:block;
  font-size:13px;
  font-weight:700;
  margin-bottom:6px;
}

.form-group input,
.form-group select,
.form-group textarea{
  width:100%;
  padding:11px 12px;
  border:1px solid #d1d5db;
  border-radius:9px;
  outline:none;
}

.form-group textarea{
  min-height:110px;
  resize:vertical;
}

.form-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.modal-footer{
  display:flex;
  justify-content:flex-end;
  gap:10px;
  margin-top:20px;
}

.toast{
  position:fixed;
  right:20px;
  bottom:20px;
  background:#111827;
  color:white;
  padding:14px 18px;
  border-radius:10px;
  display:none;
  z-index:2000;
}

.toast.show{
  display:block;
}

@media(max-width:800px){

  .stats{
    grid-template-columns:repeat(2,1fr);
  }

}

@media(max-width:550px){

  .stats{
    grid-template-columns:1fr;
  }

  .form-row{
    grid-template-columns:1fr;
  }

  .header-inner{
    align-items:flex-start;
    flex-direction:column;
  }

}

</style>

</head>

<body>

<header>

<div class="header-inner">

<div class="brand">

<h1>👥 Community Groups</h1>

<p>LetsStudy Pro Administration</p>

</div>

<button
  class="btn btn-success"
  onclick="openCreateModal()">
  + Create Group
</button>

</div>

</header>


<main class="container">


<div class="stats">

<div class="stat">
<span>Total Groups</span>
<strong id="totalGroups">0</strong>
</div>

<div class="stat">
<span>Public Groups</span>
<strong id="publicGroups">0</strong>
</div>

<div class="stat">
<span>Private Groups</span>
<strong id="privateGroups">0</strong>
</div>

<div class="stat">
<span>Total Members</span>
<strong id="totalMembers">0</strong>
</div>

</div>


<div class="toolbar">

<input
  id="searchInput"
  class="search"
  type="search"
  placeholder="Search groups..."
  oninput="renderGroups()">

<select
  id="categoryFilter"
  class="search"
  onchange="renderGroups()">

<option value="">All Categories</option>
<option value="Academic">Academic</option>
<option value="Technology">Technology</option>
<option value="Business">Business</option>
<option value="Career">Career</option>
<option value="Scholarships">Scholarships</option>
<option value="General">General</option>

</select>

<button
  class="btn btn-secondary"
  onclick="loadGroups()">
  ↻ Refresh
</button>

</div>


<div id="loading" class="loading">
Loading groups...
</div>


<div id="groupsContainer" class="groups"></div>


<div id="emptyState" class="empty" style="display:none">

<h2>No groups found</h2>

<p>Create your first community group.</p>

<br>

<button
  class="btn btn-primary"
  onclick="openCreateModal()">

+ Create Group

</button>

</div>


</main>


<!-- CREATE / EDIT MODAL -->

<div
  id="groupModal"
  class="modal">

<div class="modal-box">

<div class="modal-header">

<h2 id="modalTitle">
Create Community Group
</h2>

<button
  class="close"
  onclick="closeModal()">

✕

</button>

</div>


<form id="groupForm">


<div class="form-group">

<label>Group Name</label>

<input
  id="groupName"
  type="text"
  required
  placeholder="e.g. A-Level Physics Students">

</div>


<div class="form-row">

<div class="form-group">

<label>Category</label>

<select
  id="groupCategory"
  required>

<option value="Academic">Academic</option>
<option value="Technology">Technology</option>
<option value="Business">Business</option>
<option value="Career">Career</option>
<option value="Scholarships">Scholarships</option>
<option value="General">General</option>

</select>

</div>


<div class="form-group">

<label>Visibility</label>

<select id="groupVisibility">

<option value="public">Public</option>
<option value="private">Private</option>

</select>

</div>

</div>


<div class="form-group">

<label>Description</label>

<textarea
  id="groupDescription"
  placeholder="Describe this group..."></textarea>

</div>


<div class="form-group">

<label>Group Image URL</label>

<input
  id="groupImage"
  type="url"
  placeholder="https://example.com/group.jpg">

</div>


<div class="form-group">

<label>Group Rules</label>

<textarea
  id="groupRules"
  placeholder="1. Respect other members&#10;2. No spam&#10;3. Educational content only"></textarea>

</div>


<div class="form-group">

<label>Initial Members</label>

<input
  id="groupMembers"
  type="number"
  min="0"
  value="0">

</div>


<div class="modal-footer">

<button
  type="button"
  class="btn btn-secondary"
  onclick="closeModal()">

Cancel

</button>

<button
  type="submit"
  class="btn btn-primary">

<span id="saveText">
Create Group
</span>

</button>

</div>


</form>

</div>

</div>


<div id="toast" class="toast"></div>


<script type="module">

import {
  initializeApp
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";


import {
  getAuth,
  onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";


import {
  getFirestore,
  collection,
  addDoc,
  getDocs,
  doc,
  updateDoc,
  deleteDoc,
  serverTimestamp,
  query,
  orderBy
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";


const firebaseConfig = {

  apiKey:
    "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-85B7V5H5J0"

};


const app =
  initializeApp(firebaseConfig);


const auth =
  getAuth(app);


const db =
  getFirestore(app);


const groupsRef =
  collection(
    db,
    "communityGroups"
  );


let groups = [];

let editingId = null;


/* =====================================
   AUTH
===================================== */

onAuthStateChanged(
  auth,
  user => {

    console.log(
      "Current user:",
      user ? user.uid : "Guest"
    );

  }
);


/* =====================================
   LOAD GROUPS
===================================== */

async function loadGroups(){

  const loading =
    document.getElementById("loading");

  loading.style.display =
    "block";

  try{

    const q =
      query(
        groupsRef,
        orderBy(
          "createdAt",
          "desc"
        )
      );

    const snapshot =
      await getDocs(q);

    groups =
      snapshot.docs.map(
        item => ({

          id:item.id,

          ...item.data()

        })
      );

  }
  catch(error){

    console.error(
      "Load groups error:",
      error
    );

    /*
      Fallback without orderBy
      in case createdAt index/data
      is unavailable.
    */

    try{

      const snapshot =
        await getDocs(groupsRef);

      groups =
        snapshot.docs.map(
          item => ({

            id:item.id,

            ...item.data()

          })
        );

    }
    catch(secondError){

      console.error(
        secondError
      );

      showToast(
        "Unable to load groups"
      );

    }

  }

  loading.style.display =
    "none";

  renderGroups();

}


window.loadGroups =
  loadGroups;


/* =====================================
   RENDER GROUPS
===================================== */

function renderGroups(){

  const container =
    document.getElementById(
      "groupsContainer"
    );

  const empty =
    document.getElementById(
      "emptyState"
    );

  const search =
    document.getElementById(
      "searchInput"
    ).value
      .toLowerCase()
      .trim();

  const category =
    document.getElementById(
      "categoryFilter"
    ).value;


  const filtered =
    groups.filter(
      group => {

        const name =
          String(
            group.name || ""
          ).toLowerCase();

        const description =
          String(
            group.description || ""
          ).toLowerCase();

        const matchesSearch =
          !search ||
          name.includes(search) ||
          description.includes(search);

        const matchesCategory =
          !category ||
          group.category === category;

        return (
          matchesSearch &&
          matchesCategory
        );

      }
    );


  container.innerHTML =
    "";


  if(!filtered.length){

    container.style.display =
      "none";

    empty.style.display =
      "block";

    updateStats();

    return;

  }


  container.style.display =
    "grid";

  empty.style.display =
    "none";


  filtered.forEach(
    group => {

      const card =
        document.createElement(
          "div"
        );

      card.className =
        "group-card";


      const image =
        group.image
          ? `
            <img
              src="${escapeAttribute(group.image)}"
              alt="Group image"
              onerror="this.style.display='none'">
          `
          : "👥";


      card.innerHTML = `

        <div class="group-image">

          ${image}

        </div>


        <div class="group-body">

          <div class="group-title">

            ${escapeHTML(
              group.name ||
              "Untitled Group"
            )}

          </div>


          <div class="group-description">

            ${escapeHTML(
              group.description ||
              "No description"
            )}

          </div>


          <div class="badges">

            <span class="badge">

              ${escapeHTML(
                group.category ||
                "General"
              )}

            </span>


            <span class="badge ${
              group.visibility ===
              "private"
              ? "private"
              : ""
            }">

              ${
                group.visibility ===
                "private"
                ? "🔒 Private"
                : "🌎 Public"
              }

            </span>

          </div>


          <div class="group-meta">

            <span>

              👥 ${
                Number(
                  group.membersCount || 0
                )
              } members

            </span>


            <span>

              ${
                formatDate(
                  group.createdAt
                )
              }

            </span>

          </div>


          <div class="actions">

            <button
              class="btn-secondary"
              onclick="editGroup('${group.id}')">

              ✏️ Edit

            </button>


            <button
              class="btn-danger"
              onclick="removeGroup('${group.id}')">

              🗑 Delete

            </button>

          </div>

        </div>

      `;


      container.appendChild(card);

    }
  );


  updateStats();

}


/* =====================================
   STATS
===================================== */

function updateStats(){

  document.getElementById(
    "totalGroups"
  ).textContent =
    groups.length;


  document.getElementById(
    "publicGroups"
  ).textContent =
    groups.filter(
      g =>
        g.visibility !== "private"
    ).length;


  document.getElementById(
    "privateGroups"
  ).textContent =
    groups.filter(
      g =>
        g.visibility === "private"
    ).length;


  document.getElementById(
    "totalMembers"
  ).textContent =
    groups.reduce(
      (
        total,
        group
      ) =>
        total +
        Number(
          group.membersCount || 0
        ),
      0
    );

}


/* =====================================
   CREATE MODAL
===================================== */

function openCreateModal(){

  editingId =
    null;


  document.getElementById(
    "modalTitle"
  ).textContent =
    "Create Community Group";


  document.getElementById(
    "saveText"
  ).textContent =
    "Create Group";


  document.getElementById(
    "groupForm"
  ).reset();


  document.getElementById(
    "groupMembers"
  ).value =
    "0";


  document.getElementById(
    "groupModal"
  ).classList.add(
    "show"
  );

}


window.openCreateModal =
  openCreateModal;


/* =====================================
   EDIT GROUP
===================================== */

function editGroup(id){

  const group =
    groups.find(
      item =>
        item.id === id
    );


  if(!group){

    showToast(
      "Group not found"
    );

    return;

  }


  editingId =
    id;


  document.getElementById(
    "modalTitle"
  ).textContent =
    "Edit Community Group";


  document.getElementById(
    "saveText"
  ).textContent =
    "Save Changes";


  document.getElementById(
    "groupName"
  ).value =
    group.name || "";


  document.getElementById(
    "groupCategory"
  ).value =
    group.category ||
    "General";


  document.getElementById(
    "groupVisibility"
  ).value =
    group.visibility ||
    "public";


  document.getElementById(
    "groupDescription"
  ).value =
    group.description ||
    "";


  document.getElementById(
    "groupImage"
  ).value =
    group.image ||
    "";


  document.getElementById(
    "groupRules"
  ).value =
    group.rules ||
    "";


  document.getElementById(
    "groupMembers"
  ).value =
    Number(
      group.membersCount || 0
    );


  document.getElementById(
    "groupModal"
  ).classList.add(
    "show"
  );

}


window.editGroup =
  editGroup;


/* =====================================
   SAVE GROUP
===================================== */

document.getElementById(
  "groupForm"
).addEventListener(
  "submit",
  async event => {

    event.preventDefault();


    const saveButton =
      event.target.querySelector(
        "button[type='submit']"
      );


    saveButton.disabled =
      true;


    try{

      const data = {

        name:
          document.getElementById(
            "groupName"
          ).value.trim(),

        category:
          document.getElementById(
            "groupCategory"
          ).value,

        visibility:
          document.getElementById(
            "groupVisibility"
          ).value,

        description:
          document.getElementById(
            "groupDescription"
          ).value.trim(),

        image:
          document.getElementById(
            "groupImage"
          ).value.trim(),

        rules:
          document.getElementById(
            "groupRules"
          ).value.trim(),

        membersCount:
          Number(
            document.getElementById(
              "groupMembers"
            ).value || 0
          )

      };


      if(!data.name){

        showToast(
          "Group name is required"
        );

        saveButton.disabled =
          false;

        return;

      }


      if(editingId){

        await updateDoc(

          doc(
            db,
            "communityGroups",
            editingId
          ),

          {

            ...data,

            updatedAt:
              serverTimestamp()

          }

        );


        showToast(
          "Group updated successfully"
        );

      }
      else{

        const user =
          auth.currentUser;


        await addDoc(
          groupsRef,
          {

            ...data,

            createdBy:
              user
                ? user.uid
                : null,

            createdByEmail:
              user
                ? user.email || ""
                : "",

            createdAt:
              serverTimestamp(),

            updatedAt:
              serverTimestamp()

          }
        );


        showToast(
          "Group created successfully"
        );

      }


      closeModal();

      await loadGroups();

    }
    catch(error){

      console.error(
        "Save group error:",
        error
      );

      showToast(
        error.message ||
        "Unable to save group"
      );

    }
    finally{

      saveButton.disabled =
        false;

    }

  }
);


/* =====================================
   DELETE GROUP
===================================== */

async function removeGroup(id){

  const group =
    groups.find(
      item =>
        item.id === id
    );


  if(!group){

    return;

  }


  const confirmed =
    confirm(
      `Delete "${group.name}"?\n\nThis action cannot be undone.`
    );


  if(!confirmed){

    return;

  }


  try{

    await deleteDoc(
      doc(
        db,
        "communityGroups",
        id
      )
    );


    showToast(
      "Group deleted"
    );


    await:::writing{variant="standard" id="58321"}
    await loadGroups();

  }
  catch(error){

    console.error(
      "Delete group error:",
      error
    );

    showToast(
      error.message ||
      "Unable to delete group"
    );

  }

}

window.removeGroup =
  removeGroup;


/* =====================================
   CLOSE MODAL
===================================== */

function closeModal(){

  document.getElementById(
    "groupModal"
  ).classList.remove(
    "show"
  );

}

window.closeModal =
  closeModal;


/* =====================================
   ESCAPE HTML
===================================== */

function escapeHTML(value){

  return String(
    value ?? ""
  )
  .replace(
    /&/g,
    "&amp;"
  )
  .replace(
    /</g,
    "&lt;"
  )
  .replace(
    />/g,
    "&gt;"
  )
  .replace(
    /"/g,
    "&quot;"
  )
  .replace(
    /'/g,
    "&#039;"
  );

}


function escapeAttribute(value){

  return escapeHTML(value);

}


/* =====================================
   FORMAT DATE
===================================== */

function formatDate(timestamp){

  if(!timestamp){

    return "—";

  }

  try{

    const date =
      timestamp.toDate
        ? timestamp.toDate()
        : new Date(timestamp);

    return date.toLocaleDateString(
      "en-GB",
      {
        day:"2-digit",
        month:"short",
        year:"numeric"
      }
    );

  }
  catch(error){

    console.error(
      "Date error:",
      error
    );

    return "—";

  }

}


/* =====================================
   TOAST
===================================== */

function showToast(message){

  const toast =
    document.getElementById(
      "toast"
    );

  if(!toast){

    return;

  }

  toast.textContent =
    message;

  toast.classList.add(
    "show"
  );

  clearTimeout(
    window.toastTimer
  );

  window.toastTimer =
    setTimeout(
      () => {

        toast.classList.remove(
          "show"
        );

      },
      3000
    );

}

window.showToast =
  showToast;


/* =====================================
   MODAL OUTSIDE CLICK
===================================== */

document.getElementById(
  "groupModal"
).addEventListener(
  "click",
  event => {

    if(
      event.target.id ===
      "groupModal"
    ){

      closeModal();

