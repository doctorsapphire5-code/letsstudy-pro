<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width,initial-scale=1.0"
>

<title>
  Community Groups | LetsStudy Pro
</title>

<meta
  name="description"
  content="Manage LetsStudy Pro community groups."
>

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Inter,Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
}

button,
input,
select,
textarea{
  font:inherit;
}

button{
  cursor:pointer;
}

header{
  height:72px;
  background:#fff;
  border-bottom:1px solid #e7eaf0;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 28px;
  position:sticky;
  top:0;
  z-index:20;
}

.logo{
  font-size:21px;
  font-weight:800;
}

.logo span{
  color:#2563eb;
}

.admin-chip{
  padding:8px 13px;
  background:#eef4ff;
  color:#2563eb;
  border-radius:20px;
  font-size:13px;
  font-weight:700;
}

.layout{
  display:flex;
  min-height:calc(100vh - 72px);
}

.sidebar{
  width:245px;
  background:#111827;
  color:#fff;
  padding:22px 14px;
}

.sidebar-title{
  color:#9ca3af;
  font-size:11px;
  font-weight:700;
  letter-spacing:.08em;
  margin:12px 10px;
}

.sidebar a{
  display:flex;
  align-items:center;
  gap:10px;
  color:#d1d5db;
  text-decoration:none;
  padding:11px 12px;
  border-radius:9px;
  margin-bottom:4px;
  font-size:14px;
}

.sidebar a:hover,
.sidebar a.active{
  background:#1f2937;
  color:#fff;
}

.main{
  flex:1;
  padding:28px;
  min-width:0;
}

.page-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  margin-bottom:25px;
}

.page-head h1{
  font-size:27px;
  margin-bottom:5px;
}

.page-head p{
  color:#6b7280;
  font-size:14px;
}

.btn{
  border:0;
  border-radius:9px;
  padding:11px 17px;
  font-weight:700;
}

.btn-primary{
  background:#2563eb;
  color:#fff;
}

.btn-primary:hover{
  background:#1d4ed8;
}

.btn-secondary{
  background:#eef2f7;
  color:#374151;
}

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
  margin-bottom:22px;
}

.stat{
  background:#fff;
  border:1px solid #e8ebf1;
  border-radius:13px;
  padding:18px;
}

.stat-label{
  color:#6b7280;
  font-size:13px;
  margin-bottom:8px;
}

.stat-value{
  font-size:25px;
  font-weight:800;
}

.toolbar{
  background:#fff;
  border:1px solid #e8ebf1;
  border-radius:13px;
  padding:15px;
  display:flex;
  gap:10px;
  margin-bottom:16px;
}

.search{
  flex:1;
}

input,
select,
textarea{
  width:100%;
  border:1px solid #dce1e9;
  border-radius:8px;
  padding:11px 12px;
  outline:none;
  background:#fff;
}

input:focus,
select:focus,
textarea:focus{
  border-color:#2563eb;
}

.table-wrap{
  background:#fff;
  border:1px solid #e8ebf1;
  border-radius:13px;
  overflow:auto;
}

table{
  width:100%;
  border-collapse:collapse;
  min-width:950px;
}

th,
td{
  padding:15px;
  text-align:left;
  border-bottom:1px solid #edf0f4;
  font-size:13px;
}

th{
  background:#fafbfc;
  color:#6b7280;
  font-size:11px;
  text-transform:uppercase;
}

.group-name{
  font-weight:750;
}

.muted{
  color:#8a93a3;
  margin-top:4px;
  font-size:12px;
}

.badge{
  display:inline-flex;
  padding:5px 9px;
  border-radius:20px;
  font-size:11px;
  font-weight:800;
}

.active{
  background:#dcfce7;
  color:#15803d;
}

.pending{
  background:#fef3c7;
  color:#92400e;
}

.archived{
  background:#f3f4f6;
  color:#4b5563;
}

.public{
  background:#dbeafe;
  color:#1d4ed8;
}

.private{
  background:#ede9fe;
  color:#6d28d9;
}

.actions{
  display:flex;
  gap:6px;
}

.action{
  border:0;
  background:#f3f4f6;
  padding:7px 9px;
  border-radius:7px;
  font-size:11px;
  font-weight:700;
}

.action.delete{
  color:#b91c1c;
  background:#fee2e2;
}

.empty{
  text-align:center;
  padding:45px;
  color:#6b7280;
  display:none;
}

/* MODAL */

.modal{
  position:fixed;
  inset:0;
  background:rgba(15,23,42,.55);
  display:none;
  align-items:center;
  justify-content:center;
  padding:20px;
  z-index:100;
}

.modal.show{
  display:flex;
}

.modal-box{
  background:#fff;
  width:min(800px,100%);
  max-height:92vh;
  overflow:auto;
  border-radius:16px;
}

.modal-head{
  padding:20px;
  border-bottom:1px solid #edf0f4;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.modal-head h2{
  font-size:20px;
}

.close{
  border:0;
  background:#f3f4f6;
  width:35px;
  height:35px;
  border-radius:50%;
}

.modal-body{
  padding:20px;
}

.form-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:16px;
}

.field.full{
  grid-column:1/-1;
}

.field label{
  display:block;
  font-size:13px;
  font-weight:700;
  margin-bottom:7px;
}

textarea{
  min-height:120px;
  resize:vertical;
}

.modal-foot{
  padding:18px 20px;
  border-top:1px solid #edf0f4;
  display:flex;
  justify-content:flex-end;
  gap:10px;
}

.toast{
  position:fixed;
  right:20px;
  bottom:20px;
  background:#111827;
  color:#fff;
  padding:13px 17px;
  border-radius:9px;
  transform:translateY(20px);
  opacity:0;
  pointer-events:none;
  transition:.25s;
  z-index:200;
  font-size:13px;
}

.toast.show{
  opacity:1;
  transform:translateY(0);
}

.toast.error{
  background:#b91c1c;
}

@media(max-width:1000px){

  .stats{
    grid-template-columns:repeat(2,1fr);
  }

  .sidebar{
    display:none;
  }

}

@media(max-width:650px){

  header{
    padding:0 15px;
  }

  .main{
    padding:16px;
  }

  .page-head{
    align-items:flex-start;
    flex-direction:column;
  }

  .stats{
    grid-template-columns:1fr;
  }

  .toolbar{
    flex-direction:column;
  }

  .form-grid{
    grid-template-columns:1fr;
  }

  .field.full{
    grid-column:auto;
  }

}

</style>

</head>

