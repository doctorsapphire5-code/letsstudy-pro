<script type="module">

import {
  initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";

import {
  getFirestore,
  collection,
  getDocs,
  doc,
  setDoc,
  deleteDoc,
  serverTimestamp
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-firestore.js";


const firebaseConfig = {

  apiKey:
    "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-85B7V5H5J0"

};


const app =
  initializeApp(
    firebaseConfig
  );


const db =
  getFirestore(
    app
  );


const COLLECTION =
  "communityGroups";


let groups = [];


const tableBody =
  document.getElementById(
    "tableBody"
  );

const modal =
  document.getElementById(
    "modal"
  );

const form =
  document.getElementById(
    "groupForm"
  );


/* =====================================================
   LOAD
===================================================== */

async function loadGroups(){

  try{

    const snapshot =
      await getDocs(
        collection(
          db,
          COLLECTION
        )
      );


    groups =
      snapshot.docs.map(
        item => ({

          id:
            item.id,

          ...item.data()

        })
      );


    updateStats();

    render();

  }
  catch(error){

    console.error(
      error
    );

    showToast(
      "Unable to load groups.",
      true
    );

  }

}


/* =====================================================
   STATS
===================================================== */

function updateStats(){

  const active =
    groups.filter(
      item =>
        item.status ===
        "active"
    ).length;


  const members =
    groups.reduce(
      (
        total,
        item
      ) =>
        total +
        Number(
          item.membersCount ||
          0
        ),
      0
    );


  const posts =
    groups.reduce(
      (
        total,
        item
      ) =>
        total +
        Number(
          item.postsCount ||
          0
        ),
      0
    );


  document.getElementById(
    "groupCount"
  ).textContent =
    formatNumber(
      groups.length
    );


  document.getElementById(
    "activeCount"
  ).textContent =
    formatNumber(
      active
    );


  document.getElementById(
    "memberCount"
  ).textContent =
    formatNumber(
      members
    );


  document.getElementById(
    "postCount"
  ).textContent =
    formatNumber(
      posts
    );

}


/* =====================================================
   RENDER
===================================================== */

function render(){

  const search =
    document.getElementById(
      "search"
    )
    .value
    .trim()
    .toLowerCase();


  const status =
    document.getElementById(
      "statusFilter"
    ).value;


  const visibility =
    document.getElementById(
      "visibilityFilter"
    ).value;


  const filtered =
    groups.filter(
      group => {

        const text = [

          group.name,

          group.slug,

          group.description,

          group.category,

          group.country,

          group.ownerName

        ]
        .join(" ")
        .toLowerCase();


        return (

          (
            !search ||
            text.includes(
              search
            )
          )

          &&

          (
            status === "all" ||
            group.status === status
          )

          &&

          (
            visibility === "all" ||
            group.visibility === visibility
          )

        );

      }
    );


  tableBody.innerHTML =
    "";


  filtered.forEach(
    group => {

      const row =
        document.createElement(
          "tr"
        );


      row.innerHTML = `

        <td>

          <div
            class="group-name"
          >
            ${escapeHTML(
              group.name ||
              "Untitled Group"
            )}
          </div>

          <div
            class="muted"
          >
            ${escapeHTML(
              group.country ||
              "No country"
            )}
          </div>

        </td>


        <td>

          ${escapeHTML(
            capitalize(
              group.category ||
              "general"
            )
          )}

        </td>


        <td>

          <span
            class="badge ${
              group.visibility ===
              "private"
                ? "private"
                : "public"
            }"
          >

            ${escapeHTML(
              capitalize(
                group.visibility ||
                "public"
              )
            )}

          </span>

        </td>


        <td>

          <span
            class="badge ${
              statusClass(
                group.status
              )
            }"
          >

            ${escapeHTML(
              capitalize(
                group.status ||
                "active"
              )
            )}

          </span>

        </td>


        <td>
          ${formatNumber(
            group.membersCount
          )}
        </td>


        <td>
          ${formatNumber(
            group.postsCount
          )}
        </td>


        <td>

          ${escapeHTML(
            group.ownerName ||
            "Platform"
          )}

        </td>


        <td>

          <div
            class="actions"
          >

            <button
              class="action"
              data-edit="${escapeAttribute(
                group.id
              )}"
              type="button"
            >
              Edit
            </button>


                          <button
                class="action"
                data-view="${escapeAttribute(
                  group.id
                )}"
                type="button"
              >
                View
              </button>

              <button
                class="action delete"
                data-delete="${escapeAttribute(
                  group.id
                )}"
                type="button"
              >
                Delete
              </button>

            </div>

          </td>

        </tr>

      `;

      tableBody.appendChild(
        row
      );

    }
  );


  document.getElementById(
    "empty"
  ).style.display =
    filtered.length
      ? "none"
      : "block";

}


/* =====================================================
   ADD GROUP
===================================================== */

document.getElementById(
  "addBtn"
).addEventListener(
  "click",
  () => {

    form.reset();

    document.getElementById(
      "recordId"
    ).value = "";

    document.getElementById(
      "membersCount"
    ).value = "0";

    document.getElementById(
      "postsCount"
    ).value = "0";

    document.getElementById(
      "status"
    ).value = "active";

    document.getElementById(
      "visibility"
    ).value = "public";

    document.getElementById(
      "featured"
    ).value = "false";

    document.getElementById(
      "modalTitle"
    ).textContent =
      "Create Community Group";

    document.getElementById(
      "saveBtn"
    ).textContent =
      "Save Group";

    modal.classList.add(
      "show"
    );

  }
);


/* =====================================================
   SAVE GROUP
===================================================== */

form.addEventListener(
  "submit",
  async event => {

    event.preventDefault();

    const button =
      document.getElementById(
        "saveBtn"
      );

    button.disabled = true;

    button.textContent =
      "Saving...";

    try{

      const id =
        getValue(
          "recordId"
        );

      const name =
        getValue(
          "name"
        );

      if(
        !name
      ){

        throw new Error(
          "Group name is required."
        );

      }

      const existing =
        groups.find(
          item =>
            item.id === id
        );


      const data = {

        name:

          name,

        slug:

          getValue(
            "slug"
          ) ||
          createSlug(
            name
          ),

        description:

          getValue(
            "description"
          ),

        category:

          getValue(
            "category"
          ) ||
          "general",

        coverImage:

          getValue(
            "coverImage"
          ),

        visibility:

          getValue(
            "visibility"
          ) ||
          "public",

        status:

          getValue(
            "status"
          ) ||
          "active",

        featured:

          getValue(
            "featured"
          ) ===
          "true",

        ownerId:

          getValue(
            "ownerId"
          ),

        ownerName:

          getValue(
            "ownerName"
          ),

        membersCount:

          Number(
            getValue(
              "membersCount"
            ) ||
            existing?.membersCount ||
            0
          ),

        postsCount:

          Number(
            getValue(
              "postsCount"
            ) ||
            existing?.postsCount ||
            0
          ),

        country:

          getValue(
            "country"
          ),

        updatedAt:

          serverTimestamp()

      };


      if(
        !id
      ){

        data.createdAt =
          serverTimestamp();

        if(
          data.status ===
          "active"
        ){

          data.publishedAt =
            serverTimestamp();

        }

      }


      const groupId =
        id ||
        crypto.randomUUID();


      await setDoc(
        doc(
          db,
          COLLECTION,
          groupId
        ),
        data,
        {
          merge: true
        }
      );


      closeModal();

      await loadGroups();

      showToast(
        id
          ? "Group updated successfully."
          : "Group created successfully."
      );

    }
    catch(error){

      console.error(
        "Save group error:",
        error
      );

      showToast(
        error.message ||
        "Unable to save group.",
        true
      );

    }
    finally{

      button.disabled =
        false;

      button.textContent =
        "Save Group";

    }

  }
);


/* =====================================================
   TABLE ACTIONS
===================================================== */

tableBody.addEventListener(
  "click",
  async event => {

    const button =
      event.target.closest(
        "button"
      );

    if(
      !button
    ){

      return;

    }


    const editId =
      button.dataset.edit;

    const viewId =
      button.dataset.view;

    const deleteId =
      button.dataset.delete;


    /* EDIT */

    if(
      editId
    ){

      const group =
        groups.find(
          item =>
            item.id ===
            editId
        );

      if(
        group
      ){

        editGroup(
          group
        );

      }

      return;

    }


    /* VIEW */

    if(
      viewId
    ){

      window.location.href =
        "community-group.html?id=" +
        encodeURIComponent(
          viewId
        );

      return;

    }


    /* DELETE */

    if(
      deleteId
    ){

      const group =
        groups.find(
          item =>
            item.id ===
            deleteId
        );

      if(
        !group
      ){

        return;

      }


      const confirmed =
        confirm(
          `Delete "${group.name}"?`
        );


      if(
        !confirmed
      ){

        return;

      }


      try{

        await deleteDoc(
          doc(
            db,
            COLLECTION,
            deleteId
          )
        );


        await loadGroups();


        showToast(
          "Group deleted successfully."
        );

      }
      catch(error){

        console.error(
          "Delete group error:",
          error
        );

        showToast(
          "Unable to delete group.",
          true
        );

      }

    }

  }
);


/* =====================================================
   EDIT GROUP
===================================================== */

function editGroup(
  group
){

  document.getElementById(
    "recordId"
  ).value =
    group.id;


  setValue(
    "name",
    group.name
  );

  setValue(
    "slug",
    group.slug
  );

  setValue(
    "category",
    group.category ||
    "general"
  );

  setValue(
    "visibility",
    group.visibility ||
    "public"
  );

  setValue(
    "status",
    group.status ||
    "active"
  );

  setValue(
    "country",
    group.country
  );

  setValue(
    "ownerId",
    group.ownerId
  );

  setValue(
    "ownerName",
    group.ownerName
  );

  setValue(
    "membersCount",
    group.membersCount ||
    0
  );

  setValue(
    "postsCount",
    group.postsCount ||
    0
  );

  setValue(
    "coverImage",
    group.coverImage
  );

  setValue(
    "description",
    group.description
  );

  setValue(
    "featured",
    group.featured
      ? "true"
      : "false"
  );


  document.getElementById(
    "modalTitle"
  ).textContent =
    "Edit Community Group";


  document.getElementById(
    "saveBtn"
  ).textContent =
    "Update Group";


  modal.classList.add(
    "show"
  );

}


/* =====================================================
   CLOSE MODAL
===================================================== */

function closeModal(){

  modal.classList.remove(
    "show"
  );

  form.reset();

  document.getElementById(
    "recordId"
  ).value = "";

}


document.getElementById(
  "closeBtn"
).addEventListener(
  "click",
  closeModal
);


document.getElementById(
  "cancelBtn"
).addEventListener(
