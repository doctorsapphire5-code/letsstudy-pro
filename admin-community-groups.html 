function showToast(
  message,
  type = "info"
){

  if(!toast){

    alert(message);

    return;

  }

  toast.textContent =
    message;

  toast.className =
    "toast " + type;

  toast.classList.add("show");

  setTimeout(
    () => {

      toast.classList.remove("show");

    },
    3000
  );

}


/* =====================================================
   FORMAT DATE
===================================================== */

function formatDate(
  value
){

  if(!value){

    return "—";

  }

  const date =
    new Date(value);

  if(
    Number.isNaN(
      date.getTime()
    )
  ){

    return "—";

  }

  return date.toLocaleString();

}


/* =====================================================
   ADMIN ACCESS CHECK
===================================================== */

async function checkAdminAccess(
  user
){

  if(!user){

    return false;

  }


  /* EMAIL FALLBACK */

  if(
    ADMIN_EMAILS.includes(
      (user.email || "")
        .toLowerCase()
    )
  ){

    return true;

  }


  /* DATABASE ROLE CHECK */

  try{

    const snapshot =
      await get(
        ref(
          db,
          "users/" +
          user.uid
        )
      );

    if(
      snapshot.exists()
    ){

      const profile =
        snapshot.val();

      const role =
        String(
          profile.role || ""
        ).toLowerCase();

      return (
        role === "super-admin" ||
        role === "super_admin" ||
        role === "admin"
      );

    }

  }catch(error){

    console.error(
      "Admin access error:",
      error
    );

  }


  return false;

}


/* =====================================================
   LOAD COMMUNITY GROUPS
===================================================== */

async function loadGroups(){

  const groupsRef =
    ref(
      db,
      "groups"
    );

  const snapshot =
    await get(
      groupsRef
    );

  if(!snapshot.exists()){

    return [];

  }

  const data =
    snapshot.val();

  return Object.entries(
    data
  ).map(
    ([id, group]) => ({

      id,

      ...group

    })
  );

}


