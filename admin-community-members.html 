<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Admin Community Members | LetsStudy Pro</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033
}
header{
  background:#111827;
  color:white;
  padding:18px 22px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}
header h2{margin:0}
.container{max-width:1200px;margin:auto;padding:20px}
.card{
  background:white;
  border-radius:16px;
  padding:20px;
  margin-bottom:20px;
  box-shadow:0 5px 20px rgba(0,0,0,.06)
}
.stats{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:15px;
}
.stat{
  padding:20px;
  border-radius:14px;
  background:#eef2ff
}
.stat b{
  display:block;
  font-size:28px;
  margin-top:8px
}
.controls{
  display:flex;
  gap:10px;
  flex-wrap:wrap
}
input,select,button{
  padding:12px;
  border-radius:10px;
  border:1px solid #ddd;
  font-size:14px
}
input{flex:1;min-width:220px}
button{
  border:0;
  cursor:pointer;
  background:#2563eb;
  color:white
}
button.danger{background:#dc2626}
button.secondary{background:#64748b}
table{
  width:100%;
  border-collapse:collapse
}
th,td{
  padding:13px;
  border-bottom:1px solid #eee;
  text-align:left
}
th{background:#f8fafc}
.badge{
  padding:5px 9px;
  border-radius:20px;
  font-size:12px;
  background:#e2e8f0
}
.online{background:#dcfce7;color:#166534}
.offline{background:#fee2e2;color:#991b1b}
.actions{
  display:flex;
  gap:6px;
  flex-wrap:wrap
}
.empty{
  padding:40px;
  text-align:center;
  color:#64748b
}
#loading{text-align:center;padding:30px}
.modal{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.55);
  align-items:center;
  justify-content:center;
  padding:20px;
}
.modal-box{
  background:white;
  width:100%;
  max-width:550px;
  border-radius:16px;
  padding:22px;
}
.row{
  padding:10px 0;
  border-bottom:1px solid #eee
}
@media(max-width:700px){
 table{font-size:12px}
 th:nth-child(4),td:nth-child(4){display:none}
}
</style>
</head>

<body>

<header>
  <h2>👥 Community Members</h2>
  <button onclick="loadMembers()">↻ Refresh</button>
</header>

<div class="container">

  <div class="stats">

    <div class="stat">
      Total Members
      <b id="totalMembers">0</b>
    </div>

    <div class="stat">
      Online
      <b id="onlineMembers">0</b>
    </div>

    <div class="stat">
      Admins
      <b id="adminMembers">0</b>
    </div>

    <div class="stat">
      Students
      <b id="studentMembers">0</b>
    </div>

  </div>

  <div class="card">

    <div class="controls">

      <input
        id="searchInput"
        placeholder="Search name, email or UID..."
        oninput="renderMembers()"
      >

      <select id="roleFilter" onchange="renderMembers()">
        <option value="">All roles</option>
        <option value="student">Student</option>
        <option value="instructor">Instructor</option>
        <option value="admin">Admin</option>
        <option value="superadmin">Super Admin</option>
      </select>

      <select id="statusFilter" onchange="renderMembers()">
        <option value="">All status</option>
        <option value="online">Online</option>
        <option value="offline">Offline</option>
      </select>

    </div>

  </div>

  <div class="card">

    <div id="loading">
      Loading community members...
    </div>

    <div id="tableWrap" style="display:none">

      <table>

        <thead>
          <tr>
            <th>Member</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody id="membersBody"></tbody>

      </table>

      <div id="empty" class="empty" style="display:none">
        No members found.
      </div>

    </div>

  </div>

</div>


<!-- MEMBER MODAL -->

<div id="memberModal" class="modal">

  <div class="modal-box">

    <h3>Member Details</h3>

    <div id="memberDetails"></div>

    <br>

    <button
      class="secondary"
      onclick="closeModal()">
      Close
    </button>

  </div>

</div>


<script type="module">

import {
  initializeApp
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

import {
  getAuth,
  onAuthStateChanged
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

import {
  getFirestore,
  collection,
  getDocs,
  doc,
  updateDoc,
  deleteDoc
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";


/* =====================================
   FIREBASE
===================================== */

const firebaseConfig = {

  apiKey:
    "AIzaSyBcOYDfAVKXbjsyRgI_0rjodBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-85B7V5H5J0"

};


const app =
  initializeApp(
    firebaseConfig
  );

const auth =
  getAuth(app);

const db =
  getFirestore(app);


/* =====================================
   STATE
===================================== */

let members = [];


/* =====================================
   AUTH
===================================== */

onAuthStateChanged(
  auth,
  async user => {

    if(!user){

      await loadMembers();

      return;

    }

    await loadMembers();

  }
);


/* =====================================
   LOAD MEMBERS
===================================== */

window.loadMembers =
async function(){

  const loading =
    document.getElementById(
      "loading"
    );

  const tableWrap =
    document.getElementById(
      "tableWrap"
    );

  loading.style.display =
    "block";

  tableWrap.style.display =
    "none";

  try{

    const snapshot =
      await getDocs(
        collection(
          db,
          "users"
        )
      );

    members = [];

    snapshot.forEach(
      item => {

        members.push({

          id:
            item.id,

          ...item.data()

        });

      }
    );

    updateStats();

    renderMembers();

    loading.style.display =
      "none";

    tableWrap.style.display =
      "block";

  }
  catch(error){

    console.error(
      error
    );

    loading.innerHTML =
      "Unable to load members.";

  }

};


/* =====================================
   NORMALIZE
===================================== */

function normalizeRole(
  role
){

  return String(
    role || "student"
  )
  .toLowerCase()
  .trim();

}


/* =====================================
   STATUS
===================================== */

function isOnline(
  member
){

  return (
    member.online === true ||
    member.status === "online" ||
    member.isOnline === true
  );

}


/* =====================================
   STATS
===================================== */

function updateStats(){

  const total =
    members.length;

  const online =
    members.filter(
      isOnline
    ).length;

  const admins =
    members.filter(
      m => {

        const role =
          normalizeRole(
            m.role
          );

        return [
          "admin",
          "superadmin",
          "super_admin",
          "administrator"
        ].includes(role);

      }
    ).length;

  const students =
    members.filter(
      m =>
        normalizeRole(
          m.role
        ) === "student"
    ).length;


  document.getElementById(
    "totalMembers"
  ).textContent =
    total;

  document.getElementById(
    "onlineMembers"
  ).textContent =
    online;

  document.getElementById(
    "adminMembers"
  ).textContent =
    admins;

  document.getElementById(
    "studentMembers"
  ).textContent =
    students;

}


/* =====================================
   RENDER
===================================== */

window.renderMembers =
function(){

  const search =
    document.getElementById(
      "searchInput"
    ).value
    .toLowerCase()
    .trim();

  const role =
    document.getElementById(
      "roleFilter"
    ).value;

  const status =
    document.getElementById(
      "statusFilter"
    ).value;


  const filtered =
    members.filter(
      member => {

        const name =
          String(
            member.displayName ||
            member.name ||
            member.fullName ||
            ""
          ).toLowerCase();

        const email =
          String(
            member.email || ""
          ).toLowerCase();

        const uid =
          String(
            member.uid ||
            member.id ||
            ""
          ).toLowerCase();

        const memberRole =
          normalizeRole(
            member.role
          );

        const online =
          isOnline(
            member
          );


        const searchMatch =
          !search ||
          name.includes(search) ||
          email.includes(search) ||
          uid.includes(search);

        const roleMatch =
          !role ||
          memberRole === role;

        const statusMatch =
          !status ||
          (
            status === "online" &&
            online
          ) ||
          (
            status === "offline" &&
            !online
          );

        return (
          searchMatch &&
          roleMatch &&
          statusMatch
        );

      }
    );


  const body =
    document.getElementById(
      "membersBody"
    );

  const empty =
    document.getElementById(
      "empty"
    );


  body.innerHTML = "";


  if(!filtered.length){

    empty.style.display =
      "block";

    return;

  }


  empty.style.display =
    "none";


  filtered.forEach(
    member => {

      const id =
        member.id;

      const name =
        escapeHTML(
          member.displayName ||
          member.name ||
          "Unnamed Member"
        );

      const email =
        escapeHTML(
          member.email ||
          "No email"
        );

      const role =
        normalizeRole(
          member.role
        );

      const online =
        isOnline(
          member
        );


      const tr =
        document.createElement(
          "tr"
        );


      tr.innerHTML = `

        <td>
          <strong>${name}</strong>
        </td>

        <td>
          ${email}
        </td>

        <td>
          <span class="badge">
            ${escapeHTML(role)}
          </span>
        </td>

        <td>

          <span class="badge ${
            online
              ? "online"
              : "offline"
          }">

            ${
              online
                ? "Online"
                : "Offline"
            }

          </span>

        </td>

        <td>

          <div class="actions">

            <button
              onclick="viewMember('${id}')">
              View
            </button>

            <button
              class="secondary"
              onclick="changeRole('${id}')">
              Role
            </button>

            <button
              class="danger"
              onclick="deleteMember('${id}')">
              Delete
            </button>

          </div>

        </td>

      `;

      body.appendChild(
        tr
      );

    }
  );

};


/* =====================================
   VIEW MEMBER
===================================== */

window.viewMember =
function(id){

  const member =
    members.find(
      m => m.id === id
    );

  if(!member)
    return;


  const details =
    document.getElementById(
      "memberDetails"
    );


  details.innerHTML = `

    <div class="row">
      <strong>Name:</strong><br>
      ${escapeHTML(
        member.displayName ||
        member.name ||
        "Unnamed"
      )}
    </div>

    <div class="row">
      <strong>Email:</strong><br>
      ${escapeHTML(
        member.email || "-"
      )}
    </div>

    <div class="row">
      <strong>UID:</strong><br>
      <small>
        ${escapeHTML(
          member.uid ||
          member.id ||
          "-"
        )}
      </small>
    </div>

    <div class="row">
      <strong>Role:</strong><br>
      ${escapeHTML(
        member.role ||
        "student"
      )}
    </div>

    <div class="row">
      <strong>Status:</strong><br>
      ${
        isOnline(member)
          ? "Online"
          : "Offline"
      }
    </div>

  `;


  document.getElementById(
    "memberModal"
  ).style.display =
    "flex";

};


/* =====================================
   CLOSE MODAL
===================================== */

window.closeModal =
function(){

  document.getElementById(
    "memberModal"
  ).style.display =
    "none";

};


/* =====================================
   CHANGE ROLE
===================================== */

window.changeRole =
async function(id){

  const member =
    members.find(
      m => m.id === id
    );

  if(!member)
    return;


  const current =
    normalizeRole(
      member.role
    );


  const role =
    prompt(
      "Enter new role:\nstudent\ninstructor\nadmin\nsuperadmin",
      current
    );


  if(!role)
    return;


  const newRole =
    role
      .toLowerCase()
      .trim();


  const allowed = [
    "student",
    "instructor",
    "admin",
    "superadmin",
    "super_admin",
    "administrator"
  ];


  if(!allowed.includes(newRole)){

    alert(
      "Invalid role."
    );

    return;

  }


  try{

    await updateDoc(
      doc(
        db,
        "users",
        id
      ),
      {
        role:
          newRole
      }
    );


    alert(
      "Member role updated."
    );

    await loadMembers();

  }
  catch(error){

    console.error(
      error
    );

    alert(
      "Failed to update role."
    );

  }

};


/* =====================================
   DELETE MEMBER
===================================== */

window.deleteMember =
async function(id){

  const member =
    members.find(
      m => m.id === id
    );

  if(!member)
    return;


  const name =
    member.displayName ||
    member.name ||
    member.email ||
    id;


  if(
    !confirm(
      `Delete member "${name}" from Firestore?`
    )
  ){

    return;

  }


  try{

    await deleteDoc(
      doc(
        db,
        "users",
        id
      )
    );


    alert(
      "Member deleted."
    );


    await loadMembers();

  }
  catch(error){

    console.error(
      error
    );

    alert(
      "Failed to delete member."
    );

  }

};


/* =====================================
   ESCAPE HTML
===================================== */

function escapeHTML(
  value
){

  return String(
    value ?? ""
  )
  .replace(
    /&/g,
    "&amp;"
  )
  .replace(
    /</g,
    "&lt;"
  )
  .replace(
    />/g,
    "&gt;"
  )
  .replace(
    /"/g,
    "&quot;"
  )
  .replace(
    /'/g,
    "&#039;"
  );

}


/* =====================================
   START
===================================== */

loadMembers();

</script>

</body>
</html>