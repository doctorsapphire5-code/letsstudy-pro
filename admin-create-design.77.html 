<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin • Creative & Design | LetsStudy Pro</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 font-family:Inter,Arial,sans-serif;
 background:#f5f7fb;
 color:#172033
}
header{
 background:#111827;
 color:white;
 padding:16px 5%;
 display:flex;
 justify-content:space-between;
 align-items:center
}
.logo{font-weight:900;font-size:20px}
.container{max-width:1250px;margin:auto;padding:28px 18px}
.hero h1{margin:0;font-size:32px}
.hero p{color:#667085}

.stats{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:15px;
 margin:25px 0
}
.stat{
 background:#fff;
 padding:20px;
 border-radius:16px;
 box-shadow:0 5px 20px #0001
}
.stat span{font-size:13px;color:#667085;font-weight:700}
.stat strong{display:block;font-size:28px;margin-top:8px}

.toolbar{
 display:flex;
 gap:10px;
 flex-wrap:wrap;
 margin-bottom:20px
}
input,select,textarea{
 width:100%;
 padding:12px;
 border:1px solid #d8deea;
 border-radius:10px;
 background:white;
 outline:none
}
.search{flex:1;min-width:230px}

button{
 border:0;
 padding:11px 15px;
 border-radius:9px;
 cursor:pointer;
 font-weight:800
}
.primary{background:#db2777;color:white}
.secondary{background:#e5e7eb;color:#111827}
.danger{background:#fee2e2;color:#b91c1c}

.table-wrap{
 background:white;
 border-radius:17px;
 overflow:auto;
 box-shadow:0 5px 22px #0001
}
table{
 width:100%;
 min-width:900px;
 border-collapse:collapse
}
th,td{
 padding:14px;
 border-bottom:1px solid #edf0f4;
 text-align:left
}
th{background:#fafafa;font-size:13px}

.course{
 display:flex;
 align-items:center;
 gap:10px
}
.thumb{
 width:58px;
 height:45px;
 object-fit:cover;
 border-radius:8px
}
.course-title{font-weight:800}
.muted{font-size:12px;color:#667085}

.badge{
 display:inline-block;
 padding:5px 9px;
 border-radius:20px;
 font-size:11px;
 font-weight:900
}
.free{background:#dcfce7;color:#15803d}
.paid{background:#fce7f3;color:#be185d}
.published{background:#dcfce7;color:#15803d}
.draft{background:#fef3c7;color:#92400e}

.modal{
 display:none;
 position:fixed;
 inset:0;
 background:#0008;
 align-items:center;
 justify-content:center;
 padding:15px;
 z-index:100
}
.modal.show{display:flex}
.modal-box{
 width:720px;
 max-width:100%;
 max-height:94vh;
 overflow:auto;
 background:white;
 border-radius:20px;
 padding:24px
}
.modal-head{
 display:flex;
 justify-content:space-between;
 align-items:center
}
.form-grid{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:14px;
 margin-top:20px
}
.full{grid-column:1/-1}
label{
 display:block;
 font-size:13px;
 font-weight:800
}
label input,label select,label textarea{margin-top:6px}
textarea{min-height:110px;resize:vertical}
.actions{
 display:flex;
 justify-content:flex-end;
 gap:10px;
 margin-top:20px
}
.loading{text-align:center;padding:50px}
.toast{
 display:none;
 position:fixed;
 right:20px;
 bottom:20px;
 background:#111827;
 color:white;
 padding:13px 18px;
 border-radius:10px;
 z-index:300
}
.toast.show{display:block}

@media(max-width:800px){
 .stats{grid-template-columns:1fr 1fr}
}
@media(max-width:600px){
 .stats{grid-template-columns:1fr}
 .form-grid{grid-template-columns:1fr}
 .full{grid-column:auto}
}
</style>
</head>

<body>

<header>

<div class="logo">
 LetsStudy Pro • Admin
</div>

<button id="logout" class="secondary">
 Logout
</button>

</header>


<main class="container">

<section class="hero">

<h1>Creative & Design</h1>

<p>
Manage Graphic Design, UI/UX, Illustration,
Photography, Video Editing, Animation, Branding
and other creative courses.
</p>

</section>


<section class="stats">

<div class="stat">
<span>Total Courses</span>
<strong id="total">0</strong>
</div>

<div class="stat">
<span>Published</span>
<strong id="published">0</strong>
</div>

<div class="stat">
<span>Free</span>
<strong id="free">0</strong>
</div>

<div class="stat">
<span>Paid</span>
<strong id="paid">0</strong>
</div>

</section>


<div class="toolbar">

<input
 id="search"
 class="search"
 type="search"
 placeholder="Search Creative & Design courses..."
>

<select id="filter">

<option value="">All Courses</option>
<option value="free">Free</option>
<option value="paid">Paid</option>
<option value="published">Published</option>
<option value="draft">Draft</option>

</select>

<button
 id="addCourse"
 class="primary">

+ Add Course

</button>

</div>


<div class="table-wrap">

<table>

<thead>
<tr>
<th>Course</th>
<th>Category</th>
<th>Price</th>
<th>Level</th>
<th>Status</th>
<th>Actions</th>
</tr>
</thead>

<tbody id="courseList">

<tr>
<td colspan="6" class="loading">
Loading courses...
</td>
</tr>

</tbody>

</table>

</div>

</main>


<!-- MODAL -->

<div id="modal" class="modal">

<div class="modal-box">

<div class="modal-head">

<h2 id="modalTitle">
Add Creative & Design Course
</h2>

<button
 id="closeModal"
 class="secondary">
✕
</button>

</div>


<form id="courseForm">

<div class="form-grid">

<div class="full">

<label>
Course Title

<input
 id="title"
 required
 placeholder="Graphic Design Fundamentals">
</label>

</div>


<div>

<label>
Category

<select id="category">

<option>Creative & Design</option>
<option>Graphic Design</option>
<option>UI/UX Design</option>
<option>Illustration</option>
<option>Photography</option>
<option>Video Editing</option>
<option>Animation</option>
<option>Branding</option>
<option>3D Design</option>
<option>Creative Writing</option>

</select>

</label>

</div>


<div>

<label>
Level

<select id="level">

<option>Beginner</option>
<option>Intermediate</option>
<option>Advanced</option>
<option>Professional</option>

</select>

</label>

</div>


<div>

<label>
Price

<input
 id="price"
 type="number"
 min="0"
 value="0">
</label>

</div>


<div>

<label>
Discount Price

<input
 id="discountPrice"
 type="number"
 min="0">
</label>

</div>


<div>

<label>
Currency

<select id="currency">
<option value="TZS">TZS</option>
<option value="USD">USD</option>
</select>

</label>

</div>


<div>

<label>
Instructor

<input
 id="instructor"
 value="LetsStudy Pro">
</label>

</div>


<div>

<label>
Status

<select id="status">
<option value="draft">Draft</option>
<option value="published">Published</option>
</select>

</label>

</div>


<div class="full">

<label>
Thumbnail URL

<input
 id="thumbnail"
 type="url"
 placeholder="https://...">
</label>

</div>


<div class="full">

<label>
Short Description

<textarea
 id="shortDescription"
 placeholder="Brief course description...">
</textarea>

</label>

</div>


<div class="full">

<label>
Full Description

<textarea
 id="description"
 placeholder="Complete course description...">
</textarea>

</label>

</div>


<div>

<label>
Certificate

<select id="certificate">
<option value="true">Enabled</option>
<option value="false">Disabled</option>
</select>

</label>

</div>


<div>

<label>
Featured

<select id="featured">
<option value="false">No</option>
<option value="true">Yes</option>
</select>

</label>

</div>

</div>


<div class="actions">

<button
 type="button"
 id="cancel"
 class="secondary">
Cancel
</button>

<button
 type="submit"
 class="primary">
Save Course
</button>

</div>

</form>

</div>
</div>


<div id="toast" class="toast"></div>


<script type="module">

import {
 initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";

import {
 getAuth,
 onAuthStateChanged,
 signOut
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-auth.js";

import {
 getFirestore,
 collection,
 getDocs,
 getDoc,
 doc,
 addDoc,
 updateDoc,
 deleteDoc,
 serverTimestamp
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-firestore.js";


/* =========================
 FIREBASE
========================= */

const firebaseConfig = {

 apiKey:
 "AIzaSyBcOYDfAVKXbkljsyRgI_0rj0odBn678tCc",

 authDomain:
 "let-s-study-pro-course.firebaseapp.com",

 projectId:
 "let-s-study-pro-course",

 storageBucket:
 "let-s-study-pro-course.firebasestorage.app",

 messagingSenderId:
 "474928293390",

 appId:
 "1:474928293390:web:2bcc2aebf2351c12a9fe5f"

};


const app =
 initializeApp(firebaseConfig);

const auth =
 getAuth(app);

const db =
 getFirestore(app);

const $ =
 id => document.getElementById(id);

let courses = [];
let editingId = null;


/* =========================
 AUTH
========================= */

onAuthStateChanged(
 auth,
 async user => {

  if(!user){

   location.href = "login.html";
   return;

  }


  try{

   const snap =
    await getDoc(
     doc(
      db,
      "users",
      user.uid
     )
    );


   if(!snap.exists()){

    location.href = "login.html";
    return;

   }


   const role =
    snap.data().role;


   const allowed = [

    "admin",
    "superAdmin",
    "courseAdmin",
    "contentAdmin"

   ];


   if(!allowed.includes(role)){

    alert("Access denied.");
    location.href = "index.html";
    return;

   }


   await loadCourses();

  }catch(error){

   console.error(error);
   alert("Admin verification failed.");

  }

 });


/* =========================
 LOAD
========================= */

async function loadCourses(){

 try{

  const snapshot =
   await getDocs(
    collection(db,"courses")
   );


  courses =
   snapshot.docs
    .map(item => ({
     id:item.id,
     ...item.data()
    }))
    .filter(isCreativeDesign);


  render();

 }catch(error){

  console.error(error);

  $("courseList").innerHTML = `

   <tr>
   <td colspan="6" class="loading">
   Failed to load courses.
   </td>
   </tr>

  `;

 }

}


/* =========================
 CATEGORY MATCH
========================= */

function isCreativeDesign(course){

 const category =
  String(
   course.categoryName || ""
  ).toLowerCase();

 const title =
  String(
   course.title || ""
  ).toLowerCase();

 const tags =
  Array.isArray(course.tags)
   ? course.tags.join(" ").toLowerCase()
   : String(
      course.tags || ""
     ).toLowerCase();


 return (

  category.includes("creative") ||

  category.includes("design") ||

  category.includes("graphic") ||

  category.includes("ui/ux") ||

  category.includes("illustration") ||

  category.includes("photography") ||

  category.includes("animation") ||

  category.includes("video editing") ||

  category.includes("branding") ||

  title.includes("graphic design") ||

  title.includes("ui/ux") ||

  title.includes("ux design") ||

  title.includes("illustration") ||

  title.includes("photography") ||

  title.includes("video editing") ||

  title.includes("animation") ||

  title.includes("branding") ||

  tags.includes("creative") ||

  tags.includes("design")

 );

}


/* =========================
 RENDER
========================= */

function render(){

 const query =
  $("search")
   .value
   .toLowerCase()
   .trim();

 const filter =
  $("filter").value;


 const filtered =
  courses.filter(course => {

   const text = `

    ${course.title || ""}
    ${course.categoryName || ""}
    ${course.level || ""}
    ${course.description || ""}
    ${course.tags || ""}

   `.toLowerCase();


   const free =
    course.isFree === true ||
    Number(course.price || 0) === 0;


   return (

    (!query ||
     text.includes(query))

    &&

    (!filter ||

     (
      filter === "free" &&
      free
     )

     ||

     (
      filter === "paid" &&
      !free
     )

     ||

     (
      filter === "published" &&
      course.status === "published"
     )

     ||

     (
      filter === "draft" &&
      course.status === "draft"
     )

    )

   );

  });


 $("total").textContent =
  courses.length;


 $("published").textContent =
  courses.filter(
   c => c.status === "published"
  ).length;


 $("free").textContent =
  courses.filter(
   c =>
    c.isFree === true ||
    Number(c.price || 0) === 0
  ).length;


 $("paid").textContent =
  courses.filter(
   c =>
    !(
     c.isFree === true ||
     Number(c.price || 0) === 0
    )
  ).length;


 if(!filtered.length){

  $("courseList").innerHTML = `

   <tr>
   <td colspan="6" class="loading">
   No Creative & Design courses found.
   </td>
   </tr>

  `;

  return;

 }


 $("courseList").innerHTML =
  filtered.map(course => {

   const free =
    course.isFree === true ||
    Number(course.price || 0) === 0;


   const price =
    Number(
     course.discountPrice ??
     course.price ??
     0
    );


   const image =
    course.thumbnail ||
    "https://images.unsplash.com/photo-1561070791-2526d30994b5?w=400";


   return `

   <tr>

   <td>

    <div class="course">

     <img
      class="thumb"
      src="${escapeHTML(image)}"
      alt="">

     <div>

      <div class="course-title">
       ${escapeHTML(
        course.title ||
        "Untitled Course"
       )}
      </div>

      <div class="muted">
       ${escapeHTML(
        course.instructorName ||
        "LetsStudy Pro"
       )}
      </div>

     </div>

    </div>

   </td>


   <td>
    ${escapeHTML(
     course.categoryName ||
     "Creative & Design"
    )}
   </td>


   <td>

    <span class="badge ${
     free ? "free" : "paid"
    }">

     ${
      free
       ? "FREE"
       :
       `${escapeHTML(
        course.currency || "TZS"
       )} ${price.toLocaleString()}`
     }

    </span>

   </td>


   <td>
    ${escapeHTML(
     course.level ||
     "Beginner"
    )}
   </td>


   <td>

    <span class="badge ${
     course.status === "published"
      ? "published"
      : "draft"
    }">

     ${escapeHTML(
      course.status ||
      "draft"
     )}

    </span>

   </td>


   <td>

    <button
     class="secondary"
     onclick="editCourse('${course.id}')">

     Edit

    </button>

    <button
     class="danger"
     onclick="deleteCourse('${course.id}')">

     Delete

    </button>

   </td>

   </tr>

   `;

  }).join("");

}


/* =========================
 ESCAPE
========================= */

function escapeHTML(value){

 return String(value || "")
  .replaceAll("&","&amp;")
  .replaceAll("<","&lt;")
  .replaceAll(">","&gt;")
  .replaceAll('"',"&quot;")
  .replaceAll("'","&#039;");

}


/* =========================
 ADD
========================= */

$("addCourse").onclick = () => {

 editingId = null;

 $("courseForm").reset();

 $("price").value = 0;
 $("currency").value = "TZS";
 $("instructor").value = "LetsStudy Pro";
 $("category").value = "Creative & Design";
 $("level").value = "Beginner";
 $("status").value = "draft";
 $("certificate").value = "true";
 $("featured").value = "false";

 $("modalTitle").textContent =
  "Add Creative & Design Course";

 $("modal").classList.add("show");

};


/* =========================
 EDIT
========================= */

window.editCourse = id => {

 const course =
  courses.find(
   c => c.id === id
  );

 if(!course) return;

 editingId = id;

 $("title").value =
  course.title || "";

 $("category").value =
  course.categoryName ||
  "Creative & Design";

 $("level").value =
  course.level ||
  "Beginner";

 $("price").value =
  course.price || 0;

 $("discountPrice").value =
  course.discountPrice ?? "";

 $("currency").value =
  course.currency || "TZS";

 $("instructor").value =
  course.instructorName ||
  "LetsStudy Pro";

 $("thumbnail").value =
  course.thumbnail || "";

 $("shortDescription").value =
  course.shortDescription || "";

 $("description").value =
  course.description || "";

 $("status").value =
  course.status || "draft";

 $("certificate").value =
  String(
   course.certificateEnabled !== false
  );

 $("featured").value =
  String(
   course.featured === true
  );

 $("modalTitle").textContent =
  "Edit Creative & Design Course";

 $("modal").classList.add("show");

};


/* =========================
 SAVE
========================= */

$("courseForm").onsubmit =
 async event => {

  event.preventDefault();


  const title =
   $("title")
    .value
    .trim();


  if(!title){

   toast("Course title is required.");
   return;

  }


  const price =
   Number(
    $("price").value || 0
   );


  const discountValue =
   $("discountPrice").value;


  const status =
   $("status").value;


  const category =
   $("category").value;


  const slug =
   title
    .toLowerCase()
    .replace(
     /[^a-z0-9]+/g,
     "-"
    )
    .replace(
     /^-|-$/g,
     ""
    );


  const data = {

   title,

   slug,

   categoryName:
    category,

   categoryId:
    category
     .toLowerCase()
     .replace(
      /[^a-z0-9]+/g,
      "-"
     ),

   category:
    "Creative & Design",

   level:
    $("level").value,

   price,

   currency:
    $("currency").value,

   discountPrice:
    discountValue === ""
     ? null
     : Number(discountValue),

   isFree:
    price === 0,

   instructorName:
    $("instructor")
     .value
     .trim(),

   thumbnail:
    $("thumbnail")
     .value
     .trim(),

   shortDescription:
    $("shortDescription")
     .value
     .trim(),

   description:
    $("description")
     .value
     .trim(),

   status,

   published:
    status === "published",

   certificateEnabled:
    $("certificate").value === "true",

   featured:
    $("featured").value === "true",

   updatedAt:
    serverTimestamp()

  };


  try{

   if(editingId){

    await updateDoc(
     doc(
      db,
      "courses",
      editingId
     ),
     data
    );

    toast(
     "Creative & Design course updated."
    );

   }else{

    data.createdAt =
     serverTimestamp();

    data.publishedAt =
     status === "published"
      ? serverTimestamp()
      : null;

    data.enrollmentCount = 0;
    data.lessonCount = 0;
    data.rating = 0;
    data.ratingCount = 0;


    await addDoc(
     collection(db,"courses"),
     data
    );

    toast(
     "Creative & Design course added."
    );

   }


   closeModal();

   await loadCourses();

  }catch(error){

   console.error(error);

   toast(
    "Failed to save course."
   );

  }

};


/* =========================
 DELETE
========================= */

window.deleteCourse =
 async id => {

  const course =
   courses.find(
    c => c.id === id
   );

  if(!course) return;


  if(!confirm(
   `Delete "${course.title}"?`
  )) return;


  try{

   await deleteDoc(
    doc(
     db,
     "courses",
     id
    )
   );


   toast(
    "Course deleted successfully."
   );

   await loadCourses();

  }catch(error){

   console.error(error);

   toast(
    "Failed to delete course."
   );

  }

};


/* =========================
 MODAL
========================= */

function closeModal(){

 $("modal")
  .classList
  .remove("show");

 editingId = null;

}

$("closeModal").onclick =
 closeModal;

$("cancel").onclick =
 closeModal;

$("modal").addEventListener(
 "click",
 event => {

  if(event.target === $("modal")){
   closeModal();
  }

 });


/* =========================
 SEARCH
========================= */

$("search").addEventListener(
 "input",
 render
);

$("filter").addEventListener(
 "change",
 render
);


/* =========================
 LOGOUT
========================= */

$("logout").onclick =
 async () => {

  await signOut(auth);

  location.href =
   "login.html";

 };


/* =========================
 TOAST
========================= */

function toast(message){

 $("toast").textContent =
  message;

 $("toast")
  .classList
  .add("show");

 setTimeout(
  () => {
   $("toast")
    .classList
    .remove("show");
  },
  2600
 );

}

</script>

</body>
</html>