<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
*{box-sizing:border-box}

body{
 margin:0;
 background:#f6f8fb;
 color:#172033;
 font-family:Inter,Arial,sans-serif
}

.container{
 max-width:1200px;
 margin:auto;
 padding:24px
}

.header,.stat,.toolbar,.card,.empty{
 background:#fff;
 border:1px solid #e5e7eb;
 border-radius:14px
}

.header{
 padding:20px;
 margin-bottom:16px
}

.header h1{
