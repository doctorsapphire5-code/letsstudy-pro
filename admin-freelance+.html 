 color:#027a48
}

.draft{
 background:#f2f4f7;
 color:#475467
}

.body{
 padding:45px 15px 15px
}

.name{
 font-size:17px;
 font-weight:800
}

.username{
 color:#667085;
 font-size:11px;
 margin-top:2px
}

.headline{
 color:#155eef;
 font-size:12px;
 font-weight:700;
 margin:9px 0
}

.bio{
 color:#667085;
 font-size:12px;
 line-height:1.6;
 min-height:38px
}

.skills{
 display:flex;
 flex-wrap:wrap;
 gap:5px;
 margin:10px 0
}

.skill{
 background:#f2f4f7;
 color:#475467;
 padding:5px 8px;
 border-radius:20px;
 font-size:10px
}

.rating{
 color:#f59e0b;
 font-size:12px;
 margin:9px 0
}

.info{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:6px
}

.info div{
 background:#f8fafc;
 border-radius:8px;
 padding:8px;
 text-align:center;
 font-size:10px;
 color:#667085
}

.info b{
 display:block;
 color:#172033;
 font-size:12px
}

.actions{
 display:flex;
 gap:6px;
 margin-top:12px
}

.actions button{
 flex:1;
 font-size:10px
}

.empty{
 grid-column:1/-1;
 padding:55px;
 text-align:center;
 color:#667085
}

.modal{
 display:none;
 position:fixed;
 inset:0;
 background:#0008;
 z-index:100;
 align-items:center;
 justify-content:center;
 padding:15px
}

.modal.show{
 display:flex
}

.modal-box{
 background:#fff;
 width:min(900px,100%);
 max-height:92vh;
 overflow:auto;
 padding:20px;
 border-radius:15px
}

.close{
 float:right;
 background:#f2f4f7
}

.form-grid{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:12px
}

.group label{
 display:block;
 font-size:12px;
 font-weight:700;
 margin-bottom:5px
}

.full{
 grid-column:1/-1
}

.save{
 width:100%;
 margin-top:12px
}

@media(max-width:950px){

 .stats{
  grid-template-columns:repeat(2,1fr)
 }

 .grid{
  grid-template-columns:repeat(2,1fr)
 }

 .toolbar{
  grid-template-columns:1fr 1fr
 }

}

@media(max-width:600px){

 .container{
  padding:15px
 }

 .stats,
 .grid,
 .toolbar,
 .form-grid{
  grid-template-columns:1fr
 }

 .full{
  grid-column:auto
 }

}
</style>
</head>

<body>

