<script type="module">

import {
initializeApp
}
from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

import {
getFirestore,
collection,
getDocs,
addDoc,
updateDoc,
deleteDoc,
doc,
serverTimestamp
}
from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


const firebaseConfig={

apiKey:
"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};


const app=
initializeApp(firebaseConfig);

const db=
getFirestore(app);


let freelancers=[];
let editingId=;freelancerId


const list=
document.getElementById("list");

const modal=
document.getElementById("modal");

const form=
document.getElementById("form");


function esc(value=""){

return String(value)
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}


function arr(value){

if(Array.isArray(value))
return value;

if(typeof value==="string")
return value
.split(",")
.map(x=>x.trim())
.filter(Boolean);

return [];

}


/* =========================
 LOAD
========================= */

async function load(){

try{

const snap=
await getDocs(
collection(
db,
"freelancers"
)
);


freelancers=[];


snap.forEach(item=>{

freelancers.push({

id:item.id,
...item.data()

});

});


stats();
render();


}catch(error){

console.error(error);

list.innerHTML=`

<div class="empty">

<i class="fa fa-triangle-exclamation"></i>

<h3>
Unable to load freelancers
</h3>

</div>

`;

}

}


/* =========================
 STATS
========================= */

function stats(){

document.getElementById("total")
.textContent=freelancers.length;


document.getElementById("published")
.textContent=
freelancers.filter(
f=>f.status==="published"
).length;


document.getElementById("verified")
.textContent=
freelancers.filter(
f=>f.verified===true
).length;


document.getElementById("featured")
.textContent=
freelancers.filter(
f=>f.featured===true
).length;


document.getElementById("jobs")
.textContent=
freelancers.reduce(
(sum,f)=>
sum+
Number(
f.completedJobs||0
),
0
).toLocaleString();

}


/* =========================
 RENDER
========================= */

function render(){

const keyword=
document.getElementById("search")
.value
.toLowerCase()
.trim();

const status=
document.getElementById("statusFilter")
.value;

const experience=
document.getElementById("experienceFilter")
.value;

const availability=
document.getElementById("availabilityFilter")
.value;


const data=
freelancers.filter(f=>{

const text=`

${f.name||""}
${f.username||""}
${f.headline||""}
${f.bio||""}
${arr(f.skills).join(" ")}
${arr(f.categories).join(" ")}

`.toLowerCase();


return(

text.includes(keyword)

&&
(!status||f.status===status)

&&
(!experience||
f.experienceLevel===experience)

&&
(!availability||
f.availability===availability)

);

});


if(!data.length){

list.innerHTML=`

<div class="empty">

<i class="fa fa-users-slash"></i>

<h3>
No freelancers found
</h3>

</div>

`;

return;

}


data.sort(
(a,b)=>
Number(b.featured||false)-
Number(a.featured||false)
);


list.innerHTML=
data.map(card).join("");

}


/* =========================
 CARD
========================= */

function card(f){

const skills=
arr(f.skills).slice(0,4);


return`

<article class="card">

<div class="cover">

<img
src="${esc(
f.coverImage||
"https://via.placeholder.com/900x300?text=Freelancer"
)}"
alt="">


<img
class="profile"
src="${esc(
f.profileImage||
"https://via.placeholder.com/200?text=User"
)}"
alt="${esc(f.name)}">


${
f.featured
?
`<span class="badge featured">
★ Featured
</span>`
:""
}


<span
class="badge status ${
f.status==="published"
?"published"
:"draft"
}">

${esc(
f.status||"draft"
)}

</span>

</div>


<div class="body">

<div class="name">

${esc(
f.name||
"Freelancer"
)}

${
f.verified
?
`<i
class="fa fa-circle-check"
style="color:#155eef">
</i>`
:""
}

</div>


<div class="username">

@${esc(
f.username||
"username"
)}

</div>


<div class="headline">

${esc(
f.headline||
"Professional Freelancer"
)}

</div>


<div class="bio">

${esc(
f.bio||
""
)}

</div>


<div class="skills">

${
skills.map(
s=>
`<span class="skill">
${esc(s)}
</span>`
).join("")
}

</div>


<div class="rating">

★ ${Number(
f.rating||0
).toFixed(1)}

<span style="color:#667085">

(${Number(
f.ratingCount||0
)})

</span>

</div>


<div class="info">

<div>
Jobs
<b>
${Number(
f.totalJobs||0
).toLocaleString()}
</b>
</div>

<div>
Completed
<b>
${Number(
f.completedJobs||0
).toLocaleString()}
</b>
</div>

<div>
Portfolio
<b>
${Number(
f.portfolioCount||0
).toLocaleString()}
</b>
</div>

</div>


<div class="actions">

<button
class="light"
onclick="edit('${f.id}')">

<i class="fa fa-edit"></i>
Edit

</button>


<button
class="${
f.verified
?"success"
:"light"
}"
onclick="verify('${f.id}')">

<i class="fa fa-circle-check"></i>

${f.verified
?"Verified"
:"Verify"}

</button>


<button
class="primary"
onclick="publish('${f.id}')">

<i class="fa fa-toggle-on"></i>

</button>


<button
class="danger"
onclick="removeItem('${f.id}')">

<i class="fa fa-trash"></i>

</button>

</div>

</div>

</article>

`;

}


/* =========================
 ADD
========================= */

document
.getElementById("addBtn")
.onclick=()=>{

editingId=freelancerId;

form.reset();

document.getElementById(
"currency"
).value="TZS";

document.getElementById(
"status"
).value="draft";

document.getElementById(
"availability"
).value="available";

document.getElementById(
"verified"
).value="false";

document.getElementById(
"featured"
).value="false";

document.getElementById(
"modalTitle"
).textContent=
"Add Freelancer";

modal.classList.add("show");

};


/* =========================
 CLOSE
========================= */

document
.getElementById("close")
.onclick=()=>{

modal.classList.remove("show");

};


/* =========================
 SAVE
========================= */

form.onsubmit=
async e=>{

e.preventDefault();


const data={

userId:
document.getElementById(
"userId"
).value.trim(),

name:
document.getElementById(
"name"
).value.trim(),

username:
document.getElementById(
"username"
).value.trim(),

slug:
document.getElementById(
"slug"
).value.trim(),

profileImage:
document.getElementById(
"profileImage"
).value.trim(),

coverImage:
document.getElementById(
"coverImage"
).value.trim(),

headline:
document.getElementById(
"headline"
).value.trim(),

bio:
document.getElementById(
"bio"
).value.trim(),

country:
document.getElementById(
"country"
).value.trim(),

region:
document.getElementById(
"region"
).value.trim(),

city:
document.getElementById(
"city"
).value.trim(),

timezone:
document.getElementById(
"timezone"
).value.trim(),

languages:
arr(
document.getElementById(
"languages"
).value
),

skills:
arr(
document.getElementById(
"skills"
).value
),

categories:
arr(
document.getElementById(
"categories"
).value
),

experienceLevel:
document.getElementById(
"experienceLevel"
).value,

hourlyRate:
Number(
document.getElementById(
"hourlyRate"
).value||0
),

currency:
document.getElementById(
"currency"
).value.trim()||"TZS",

availability:
document.getElementById(
"availability"
).value,

responseTime:
document.getElementById(
"responseTime"
).value.trim(),

verified:
document.getElementById(
"verified"
).value==="true",

featured:
document.getElementById(
"featured"
).value==="true",

status:
document.getElementById(
"status"
).value,

updatedAt:
serverTimestamp()

};


try{

if(editingId){

await updateDoc(

doc(
db,
"freelancers",
editingId
),

data

);

}else{

data.totalJobs=0;
data.completedJobs=0;
data.activeJobs=0;
data.rating=0;
data.ratingCount=0;
data.totalEarnings=0;
data.portfolioCount=0;

data.createdAt=
serverTimestamp();

data.publishedAt=
data.status==="published"
?serverTimestamp()
:freelancerId;


await addDoc(
collection(
db,
"freelancers"
),
data
);

}


modal.classList.remove(
"show"
);

await load();


}catch(error){

console.error(error);

alert(
"Unable to save freelancer."
);

}

};


/* =========================
 EDIT
========================= */

window.edit=
id=>{

const f=
freelancers.find(
x=>x.id===id
);

if(!f)return;

editingId=id;


const fields=[

"userId",
"name",
"username",
"slug",
"profileImage",
"coverImage",
"headline",
"bio",
"country",
"region",
"city",
"timezone",
"hourlyRate",
"currency",
"responseTime"

];


fields.forEach(key=>{

const el=
document.getElementById(key);

if(el)
el.value=f[key]??"";

});


document.getElementById(
"languages"
).value=
arr(f.languages).join(", ");


document.getElementById(
"skills"
).value=
arr(f.skills).join(", ");


document.getElementById(
"categories"
).value=
arr(f.categories).join(", ");


document.getElementById(
"experienceLevel"
).value=
f.experienceLevel||"entry";


document.getElementById(
"availability"
).value=
f.availability||"available";


document.getElementById(
"status"
).value=
f.status||"draft";


document.getElementById(
"verified"
).value=
f.verified?"true":"false";


document.getElementById(
"featured"
).value=
f.featured?"true":"false";


document.getElementById(
"modalTitle"
).textContent=
"Edit Freelancer";


modal.classList.add("show");

};


/* =========================
 VERIFY
========================= */

window.verify=
async id=>{

const f=
freelancers.find(
x=>x.id===id
);

if(!f)return;


try{

await updateDoc(

doc(
db,
"freelancers",
id
),

{

verified:
!f.verified,

updatedAt:
serverTimestamp()

}

);

await load();

}catch(error){

console.error(error);

alert(
"Unable to update verification."
);

}

};


/* =========================
 PUBLISH
========================= */

window.publish=
async id=>{

const f=
freelancers.find(
x=>x.id===id
);

if(!f)return;


const next=
f.status==="published"
?"draft"
:"published";


try{

await updateDoc(

doc(
db,
"freelancers",
id
),

{

status:next,

publishedAt:
next==="published"
?serverTimestamp()
:null,

updatedAt:
serverTimestamp()

}

);

await load();

}catch(error){

console.error(error);

alert(
"Unable to update status."
);

}

};


/* =========================
 DELETE
========================= */

window.removeItem=
async id=>{

if(
!confirm(
"Delete this freelancer permanently?"
)
)return;


try{

await deleteDoc(

doc(
db,
"freelancers",
id
)

);

await load();

}catch(error){

console.error(error);

alert(
"Unable to delete freelancer."
);

}

};


