<script type="module">


/* =========================================
   FIREBASE
========================================= */

import {
  initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";


import {
  getAuth,
  onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";


import {
  getFirestore,
  collection,
  addDoc,
  getDocs,
  getDoc,
  doc,
  updateDoc,
  deleteDoc,
  serverTimestamp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


/* =========================================
   CONFIG
========================================= */

const firebaseConfig = {

  apiKey:
    "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-85B7V5H5J0"

};


const app =
  initializeApp(firebaseConfig);

const auth =
  getAuth(app);

const db =
  getFirestore(app);


/* =========================================
   STATE
========================================= */

let freelancers = [];

let currentAdmin = null;


/* =========================================
   AUTH
========================================= */

onAuthStateChanged(
  auth,
  async user => {

    if(!user){

      document.getElementById(
        "adminName"
      ).textContent =
        "Admin";

      return;

    }

    currentAdmin = user;

    document.getElementById(
      "adminName"
    ).textContent =
      user.displayName ||
      user.email ||
      "Admin";

    if(user.photoURL){

      document.getElementById(
        "adminAvatar"
      ).src =
        user.photoURL;

    }

    await loadFreelancers();

  }
);


/* =========================================
   LOAD FREELANCERS
========================================= */

async function loadFreelancers(){

  const table =
    document.getElementById(
      "freelancerTable"
    );

  table.innerHTML =
    `
      <tr>
        <td
          colspan="8"
          class="loading">

          Loading freelancers...

        </td>
      </tr>
    `;


  try{

    const snap =
      await getDocs(
        collection(
          db,
          "freelancers"
        )
      );


    freelancers = [];


    snap.forEach(item => {

      freelancers.push({

        id:
          item.id,

        ...item.data()

      });

    });


    updateStats();

    renderFreelancers();

  }catch(error){

    console.error(error);

    table.innerHTML =
      `
        <tr>

          <td
            colspan="8"
            class="empty">

            Unable to load freelancers.

            <br><br>

            ${escapeHtml(
              error.message
            )}

          </td>

        </tr>
      `;

  }

}


/* =========================================
   STATS
========================================= */

function updateStats(){

  const total =
    freelancers.length;


  const verified =
    freelancers.filter(
      x => x.verified === true
    ).length;


  const featured =
    freelancers.filter(
      x => x.featured === true
    ).length;


  const pending =
    freelancers.filter(
      x =>
        (x.status || "pending")
        === "pending"
    ).length;


  const active =
    freelancers.filter(
      x =>
        x.status === "active" ||
        x.status === "published"
    ).length;


  document.getElementById(
    "totalCount"
  ).textContent =
    total;


  document.getElementById(
    "verifiedCount"
  ).textContent =
    verified;


  document.getElementById(
    "featuredCount"
  ).textContent =
    featured;


  document.getElementById("freelancerForm")
  .addEventListener("submit", async function(e){

    e.preventDefault();

    const btn =
      document.getElementById("saveBtn");

    const editId =
      document.getElementById("editId").value;

    btn.disabled = true;
    btn.textContent = "Saving...";

    try {

      const data = {

        userId:
          document.getElementById("userId").value.trim(),

        name:
          document.getElementById("name").value.trim(),

        username:
          document.getElementById("username").value.trim(),

        slug:
          document.getElementById("slug").value.trim(),

        profileImage:
          document.getElementById("profileImage").value.trim(),

        coverImage:
          document.getElementById("coverImage").value.trim(),

        headline:
          document.getElementById("headline").value.trim(),

        bio:
          document.getElementById("bio").value.trim(),

        country:
          document.getElementById("country").value.trim(),

        region:
          document.getElementById("region").value.trim(),

        city:
          document.getElementById("city").value.trim(),

        timezone:
          document.getElementById("timezone").value.trim(),

        languages:
          stringToArray(
            document.getElementById("languages").value
          ),

        skills:
          stringToArray(
            document.getElementById("skills").value
          ),

        categories:
          stringToArray(
            document.getElementById("categories").value
          ),

        experienceLevel:
          document.getElementById("experienceLevel").value,

        hourlyRate:
          Number(
            document.getElementById("hourlyRate").value
          ) || 0,

        currency:
          document.getElementById("currency").value.trim() ||
          "TZS",

        availability:
          document.getElementById("availability").value,

        responseTime:
          document.getElementById("responseTime").value.trim(),

        status:
          document.getElementById("status").value,

        verified:
          document.getElementById("verified").value === "true",

        featured:
          document.getElementById("featured").value === "true",

        updatedAt:
          serverTimestamp()

      };


      /* ===============================
         VALIDATION
      =============================== */

      if(!data.name){

        alert("Freelancer name is required.");

        return;

      }

      if(!data.username){

        alert("Username is required.");

        return;

      }

      if(!data.slug){

        alert("Slug is required.");

        return;

      }


      /* ===============================
         EDIT EXISTING
      =============================== */

      if(editId){

        await updateDoc(
          doc(
            db,
            "freelancers",
            editId
          ),
          data
        );

        alert(
          "Freelancer updated successfully."
        );

      }


      /* ===============================
         ADD NEW
      =============================== */

      else{

        data.totalJobs = 0;

        data.completedJobs = 0;

        data.activeJobs = 0;

        data.rating = 0;

        data.ratingCount = 0;

        data.totalEarnings = 0;

        data.portfolioCount = 0;

        data.createdAt =
          serverTimestamp();

        data.publishedAt =
          null;


        await addDoc(
          collection(
            db,
            "freelancers"
          ),
          data
        );

        alert(
          "Freelancer added successfully."
        );

      }


      closeModal(
        "formModal"
      );

      await loadFreelancers();


    }catch(error){

      console.error(
        "Freelancer save error:",
        error
      );

      alert(
        "Error: " +
        error.message
      );

    }finally{

      btn.disabled = false;

      btn.textContent =
        "Save Freelancer";

    }

  });


