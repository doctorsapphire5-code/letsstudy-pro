<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Admin Freelancers | LetsStudy Pro</title>

<link rel="icon"
href="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgQHmJO8e8twONhRhp3I6pP4NFDh-LPcqVtAmQ9R9XjOGaVMKShfSLmxeK0fVzJsybBBOXKbA8LIhjgTgko83C-UPVhwgXeLtvTfjtVv6aVGgQgniOF-gMC28bY78HryXZ-5OqCwdBpKGqjEfTta5jLjT1mpvtBi2DQKyu35rkxsZNoVvl0nhvxUUn1gDP0/s1600/Untitled%20design_20260717_144337_0000.jpg">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
*{box-sizing:border-box}

body{
 margin:0;
 background:#f6f8fb;
 color:#172033;
 font-family:Inter,Arial,sans-serif
}

.top{
 height:64px;
 background:#fff;
 border-bottom:1px solid #e5e7eb;
 display:flex;
 align-items:center;
 justify-content:space-between;
 padding:0 5%;
 position:sticky;
 top:0;
 z-index:20
}

.logo{
 color:#155eef;
 font-size:20px;
 font-weight:900
}

.admin{
 background:#eef4ff;
 color:#155eef;
 padding:8px 12px;
 border-radius:20px;
 font-size:11px;
 font-weight:800
}

.container{
 max-width:1200px;
 margin:30px auto;
 padding:0 20px
}

.header{
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:15px;
 margin-bottom:22px
}

h1{
 margin:0;
 font-size:28px
}

.subtitle{
 color:#667085;
 font-size:13px;
 margin-top:6px
}

.search{
 display:flex;
 gap:8px
}

.search input,
.search select{
 padding:11px 13px;
 border:1px solid #d0d5dd;
 border-radius:9px;
 outline:none;
 background:#fff
}

.stats{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:12px;
 margin-bottom:22px
}

.stat{
 background:#fff;
 border:1px solid #e5e7eb;
 border-radius:13px;
 padding:18px
}

.stat i{
 color:#155eef;
 margin-bottom:10px
}

.stat strong{
 display:block;
 font-size:22px
}

.stat span{
 color:#667085;
 font-size:11px
}

.table-box{
 background:#fff;
 border:1px solid #e5e7eb;
 border-radius:15px;
 overflow:auto
}

table{
 width:100%;
 border-collapse:collapse;
 min-width:950px
}

th{
 background:#f8fafc;
 color:#667085;
 font-size:10px;
 text-transform:uppercase;
 text-align:left;
 padding:13px
}

td{
 padding:13px;
 border-top:1px solid #eaecf0;
 font-size:12px
}

.person{
 display:flex;
 align-items:center;
 gap:10px
}

.avatar{
 width:40px;
 height:40px;
 border-radius:50%;
 background:#eef4ff;
 color:#155eef;
 display:flex;
 align-items:center;
 justify-content:center;
 overflow:hidden;
 font-weight:800
}

.avatar img{
 width:100%;
 height:100%;
 object-fit:cover
}

.name{
 font-weight:800
}

.username{
 color:#667085;
 font-size:10px;
 margin-top:3px
}

.badge{
 display:inline-block;
 padding:5px 8px;
 border-radius:20px;
 font-size:9px;
 font-weight:800
}

.active{
 background:#ecfdf3;
 color:#027a48
}

.pending{
 background:#fffaeb;
 color:#b54708
}

.suspended{
 background:#fef3f2;
 color:#b42318
}

.verified{
 color:#12b76a;
 margin-left:3px
}

.actions{
 display:flex;
 gap:5px
}

.btn{
 border:1px solid #d0d5dd;
 background:#fff;
 padding:7px 9px;
 border-radius:7px;
 cursor:pointer;
 font-size:10px;
 font-weight:700
}

.btn:hover{
 border-color:#155eef;
 color:#155eef
}

.btn.danger:hover{
 color:#b42318;
 border-color:#b42318
}

.loading,
.empty{
 padding:50px;
 text-align:center;
 color:#667085
}

@media(max-width:800px){

 .header{
  flex-direction:column;
  align-items:flex-start
 }

 .search{
  width:100%;
  flex-wrap:wrap
 }

 .search input,
 .search select{
  flex:1
 }

 .stats{
  grid-template-columns:repeat(2,1fr)
 }

}
</style>
</head>

<body>

<header class="top">

<div class="logo">
LetsStudy Pro
</div>

<div class="admin">
<i class="fa fa-shield-halved"></i>
ADMIN
</div>

</header>


<main class="container">

<div class="header">

<div>
<h1>Freelancer Management</h1>
<div class="subtitle">
Manage, verify, feature and control freelancers.
</div>
</div>

<div class="search">

<input
id="search"
placeholder="Search freelancer...">

<select id="statusFilter">

<option value="">All Status</option>
<option value="published">Published</option>
<option value="pending">Pending</option>
<option value="suspended">Suspended</option>
</select>

</div>

</div>


<section class="stats">

<div class="stat">
<i class="fa fa-users"></i>
<strong id="total">0</strong>
<span>Total Freelancers</span>
</div>

<div class="stat">
<i class="fa fa-circle-check"></i>
<strong id="verifiedCount">0</strong>
<span>Verified</span>
</div>

<div class="stat">
<i class="fa fa-star"></i>
<strong id="featuredCount">0</strong>
<span>Featured</span>
</div>

<div class="stat">
<i class="fa fa-user-clock"></i>
<strong id="pendingCount">0</strong>
<span>Pending</span>
</div>

</section>


<section class="table-box">

<table>

<thead>
<tr>
<th>Freelancer</th>
<th>Category</th>
<th>Rate</th>
<th>Rating</th>
<th>Jobs</th>
<th>Status</th>
<th>Actions</th>
</tr>
</thead>

<tbody id="list">

<tr>
<td colspan="7" class="loading">
<i class="fa fa-spinner fa-spin"></i>
Loading freelancers...
</td>
</tr>

</tbody>

</table>

</section>

</main>


<script type="module">

import {
 initializeApp
}
from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

import {
 getFirestore,
 collection,
 getDocs,
 doc,
 updateDoc,
 deleteDoc,
 serverTimestamp
}
from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


const firebaseConfig={

 apiKey:
 "AIzaSyBcOYDfAVKXbkljsYrgI_0rjodBn678tCc",

 authDomain:
 "let-s-study-pro-course.firebaseapp.com",

 projectId:
 "let-s-study-pro-course",

 storageBucket:
 "let-s-study-pro-course.firebasestorage.app",

 messagingSenderId:
 "474928293390",

 appId:
 "1:474928293390:web:2bcc2aebf2351c12a9fe5f"

};

const app=initializeApp(firebaseConfig);
const db=getFirestore(app);

let freelancers=[];


const $=id=>
document.getElementById(id);


function esc(value=""){

 return String(value??"")
 .replace(/&/g,"&amp;")
 .replace(/</g,"&lt;")
 .replace(/>/g,"&gt;")
 .replace(/"/g,"&quot;")
 .replace(/'/g,"&#039;");

}


async function load(){

 try{

  const snap=
  await getDocs(
   collection(db,"freelancers")
  );

  freelancers=
  snap.docs.map(d=>({
   id:d.id,
   ...d.data()
  }));

  render();

 }catch(error){

  console.error(error);

  $("list").innerHTML=`
  <tr>
  <td colspan="7" class="empty">
  Unable to load freelancers.
  </td>
  </tr>`;

 }

}


function render(){

 const q=
 $("search").value
 .toLowerCase()
 .trim();

 const status=
 $("statusFilter").value;


 const data=
 freelancers.filter(f=>{

  const text=`
  ${f.name||""}
  ${f.username||""}
  ${f.headline||""}
  ${f.city||""}
  ${f.country||""}
  ${f.category||""}
  ${Array.isArray(f.categories)
   ?f.categories.join(" ")
   :""
  }
  `.toLowerCase();


  return(
   (!q||text.includes(q)) &&
   (!status||f.status===status)
  );

 });


 $("total").textContent=
 freelancers.length.toLocaleString();


 $("verifiedCount").textContent=
 freelancers.filter(f=>f.verified).length;


 $("featuredCount").textContent=
 freelancers.filter(f=>f.featured).length;


 $("pendingCount").textContent=
 freelancers.filter(f=>
  !f.status ||
  f.status==="pending"
 ).length;


 if(!data.length){

  $("list").innerHTML=`
  <tr>
  <td colspan="7" class="empty">
  No freelancers found.
  </td>
  </tr>`;

  return;

 }


 $("list").innerHTML=
 data.map(row).join("");

}


function row(f){

 const name=
 f.name||"Unnamed Freelancer";

 const initial=
 name.trim().charAt(0).toUpperCase();


 const status=
 f.status||"pending";


 const statusClass=
 status==="published"
 ?"active"
 :status==="suspended"
 ?"suspended"
 :"pending";


 const categories=
 Array.isArray(f.categories)
 ?f.categories.join(", ")
 :(f.categories||"-");


 return`

<tr>

<td>

<div class="person">

<div class="avatar">

${
 f.profileImage
 ?
 `<img
 src="${esc(f.profileImage)}"
 alt="${esc(name)}">`
 :
 initial
}

</div>

<div>

<div class="name">

${esc(name)}

${
 f.verified
 ?
 `<span class="verified">
 <i class="fa fa-circle-check"></i>
 </span>`
 :""
}

</div>

<div class="username">
@${esc(f.username||"freelancer")}
</div>

</div>

</div>

</td>


<td>
${esc(categories)}
</td>


<td>
${esc(f.currency||"TZS")}
 ${Number(f.hourlyRate||0).toLocaleString()}
/hr
</td>


<td>
⭐ ${Number(f.rating||0).toFixed(1)}
(${Number(f.ratingCount||0)})
</td>


<td>
${Number(f.totalJobs||0)}
</td>


<td>

<span class="badge ${statusClass}">
${esc(status)}
</span>

</td>


<td>

<div class="actions">

<button
class="btn"
onclick="viewFreelancer('${f.id}')">
View
</button>

<button
class="btn"
onclick="toggleVerify('${f.id}',${!!f.verified})">
${f.verified?"Unverify":"Verify"}
</button>

<button
class="btn"
onclick="toggleFeatured('${f.id}',${!!f.featured})">
${f.featured?"Unfeature":"Feature"}
</button>

<button
class="btn danger"
onclick="toggleSuspend('${f.id}','${esc(status)}')">
${status==="suspended"?"Activate":"Suspend"}
</button>

<button
class="btn danger"
onclick="removeFreelancer('${f.id}')">
Delete
</button>

</div>

</td>

</tr>

`;

}


window.viewFreelancer=id=>{

 location.href=
 `freelancer-view.html?id=${encodeURIComponent(id)}`;

};


window.toggleVerify=async(id,current)=>{

 try{

  await updateDoc(
   doc(db,"freelancers",id),
   {
    verified:!current,
    updatedAt:serverTimestamp()
   }
  );

  await load();

 }catch(e){

  alert(e.message);

 }

};


window.toggleFeatured=async(id,current)=>{

 try{

  await updateDoc(
   doc(db,"freelancers",id),
   {
    featured:!current,
    updatedAt:serverTimestamp()
   }
  );

  await load();

 }catch(e){

  alert(e.message);

 }

};


window.toggleSuspend=async(id,status)=>{

 const next=
 status==="suspended"
 ?"published"
 :"suspended";


 try{

  await updateDoc(
   doc(db,"freelancers",id),
   {
    status:next,
    updatedAt:serverTimestamp()
   }
  );

  await load();

 }catch(e){

  alert(e.message);

 }

};


window.removeFreelancer=async id=>{

 if(
 !confirm(
 "Delete this freelancer permanently?"
 )
 )return;


 try{

  await deleteDoc(
   doc(db,"freelancers",id)
  );

  await load();

 }catch(e){

  alert(e.message);

 }

};


$("search").addEventListener(
"input",
render
);

$("statusFilter").addEventListener(
"change",
render
);


load();

</script>

</body>
</html>