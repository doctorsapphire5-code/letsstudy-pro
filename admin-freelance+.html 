);


/* =========================================
   ESC CLOSE
========================================= */

document.addEventListener(
  "keydown",
  function(e){

    if(
      e.key !== "Escape"
    )
      return;


    document
      .querySelectorAll(".modal")
      .forEach(modal => {

        modal.style.display =
          "none";

      });

  }
);


/* =========================================
   HELPERS
========================================= */

function stringToArray(value){

  return String(value || "")
    .split(",")
    .map(
      item =>
        item.trim()
    )
    .filter(Boolean);

}


function arrayToString(value){

  if(
    Array.isArray(value)
  ){

    return value.join(", ");

  }

  return value || "";

}


function setValue(id,value){

  const element =
    document.getElementById(id);

  if(!element)
    return;

  element.value =
    value ?? "";

}


function getValue(id){

  const element =
    document.getElementById(id);

  return element
    ? element.value.trim()
    : "";

}


function formatNumber(value){

  return Number(
    value || 0
  ).toLocaleString();

}


function escapeHtml(value){

  return String(
    value ?? ""
  )
  .replaceAll("&","&amp;")
  .replaceAll("<","&lt;")
  .replaceAll(">","&gt;")
  .replaceAll('"',"&quot;")
  .replaceAll("'","&#039;");

}


