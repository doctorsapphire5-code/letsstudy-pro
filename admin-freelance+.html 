========================================= */

window.toggleStatus =
async function(id){

  const freelancer =
    freelancers.find(
      f => f.id === id
    );

  if(!freelancer)
    return;


  const isSuspended =
    freelancer.status ===
    "suspended";


  const newStatus =
    isSuspended
      ? "active"
      : "suspended";


  const message =
    isSuspended
      ?
      "Activate this freelancer?"
      :
      "Suspend this freelancer?";


  if(!confirm(message))
    return;


  try{

    await updateDoc(
      doc(
        db,
        "freelancers",
        id
      ),
      {

        status:
          newStatus,

        updatedAt:
          serverTimestamp()

      }
    );


    await loadFreelancers();


  }catch(error){

    console.error(error);

    alert(
      "Unable to change status."
    );

  }

};


/* =========================================
   DELETE
========================================= */

window.deleteFreelancer =
async function(id){

  const freelancer =
    freelancers.find(
      f => f.id === id
    );

  if(!freelancer)
    return;


  const name =
    freelancer.name ||
    "this freelancer";


  if(
    !confirm(
      `Delete ${name} permanently?`
    )
  ){

    return;

  }


  try{

    await deleteDoc(
      doc(
        db,
        "freelancers",
        id
      )
    );


    alert(
      "Freelancer deleted successfully."
    );


    await loadFreelancers();


  }catch(error){

    console.error(error);

    alert(
      "Delete failed: " +
      error.message
    );

  }

};


