<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>Admin | Freelancer Management</title>

<meta name="description"
      content="LetsStudy Pro Admin Freelancer Management">

<style>

*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Inter,Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
}

button,
input,
textarea,
select{
  font:inherit;
}

button{
  cursor:pointer;
  border:0;
}

.header{
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  position:sticky;
  top:0;
  z-index:50;
}

.header-inner{
  max-width:1250px;
  margin:auto;
  padding:15px 20px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo{
  font-size:22px;
  font-weight:800;
  color:#2563eb;
}

.logo span{
  color:#111827;
}

.admin{
  display:flex;
  align-items:center;
  gap:10px;
}

.avatar{
  width:40px;
  height:40px;
  border-radius:50%;
  object-fit:cover;
}

.container{
  max-width:1250px;
  margin:auto;
  padding:25px 15px;
}

.page-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  margin-bottom:20px;
}

.page-head h1{
  margin:0;
  font-size:28px;
}

.page-head p{
  margin:5px 0 0;
  color:#64748b;
}

.btn{
  padding:10px 15px;
  border-radius:9px;
  font-weight:600;
}

.btn-primary{
  background:#2563eb;
  color:#fff;
}

.btn-primary:hover{
  background:#1d4ed8;
}

.btn-light{
  background:#f1f5f9;
  color:#334155;
}

.btn-success{
  background:#dcfce7;
  color:#15803d;
}

.btn-warning{
  background:#fef3c7;
  color:#92400e;
}

.btn-danger{
  background:#fee2e2;
  color:#b91c1c;
}

.stats{
  display:grid;
  grid-template-columns:
    repeat(5,1fr);
  gap:14px;
  margin-bottom:20px;
}

.stat{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:14px;
  padding:18px;
}

.stat-label{
  color:#64748b;
  font-size:13px;
}

.stat-value{
  display:block;
  font-size:27px;
  font-weight:800;
  margin-top:6px;
}

.toolbar{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:14px;
  padding:15px;
  display:grid;
  grid-template-columns:
    1fr 180px 180px 180px;
  gap:10px;
  margin-bottom:20px;
}

input,
textarea,
select{
  width:100%;
  padding:11px 13px;
  border:1px solid #dbe1e8;
  border-radius:9px;
  outline:none;
  background:#fff;
}

input:focus,
textarea:focus,
select:focus{
  border-color:#2563eb;
}

.table-card{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:14px;
  overflow:hidden;
}

.table-wrap{
  overflow-x:auto;
}

table{
  width:100%;
  border-collapse:collapse;
  min-width:1000px;
}

th,
td{
  padding:14px;
  text-align:left;
  border-bottom:1px solid #edf0f3;
}

th{
  background:#f8fafc;
  color:#475569;
  font-size:13px;
}

.freelancer{
  display:flex;
  align-items:center;
  gap:10px;
}

.freelancer img{
  width:45px;
  height:45px;
  border-radius:50%;
  object-fit:cover;
}

.freelancer-name{
  font-weight:700;
}

.muted{
  color:#64748b;
  font-size:13px;
}

.badge{
  display:inline-block;
  padding:5px 9px;
  border-radius:20px;
  font-size:11px;
  font-weight:700;
}

.badge-green{
  background:#dcfce7;
  color:#15803d;
}

.badge-yellow{
  background:#fef3c7;
  color:#92400e;
}

.badge-red{
  background:#fee2e2;
  color:#b91c1c;
}

.badge-blue{
  background:#dbeafe;
  color:#1d4ed8;
}

.actions{
  display:flex;
  gap:5px;
  flex-wrap:wrap;
}

.action{
  padding:7px 9px;
  border-radius:7px;
  background:#f1f5f9;
  font-size:12px;
}

.action:hover{
  background:#e2e8f0;
}

.empty{
  text-align:center;
  padding:45px 20px;
  color:#64748b;
}

.loading{
  text-align:center;
  padding:30px;
  color:#64748b;
}

.modal{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(15,23,42,.6);
  z-index:100;
  overflow:auto;
  padding:20px;
}

.modal-box{
  max-width:850px;
  margin:30px auto;
  background:#fff;
  border-radius:17px;
  padding:22px;
}

.modal-small{
  max-width:550px;
}

.modal-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:18px;
}

.modal-head h2{
  margin:0;
}

.close{
  width:36px;
  height:36px;
  border-radius:50%;
  background:#f1f5f9;
  font-size:20px;
}

.form-grid{
  display:grid;
  grid-template-columns:
    repeat(2,1fr);
  gap:14px;
}

.full{
  grid-column:1/-1;
}

label{
  display:block;
  font-size:13px;
  font-weight:700;
  margin-bottom:6px;
}

.form-actions{
  display:flex;
  justify-content:flex-end;
  gap:10px;
  margin-top:20px;
}

.profile-cover{
  width:100%;
  height:200px;
  object-fit:cover;
  border-radius:12px;
  background:#e5e7eb;
}

.profile-head{
  display:flex;
  align-items:center;
  gap:15px;
  margin-top:-35px;
  padding:0 20px;
}

.profile-avatar{
  width:90px;
  height:90px;
  border-radius:50%;
  border:5px solid #fff;
  object-fit:cover;
}

.detail-grid{
  display:grid;
  grid-template-columns:
    repeat(3,1fr);
  gap:12px;
  margin-top:20px;
}

.detail{
  background:#f8fafc;
  border-radius:10px;
  padding:13px;
}

.detail small{
  display:block;
  color:#64748b;
  margin-bottom:5px;
}

.detail strong{
  word-break:break-word;
}

.section-title{
  margin-top:25px;
  margin-bottom:12px;
}

.skills{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
}

.skill{
  padding:6px 10px;
  background:#dbeafe;
  color:#1d4ed8;
  border-radius:20px;
  font-size:12px;
}

.hidden{
  display:none!important;
}

@media(max-width:950px){

  .stats{
    grid-template-columns:
      repeat(3,1fr);
  }

  .toolbar{
    grid-template-columns:
      1fr 1fr;
  }

}

@media(max-width:600px){

  .stats{
    grid-template-columns:
      repeat(2,1fr);
  }

  .toolbar{
    grid-template-columns:1fr;
  }

  .page-head{
    align-items:flex-start;
    flex-direction:column;
  }

  .form-grid{
    grid-template-columns:1fr;
  }

  .full{
    grid-column:auto;
  }

  .detail-grid{
    grid-template-columns:1fr;
  }

}

</style>
</head>


