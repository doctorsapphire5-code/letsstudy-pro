<script type="module">

import {
 initializeApp
}
from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";


import {
 getFirestore,
 collection,
 getDocs,
 doc,
 addDoc,
 updateDoc,
 deleteDoc,
 serverTimestamp
}
from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


const firebaseConfig={

 apiKey:
 "AIzaSyBcOYDfAVKXbkljsYrgI_0rjodBn678tCc",

 authDomain:
 "let-s-study-pro-course.firebaseapp.com",

 projectId:
 "let-s-study-pro-course",

 storageBucket:
 "let-s-study-pro-course.firebasestorage.app",

 messagingSenderId:
 "474928293390",

 appId:
 "1:474928293390:web:2bcc2aebf2351c12a9fe5f"

};


const app=
initializeApp(firebaseConfig);

const db=
getFirestore(app);


let freelancers=[];


const $=id=>
document.getElementById(id);


function esc(value=""){

 return String(value??"")
 .replace(/&/g,"&amp;")
 .replace(/</g,"&lt;")
 .replace(/>/g,"&gt;")
 .replace(/"/g,"&quot;")
 .replace(/'/g,"&#039;");

}


/* LOAD */

async function load(){

 try{

  const snap=
  await getDocs(
   collection(db,"freelancers")
  );


  freelancers=
  snap.docs.map(d=>({

   id:d.id,

   ...d.data()

  }));


  render();


 }catch(error){

  console.error(error);

  $("list").innerHTML=`

  <tr>

  <td
  colspan="7"
  class="empty">

  Unable to load freelancers.

  </td>

  </tr>`;

 }

}


/* RENDER */

function render(){

 const q=
 $("search").value
 .toLowerCase()
 .trim();


 const status=
 $("statusFilter").value;


 const data=
 freelancers.filter(f=>{

  const text=`

  ${f.name||""}
  ${f.username||""}
  ${f.headline||""}
  ${f.city||""}
  ${f.country||""}

  ${
   Array.isArray(f.categories)
   ?f.categories.join(" ")
   :""
  }

  `.toLowerCase();


  return(

   (!q||text.includes(q)) &&

   (!status||f.status===status)

  );

 });


 $("total").textContent=
 freelancers.length.toLocaleString();


 $("verifiedCount").textContent=
 freelancers.filter(
  f=>f.verified
 ).length;


 $("featuredCount").textContent=
 freelancers.filter(
  f=>f.featured
 ).length;


 $("pendingCount").textContent=
 freelancers.filter(
  f=>!f.status||
  f.status==="pending"
 ).length;


 if(!data.length){

  $("list").innerHTML=`

  <tr>

  <td
  colspan="7"
  class="empty">

  No freelancers found.

  </td>

  </tr>`;

  return;

 }


 $("list").innerHTML=
 data.map(row).join("");

}


/* ROW */

function row(f){

 const name=
 f.name||
 "Unnamed Freelancer";


 const initial=
 name.trim()
 .charAt(0)
 .toUpperCase();


 const status=
 f.status||
 "pending";


 const statusClass=
 status==="published"
 ?"active"
 :status==="suspended"
 ?"suspended"
 :"pending";


 const categories=
 Array.isArray(f.categories)
 ?f.categories.join(", ")
 :(f.categories||"-");


 return`

<tr>

<td>

<div class="person">

<div class="avatar">

${

 f.profileImage

 ?

 `<img
 src="${esc(f.profileImage)}"
 alt="${esc(name)}">`

 :

 initial

}

</div>


<div>

<div class="name">

${esc(name)}

${

 f.verified

 ?

 `<span class="verified">

 <i class="fa fa-circle-check"></i>

 </span>`

 :

 ""

}

</div>


<div class="username">

@${esc(
 f.username||
 "freelancer"
)}

</div>

</div>

</div>

</td>


<td>

${esc(categories)}

</td>


<td>

${esc(f.currency||"TZS")}

${Number(
 f.hourlyRate||0
).toLocaleString()}

/hr

</td>


<td>

⭐

${Number(
 f.rating||0
).toFixed(1)}

(${Number(
 f.ratingCount||0
)})

</td>


<td>

${Number(
 f.totalJobs||0
)}

</td>


<td>

<span
class="badge ${statusClass}">

${esc(status)}

</span>

</td>


<td>

<div class="actions">


<button
class="btn"
onclick="viewFreelancer('${f.id}')">

View

</button>


<button
class="btn"
onclick="toggleVerify('${f.id}',${!!f.verified})">

${f.verified?"Unverify":"Verify"}

</button>


<button
class="btn"
onclick="toggleFeatured('${f.id}',${!!f.featured})">

${f.featured?"Unfeature":"Feature"}

</button>


<button
class="btn danger"
onclick="toggleSuspend('${f.id}','${status}')">

${status==="suspended"
?"Activate"
:"Suspend"}

</button>


<button
class="btn danger"
onclick="removeFreelancer('${f.id}')">

Delete

</button>


</div>

</td>

</tr>

`;

}


/* ADD MODAL */

window.openAdd=()=>{

 $("addModal").style.display=
 "block";

 document.body.style.overflow=
 "hidden";

};


window.closeAdd=()=>{

 $("addModal").style.display=
 "none";

 document.body.style.overflow=
 "";

 $("addForm").reset();

};


/* ADD FREELANCER */

$("addForm").addEventListener(
 "submit",
 async e=>{

  e.preventDefault();


  const saveBtn=
  $("saveBtn");


  saveBtn.disabled=true;

  saveBtn.innerHTML=
  '<i class="fa fa-spinner fa-spin"></i> Creating...';


  try{

   const name=
   $("name").value.trim();


   const username=
   $("username").value
   .trim()
   .replace(/^@/,"");


   const freelancer={

    userId:"",

    name:name,

    username:username,

    slug:
    username
    .toLowerCase()
    .replace(/[^a-z0-9]+/g,"-")
    .replace(/^-|-$/g,""),

    email:
    $("email").value.trim(),

    profileImage:
    $("profileImage").value.trim(),

    coverImage:
    $("coverImage").value.trim(),

    headline:
    $("headline").value.trim(),

    bio:
    $("bio").value.trim(),

    country:
    $("country").value.trim(),

    region:
    $("region").value.trim(),

    city:
    $("city").value.trim(),

    timezone:
    "Africa/Dar_es_Salaam",

    languages:[],

    skills:
    $("skills").value
    .split(",")
    .map(x=>x.trim())
    .filter(Boolean),

    categories:
    $("categories").value
    .split(",")
    .map(x=>x.trim())
    .filter(Boolean),

    experienceLevel:
    $("experienceLevel").value,

    hourlyRate:
    Number(
     $("hourlyRate").value||0
    ),

    currency:
    $("currency").value,

    availability:
    $("availability").value,

    responseTime:
    "24 hours",

    totalJobs:0,

    completedJobs:0,

    activeJobs:0,

    rating:0,

    ratingCount:0,

    totalEarnings:0,

    portfolioCount:0,

    verified:false,

    featured:false,

    status:
    $("status").value,

    createdAt:
    serverTimestamp(),

    updatedAt:
    serverTimestamp(),

    publishedAt:
    $("status").value==="published"
    ?serverTimestamp()
    :null

   };


   const ref=
   await addDoc(
    collection(db,"freelancers"),
    freelancer
   );


   /*
    Firestore document ID
    ndiyo freelancerId
   */

   alert(
    "Freelancer created successfully!\n\n"+
    "Freelancer ID: "+
    ref.id
   );


   closeAdd();


   await load();


  }catch(error){

   console.error(error);

   alert(
    "Failed to create freelancer:\n"+
    error.message
   );


  }finally{

   saveBtn.disabled=false;

   saveBtn.innerHTML=
   '<i class="fa fa-plus"></i> Create Freelancer';

  }

 });


/* VIEW */

window.viewFreelancer=id=>{

 location.href=
 `admin-freelancer-view.html?id=${
  encodeURIComponent(id)
 }`;

};


/* VERIFY */

window.toggleVerify=
async(id,current)=>{

 try{

  await updateDoc(

   doc(
    db,
    "freelancers",
    id
   ),

   {
    verified:!current,

    updatedAt:
    serverTimestamp()
   }

  );


  await load();


 }catch(e){

  alert(e.message);

 }

};


/* FEATURE */

window.toggleFeatured=
async(id,current)=>{

 try{

  await updateDoc(

   doc(
    db,
    "freelancers",
    id
   ),

   {
    featured:!current,

    updatedAt:
    serverTimestamp()
   }

  );


  await load();


 }catch(e){

  alert(e.message);

 }

};


/* SUSPEND */

window.toggleSuspend=
async(id,status)=>{

 const next=
 status==="suspended"
 ?"published"
 :"suspended";


 try{

  await updateDoc(

   doc(
    db,
    "freelancers",
    id
   ),

   {
    status:next,

    updatedAt:
    serverTimestamp()
   }

  );


  await load();


 }catch(e){

  alert(e.message);

 }

};


/* DELETE */

window.removeFreelancer=
async id=>{

 if(
 !confirm(
 "Delete this freelancer permanently?"
 )
 )return;


 try{

  await deleteDoc(

   doc(
    db,
