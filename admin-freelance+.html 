<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Admin Freelancers | LetsStudy Pro</title>

<link rel="icon" href="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgQHmJO8e8twONhRhp3I6pP4NFDh-LPcqVtAmQ9R9XjOGaVMKShfSLmxeK0fVzJsybBBOXKbA8LIhjgTgko83C-UPVhwgXeLtvTfjtVv6aVGgQgniOF-gMC28bY78HryXZ-5OqCwdBpKGqjEfTta5jLjT1mpvtBi2DQKyu35rkxsZNoVvl0nhvxUUn1gDP0/s1600/Untitled%20design_20260717_144337_0000.jpg">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
*{box-sizing:border-box}
body{margin:0;background:#f6f8fb;color:#172033;font-family:Inter,Arial,sans-serif}
button,input,select,textarea{font:inherit}
.top{height:64px;background:#fff;border-bottom:1px solid #e5e7eb;display:flex;align-items:center;justify-content:space-between;padding:0 5%;position:sticky;top:0;z-index:20}
.logo{color:#155eef;font-size:20px;font-weight:900}
.admin{background:#eef4ff;color:#155eef;padding:8px 12px;border-radius:20px;font-size:11px;font-weight:800}
.container{max-width:1200px;margin:30px auto;padding:0 20px}
.header{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:22px}
h1{margin:0;font-size:28px}
.subtitle{color:#667085;font-size:13px;margin-top:6px}
.header-right{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.search{display:flex;gap:8px}
.search input,.search select{padding:11px 13px;border:1px solid #d0d5dd;border-radius:9px;outline:none;background:#fff}
.add-btn{border:0;background:#155eef;color:#fff;padding:11px 15px;border-radius:9px;font-size:12px;font-weight:800;cursor:pointer}
.add-btn:hover{background:#073bba}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}
.stat{background:#fff;border:1px solid #e5e7eb;border-radius:13px;padding:18px}
.stat i{color:#155eef;margin-bottom:10px}
.stat strong{display:block;font-size:22px}
.stat span{color:#667085;font-size:11px}
.table-box{background:#fff;border:1px solid #e5e7eb;border-radius:15px;overflow:auto}
table{width:100%;border-collapse:collapse;min-width:950px}
th{background:#f8fafc;color:#667085;font-size:10px;text-transform:uppercase;text-align:left;padding:13px}
td{padding:13px;border-top:1px solid #eaecf0;font-size:12px}
.person{display:flex;align-items:center;gap:10px}
.avatar{width:40px;height:40px;border-radius:50%;background:#eef4ff;color:#155eef;display:flex;align-items:center;justify-content:center;overflow:hidden;font-weight:800}
.avatar img{width:100%;height:100%;object-fit:cover}
.name{font-weight:800}
.username{color:#667085;font-size:10px;margin-top:3px}
.badge{display:inline-block;padding:5px 8px;border-radius:20px;font-size:9px;font-weight:800}
.active{background:#ecfdf3;color:#027a48}
.pending{background:#fffaeb;color:#b54708}
.suspended{background:#fef3f2;color:#b42318}
.verified{color:#12b76a;margin-left:3px}
.actions{display:flex;gap:5px;flex-wrap:wrap}
.btn{border:1px solid #d0d5dd;background:#fff;padding:7px 9px;border-radius:7px;cursor:pointer;font-size:10px;font-weight:700}
.btn:hover{border-color:#155eef;color:#155eef}
.btn.danger:hover{color:#b42318;border-color:#b42318}
.loading,.empty{padding:50px;text-align:center;color:#667085}
.modal{display:none;position:fixed;inset:0;background:rgba(15,23,42,.65);z-index:100;padding:20px;overflow:auto}
.modal-box{width:100%;max-width:800px;margin:30px auto;background:#fff;border-radius:18px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.2)}
.modal-head{display:flex;justify-content:space-between;align-items:flex-start;padding:22px 25px;border-bottom:1px solid #eaecf0}
.modal-head h2{margin:0;font-size:21px}
.modal-head p{margin:6px 0 0;color:#667085;font-size:12px}
.close{width:34px;height:34px;border:0;border-radius:50%;background:#f2f4f7;cursor:pointer;font-size:20px}
.form{padding:25px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.field{margin-bottom:14px}
.field label{display:block;font-size:11px;font-weight:800;margin-bottom:6px;color:#344054}
.field input,.field select,.field textarea{width:100%;border:1px solid #d0d5dd;border-radius:9px;padding:11px 12px;outline:none;background:#fff}
.field textarea{min-height:100px;resize:vertical}
.field input:focus,.field select:focus,.field textarea:focus{border-color:#155eef}
.full{grid-column:1/-1}
.form-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:8px;padding-top:18px;border-top:1px solid #eaecf0}
.cancel{border:1px solid #d0d5dd;background:#fff;padding:11px 16px;border-radius:9px;cursor:pointer;font-weight:800}
.save{border:0;background:#155eef;color:#fff;padding:11px 18px;border-radius:9px;cursor:pointer;font-weight:800}
.save:disabled{opacity:.6;cursor:not-allowed}
@media(max-width:900px){
.header{flex-direction:column;align-items:flex-start}
.header-right{width:100%}
.search{width:100%}
.search input,.search select{flex:1}
}
@media(max-width:650px){
.stats{grid-template-columns:repeat(2,1fr)}
.form-grid{grid-template-columns:1fr}
.full{grid-column:auto}
.header-right{flex-direction:column;align-items:stretch}
.add-btn{width:100%}
.search{flex-direction:column}
}
</style>
</head>

<body>

<header class="top">
<div class="logo">LetsStudy Pro</div>
<div class="admin">
<i class="fa fa-shield-halved"></i> ADMIN
</div>
</header>

<main class="container">

<div class="header">

<div>
<h1>Freelancer Management</h1>
<div class="subtitle">Manage, verify, feature and control freelancers.</div>
</div>

<div class="header-right">

<button class="add-btn" id="addButton">
<i class="fa fa-plus"></i> Add Freelancer
</button>

<div class="search">

<input id="search" placeholder="Search freelancer..." autocomplete="off">

<select id="statusFilter">
<option value="">All Status</option>
<option value="published">Published</option>
<option value="pending">Pending</option>
<option value="suspended">Suspended</option>
</select>

</div>
</div>
</div>

<section class="stats">

<div class="stat">
<i class="fa fa-users"></i>
<strong id="total">0</strong>
<span>Total Freelancers</span>
</div>

<div class="stat">
<i class="fa fa-circle-check"></i>
<strong id="verifiedCount">0</strong>
<span>Verified</span>
</div>

<div class="stat">
<i class="fa fa-star"></i>
<strong id="featuredCount">0</strong>
<span>Featured</span>
</div>

<div class="stat">
<i class="fa fa-user-clock"></i>
<strong id="pendingCount">0</strong>
<span>Pending</span>
</div>

</section>

<section class="table-box">

<table>

<thead>
<tr>
<th>Freelancer</th>
<th>Category</th>
<th>Rate</th>
<th>Rating</th>
<th>Jobs</th>
<th>Status</th>
<th>Actions</th>
</tr>
</thead>

<tbody id="list">
<tr>
<td colspan="7" class="loading">
<i class="fa fa-spinner fa-spin"></i>
Loading freelancers...
</td>
</tr>
</tbody>

</table>

</section>

</main>


<!-- ADD MODAL -->

<div id="addModal" class="modal">

<div class="modal-box">

<div class="modal-head">

<div>
<h2>Add Freelancer</h2>
<p>Create a professional freelancer profile.</p>
</div>

<button class="close" id="closeButton">×</button>

</div>

<form id="addForm" class="form">

<div class="form-grid">

<div class="field">
<label>Full Name *</label>
<input id="name" required placeholder="John Doe">
</div>

<div class="field">
<label>Username *</label>
<input id="username" required placeholder="johndoe">
</div>

<div class="field">
<label>Email</label>
<input id="email" type="email" placeholder="john@example.com">
</div>

<div class="field">
<label>Professional Headline</label>
<input id="headline" placeholder="Full Stack Developer">
</div>

<div class="field">
<label>Country</label>
<input id="country" placeholder="Tanzania">
</div>

<div class="field">
<label>Region</label>
<input id="region" placeholder="Dar es Salaam">
</div>

<div class="field">
<label>City</label>
<input id="city" placeholder="Dar es Salaam">
</div>

<div class="field">
<label>Hourly Rate</label>
<input id="hourlyRate" type="number" min="0" placeholder="25000">
</div>

<div class="field">
<label>Currency</label>
<select id="currency">
<option value="TZS">TZS</option>
<option value="USD">USD</option>
<option value="EUR">EUR</option>
</select>
</div>

<div class="field">
<label>Experience Level</label>
<select id="experienceLevel">
<option value="Beginner">Beginner</option>
<option value="Intermediate">Intermediate</option>
<option value="Expert">Expert</option>
</select>
</div>

<div class="field">
<label>Availability</label>
<select id="availability">
<option value="available">Available</option>
<option value="busy">Busy</option>
<option value="unavailable">Unavailable</option>
</select>
</div>

<div class="field">
<label>Status</label>
<select id="status">
<option value="pending">Pending</option>
<option value="published">Published</option>
<option value="suspended">Suspended</option>
</select>
</div>

<div class="field full">
<label>Skills</label>
<input id="skills" placeholder="Web Development, SEO, Design">
</div>

<div class="field full">
<label>Categories</label>
<input id="categories" placeholder="Technology, Marketing, Design">
</div>

<div class="field full">
<label>Profile Image URL</label>
<input id="profileImage" placeholder="https://...">
</div>

<div class="field full">
<label>Cover Image URL</label>
<input id="coverImage" placeholder="https://...">
</div>

<div class="field full">
<label>Bio</label>
<textarea id="bio" placeholder="Write freelancer professional biography..."></textarea>
</div>

</div>

<div class="form-actions">

<button type="button" class="cancel" id="cancelButton">
Cancel
</button>

<button type="submit" class="save" id="saveBtn">
<i class="fa fa-plus"></i> Create Freelancer
</button>

</div>

</form>

</div>
</div>


<script type="module">

import{
initializeApp
}from"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

import{
getFirestore,
collection,
getDocs,
addDoc,
updateDoc,
deleteDoc,
doc,
serverTimestamp
}from"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


/* FIREBASE */

const firebaseConfig={

apiKey:"AIzaSyBcOYDfAVKXbkljsyRgI_0rj0rodBn678tCc",

authDomain:"let-s-study-pro-course.firebaseapp.com",

databaseURL:"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:"let-s-study-pro-course",

storageBucket:"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:"474928293390",

appId:"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:"G-85B7V5H5J0"

};

const app=initializeApp(firebaseConfig);
const db=getFirestore(app);

let freelancers=[];

const $=id=>document.getElementById(id);


/* ESCAPE */

function esc(value=""){

return String(value??"")
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}


/* LOAD */

async function load(){

$("list").innerHTML=`
<tr>
<td colspan="7" class="loading">
<i class="fa fa-spinner fa-spin"></i>
Loading freelancers...
</td>
</tr>`;

try{

const snap=
await getDocs(
collection(db,"freelancers")
);

freelancers=
snap.docs.map(d=>({
id:d.id,
...d.data()
}));

render();

}catch(error){

console.error(error);

$("list").innerHTML=`
<tr>
<td colspan="7" class="empty">
Unable to load freelancers.
<br>
<small>${esc(error.message)}</small>
</td>
</tr>`;

}

}


/* RENDER */

function render(){

const q=
$("search").value
.toLowerCase()
.trim();

const status=
$("statusFilter").value;

const data=
freelancers.filter(f=>{

const skills=
Array.isArray(f.skills)
?f.skills.join(" ")
:String(f.skills||"");

const categories=
Array.isArray(f.categories)
?f.categories.join(" ")
:String(f.categories||"");

const text=[
f.name,
f.username,
f.headline,
f.city,
f.region,
f.country,
skills,
categories
].join(" ")
.toLowerCase();

return(
(!q||text.includes(q))&&
(!status||String(f.status||"pending")===status)
);

});


$("total").textContent=
freelancers.length.toLocaleString();

$("verifiedCount").textContent=
freelancers.filter(f=>f.verified===true).length;

$("featuredCount").textContent=
freelancers.filter(f=>f.featured===true).length;

$("pendingCount").textContent=
freelancers.filter(
f=>!f.status||f.status==="pending"
).length;


if(!data.length){

$("list").innerHTML=`
<tr>
<td colspan="7" class="empty">
No freelancers found.
</td>
</tr>`;

return;

}

$("list").innerHTML=
data.map(row).join("");

}


/* ROW */

function row(f){

const name=
f.name||"Unnamed Freelancer";

const initial=
name.trim().charAt(0).toUpperCase();

const status=
f.status||"pending";

const statusClass=
status==="published"
?"active"
:status==="suspended"
?"suspended"
:"pending";

const categories=
Array.isArray(f.categories)
?f.categories.join(", ")
:(f.categories||"-");

const rating=
Number(f.rating||0);

const ratingCount=
Number(
f.ratingCount||
f.reviewsCount||
0
);

const jobs=
Number(
f.totalJobs||
f.jobs||
f.completedJobs||
0
);

const rate=
Number(
f.hourlyRate||
f.rate||
0
);

return`

<tr>

<td>

<div class="person">

<div class="avatar">

${
f.profileImage
?
`<img
src="${esc(f.profileImage)}"
alt="${esc(name)}"
onerror="this.style.display='none'">`
:
esc(initial)
}

</div>

<div>

<div class="name">

${esc(name)}

${
f.verified
?
`<span class="verified">
<i class="fa fa-circle-check"></i>
</span>`
:""
}

</div>

<div class="username">
@${esc(f.username||"freelancer")}
</div>

</div>

</div>

</td>

<td>${esc(categories)}</td>

<td>
${esc(f.currency||"TZS")}
${rate.toLocaleString()}/hr
</td>

<td>
⭐ ${rating.toFixed(1)}
(${ratingCount})
</td>

<td>${jobs}</td>

<td>
<span class="badge ${statusClass}">
${esc(status)}
</span>
</td>

<td>

<div class="actions">

<button
class="btn"
data-action="view"
data-id="${esc(f.id)}">
View
</button>

<button
class="btn"
data-action="verify"
data-id="${esc(f.id)}">
${f.verified?"Unverify":"Verify"}
</button>

<button
class="btn"
data-action="feature"
data-id="${esc(f.id)}">
${f.featured?"Unfeature":"Feature"}
</button>

<button
class="btn danger"
data-action="suspend"
data-id="${esc(f.id)}">
${status==="suspended"?"Activate":"Suspend"}
</button>

<button
class="btn danger"
data-action="delete"
data-id="${esc(f.id)}">
Delete
</button>

</div>

</td>

</tr>

`;

}


/* MODAL */

function openAdd(){

$("addModal").style.display="block";
document.body.style.overflow="hidden";

}

function closeAdd(){

$("addModal").style.display="none";
document.body.style.overflow="";
$("addForm").reset();

}

$("addButton").addEventListener(
"click",
openAdd
);

$("closeButton").addEventListener(
"click",
closeAdd
);

$("cancelButton").addEventListener(
"click",
closeAdd
);

$("addModal").addEventListener(
"click",
e=>{
if(e.target===$("addModal"))
closeAdd();
}
);


/* CREATE */

$("addForm").addEventListener(
"submit",
async e=>{

e.preventDefault();

const btn=$("saveBtn");

btn.disabled=true;
btn.innerHTML=
'<i class="fa fa-spinner fa-spin"></i> Creating...';

try{

const name=$("name").value.trim();

const username=
$("username").value
.trim()
.replace(/^@/,"");

const status=$("status").value;

const freelancer={

userId:"",

name,

username,

slug:
username
.toLowerCase()
.replace(/[^a-z0-9]+/g,"-")
.replace(/^-|-$/g,""),

email:$("email").value.trim(),

headline:$("headline").value.trim(),

bio:$("bio").value.trim(),

country:$("country").value.trim(),

region:$("region").value.trim(),

city:$("city").value.trim(),

profileImage:$("profileImage").value.trim(),

coverImage:$("coverImage").value.trim(),

skills:$("skills").value
.split(",")
.map(x=>x.trim())
.filter(Boolean),

categories:$("categories").value
.split(",")
.map(x=>x.trim())
.filter(Boolean),

hourlyRate:Number(
$("hourlyRate").value||0
),

currency:$("currency").value,

experienceLevel:
$("experienceLevel").value,

availability:
$("availability").value,

languages:[],

responseTime:"24 hours",

totalJobs:0,

completedJobs:0,

activeJobs:0,

rating:0,

ratingCount:0,

totalEarnings:0,

portfolioCount:0,

verified:false,

featured:false,

status,

createdAt:serverTimestamp(),

updatedAt:serverTimestamp(),

publishedAt:
status==="published"
?serverTimestamp()
:null

};


const ref=
await addDoc(
collection(db,"freelancers"),
freelancer
);

alert(
"Freelancer created successfully!\n\n"+
"Freelancer ID: "+
ref.id
);

closeAdd();

await load();

}catch(error){

console.error(error);

alert(
"Failed to create freelancer:\n"+
error.message
);

}finally{

btn.disabled=false;

btn.innerHTML=
'<i class="fa fa-plus"></i> Create Freelancer';

}

});


/* ACTIONS */

$("list").addEventListener(
"click",
async e=>{

const button=
e.target.closest("button[data-action]");

if(!button)return;

const id=
button.dataset.id;

const action=
button.dataset.action;

if(action==="view"){

location.href=
"admin-freelancer-view.html?id="+
encodeURIComponent(id);

return;

}

const freelancer=
freelancers.find(
f=>f.id===id
);

if(!freelancer)return;


try{

if(action==="verify"){

await updateDoc(
doc(db,"freelancers",id),
{
verified:!freelancer.verified,
updatedAt:serverTimestamp()
}
);

}


if(action==="feature"){

await updateDoc(
doc(db,"freelancers",id),
{
featured:!freelancer.featured,
updatedAt:serverTimestamp()
}
);

}


if(action==="suspend"){

const next=
freelancer.status==="suspended"
?"published"
:"suspended";

await updateDoc(
doc(db,"freelancers",id),
{
status:next,
updatedAt:serverTimestamp()
}
);

}


if(action==="delete"){

if(!confirm(
"Delete this freelancer permanently?"
))return;

await deleteDoc(
doc(db,"freelancers",id)
);

}

await load();

}catch(error){

console.error(error);

alert(
"Action failed:\n"+
error.message
);

}

});


/* SEARCH */

$("search").addEventListener(
"input",
render
);

$("statusFilter").addEventListener(
"change",
render
);


/* START */

load();

</script>

</body>
</html>