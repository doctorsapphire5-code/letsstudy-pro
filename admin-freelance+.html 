 resize:vertical
}

button{
 border:0;
 border-radius:9px;
 padding:10px 13px;
 cursor:pointer;
 font-weight:700
}

.primary{
 background:#155eef;
 color:#fff
}

.light{
 background:#eef2f6;
 color:#344054
}

.danger{
 background:#fee4e2;
 color:#b42318
}

.success{
 background:#ecfdf3;
 color:#027a48
}

.grid{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:16px
}

.card{
 overflow:hidden
}

.cover{
 height:105px;
 background:#e9eef7;
 position:relative
}

.cover img{
 width:100%;
 height:100%;
 object-fit:cover
}

.profile{
 position:absolute;
 width:70px;
 height:70px;
 border-radius:50%;
 border:4px solid #fff;
 left:15px;
 bottom:-35px;
 object-fit:cover;
 background:#eef2f6
}

.badge{
 position:absolute;
 top:9px;
 padding:5px 9px;
 border-radius:20px;
 font-size:10px;
 font-weight:800
}

.featured{
 left:9px;
 background:#f59e0b;
 color:#fff
}

.status{
 right:9px
}

.published{
