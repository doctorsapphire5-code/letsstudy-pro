}

.toolbar{
 padding:12px;
 display:grid;
 grid-template-columns:2fr 1fr 1fr 1fr auto;
 gap:9px;
 margin-bottom:16px
}

input,select,textarea{
 width:100%;
 padding:11px;
 border:1px solid #d9dee8;
 border-radius:9px;
 outline:none;
 background:#fff
}

textarea{
