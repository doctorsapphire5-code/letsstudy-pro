              deleteInternship(
                '${escapeAttribute(
                  internship.id
                )}'
              )
            "
          >
            🗑
          </button>

        </div>

      </td>

    </tr>

  `;

}


/*
====================================================
STATUS
====================================================
*/

function getCurrentStatus(
  internship
){

  const status =
    internship.status ||
    "active";


  if(
    status === "active" &&
    internship.deadline
  ){

    const deadline =
      new Date(
        internship.deadline
      );


    if(
      !Number.isNaN(
        deadline.getTime()
      ) &&
      deadline < new Date()
    ){

      return "expired";

    }

  }


  return status;

}


/*
====================================================
STATS
====================================================
*/

function updateStats(){

  const total =
    internships.length;


  const active =
    internships.filter(
      item =>
        getCurrentStatus(
          item
        ) === "active"
    ).length;


  const totalApplications =
    applications.length;


  const pending =
    applications.filter(
      item =>
        !item.status ||
        item.status ===
        "pending" ||
        item.status ===
        "submitted"
    ).length;


  document.getElementById(
    "totalInternships"
  ).textContent =
    total;


  document.getElementById(
    "activeInternships"
  ).textContent =
    active;


  document.getElementById(
    "totalApplications"
  ).textContent =
    totalApplications;


  document.getElementById(
    "pendingApplications"
  ).textContent =
    pending;

}


