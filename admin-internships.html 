<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width,initial-scale=1.0"
>

<title>
  Admin Internships | LetsStudy Pro
</title>

<meta
  name="description"
  content="Manage internships, companies, applications and internship opportunities on LetsStudy Pro."
>

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:
    Inter,
    Arial,
    sans-serif;
  background:#f5f7fb;
  color:#172033;
}

button,
input,
select,
textarea{
  font:inherit;
}

button{
  cursor:pointer;
}

.layout{
  display:flex;
  min-height:100vh;
}


/* SIDEBAR */

.sidebar{
  width:250px;
  background:#111827;
  color:white;
  position:fixed;
  left:0;
  top:0;
  bottom:0;
  padding:22px 15px;
  z-index:1000;
  overflow-y:auto;
}

.logo{
  font-size:22px;
  font-weight:800;
  padding:5px 12px 25px;
}

.logo span{
  color:#60a5fa;
}

.nav-title{
  font-size:11px;
  color:#9ca3af;
  text-transform:uppercase;
  letter-spacing:1px;
  padding:15px 12px 8px;
}

.nav a{
  display:flex;
  align-items:center;
  gap:12px;
  text-decoration:none;
  color:#d1d5db;
  padding:11px 12px;
  border-radius:9px;
  margin:3px 0;
  font-size:14px;
}

.nav a:hover,
.nav a.active{
  background:#1f2937;
  color:white;
}

.nav-icon{
  width:22px;
  text-align:center;
}


/* MAIN */

.main{
  margin-left:250px;
  width:calc(100% - 250px);
  min-width:0;
}

.topbar{
  height:72px;
  background:white;
  border-bottom:1px solid #e5e7eb;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 28px;
  position:sticky;
  top:0;
  z-index:500;
}

.page-title{
  font-size:20px;
  font-weight:800;
}

.page-subtitle{
  color:#6b7280;
  font-size:12px;
  margin-top:3px;
}

.mobile-menu{
  display:none;
  border:0;
  background:#f3f4f6;
  padding:8px 10px;
  border-radius:8px;
}


/* CONTENT */

.content{
  padding:28px;
}

.header-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  margin-bottom:24px;
}

.heading h1{
  font-size:28px;
  margin-bottom:5px;
}

.heading p{
  color:#6b7280;
  font-size:14px;
}


/* BUTTONS */

.btn{
  border:0;
  border-radius:8px;
  padding:10px 15px;
  font-weight:700;
  transition:.2s;
}

.btn:hover{
  transform:translateY(-1px);
}

.btn-primary{
  background:#2563eb;
  color:white;
}

.btn-primary:hover{
  background:#1d4ed8;
}

.btn-secondary{
  background:#eef2f7;
  color:#374151;
}

.btn-success{
  background:#059669;
  color:white;
}

.btn-danger{
  background:#dc2626;
  color:white;
}

.btn-warning{
  background:#d97706;
  color:white;
}


/* STATS */

.stats{
  display:grid;
  grid-template-columns:
    repeat(4,minmax(0,1fr));
  gap:16px;
  margin-bottom:22px;
}

.stat-card{
  background:white;
  border:1px solid #e5e7eb;
  border-radius:13px;
  padding:19px;
}

.stat-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.stat-label{
  color:#6b7280;
  font-size:13px;
}

.stat-icon{
  width:38px;
  height:38px;
  border-radius:10px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#eff6ff;
  font-size:19px;
}

.stat-value{
  font-size:27px;
  font-weight:800;
  margin-top:10px;
}


/* TOOLBAR */

.card{
  background:white;
  border:1px solid #e5e7eb;
  border-radius:13px;
  overflow:hidden;
}

.toolbar{
  padding:17px;
  display:flex;
  gap:10px;
  align-items:center;
  flex-wrap:wrap;
  border-bottom:1px solid #e5e7eb;
}

.search{
  flex:1;
  min-width:220px;
  position:relative;
}

.search input{
  width:100%;
  border:1px solid #d1d5db;
  border-radius:8px;
  padding:10px 12px 10px 38px;
  outline:none;
}

.search input:focus{
  border-color:#2563eb;
}

.search-icon{
  position:absolute;
  left:13px;
  top:10px;
  color:#9ca3af;
}

.filter{
  border:1px solid #d1d5db;
  border-radius:8px;
  padding:10px 12px;
  background:white;
  outline:none;
}


/* TABLE */

.table-wrap{
  overflow-x:auto;
}

table{
  width:100%;
  border-collapse:collapse;
  min-width:1000px;
}

th{
  text-align:left;
  padding:13px 16px;
  background:#f9fafb;
  color:#6b7280;
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.5px;
}

td{
  padding:15px 16px;
  border-top:1px solid #eef0f3;
  font-size:13px;
  vertical-align:middle;
}

tr:hover td{
  background:#fafcff;
}

.internship-title{
  font-weight:800;
  color:#111827;
}

.internship-id{
  font-size:10px;
  color:#9ca3af;
  margin-top:4px;
  word-break:break-all;
}

.company{
  font-weight:700;
}

.location{
  color:#6b7280;
}

.salary{
  font-weight:700;
}


/* STATUS */

.status{
  display:inline-flex;
  padding:5px 9px;
  border-radius:999px;
  font-size:11px;
  font-weight:700;
}

.status-active{
  color:#047857;
  background:#d1fae5;
}

.status-draft{
  color:#92400e;
  background:#fef3c7;
}

.status-closed{
  color:#b91c1c;
  background:#fee2e2;
}

.status-expired{
  color:#4b5563;
  background:#e5e7eb;
}


/* ACTIONS */

.actions{
  display:flex;
  gap:6px;
}

.small-btn{
  border:0;
  width:33px;
  height:33px;
  border-radius:7px;
  display:flex;
  align-items:center;
  justify-content:center;
}

.view-btn{
  background:#eff6ff;
  color:#2563eb;
}

.edit-btn{
  background:#fff7ed;
  color:#c2410c;
}

.delete-btn{
  background:#fef2f2;
  color:#dc2626;
}


/* MODAL */

.modal-overlay{
  position:fixed;
  inset:0;
  background:rgba(15,23,42,.55);
  display:none;
  align-items:center;
  justify-content:center;
  padding:20px;
  z-index:2000;
}

.modal-overlay.show{
  display:flex;
}

.modal{
  width:min(850px,100%);
  max-height:92vh;
  overflow-y:auto;
  background:white;
  border-radius:14px;
  box-shadow:0 20px 60px rgba(0,0,0,.2);
}

.modal.large{
  width:min(1050px,100%);
}

.modal-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:20px 22px;
  border-bottom:1px solid #e5e7eb;
  position:sticky;
  top:0;
  background:white;
  z-index:2;
}

.modal-header h2{
  font-size:18px;
}

.close{
  width:35px;
  height:35px;
  border:0;
  border-radius:8px;
  background:#f3f4f6;
  font-size:22px;
  color:#4b5563;
}

.modal-body{
  padding:22px;
}

.modal-footer{
  padding:17px 22px;
  border-top:1px solid #e5e7eb;
  display:flex;
  justify-content:flex-end;
  gap:10px;
}


/* FORM */

.form-grid{
  display:grid;
  grid-template-columns:
    repeat(2,minmax(0,1fr));
  gap:16px;
}

.form-group{
  margin-bottom:15px;
}

.form-group.full{
  grid-column:1/-1;
}

.form-group label{
  display:block;
  font-size:12px;
  font-weight:700;
  margin-bottom:7px;
  color:#374151;
}

.form-group input,
.form-group select,
.form-group textarea{
  width:100%;
  border:1px solid #d1d5db;
  border-radius:8px;
  padding:10px 12px;
  outline:none;
  background:white;
}

.form-group textarea{
  min-height:100px;
  resize:vertical;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus{
  border-color:#2563eb;
  box-shadow:0 0 0 3px rgba(37,99,235,.08);
}


/* CHECKBOX */

.checkbox-row{
  display:flex;
  gap:9px;
  align-items:center;
}

.checkbox-row input{
  width:auto;
}


/* DESCRIPTION */

.description-box{
  line-height:1.7;
  color:#4b5563;
  white-space:pre-wrap;
}


/* APPLICATION */

.application-card{
  border:1px solid #e5e7eb;
  border-radius:11px;
  padding:17px;
  margin-bottom:12px;
}

.application-top{
  display:flex;
  justify-content:space-between;
  gap:15px;
}

.applicant-name{
  font-weight:800;
  font-size:15px;
}

.application-meta{
  color:#6b7280;
  font-size:12px;
  line-height:1.7;
  margin-top:4px;
}

.application-actions{
  display:flex;
  gap:8px;
  margin-top:15px;
}


/* EMPTY */

.empty{
  padding:55px 20px;
  text-align:center;
  color:#6b7280;
}

.empty-icon{
  font-size:35px;
  margin-bottom:12px;
}


/* TOAST */

.toast{
  position:fixed;
  right:20px;
  bottom:20px;
  background:#111827;
  color:white;
  padding:12px 17px;
  border-radius:9px;
  box-shadow:0 10px 30px rgba(0,0,0,.2);
  transform:translateY(30px);
  opacity:0;
  pointer-events:none;
  transition:.25s;
  z-index:5000;
  font-size:13px;
}

.toast.show{
  transform:translateY(0);
  opacity:1;
}

.toast.error{
  background:#dc2626;
}

.toast.success{
  background:#059669;
}


/* RESPONSIVE */

@media(max-width:1000px){

  .stats{
    grid-template-columns:
      repeat(2,minmax(0,1fr));
  }

}

@media(max-width:800px){

  .sidebar{
    transform:translateX(-100%);
    transition:.25s;
  }

  .sidebar.open{
    transform:translateX(0);
  }

  .main{
    margin-left:0;
    width:100%;
  }

  .mobile-menu{
    display:block;
  }

  .topbar{
    padding:0 16px;
  }

  .content{
    padding:18px;
  }

  .header-row{
    align-items:flex-start;
  }

}

@media(max-width:600px){

  .stats{
    grid-template-columns:1fr;
  }

  .form-grid{
    grid-template-columns:1fr;
  }

  .form-group.full{
    grid-column:auto;
  }

  .header-row{
    flex-direction:column;
  }

  .header-row .btn{
    width:100%;
  }

}

</style>

</head>


<body>


<div class="layout">


<!-- SIDEBAR -->

<aside
