/*
====================================================
LOAD INTERNSHIPS
====================================================
*/

async function loadInternships(){

  try{

    internshipTable.innerHTML = `

      <tr>

        <td colspan="7">

          <div class="empty">

            <div class="empty-icon">
              ⏳
            </div>

            Loading internships...

          </div>

        </td>

      </tr>

    `;


    const snapshot =
      await getDocs(
        collection(
          db,
          "internships"
        )
      );


    internships = [];


    snapshot.forEach(
      item => {

        internships.push({

          id:
            item.id,

          ...item.data()

        });

      }
    );


    renderInternships();

    updateStats();

  }

  catch(error){

    console.error(
      "loadInternships:",
      error
    );


    internshipTable.innerHTML = `

      <tr>

        <td colspan="7">

          <div class="empty">

            <div class="empty-icon">
              ⚠️
            </div>

            <strong>
              Unable to load internships
