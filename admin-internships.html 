              ${escapeHTML(
                error.message
              )}
            </p>

          </div>

        </td>

      </tr>

    `;

  }

}


/*
====================================================
LOAD APPLICATIONS
====================================================
*/

async function loadApplications(){

  try{

    const snapshot =
      await getDocs(
        collection(
          db,
          "internshipApplications"
        )
      );


    applications = [];


    snapshot.forEach(
      item => {

        applications.push({

          id:
            item.id,

          ...item.data()

        });

      }
    );


    updateStats();

  }

  catch(error){

    console.warn(
      "Applications:",
      error
    );

    applications = [];

  }

}


/*
====================================================
RENDER INTERNSHIPS
====================================================
*/

function renderInternships(){

  let data =
    [...internships];


  const search =
    searchInput
      ?.value
      ?.trim()
      ?.toLowerCase() ||
      "";


  const selectedStatus =
    statusFilter?.value ||
    "all";


  const selectedType =
    typeFilter?.value ||
    "all";


  if(search){

    data =
      data.filter(
        item => {

          const title =
            String(
              item.title ||
              ""
            )
            .toLowerCase();


          const company =
            String(
              item.companyName ||
              ""
            )
            .toLowerCase();


          const location =
            String(
              item.location ||
              ""
            )
            .toLowerCase();


          const category =
            String(
              item.category ||
              ""
            )
            .toLowerCase();


          return (

            title.includes(
              search
            )

            ||

            company.includes(
              search
            )

            ||

            location.includes(
              search
            )

            ||

            category.includes(
              search
            )

          );

        }
      );

  }


  if(
    selectedStatus !==
    "all"
  ){

    data =
      data.filter(
        item =>
          getCurrentStatus(
            item
          ) ===
          selectedStatus
      );

  }


  if(
    selectedType !==
    "all"
  ){

    data =
      data.filter(
        item =>
          (
            item.workType ||
            "onsite"
          ) ===
          selectedType
      );

  }


  const sort =
    sortFilter?.value ||
    "newest";


  if(sort === "newest"){

    data.sort(
      (a,b) =>
        getTime(
          b.createdAt
        )
        -
        getTime(
          a.createdAt
        )
    );

  }


  else if(
    sort === "oldest"
  ){

    data.sort(
      (a,b) =>
        getTime(
          a.createdAt
        )
        -
        getTime(
          b.createdAt
        )
    );

  }


  else if(
    sort === "deadline"
  ){

    data.sort(
      (a,b) =>
        getTime(
          a.deadline
        )
        -
        getTime(
          b.deadline
        )
    );

  }


  else if(
    sort === "title"
  ){

    data.sort(
      (a,b) =>
        String(
          a.title ||
          ""
        )
        .localeCompare(
          String(
            b.title ||
            ""
          )
        )
    );

  }


  if(!data.length){

    internshipTable.innerHTML = `

      <tr>

        <td colspan="7">

          <div class="empty">

            <div class="empty-icon">
              💼
            </div>

            <strong>
              No internships found
            </strong>

            <p
              style="margin-top:6px;"
            >
              Try another search or
              create a new internship.
            </p>

          </div>

        </td>

      </tr>

    `;

    return;

  }


  internshipTable.innerHTML =
    data
      .map(
        internship =>
          createInternshipRow(
            internship
          )
      )
      .join("");

}


