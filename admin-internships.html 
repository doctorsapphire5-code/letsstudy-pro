              ?.value
              ?.trim() ||
            "",

          location:
            document
              .getElementById(
                "location"
              )
              ?.value
              ?.trim() ||
            "",

          workType:
            document
              .getElementById(
                "workType"
              )
              ?.value ||
            "onsite",

          category:
            document
              .getElementById(
                "category"
              )
              ?.value ||
            "",

          employmentType:
            document
              .getElementById(
                "employmentType"
              )
              ?.value ||
            "internship",

          startDate:
            document
              .getElementById(
                "startDate"
              )
              ?.value ||
            "",

          deadline:
            document
              .getElementById(
                "deadline"
              )
              .value,

          duration:
            document
              .getElementById(
                "duration"
              )
              ?.value
              ?.trim() ||
            "",

          stipend:
            document
              .getElementById(
                "stipend"
              )
              ?.value
              ?.trim() ||
            "",

          positions:
            safeNumber(
              document
                .getElementById(
                  "positions"
                )
                ?.value,
              1
            ),

          status:
            document
              .getElementById(
                "internshipStatus"
              )
              ?.value ||
            "active",

          shortDescription:
            document
              .getElementById(
                "shortDescription"
              )
              ?.value
              ?.trim() ||
            "",

          description:
            document
              .getElementById(
                "description"
              )
              ?.value
              ?.trim() ||
            "",

          requirements:
            document
              .getElementById(
                "requirements"
              )
              ?.value
              ?.trim() ||
            "",

          responsibilities:
            document
              .getElementById(
                "responsibilities"
              )
              ?.value
              ?.trim() ||
            "",

          skills,

          featured:
            Boolean(
              document
                .getElementById(
                  "featured"
                )
                ?.checked
            ),

          allowApplications:
            document
              .getElementById(
                "allowApplications"
              )
              ?.checked !== false,

          updatedAt:
            serverTimestamp()

        };


        if(
          editingId
        ){

          await updateDoc(
            doc(
              db,
              "internships",
              editingId
            ),
            data
          );


          showToast(
            "Internship updated successfully."
          );

        }

        else{

          data.createdAt =
            serverTimestamp();


          data.applicationCount =
            0;


          await addDoc(
            collection(
              db,
              "internships"
            ),
            data
          );


          showToast(
            "Internship created successfully."
          );

        }


        editingId =
          null;


        closeInternshipModal();


        await refreshData();

      }

      catch(error){

        console.error(
          "Internship save error:",
          error
        );


        showToast(
          error?.message ||
          "Unable to save internship.",
          "error"
        );

      }

      finally{

        setFormLoading(
          false
        );

      }

    }
  );

}


/*
====================================================
FINAL INITIALIZATION
====================================================
*/

(async function(){

  try{

    await refreshData();

  }

  catch(error){

    console.error(
      "Initialization error:",
      error
    );

  }

})();

</script>

