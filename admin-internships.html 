        </button>

      </td>


      <td>

        <span
          class="
            status
            status-${status}
          "
        >

          ${capitalize(
            status
          )}

        </span>

      </td>


      <td>

        <div class="actions">

          <button
            type="button"
            class="
              small-btn
              view-btn
            "
            title="View"
            onclick="
              viewInternship(
                '${escapeAttribute(
                  internship.id
                )}'
              )
            "
          >
            👁
          </button>


          <button
            type="button"
            class="
              small-btn
