/*
====================================================
FORM VALIDATION
====================================================
*/

function validateInternshipForm(){

  const title =
    document.getElementById(
      "internshipTitle"
    );


  const company =
    document.getElementById(
      "companyName"
    );


  const deadline =
    document.getElementById(
      "deadline"
    );


  if(
    !title ||
    !title.value.trim()
  ){

    showToast(
      "Internship title is required.",
      "error"
    );


    title?.focus();

    return false;

  }


  if(
    !company ||
    !company.value.trim()
  ){

    showToast(
      "Company name is required.",
      "error"
    );


    company?.focus();

    return false;

  }


  if(
    !deadline ||
    !deadline.value
  ){

    showToast(
      "Application deadline is required.",
      "error"
    );


    deadline?.focus();

    return false;

  }


  const deadlineDate =
    new Date(
      deadline.value
    );


  if(
    Number.isNaN(
      deadlineDate.getTime()
    )
  ){

    showToast(
      "Please enter a valid deadline.",
      "error"
    );


    deadline.focus();

    return false;

  }


  const positions =
    document.getElementById(
      "positions"
    );


  if(
    positions &&
    (
      !Number.isFinite(
        Number(
          positions.value
        )
      )
      ||
      Number(
        positions.value
      ) < 1
    )
  ){

    showToast(
      "Positions must be at least 1.",
      "error"
    );


    positions.focus();

    return false;

  }


  return true;

}


