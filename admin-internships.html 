<!-- MAIN -->

<main class="main">


<!-- TOPBAR -->

<header class="topbar">

  <div>

    <button
      class="mobile-menu"
      id="mobileMenu"
    >
      ☰
    </button>

  </div>


  <div style="text-align:right">

    <div class="page-title">
      Internship Administration
    </div>

    <div class="page-subtitle">
      Manage opportunities and applications
    </div>

  </div>

</header>


<!-- CONTENT -->

<section class="content">


<div class="header-row">

  <div class="heading">

    <h1>
      Internships
    </h1>

    <p>
      Create and manage internship
      opportunities for students.
    </p>

  </div>


  <button
    class="btn btn-primary"
    id="createBtn"
  >

    ＋ Create Internship

  </button>

</div>


<!-- STATS -->

<div class="stats">


  <div class="stat-card">

    <div class="stat-top">

      <div class="stat-label">
        Total Internships
      </div>

      <div class="stat-icon">
        💼
      </div>

    </div>

    <div
      class="stat-value"
      id="totalInternships"
    >
      0
    </div>

  </div>


  <div class="stat-card">

    <div class="stat-top">

      <div class="stat-label">
        Active
      </div>

      <div class="stat-icon">
        🟢
      </div>

    </div>

    <div
      class="stat-value"
      id="activeInternships"
    >
      0
    </div>

  </div>


  <div class="stat-card">

    <div class="stat-top">

      <div class="stat-label">
        Applications
      </div>

      <div class="stat-icon">
        📩
      </div>

    </div>

    <div
      class="stat-value"
      id="totalApplications"
    >
      0
    </div>

  </div>


  <div class="stat-card">

    <div class="stat-top">

      <div class="stat-label">
        Pending Review
      </div>

      <div class="stat-icon">
        ⏳
      </div>

    </div>

    <div
      class="stat-value"
      id="pendingApplications"
    >
      0
    </div>

  </div>

</div>


<!-- INTERNSHIPS CARD -->

<div class="card">


  <div class="toolbar">

    <div class="search">

      <span class="search-icon">
        🔍
      </span>

      <input
        type="search"
        id="searchInput"
        placeholder="
          Search internship, company or location...
        "
      >

    </div>


    <select
      class="filter"
      id="statusFilter"
    >

      <option value="all">
        All Status
      </option>

      <option value="active">
        Active
      </option>

      <option value="draft">
        Draft
      </option>

      <option value="closed">
        Closed
      </option>

      <option value="expired">
        Expired
      </option>

    </select>


    <select
      class="filter"
      id="typeFilter"
    >

      <option value="all">
        All Types
      </option>

      <option value="remote">
        Remote
      </option>

      <option value="onsite">
        On-site
      </option>

      <option value="hybrid">
        Hybrid
      </option>

    </select>


    <select
      class="filter"
      id="sortFilter"
    >

      <option value="newest">
        Newest
      </option>

      <option value="oldest">
        Oldest
      </option>

      <option value="deadline">
        Deadline
      </option>

      <option value="title">
        Title
      </option>

    </select>

  </div>


  <div class="table-wrap">

    <table>

      <thead>

        <tr>

          <th>
            Internship
          </th>

          <th>
            Company
          </th>

          <th>
            Location
          </th>

          <th>
            Deadline
          </th>

          <th>
            Applications
          </th>

          <th>
            Status
          </th>

          <th>
            Actions
          </th>

        </tr>

      </thead>


      <tbody
        id="internshipTable"
      >

        <tr>

          <td colspan="7">

            <div class="empty">

              <div class="empty-icon">
                ⏳
              </div>

              Loading internships...

            </div>

          </td>

        </tr>

      </tbody>

