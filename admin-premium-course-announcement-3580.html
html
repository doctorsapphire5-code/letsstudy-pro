};


/* =========================
   EDIT ANNOUNCEMENT
========================= */

window.editAnnouncement =
async function(id){

  const item =
    announcements.find(
      announcement =>
        announcement.id === id
    );

  if(!item){

    showToast(
      "Announcement not found.",
      "error"
    );

    return;

  }

  document.getElementById(
    "modalTitle"
  ).textContent =
    "Edit Announcement";

  document.getElementById(
    "announcementId"
  ).value = item.id;

  document.getElementById(
    "announcementCourse"
  ).value =
    item.courseId || "";

  document.getElementById(
    "announcementTitle"
  ).value =
    item.title || "";

  document.getElementById(
    "announcementMessage"
  ).value =
    item.message || "";

  document.getElementById(
    "announcementPriority"
  ).value =
    item.priority || "normal";

  document.getElementById(
    "announcementStatus"
  ).value =
    item.status || "draft";

  document.getElementById(
    "publishDate"
  ).value =
    toDateTimeLocal(
      item.publishDate
    );

  document.getElementById(
    "announcementOrder"
  ).value =
    Number(item.order || 0);

  document.getElementById(
    "announcementModal"
  ).classList.add("show");

};


/* =========================
   SAVE ANNOUNCEMENT
========================= */

document
  .getElementById(
    "announcementForm"
  )
  .addEventListener(
    "submit",
    async event => {

      event.preventDefault();

      const id =
        document.getElementById(
          "announcementId"
        ).value.trim();

      const courseId =
        document.getElementById(
          "announcementCourse"
        ).value.trim();

      const title =
        document.getElementById(
          "announcementTitle"
        ).value.trim();

      const message =
        document.getElementById(
          "announcementMessage"
        ).value.trim();

      const priority =
        document.getElementById(
          "announcementPriority"
        ).value;

      const status =
        document.getElementById(
          "announcementStatus"
        ).value;

      const publishDateValue =
        document.getElementById(
          "publishDate"
        ).value;

      const order =
        Number(
          document.getElementById(
            "announcementOrder"
          ).value || 0
        );


      if(!courseId){

        showToast(
          "Please select a premium course.",
          "error"
        );

        return;

      }

      if(!title){

        showToast(
          "Announcement title is required.",
          "error"
        );

        return;

      }

      if(!message){

        showToast(
          "Announcement message is required.",
          "error"
        );

        return;

      }


      try{

        showLoading(true);

        const data = {

          courseId,

          title,

          message,

          priority,

          status,

          order,

          updatedAt:
            serverTimestamp()

        };


        if(publishDateValue){

          data.publishDate =
            Timestamp.fromDate(
              new Date(
                publishDateValue
              )
            );

        }


        if(id){

          await updateDoc(
            doc(
              db,
              "premiumCourseAnnouncements",
              id
            ),
            data
          );

          showToast(
            "Announcement updated successfully."
          );

        }else{

          data.createdAt =
            serverTimestamp();

          await addDoc(
            collection(
              db,
              "premiumCourseAnnouncements"
            ),
            data
          );

          showToast(
            "Announcement created successfully."
          );

        }


        closeModal();

        await loadAnnouncements();

      }catch(error){

        console.error(error);

        showToast(
          error.message ||
          "Failed to save announcement.",
          "error"
        );

      }finally{

        showLoading(false);

      }

    }
  );


/* =========================
   PUBLISH ANNOUNCEMENT
========================= */

window.publishAnnouncement =
async function(id){

  if(
    !confirm(
      "Publish this announcement?"
    )
  ){

    return;

  }


  try{

    showLoading(true);

    await updateDoc(
      doc(
        db,
        "premiumCourseAnnouncements",
        id
      ),
      {
        status:"published",
        updatedAt:
          serverTimestamp()
      }
    );


    showToast(
      "Announcement published successfully."
    );

    await loadAnnouncements();

  }catch(error){

    console.error(error);

    showToast(
      error.message ||
      "Failed to publish announcement.",
      "error"
    );

  }finally{

    showLoading(false);

  }

};


