  Timestamp
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


const firebaseConfig = {

  apiKey:
    "AIzaSyBcOYDfAVKXbljsyRgI_0rjodBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-85B7V5H5J0"

};


const app = initializeApp(firebaseConfig);

const auth = getAuth(app);

const db = getFirestore(app);


let courses = [];
let announcements = [];


/* =========================
   HELPERS
========================= */

function escapeHTML(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


function showLoading(show){

  document
    .getElementById("loading")
    .classList.toggle("show",show);

}


function showToast(message,type="success"){

  const toast =
    document.getElementById("toast");

  toast.textContent = message;

  toast.className =
    "toast show " + type;

  setTimeout(()=>{
    toast.className = "toast";
  },3500);

}


function formatDate(value){

  if(!value) return "—";

  try{

    let date;

    if(value?.toDate){
      date = value.toDate();
    }
    else if(value instanceof Date){
      date = value;
    }
    else{
      date = new Date(value);
    }

    if(isNaN(date.getTime())){
      return "—";
    }

    return date.toLocaleString();

  }catch(error){

    return "—";

  }

}


function toDateTimeLocal(value){

  if(!value) return "";

  try{

    const date =
      value?.toDate
        ? value.toDate()
        : new Date(value);

    if(isNaN(date.getTime())){
      return "";
    }

    const local =
      new Date(
        date.getTime()
        - date.getTimezoneOffset() * 60000
      );

    return local
      .toISOString()
      .slice(0,16);

  }catch(error){

    return "";

  }

}


/* =========================
   LOAD COURSES
========================= */

async function loadCourses(){

  try{

    const snapshot =
      await getDocs(
        collection(
          db,
          "premiumCourses"
        )
      );

    courses =
      snapshot.docs.map(item => ({
        id:item.id,
        ...item.data()
      }));

    courses.sort(
      (a,b)=>
        String(a.title || "")
          .localeCompare(
            String(b.title || "")
          )
    );

    renderCourseSelectors();

  }catch(error){

    console.error(error);

    showToast(
      "Failed to load premium courses.",
      "error"
    );

  }

}


function renderCourseSelectors(){

  const filter =
    document.getElementById(
      "courseFilter"
    );

  const select =
    document.getElementById(
      "announcementCourse"
    );

  filter.innerHTML =
    `<option value="">All Courses</option>`;

  select.innerHTML =
    `<option value="">Select Premium Course</option>`;


  courses.forEach(course=>{

    const title =
      escapeHTML(
        course.title || "Untitled Course"
      );

    filter.insertAdjacentHTML(
      "beforeend",
      `<option value="${escapeHTML(course.id)}">
        ${title}
      </option>`
    );

    select.insertAdjacentHTML(
      "beforeend",
      `<option value="${escapeHTML(course.id)}">
        ${title}
      </option>`
    );

  });

}


/* =========================
   LOAD ANNOUNCEMENTS
========================= */

async function loadAnnouncements(){

  try{

    const snapshot =
      await getDocs(
        collection(
          db,
          "premiumCourseAnnouncements"
        )
      );

    announcements =
      snapshot.docs.map(item=>({
        id:item.id,
        ...item.data()
      }));

    announcements.sort((a,b)=>{

      const orderA =
        Number(a.order || 0);

      const orderB =
        Number(b.order || 0);

      if(orderA !== orderB){
        return orderA - orderB;
      }

      const dateA =
        a.publishDate?.toDate
          ? a.publishDate.toDate().getTime()
          : 0;

      const dateB =
        b.publishDate?.toDate
          ? b.publishDate.toDate().getTime()
          : 0;

      return dateB - dateA;

    });

    updateStats();

    renderAnnouncements();

  }catch(error){

    console.error(error);

    showToast(
      "Failed to load announcements.",
      "error"
    );

  }

}


/* =========================
   STATS
========================= */

function updateStats(){

  const total =
    announcements.length;

  const published =
    announcements.filter(
      item =>
        item.status === "published"
    ).length;

  const drafts =
    announcements.filter(
      item =>
        item.status !== "published"
    ).length;

  const important =
    announcements.filter(
      item =>
        item.priority === "important"
    ).length;


  document.getElementById(
    "totalAnnouncements"
  ).textContent = total;

  document.getElementById(
    "publishedAnnouncements"
  ).textContent = published;

  document.getElementById(
    "draftAnnouncements"
  ).textContent = drafts;

  document.getElementById(
    "importantAnnouncements"
  ).textContent = important;

}


/* =========================
   COURSE NAME
========================= */

function getCourseName(courseId){

  const course =
    courses.find(
      item => item.id === courseId
    );

  return course
    ? course.title || "Untitled Course"
    : "Unknown Course";

}


/* =========================
   RENDER
========================= */

function renderAnnouncements(){

  const tbody =
    document.getElementById(
      "announcementTable"
    );

  const search =
    document.getElementById(
      "searchInput"
    ).value
      .trim()
      .toLowerCase();

  const courseFilter =
    document.getElementById(
      "courseFilter"
    ).value;

  const statusFilter =
    document.getElementById(
      "statusFilter"
    ).value;

  const priorityFilter =
    document.getElementById(
      "priorityFilter"
    ).value;


  const filtered =
    announcements.filter(item=>{

      const title =
        String(item.title || "")
          .toLowerCase();

      const message =
        String(item.message || "")
          .toLowerCase();

      const matchesSearch =
        !search ||
        title.includes(search) ||
        message.includes(search);

      const matchesCourse =
        !courseFilter ||
        item.courseId === courseFilter;

      const matchesStatus =
        !statusFilter ||
        item.status === statusFilter;

      const matchesPriority =
        !priorityFilter ||
        item.priority === priorityFilter;

      return (
        matchesSearch &&
        matchesCourse &&
        matchesStatus &&
        matchesPriority
      );

    });


  if(!filtered.length){

    tbody.innerHTML = `
      <tr>
        <td colspan="8">
          <div class="empty">
            📢 No announcements found.
          </div>
        </td>
      </tr>
    `;

    return;

  }


  tbody.innerHTML =
    filtered.map(item=>{

      const courseName =
        escapeHTML(
          getCourseName(item.courseId)
        );

      const title =
        escapeHTML(item.title);

      const message =
        escapeHTML(item.message);

      const status =
        item.status === "published"
          ? `<span class="badge badge-published">
               Published
             </span>`
          : `<span class="badge badge-draft">
               Draft
             </span>`;

      const priority =
        item.priority === "important"
          ? `<span class="badge badge-important">
               Important
             </span>`
          : `<span class="badge badge-normal">
               Normal
             </span>`;

      return `

        <tr>

          <td>
            <strong>${courseName}</strong>
          </td>

          <td>
            <strong>${title}</strong>
          </td>

          <td>
            ${message.length > 120
              ? message.slice(0,120) + "..."
              : message}
          </td>

          <td>
            ${priority}
          </td>

          <td>
            ${status}
          </td>

          <td>
  ${formatDate(item.publishDate)}
</td>

<td>
  ${Number(item.order || 0)}
</td>

<td>

  <div class="actions">

    <button
      class="btn-secondary"
      onclick="editAnnouncement('${escapeHTML(item.id)}')">
      Edit
    </button>

    ${
      item.status !== "published"
      ? `
        <button
          class="btn-success"
          onclick="publishAnnouncement('${escapeHTML(item.id)}')">
          Publish
        </button>
      `
      : `
        <span class="badge badge-published">
          Live
        </span>
      `
    }

    <button
      class="btn-danger"
      onclick="deleteAnnouncement('${escapeHTML(item.id)}')">
      Delete
    </button>

  </div>

</td>

</tr>

`;

}).join("");

}


/* =========================
