/* =========================
   ADMIN AUTHENTICATION
========================= */

onAuthStateChanged(
  auth,
  async user => {

    if(!user){

      window.location.href =
        "login-admin.html";

      return;

    }


    try{

      const adminRef =
        doc(
          db,
          "admins",
          user.uid
        );


      const adminSnap =
        await getDoc(
          adminRef
        );


      if(!adminSnap.exists()){

        showToast(
          "Access denied. Admin account required.",
          "error"
        );

        await signOut(auth);

        window.location.href =
          "login-admin.html";

        return;

      }


      const admin =
        adminSnap.data();


      if(
        admin.role &&
        admin.role !== "admin"
      ){

        showToast(
          "You do not have admin permission.",
          "error"
        );

        await signOut(auth);

        window.location.href =
          "login-admin.html";

        return;

      }


      await loadCourses();

      await loadAnnouncements();


    }catch(error){

      console.error(
        "Admin authentication error:",
        error
      );

      showToast(
        "Admin verification failed.",
        "error"
      );

    }

  }
);

</script>

