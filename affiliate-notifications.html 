    /* =================================
       TOAST
    ================================= */

    function showToast(
      message,
      type = "success"
    ){

      toast.textContent =
        message;

      toast.className =
        "toast show " +
        type;


      setTimeout(
        () => {

          toast.className =
            "toast";

        },
        2500
      );

    }


    /* =================================
       ICON
    ================================= */

    function getIcon(
      notification
    ){

      if(
        notification.icon
      ){

        return notification.icon;

      }


      const type =
        String(
          notification.type || ""
        ).toLowerCase();


      if(
        type === "commission"
      ){
        return "💰";
      }

      if(
        type === "withdrawal"
      ){
        return "💸";
      }

      if(
        type === "referral"
      ){
        return "👥";
      }

      if(
        type === "sale"
      ){
        return "🛍️";
      }

      if(
        type === "announcement"
      ){
        return "📢";
      }

      if(
        type === "system"
      ){
        return "⚙️";
      }

      return "🔔";

    }


    /* =================================
       FORMAT DATE
    ================================= */

    function formatDate(
      timestamp
    ){

      if(
        !timestamp
      ){

        return "Just now";

      }


      try{

        let date;


        if(
          timestamp.toDate
        ){

          date =
            timestamp.toDate();

        }else{

          date =
            new Date(timestamp);

        }


        if(
          Number.isNaN(
            date.getTime()
          )
        ){

          return "Recently";

        }


        const now =
          new Date();


        const diff =
          now - date;


        const seconds =
          Math.floor(
            diff / 1000
          );


        if(
          seconds < 60
        ){

          return "Just now";

        }


        const minutes =
          Math.floor(
            seconds / 60
          );


        if(
          minutes < 60
        ){

          return (
            minutes +
            (
              minutes === 1
                ? " minute ago"
                : " minutes ago"
            )
          );

        }


        const hours =
          Math.floor(
            minutes / 60
          );


        if(
          hours < 24
        ){

          return (
            hours +
            (
              hours === 1
                ? " hour ago"
                : " hours ago"
            )
          );

        }


        const days =
          Math.floor(
            hours / 24
          );


        if(
          days < 7
        ){

          return (
            days +
            (
              days === 1
                ? " day ago"
                : " days ago"
            )
          );

        }


        return date.toLocaleDateString(
          undefined,
          {
            year:"numeric",
            month:"short",
            day:"numeric"
          }
        );

      }catch(error){

        return "Recently";

      }

    }


    /* =================================
       ESCAPE HTML
    ================================= */

    function escapeHTML(
      value
    ){

      return String(
        value ?? ""
      )

        .replace(
          /&/g,
          "&amp;"
        )

        .replace(
          /</g,
          "&lt;"
        )

        .replace(
          />/g,
          "&gt;"
        )

        .replace(
          /"/g,
          "&quot;"
        )

        .replace(
          /'/g,
          "&#039;"
        );

    }


    /* =================================
       SORT NOTIFICATIONS
    ================================= */

    function sortNotifications(
      items
    ){

      return items.sort(
        (a,b) => {

          const aTime =
            a.createdAt?.toMillis
              ? a.createdAt.toMillis()
              : 0;

          const bTime =
            b.createdAt?.toMillis
              ? b.createdAt.toMillis()
              : 0;


          return bTime - aTime;

        }
      );

    }


    /* =================================
       UPDATE COUNT
    ================================= */

    function updateUnreadCount(){

      const unread =
        notifications.filter(
          notification =>
            notification.read !== true
        ).length;


      if(
        unread > 0
      ){

        topCount.textContent =
          unread > 99
            ? "99+"
            : unread;

        topCount.classList.remove(
          "hidden"
        );

      }else{

                  topCount.classList.add(
            "hidden"
          );

        }

      }


      /* =================================
         FILTER
      ================================= */

      function getFilteredNotifications(){

        if(
          currentFilter === "all"
        ){

          return notifications;

        }


        if(
          currentFilter === "unread"
        ){

          return notifications.filter(
            notification =>
              notification.read !== true
          );

        }


        return notifications.filter(
          notification =>
            String(
              notification.type || ""
            ).toLowerCase() ===
            currentFilter
        );

      }


      /* =================================
         RENDER NOTIFICATIONS
      ================================= */

      function renderNotifications(){

        const filtered =
          getFilteredNotifications();


        if(
          filtered.length === 0
        ){

          notificationsList.innerHTML = `

            <div class="empty">

              <div class="empty-icon">
                🔔
              </div>

              <strong>
                No notifications
              </strong>

              <p>
                You're all caught up.
              </p>

            </div>

          `;

          updateUnreadCount();

          return;

        }


        notificationsList.innerHTML =
          filtered.map(
            notification => {

              const isUnread =
                notification.read !== true;


              const icon =
                getNotificationIcon(
                  notification
                );


              const title =
                notification.title ||
                "Notification";


              const message =
                notification.message ||
                "";


              const type =
                notification.type ||
                "system";


              return `

                <div
                  class="
                    notification
                    ${isUnread ? "unread" : ""}
                  "
                  data-id="${escapeHTML(
                    notification.id
                  )}"
                >

                  <div class="notification-icon">
                    ${escapeHTML(icon)}
                  </div>


                  <div class="notification-content">

                    <div class="notification-title">
                      ${escapeHTML(title)}
                    </div>


                    <div class="notification-message">
                      ${escapeHTML(message)}
                    </div>


                    <div class="notification-meta">

                      ${
                        isUnread
                          ? `
                            <span
                              class="unread-dot"
                            ></span>
                          `
                          : ""
                      }

                      <span>
                        ${escapeHTML(
                          formatDate(
                            notification.createdAt
                          )
                        )}
                      </span>

                      <span>
                        ${escapeHTML(type)}
                      </span>

                    </div>

                  </div>


                  <div class="notification-actions">

                    ${
                      isUnread
                        ? `
                          <button
                            class="read-btn"
                            data-read-id="${escapeHTML(
                              notification.id
                            )}"
                          >
                            ✓ Read
                          </button>
                        `
                        : ""
                    }

                  </div>

                </div>

              `;

            }
          ).join("");


        updateUnreadCount();


        /* =================================
           CLICK NOTIFICATION
        ================================= */

        document
          .querySelectorAll(
            ".notification"
          )
          .forEach(
            card => {

              card.addEventListener(
                "click",
                async event => {

                  if(
                    event.target.closest(
                      ".read-btn"
                    )
                  ){

                    return;

                  }


                  const id =
                    card.dataset.id;


                  const notification =
                    notifications.find(
                      item =>
                        item.id === id
                    );


                  if(
                    notification
                  ){

                    await openNotification(
                      notification
                    );

                  }

                }
              );

            }
          );


        /* =================================
           READ BUTTONS
        ================================= */

        document
          .querySelectorAll(
            ".read-btn"
          )
          .forEach(
            button => {

              button.addEventListener(
                "click",
                async event => {

                  event.stopPropagation();


                  const id =
                    button.dataset.readId;


                  await markAsRead(
                    id
                  );

                }
              );

            }
          );

      }


      /* =================================
         NOTIFICATION ICON
      ================================= */

      function getNotificationIcon(
        notification
      ){

        if(
          notification.icon
        ){

          return notification.icon;

        }


        const type =
          String(
            notification.type || ""
          ).toLowerCase();


        switch(type){

          case "commission":
            return "💰";

          case "withdrawal":
            return "💸";

          case "referral":
            return "👥";

          case "sale":
            return "🛍️";

          case "announcement":
            return "📢";

          case "system":
            return "⚙️";

          default:
            return "🔔";

        }

      }


      /* =================================
         FORMAT DATE
      ================================= */

      function formatDate(
        timestamp
      ){

        if(
          !timestamp
        ){

          return "Just now";

        }


        try{

          let date;


          if(
            timestamp.toDate
          ){

            date =
              timestamp.toDate();

          }else{

            date =
              new Date(timestamp);

          }


          if(
            Number.isNaN(
              date.getTime()
            )
          ){

            return "Recently";

          }


          const now =
            new Date();


          const difference =
            now.getTime() -
            date.getTime();


          const seconds =
            Math.floor(
              difference / 1000
            );


          if(
            seconds < 60
          ){

            return "Just now";

          }


          const minutes =
            Math.floor(
              seconds / 60
            );


          if(
            minutes < 60
          ){

            return (
              minutes +
              (
                minutes === 1
                  ? " minute ago"
                  : " minutes ago"
              )
            );

          }


          const hours =
            Math.floor(
              minutes / 60
            );


          if(
            hours < 24
          ){

            return (
              hours +
              (
                hours === 1
                  ? " hour ago"
                  : " hours ago"
              )
            );

          }


          const days =
            Math.floor(
              hours / 24
            );


          if(
            days < 7
          ){

            return (
              days +
              (
                days === 1
                  ? " day ago"
                  : " days ago"
              )
            );

          }


          return date.toLocaleDateString(
            undefined,
            {
              year:"numeric",
              month:"short",
              day:"numeric"
            }
          );

        }catch(error){

          console.error(
            "Date formatting error:",
            error
          );

          return "Recently";

        }

      }


      /* =================================
         ESCAPE HTML
      ================================= */

      function escapeHTML(
        value
      ){

        return String(
          value ?? ""
        )

          .replace(
            /&/g,
            "&amp;"
          )

          .replace(
            /</g,
            "&lt;"
          )

          .replace(
            />/g,
            "&gt;"
          )

          .replace(
            /"/g,
            "&quot;"
          )

          .replace(
            /'/g,
            "&#039;"
          );

      }


      /* =================================
         MARK AS READ
      ================================= */

      async function markAsRead(
        notificationId
      ){

        if(
          !notificationId
        ){

          return;

        }


        try{

          await updateDoc(
            doc(
              db,
              "affiliateNotifications",
              notificationId
            ),
            {
              read:true
            }
          );


          showToast(
            "Notification marked as read.",
            "success"
          );


        }catch(error){

          console.error(
            "Mark as read error:",
            error
          );


          showToast(
            "Unable to mark notification as read.",
            "error"
          );

        }

      }


      /* =================================
         OPEN NOTIFICATION
      ================================= */

      async function openNotification(
        notification
      ){

        if(
          !notification
        ){

          return;

        }


        if(
          notification.read !== true
        ){

          try{

            await updateDoc(
              doc(
                db,
                "affiliateNotifications",
                notification.id
              ),
              {
                read:true
              }
            );

          }catch(error){

            console.error(
              "Read update error:",
              error
            );

          }

        }


        if(
          notification.link
        ){

          const link =
            String(
              notification.link
            );


          if(
            /^(https?:\/\/|\/|\.\/)/i.test(
              link
            )
          ){

            window.location.href =
              link;

          }

        }

      }


      /* =================================
         MARK ALL AS READ
      ================================= */

      async function markAllAsRead(){

        if(
          !currentUser
        ){

          return;

        }


        const unread =
          notifications.filter(
            notification =>
              notification.read !== true
          );


        if(
          unread.length === 0
        ){

          showToast(
            "All notifications are already read.",
            "success"
          );

          return;

        }


        try{

          markAllBtn.disabled =
            true;


          markAllBtn.textContent =
            "Marking...";


          const batch =
            writeBatch(
              db
            );


          unread.forEach(
            notification => {

              const notificationRef =
                doc(
                  db,
                  "affiliateNotifications",
                  notification.id
                );


              batch.update(
                notificationRef,
                {
                  read:true
                }
              );

            }
          );


          await batch.commit();


          showToast(
            "All notifications marked as read.",
            "success"
          );


        }catch(error){

          console.error(
            "Mark all as read error:",
            error
          );


          showToast(
            "Unable to mark all notifications.",
            "error"
          );

        }finally{

          markAllBtn.disabled =
            false;


          markAllBtn.textContent =
            "✓ Mark all as read";

        }

      }


      /* =================================
         REALTIME NOTIFICATIONS
      ================================= */

      function startNotificationsListener(){

        if(
          !currentUser
        ){

          return;

        }


        if(
          unsubscribeNotifications
        ){

          unsubscribeNotifications();

        }


        const notificationsRef =
          collection(
            db,
            "affiliateNotifications"
          );


        const notificationQuery =
          query(
            notificationsRef,
            where(
              "userId",
              "==",
              currentUser.uid
            )
          );


        unsubscribeNotifications =
          onSnapshot(
            notificationQuery,

            snapshot => {

              notifications =
                snapshot.docs.map(
                  docSnap => ({

                    id:
                      docSnap.id,

                    ...docSnap.data()

                  })
                );


              notifications.sort(
                (a,b) => {

                  const timeA =
                    a.createdAt?.toMillis
                      ? a.createdAt.toMillis()
                      : 0;


                  const timeB =
                    b.createdAt?.toMillis
                      ? b.createdAt.toMillis()
                      : 0;


                  return (
                    timeB -
                    timeA
                  );

                }
              );


              renderNotifications();

            },

            error => {

              console.error(
                "Realtime notification error:",
                error
              );


              notificationsList.innerHTML = `

                <div class="empty">

                  <div class="empty-icon">
                    ⚠️
                  </div>

                  <strong>
                    Unable to load notifications
                  </strong>

                  <p>
                    Please check your connection
                    and try again.
                  </p>

                </div>

              `;

            }

          );

      }


      /* =================================
         FILTER BUTTONS
      ================================= */

      document
        .querySelectorAll(
          ".filter-btn"
        )
        .forEach(
          button => {

            button.addEventListener(
              "click",
              () => {

                document
                  .querySelectorAll(
                    ".filter-btn"
                  )
                  .forEach(
                    item => {

                      item.classList.remove(
                        "active"
                      );

                    }
                  );


                button.classList.add(
                  "active"
                );


                currentFilter =
                  button.dataset.filter;


                renderNotifications();

              }
            );

          }
        );


      /* =================================
         MARK ALL BUTTON
      ================================= */

      if(
        markAllBtn
      ){

        markAllBtn.addEventListener(
          "click",
          markAllAsRead
        );

      }


      /* =================================
         TOP NOTIFICATION BELL
      ================================= */

      if(
        topBell
      ){

        topBell.addEventListener(
          "click",
          () => {

            window.scrollTo({
              top:0,
              behavior:"smooth"
            });

          }
        );

      }


      /* =================================
         MOBILE MENU
      ================================= */

      if(
        menuBtn
      ){

        menuBtn.addEventListener(
          "click",
          () => {

            sidebar.classList.add(
              "open"
            );

            overlay.classList.add(
              "show"
            );

          }
        );

      }


      /* =================================
         CLOSE MOBILE MENU
      ================================= */

      if(
        overlay
      ){

        overlay.addEventListener(
          "click",
          () => {

            sidebar.classList.remove(
              "open"
            );

            overlay.classList.remove(
              "show"
            );

          }
        );

      }


      /* =================================
         SIDEBAR LINKS
      ================================= */

      document
        .querySelectorAll(
          ".sidebar nav a"
        )
        .forEach(
          link => {

            link.addEventListener(
              "click",
              () => {

                sidebar.classList.remove(
                  "open"
                );

                overlay.classList.remove(
                  "show"
                );

              }
            );

          }
        );


      /* =================================
         LOGOUT
      ================================= */

      if(
        logoutBtn
      ){

        logoutBtn.addEventListener(
          "click",
          async event => {

            event.preventDefault();


            const confirmed =
              confirm(
                "Are you sure you want to logout?"
              );


            if(
              !confirmed
            ){

              return;

            }


            try{

              logoutBtn.style.pointerEvents =
                "none";


              logoutBtn.style.opacity =
                "0.6";


              if(
                unsubscribeNotifications
              ){

                unsubscribeNotifications();

              }


              await signOut(
                auth
              );


              window.location.href =
                "login.html";


            }catch(error){

              console.error(
                "Logout error:",
                error
              );


              logoutBtn.style.pointerEvents =
                "auto";


              logoutBtn.style.opacity =
                "1";


              showToast(
                "Unable to logout. Please try again.",
                "error"
              );

            }

          }
        );

      }


      /* =================================
         AUTH STATE
      ================================= */

      onAuthStateChanged(
        auth,
        user => {

          if(
            !user
          ){

            window.location.href =
              "login.html";

            return;

          }


          currentUser =
            user;


          startNotificationsListener();

        }
      );


      /* =================================
         ESCA
      /* =================================
         ESCAPE KEY
      ================================= */

      document.addEventListener(
        "keydown",
        event => {

          if(
            event.key === "Escape"
          ){

            sidebar.classList.remove(
              "open"
            );

            overlay.classList.remove(
              "show"
            );

          }

        }
      );


      /* =================================
         WINDOW RESIZE
      ================================= */

      window.addEventListener(
        "resize",
        () => {

          if(
            window.innerWidth > 850
          ){

            sidebar.classList.remove(
              "open"
            );

            overlay.classList.remove(
              "show"
            );

          }

        }
      );


      /* =================================
         CLEANUP REALTIME LISTENER
      ================================= */

      window.addEventListener(
        "beforeunload",
        () => {

          if(
            unsubscribeNotifications
          ){

            unsubscribeNotifications();

            unsubscribeNotifications =
              null;

          }

        }
      );


      /* =================================
         VISIBILITY CHANGE
      ================================= */

      document.addEventListener(
        "visibilitychange",
        () => {

          if(
            document.visibilityState ===
            "visible"
          ){

            if(
              currentUser &&
              !unsubscribeNotifications
            ){

              startNotificationsListener();

            }

          }

        }
      );


      /* =================================
         AUTH STATE
      ================================= */

      onAuthStateChanged(
        auth,
        user => {

          if(
            !user
          ){

            currentUser =
              null;


            if(
              unsubscribeNotifications
            ){

              unsubscribeNotifications();

              unsubscribeNotifications =
                null;

            }


            window.location.href =
              "login.html";

            return;

          }


          currentUser =
            user;


          startNotificationsListener();

        }
      );


      /* =================================
         INITIAL AUTH CHECK
      ================================= */

      if(
        auth.currentUser
      ){

        currentUser =
          auth.currentUser;

        startNotificationsListener();

      }


      /* =================================
         PREVENT EMPTY LINK ERRORS
      ================================= */

      document
        .querySelectorAll(
          'a[href="#"]'
        )
        .forEach(
          link => {

            link.addEventListener(
              "click",
              event => {

                event.preventDefault();

              }
            );

          }
        );


      /* =================================
         CONSOLE STATUS
      ================================= */

      console.log(
        "LetsStudy Pro Affiliate Notifications initialized."
      );

    </script>

