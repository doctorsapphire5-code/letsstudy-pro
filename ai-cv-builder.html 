     FOOTER
========================================= -->

<footer class="site-footer">

  <div class="footer-content">

    <div>
      <h3>AI CV Builder</h3>

      <p>
        Build a professional CV quickly,
        simply and confidently.
      </p>
    </div>

    <div class="footer-links">

      <a href="#builder">
        Builder
