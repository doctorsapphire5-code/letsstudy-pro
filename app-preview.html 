<script>

const PREVIEW_KEY =
    "letsstudy_app_preview";

const BUILD_KEY =
    "letsstudy_app_build";

let iconData = "";


/* =========================
   GET
========================= */

function get(id){

    return document.getElementById(id);

}


/* =========================
   TOAST
========================= */

function showToast(message){

    const toast =
        get("toast");

    if(!toast){
        return;
    }

    toast.textContent =
        message;

    toast.classList.add(
        "show"
    );

    clearTimeout(
        window.toastTimer
    );

    window.toastTimer =
        setTimeout(
            function(){

                toast.classList.remove(
                    "show"
                );

            },
            2200
        );

}


/* =========================
   UPDATE PREVIEW
========================= */

function updatePreview(){

    const title =
        get("previewTitle")
            .value
            .trim() ||
        "LetsStudy Pro";

    const description =
        get("description")
            .value
            .trim() ||
        "Learn, create, connect and grow with LetsStudy Pro.";

    const version =
        get("version")
            .value
            .trim() ||
        "1.0.0";

    const category =
        get("category")
            .value
            .trim() ||
        "Education";


    get("appName").textContent =
        title;

    get("appVersion").textContent =
        "Version " + version;


    get("mobileAppName").textContent =
        title;

    get("mobileTitle").textContent =
        title;

    get("mobileDescription").textContent =
        description;


    get("infoVersion").textContent =
        version;

    get("infoCategory").textContent =
        category;


    if(iconData){

        get("appIcon").innerHTML = `

            <img
                src="${iconData}"
                alt="App icon"
            >

        `;

    }else{

        const initials =
            title
                .split(/\s+/)
                .filter(Boolean)
                .slice(0,2)
                .map(
                    word =>
                        word
                            .charAt(0)
                            .toUpperCase()
                )
                .join("");

        get("appIcon").textContent =
            initials ||
            "LS";

    }

}


/* =========================
   LOAD BUILD DATA
========================= */

function loadBuildData(){

    try{

        const raw =
            localStorage.getItem(
                BUILD_KEY
            );

        if(!raw){
            return;
        }

        const data =
            JSON.parse(raw);


        if(data.appName){

            get(
                "previewTitle"
            ).value =
                data.appName;

        }


        if(data.version){

            get(
                "version"
            ).value =
                data.version;

        }


        if(
            Array.isArray(
                data.platforms
            ) &&
            data.platforms.length
        ){

            get(
                "infoPlatform"
            ).textContent =
                data.platforms.join(
                    ", "
                );

        }

    }catch(error){

        console.warn(
            "Could not load build data:",
            error
        );

    }

}


/* =========================
   SAVE PREVIEW
========================= */

function savePreview(){

    const data = {

        title:
            get("previewTitle")
                .value
                .trim(),

        description:
            get("description")
                .value
                .trim(),

        version:
            get("version")
                .value
                .trim(),

        category:
            get("category")
                .value
                .trim(),

        icon:
            iconData,

        updatedAt:
            new Date()
                .toISOString()

    };


    try{

        localStorage.setItem(
            PREVIEW_KEY,
            JSON.stringify(
                data
            )
        );

        showToast(
            "App preview saved."
        );

    }catch(error){

        console.error(
            "Save preview error:",
            error
        );

        showToast(
            "Could not save preview."
        );

    }

}


/* =========================
   LOAD PREVIEW
========================= */

function loadPreview(){

    try{

        const raw =
            localStorage.getItem(
                PREVIEW_KEY
            );

        if(!raw){
            return;
        }

        const data =
            JSON.parse(raw);


        if(data.title){

            get(
                "previewTitle"
            ).value =
                data.title;

        }


        if(data.description){

            get(
                "description"
            ).value =
                data.description;

        }


        if(data.version){

            get(
                "version"
            ).value =
                data.version;

        }


        if(data.category){

            get(
                "category"
            ).value =
                data.category;

        }


        if(data.icon){

            iconData =
                data.icon;

        }


        updatePreview();

    }catch(error){

        console.warn(
            "Could not load preview:",
            error
        );

    }

}


/* =========================
   ICON UPLOAD
========================= */

get("iconFile")
    .addEventListener(
        "change",
        function(event){

            const file =
                event.target.files[0];


            if(!file){
                return;
            }


            if(
                !file.type.startsWith(
                    "image/"
                )
            ){

                showToast(
                    "Please select an image."
                );

                return;

            }


            const reader =
                new FileReader();


            reader.onload =
                function(){

                    iconData =
                        reader.result;

                    updatePreview();

                    savePreview();

                };


            reader.readAsDataURL(
                file
            );

        }
    );


/* =========================
   SCREENSHOT UPLOAD
========================= */

get("screenshotFile")
    .addEventListener(
        "change",
        function(event){

            const file =
                event.target.files[0];


            if(!file){
                return;
            }


            const reader =
                new FileReader();


            reader.onload =
                function(){

                    get(
                        "screenshotImage"
                    ).src =
                        reader.result;

                    get(
                        "screenshotPreview"
                    ).style.display =
                        "block";

                };


            reader.readAsDataURL(
                file
            );

        }
    );


/* =========================
   REFRESH
========================= */

function refreshPreview(){

    updatePreview();

    showToast(
        "Preview updated."
    );

}


/* ======================
/* =========================
   INPUT EVENTS
========================= */

[
    "previewTitle",
    "description",
    "version",
    "category"
].forEach(
    function(id){

        const element =
            get(id);

        if(!element){
            return;
        }

        element.addEventListener(
            "input",
            function(){

                updatePreview();

            }
        );

        element.addEventListener(
            "change",
            function(){

                updatePreview();

            }
        );

    }
);


/* =========================
   KEYBOARD SHORTCUTS
========================= */

document.addEventListener(
    "keydown",
    function(event){

        if(
            (event.ctrlKey ||
             event.metaKey) &&
            event.key.toLowerCase() === "s"
        ){

            event.preventDefault();

            savePreview();

        }

        if(
            event.key === "Escape"
        ){

            updatePreview();

        }

    }
);


/* =========================
   INITIALIZATION
========================= */

document.addEventListener(
    "DOMContentLoaded",
    function(){

        loadBuildData();

        loadPreview();

        updatePreview();

        console.log(
            "LetsStudy Pro App Preview initialized."
        );

    }
);


/* =========================
   GLOBAL FUNCTIONS
========================= */

window.get =
    get;

window.showToast =
    showToast;

window.updatePreview =
    updatePreview;

window.loadBuildData =
    loadBuildData;

window.savePreview =
