.toast{
    position:fixed;
    right:20px;
    bottom:20px;
    background:var(--dark);
    color:#fff;
    padding:12px 16px;
    border-radius:9px;
    opacity:0;
    transform:translateY(10px);
    transition:.2s;
    z-index:100;
}

.toast.show{
    opacity:1;
    transform:translateY(0);
}

