<!-- =====================================
     HERO
===================================== -->

<section class="hero">

  <div class="container hero-content">

    <span class="hero-badge">

      <i class="fa-solid fa-compass"></i>

      Application Support

    </span>


    <h1>
      Your Complete Application Guide
    </h1>


    <p>
