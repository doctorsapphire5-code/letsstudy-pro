<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="LetsStudy Pro application guide. Learn how to apply for universities, scholarships and study abroad opportunities."
  >

  <title>
    Application Guide | LetsStudy Pro
  </title>


  <!-- FONT AWESOME -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
  >


  <style>

    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
    }


    :root{

      --primary:#2563eb;
      --primary-dark:#1d4ed8;

      --secondary:#0f172a;

      --text:#1e293b;
      --muted:#64748b;

      --bg:#f8fafc;
      --white:#ffffff;

      --border:#e2e8f0;

      --success:#16a34a;
      --warning:#d97706;

      --radius:16px;

      --shadow:
        0 10px 30px
        rgba(15,23,42,.07);

    }


    html{

      scroll-behavior:smooth;

    }


    body{

      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background:var(--bg);

      color:var(--text);

      line-height:1.6;

    }


    a{

      color:inherit;

      text-decoration:none;

    }


    button,
    input,
    select{

      font:inherit;

    }


    .container{

      width:
        min(1180px,92%);

      margin:auto;

    }


    /* =====================================
       HEADER
    ===================================== */

    header{

      position:sticky;

      top:0;

      z-index:1000;

      background:
        rgba(255,255,255,.95);

      backdrop-filter:
        blur(12px);

      border-bottom:
        1px solid var(--border);

    }


    .navbar{

      height:72px;

      display:flex;

      align-items:center;

      justify-content:space-between;

      gap:25px;

    }


    .logo{

      display:flex;

      align-items:center;

      gap:9px;

      color:var(--secondary);

      font-size:20px;

      font-weight:800;

    }


    .logo i{

      color:var(--primary);

      font-size:24px;

    }


    .nav-links{

      display:flex;

      align-items:center;

      gap:24px;

    }


    .nav-links a{

      color:#475569;

      font-size:14px;

      font-weight:600;

      transition:.2s ease;

    }


    .nav-links a:hover,
    .nav-links a.active{

      color:var(--primary);

    }


    .menu-btn{

      display:none;

      border:0;

      background:none;

      font-size:22px;

      cursor:pointer;

    }


    /* =====================================
       HERO
    ===================================== */

    .hero{

      padding:
        75px 0 65px;

      background:

        linear-gradient(
          135deg,
          #eff6ff 0%,
          #ffffff 55%,
          #f8fafc 100%
        );

      border-bottom:
        1px solid var(--border);

    }


    .hero-content{

      max-width:800px;

      margin:auto;

      text-align:center;

    }


    .hero-badge{

      display:inline-flex;

      align-items:center;

      gap:8px;

      padding:
        7px 13px;

      margin-bottom:18px;

      border-radius:999px;

      background:#dbeafe;

      color:#1d4ed8;

      font-size:13px;

      font-weight:700;

    }


    .hero h1{

      font-size:
        clamp(34px,5vw,58px);

      line-height:1.1;

      color:var(--secondary);

      margin-bottom:18px;

      letter-spacing:-1.5px;

    }


    .hero p{

      max-width:680px;

      margin:auto;

      color:var(--muted);

      font-size:17px;

    }


    /* =====================================
       SEARCH
    ===================================== */

    .guide-search{

      margin-top:30px;

      position:relative;

      max-width:650px;

      margin-left:auto;

      margin-right:auto;

    }


    .guide-search i{

      position:absolute;

      left:18px;

      top:50%;

      transform:
        translateY(-50%);

      color:#94a3b8;

    }


    .guide-search input{

      width:100%;

      height:56px;

      padding:
        0 20px 0 48px;

      border:
        1px solid var(--border);

      border-radius:14px;

      outline:none;

      background:#fff;

      box-shadow:var(--shadow);

    }


    .guide-search input:focus{

      border-color:
        var(--primary);

      box-shadow:
        0 0 0 4px
        rgba(37,99,235,.1);

    }


    /* =====================================
       QUICK NAV
    ===================================== */

    .quick-nav{

      padding:24px 0;

      background:#fff;

      border-bottom:
        1px solid var(--border);

    }


    .quick-nav-inner{

      display:flex;

      justify-content:center;

      flex-wrap:wrap;

      gap:10px;

    }


    .quick-nav a{

      padding:
        9px 15px;

      border:
        1px solid var(--border);

      border-radius:999px;

      color:#475569;

      background:#fff;

      font-size:13px;

      font-weight:600;

      transition:.2s ease;

    }


    .quick-nav a:hover{

      color:var(--primary);

      border-color:#bfdbfe;

      background:#eff6ff;

    }


    /* =====================================
       MAIN
    ===================================== */

    main{

      padding:60px 0;

    }


    .section{

      margin-bottom:65px;

      scroll-margin-top:95px;

    }


    .section-heading{

      margin-bottom:25px;

    }


    .section-heading h2{

      color:var(--secondary);

      font-size:
        clamp(25px,4vw,34px);

      margin-bottom:8px;

    }


    .section-heading p{

      color:var(--muted);

    }


    /* =====================================
       STEPS
    ===================================== */

    .steps{

      display:grid;

      grid-template-columns:
        repeat(4,1fr);

      gap:18px;

    }


    .step{

      position:relative;

      padding:25px;

      background:#fff;

      border:
        1px solid var(--border);

      border-radius:var(--radius);

      box-shadow:var(--shadow);

    }


    .step-number{

      width:44px;

      height:44px;

      display:flex;

      align-items:center;

      justify-content:center;

      border-radius:12px;

      background:#dbeafe;

      color:var(--primary);

      font-weight:800;

      margin-bottom:18px;

    }


    .step h3{

      margin-bottom:8px;

      color:var(--secondary);

      font-size:18px;

    }


    .step p{

      color:var(--muted);

      font-size:14px;

    }


    /* =====================================
       GUIDE CARDS
    ===================================== */

    .guide-grid{

      display:grid;

      grid-template-columns:
        repeat(3,1fr);

      gap:20px;

    }


    .guide-card{

      background:#fff;

      border:
        1px solid var(--border);

      border-radius:var(--radius);

      padding:25px;

      box-shadow:var(--shadow);

      transition:
        transform .2s ease,
        box-shadow .2s ease;

    }


    .guide-card:hover{

      transform:
        translateY(-4px);

      box-shadow:
        0 16px 35px
        rgba(15,23,42,.1);

    }


    .guide-icon{

      width:50px;

      height:50px;

      display:flex;

      align-items:center;

      justify-content:center;

      border-radius:13px;

      background:#eff6ff;

      color:var(--primary);

      font-size:21px;

      margin-bottom:17px;

    }


    .guide-card h3{

      color:var(--secondary);

      margin-bottom:8px;

    }


    .guide-card p{

      color:var(--muted);

      font-size:14px;

    }


    /* =====================================
       DOCUMENT CHECKLIST
    ===================================== */

    .checklist{

      display:grid;

      grid-template-columns:
        repeat(2,1fr);

      gap:12px;

    }


    .check-item{

      display:flex;

      align-items:flex-start;

      gap:13px;

      padding:16px;

      background:#fff;

      border:
        1px solid var(--border);

      border-radius:12px;

    }


    .check-item i{

      color:var(--success);

      margin-top:3px;

    }


    .check-item strong{

      display:block;

      color:var(--secondary);

      margin-bottom:3px;

    }


    .check-item span{

      color:var(--muted);

      font-size:13px;

    }


    /* =====================================
       IMPORTANT TIPS
    ===================================== */

    .tips{

      display:grid;

      grid-template-columns:
        repeat(2,1fr);

      gap:20px;

    }


    .tip{

      display:flex;

      gap:16px;

      padding:22px;

      border-radius:var(--radius);

      background:#fff;

      border:
        1px solid var(--border);

      box-shadow:var(--shadow);

    }


    .tip-icon{

      flex-shrink:0;

      width:42px;

      height:42px;

      display:flex;

      align-items:center;

      justify-content:center;

      border-radius:11px;

      background:#fef3c7;

      color:var(--warning);

    }


    .tip h3{

      margin-bottom:5px;

      font-size:16px;

      color:var(--secondary);

    }


    .tip p{

      color:var(--muted);

      font-size:14px;

    }


    /* =====================================
       WARNING BOX
    ===================================== */

    .notice{

      display:flex;

      gap:15px;

      padding:22px;

      background:#eff6ff;

      border:
        1px solid #bfdbfe;

      border-radius:var(--radius);

    }


    .notice i{

      color:var(--primary);

      font-size:20px;

      margin-top:3px;

    }


    .notice h3{

      margin-bottom:5px;

      color:#1e3a8a;

    }


    .notice p{

      color:#475569;

      font-size:14px;

    }


    /* =====================================
       FAQ
    ===================================== */

    .faq{

      display:grid;

      gap:12px;

      max-width:850px;

    }


    .faq-item{

      background:#fff;

      border:
        1px solid var(--border);

      border-radius:12px;

      overflow:hidden;

    }


    .faq-question{

      width:100%;

      padding:18px 20px;

      border:0;

      background:#fff;

      display:flex;

      align-items:center;

      justify-content:space-between;

      gap:20px;

      text-align:left;

      cursor:pointer;

      color:var(--secondary);

      font-weight:700;

    }


    .faq-question i{

      color:var(--primary);

      transition:.2s ease;

    }


    .faq-answer{

      display:none;

      padding:
        0 20px 20px;

      color:var(--muted);

      font-size:14px;

    }


    .faq-item.open
    .faq-answer{

      display:block;

    }


    .faq-item.open
    .faq-question i{

      transform:
        rotate(180deg);

    }


    /* =====================================
       CTA
    ===================================== */

    .cta{

      padding:45px;

      border-radius:22px;

      background:

        linear-gradient(
          135deg,
          #1d4ed8,
          #2563eb
        );

      color:#fff;

      text-align:center;

    }


    .cta h2{

      font-size:30px;

      margin-bottom:10px;

    }


    .cta p{

      max-width:650px;

      margin:
        0 auto 25px;

      color:#dbeafe;

    }


    .cta-buttons{

      display:flex;

      justify-content:center;

      flex-wrap:wrap;

      gap:12px;

    }


    .btn{

      display:inline-flex;

      align-items:center;

      justify-content:center;

      gap:8px;

      min-height:45px;

      padding:
        0 20px;

      border-radius:10px;

      font-weight:700;

      font-size:14px;

    }


    .btn-light{

      background:#fff;

      color:#1d4ed8;

    }


    .btn-outline{

      border:
        1px solid
        rgba(255,255,255,.5);

      color:#fff;

    }


    /* =====================================
       FOOTER
    ===================================== */

    footer{

      background:#0f172a;

      color:#cbd5e1;

      padding:40px 0 20px;

    }


    .footer-top{

      display:flex;

      justify-content:space-between;

      gap:30px;

      padding-bottom:30px;

      border-bottom:
        1px solid
        rgba(255,255,255,.1);

    }


    .footer-brand{

      max-width:400px;

    }


    .footer-brand h3{

      color:#fff;

      margin-bottom:8px;

    }


    .footer-brand p{

      font-size:14px;

    }


    .footer-links{

      display:flex;

      flex-wrap:wrap;

      gap:18px;

      align-items:center;

    }


    .footer-links a{

      font-size:13px;

    }


    .footer-links a:hover{

      color:#fff;

    }


    .footer-bottom{

      padding-top:20px;

      display:flex;

      justify-content:space-between;

      gap:20px;

      font-size:13px;

    }


    /* =====================================
       BACK TO TOP
    ===================================== */

    #backToTop{

      position:fixed;

      right:20px;

      bottom:20px;

      width:45px;

      height:45px;

      border:0;

      border-radius:50%;

      background:var(--primary);

      color:#fff;

      cursor:pointer;

      opacity:0;

      visibility:hidden;

      transform:
        translateY(10px);

      transition:.25s ease;

      z-index:999;

    }


    #backToTop.show{

      opacity:1;

      visibility:visible;

      transform:
        translateY(0);

    }


    /* =====================================
       SEARCH HIGHLIGHT
    ===================================== */

    .hidden-search{

      display:none !important;

    }


    /* =====================================
       RESPONSIVE
    ===================================== */

    @media(max-width:900px){

      .steps{

        grid-template-columns:
          repeat(2,1fr);

      }


      .guide-grid{

        grid-template-columns:
          repeat(2,1fr);

      }

    }


    @media(max-width:700px){

      .menu-btn{

        display:block;

      }


      .nav-links{

        position:absolute;

        top:72px;

        left:0;

        right:0;

        display:none;

        flex-direction:column;

        align-items:stretch;

        gap:0;

        background:#fff;

        border-bottom:
          1px solid var(--border);

      }


      .nav-links.open{

        display:flex;

      }


      .nav-links a{

        padding:14px 4%;

        border-bottom:
          1px solid #f1f5f9;

      }


      .hero{

        padding:
          55px 0;

      }


      .steps,
      .guide-grid,
      .checklist,
      .tips{

        grid-template-columns:1fr;

      }


      .footer-top,
      .footer-bottom{

        flex-direction:column;

      }


      .cta{

        padding:30px 20px;

      }

    }


    @media(max-width:450px){

      .hero h1{

        font-size:34px;

      }


      .quick-nav-inner{

        justify-content:flex-start;

      }

    }

  </style>

</head>


