    </p>


    <div class="guide-search">

      <i
        class="fa-solid fa-magnifying-glass"
      ></i>

      <input
        type="search"
        id="guideSearch"
        placeholder="
          Search application guide...
        "
        autocomplete="off"
      >

    </div>

  </div>

</section>


<!-- =====================================
     QUICK NAVIGATION
===================================== -->

<section class="quick-nav">

  <div class="container quick-nav-inner">

    <a href="#steps">
