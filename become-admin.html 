<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Become an Admin | LetsStudy Pro</title>

<meta name="description"
content="Apply to become an administrator of LetsStudy Pro. Applications are reviewed within one week.">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
*{box-sizing:border-box}

body{
 margin:0;
 background:#f6f8fb;
 color:#172033;
 font-family:Inter,Arial,sans-serif
}

a{text-decoration:none;color:inherit}

.top{
 height:64px;
 background:#fff;
 border-bottom:1px solid #e5e7eb;
 padding:0 6%;
 display:flex;
 align-items:center;
 justify-content:space-between;
 position:sticky;
 top:0;
 z-index:20
}

.logo{
 color:#155eef;
 font-size:21px;
 font-weight:800
}

.nav{
 display:flex;
 gap:18px;
 font-size:13px;
 font-weight:700
}

.container{
 max-width:850px;
 margin:35px auto;
 padding:0 18px
}

.hero{
 background:linear-gradient(135deg,#155eef,#073bba);
 color:#fff;
 padding:38px 25px;
 border-radius:18px;
 margin-bottom:20px
}

.hero h1{
 margin:0 0 10px;
 font-size:32px
}

.hero p{
 margin:0;
 max-width:680px;
 line-height:1.7;
 color:#dbe7ff;
 font-size:13px
}

.card{
 background:#fff;
 border:1px solid #e5e7eb;
 border-radius:16px;
 padding:25px
}

.info{
 background:#eff6ff;
 border:1px solid #bfdbfe;
 border-radius:12px;
 padding:16px;
 margin-bottom:22px;
 font-size:12px;
 line-height:1.7;
 color:#1e40af
}

.info h3{
 margin:0 0 8px;
 font-size:14px
}

.info ul{
 margin:8px 0 0;
 padding-left:20px
}

.grid{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:15px
}

.group{
 margin-bottom:15px
}

.full{
 grid-column:1/-1
}

label{
 display:block;
 font-size:12px;
 font-weight:800;
 margin-bottom:7px
}

input,
select,
textarea{
 width:100%;
 padding:12px;
 border:1px solid #d9dee8;
 border-radius:9px;
 outline:none;
 background:#fff;
 font-family:inherit
}

textarea{
 min-height:110px;
 resize:vertical
}

input:focus,
select:focus,
textarea:focus{
 border-color:#155eef
}

.roles{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:10px
}

.role{
 border:1px solid #d9dee8;
 border-radius:10px;
 padding:14px;
 cursor:pointer
}

.role input{
 width:auto
}

.role strong{
 display:block;
 margin-top:7px;
 font-size:12px
}

.role small{
 display:block;
 color:#667085;
 font-size:10px;
 line-height:1.5;
 margin-top:4px
}

.permissions{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:8px
}

.permission{
 background:#f8fafc;
 padding:11px;
 border-radius:8px;
 font-size:11px
}

.permission input{
 width:auto;
 margin-right:6px
}

.agreement{
 display:flex;
 gap:8px;
 align-items:flex-start;
 font-size:11px;
 line-height:1.5
}

.agreement input{
 width:auto;
 margin-top:3px
}

.submit{
 width:100%;
 border:0;
 padding:14px;
 border-radius:9px;
 background:#155eef;
 color:#fff;
 font-weight:800;
 cursor:pointer;
 font-size:13px
}

.submit:disabled{
 opacity:.6;
 cursor:not-allowed
}

.status{
 display:none;
 margin-top:15px;
 padding:13px;
 border-radius:9px;
 font-size:12px;
 line-height:1.6
}

.status.success{
 display:block;
 background:#ecfdf3;
 color:#027a48;
 border:1px solid #abefc6
}

.status.error{
 display:block;
 background:#fef3f2;
 color:#b42318;
 border:1px solid #fecdca
}

@media(max-width:650px){

 .nav{
  display:none
 }

 .grid,
 .roles,
 .permissions{
  grid-template-columns:1fr
 }

 .full{
  grid-column:auto
 }

 .hero h1{
  font-size:26px
 }

 .card{
  padding:18px
 }
}
</style>
</head>

<body>

<header class="top">

<a href="index.html" class="logo">
LetsStudy Pro
</a>

<nav class="nav">

<a href="course.html">Courses</a>

<a href="marketplace.html">Marketplace</a>

<a href="freelance.html">Freelancers</a>

<a href="careers.html">Careers</a>

</nav>

</header>


<main class="container">


<section class="hero">

<h1>
Become a LetsStudy Pro Admin
</h1>

<p>
Join the LetsStudy Pro administration team and help manage,
moderate and grow the platform.
</p>

</section>


<section class="card">


<div class="info">

<h3>
<i class="fa fa-circle-info"></i>
Before You Apply
</h3>

LetsStudy Pro reviews admin applications carefully.
After submitting your application, please allow up to
<strong>one week</strong> for the review process.

<ul>

<li>
If your application is approved, you will receive an
approval notification through your registered email.
</li>

<li>
If your application is not approved within one week,
<strong>check your email</strong> for an explanation or
reason why the application was not approved.
</li>

<li>
You may be asked to provide additional information or
correct certain details before your application can be approved.
</li>

<li>
Do not submit multiple applications while your current
application is still under review.
</li>

</ul>

</div>


<form id="adminForm">


<div class="grid">


<div class="group">

<label>
Full Name *
</label>

<input
id="name"
required
placeholder="Enter your full name">

</div>


<div class="group">

<label>
Email Address *
</label>

<input
id="email"
type="email"
required
placeholder="Enter your email address">

</div>


<div class="group">

<label>
Phone Number
</label>

<input
id="phone"
placeholder="+255...">

</div>


<div class="group">

<label>
Country *
</label>

<input
id="country"
required
placeholder="Enter your country">

</div>


<div class="group full">

<label>
Admin Role You Are Applying For *
</label>

<div class="roles">


<label class="role">

<input
type="radio"
name="role"
value="contentAdmin"
required>

<strong>
Content Admin
</strong>

<small>
Manage courses, scholarships, careers and educational content.
</small>

</label>


<label class="role">

<input
type="radio"
name="role"
value="communityAdmin">

<strong>
Community Admin
</strong>

<small>
Manage communities, groups, reports and moderation.
</small>

</label>


<label class="role">

<input
type="radio"
name="role"
value="marketingAdmin">

<strong>
Marketing Admin
</strong>

<small>
Manage campaigns, promotions and marketing content.
</small>

</label>


</div>

</div>


<div class="group full">

<label>
Why do you want to become an Admin? *
</label>

<textarea
id="reason"
required
placeholder="Explain why you want to become a LetsStudy Pro Admin..."></textarea>

</div>


<div class="group full">

<label>
Your Experience
</label>

<textarea
id="experience"
placeholder="Describe your relevant skills, experience or previous responsibilities..."></textarea>

</div>


<div class="group full">

<label>
Requested Permissions
</label>

<div class="permissions">


<label class="permission">
<input type="checkbox" value="manageCourses">
Manage Courses
</label>


<label class="permission">
<input type="checkbox" value="manageUsers">
Manage Users
</label>


<label class="permission">
<input type="checkbox" value="manageCareers">
Manage Careers
</label>


<label class="permission">
<input type="checkbox" value="manageScholarships">
Manage Scholarships
</label>


<label class="permission">
<input type="checkbox" value="manageMarketing">
Manage Marketing
</label>


<label class="permission">
<input type="checkbox" value="manageCommunity">
Manage Community
</label>


<label class="permission">
<input type="checkbox" value="manageFreelancers">
Manage Freelancers
</label>


<label class="permission">
<input type="checkbox" value="viewReports">
View Reports
</label>


</div>

</div>


<div class="group full">

<label>
Additional Information
</label>

<textarea
id="additional"
placeholder="Add any other information you would like the review team to know..."></textarea>

</div>


<div class="group full">

<label class="agreement">

<input
id="agreement"
type="checkbox"
required>

<span>
I confirm that the information I have provided is accurate
and I agree to follow LetsStudy Pro administrator policies.
</span>

</label>

</div>


<div class="group full">

<button
class="submit"
id="submitBtn"
type="submit">

<i class="fa fa-paper-plane"></i>

Submit Admin Application

</button>

<div
id="status"
class="status">
</div>

</div>

</div>

</form>

</section>

</main>


<script type="module">

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

import {
getAuth,
onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

import {
getFirestore,
collection,
addDoc,
serverTimestamp,
query,
where,
getDocs
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


const firebaseConfig={

apiKey:
"AIzaSyBcOYDfAVKXbkljsYrgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};


const app=
initializeApp(firebaseConfig);

const auth=
getAuth(app);

const db=
getFirestore(app);


let currentUser=null;


const form=
document.getElementById("adminForm");

const email=
document.getElementById("email");

const statusBox=
document.getElementById("status");

const submitBtn=
document.getElementById("submitBtn");


function status(message,type){

statusBox.textContent=message;

statusBox.className=
"status "+type;

}


onAuthStateChanged(
auth,
user=>{

currentUser=user;

if(user){

email.value=
user.email||"";

email.readOnly=true;

}

}
);


form.addEventListener(
"submit",
async e=>{

e.preventDefault();


if(!currentUser){

status(
"Please log in to your LetsStudy Pro account before submitting an admin application.",
"error"
);

return;

}


const selectedRole=
document.querySelector(
'input[name="role"]:checked'
);


if(!selectedRole){

status(
"Please select the admin role you are applying for.",
"error"
);

return;

}


submitBtn.disabled=true;


try{


const q=
query(
collection(db,"adminRequests"),
where(
"userId",
"==",
currentUser.uid
)
);


const snap=
await getDocs(q);


const pending=
snap.docs.some(
item=>
item.data().status==="pending"
);


if(pending){

status(
"You already have an admin application under review. Please allow up to one week and check your email for the result.",
"error"
);

submitBtn.disabled=false;

return;

}


const permissions=
[
...document.querySelectorAll(
".permission input:checked"
)
].map(
item=>item.value
);


await addDoc(

collection(
db,
"adminRequests"
),

{

userId:
currentUser.uid,

name:
document.getElementById("name").value.trim(),

email:
currentUser.email,

phone:
document.getElementById("phone").value.trim(),

country:
document.getElementById("country").value.trim(),

requestedRole:
selectedRole.value,

permissions:
permissions,

reason:
document.getElementById("reason").value.trim(),

experience:
document.getElementById("experience").value.trim(),

additional:
document.getElementById("additional").value.trim(),

status:
"pending",

reviewed:
false,

createdAt:
serverTimestamp(),

updatedAt:
serverTimestamp()

}

);


status(
"Your admin application has been submitted successfully. Please allow up to one week for review. If it is not approved, check your registered email for the reason or next steps.",
"success"
);


form.reset();

email.value=
currentUser.email||"";

email.readOnly=true;


}catch(error){

console.error(error);

status(
"Something went wrong while submitting your application. Please try again.",
"error"
);

}


submitBtn.disabled=false;

}
);

</script>

</body>
</html>