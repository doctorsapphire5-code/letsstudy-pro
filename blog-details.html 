    .hero {
      padding: 35px;
    }

    .category {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 999px;
      background: #eaf2ff;
      color: #1d4ed8;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 14px;
    }

    .title {
      margin: 0;
