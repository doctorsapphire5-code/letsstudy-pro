  <script type="module">

    import {
      initializeApp
    } from
      "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";


    import {
      getFirestore,
      doc,
      getDoc,
      updateDoc,
      increment
    } from
      "https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";


    /* =========================
       FIREBASE
    ========================= */

    const firebaseConfig = {

      apiKey:
        "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

      authDomain:
        "let-s-study-pro-course.firebaseapp.com",

      databaseURL:
        "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

      projectId:
        "let-s-study-pro-course",

      storageBucket:
        "let-s-study-pro-course.firebasestorage.app",

      messagingSenderId:
        "474928293390",

      appId:
        "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

      measurementId:
        "G-85B7V5H5J0"

    };


    const app =
      initializeApp(
        firebaseConfig
      );


    const db =
      getFirestore(app);


    /* =========================
       ELEMENTS
    ========================= */

    const loading =
      document.getElementById(
        "loading"
      );

    const errorBox =
      document.getElementById(
        "error"
      );

    const article =
      document.getElementById(
        "article"
      );


    document.getElementById(
      "year"
    ).textContent =
      new Date().getFullYear();


    /* =========================
       BLOG DOCUMENT ID
    ========================= */

    const params =
      new URLSearchParams(
        window.location.search
      );


    const documentId =
      params.get("blogId") ||
      params.get("id");


    if(!documentId){

      showError(
        "No blogId was provided."
      );

    }else{

      loadBlog(
        documentId
      );

    }


    /* =========================
       LOAD BLOG
    ========================= */

    async function loadBlog(
      id
    ){

      try{

        const reference =
          doc(
            db,
            "blogPosts",
            id
          );


        const snapshot =
          await getDoc(
            reference
          );


        if(!snapshot.exists()){

          showError(
            "This blog post does not exist."
          );

          return;

        }


        const data =
          snapshot.data();


        /*
          Only published/active posts
          are shown publicly.
        */

        const isPublished =
          data.published === true ||
          String(
            data.published
          ).toLowerCase() === "true";


        const status =
          String(
            data.status ||
            ""
          ).toLowerCase();


        if(
          !isPublished ||
          (
            status &&
            ![
              "published",
              "active"
            ].includes(
              status
            )
          )
        ){

          showError(
            "This blog post is not currently available."
          );

          return;

        }


        renderBlog(
          data,
          id
        );


        recordView(
          reference
        );


      }catch(error){

        console.error(
          "Blog loading error:",
          error
        );


        showError(
          "Unable to load this blog post. Please try again."
        );

      }

    }


    /* =========================
       RENDER BLOG
    ========================= */

    function renderBlog(
      data,
      id
    ){

      const title =
        data.title ||
        "Untitled Article";


      const description =
        data.seo?.description ||
        data.excerpt ||
        "";


      document.title =
        data.seo?.title ||
        title ||
        "Blog Details | LetsStudy Pro";


      setMeta(
        "description",
        description
      );


      setMetaProperty(
        "og:title",
        data.seo?.title ||
        title
      );


      setMetaProperty(
        "og:description",
        description
      );


      setMetaProperty(
        "og:image",
        data.seo?.ogImage ||
        data.coverImage ||
        ""
      );


      setMetaProperty(
        "og:url",
        window.location.href
      );


      const canonical =
        data.seo?.canonicalUrl ||
        `https://letsstudy.pro/blog-details.html?blogId=${encodeURIComponent(
          id
        )}`;


      let canonicalElement =
        document.querySelector(
          'link[rel="canonical"]'
        );


      if(!canonicalElement){

        canonicalElement =
          document.createElement(
            "link"
          );

        canonicalElement.rel =
          "canonical";

        document.head.appendChild(
          canonicalElement
        );

      }


      canonicalElement.href =
        canonical;


      document.getElementById(
        "title"
      ).textContent =
        title;


      document.getElementById(
        "excerpt"
      ).textContent =
        data.excerpt ||
        "";


      /* CATEGORY */

      if(data.category){

        const category =
          document.getElementById(
            "category"
          );

        category.textContent =
          data.category;

        category.classList.remove(
          "hidden"
        );

      }


      /* AUTHOR */

      renderAuthor(
        data
      );


      /* META */

      renderMeta(
        data
      );


      /* STATS */

      renderStats(
        data
      );


      /* COVER */

      if(
        data.coverImage &&
        isSafeUrl(
          data.coverImage
        )
      ){

        const cover =
          document.getElementById(
            "cover"
          );


        cover.src =
          data.coverImage;


        cover.alt =
          title;


        cover.classList.remove(
          "hidden"
        );

      }


      /* CONTENT */

      document.getElementById(
        "content"
      ).innerHTML =
        sanitizeContent(
          data.content ||
          ""
        );


      /* MEDIA */

      renderImages(
        data.images
      );


      renderVideos(
        data.videos
      );


      renderAudios(
        data.audios
      );


      renderFiles(
        data.files
      );


      renderEmbeds(
        data.embeds
      );


      renderAI(
        data.aiEmbed
      );


      renderTags(
        data.tags
      );


      setupSharing();


      article.classList.remove(
        "hidden"
      );


      loading.classList.add(
        "hidden"
      );

    }


    /* =========================
       AUTHOR
    ========================= */

    function renderAuthor(
      data
    ){

      if(
        !data.authorName &&
        !data.authorPhoto &&
        !data.authorId
      ){

        return;

      }


      const section =
        document.getElementById(
          "author"
        );


      const photo =
        document.getElementById(
          "authorPhoto"
        );


      const name =
        document.getElementById(
          "authorName"
        );


      const authorId =
        document.getElementById(
          "authorId"
        );


      name.textContent =
        data.authorName ||
        "LetsStudy Pro";


      authorId.textContent =
        data.authorId
          ? `Author ID: ${data.authorId}`
          : "";


      if(
        data.authorPhoto &&
        isSafeUrl(
          data.authorPhoto
        )
      ){

        photo.src =
          data.authorPhoto;

        photo.alt =
          data.authorName ||
          "Author";

      }else{

        photo.classList.add(
          "hidden"
        );

      }


      section.classList.remove(
        "hidden"
      );

    }


    /* =========================
       META
    ========================= */

    function renderMeta(
      data
    ){

      const meta =
        document.getElementById(
          "meta"
        );


      meta.innerHTML =
        "";


      if(data.language){

        addMeta(
          `Language: ${data.language}`
        );

      }


      if(data.countryTarget){

        const countries =
                    Array.isArray(
            data.countryTarget
          )
            ? data.countryTarget
            : [data.countryTarget];


        if(countries.length){

          addMeta(
            `Target: ${countries.join(", ")}`
          );

        }

      }


      const date =
        timestampToDate(
          data.publishedAt
        ) ||
        timestampToDate(
          data.createdAt
        );


      if(date){

        addMeta(
          date.toLocaleDateString(
            undefined,
            {
              year:
                "numeric",
              month:
                "long",
              day:
                "numeric"
            }
          )
        );

      }

    }


    function addMeta(
      text
    ){

      const span =
        document.createElement(
          "span"
        );


      span.textContent =
        text;


      document.getElementById(
        "meta"
      ).appendChild(
        span
      );

    }


    /* =========================
       STATS
    ========================= */

    function renderStats(
      data
    ){

      const stats =
        document.getElementById(
          "stats"
        );


      stats.innerHTML =
        "";


      addStat(
        stats,
        "Views",
        data.views
      );


      addStat(
        stats,
        "Likes",
        data.likes
      );


      addStat(
        stats,
        "Shares",
        data.shares
      );


      addStat(
        stats,
        "Comments",
        data.commentsCount
      );

    }


    function addStat(
      container,
      label,
      value
    ){

      if(
        value === undefined ||
        value === null
      ){

        return;

      }


      const stat =
        document.createElement(
          "div"
        );


      stat.className =
        "stat";


      stat.textContent =
        `${label}: ${Number(
          value || 0
        ).toLocaleString()}`;


      container.appendChild(
        stat
      );

    }


    /* =========================
       IMAGES
    ========================= */

    function renderImages(
      items
    ){

      if(
        !Array.isArray(items) ||
        !items.length
      ){

        return;

      }


      const container =
        document.getElementById(
          "images"
        );


      items.forEach(
        item => {

          const url =
            typeof item === "string"
              ? item
              : item?.url;


          if(
            !url ||
            !isSafeUrl(url)
          ){

            return;

          }


          const card =
            document.createElement(
              "div"
            );


          card.className =
            "media-card";


          const image =
            document.createElement(
              "img"
            );


          image.src =
            url;


          image.loading =
            "lazy";


          image.alt =
            typeof item === "object"
              ? item.title ||
                "Article image"
              : "Article image";


          card.appendChild(
            image
          );


          if(
            typeof item === "object" &&
            item.title
          ){

            const title =
              document.createElement(
                "div"
              );


            title.className =
              "media-title";


            title.textContent =
              item.title;


            card.appendChild(
              title
            );

          }


          container.appendChild(
            card
          );

        }
      );


      if(
        container.children.length
      ){

        document.getElementById(
          "imagesSection"
        ).classList.remove(
          "hidden"
        );

      }

    }


    /* =========================
       VIDEOS
    ========================= */

    function renderVideos(
      items
    ){

      if(
        !Array.isArray(items) ||
        !items.length
      ){

        return;

      }


      const container =
        document.getElementById(
