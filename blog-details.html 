<script type="module">

/* =========================================
   FIREBASE IMPORTS
========================================= */

import {
  initializeApp
} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";

import {
  getFirestore,
  doc,
  getDoc,
  updateDoc,
  increment
} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";


/* =========================================
   FIREBASE CONFIG
========================================= */

const firebaseConfig = {

  apiKey:
    "AIzaSyBcOYDfAVKXbjs5RgI_0rjodBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-85B7V5H5J0"

};


const app =
  initializeApp(firebaseConfig);

const db =
  getFirestore(app);


/* =========================================
   ELEMENTS
========================================= */

const loading =
  document.getElementById("loading");

const errorBox =
  document.getElementById("errorBox");

const article =
  document.getElementById("article");

const category =
  document.getElementById("category");

const title =
  document.getElementById("title");

const excerpt =
  document.getElementById("excerpt");

const authorName =
  document.getElementById("authorName");

const authorPhotoBox =
  document.getElementById("authorPhotoBox");

const meta =
  document.getElementById("meta");

const countryTarget =
  document.getElementById("countryTarget");

const coverSection =
  document.getElementById("coverSection");

const coverImage =
  document.getElementById("coverImage");

const content =
  document.getElementById("content");

const imagesSection =
  document.getElementById("imagesSection");

const images =
  document.getElementById("images");

const videosSection =
  document.getElementById("videosSection");

const videos =
  document.getElementById("videos");

const audioSection =
  document.getElementById("audioSection");

const audios =
  document.getElementById("audios");

const filesSection =
  document.getElementById("filesSection");

const files =
  document.getElementById("files");

const embedsSection =
  document.getElementById("embedsSection");

const embeds =
  document.getElementById("embeds");

const aiSection =
  document.getElementById("aiSection");

const aiTitle =
  document.getElementById("aiTitle");

const aiProvider =
  document.getElementById("aiProvider");

const aiFrame =
  document.getElementById("aiFrame");

const tagsSection =
  document.getElementById("tagsSection");

const tags =
  document.getElementById("tags");

const engagement =
  document.getElementById("engagement");

const copyLink =
  document.getElementById("copyLink");

const facebookShare =
  document.getElementById("facebookShare");

const linkedinShare =
  document.getElementById("linkedinShare");

const whatsappShare =
  document.getElementById("whatsappShare");

const yearElement =
  document.getElementById("year");


/* =========================================
   FIRESTORE DOCUMENT ID
=========================================

   blog.html  -> blog.id -> ?id=
   search.html -> result.id -> ?id=

   IMPORTANT:
   This is the Firestore document ID.

   No slug lookup.
   No blogId field lookup.
   No API.
========================================= */

const params =
  new URLSearchParams(
    window.location.search
  );

const documentId =
  params.get("id");


if (!documentId) {

  showError(
    "No blog article was selected. Please open the article from Blog or Search."
  );

} else {

  loadBlog(documentId);

}


/* =========================================
   LOAD BLOG
========================================= */

async function loadBlog(id) {

  try {

    console.log(
      "Loading blog document:",
      id
    );


    /*
      DIRECT FIRESTORE DOCUMENT LOOKUP

      blogPosts/{Firestore Document ID}
    */

    const reference =
      doc(
        db,
        "blogPosts",
        id
      );


    const snapshot =
      await getDoc(reference);


    console.log(
      "Document exists:",
      snapshot.exists()
    );


    if (!snapshot.exists()) {

      showError(
        "The selected blog article could not be found."
      );

      return;

    }


    const data =
      snapshot.data();


    console.log(
      "Blog data:",
      data
    );


    /*
      Render first.
      View update must never stop
      the article from displaying.
    */

    renderBlog(
      data,
      id
    );


    recordView(
      reference
    );


  } catch (error) {

    console.error(
      "Blog loading error:",
      error
    );


    showError(
      "Unable to load this article. " +
      (
        error?.message ||
        "Please try again."
      )
    );

  }

}


/* =========================================
   RENDER BLOG
========================================= */

function renderBlog(
  data,
  id
) {

  try {

    data =
      data || {};


    /* =====================================
       TITLE
    ===================================== */

    const blogTitle =
      safeText(data.title) ||
      safeText(data.seo?.title) ||
      "LetsStudy Pro Blog";


    if (title) {

      title.textContent =
        blogTitle;

    }


    document.title =
      blogTitle +
      " | LetsStudy Pro";


    /* =====================================
       EXCERPT
    ===================================== */

    if (excerpt) {

      const text =
        safeText(data.excerpt);


      if (text) {

        excerpt.textContent =
          text;

        excerpt.style.display =
                    "block";

      } else {

        excerpt.style.display =
          "none";

      }

    }


    /* =====================================
       CATEGORY
    ===================================== */

    if (category) {

      category.textContent =
        safeText(
          data.category
        ) ||
        "General";

    }


    /* =====================================
       AUTHOR
    ===================================== */

    renderAuthor(data);


    /* =====================================
       META
    ===================================== */

    renderMeta(data);


    /* =====================================
       COUNTRY TARGET
    ===================================== */

    if (countryTarget) {

      countryTarget.innerHTML = "";

      const countries =
        normalizeArray(
          data.countryTarget
        )
        .map(item =>
          safeText(item)
        )
        .filter(Boolean);

      if (countries.length) {

        countryTarget.textContent =
          "Target: " +
          countries.join(", ");

        countryTarget.style.display =
          "block";

      } else {

        countryTarget.style.display =
          "none";

      }

    }


    /* =====================================
       COVER IMAGE
    ===================================== */

    renderCover(data);


    /* =====================================
       ARTICLE CONTENT
    ===================================== */

    if (content) {

      const articleContent =
        safeText(data.content);

      if (articleContent) {

        content.innerHTML =
          sanitizeContent(
            articleContent
          );

      } else {

        content.innerHTML =
          "<p>No article content is available.</p>";

      }

    }


    /* =====================================
       IMAGES
    ===================================== */

    renderImages(
      normalizeArray(
        data.images
      )
    );


    /* =====================================
       VIDEOS
    ===================================== */

    renderVideos(
      normalizeArray(
        data.videos
      )
    );


    /* =====================================
       AUDIO
    ===================================== */

    renderAudios(
      normalizeArray(
        data.audios
      )
    );


    /* =====================================
       FILES
    ===================================== */

    renderFiles(
      normalizeArray(
        data.files
      )
    );


    /* =====================================
       EMBEDS
    ===================================== */

    renderEmbeds(
      normalizeArray(
        data.embeds
      )
    );


    /* =====================================
       AI EMBED
    ===================================== */

    renderAI(
      data.aiEmbed
    );


    /* =====================================
       TAGS
    ===================================== */

    renderTags(
      normalizeArray(
        data.tags
      )
    );


    /* =====================================
       ENGAGEMENT
    ===================================== */

    renderEngagement(
      data
    );


    /* =====================================
       SEO
    ===================================== */

    setupSEO(
      data,
      blogTitle
    );


    /* =====================================
       SHARING
    ===================================== */

    setupSharing(
      blogTitle
    );


    /* =====================================
       SHOW ARTICLE
    ===================================== */

    if (loading) {

      loading.style.display =
        "none";

    }

    if (errorBox) {

      errorBox.style.display =
        "none";

    }

    if (article) {

      article.style.display =
        "block";

    }


    console.log(
      "Blog rendered successfully:",
      id
    );


  } catch (error) {

    console.error(
      "Blog rendering error:",
      error
    );

    showError(
      "The article was found, but it could not be displayed."
    );

  }

}


