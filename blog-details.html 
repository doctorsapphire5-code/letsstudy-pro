      const container =
        document.getElementById(
          "images"
        );


      container.innerHTML = "";


      items.forEach(
        (item) => {

          const url =
            typeof item === "string"
              ? item
              : item?.url;


          const title =
            typeof item === "object"
              ? item?.title || ""
              : "";


          if(
            !isSafeUrl(url)
          ){

            return;

          }


          const card =
            document.createElement(
              "div"
            );

          card.className =
            "media-card";


          const img =
            document.createElement(
              "img"
            );

          img.src =
            url;

          img.alt =
            title ||
            "Blog image";

          img.loading =
            "lazy";


          card.appendChild(
            img
