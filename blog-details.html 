/* =========================================
   ARTICLE CONTENT
========================================= */

function renderContent(data){

  const value =
    data.content;


  if(
    value === null ||
    value === undefined ||
    value === ""
  ){

    content.innerHTML =
      "<p>No article content is available.</p>";

    return;

  }


  if(
    typeof value === "string"
  ){

    /*
      Content from the admin can contain
      formatted HTML.
    */

    content.innerHTML =
      value;

    return;

  }


  if(
    Array.isArray(value)
  ){

    content.innerHTML =
      value
        .map(item => {

          if(
            typeof item === "string"
          ){

            return escapeHtml(item);

          }

          return escapeHtml(
            item?.text ||
            item?.content ||
            ""
          );

        })
        .filter(Boolean)
        .join("<br><br>");

    return;

  }


  content.textContent =
    String(value);

}


/* =========================================
   IMAGES
========================================= */

function renderImages(data){

  images.innerHTML =
    "";


  const list =
    normalizeList(
      data.images
    );


  if(!list.length){

    imagesSection.style.display =
      "none";

    return;

  }


  list.forEach(item => {

    const url =
      extractUrl(item);


    if(!url) return;


    const card =
      document.createElement("div");

    card.className =
      "media-card";


    const img =
      document.createElement("img");

    img.src =
      url;

    img.alt =
      extractTitle(item) ||
      "Blog image";

    img.loading =
      "lazy";


    img.onerror = () => {

      card.remove();

      if(!images.children.length){

        imagesSection.style.display =
          "none";

      }

    };


    card.appendChild(img);


    const caption =
      extractTitle(item);


    if(caption){

      const captionElement =
        document.createElement("div");

      captionElement.className =
        "media-title";

      captionElement.style.marginTop =
        "10px";

      captionElement.textContent =
        caption;

      card.appendChild(
        captionElement
      );

    }


    images.appendChild(card);

  });


  imagesSection.style.display =
    images.children.length
      ? "block"
      : "none";

}


/* =========================================
   VIDEOS
========================================= */

function renderVideos(data){

  videos.innerHTML =
    "";


  const list =
    normalizeList(
      data.videos
    );


  if(!list.length){

    videosSection.style.display =
      "none";

    return;

  }


  list.forEach(item => {

    const url =
      extractUrl(item);


    if(!url) return;


    const card =
      document.createElement("div");

    card.className =
      "media-card";


    const titleText =
      extractTitle(item);


    if(titleText){

      const heading =
        document.createElement("div");

      heading.className =
        "media-title";

      heading.textContent =
        titleText;

      card.appendChild(
        heading
      );

    }


    if(
      isYoutube(url) ||
      isVimeo(url)
    ){

      const iframe =
        document.createElement("iframe");

      iframe.src =
        videoEmbedUrl(url);

      iframe.title =
        titleText ||
        "Blog video";

      iframe.loading =
        "lazy";

      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";

      iframe.allowFullscreen =
        true;

      card.appendChild(
        iframe
      );

    }else{

      const video =
        document.createElement("video");

      video.src =
        url;

      video.controls =
        true;

      video.preload =
        "metadata";

      card.appendChild(
        video
      );

    }


    videos.appendChild(card);

  });


  videosSection.style.display =
    videos.children.length
      ? "block"
      : "none";

}


