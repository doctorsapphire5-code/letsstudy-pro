      margin-top: 18px;
    }

    .cover {
      width: 100%;
      max-height: 580px;
      object-fit: cover;
      display: block;
    }

    .content {
      padding: 35px;
      font-size: 17px;
      overflow-wrap: anywhere;
    }

    .content h1,
    .content h2,
    .content h3,
    .content h4,
    .content h5,
    .content h6 {
      color: #111827;
      line-height: 1.3;
      margin-top: 32px;
    }

    .content img {
      max-width: 100%;
      height: auto;
      border-radius: 12px;
      margin: 15px 0;
    }

    .content iframe,
    .content video {
      max-width: 100%;
      width: 100%;
      border-radius: 12px;
    }

    .content iframe {
      min-height: 320px;
      border: 0;
    }

    .content blockquote {
      margin: 25px 0;
      padding: 18px 22px;
      border-left: 4px solid #2563eb;
      background: #f4f7fb;
    }

    .content pre {
      overflow-x: auto;
      background: #111827;
      color: #fff;
      padding: 18px;
      border-radius: 10px;
    }

    .section {
      margin-top: 35px;
      padding: 0 35px 35px;
    }

    .section h2 {
      margin-bottom: 18px;
      font-size: 24px;
    }

    .media-grid {
      display: grid;
      grid-template-columns: repeat(
        auto-fit,
        minmax(240px, 1fr)
      );
      gap: 18px;
    }

    .media-card {
      background: #f7f9fc;
      border: 1px solid #e6eaf0;
      border-radius: 14px;
      padding: 16px;
      overflow: hidden;
    }

    .media-card img {
      width: 100%;
      max-height: 280px;
      object-fit: cover;
      border-radius: 10px;
      display: block;
    }

    .media-card video {
      width: 100%;
      border-radius: 10px;
    }

    .media-card audio {
      width: 100%;
    }

    .media-card iframe {
      width: 100%;
      min-height: 300px;
      border: 0;
      border-radius: 10px;
    }

    .media-title {
      font-weight: 700;
      margin-bottom: 10px;
    }

    .resource-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      border-radius: 9px;
      background: #111827;
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      font-size: 14px;
    }

    .ai-box {
      background: #f4f7fb;
      border: 1px solid #dce3ec;
      border-radius: 16px;
      padding: 20px;
    }

    .ai-box iframe {
      width: 100%;
      border: 0;
      border-radius: 12px;
      background: #fff;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .tag {
      background: #eef2f7;
      color: #374151;
      padding: 7px 11px;
      border-radius: 999px;
      font-size: 13px;
    }

    .stats {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 22px;
    }

    .stat {
      padding: 9px 13px;
      border-radius: 9px;
      background: #f1f5f9;
      color: #374151;
      font-size: 14px;
      font-weight: 700;
    }

    .share {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .share button {
      border: 0;
      border-radius: 9px;
      padding: 11px 15px;
      cursor: pointer;
      background: #111827;
      color: #fff;
      font-weight: 700;
    }

    .footer {
      margin-top: 35px;
      padding: 30px 20px;
      background: #111827;
      color: #cbd5e1;
      text-align: center;
    }

    .footer a {
      color: #fff;
      text-decoration: none;
      font-weight: 700;
    }

    .hidden {
      display: none !important;
    }

    @media (max-width: 700px) {

      .topbar-inner {
        flex-direction: column;
        align-items: stretch;
      }

      .back-btn {
        width: 100%;
      }

      .hero,
      .content,
      .section {
        padding-left: 20px;
        padding-right: 20px;
      }

      .title {
        font-size: 32px;
      }

      .content {
        font-size: 16px;
      }

    }

  </style>

</head>


