/* =========================================
   SEO
========================================= */

function setupSEO(
  data,
  blogTitle
) {

  const seo =
    data.seo || {};

  const description =
    safeText(
      seo.description
    ) ||
    safeText(
      data.excerpt
    );

  setMeta(
    "description",
    description
  );

  const keywords =
    normalizeArray(
      seo.keywords
    )
    .map(item =>
      safeText(item)
    )
    .filter(Boolean)
    .join(", ");

  if (keywords) {

    setMeta(
      "keywords",
      keywords
    );

  }

  setMetaProperty(
    "og:title",
    safeText(
      seo.title
    ) ||
    blogTitle
  );

  setMetaProperty(
    "og:description",
    description
  );

  if (
    data.coverImage &&
    isSafeUrl(
      data.coverImage
    )
  ) {

    setMetaProperty(
      "og:image",
      data.coverImage
    );

  }

  setMetaProperty(
    "og:type",
    "article"
  );

  setMetaProperty(
    "og:url",
    window.location.href
  );

  if (
    seo.canonicalUrl &&
    isSafeUrl(
      seo.canonicalUrl
    )
  ) {

    let canonical =
      document.querySelector(
        'link[rel="canonical"]'
      );

    if (!canonical) {

      canonical =
        document.createElement(
          "link"
        );

      canonical.rel =
        "canonical";

      document.head.appendChild(
        canonical
      );

    }

    canonical.href =
      seo.canonicalUrl;

  }

}


/* =========================================
   SET META
========================================= */

function setMeta(
  name,
  value
) {

  if (!value) return;

  let element =
    document.querySelector(
      `meta[name="${name}"]`
    );

  if (!element) {

    element =
      document.createElement(
        "meta"
      );

    element.name =
      name;

    document.head.appendChild(
      element
    );

  }

  element.content =
    value;

}


/* =========================================
   SET META PROPERTY
========================================= */

function setMetaProperty(
  property,
  value
) {

  if (!value) return;

  let element =
    document.querySelector(
      `meta[property="${property}"]`
    );

  if (!element) {

    element =
      document.createElement(
        "meta"
      );

    element.setAttribute(
      "property",
      property
    );

    document.head.appendChild(
      element
    );

  }

  element.content =
    value;

}


