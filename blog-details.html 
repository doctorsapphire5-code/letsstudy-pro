/* =========================================
   YEAR
========================================= */

yearElement.textContent =
  new Date().getFullYear();


/* =========================================
   DOCUMENT ID
========================================= */

const params =
  new URLSearchParams(
    window.location.search
  );

const documentId =
  params.get("id");


if(!documentId){

  showError(
    "No blog article was selected. Please open the article from Blog."
  );

}else{

  loadBlog(documentId);

}


/* =========================================
   LOAD BLOG
========================================= */

async function loadBlog(id){

  try{

    const reference =
      doc(
        db,
        "blogPosts",
        id
      );


    const snapshot =
      await getDoc(
        reference
      );


    if(!snapshot.exists()){

      showError(
        "The selected blog article could not be found."
      );

      return;

    }


    const data =
      snapshot.data() || {};


    const published =
      data.published === true ||
      data.published === "true";


    const status =
      String(
        data.status || ""
      ).toLowerCase();


    /*
      Do not expose obvious drafts/private posts.
    */

    if(
      !published &&
      status !== "published"
    ){

      showError(
        "This article is not currently available."
      );

      return;

    }


    renderBlog(
      data,
      id
    );


    /*
      View counter must never prevent
      the article from displaying.
    */

    recordView(
      reference
    );


  }catch(error){

    console.error(
      "Blog loading error:",
      error
    );


    showError(
      "Unable to load this article. Please try again later."
    );

  }

}


/* =========================================
   RENDER BLOG
========================================= */

function renderBlog(
  data,
  id
){

  const blogTitle =
    safeText(
      data.title
    ) ||
    safeText(
      data.seo?.title
    ) ||
    "LetsStudy Pro Blog";


  const blogExcerpt =
    safeText(
      data.excerpt
    ) ||
    "Read professional articles, guides and resources on LetsStudy Pro.";


  const blogCategory =
    safeText(
      data.category
    ) ||
    "General";


  const author =
    safeText(
      data.authorName
    ) ||
    safeText(
      data.author
    ) ||
    safeText(
      data.author?.name
    ) ||
    "LetsStudy Pro";


  const authorPhoto =
    safeUrl(
      data.authorPhoto
    ) ||
    safeUrl(
      data.authorImage
    ) ||
    safeUrl(
      data.author?.photo
    ) ||
    safeUrl(
      data.author?.image
    );


  title.textContent =
    blogTitle;


  excerpt.textContent =
    blogExcerpt;


  category.textContent =
    blogCategory;


  authorName.textContent =
    author;


  if(authorPhoto){

    const img =
      document.createElement(
        "img"
      );

    img.src =
      authorPhoto;

    img.alt =
      author;

    img.loading =
      "lazy";

    authorPhotoBox.textContent =
      "";

    authorPhotoBox.appendChild(
      img
    );

  }else{

    authorPhotoBox.textContent =
      initials(author);

  }


  renderMeta(
    data
  );


  renderCountry(
    data
  );


  renderCover(
    data,
    blogTitle
  );


  renderContent(
    data
  );


  renderImages(
    data
  );


  renderVideos(
    data
  );


  renderAudio(
    data
  );


  renderFiles(
    data
  );


  renderEmbeds(
    data
  );


  renderAI(
    data
  );


  renderTags(
    data
  );


  renderEngagement(
    data
  );


  updateSEO(
    data,
    blogTitle,
    blogExcerpt,
    id
  );


  loading.style.display =
    "none";

  article.style.display =
    "block";

}


/* =========================================
   META
========================================= */

function renderMeta(data){

  meta.innerHTML =
    "";


  const publishedAt =
    formatDate(
      data.publishedAt
    );


  const createdAt =
    formatDate(
      data.createdAt
    );


  const updatedAt =
    formatDate(
      data.updatedAt
    );


  const readingTime =
    data.readingTime ||
    data.readTime;


  const views =
    Number(
      data.views || 0
    );


  if(publishedAt){

  addMeta(
    "Published: " +
    publishedAt
  );

}else if(createdAt){

  addMeta(
    "Published: " +
    createdAt
  );

}


if(updatedAt){

  addMeta(
    "Updated: " +
    updatedAt
  );

}


if(readingTime){

  addMeta(
    String(readingTime).includes("min")
      ? String(readingTime)
      : String(readingTime) +
        " min read"
  );

}


if(views >= 0){

  addMeta(
    formatNumber(views) +
    " views"
  );

}


}


/* =========================================
   ADD META ITEM
========================================= */

