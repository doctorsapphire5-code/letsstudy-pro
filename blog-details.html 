  <script type="module">

    import {
      initializeApp
    } from
      "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";


    import {
      getFirestore,
      doc,
      getDoc,
      updateDoc,
      increment
    } from
      "https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";


    /* =========================
       FIREBASE
    ========================= */

    const firebaseConfig = {

      apiKey:
        "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

      authDomain:
        "let-s-study-pro-course.firebaseapp.com",

      databaseURL:
        "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

      projectId:
        "let-s-study-pro-course",

      storageBucket:
        "let-s-study-pro-course.firebasestorage.app",

      messagingSenderId:
        "474928293390",

      appId:
        "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

      measurementId:
        "G-85B7V5H5J0"

    };


    const app =
      initializeApp(
        firebaseConfig
      );


    const db =
      getFirestore(app);


    /* =========================
       ELEMENTS
    ========================= */

    const loading =
      document.getElementById(
        "loading"
      );

    const errorBox =
      document.getElementById(
        "error"
      );

    const article =
      document.getElementById(
        "article"
      );


    /* =========================
       BLOG ID
    ========================= */

    const params =
      new URLSearchParams(
        window.location.search
      );


    const blogId =
      params.get(
        "blogId"
      );


    if(!blogId){

      showError(
        "No blogId was provided."
      );

    }else{

      loadBlog(
        blogId
      );

    }


    /* =========================
       LOAD BLOG
    ========================= */

    async function loadBlog(
      id
    ){

      try{

        const reference =
          doc(
            db,
            "blogPosts",
            id
          );


        const snapshot =
          await getDoc(
            reference
          );


        if(!snapshot.exists()){

          showError(
            "This blog post does not exist."
          );

          return;

        }


        const data =
          snapshot.data();


        renderBlog(
          data,
          id
        );


        recordView(
          reference
        );


      }catch(error){

        console.error(
          error
        );


        showError(
          "Unable to load this blog post."
        );

      }

    }


    /* =========================
       RENDER BLOG
    ========================= */

    function renderBlog(
      data,
      id
    ){

      document.title =
        data.seo?.title ||
        data.title ||
        "Blog Details | LetsStudy Pro";


      const description =
        data.seo?.description ||
        data.excerpt ||
        "";


      setMeta(
        "description",
        description
      );


      setMetaProperty(
        "og:title",
        data.seo?.title ||
        data.title ||
        ""
      );


      setMetaProperty(
        "og:description",
        description
      );


      setMetaProperty(
        "og:image",
        data.seo?.ogImage ||
        data.coverImage ||
        ""
      );


      const canonical =
        data.seo?.canonicalUrl ||
        `https://letsstudy.pro/blog-details.html?blogId=${encodeURIComponent(
          id
        )}`;


      let canonicalElement =
        document.querySelector(
          'link[rel="canonical"]'
        );


      if(!canonicalElement){

        canonicalElement =
          document.createElement(
            "link"
          );

        canonicalElement.rel =
          "canonical";

        document.head.appendChild(
          canonicalElement
        );

      }


      canonicalElement.href =
        canonical;


      document.getElementById(
        "title"
      ).textContent =
        data.title ||
        "Untitled Article";


      document.getElementById(
        "excerpt"
      ).textContent =
        data.excerpt ||
        "";


      if(data.category){

        const category =
          document.getElementById(
            "category"
          );

        category.textContent =
          data.category;

        category.classList.remove(
          "hidden"
        );

      }


      renderMeta(
        data
      );


      if(data.coverImage){

        const cover =
          document.getElementById(
            "cover"
          );

        cover.src =
          data.coverImage;

        cover.alt =
          data.title ||
          "LetsStudy Pro article";

        cover.classList.remove(
          "hidden"
        );

      }


      document.getElementById(
        "content"
      ).innerHTML =
        sanitizeContent(
          data.content ||
          ""
        );


      renderImages(
        data.images
      );


      renderVideos(
        data.videos
      );


      renderAudios(
        data.audios
      );


      renderFiles(
        data.files
      );


      renderEmbeds(
        data.embeds
      );


      renderAI(
        data.aiEmbed
      );


      renderTags(
        data.tags
      );


      article.classList.remove(
        "hidden"
      );

      loading.classList.add(
        "hidden"
      );

    }


    /* =========================
       META
    ========================= */

    function renderMeta(
      data
    ){

      const meta =
        document.getElementById(
          "meta"
        );


      meta.innerHTML =
        "";


      if(data.authorName){

        addMeta(
          `Author: ${escapeHTML(
            data.authorName
          )}`
        );

      }


      if(data.language){

        addMeta(
          `Language: ${escapeHTML(
            data.language
          )}`
        );

      }


      if(data.views !== undefined){

        addMeta(
          `Views: ${Number(
            data.views || 0
          ).toLocaleString()}`
        );

      }


      if(data.publishedAt){

        const date =
          timestampToDate(
            data.publishedAt
          );


        if(date){

          addMeta(
            date.toLocaleDateString(
              undefined,
              {
                year:
                  "numeric",
                month:
                  "long",
                day:
                  "numeric"
              }
            )
          );

        }

      }

    }


    function addMeta(
      text
    ){

      const span =
        document.createElement(
          "span"
        );

      span.textContent =
        text;

      document.getElementById(
        "meta"
      ).appendChild(
        span
      );

    }


    /* =========================
       IMAGES
    ========================= */

    function renderImages(
      items
    ){

      if(!Array.isArray(items) ||
         !items.length){

        return;

      }


      const container =
        document.getElementById(
          "images"
        );


      items.forEach(
        item => {

          const url =
            typeof item ===
            "string"
              ? item
              : item?.url;


          if(!url){

            return;

          }


          const card =
            document.createElement(
              "div"
            );

          card.className =
            "media-card";


          const image =
            document.createElement(
              "img"
            );


          image.src =
            url;

          image.loading =
            "lazy";

          image.alt =
            item?.title ||
            "Article image";


          card.appendChild(
            image
          );


          if(item?.title){

            const title =
              document.createElement(
                "div"
              );

            title.className =
              "media-title";

            title.textContent =
              item.title;

            card.appendChild(
              title
            );

          }


          container.appendChild(
            card
          );

        }
      );


      document.getElementById(
        "imagesSection"
      ).classList.remove(
        "hidden"
      );

    }


    /* =========================
       VIDEOS
    ========================= */

    function renderVideos(
      items
    ){

      if(!Array.isArray(items) ||
         !items.length){

        return;

      }


      const container =
        document.getElementById(
          "videos"
        );


      items.forEach(
        item => {

          const url =
            typeof item ===
            "string"
              ? item
              : item?.url;


          if(!url){

            return;

          }


          const card =
            document.createElement(
              "div"
            );

          card.className =
            "media-card";


          const youtubeId =
            getYouTubeId(
              url
            );


          if(youtubeId){

            const iframe =
              document.createElement(
                "iframe"
              );

            iframe.src =
                            `https://www.youtube.com/embed/${youtubeId}`;

            iframe.loading =
              "lazy";

            iframe.title =
              item?.title ||
              "YouTube video";

            iframe.allow =
              "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";

            iframe.allowFullscreen =
              true;

            card.appendChild(
              iframe
            );

          } else {

            const video =
              document.createElement(
                "video"
              );

            video.src =
              url;

            video.controls =
              true;

            video.preload =
              "metadata";

            card.appendChild(
              video
            );

          }

          if(item?.title){

            const title =
              document.createElement(
                "div"
              );

            title.className =
              "media-title";

            title.textContent =
              item.title;

            card.appendChild(
              title
            );

          }

          container.appendChild(
            card
          );

        }
      );

      document
        .getElementById(
          "videosSection"
        )
        .classList.remove(
          "hidden"
        );

    }


    /* =========================
       AUDIO
    ========================= */

    function renderAudios(
      items
    ){

      if(
        !Array.isArray(items) ||
        !items.length
      ){

        return;

      }

      const container =
        document.getElementById(
          "audios"
        );

      items.forEach(
        item => {

          const url =
            typeof item === "string"
              ? item
              : item?.url;

          if(!url){

            return;

          }

          const card =
            document.createElement(
              "div"
            );

          card.className =
            "media-card";

          if(item?.title){

            const title =
              document.createElement(
                "div"
              );

            title.className =
              "media-title";

            title.textContent =
              item.title;

            card.appendChild(
              title
            );

          }

          const audio =
            document.createElement(
              "audio"
            );

          audio.src =
            url;

          audio.controls =
            true;

          audio.preload =
            "metadata";

          card.appendChild(
            audio
          );

          container.appendChild(
            card
          );

        }
      );

      document
        .getElementById(
          "audioSection"
        )
        .classList.remove(
          "hidden"
        );

    }


    /* =========================
       FILES
    ========================= */

    function renderFiles(
      items
    ){

      if(
        !Array.isArray(items) ||
        !items.length
      ){

        return;

      }

      const container =
        document.getElementById(
          "files"
        );

      items.forEach(
        item => {

          const url =
            typeof item === "string"
              ? item
              : item?.url;

          if(!url){

            return;

          }

          const card =
            document.createElement(
              "div"
            );

          card.className =
            "media-card";

          const title =
            document.createElement(
              "div"
            );

          title.className =
            "media-title";

          title.textContent =
            item?.title ||
            "Download Resource";

          const link =
            document.createElement(
              "a"
            );

          link.href =
            url;

          link.target =
            "_blank";

          link.rel =
            "noopener noreferrer";

          link.className =
            "resource-link";

          link.textContent =
            "Open Resource";

          card.appendChild(
            title
          );

          card.appendChild(
            link
          );

          container.appendChild(
            card
          );

        }
      );

      document
        .getElementById(
          "filesSection"
        )
        .classList.remove(
          "hidden"
        );

    }


    /* =========================
       INTERACTIVE EMBEDS
    ========================= */

    function renderEmbeds(
      items
    ){

      if(
        !Array.isArray(items) ||
        !items.length
      ){

        return;

      }

      const container =
        document.getElementById(
          "embeds"
        );

      items.forEach(
        item => {

          const url =
            typeof item === "string"
              ? item
              : item?.url;

          if(!url){

            return;

          }

          const card =
            document.createElement(
              "div"
            );

          card.className =
            "media-card";

          if(item?.title){

            const title =
              document.createElement(
                "div"
              );

            title.className =
              "media-title";

            title.textContent =
              item.title;

            card.appendChild(
              title
            );

          }

          const iframe =
            document.createElement(
              "iframe"
            );

          iframe.src =
            url;

          iframe.loading =
            "lazy";

          iframe.title =
            item?.title ||
            "Interactive content";

          iframe.allowFullscreen =
            true;

          card.appendChild(
            iframe
          );

          container.appendChild(
            card
          );

        }
      );

      document
        .getElementById(
          "embedsSection"
        )
        .classList.remove(
          "hidden"
        );

    }


    /* =========================
       AI EMBED
    ========================= */

    function renderAI(
      ai
    ){

      if(
        !ai ||
        ai.enabled !== true ||
        !ai.url
      ){

        return;

      }

      const section =
        document.getElementById(
          "aiSection"
        );

      const frame =
        document.getElementById(
          "aiFrame"
        );

      const title =
        document.getElementById(
          "aiTitle"
        );

      title.textContent =
        ai.title ||
        "Ask AI About This Article";

      frame.src =
        ai.url;

      frame.loading =
        "lazy";

      frame.style.height =
        `${Number(
          ai.height || 550
        )}px`;

      frame.allowFullscreen =
        ai.allowFullscreen !== false;

      section.classList.remove(
        "hidden"
      );

    }


    /* =========================
