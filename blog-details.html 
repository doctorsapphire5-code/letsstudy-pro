  line-height:1.15;
  color:#111827;
}

.excerpt{
  margin:0 0 22px;
  font-size:18px;
  color:#64748b;
}

.author-row{
  display:flex;
  align-items:center;
  gap:12px;
  margin-top:20px;
}

.author-photo{
  width:45px;
  height:45px;
  border-radius:50%;
  overflow:hidden;
  background:#e5e7eb;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
  color:#475569;
  flex-shrink:0;
}

.author-photo img{
  width:100%;
  height:100%;
