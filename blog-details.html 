    function renderAI(ai){

      if(!ai){

        return;

      }


      const enabled =
        ai.enabled === true ||
        ai.enabled === "true";


      if(
        !enabled ||
        !isSafeEmbedUrl(ai.url)
      ){

        return;

      }


      const section =
        document.getElementById(
          "aiSection"
        );


      const frame =
        document.getElementById(
          "aiFrame"
        );


      document.getElementById(
        "aiTitle"
      ).textContent =
        ai.title ||
        "AI Assistant";


      document.getElementById(
        "aiProvider"
      ).textContent =
        ai.provider ||
        "AI Assistant";


      frame.src =
        ai.url;


      frame.height =
        Math.min(
          Math.max(
            Number(ai.height) || 450,
            200
          ),
          1200
        );


      if(
        ai.allowFullscreen === false
      ){

        frame.removeAttribute(
          "allowfullscreen"
