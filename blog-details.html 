<script type="module">
import {initializeApp} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";
import {getFirestore,collection,doc,getDoc,getDocs,query,where,limit,updateDoc,increment}
  from "https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";

const db=getFirestore(initializeApp({
  apiKey:"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",
  authDomain:"let-s-study-pro-course.firebaseapp.com",
  projectId:"let-s-study-pro-course",
  storageBucket:"let-s-study-pro-course.firebasestorage.app",
  messagingSenderId:"474928293390",
  appId:"1:474928293390:web:2bcc2aebf2351c12a9fe5f"
}));

const $=s=>document.querySelector(s);
const app=$("#app");
const params=new URLSearchParams(location.search);
const key=(params.get("blogId")||params.get("id")||params.get("slug")||params.get("post")||"").trim();

const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const safe=u=>{try{const x=new URL(String(u||"").trim(),location.href);return /^https?:$/.test(x.protocol)?x.href:""}catch{return ""}};
const urls=a=>(Array.isArray(a)?a:[]).map(i=>safe(i&&i.url?i.url:i)).filter(Boolean);
const isPublished=p=>p.published===true||p.status==="published";
const pageUrl=id=>location.origin+location.pathname+"?blogId="+encodeURIComponent(id);

function toast(msg){const t=$("#toast");t.textContent=msg;t.classList.add("show");setTimeout(()=>t.classList.remove("show"),2200)}

function clean(html){
  const d=new DOMParser().parseFromString(html||"","text/html");
  d.querySelectorAll("script,style,object,embed,link,meta,base,form").forEach(e=>e.remove());
  d.querySelectorAll("*").forEach(e=>[...e.attributes].forEach(a=>{
    const n=a.name.toLowerCase();
    if(n.startsWith("on")||(["href","src","xlink:href"].includes(n)&&/^\s*(javascript|data):/i.test(a.value)))e.removeAttribute(a.name);
  }));
  d.querySelectorAll("iframe,img").forEach(e=>e.setAttribute("loading","lazy"));
  d.querySelectorAll("a[href]").forEach(a=>{if(/^https?:/i.test(a.getAttribute("href"))){a.target="_blank";a.rel="noopener"}});
  return d.body.innerHTML;
}

function videoHTML(u){
  let m=u.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{11})/);
  if(m)return `<div class="ratio"><iframe src="https://www.youtube.com/embed/${m[1]}" title="Video" allowfullscreen loading="lazy"></iframe></div>`;
  m=u.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  if(m)return `<div class="ratio"><iframe src="https://player.vimeo.com/video/${m[1]}" title="Video" allowfullscreen loading="lazy"></iframe></div>`;
  if(/\.(mp4|webm|ogg|mov)(\?|$)/i.test(u))return `<div class="ratio"><video src="${esc(u)}" controls preload="metadata"></video></div>`;
  return `<div class="ratio"><iframe src="${esc(u)}" title="Video" allowfullscreen loading="lazy"></iframe></div>`;
}

function fileName(u){
  try{return decodeURIComponent(new URL(u).pathname.split("/").filter(Boolean).pop()||"Download")}catch{return "Download"}
}

const section=(title,inner)=>inner?`<section class="sec"><h2>${title}</h2>${inner}</section>`:"";

function setMeta(attr,name,val){
  if(!val)return;
  let m=document.querySelector(`meta[${attr}="${name}"]`);
  if(!m){m=document.createElement("meta");m.setAttribute(attr,name);document.head.appendChild(m)}
  m.setAttribute("content",val);
}

function applySEO(p){
  const seo=p.seo||{};
  const title=seo.title||`${p.title} | LetsStudy Pro`;
  const desc=seo.description||p.excerpt||"";
  const img=safe(seo.ogImage||p.coverImage);
  let canon=safe(seo.canonicalUrl);
  if(!canon||/\/blog\.html\?/.test(canon))canon=pageUrl(p.blogId||p.id);
  document.title=title;
  document.documentElement.lang=p.language||"en";
  setMeta("name","description",desc);
  setMeta("name","keywords",(seo.keywords||[]).join(", "));
  setMeta("property","og:type","article");
  setMeta("property","og:title",title);
  setMeta("property","og:description",desc);
  setMeta("property","og:url",canon);
  setMeta("property","og:image",img);
  setMeta("name","twitter:card",img?"summary_large_image":"summary");
  setMeta("name","twitter:title",title);
  setMeta("name","twitter:description",desc);
  setMeta("name","twitter:image",img);
  let l=document.querySelector('link[rel="canonical"]');
  if(!l){l=document.createElement("link");l.rel="canonical";document.head.appendChild(l)}
  l.href=canon;
  const ld=document.createElement("script");
  ld.type="application/ld+json";
  ld.textContent=JSON.stringify({
    "@context":"https://schema.org","@type":"BlogPosting",
    headline:p.title,description:desc,image:img||undefined,
    datePublished:toDate(p.publishedAt||p.createdAt)?.toISOString(),
    dateModified:toDate(p.updatedAt)?.toISOString(),
    inLanguage:p.language||"en",mainEntityOfPage:canon,
    publisher:{"@type":"Organization",name:"LetsStudy Pro"}
  });
  document.head.appendChild(ld);
}

const toDate=t=>t&&t.toDate?t.toDate():(t&&t.seconds?new Date(t.seconds*1000):null);

function render(p){
  const id=p.blogId||p.id;
  const d=toDate(p.publishedAt||p.createdAt);
  const body=clean(p.content);
  const words=body.replace(/<[^>]*>/g," ").split(/\s+/).filter(Boolean).length;
  const mins=Math.max(1,Math.round(words/200));
  const liked=localStorage.getItem("liked_"+p.id)==="1";
  const cover=safe(p.coverImage);
  const ai=p.aiEmbed||{};
  const aiUrl=safe(ai.url);

  const images=urls(p.images),videos=urls(p.videos),audios=urls(p.audios),files=urls(p.files),embeds=urls(p.embeds);

  app.innerHTML=`
  <header class="col">
    <div class="chips">
      ${p.featured?`<span class="chip f">Featured</span>`:""}
      ${p.category?`<a class="chip" href="search.html?q=${encodeURIComponent(p.category)}">${esc(p.category)}</a>`:""}
    </div>
    <h1>${esc(p.title)}</h1>
    ${p.excerpt?`<p class="lead">${esc(p.excerpt)}</p>`:""}
    <div class="by"><span class="av">LS</span><div><b>LetsStudy Pro</b>
      <small>${d?esc(d.toLocaleDateString(p.language||"en",{year:"numeric",month:"long",day:"numeric"}))+", ":""}${mins} min read</small></div></div>
    <div class="bar">
      <button class="btn ${liked?"on":""}" id="likeBtn" type="button">${liked?"Liked":"Like"}</button>
      <button class="btn" id="shareBtn" type="button">Share</button>
      <button class="btn" id="copyBtn" type="button">Copy link</button>
      <span class="stats"><span id="views">${Number(p.views||0).toLocaleString()} views</span><span id="likesTxt">${Number(p.likes||0).toLocaleString()} likes</span></span>
    </div>
  </header>
  ${cover?`<figure class="cover"><img src="${esc(cover)}" alt="${esc(p.title)}"></figure>`:""}
  <div class="col">
    <details class="toc" id="toc" open hidden></details>
    <div class="prose">${body}</div>
    ${(p.tags||[]).length?`<div class="tags">${p.tags.map(t=>`<a href="search.html?q=${encodeURIComponent(t)}">#${esc(t)}</a>`).join("")}</div>`:""}
    ${section("Images",images.length?`<div class="gal">${images.map(u=>`<a href="${esc(u)}" target="_blank" rel="noopener"><img src="${esc(u)}" alt="" loading="lazy"></a>`).join("")}</div>`:"")}
    ${section("Videos",videos.map(videoHTML).join(""))}
    ${section("Audio",audios.map(u=>`<audio controls preload="none" src="${esc(u)}"></audio>`).join(""))}
    ${section("Resources",files.map(u=>`<a class="file" href="${esc(u)}" target="_blank" rel="noopener" download><span>${esc(fileName(u))}</span><b>Download</b></a>`).join(""))}
    ${section("Interactive",embeds.map(u=>`<iframe class="emb" src="${esc(u)}" title="Embedded content" loading="lazy" allowfullscreen></iframe>`).join(""))}
    ${ai.enabled&&aiUrl?section(esc(ai.title||"Ask AI About This Article"),
      `${ai.provider?`<p class="lead" style="font-size:14px">${esc(ai.provider)}</p>`:""}
       <iframe class="emb" style="height:${Math.max(350,Number(ai.height)||550)}px" src="${esc(aiUrl)}" title="${esc(ai.title||"AI")}" loading="lazy" ${ai.allowFullscreen!==false?"allowfullscreen":""} allow="clipboard-write${ai.allowFullscreen!==false?"; fullscreen":""}"></iframe>`):""}
    <div id="related"></div>
  </div>`;

  app.hidden=false;
  applySEO(p);
  wire(p,id);
  enhance();
}

function enhance(){
  const hs=[...document.querySelectorAll(".prose h2,.prose h3")];
  if(hs.length>=3){
    hs.forEach((h,i)=>h.id="s"+i);
    $("#toc").innerHTML=`<summary>In this article</summary><ol>${hs.map((h,i)=>`<li class="${h.tagName.toLowerCase()}"><a href="#s${i}">${esc(h.textContent)}</a></li>`).join("")}</ol>`;
    $("#toc").hidden=false;
  }
  const lb=$("#lb");
  document.addEventListener("click",e=>{
    const t=e.target;
    if(t.matches&&t.matches(".prose img,.gal img")){e.preventDefault();lb.querySelector("img").src=t.currentSrc||t.src;lb.classList.add("show")}
    else if(lb.contains(t))lb.classList.remove("show");
  });
  addEventListener("keydown",e=>{if(e.key==="Escape")lb.classList.remove("show")});
  const bar=$("#prog"),upd=()=>{const h=document.documentElement;bar.style.width=Math.min(100,h.scrollTop/((h.scrollHeight-h.clientHeight)||1)*100)+"%"};
  addEventListener("scroll",upd,{passive:true});upd();
}

function wire(p,id){
  const ref=doc(db,"blogPosts",p.id);
  const url=pageUrl(id);
  let likes=Number(p.likes||0);

  $("#likeBtn").onclick=async e=>{
    const btn=e.currentTarget,was=localStorage.getItem("liked_"+p.id)==="1";
    const delta=was?-1:1;
    likes=Math.max(0,likes+delta);
    was?localStorage.removeItem("liked_"+p.id):localStorage.setItem("liked_"+p.id,"1");
    btn.classList.toggle("on",!was);btn.textContent=was?"Like":"Liked";
    $("#likesTxt").textContent=likes.toLocaleString()+" likes";
    try{await updateDoc(ref,{likes:increment(delta)})}catch(err){console.warn(err)}
  };

  const counted=()=>updateDoc(ref,{shares:increment(1)}).catch(console.warn);

  $("#shareBtn").onclick=async()=>{
    if(navigator.share){
      try{await navigator.share({title:p.title,text:p.excerpt||"",url});counted()}catch{}
    }else{await copy(url);counted()}
  };
  $("#copyBtn").onclick=()=>copy(url);

  async function copy(t){
    try{await navigator.clipboard.writeText(t)}
    catch{const i=document.createElement("input");i.value=t;document.body.appendChild(i);i.select();document.execCommand("copy");i.remove()}
    toast("Link copied");
  }

  if(!sessionStorage.getItem("viewed_"+p.id)){
    sessionStorage.setItem("viewed_"+p.id,"1");
    updateDoc(ref,{views:increment(1)}).then(()=>{
      $("#views").textContent=(Number(p.views||0)+1).toLocaleString()+" views";
    }).catch(console.warn);
  }
}

async function related(p){
  if(!p.category)return;
  try{
    const s=await getDocs(query(collection(db,"blogPosts"),where("category","==",p.category),limit(8)));
    const list=s.docs.map(x=>({id:x.id,...x.data()})).filter(x=>x.id!==p.id&&isPublished(x)).slice(0,3);
    if(!list.length)return;
    $("#related").innerHTML=section("More in "+esc(p.category),`<div class="rel">${list.map(x=>{
      const c=safe(x.coverImage);
      return `<a href="blog-details.html?blogId=${encodeURIComponent(x.blogId||x.id)}">${c?`<img src="${esc(c)}" alt="" loading="lazy">`:""}<span>${esc(x.title||"Untitled")}</span></a>`;
    }).join("")}</div>`);
  }catch(e){console.warn(e)}
}

async function find(){
  if(!key)return null;
  try{
    const s=await getDoc(doc(db,"blogPosts",key));
    if(s.exists())return {id:s.id,...s.data()};
  }catch(e){console.warn(e)}
  try{
    const q=await getDocs(query(collection(db,"blogPosts"),where("slug","==",key),limit(1)));
    if(!q.empty)return {id:q.docs[0].id,...q.docs[0].data()};
  }catch(e){console.warn(e)}
  return null;
}

function missing(){
  document.title="Article not found | LetsStudy Pro";
  setMeta("name","robots","noindex");
  app.innerHTML=`<div class="card miss"><h1>Article not found</h1>
    <p class="lead">This article is unavailable or the link is incorrect.</p>
    <p><a href="blog.html">Browse all articles</a> &nbsp;|&nbsp; <a href="search.html">Search</a></p></div>`;
  app.hidden=false;
}

const post=await find();
if(post&&isPublished(post)){render(post);related(post)}else missing();
