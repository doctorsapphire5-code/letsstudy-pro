    function timestampToDate(
      value
    ){

      if(!value){

        return null;

      }


      if(
        typeof value.toDate ===
        "function"
      ){

        return value.toDate();

      }


      if(
        value.seconds !==
        undefined
      ){

        return new Date(
          Number(
            value.seconds
          ) * 1000
        );

      }


      const date =
        new Date(value);


      if(
        Number.isNaN(
          date.getTime()
        )
      ){

        return null;

      }


      return date;

    }


