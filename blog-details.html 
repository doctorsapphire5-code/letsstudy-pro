}

.topbar{
  position:sticky;
  top:0;
  z-index:1000;
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  box-shadow:0 2px 10px rgba(0,0,0,.04);
}

.topbar-inner{
  max-width:1180px;
  margin:auto;
  padding:15px 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.brand{
  font-size:22px;
  font-weight:800;
  color:#111827;
}

.brand span{
  color:#2563eb;
}

.back-btn{
  display:inline-flex;
  align-items:center;
  gap:7px;
  padding:9px 15px;
  border:1px solid #dbe2ea;
  border-radius:9px;
  background:#fff;
  color:#1f2937;
  font-weight:700;
  transition:.2s;
}

.back-btn:hover{
  background:#f3f6fa;
  transform:translateY(-1px);
}

.container{
  max-width:1000px;
  margin:0 auto;
  padding:35px 18px 60px;
}

.loading{
  min-height:300px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  color:#64748b;
  font-size:18px;
  font-weight:600;
}

.spinner{
  width:30px;
  height:30px;
  border:3px solid #dbeafe;
  border-top-color:#2563eb;
  border-radius:50%;
  animation:spin .8s linear infinite;
  margin:0 auto 12px;
}

@keyframes spin{
  to{
    transform:rotate(360deg);
  }
}

.error-box{
  display:none;
  margin:40px auto;
  max-width:800px;
  padding:22px;
  border-radius:12px;
  background:#fff1f2;
  border:1px solid #fecdd3;
  color:#9f1239;
}

.article{
  display:none;
}

.hero{
  background:#fff;
  border-radius:18px;
  padding:35px;
  border:1px solid #e5e7eb;
