}

.ai-title{
  font-weight:800;
  color:#111827;
}

.ai-provider{
  color:#64748b;
  font-size:13px;
  margin-top:2px;
}

.ai-frame{
  width:100%;
  min-height:500px;
  border:0;
  display:block;
}

.tags{
  display:flex;
  flex-wrap:wrap;
  gap:9px;
}

.tag{
  padding:7px 11px;
  background:#eff6ff;
  color:#1d4ed8;
  border-radius:999px;
  font-size:13px;
  font-weight:700;
}

.engagement{
  display:flex;
  flex-wrap:wrap;
  gap:15px;
  margin-top:18px;
  color:#64748b;
  font-size:14px;
}

.share-grid{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
}

.share-btn{
  border:1px solid #dbe2ea;
  background:#fff;
  color:#1f2937;
  border-radius:9px;
  padding:10px 14px;
  cursor:pointer;
  font-weight:700;
  transition:.2s;
}

.share-btn:hover{
  background:#f3f6fa;
  transform:translateY(-1px);
}

footer{
  background:#111827;
  color:#cbd5e1;
  text-align:center;
  padding:28px 18px;
}

footer a{
  color:#fff;
  font-weight:700;
}

.empty{
  padding:20px;
  background:#f8fafc;
  border:1px dashed #cbd5e1;
  border-radius:12px;
  color:#64748b;
}

@media(max-width:700px){
  .topbar-inner{
    padding:12px 14px;
  }

  .brand{
    font-size:19px;
  }

  .back-btn{
    padding:8px 11px;
    font-size:13px;
  }

  .container{
    padding:22px 12px 45px;
  }

  .hero,
  .section{
    padding:21px;
    border-radius:14px;
  }

  .article-title{
    font-size:31px;
  }

  .excerpt{
    font-size:16px;
  }

  .file-item{
    align-items:flex-start;
    flex-direction:column;
  }

  .file-button{
    width:100%;
    justify-content:center;
  }

  .content iframe,
  .ai-frame{
    min-height:300px;
  }

  .embed-card iframe{
    min-height:300px;
  }
}
</style>
</head>

