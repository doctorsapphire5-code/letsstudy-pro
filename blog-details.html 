    function renderVideos(items){

      if(
        !Array.isArray(items) ||
        !items.length
      ){

        return;

      }


      const container =
        document.getElementById(
          "videos"
        );


      container.innerHTML = "";


      items.forEach(
        (item) => {

          const url =
            typeof item === "string"
              ? item
              : item?.url;


          const title =
            typeof item === "object"
              ? item?.title || "Video"
              : "Video";


          if(
            !isSafeUrl(url)
          ){

            return;

          }


          const card =
            document.createElement(
              "div"
