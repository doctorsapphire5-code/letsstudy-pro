    .section h2 {
      margin-bottom: 18px;
      font-size: 24px;
    }

    .media-grid {
      display: grid;
      grid-template-columns:
        repeat(auto-fit, minmax(240px, 1fr));
      gap: 18px;
    }

    .media-card {
      background: #f7f9fc;
      border: 1px solid #e6eaf0;
      border-radius: 14px;
      padding: 16px;
    }

    .media-card img {
      width: 100%;
      max-height: 280px;
      object-fit: cover;
      border-radius: 10px;
    }

    .media-card video {
      width: 100%;
      border-radius: 10px;
    }

    .media-card audio {
      width: 100%;
    }

    .media-card iframe {
