}

.embed-card{
  overflow:hidden;
}

.embed-card iframe{
  width:100%;
  min-height:450px;
  border:0;
  border-radius:12px;
}

.ai-box{
  background:#f8fafc;
  border:1px solid #dbe2ea;
  border-radius:14px;
  overflow:hidden;
}

.ai-header{
  padding:15px 18px;
