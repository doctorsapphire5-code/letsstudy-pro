  margin-top:28px;
}

.content img{
  max-width:100%;
  height:auto;
  border-radius:12px;
}

.content iframe{
  width:100%;
  min-height:420px;
  border:0;
  border-radius:12px;
}

.content table{
  width:100%;
  border-collapse:collapse;
  overflow:auto;
  display:block;
}

.content th,
.content td{
  border:1px solid #e5e7eb;
  padding:10px;
}

.media-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:18px;
}

.media-card{
  border:1px solid #e5e7eb;
  border-radius:14px;
  overflow:hidden;
  background:#f8fafc;
}

.media-card img,
.media-card video,
.media-card iframe{
  display:block;
