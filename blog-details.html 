      function setMeta(
        name,
        content
      ){

        if(
          !content
        ){

          return;

        }


        let element =
          document.querySelector(
            `meta[name="${name}"]`
          );


        if(
          !element
        ){

          element =
            document.createElement(
              "meta"
            );

          element.setAttribute(
            "name",
