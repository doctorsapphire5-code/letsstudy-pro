<script type="module">

import {
  initializeApp
} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";

import {
  getFirestore,
  doc,
  getDoc,
  updateDoc,
  increment
} from "https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";


/* =========================================
   FIREBASE CONFIG
========================================= */

const firebaseConfig = {

  apiKey:
    "AIzaSyBcOYDfAVKXbjsyRgI_0rjodBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-85B7V5H5J0"

};


const app = initializeApp(firebaseConfig);

const db = getFirestore(app);


/* =========================================
   ELEMENTS
========================================= */

const loading =
  document.getElementById("loading");

const errorBox =
  document.getElementById("errorBox");

const article =
  document.getElementById("article");


/* =========================================
   DIRECT FIRESTORE DOCUMENT ID
=========================================

   blog.html must send:

   blog-details.html?blogId=FIRESTORE_DOCUMENT_ID

   Example:

   blog-details.html?blogId=fowjoz

   The value is used DIRECTLY here:

   doc(db,"blogPosts",id)

   No API.
   No slug lookup.
   No where().
========================================= */

const params =
  new URLSearchParams(window.location.search);

const blogId =
  params.get("blogId");


if(!blogId){

  showError(
    "No blog ID was provided. Please open this article from blog.html."
  );

}else{

  loadBlog(blogId);

}


/* =========================================
   LOAD BLOG DIRECTLY BY FIRESTORE ID
========================================= */

async function loadBlog(id){

  try{

    console.log(
      "Loading blog document:",
      id
    );


    /*
      IMPORTANT:

      id is the actual Firestore document ID.

      Example:

      blogPosts
        └── fowjoz

      Therefore:

      doc(db,"blogPosts","fowjoz")
    */

    const reference =
      doc(db,"blogPosts",id);


    const snapshot =
      await getDoc(reference);


    console.log(
      "Document exists:",
      snapshot.exists()
    );


    if(!snapshot.exists()){

      showError(
        "This blog post does not exist in Firestore. Document ID: " +
        id
      );

      return;

    }


    const data =
      snapshot.data();


    console.log(
      "Blog data:",
      data
    );


    renderBlog(
      data,
      id
    );


    /*
      View counter is OPTIONAL.
      If Firestore rules don't allow public updates,
      it will not stop the article from loading.
    */

    recordView(reference);


  }catch(error){

    console.error(
      "Blog loading error:",
      error
    );


    showError(
      "Unable to load this article. " +
      (error?.message || "Please try again.")
    );

  }

}


/* =========================================
   RENDER BLOG
========================================= */

function renderBlog(
  data,
  id
){

  try{

    const title =
      data.title ||
      "Untitled Blog Post";


    const description =
      data.excerpt ||
      data.seo?.description ||
      "";


    /* SEO */

    document.title =
      data.seo?.title ||
      title +
      " | LetsStudy Pro";


    setMeta(
      "description",
      description
    );


    setMetaProperty(
      "og:title",
      title
    );


    setMetaProperty(
      "og:description",
      description
    );


    setMetaProperty(
      "og:type",
      "article"
    );


    setMetaProperty(
      "og:url",
      window.location.href
    );


    setMetaProperty(
      "og:image",
      data.seo?.ogImage ||
      data.coverImage ||
      "https://letsstudy.pro/favicon.jpg"
    );


    setMeta(
      "twitter:title",
      title
    );


    setMeta(
      "twitter:description",
      description
    );


    setMeta(
      "twitter:image",
      data.seo?.ogImage ||
      data.coverImage ||
      "https://letsstudy.pro/favicon.jpg"
    );


    /* Canonical */

    let canonical =
      document.querySelector(
        'link[rel="canonical"]'
      );


    if(!canonical){

      canonical =
        document.createElement("link");

      canonical.rel =
        "canonical";

      document.head.appendChild(
        canonical
      );

    }


    canonical.href =
      data.seo?.canonicalUrl ||
      window.location.href;


    /* Basic fields */

    document.getElementById(
      "category"
    ).textContent =
      data.category ||
      "General";


    document.getElementById(
      "title"
    ).textContent =
      title;


    document.getElementById(
      "excerpt"
    ).textContent =
      description;


    renderAuthor(data);

    renderMeta(data);

    renderCover(data);

    document.getElementById(
      "content"
    ).innerHTML =
      sanitizeContent(
        data.content ||
        "<p>No article content available.</p>"
      );


    renderImages(
      data.images
    );


    renderVideos(
      data.videos
    );


    renderAudios(
      data.audios
    );


    renderFiles(
      data.files
    );


    renderEmbeds(
      data.embeds
    );


    renderAI(
      data.aiEmbed
    );


    renderTags(
      data.tags
    );


    /* Engagement */

    document.getElementById(
      "engagement"
    ).innerHTML = "";


    addMeta(
      "Views: " +
      formatNumber(
        data.views
      )
    );


    addMeta(
      "Likes: " +
      formatNumber(
        data.likes
      )
    );


    addMeta(
      "Shares: " +
      formatNumber(
        data.shares
      )
    );


    addMeta(
      "Comments: " +
      formatNumber(
        data.commentsCount
      )
    );


    setupSharing(
      title
    );


    loading.style.display =
      "none";


    article.style.display =
      "block";


  }catch(error){

    console.error(
      "Render error:",
      error
    );


    showError(
      "The article was found, but it could not be displayed."
    );

  }

}


/* =========================================
   AUTHOR
========================================= */

function renderAuthor(data){

  const photoBox =
    document.getElementById(
      "authorPhotoBox"
    );


  const authorName =
    document.getElementById(
      "authorName"
    );


  const name =
    data.authorName ||
    "LetsStudy Pro";


  authorName.textContent =
    name;


  photoBox.innerHTML =
    "";


  if(
    data.authorPhoto &&
    isSafeUrl(data.authorPhoto)
  ){

    const img =
      document.createElement("img");


    img.src =
      data.authorPhoto;


    img.alt =
      name;


    img.loading =
      "lazy";


    img.referrerPolicy =
      "no-referrer";


    photoBox.appendChild(
      img
    );

  }else{

    photoBox.textContent =
      name
        .trim()
        .charAt(0)
        .toUpperCase() ||
      "L";

  }

}


/* =========================================
   META
========================================= */

function renderMeta(data){

  const meta =
    document.getElementById(
      "meta"
    );


  const items = [];


  const published =
    timestampToDate(
      data.publishedAt
    );


  const created =
    timestampToDate(
      data.createdAt
    );


  if(published){

    items.push(
      "Published " +
      published.toLocaleDateString(
        undefined,
        {
          year:"numeric",
          month:"long",
          day:"numeric"
        }
      )
    );

  }else if(created){

    items.push(
      created.toLocaleDateString(
        undefined,
        {
          year:"numeric",
          month:"long",
          day:"numeric"
        }
      )
    );

  }


  if(data.language){

    items.push(
      "Language: " +
      data.language
    );

  }


  if(data.status){

    items.push(
      data.status
    );

  }


  meta.textContent =
    items.join(" • ");


  const countryTarget =
    document.getElementById(
      "countryTarget"
    );

  const countries =
    Array.isArray(
      data.countryTarget
    )
      ? data.countryTarget
      : [];

  if(countries.length){

    countryTarget.textContent =
      "Target: " +
      countries.join(", ");

  }else{

    countryTarget.textContent =
      "";

  }

}


/* =========================================
   COVER IMAGE
========================================= */

function renderCover(data){

  const section =
    document.getElementById(
      "coverSection"
    );

  const image =
    document.getElementById(
      "coverImage"
    );

  const cover =
    data.coverImage ||
    data.seo?.ogImage ||
    "";

  if(
    cover &&
    isSafeUrl(cover)
  ){

    image.src =
