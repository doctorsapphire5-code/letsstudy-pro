}

.author-name{
  font-weight:800;
  color:#111827;
}

.meta{
  margin-top:3px;
  color:#64748b;
  font-size:14px;
}

.meta-list{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}

.meta-item{
  display:inline-flex;
  align-items:center;
}

.cover{
  margin-top:25px;
  background:#fff;
  border-radius:18px;
  overflow:hidden;
  border:1px solid #e5e7eb;
}

.cover img{
  width:100%;
  max-height:560px;
  object-fit:cover;
  display:block;
}

.section{
  margin-top:25px;
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:18px;
  padding:28px;
  box-shadow:0 6px 24px rgba(15,23,42,.04);
}

.section h2{
  margin:0 0 20px;
