      margin: 15px 0;
    }

    .content video,
    .content iframe {
      max-width: 100%;
    }

    .content blockquote {
      margin: 25px 0;
      padding: 18px 22px;
      border-left: 4px solid #2563eb;
      background: #f4f7fb;
    }

    .content pre {
      overflow-x: auto;
      background: #111827;
      color: #fff;
      padding: 18px;
      border-radius: 10px;
    }

    .section {
      margin-top: 35px;
