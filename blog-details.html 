function setupSharing(title){

  const currentUrl =
    window.location.href;


  document.getElementById(
    "copyLink"
  ).onclick =
    async ()=>{

      try{

        await navigator.clipboard.writeText(
          currentUrl
        );

        const button =
          document.getElementById(
            "copyLink"
          );

        const original =
          button.textContent;

        button.textContent =
          "Copied!";

        setTimeout(
          ()=>{
            button.textContent =
              original;
          },
          1600
        );

      }catch{

        window.prompt(
          "Copy this article link:",
          currentUrl
        );

      }

    };


  document.getElementById(
    "facebookShare"
  ).onclick =
    ()=>{

      const shareUrl =
        "https://www.facebook.com/sharer/sharer.php?u=" +
        encodeURIComponent(
          currentUrl
        );

      openShareWindow(
        shareUrl
      );

    };


  document.getElementById(
    "linkedinShare"
  ).onclick =
    ()=>{

      const shareUrl =
        "https://www.linkedin.com/sharing/share-offsite/?url=" +
        encodeURIComponent(
          currentUrl
        );

      openShareWindow(
        shareUrl
      );

    };


  document.getElementById(
    "whatsappShare"
  ).onclick =
