<style>
:root{--p:#2563eb;--ink:#0f172a;--text:#1f2937;--muted:#64748b;--bg:#f6f8fb;--paper:#fff;--line:#e2e8f0;--soft:#eef2f8}
@media(prefers-color-scheme:dark){:root{--p:#60a5fa;--ink:#f1f5f9;--text:#d5dcea;--muted:#94a3b8;--bg:#0b1220;--paper:#111a2e;--line:#22304a;--soft:#17223a}}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--bg);color:var(--text);line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:var(--p)}
:focus-visible{outline:3px solid var(--p);outline-offset:3px;border-radius:4px}
#prog{position:fixed;top:0;left:0;height:3px;width:0;background:var(--p);z-index:99}
.hd{background:#0f172a;position:sticky;top:0;z-index:50}
.hd>div{width:min(1100px,92%);margin:auto;min-height:62px;display:flex;align-items:center;justify-content:space-between}
.brand{color:#fff;font-weight:800;font-size:20px;text-decoration:none}
.brand span{color:#60a5fa}
.hd nav a{color:#cbd5e1;text-decoration:none;font-weight:600;font-size:14px;margin-left:18px}
.hd nav a:hover{color:#fff}
.wrap{width:min(1000px,92%);margin:0 auto;padding:44px 0 70px}
.col{width:min(700px,100%);margin-inline:auto}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
.chip{background:var(--soft);color:var(--p);border-radius:6px;padding:4px 10px;font-size:13px;font-weight:700;text-decoration:none}
.chip.f{background:#fef3c7;color:#92400e}
h1{font-size:clamp(32px,6vw,54px);line-height:1.08;letter-spacing:-.025em;font-weight:800;color:var(--ink);margin:0 0 16px;text-wrap:balance}
.lead{font-size:clamp(18px,2.4vw,21px);color:var(--muted);line-height:1.5;margin:0 0 24px}
.by{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.av{width:42px;height:42px;border-radius:50%;background:var(--p);color:#fff;display:grid;place-items:center;font-weight:800;font-size:14px;flex:none}
.by b{display:block;color:var(--ink);font-size:15px;line-height:1.25}
.by small{color:var(--muted);font-size:13px}
.bar{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:14px 0;border-block:1px solid var(--line)}
.btn{border:1px solid var(--line);border-radius:999px;padding:8px 16px;font:inherit;font-size:14px;font-weight:700;background:var(--paper);color:var(--ink);cursor:pointer}
.btn:hover{border-color:var(--p)}
.btn.on{background:var(--p);border-color:var(--p);color:#fff}
.stats{margin-left:auto;display:flex;gap:14px;color:var(--muted);font-size:13px}
.cover{margin:36px 0 0}
.cover img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:20px;display:block;background:var(--soft)}
.toc{margin-top:34px;padding:16px 20px;background:var(--paper);border:1px solid var(--line);border-radius:12px}
.toc summary{font-weight:800;color:var(--ink);cursor:pointer}
.toc ol{margin:12px 0 0;padding-left:20px}
.toc li{margin:6px 0}
.toc li.h3{margin-left:16px;list-style:circle}
.toc a{color:var(--text);text-decoration:none}
.toc a:hover{color:var(--p)}
.prose{font:19px/1.78 Charter,"Iowan Old Style","Palatino Linotype",Georgia,serif;color:var(--text);margin-top:36px;overflow-wrap:anywhere}
.prose>:first-child{margin-top:0}
.prose p{margin:0 0 1.35em}
.prose h2,.prose h3{font-family:Inter,system-ui,sans-serif;color:var(--ink);line-height:1.25;letter-spacing:-.015em;margin:2em 0 .6em;scroll-margin-top:84px}
.prose h2{font-size:30px}
.prose h3{font-size:23px}
.prose img,.prose video,.prose iframe{max-width:100%;border-radius:12px}
.prose img{cursor:zoom-in;height:auto}
.prose blockquote{margin:1.6em 0;padding:0 0 0 22px;border-left:4px solid var(--p);font-size:1.12em;font-style:italic;color:var(--ink)}
.prose pre{background:#0f172a;color:#e2e8f0;padding:16px;border-radius:12px;overflow:auto;font-size:15px;line-height:1.6}
.prose code{background:var(--soft);padding:2px 6px;border-radius:5px;font-size:.88em}
.prose pre code{background:none;padding:0}
.prose table{border-collapse:collapse;display:block;overflow-x:auto;font:15px/1.5 Inter,system-ui,sans-serif}
.prose td,.prose th{border:1px solid var(--line);padding:9px 12px}
.prose a{text-underline-offset:3px}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:34px}
.tags a{border:1px solid var(--line);border-radius:999px;padding:5px 13px;font-size:14px;text-decoration:none;color:var(--text);background:var(--paper)}
.tags a:hover{border-color:var(--p);color:var(--p)}
.sec{margin-top:56px;padding-top:28px;border-top:1px solid var(--line)}
.sec>h2{font-size:22px;margin:0 0 18px;color:var(--ink);letter-spacing:-.01em}
.gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}
.gal img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:12px;display:block;cursor:zoom-in}
.ratio{position:relative;padding-top:56.25%;margin-bottom:14px}
.ratio iframe,.ratio video{position:absolute;inset:0;width:100%;height:100%;border:0;border-radius:12px;background:#000}
.emb{width:100%;height:480px;border:0;border-radius:12px;margin-bottom:14px;background:var(--paper)}
audio{width:100%;margin-bottom:12px}
.file{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 16px;background:var(--paper);border:1px solid var(--line);border-radius:12px;margin-bottom:10px;text-decoration:none;color:var(--ink);font-weight:600;overflow-wrap:anywhere}
.file:hover{border-color:var(--p)}
.file b{color:var(--p);white-space:nowrap}
.rel{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:20px}
.rel a{text-decoration:none;color:var(--ink);font-weight:700;line-height:1.35}
.rel img{width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:12px;display:block;margin-bottom:10px}
.card{background:var(--paper);border:1px solid var(--line);border-radius:16px}
.miss{text-align:center;padding:56px 20px}
#lb{position:fixed;inset:0;background:rgba(2,6,23,.92);display:none;align-items:center;justify-content:center;z-index:200;padding:20px;cursor:zoom-out}
#lb.show{display:flex}
#lb img{max-width:100%;max-height:100%;border-radius:8px}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:#0f172a;color:#fff;padding:11px 18px;border-radius:10px;font-weight:700;font-size:14px;opacity:0;pointer-events:none;transition:opacity .2s;z-index:300}
.toast.show{opacity:1}
footer{border-top:1px solid var(--line);background:var(--paper);padding:30px 0;text-align:center;color:var(--muted);font-size:14px}
@media(max-width:600px){.prose{font-size:18px}.prose h2{font-size:26px}.emb{height:380px}.hd nav a{margin-left:12px}.wrap{padding-top:28px}.stats{margin-left:0;width:100%}}
@media print{.hd,.bar,#prog,.toc,footer,.emb{display:none}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
</style>
</head>
