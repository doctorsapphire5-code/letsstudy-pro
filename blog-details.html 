}

.audio-card{
  padding:16px;
  border:1px solid #e5e7eb;
  border-radius:12px;
  background:#f8fafc;
}

.audio-card audio{
  width:100%;
}

.file-list{
  display:grid;
  gap:12px;
}

.file-item{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  padding:15px;
  border:1px solid #e5e7eb;
  border-radius:12px;
