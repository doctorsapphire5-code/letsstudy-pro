  <script type="module">

    import {
      initializeApp
    } from
      "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";


    import {
      getFirestore,
      doc,
      getDoc,
      updateDoc,
      increment
    } from
      "https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";


    const firebaseConfig = {

      apiKey:
        "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

      authDomain:
        "let-s-study-pro-course.firebaseapp.com",

      databaseURL:
        "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

      projectId:
        "let-s-study-pro-course",

      storageBucket:
        "let-s-study-pro-course.firebasestorage.app",

      messagingSenderId:
        "474928293390",

      appId:
        "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

      measurementId:
        "G-85B7V5H5J0"

    };


    const app =
      initializeApp(
        firebaseConfig
      );


    const db =
      getFirestore(
        app
      );


    const loading =
      document.getElementById(
        "loading"
      );

    const errorBox =
      document.getElementById(
        "errorBox"
      );

    const article =
      document.getElementById(
        "article"
      );


    const params =
      new URLSearchParams(
        window.location.search
      );


    /*
     * IMPORTANT:
     * The URL must contain the
     * Firestore document ID.
     *
     * Example:
     * blog-details.html?blogId=abc123
     */

    const blogId =
      params.get(
        "blogId"
      );


    if(
      !blogId
    ){

      showError(
        "No blog ID was provided."
      );

    }else{

      loadBlog(
        blogId
      );

    }


    async function loadBlog(
      id
    ){

      try{

        /*
         * Direct Firestore document:
         *
         * blogPosts/{documentId}
         */

        const reference =
          doc(
            db,
            "blogPosts",
            id
          );


        const snapshot =
          await getDoc(
            reference
          );


        if(
          !snapshot.exists()
        ){

          showError(
            "This blog post does not exist."
          );

          return;

        }


        const data =
          snapshot.data();


        /*
         * Public page should only
         * display published posts.
         */

        const published =
          data.published === true ||
          data.published === "true";


        const status =
          String(
            data.status ||
            ""
          ).toLowerCase();


        if(
          !published &&
          status !== "published"
        ){

          showError(
            "This blog post is not currently available."
          );

          return;

        }


        renderBlog(
          data,
          id
        );


        recordView(
          reference
        );


      }catch(error){

        console.error(
          "Blog details error:",
          error
        );


        showError(
          "Unable to load this blog post. Please try again later."
        );

      }

    }


    function renderBlog(
      data,
      id
    ){

      const title =
        data.seo?.title ||
        data.title ||
        "LetsStudy Pro Blog";


      const description =
        data.seo?.description ||
        data.excerpt ||
        "Read professional articles on LetsStudy Pro.";


      document.title =
        title;


      setMeta(
        "description",
        description
      );


      setMetaProperty(
        "og:title",
        title
      );


      setMetaProperty(
        "og:description",
        description
      );


      setMetaProperty(
        "og:url",
        window.location.href
      );


      const ogImage =
        data.seo?.ogImage ||
        data.coverImage ||
        "";


      if(
        ogImage &&
        isSafeUrl(
          ogImage
        )
      ){

        setMetaProperty(
          "og:image",
          ogImage
        );

      }


      const canonical =
        data.seo?.canonicalUrl ||
        `https://letsstudy.pro/blog-details.html?blogId=${encodeURIComponent(id)}`;


              let canonicalElement =
          document.querySelector(
            'link[rel="canonical"]'
          );


        if(!canonicalElement){

          canonicalElement =
            document.createElement("link");

          canonicalElement.rel =
            "canonical";

          document.head.appendChild(
            canonicalElement
          );

        }


        canonicalElement.href =
          data.seo?.canonicalUrl ||
          `https://letsstudy.pro/blog-details.html?blogId=${encodeURIComponent(id)}`;


        setMeta(
          "description",
          data.seo?.description ||
          data.excerpt ||
          ""
        );


        setMetaProperty(
          "og:title",
          data.seo?.title ||
          data.title ||
          "LetsStudy Pro Blog"
        );


        setMetaProperty(
          "og:description",
          data.seo?.description ||
          data.excerpt ||
          ""
        );


        if(data.seo?.ogImage || data.coverImage){

          setMetaProperty(
            "og:image",
            data.seo?.ogImage ||
            data.coverImage
          );

        }


        setMetaProperty(
          "og:url",
          window.location.href
        );


        document.getElementById(
          "category"
        ).textContent =
          data.category ||
          "General";


        document.getElementById(
          "title"
        ).textContent =
          data.title ||
          "Untitled Article";


        document.getElementById(
          "excerpt"
        ).textContent =
          data.excerpt ||
          "";


        renderAuthor(data);


        renderMeta(data);


        const cover =
          document.getElementById(
            "coverImage"
          );


        if(
          data.coverImage &&
          isSafeUrl(data.coverImage)
        ){

          cover.src =
            data.coverImage;

          cover.alt =
            data.title ||
            "Blog cover image";

          document.getElementById(
            "coverSection"
          ).classList.remove(
            "hidden"
          );

        }


        document.getElementById(
          "content"
        ).innerHTML =
          sanitizeContent(
            data.content ||
            "<p>No article content available.</p>"
          );


        renderImages(
          data.images
        );


        renderVideos(
          data.videos
        );


        renderAudios(
          data.audios
        );


        renderFiles(
          data.files
        );


        renderEmbeds(
          data.embeds
        );


        renderAI(
          data.aiEmbed
        );


        renderTags(
          data.tags
        );


        document.getElementById(
          "likes"
        ).textContent =
          Number(data.likes || 0);


        document.getElementById(
          "shares"
        ).textContent =
          Number(data.shares || 0);


        document.getElementById(
          "commentsCount"
        ).textContent =
          Number(data.commentsCount || 0);


        setupSharing();


        article.classList.remove(
          "hidden"
        );

        loading.classList.add(
          "hidden"
        );

      }catch(error){

        console.error(
          "Blog loading error:",
          error
        );

        showError(
          "Unable to load this blog post. Please try again later."
        );

      }

    }


    function renderAuthor(data){

      const authorName =
        document.getElementById(
          "authorName"
        );

      const authorPhotoBox =
        document.getElementById(
          "authorPhotoBox"
        );


      authorName.textContent =
        data.authorName ||
        "LetsStudy Pro";


      if(
        data.authorPhoto &&
        isSafeUrl(data.authorPhoto)
      ){

        const img =
          document.createElement(
            "img"
          );

        img.src =
          data.authorPhoto;

        img.alt =
          data.authorName ||
          "Author";

        img.loading =
          "lazy";

        authorPhotoBox
          .appendChild(img);

      }else{

        authorPhotoBox.textContent =
          (data.authorName || "L")
            .charAt(0)
            .toUpperCase();

      }

    }


    function renderMeta(data){

      const meta =
        document.getElementById(
          "meta"
        );

      meta.innerHTML = "";


      if(data.language){

        addMeta(
          `Language: ${data.language}`
        );

      }


      if(
        data.views !== undefined
      ){

        addMeta(
          `Views: ${Number(data.views || 0)}`
        );

      }


      if(data.slug){

        addMeta(
          `Slug: ${data.slug}`
        );

      }


      if(data.countryTarget){

        const countries =
          Array.isArray(
            data.countryTarget
          )
            ? data.countryTarget
            : [data.countryTarget];


        if(countries.length){

          addMeta(
            `Target: ${countries.join(", ")}`
          );

        }

      }


      const date =
        timestampToDate(
          data.publishedAt
        ) ||
        timestampToDate(
          data.createdAt
        );


      if(date){

        addMeta(
          date.toLocaleDateString(
            undefined,
            {
              year: "numeric",
              month: "long",
              day: "numeric"
            }
          )
        );

      }

    }


    function addMeta(text){

      const span =
        document.createElement(
          "span"
        );

      span.textContent =
        text;

      document.getElementById(
        "meta"
      ).appendChild(
        span
      );

    }


    function renderImages(items){

