<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Business Plan Builder</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
}

.container{
  width:min(1150px,92%);
  margin:auto;
}

header{
  background:#fff;
  border-bottom:1px solid #e2e8f0;
  padding:18px 0;
}

.nav{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo{
  color:#2563eb;
  font-size:20px;
  font-weight:900;
}

nav a{
  color:#64748b;
  text-decoration:none;
  margin-left:18px;
  font-size:14px;
  font-weight:700;
}

main{
  padding:35px 0 60px;
}

.hero{
  margin-bottom:25px;
}

.hero h1{
  font-size:36px;
  margin-bottom:8px;
}

.hero p{
  color:#64748b;
}

.layout{
  display:grid;
  grid-template-columns:390px 1fr;
  gap:20px;
  align-items:start;
}

.panel,
.preview{
  background:#fff;
  border:1px solid #e2e8f0;
  border-radius:15px;
  padding:22px;
  box-shadow:0 8px 25px #00000008;
}

.panel{
  position:sticky;
  top:90px;
}

.panel h2,
.preview h2{
  margin-bottom:18px;
}

.group{
  margin-bottom:15px;
}

label{
  display:block;
  font-size:12px;
  font-weight:800;
  margin-bottom:6px;
}

input,
textarea,
select{
  width:100%;
  padding:11px;
  border:1px solid #dbe2ea;
  border-radius:8px;
  outline:none;
  font:inherit;
}

textarea{
  resize:vertical;
  min-height:80px;
}

input:focus,
textarea:focus,
select:focus{
  border-color:#2563eb;
}

button{
  border:0;
  border-radius:9px;
  padding:12px 17px;
  cursor:pointer;
  font-weight:800;
}

.primary{
  background:#2563eb;
  color:#fff;
}

.primary:hover{
  background:#1d4ed8;
}

.secondary{
  background:#e2e8f0;
  color:#172033;
}

.actions{
  display:flex;
  gap:10px;
  margin-top:20px;
}

.actions button{
  flex:1;
}

.preview-header{
  text-align:center;
  border-bottom:2px solid #2563eb;
  padding-bottom:20px;
  margin-bottom:20px;
}

.preview-header h1{
  font-size:30px;
}

.preview-header p{
  color:#64748b;
  margin-top:6px;
}

.plan-section{
  margin-bottom:25px;
}

.plan-section h3{
  color:#2563eb;
  font-size:18px;
  margin-bottom:8px;
}

.plan-section p{
  color:#475569;
  line-height:1.7;
  white-space:pre-line;
}

.financials{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
  margin-top:12px;
}

.financial{
  background:#f8fafc;
  padding:15px;
  border-radius:9px;
}

.financial span{
  display:block;
  color:#64748b;
  font-size:11px;
}

.financial strong{
  display:block;
  margin-top:5px;
  font-size:18px;
}

.status{
  background:#eff6ff;
  color:#1d4ed8;
  padding:11px;
  border-radius:8px;
  margin-bottom:18px;
  font-size:13px;
  font-weight:700;
}

@media(max-width:900px){
  .layout{
    grid-template-columns:1fr;
  }

  .panel{
    position:static;
  }
}

@media(max-width:600px){
  nav{display:none}

  .hero h1{
    font-size:29px;
  }

  .financials{
    grid-template-columns:1fr;
  }

  .actions{
    flex-direction:column;
  }
}

@media print{
  header,
  .hero,
  .panel,
  .status,
  footer{
    display:none!important;
  }

  body{
    background:#fff;
  }

  .container{
    width:100%;
  }

  .layout{
    display:block;
  }

  .preview{
    border:0;
    box-shadow:none;
  }
}
</style>
</head>

<body>

<header>
<div class="container nav">

<div class="logo">
📋 Business Plan Builder
</div>

<nav>
<a href="#builder">Builder</a>
<a href="#preview">Preview</a>
</nav>

</div>
</header>


<main class="container" id="builder">

<section class="hero">
<h1>Business Plan Builder</h1>
<p>
Create a professional business plan from your business information.
</p>
</section>


<div class="layout">

<!-- FORM -->

<section class="panel">

<h2>Business Information</h2>

<div class="status">
Fill in your details and generate your plan.
</div>

<div class="group">
<label>Business Name</label>
<input
id="businessName"
placeholder="e.g. SmartTech Solutions">
</div>

<div class="group">
<label>Business Type</label>
<select id="businessType">
<option>Retail</option>
<option>Technology</option>
<option>Consulting</option>
<option>Education</option>
<option>Food & Beverage</option>
<option>Manufacturing</option>
<option>Other</option>
</select>
</div>

<div class="group">
<label>Location</label>
<input
id="location"
placeholder="e.g. Dar es Salaam">
</div>

<div class="group">
<label>Business Description</label>
<textarea
id="description"
placeholder="Describe what your business does..."></textarea>
</div>

<div class="group">
<label>Target Market</label>
<textarea
id="market"
placeholder="Who are your customers?"></textarea>
</div>

<div class="group">
<label>Products / Services</label>
<textarea
id="products"
placeholder="List your main products or services..."></textarea>
</div>

<div class="group">
<label>Marketing Strategy</label>
<textarea
id="marketing"
placeholder="How will you attract customers?"></textarea>
</div>

<div class="group">
<label>Business Goals</label>
<textarea
id="goals"
placeholder="What do you want to achieve?"></textarea>
</div>

<h2 style="margin-top:25px">
Financial Plan
</h2>

<div class="group">
<label>Startup Capital</label>
<input
type="number"
id="capital"
placeholder="0">
</div>

<div class="group">
<label>Expected Monthly Revenue</label>
<input
type="number"
id="revenue"
placeholder="0">
</div>

<div class="group">
<label>Expected Monthly Expenses</label>
<input
type="number"
id="expenses"
placeholder="0">
</div>

<div class="actions">

<button
class="primary"
id="generate">
Generate Plan
</button>

<button
class="secondary"
id="print">
Print
</button>

</div>

</section>


<!-- PREVIEW -->

<section
class="preview"
id="preview">

<div class="preview-header">

<h1 id="previewName">
Your Business Plan
</h1>

<p id="previewType">
Business Plan
</p>

<p id="previewLocation">
Location
</p>

</div>


<div class="plan-section">

<h3>1. Executive Summary</h3>

<p id="summary">
Your executive summary will appear here.
</p>

</div>


<div class="plan-section">

<h3>2. Business Description</h3>

<p id="previewDescription">
Your business description will appear here.
</p>

</div>


<div class="plan-section">

<h3>3. Target Market</h3>

<p id="previewMarket">
Your target market will appear here.
</p>

</div>


<div class="plan-section">

<h3>4. Products & Services</h3>

<p id="previewProducts">
Your products and services will appear here.
</p>

</div>


<div class="plan-section">

<h3>5. Marketing Strategy</h3>

<p id="previewMarketing">
Your marketing strategy will appear here.
</p>

</div>


<div class="plan-section">

<h3>6. Business Goals</h3>

<p id="previewGoals">
Your business goals will appear here.
</p>

</div>


<div class="plan-section">

<h3>7. Financial Plan</h3>

<div class="financials">

<div class="financial">
<span>Startup Capital</span>
<strong id="previewCapital">
$0
</strong>
</div>

<div class="financial">
<span>Monthly Revenue</span>
<strong id="previewRevenue">
$0
</strong>
</div>

<div class="financial">
<span>Monthly Expenses</span>
<strong id="previewExpenses">
$0
</strong>
</div>

</div>

<div
class="financial"
style="margin-top:10px">

<span>Estimated Monthly Profit</span>

<strong id="previewProfit">
$0
</strong>

</div>

</div>


<div class="plan-section">

<h3>8. Business Outlook</h3>

<p id="outlook">
Generate your plan to see the business outlook.
</p>

</div>

</section>

</div>

</main>


<footer>
<div class="container">
<strong>📋 Business Plan Builder</strong>
</div>
</footer>


<script>

const $ = id =>
document.getElementById(id);


function value(id){
return $(id).value.trim();
}


function money(number){

return Number(number || 0)
.toLocaleString(
"en-US",
{
style:"currency",
currency:"USD",
maximumFractionDigits:2
}
);


}


function generatePlan(){

const name =
value("businessName") ||
"Your Business";

const type =
value("businessType");

const location =
value("location") ||
"Your Location";

const description =
value("description") ||
"No business description provided.";

const market =
value("market") ||
"No target market information provided.";

const products =
value("products") ||
"No products or services listed.";

const marketing =
value("marketing") ||
"No marketing strategy provided.";

const goals =
value("goals") ||
"No business goals provided.";

const capital =
Number(value("capital")) || 0;

const revenue =
Number(value("revenue")) || 0;

const expenses =
Number(value("expenses")) || 0;

const profit =
revenue - expenses;


/* HEADER */

$("previewName")
.textContent = name;

$("previewType")
.textContent =
type + " Business Plan";

$("previewLocation")
.textContent =
location;


/* SECTIONS */

$("previewDescription")
.textContent =
description;

$("previewMarket")
.textContent =
market;

$("previewProducts")
.textContent =
products;

$("previewMarketing")
.textContent =
marketing;

$("previewGoals")
.textContent =
goals;


/* SUMMARY */

$("summary")
.textContent =
`${name} is a ${type.toLowerCase()} business based in ${location}. ` +
`The business aims to serve its target market through its products and services ` +
`while building sustainable revenue and long-term growth.`;


/* FINANCIALS */

$("previewCapital")
.textContent =
money(capital);

$("previewRevenue")
.textContent =
money(revenue);

$("previewExpenses")
.textContent =
money(expenses);

$("previewProfit")
.textContent =
money(profit);


/* OUTLOOK */

let outlook;

if(revenue === 0){

outlook =
"Enter expected monthly revenue and expenses to calculate the financial outlook.";

}else if(profit > 0){

outlook =
`The current projection shows an estimated monthly profit of ${money(profit)}. ` +
`The business should focus on customer growth, cost control and reinvesting profits for sustainable expansion.`;

}else if(profit < 0){

outlook =
`The current projection shows a monthly loss of ${money(Math.abs(profit))}. ` +
`Review pricing, sales targets and operating expenses before scaling the business.`;

}else{

outlook =
"The current projection is at break-even. Increasing revenue while maintaining controlled expenses can improve profitability.";

}

$("outlook").textContent =
outlook;

}


$("generate")
.addEventListener(
"click",
generatePlan
);


$("print")
.addEventListener(
"click",
() => {

generatePlan();
window.print();

}
);


/* LIVE PREVIEW */

[
"businessName",
"location",
"description",
"market",
"products",
"marketing",
"goals",
"capital",
"revenue",
"expenses"
].forEach(id => {

$(id).addEventListener(
"input",
generatePlan
);

});

generatePlan();

</script>

</body>
</html>