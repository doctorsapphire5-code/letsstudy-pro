<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Business Customers</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
  --primary:#2563eb;
  --primary-dark:#1d4ed8;
  --dark:#0f172a;
  --text:#172033;
  --muted:#64748b;
  --bg:#f5f7fb;
  --white:#fff;
  --border:#e2e8f0;
  --danger:#dc2626;
  --success:#16a34a;
  --warning:#d97706;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--bg);
  color:var(--text);
}

.container{
  width:min(1150px,92%);
  margin:auto;
}

header{
  background:#fff;
  border-bottom:1px solid var(--border);
  position:sticky;
  top:0;
  z-index:50;
}

.nav{
  min-height:70px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  display:flex;
  align-items:center;
  gap:10px;
  font-weight:800;
}

.logo-icon{
  width:42px;
  height:42px;
  border-radius:11px;
  display:grid;
  place-items:center;
  background:var(--primary);
  color:#fff;
}

.nav-links{
  display:flex;
  gap:20px;
}

.nav-links a{
  text-decoration:none;
  color:var(--muted);
  font-size:14px;
  font-weight:700;
}

main{
  padding:35px 0 60px;
}

.hero{
  margin-bottom:25px;
}

.eyebrow{
  color:var(--primary);
  font-size:12px;
  font-weight:800;
  letter-spacing:.12em;
}

h1{
  margin-top:5px;
  font-size:clamp(28px,5vw,42px);
}

.hero p{
  color:var(--muted);
  margin-top:7px;
}

.status{
  padding:12px 15px;
  border-radius:10px;
  background:#eff6ff;
  color:#1d4ed8;
  font-size:13px;
  font-weight:700;
  margin-bottom:22px;
}

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
  margin-bottom:22px;
}

.stat{
  background:#fff;
  border:1px solid var(--border);
  border-radius:15px;
  padding:20px;
  box-shadow:0 8px 25px #00000008;
}

.stat-icon{
  width:40px;
  height:40px;
  display:grid;
  place-items:center;
  background:#eff6ff;
  border-radius:10px;
}

.stat-label{
  display:block;
  color:var(--muted);
  font-size:12px;
  margin-top:13px;
}

.stat-value{
  display:block;
  font-size:25px;
  margin-top:3px;
}

.card{
  background:#fff;
  border:1px solid var(--border);
  border-radius:16px;
  padding:23px;
  margin-bottom:22px;
  box-shadow:0 8px 25px #00000008;
}

.card h2{
  font-size:19px;
  margin-bottom:5px;
}

.card-sub{
  color:var(--muted);
  font-size:13px;
  margin-bottom:20px;
}

.form-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:15px;
}

.form-group{
  display:flex;
  flex-direction:column;
  gap:6px;
}

.full{
  grid-column:1/-1;
}

label{
  font-size:13px;
  font-weight:800;
}

input,select,textarea{
  width:100%;
  padding:12px;
  border:1px solid var(--border);
  border-radius:9px;
  outline:none;
  font:inherit;
  background:#fff;
}

input:focus,select:focus,textarea:focus{
  border-color:var(--primary);
  box-shadow:0 0 0 3px #2563eb18;
}

textarea{
  min-height:90px;
  resize:vertical;
}

.buttons{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top:20px;
}

button{
  border:0;
  border-radius:9px;
  padding:11px 17px;
  cursor:pointer;
  font:inherit;
  font-weight:800;
}

.primary{
  background:var(--primary);
  color:#fff;
}

.primary:hover{
  background:var(--primary-dark);
}

.secondary{
  background:#eef2f7;
  color:var(--text);
}

.danger{
  background:#fee2e2;
  color:#b91c1c;
}

.toolbar{
  display:grid;
  grid-template-columns:1fr 220px;
  gap:12px;
  margin-bottom:20px;
}

.customers{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
}

.customer{
  background:#fff;
  border:1px solid var(--border);
  border-radius:14px;
  padding:18px;
}

.customer-top{
  display:flex;
  align-items:center;
  gap:12px;
}

.avatar{
  width:48px;
  height:48px;
  border-radius:50%;
  background:#dbeafe;
  color:#1d4ed8;
  display:grid;
  place-items:center;
  font-weight:900;
}

.customer-name{
  font-size:17px;
  font-weight:850;
}

.customer-email{
  color:var(--muted);
  font-size:12px;
  margin-top:3px;
  word-break:break-word;
}

.customer-info{
  margin-top:15px;
  display:grid;
  gap:8px;
}

.info-row{
  display:flex;
  justify-content:space-between;
  gap:10px;
  padding:9px;
  border-radius:8px;
  background:#f8fafc;
  font-size:12px;
}

.info-row span{
  color:var(--muted);
}

.badge{
  display:inline-block;
  margin-top:12px;
  padding:5px 9px;
  border-radius:20px;
  font-size:11px;
  font-weight:800;
}

.active{
  background:#dcfce7;
  color:#166534;
}

.inactive{
  background:#fee2e2;
  color:#991b1b;
}

.customer-actions{
  display:flex;
  gap:8px;
  margin-top:15px;
}

.small-btn{
  flex:1;
  padding:9px;
  font-size:12px;
}

.empty{
  grid-column:1/-1;
  text-align:center;
  padding:35px;
  color:var(--muted);
  border:1px dashed var(--border);
  border-radius:12px;
}

footer{
  background:var(--dark);
  color:#fff;
  padding:30px 0;
}

.footer{
  display:flex;
  justify-content:space-between;
  gap:20px;
}

.footer p{
  color:#94a3b8;
  font-size:12px;
}

@media(max-width:950px){
  .stats{grid-template-columns:repeat(2,1fr)}
  .customers{grid-template-columns:repeat(2,1fr)}
}

@media(max-width:650px){
  .nav-links{display:none}
  .stats{grid-template-columns:1fr}
  .form-grid{grid-template-columns:1fr}
  .full{grid-column:auto}
  .toolbar{grid-template-columns:1fr}
  .customers{grid-template-columns:1fr}
  .footer{flex-direction:column}
}
</style>
</head>

<body>

<header>
<div class="container nav">

<div class="logo">
<div class="logo-icon">👥</div>
<span>Business Customers</span>
</div>

<nav class="nav-links">
<a href="#overview">Overview</a>
<a href="#add">Add Customer</a>
<a href="#customers">Customers</a>
</nav>

</div>
</header>


<main class="container">

<section class="hero">
<span class="eyebrow">CUSTOMER MANAGEMENT</span>
<h1>Business Customers</h1>
<p>
Add, manage and track your business customers.
</p>
</section>


<div id="status" class="status">
Connecting to Firebase...
</div>


<section class="stats" id="overview">

<div class="stat">
<div class="stat-icon">👥</div>
<span class="stat-label">Total Customers</span>
<strong class="stat-value" id="totalCustomers">0</strong>
</div>

<div class="stat">
<div class="stat-icon">✅</div>
<span class="stat-label">Active Customers</span>
<strong class="stat-value" id="activeCustomers">0</strong>
</div>

<div class="stat">
<div class="stat-icon">📱</div>
<span class="stat-label">Phone Contacts</span>
<strong class="stat-value" id="phoneContacts">0</strong>
</div>

<div class="stat">
<div class="stat-icon">🌍</div>
<span class="stat-label">Locations</span>
<strong class="stat-value" id="locations">0</strong>
</div>

</section>


<section class="card" id="add">

<h2 id="formTitle">Add Customer</h2>

<p class="card-sub">
Enter your customer information below.
</p>

<form id="customerForm">

<div class="form-grid">

<div class="form-group">
<label for="customerName">Full Name *</label>
<input
id="customerName"
required
placeholder="John Doe">
</div>

<div class="form-group">
<label for="email">Email *</label>
<input
id="email"
type="email"
required
placeholder="john@example.com">
</div>

<div class="form-group">
<label for="phone">Phone</label>
<input
id="phone"
type="tel"
placeholder="+255 700 000 000">
</div>

<div class="form-group">
<label for="location">Location</label>
<input
id="location"
placeholder="Dar es Salaam">
</div>

<div class="form-group">
<label for="company">Company</label>
<input
id="company"
placeholder="ABC Company">
</div>

<div class="form-group">
<label for="statusSelect">Status *</label>

<select id="statusSelect" required>
<option value="Active">Active</option>
<option value="Inactive">Inactive</option>
</select>

</div>

<div class="form-group full">
<label for="notes">Notes</label>
<textarea
id="notes"
placeholder="Additional customer information..."
></textarea>
</div>

</div>

<div class="buttons">

<button
type="submit"
class="primary"
id="saveBtn">
➕ Add Customer
</button>

<button
type="button"
class="secondary"
id="cancelBtn"
style="display:none">
Cancel Edit
</button>

<button
type="reset"
class="secondary">
Reset
</button>

</div>

</form>

</section>


<section class="card" id="customers">

<h2>Customer Directory</h2>

<p class="card-sub">
Search and manage your customers.
</p>

<div class="toolbar">

<input
id="search"
placeholder="🔎 Search customers...">

<select id="filterStatus">
<option value="">All Statuses</option>
<option value="Active">Active</option>
<option value="Inactive">Inactive</option>
</select>

</div>

<div class="customers" id="customerList">

<div class="empty">
Loading customers...
</div>

</div>

</section>

</main>


<footer>

<div class="container footer">

<strong>👥 Business Customers</strong>

<p>
© <span id="year"></span> Business Customers
</p>

</div>

</footer>


<script type="module">

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

import {
getFirestore,
collection,
addDoc,
doc,
updateDoc,
deleteDoc,
onSnapshot,
serverTimestamp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


/* =========================
   FIREBASE CONFIG
========================= */

const firebaseConfig = {

apiKey:
"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};


/* =========================
   INITIALIZE FIREBASE
========================= */

const app =
initializeApp(firebaseConfig);

const db =
getFirestore(app);

const customersRef =
collection(
db,
"businessCustomers"
);


/* =========================
   ELEMENTS
========================= */

const form =
document.getElementById(
"customerForm"
);

const customerList =
document.getElementById(
"customerList"
);

const statusBox =
document.getElementById(
"status"
);

const saveBtn =
document.getElementById(
"saveBtn"
);

const cancelBtn =
document.getElementById(
"cancelBtn"
);

const search =
document.getElementById(
"search"
);

const filterStatus =
document.getElementById(
"filterStatus"
);

let customers = [];
let editingId = null;


/* =========================
   STATUS
========================= */

function setStatus(
text,
error = false
){

statusBox.textContent = text;

if(error){

statusBox.style.background =
"#fee2e2";

statusBox.style.color =
"#b91c1c";

}else{

statusBox.style.background =
"#eff6ff";

statusBox.style.color =
"#1d4ed8";

}

}


/* =========================
   FORM DATA
========================= */

function getFormData(){

return {

name:
document
.getElementById("customerName")
.value
.trim(),

email:
document
.getElementById("email")
.value
.trim(),

phone:
document
.getElementById("phone")
.value
.trim(),

location:
document
.getElementById("location")
.value
.trim(),

company:
document
.getElementById("company")
.value
.trim(),

status:
document
.getElementById("statusSelect")
.value,

notes:
document
.getElementById("notes")
.value
.trim()

};

}


/* =========================
   ADD / UPDATE
========================= */

form.addEventListener(
"submit",
async event => {

event.preventDefault();

const data =
getFormData();

if(!data.name || !data.email){

setStatus(
"Name and email are required.",
true
);

return;

}

try{

saveBtn.disabled = true;

saveBtn.textContent =
editingId
? "Updating..."
: "Adding...";


if(editingId){

await updateDoc(

doc(
db,
"businessCustomers",
editingId
),

{
...data,
updatedAt:
serverTimestamp()
}

);

setStatus(
"Customer updated successfully."
);

}else{

await addDoc(

customersRef,

{
...data,
createdAt:
serverTimestamp(),
updatedAt:
serverTimestamp()
}

);

setStatus(
"Customer added successfully."
);

}


form.reset();

editingId = null;

document.getElementById(
"formTitle"
).textContent =
"Add Customer";

saveBtn.textContent =
"➕ Add Customer";

cancelBtn.style.display =
"none";


}catch(error){

console.error(error);

setStatus(
"Operation failed: " +
error.message,
true
);

}finally{

saveBtn.disabled = false;

if(!editingId){

saveBtn.textContent =
"➕ Add Customer";

}

}

});


/* =========================
   REAL-TIME FIRESTORE
========================= */

onSnapshot(

customersRef,

snapshot => {

customers = [];

snapshot.forEach(
item => {

customers.push({

id:item.id,
...item.data()

});

});

renderCustomers();
updateStats();

setStatus(
`${customers.length} customer(s) loaded from Firestore.`
);

},

error => {

console.error(error);

setStatus(
"Firestore error: " +
error.message,
true
);

}

);


/* =========================
   RENDER CUSTOMERS
========================= */

function renderCustomers(){

const query =
search.value
.trim()
.toLowerCase();

const selectedStatus =
filterStatus.value;


const filtered =
customers.filter(
customer => {

const matchesSearch =

(customer.name || "")
.toLowerCase()
.includes(query)

||

(customer.email || "")
.toLowerCase()
.includes(query)

||

(customer.phone || "")
.toLowerCase()
.includes(query)

||

(customer.company || "")
.toLowerCase()
.includes(query)

||

(customer.location || "")
.toLowerCase()
.includes(query);


const matchesStatus =
!selectedStatus ||
customer.status === selectedStatus;


return (
matchesSearch &&
matchesStatus
);

});


if(!filtered.length){

customerList.innerHTML = `
<div class="empty">
No customers found.
</div>
`;

return;

}


customerList.innerHTML =
filtered.map(
customer => {

const active =
customer.status !== "Inactive";

const badgeClass =
active
? "active"
: "inactive";

const initials =
getInitials(
customer.name
);


return `

<article class="customer">

<div class="customer-top">

<div class="avatar">
${escapeHTML(initials)}
</div>

<div>

<div class="customer-name">
${escapeHTML(
customer.name ||
"Unnamed Customer"
)}
</div>

<div class="customer-email">
${escapeHTML(
customer.email ||
"No email"
)}
</div>

</div>

</div>


<div class="customer-info">

<div class="info-row">
<span>Phone</span>
<strong>
${escapeHTML(
customer.phone || "—"
)}
</strong>
</div>

<div class="info-row">
<span>Company</span>
<strong>
${escapeHTML(
customer.company || "—"
)}
</strong>
</div>

<div class="info-row">
<span>Location</span>
<strong>
${escapeHTML(
customer.location || "—"
)}
</strong>
</div>

</div>


<span class="badge ${badgeClass}">
${escapeHTML(
customer.status || "Active"
)}
</span>


<div class="customer-actions">

<button
class="secondary small-btn"
data-edit="${customer.id}">
✏️ Edit
</button>

<button
class="danger small-btn"
data-delete="${customer.id}">
🗑️ Delete
</button>

</div>

</article>

`;

}
).join("");


document
.querySelectorAll("[data-edit]")
.forEach(button => {

button.addEventListener(
"click",
() => editCustomer(
button.dataset.edit
)
);

});


document
.querySelectorAll("[data-delete]")
.forEach(button => {

button.addEventListener(
"click",
() => deleteCustomer(
button.dataset.delete
)
);

});

}


/* =========================
   EDIT CUSTOMER
========================= */

function editCustomer(id){

const customer =
customers.find(
item => item.id === id
);

if(!customer)return;


document.getElementById(
"customerName"
).value =
customer.name || "";

document.getElementById(
"email"
).value =
customer.email || "";

document.getElementById(
"phone"
).value =
customer.phone || "";

document.getElementById(
"location"
).value =
customer.location || "";

document.getElementById(
"company"
).value =
customer.company || "";

document.getElementById(
"statusSelect"
).value =
customer.status || "Active";

document.getElementById(
"notes"
).value =
customer.notes || "";


editingId = id;


document.getElementById(
"formTitle"
).textContent =
"Edit Customer";

saveBtn.textContent =
"💾 Update Customer";

cancelBtn.style.display =
"inline-block";


document
.getElementById("add")
.scrollIntoView({
behavior:"smooth"
});

}


/* =========================
   CANCEL EDIT
========================= */

cancelBtn.addEventListener(
"click",
() => {

editingId = null;

form.reset();

document.getElementById(
"formTitle"
).textContent =
"Add Customer";

saveBtn.textContent =
"➕ Add Customer";

cancelBtn.style.display =
"none";

}
);


/* =========================
   DELETE
========================= */

async function deleteCustomer(id){

const customer =
customers.find(
item => item.id === id
);

if(!customer)return;


const confirmed =
confirm(
`Delete "${customer.name}"?`
);

if(!confirmed)return;


try{

await deleteDoc(

doc(
db,
"businessCustomers",
id
)

);

setStatus(
"Customer deleted successfully."
);

}catch(error){

console.error(error);

setStatus(
"Could not delete customer: " +
error.message,
true
);

}

}


/* =========================
   SEARCH
========================= */

search.addEventListener(
"input",
renderCustomers
);

filterStatus.addEventListener(
"change",
renderCustomers
);


/* =========================
   STATS
========================= */

function updateStats(){

const total =
customers.length;

const active =
customers.filter(
customer =>
customer.status !== "Inactive"
).length;

const phones =
customers.filter(
customer =>
customer.phone &&
customer.phone.trim()
).length;

const locations =
new Set(
customers
.map(customer =>
customer.location
)
).size;


document.getElementById(
"totalCustomers"
).textContent =
total.toLocaleString();

document.getElementById(
"activeCustomers"
).textContent =
active.toLocaleString();

document.getElementById(
"phoneContacts"
).textContent =
phones.toLocaleString();

document.getElementById(
"locations"
).textContent =
locations.toLocaleString();

}


/* =========================
   INITIALS
========================= */

function getInitials(name){

if(!name)return "?";

return name
.trim()
.split(/\s+/)
.slice(0,2)
.map(word => word[0])
.join("")
.toUpperCase();

}


/* =========================
   ESCAPE HTML
========================= */

function escapeHTML(value){

return String(value)
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}


/* =========================
   YEAR
========================= */

document.getElementById(
"year"
).textContent =
new Date().getFullYear();

</script>

</body>
</html>