<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Business Dashboard</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
  --primary:#2563eb;
  --dark:#0f172a;
  --text:#172033;
  --muted:#64748b;
  --bg:#f5f7fb;
  --white:#fff;
  --border:#e2e8f0;
  --green:#16a34a;
  --red:#dc2626;
  --orange:#ea580c;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--bg);
  color:var(--text);
}

.container{
  width:min(1150px,92%);
  margin:auto;
}

/* HEADER */

header{
  background:var(--white);
  border-bottom:1px solid var(--border);
  position:sticky;
  top:0;
  z-index:20;
}

.nav{
  min-height:70px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  display:flex;
  align-items:center;
  gap:10px;
  font-weight:800;
}

.logo-icon{
  width:40px;
  height:40px;
  border-radius:11px;
  display:grid;
  place-items:center;
  background:var(--primary);
  color:#fff;
}

.nav-links{
  display:flex;
  gap:20px;
}

.nav-links a{
  text-decoration:none;
  color:var(--muted);
  font-size:14px;
  font-weight:700;
}

.nav-links a:hover{
  color:var(--primary);
}

/* MAIN */

main{
  padding:35px 0 60px;
}

.hero{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:20px;
  margin-bottom:25px;
}

.eyebrow{
  color:var(--primary);
  font-size:12px;
  font-weight:800;
  letter-spacing:.12em;
}

h1{
  margin-top:5px;
  font-size:clamp(28px,5vw,42px);
}

.hero p{
  color:var(--muted);
  margin-top:7px;
}

.date{
  color:var(--muted);
  font-size:13px;
}

/* STATUS */

.status{
  padding:12px 15px;
  border-radius:10px;
  background:#eff6ff;
  color:#1d4ed8;
  font-size:13px;
  font-weight:700;
  margin-bottom:22px;
}

/* CARDS */

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:16px;
  margin-bottom:22px;
}

.stat{
  background:#fff;
  border:1px solid var(--border);
  border-radius:16px;
  padding:20px;
  box-shadow:0 7px 25px #00000008;
}

.stat-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.stat-icon{
  width:40px;
  height:40px;
  border-radius:10px;
  display:grid;
  place-items:center;
  background:#eff6ff;
}

.stat-label{
  display:block;
  color:var(--muted);
  font-size:13px;
  margin-top:15px;
}

.stat-value{
  display:block;
  font-size:25px;
  margin-top:4px;
}

.change{
  display:inline-block;
  margin-top:7px;
  font-size:12px;
  font-weight:800;
}

.up{color:var(--green)}
.down{color:var(--red)}

/* GRID */

.dashboard-grid{
  display:grid;
  grid-template-columns:1.5fr 1fr;
  gap:22px;
}

.card{
  background:#fff;
  border:1px solid var(--border);
  border-radius:16px;
  padding:22px;
  box-shadow:0 7px 25px #00000008;
}

.card h2{
  font-size:19px;
  margin-bottom:5px;
}

.card-sub{
  color:var(--muted);
  font-size:13px;
  margin-bottom:18px;
}

/* REVENUE */

.revenue-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.revenue-number{
  font-size:28px;
  font-weight:850;
}

.bar-chart{
  height:220px;
  display:flex;
  align-items:end;
  gap:10px;
  margin-top:25px;
  padding-top:15px;
  border-bottom:1px solid var(--border);
}

.bar-wrap{
  height:100%;
  flex:1;
  display:flex;
  align-items:end;
  justify-content:center;
}

.bar{
  width:100%;
  max-width:45px;
  min-height:5px;
  border-radius:7px 7px 0 0;
  background:var(--primary);
}

.bar-label{
  font-size:10px;
  color:var(--muted);
  text-align:center;
  margin-top:7px;
}

/* ACTIVITIES */

.activity{
  display:flex;
  gap:12px;
  padding:13px 0;
  border-bottom:1px solid var(--border);
}

.activity:last-child{
  border-bottom:0;
}

.activity-icon{
  width:36px;
  height:36px;
  border-radius:10px;
  background:#eff6ff;
  display:grid;
  place-items:center;
  flex:none;
}

.activity strong{
  font-size:13px;
}

.activity p{
  color:var(--muted);
  font-size:12px;
  margin-top:2px;
}

/* PROFILE */

.profile{
  display:flex;
  align-items:center;
  gap:15px;
}

.profile-logo{
  width:65px;
  height:65px;
  border-radius:15px;
  object-fit:cover;
  background:#eff6ff;
}

.profile h3{
  font-size:18px;
}

.profile p{
  color:var(--muted);
  font-size:13px;
}

.info{
  margin-top:20px;
  display:grid;
  gap:11px;
}

.info-row{
  display:flex;
  justify-content:space-between;
  gap:15px;
  font-size:13px;
  padding-bottom:10px;
  border-bottom:1px solid var(--border);
}

.info-row span:first-child{
  color:var(--muted);
}

/* QUICK ACTIONS */

.actions{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
  margin-top:15px;
}

.action{
  padding:13px;
  border:1px solid var(--border);
  border-radius:11px;
  background:#fff;
  cursor:pointer;
  text-decoration:none;
  color:var(--text);
  font-weight:800;
  font-size:13px;
}

.action:hover{
  border-color:var(--primary);
  color:var(--primary);
}

/* TABLE */

.table-wrap{
  overflow-x:auto;
}

table{
  width:100%;
  border-collapse:collapse;
  margin-top:10px;
}

th,td{
  padding:12px;
  text-align:left;
  border-bottom:1px solid var(--border);
  font-size:13px;
}

th{
  color:var(--muted);
  font-size:12px;
}

.badge{
  padding:5px 9px;
  border-radius:20px;
  background:#dcfce7;
  color:#166534;
  font-size:11px;
  font-weight:800;
}

/* FOOTER */

footer{
  background:var(--dark);
  color:#fff;
  padding:30px 0;
}

.footer{
  display:flex;
  justify-content:space-between;
  gap:20px;
}

.footer p{
  color:#94a3b8;
  font-size:12px;
}

/* RESPONSIVE */

@media(max-width:950px){
  .stats{
    grid-template-columns:repeat(2,1fr);
  }

  .dashboard-grid{
    grid-template-columns:1fr;
  }
}

@media(max-width:600px){
  .nav-links{
    display:none;
  }

  .hero{
    flex-direction:column;
    align-items:flex-start;
  }

  .stats{
    grid-template-columns:1fr;
  }

  .actions{
    grid-template-columns:1fr;
  }

  .footer{
    flex-direction:column;
  }
}
</style>
</head>

<body>

