<!-- =========================
     FIREBASE + JAVASCRIPT
========================= -->

<script type="module">

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";


import {
getFirestore,
doc,
onSnapshot,
collection,
query,
orderBy,
limit,
getDocs
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


/* =========================
   FIREBASE CONFIG
========================= */

const firebaseConfig={

apiKey:
"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};


/* =========================
   INITIALIZE
========================= */

const app=
initializeApp(firebaseConfig);

const db=
getFirestore(app);


/* =========================
   ELEMENTS
========================= */

const status=
document.getElementById("status");

const revenueValue=
document.getElementById("revenueValue");

const revenueTotal=
document.getElementById("revenueTotal");

const customersValue=
document.getElementById("customersValue");

const employeesValue=
document.getElementById("employeesValue");

const ordersValue=
document.getElementById("ordersValue");


/* =========================
   FORMAT MONEY
========================= */

function money(value){

return "$"+
Number(value||0)
.toLocaleString(
"en-US",
{
maximumFractionDigits:2
}
);

}


/* =========================
   STATUS
========================= */

function setStatus(
text,
error=false
){

status.textContent=text;

if(error){

status.style.background="#fee2e2";
status.style.color="#b91c1c";

}else{

status.style.background="#eff6ff";
status.style.color="#1d4ed8";

}

}


/* =========================
   BUSINESS PROFILE
========================= */

const profileRef=
doc(
db,
"businessProfiles",
"main"
);


onSnapshot(
profileRef,
snapshot=>{

if(!snapshot.exists()){

setStatus(
"No business profile found. Create one first."
);

return;

}

const data=
snapshot.data();


document.getElementById(
"businessName"
).textContent=
data.businessName||"Your Business";


document.getElementById(
"welcomeTitle"
).textContent=
data.businessName||
"Business Overview";


document.getElementById(
"industry"
).textContent=
data.industry||"Industry";


document.getElementById(
"owner"
).textContent=
data.owner||"—";


document.getElementById(
"location"
).textContent=
data.location||"—";


document.getElementById(
"phone"
).textContent=
data.phone||"—";


document.getElementById(
"profileEmployees"
).textContent=
data.employees||"0";


employeesValue.textContent=
Number(data.employees||0)
.toLocaleString();


if(data.logo){

document.getElementById(
"profileLogo"
).src=data.logo;

}


setStatus(
"Dashboard connected and synced with Firestore."
);

},
error=>{

console.error(error);

setStatus(
"Could not load business profile: "+
error.message,
true
);

}
);


/* =========================
   DASHBOARD STATS
========================= */

const dashboardRef=
doc(
db,
"dashboard",
"main"
);


onSnapshot(
dashboardRef,
snapshot=>{

if(!snapshot.exists()){

return;

}

const data=
snapshot.data();


const revenue=
Number(data.revenue||0);

const customers=
Number(data.customers||0);

const employees=
Number(data.employees||0);

const orders=
Number(data.orders||0);


revenueValue.textContent=
money(revenue);

revenueTotal.textContent=
money(revenue);

customersValue.textContent=
customers.toLocaleString();

employeesValue.textContent=
employees.toLocaleString();

ordersValue.textContent=
orders.toLocaleString();


/* CHART */

const months=
data.months||[
"Jan",
"Feb",
"Mar",
"Apr",
"May",
"Jun"
];

const values=
data.revenueHistory||[
0,0,0,0,0,0
];


renderChart(
months,
values
);

},
error=>{

console.error(error);

}
);


/* =========================
   CHART
========================= */

function renderChart(
months,
values
){

const chart=
document.getElementById(
"chart"
);

chart.innerHTML="";


const max=
Math.max(
...values,
1
);


months.forEach(
(month,index)=>{

const value=
Number(values[index]||0);

const height=
(value/max)*100;


const wrap=
document.createElement(
"div"
);

wrap.className=
"bar-wrap";


wrap.innerHTML=`

<div
style="
width:100%;
height:100%;
display:flex;
flex-direction:column;
justify-content:flex-end;
align-items:center;
"
>

<div
class="bar"
style="
height:${height}%;
"
title="${money(value)}"
></div>

<div class="bar-label">
${month}
</div>

</div>

`;

chart.appendChild(wrap);

});

}


/* =========================
   RECENT ORDERS
========================= */

async function loadOrders(){

const table=
document.getElementById(
"ordersTable"
);

try{

const ordersRef=
collection(
db,
"orders"
);


const q=
query(
ordersRef,
orderBy(
"createdAt",
"desc"
),
limit(10)
);


const snapshot=
await getDocs(q);


if(snapshot.empty){

table.innerHTML=`

<tr>
<td colspan="4">
No orders recorded yet.
</td>
</tr>

`;

return;

}


table.innerHTML="";


snapshot.forEach(
item=>{

const data=
item.data();


const row=
document.createElement(
"tr"
);


row.innerHTML=`

<td>
${escapeHTML(
data.customer||"—"
)}
</td>

<td>
${escapeHTML(
data.product||"—"
)}
</td>

<td>
${money(data.amount)}
</td>

<td>
<span class="badge">
${escapeHTML(
data.status||"Completed"
)}
</span>
</td>

`;

table.appendChild(row);

});

}catch(error){

console.error(error);

table.innerHTML=`

<tr>
<td colspan="4">
Could not load orders.
</td>
</tr>

`;

}

}


/* =========================
   ACTIVITIES
========================= */

async function loadActivities(){

const activityList=
document.getElementById(
"activityList"
);


try{

const ref=
collection(
db,
"activities"
);


const q=
query(
ref,
orderBy(
"createdAt",
"desc"
),
limit(8)
);


const snapshot=
await getDocs(q);


if(snapshot.empty){

activityList.innerHTML=`

<div class="activity">

<div class="activity-icon">
📋
</div>

<div>
<strong>No recent activity</strong>
<p>Your latest activity will appear here.</p>
</div>

</div>

`;

return;

}


activityList.innerHTML="";


snapshot.forEach(
item=>{

const data=
item.data();


const div=
document.createElement(
"div"
);

div.className=
"activity";


div.innerHTML=`

<div class="activity-icon">
${escapeHTML(
data.icon||"📋"
)}
</div>

<div>

<strong>
${escapeHTML(
data.title||"Business activity"
)}
</strong>

<p>
${escapeHTML(
data.description||""
)}
</p>

</div>

`;


activityList.appendChild(
div
);

});

}catch(error){

console.error(error);

activityList.innerHTML=`

<div class="activity">

<div class="activity-icon">
⚠️
</div>

<div>
<strong>Activity unavailable</strong>
<p>
Could not load recent activity.
</p>
</div>

</div>

`;

}

}


/* =========================
   SAFE HTML
========================= */

function escapeHTML(value){

return String(value)
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}


/* =========================
   REFRESH
========================= */

document
.getElementById(
"refreshBtn"
)
.addEventListener(
"click",
async()=>{

setStatus(
"Refreshing dashboard..."
);

await loadOrders();
await loadActivities();

setStatus(
"Dashboard refreshed successfully."
);

}
);


/* =========================
   DATE
========================= */

document.getElementById(
"today"
).textContent=
new Date()
.toLocaleDateString(
"en-US",
{
weekday:"long",
year:"numeric",
month:"long",
day:"numeric"
}
);


/* =========================
   YEAR
========================= */

document.getElementById(
"year"
).textContent=
new Date().getFullYear();


/* =========================
   START
========================= */

loadOrders();
loadActivities();

</script>

</body>
</html>