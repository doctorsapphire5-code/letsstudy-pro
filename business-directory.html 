  <script>

    /* =========================================
       ELEMENTS
    ========================================= */

    const businessForm =
      document.getElementById(
        "businessForm"
      );

    const revenueInput =
      document.getElementById(
        "revenue"
      );

    const expensesInput =
      document.getElementById(
        "expenses"
      );

    const customersInput =
      document.getElementById(
        "customers"
      );

    const employeesInput =
      document.getElementById(
        "employees"
      );

    const businessNameInput =
      document.getElementById(
        "businessName"
      );

    const revenueMetric =
      document.getElementById(
        "revenueMetric"
      );

    const profitMetric =
      document.getElementById(
        "profitMetric"
      );

    const customersMetric =
      document.getElementById(
        "customersMetric"
      );

    const healthMetric =
      document.getElementById(
        "healthMetric"
      );

    const goalMetric =
      document.getElementById(
        "goalMetric"
      );

    const heroProfit =
      document.getElementById(
        "heroProfit"
      );

    const heroCustomers =
      document.getElementById(
        "heroCustomers"
      );

    const heroHealth =
      document.getElementById(
        "heroHealth"
      );

    const businessScore =
      document.getElementById(
        "businessScore"
      );

    const scoreMessage =
      document.getElementById(
        "scoreMessage"
      );


    /* =========================================
       FORMAT CURRENCY
    ========================================= */

    function formatCurrency(
      amount
    ) {

      return "$" +
        Number(amount || 0)
          .toLocaleString(
            undefined,
            {
              maximumFractionDigits: 0
            }
          );

    }


    /* =========================================
       CALCULATE BUSINESS HEALTH
    ========================================= */

    function calculateHealth(
      revenue,
      expenses,
      customers,
      employees
    ) {

      let score = 50;

      if (revenue > 0) {

        const profit =
          revenue - expenses;

        const margin =
          profit / revenue;

        if (margin >= .30) {
          score += 25;
        }

        else if (margin >= .20) {
          score += 18;
        }

        else if (margin >= .10) {
          score += 10;
        }

        else if (margin < 0) {
          score -= 25;
        }

      }

      if (customers >= 1000) {
        score += 10;
      }

      else if (customers >= 500) {
        score += 6;
      }

      else if (customers < 100) {
        score -= 5;
      }

      if (employees > 0) {

        const revenuePerEmployee =
          revenue / employees;

        if (revenuePerEmployee >= 5000) {
          score += 8;
        }

      }

      return Math.max(
        0,
        Math.min(
          100,
          Math.round(score)
        )
      );

    }


    /* =========================================
       UPDATE DASHBOARD
    ========================================= */

    function updateDashboard() {

      const revenue =
        Number(
          revenueInput.value
        ) || 0;

      const expenses =
        Number(
          expensesInput.value
        ) || 0;

      const customers =
        Number(
          customersInput.value
        ) || 0;

      const employees =
        Number(
          employeesInput.value
        ) || 0;

      const profit =
        revenue - expenses;

      const score =
        calculateHealth(
          revenue,
          expenses,
          customers,
          employees
        );

      let health =
        "Needs Attention";

      if (score >= 80) {
        health = "Excellent";
      }

      else if (score >= 65) {
        health = "Good";
      }

      else if (score >= 50) {
        health = "Fair";
      }

      revenueMetric.textContent =
        formatCurrency(
          revenue
        );

      profitMetric.textContent =
        formatCurrency(
          profit
        );

      customersMetric.textContent =
        customers.toLocaleString();

      healthMetric.textContent =
        health;

      goalMetric.textContent =
        `${score}%`;

      heroProfit.textContent =
        formatCurrency(
          profit
        );

      heroCustomers.textContent =
        customers.toLocaleString();

      heroHealth.textContent =
        health;

      businessScore.textContent =
        score;

      const degrees =
        Math.round(
          score * 3.6
        );

      document
        .querySelector(
          ".score-circle"
        )
        .style.background =
        `conic-gradient(
          var(--primary) 0deg,
          var(--primary) ${degrees}deg,
          #e2e8f0 ${degrees}deg,
          #e2e8f0 360deg
        )`;

      if (score >= 80) {

        scoreMessage.textContent =
          "Excellent business health. Focus on sustainable growth.";

      }

      else if (score >= 65) {

        scoreMessage.textContent =
          "Your business is performing well. Keep improving key areas.";

      }

      else if (score >= 50) {

        scoreMessage.textContent =
          "Your business has potential. Review costs, customers and strategy.";

      }

      else {

        scoreMessage.textContent =
          "Your business needs attention. Start with cash flow and profitability.";

      }

    }


    /* =========================================
       FORM SAVE
    ========================================= */

    businessForm.addEventListener(
      "submit",
      function(event) {

        event.preventDefault();

        updateDashboard();

        const businessName =
          businessNameInput.value.trim();

        showModal(
          "Profile Saved",
          businessName
            ? `${businessName} has been added to your Business Director dashboard.`
            : "Your business profile has been saved successfully."
                 );

        document
          .getElementById("dashboard")
          .scrollIntoView({
            behavior: "smooth"
          });

      }
    );


    /* =========================================
       LIVE METRIC UPDATE
    ========================================= */

    [
      revenueInput,
      expensesInput,
      customersInput,
      employeesInput
    ].forEach(input => {

      input.addEventListener(
        "input",
        updateDashboard
      );

    });


    /* =========================================
       ACTION CHECKBOXES
    ========================================= */

    const actionCheckboxes =
      document.querySelectorAll(
        ".action-item input"
      );

    actionCheckboxes.forEach(
      checkbox => {

        checkbox.addEventListener(
          "change",
          function () {

            const item =
              this.closest(".action-item");

            if (this.checked) {

              item.classList.add(
                "completed"
              );

            } else {

              item.classList.remove(
                "completed"
              );

            }

          }
        );

      }
    );


    /* =========================================
       MODAL
    ========================================= */

    const modal =
      document.getElementById("modal");

    const closeModalButton =
      document.getElementById(
        "closeModal"
      );

    const modalOk =
      document.getElementById("modalOk");

    const modalTitle =
      document.getElementById(
        "modalTitle"
      );

    const modalBody =
      document.getElementById(
        "modalBody"
      );


    function showModal(
      title,
      message
    ) {

      modalTitle.textContent =
        title;

      modalBody.textContent =
        message;

      modal.classList.add(
        "active"
      );

      modal.setAttribute(
        "aria-hidden",
        "false"
      );

      document.body.style.overflow =
        "hidden";

    }


    function hideModal() {

      modal.classList.remove(
        "active"
      );

      modal.setAttribute(
        "aria-hidden",
        "true"
      );

      document.body.style.overflow =
        "";

    }


    closeModalButton.addEventListener(
      "click",
      hideModal
    );

    modalOk.addEventListener(
      "click",
      hideModal
    );


    modal.addEventListener(
      "click",
      function (event) {

        if (
          event.target === modal
        ) {

          hideModal();

        }

      }
    );


    document.addEventListener(
      "keydown",
      function (event) {

        if (
          event.key === "Escape"
        ) {

          hideModal();

        }

      }
    );


    /* =========================================
       SMOOTH SCROLL
    ========================================= */

    document
      .querySelectorAll(
        'a[href^="#"]'
      )
      .forEach(link => {

        link.addEventListener(
          "click",
          function (event) {

            const target =
              document.querySelector(
                this.getAttribute("href")
              );

            if (target) {

              event.preventDefault();

              target.scrollIntoView({
                behavior: "smooth"
              });

            }

          }
        );

      });


    /* =========================================
       YEAR
    ========================================= */

    document.getElementById(
      "year"
    ).textContent =
      new Date().getFullYear();


    /* =========================================
       INITIAL DASHBOARD
    ========================================= */

    updateDashboard();

  </script>

