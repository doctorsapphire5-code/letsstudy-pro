<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Business Director</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --secondary: #0f172a;
      --muted: #64748b;
      --bg: #f8fafc;
      --card: #ffffff;
      --border: #e2e8f0;
      --success: #16a34a;
      --warning: #d97706;
      --danger: #dc2626;
      --radius: 18px;
      --shadow: 0 12px 35px rgba(15, 23, 42, 0.07);
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      background: var(--bg);
      color: var(--secondary);
      line-height: 1.6;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .container {
      width: min(1180px, 92%);
      margin: auto;
    }

    /* =========================================
       HEADER
    ========================================= */

    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(255,255,255,.95);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
    }

    .navbar {
      min-height: 72px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      font-weight: 800;
      font-size: 1.1rem;
    }

    .brand-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: var(--primary);
      color: white;
    }

    .nav-links {
      display: flex;
      gap: 22px;
      color: var(--muted);
      font-weight: 600;
    }

    .nav-links a:hover {
      color: var(--primary);
    }

    /* =========================================
       BUTTONS
    ========================================= */

    .btn {
      border: 0;
      border-radius: 11px;
      padding: 11px 17px;
      font-weight: 700;
      transition: .2s ease;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background: var(--primary-dark);
      transform: translateY(-1px);
    }

    .btn-secondary {
      background: white;
      color: var(--secondary);
      border: 1px solid var(--border);
    }

    .btn-secondary:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    .btn-danger {
      background: #fee2e2;
      color: var(--danger);
    }

    /* =========================================
       HERO
    ========================================= */

    .hero {
      padding: 75px 0 45px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr .85fr;
      gap: 45px;
      align-items: center;
    }

    .eyebrow {
      display: inline-block;
      color: var(--primary);
      font-size: .76rem;
      font-weight: 800;
      letter-spacing: .13em;
      margin-bottom: 12px;
    }

    .hero h1 {
      font-size: clamp(2.4rem, 6vw, 4.5rem);
      line-height: 1.05;
      letter-spacing: -.045em;
    }

    .hero h1 span {
      color: var(--primary);
    }

    .hero p {
      max-width: 650px;
      margin: 20px 0;
      color: var(--muted);
      font-size: 1.05rem;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 25px;
    }

    .hero-card {
      background: var(--secondary);
      color: white;
      border-radius: 24px;
      padding: 28px;
      box-shadow: var(--shadow);
    }

    .hero-card h3 {
      margin-bottom: 18px;
    }

    .mini-metric {
      display: flex;
      justify-content: space-between;
      padding: 13px 0;
      border-bottom: 1px solid #334155;
    }

    .mini-metric:last-child {
      border-bottom: 0;
    }

    .mini-metric span:first-child {
      color: #cbd5e1;
    }

    .mini-metric strong {
      color: #fff;
    }

    /* =========================================
       DASHBOARD
    ========================================= */

    .dashboard {
      padding: 25px 0 80px;
    }

    .section-heading {
      margin-bottom: 22px;
    }

    .section-heading h2 {
      font-size: 2rem;
      margin-bottom: 5px;
    }

    .section-heading p {
      color: var(--muted);
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 17px;
    }

    .metric-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 21px;
      box-shadow: var(--shadow);
    }

    .metric-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .metric-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: #eff6ff;
    }

    .metric-label {
      display: block;
      margin-top: 15px;
      color: var(--muted);
      font-size: .86rem;
      font-weight: 600;
    }

    .metric-value {
      display: block;
      font-size: 1.65rem;
      font-weight: 800;
      margin-top: 2px;
    }

    .metric-change {
      font-size: .8rem;
      color: var(--success);
      font-weight: 700;
    }

    /* =========================================
       BUSINESS PROFILE
    ========================================= */

    .profile-section {
      padding: 0 0 75px;
    }

    .profile-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 22px;
      box-shadow: var(--shadow);
      padding: 28px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .form-group.full {
      grid-column: 1 / -1;
    }

    label {
      font-weight: 700;
      font-size: .9rem;
    }

    input,
    select,
    textarea {
      width: 100%;
      padding: 12px 13px;
      border: 1px solid var(--border);
      border-radius: 11px;
      outline: none;
      background: white;
      color: var(--secondary);
    }

    textarea {
      min-height: 100px;
      resize: vertical;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37,99,235,.11);
    }

    .form-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 22px;
    }

    /* =========================================
       BUSINESS SECTIONS
    ========================================= */

    .business-sections {
      padding: 0 0 80px;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .info-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
      box-shadow: var(--shadow);
    }

    .info-icon {
      width: 45px;
      height: 45px;
      display: grid;
      place-items: center;
      background: #eff6ff;
      border-radius: 12px;
      margin-bottom: 15px;
    }

    .info-card h3 {
      margin-bottom: 7px;
    }

    .info-card p {
      color: var(--muted);
      font-size: .9rem;
      margin-bottom: 17px;
    }

    .list {
      display: grid;
      gap: 9px;
      list-style: none;
    }

    .list li {
      display: flex;
      gap: 8px;
      align-items: flex-start;
      font-size: .9rem;
    }

    /* =========================================
       ACTION PLAN
    ========================================= */

    .action-section {
      padding: 0 0 80px;
    }

    .action-layout {
      display: grid;
      grid-template-columns: 1fr .8fr;
      gap: 20px;
    }

    .action-card {
      background: white;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 25px;
      box-shadow: var(--shadow);
    }

    .action-list {
      display: grid;
      gap: 10px;
      margin-top: 15px;
    }

    .action-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 14px;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 12px;
    }

    .action-item input {
      width: 19px;
      height: 19px;
      accent-color: var(--primary);
      margin-top: 3px;
    }

    .action-item.completed {
      opacity: .6;
    }

    .action-item.completed strong {
      text-decoration: line-through;
    }

    .score-wrap {
      display: grid;
      place-items: center;
      text-align: center;
      min-height: 280px;
    }

    .score-circle {
      width: 170px;
      height: 170px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background:
        conic-gradient(
          var(--primary) 0deg,
          var(--primary) 252deg,
          #e2e8f0 252deg,
          #e2e8f0 360deg
        );
      position: relative;
    }

    .score-circle::after {
      content: "";
      position: absolute;
      width: 128px;
      height: 128px;
      background: white;
      border-radius: 50%;
    }

    .score-content {
      position: relative;
      z-index: 2;
    }

    .score-number {
      display: block;
      font-size: 2.3rem;
      font-weight: 900;
    }

    .score-label {
      color: var(--muted);
      font-size: .8rem;
    }

    /* =========================================
       MODAL
    ========================================= */

    .modal {
      position: fixed;
      inset: 0;
      z-index: 999;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(15,23,42,.62);
    }

    .modal.active {
      display: flex;
    }

    .modal-box {
      width: min(550px, 100%);
      background: white;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 30px 80px rgba(0,0,0,.25);
    }

    .modal-header {
      padding: 21px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }

    .close-modal {
      width: 38px;
      height: 38px;
      border: 0;
      border-radius: 10px;
      background: #f1f5f9;
    }

    .modal-body {
      padding: 25px;
      color: var(--muted);
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      padding: 18px 24px;
      border-top: 1px solid var(--border);
    }

    /* =========================================
       FOOTER
    ========================================= */

    footer {
      background: var(--secondary);
      color: white;
      padding: 45px 0 20px;
    }

    .footer-content {
      display: flex;
      justify-content: space-between;
      gap: 30px;
    }

    .footer-content p {
      color: #94a3b8;
      max-width: 550px;
      margin-top: 7px;
    }

    .footer-links {
      display: flex;
      gap: 20px;
      color: #cbd5e1;
    }

    .footer-links a:hover {
      color: white;
    }

    .footer-bottom {
      margin-top: 32px;
      padding-top: 18px;
      border-top: 1px solid #334155;
      display: flex;
      justify-content: space-between;
      color: #94a3b8;
      font-size: .85rem;
    }

    /* =========================================
       RESPONSIVE
    ========================================= */

    @media (max-width: 900px) {
      .hero-grid,
      .action-layout {
        grid-template-columns: 1fr;
      }

      .dashboard-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .cards-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 650px) {
      .nav-links {
        display: none;
      }

      .dashboard-grid,
      .cards-grid,
      .form-grid {
        grid-template-columns: 1fr;
      }

      .form-group.full {
        grid-column: auto;
      }

      .hero {
        padding-top: 50px;
      }

      .hero-actions,
      .form-actions {
        flex-direction: column;
      }

      .hero-actions .btn,
      .form-actions .btn {
        width: 100%;
      }

      .footer-content,
      .footer-bottom {
        flex-direction: column;
      }

      .footer-links {
        flex-wrap: wrap;
      }
    }

    @media print {
      header,
      .hero-actions,
      .profile-section,
      .business-sections,
      footer,
      .action-section .action-card:last-child {
        display: none !important;
      }

      body {
        background: white;
      }

      .dashboard {
        padding-top: 20px;
      }

      .metric-card,
      .action-card {
        box-shadow: none;
      }
    }
  </style>
</head>

<body>

  <!-- =========================================
       HEADER
  ========================================= -->

  <header>

    <div class="container navbar">

      <a
        href="#home"
        class="brand"
      >
        <span class="brand-icon">
          💼
        </span>

        <span>
          Business Director
        </span>
      </a>

      <nav class="nav-links">

        <a href="#dashboard">
          Dashboard
        </a>

        <a href="#profile">
          Business Profile
        </a>

        <a href="#strategy">
          Strategy
        </a>

        <a href="#actions">
          Action Plan
        </a>

      </nav>

    </div>

  </header>


  <main id="home">

    <!-- =========================================
         HERO
    ========================================= -->

    <section class="hero">

      <div class="container hero-grid">

        <div>

          <span class="eyebrow">
            BUSINESS MANAGEMENT
          </span>

          <h1>
            Lead Your Business
            <span>With Clarity.</span>
          </h1>

          <p>
            Business Director helps you organize
            your business goals, track key metrics,
            identify priorities and build a practical
            action plan.
          </p>

          <div class="hero-actions">

            <a
              href="#profile"
              class="btn btn-primary"
            >
              🚀 Set Up Business
            </a>

            <a
              href="#dashboard"
              class="btn btn-secondary"
            >
              View Dashboard
            </a>

          </div>

        </div>


        <div class="hero-card">

          <h3>
            Business Snapshot
          </h3>

          <div class="mini-metric">
            <span>Revenue Growth</span>
            <strong id="heroGrowth">+18%</strong>
          </div>

          <div class="mini-metric">
            <span>Customers</span>
            <strong id="heroCustomers">1,240</strong>
          </div>

          <div class="mini-metric">
            <span>Monthly Profit</span>
            <strong id="heroProfit">$8,450</strong>
          </div>

          <div class="mini-metric">
            <span>Business Health</span>
            <strong id="heroHealth">Good</strong>
          </div>

        </div>

      </div>

    </section>


    <!-- =========================================
         DASHBOARD
    ========================================= -->

    <section
      class="dashboard"
      id="dashboard"
    >

      <div class="container">

        <div class="section-heading">

          <span class="eyebrow">
            DASHBOARD
          </span>

          <h2>
            Business Overview
          </h2>

          <p>
            Monitor the numbers that matter most.
          </p>

        </div>


        <div class="dashboard-grid">

          <div class="metric-card">

            <div class="metric-top">

              <div class="metric-icon">
                💰
              </div>

              <span class="metric-change">
                +12.5%
              </span>

            </div>

            <span class="metric-label">
              Monthly Revenue
            </span>

            <strong
              class="metric-value"
              id="revenueMetric"
            >
              $24,500
            </strong>

          </div>


          <div class="metric-card">

            <div class="metric-top">

              <div class="metric-icon">
                📈
              </div>

              <span class="metric-change">
                +8.2%
              </span>

            </div>

            <span class="metric-label">
              Monthly Profit
            </span>

            <strong
              class="metric-value"
              id="profitMetric"
            >
              $8,450
            </strong>

          </div>


          <div class="metric-card">

            <div class="metric-top">

              <div class="metric-icon">
                👥
              </div>

              <span class="metric-change">
                +15%
              </span>

            </div>

            <span class="metric-label">
              Customers
            </span>

            <strong
              class="metric-value"
              id="customersMetric"
            >
              1,240
            </strong>

          </div>


          <div class="metric-card">

            <div class="metric-top">

              <div class="metric-icon">
                🎯
              </div>

              <span
                class="metric-change"
                id="goalMetric"
              >
                72%
              </span>

            </div>

            <span class="metric-label">
              Goal Progress
            </span>

            <strong
              class="metric-value"
              id="healthMetric"
            >
              Good
            </strong>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================
         BUSINESS PROFILE
    ========================================= -->

    <section
      class="profile-section"
      id="profile"
    >

      <div class="container">

        <div class="section-heading">

          <span class="eyebrow">
            BUSINESS PROFILE
          </span>

          <h2>
            Define Your Business
          </h2>

          <p>
            Add your business information to
            personalize your dashboard.
          </p>

        </div>


        <div class="profile-card">

          <form id="businessForm">

            <div class="form-grid">

              <div class="form-group">

                <label for="businessName">
                  Business Name
                </label>

                <input
                  id="businessName"
                  type="text"
                  placeholder="e.g. Bright Solutions"
                  required
                >

              </div>


              <div class="form-group">

                <label for="industry">
                  Industry
                </label>

                <select id="industry">

                  <option>
                    Technology
                  </option>

                  <option>
                    Retail
                  </option>

                  <option>
                    Finance
                  </option>

                  <option>
                    Education
                  </option>

                  <option>
                    Healthcare
                  </option>

                  <option>
                    Food & Hospitality
                  </option>

                  <option>
                    Consulting
                                    </option>

                  <option>
                    Real Estate
                  </option>

                  <option>
                    Manufacturing
                  </option>

                  <option>
                    Agriculture
                  </option>

                  <option>
                    Transportation
                  </option>

                  <option>
                    Media & Entertainment
                  </option>

                  <option>
                    Construction
                  </option>

                  <option>
                    Professional Services
                  </option>

                  <option>
                    Other
                  </option>

                </select>

              </div>


              <div class="form-group">

                <label for="revenue">
                  Monthly Revenue
                </label>

                <input
                  id="revenue"
                  type="number"
                  min="0"
                  placeholder="25000"
                  value="24500"
                >

              </div>


              <div class="form-group">

                <label for="expenses">
                  Monthly Expenses
                </label>

                <input
                  id="expenses"
                  type="number"
                  min="0"
                  placeholder="16000"
                  value="16050"
                >

              </div>


              <div class="form-group">

                <label for="customers">
                  Number of Customers
                </label>

                <input
                  id="customers"
                  type="number"
                  min="0"
                  placeholder="1200"
                  value="1240"
                >

              </div>


              <div class="form-group">

                <label for="employees">
                  Employees
                </label>

                <input
                  id="employees"
                  type="number"
                  min="0"
                  placeholder="10"
                  value="8"
                >

              </div>


              <div class="form-group full">

                <label for="businessGoal">
                  Main Business Goal
                </label>

                <textarea
                  id="businessGoal"
                  placeholder="Example: Increase monthly revenue by 30% within six months."
                >Increase monthly revenue and improve customer retention.</textarea>

              </div>

            </div>


            <div class="form-actions">

              <button
                type="reset"
                class="btn btn-secondary"
              >
                Reset
              </button>

              <button
                type="submit"
                class="btn btn-primary"
              >
                Save Business Profile
              </button>

            </div>

          </form>

        </div>

      </div>

    </section>


    <!-- =========================================
         STRATEGY
    ========================================= -->

    <section
      class="business-sections"
      id="strategy"
    >

      <div class="container">

        <div class="section-heading">

          <span class="eyebrow">
            STRATEGY
          </span>

          <h2>
            Business Director Areas
          </h2>

          <p>
            Focus on the areas that drive business
            performance.
          </p>

        </div>


        <div class="cards-grid">

          <article class="info-card">

            <div class="info-icon">
              🎯
            </div>

            <h3>
              Strategy
            </h3>

            <p>
              Decide where the business should go
              and how to get there.
            </p>

            <ul class="list">

              <li>
                <span>✓</span>
                <span>Define measurable goals</span>
              </li>

              <li>
                <span>✓</span>
                <span>Identify competitive advantages</span>
              </li>

              <li>
                <span>✓</span>
                <span>Prioritize high-impact projects</span>
              </li>

            </ul>

          </article>


          <article class="info-card">

            <div class="info-icon">
              📣
            </div>

            <h3>
              Marketing
            </h3>

            <p>
              Build a reliable system for attracting
              and retaining customers.
            </p>

            <ul class="list">

              <li>
                <span>✓</span>
                <span>Define target customers</span>
              </li>

              <li>
                <span>✓</span>
                <span>Improve your value proposition</span>
              </li>

              <li>
                <span>✓</span>
                <span>Measure campaign performance</span>
              </li>

            </ul>

          </article>


          <article class="info-card">

            <div class="info-icon">
              💵
            </div>

            <h3>
              Finance
            </h3>

            <p>
              Keep revenue, costs, cash flow and
              profitability under control.
            </p>

            <ul class="list">

              <li>
                <span>✓</span>
                <span>Monitor monthly profit</span>
              </li>

              <li>
                <span>✓</span>
                <span>Control operating expenses</span>
