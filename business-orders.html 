<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Business Orders</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
  --primary:#2563eb;
  --primary-dark:#1d4ed8;
  --dark:#0f172a;
  --text:#172033;
  --muted:#64748b;
  --bg:#f5f7fb;
  --white:#fff;
  --border:#e2e8f0;
  --danger:#dc2626;
  --success:#16a34a;
  --warning:#d97706;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--bg);
  color:var(--text);
}

.container{
  width:min(1150px,92%);
  margin:auto;
}

header{
  background:#fff;
  border-bottom:1px solid var(--border);
  position:sticky;
  top:0;
  z-index:50;
}

.nav{
  min-height:70px;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo{
  display:flex;
  align-items:center;
  gap:10px;
  font-weight:800;
}

.logo-icon{
  width:42px;
  height:42px;
  display:grid;
  place-items:center;
  border-radius:11px;
  background:var(--primary);
  color:#fff;
}

.nav-links{
  display:flex;
  gap:20px;
}

.nav-links a{
  text-decoration:none;
  color:var(--muted);
  font-size:14px;
  font-weight:700;
}

main{
  padding:35px 0 60px;
}

.hero{
  margin-bottom:25px;
}

.eyebrow{
  color:var(--primary);
  font-size:12px;
  font-weight:800;
  letter-spacing:.12em;
}

h1{
  margin-top:5px;
  font-size:clamp(28px,5vw,42px);
}

.hero p{
  color:var(--muted);
  margin-top:7px;
}

.status{
  padding:12px 15px;
  border-radius:10px;
  background:#eff6ff;
  color:#1d4ed8;
  font-size:13px;
  font-weight:700;
  margin-bottom:22px;
}

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
  margin-bottom:22px;
}

.stat{
  background:#fff;
  border:1px solid var(--border);
  border-radius:15px;
  padding:20px;
  box-shadow:0 8px 25px #00000008;
}

.stat-icon{
  width:40px;
  height:40px;
  display:grid;
  place-items:center;
  border-radius:10px;
  background:#eff6ff;
}

.stat-label{
  display:block;
  color:var(--muted);
  font-size:12px;
  margin-top:13px;
}

.stat-value{
  display:block;
  font-size:25px;
  margin-top:3px;
}

.card{
  background:#fff;
  border:1px solid var(--border);
  border-radius:16px;
  padding:23px;
  margin-bottom:22px;
  box-shadow:0 8px 25px #00000008;
}

.card h2{
  font-size:19px;
  margin-bottom:5px;
}

.card-sub{
  color:var(--muted);
  font-size:13px;
  margin-bottom:20px;
}

.form-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:15px;
}

.form-group{
  display:flex;
  flex-direction:column;
  gap:6px;
}

.full{
  grid-column:1/-1;
}

label{
  font-size:13px;
  font-weight:800;
}

input,select,textarea{
  width:100%;
  padding:12px;
  border:1px solid var(--border);
  border-radius:9px;
  outline:none;
  font:inherit;
  background:#fff;
}

input:focus,select:focus,textarea:focus{
  border-color:var(--primary);
  box-shadow:0 0 0 3px #2563eb18;
}

textarea{
  min-height:85px;
  resize:vertical;
}

.buttons{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top:20px;
}

button{
  border:0;
  border-radius:9px;
  padding:11px 17px;
  cursor:pointer;
  font:inherit;
  font-weight:800;
}

.primary{
  background:var(--primary);
  color:#fff;
}

.primary:hover{
  background:var(--primary-dark);
}

.secondary{
  background:#eef2f7;
  color:var(--text);
}

.danger{
  background:#fee2e2;
  color:#b91c1c;
}

.toolbar{
  display:grid;
  grid-template-columns:1fr 200px;
  gap:12px;
  margin-bottom:20px;
}

.orders{
  display:grid;
  gap:14px;
}

.order{
  border:1px solid var(--border);
  border-radius:14px;
  padding:18px;
  background:#fff;
}

.order-top{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:15px;
}

.order-id{
  font-size:17px;
  font-weight:900;
}

.order-customer{
  color:var(--muted);
  font-size:13px;
  margin-top:4px;
}

.badge{
  padding:6px 10px;
  border-radius:20px;
  font-size:11px;
  font-weight:800;
  white-space:nowrap;
}

.pending{
  background:#fef3c7;
  color:#92400e;
}

.processing{
  background:#dbeafe;
  color:#1d4ed8;
}

.completed{
  background:#dcfce7;
  color:#166534;
}

.cancelled{
  background:#fee2e2;
  color:#991b1b;
}

.order-info{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
  margin-top:16px;
}

.info-box{
  padding:11px;
  background:#f8fafc;
  border-radius:9px;
}

.info-box small{
  display:block;
  color:var(--muted);
  font-size:10px;
}

.info-box strong{
  display:block;
  margin-top:3px;
  font-size:13px;
}

.order-notes{
  margin-top:12px;
  color:var(--muted);
  font-size:12px;
}

.order-actions{
  display:flex;
  gap:8px;
  margin-top:15px;
}

.small-btn{
  padding:9px 13px;
  font-size:12px;
}

.empty{
  text-align:center;
  padding:35px;
  color:var(--muted);
  border:1px dashed var(--border);
  border-radius:12px;
}

footer{
  background:var(--dark);
  color:#fff;
  padding:30px 0;
}

.footer{
  display:flex;
  justify-content:space-between;
  gap:20px;
}

.footer p{
  color:#94a3b8;
  font-size:12px;
}

@media(max-width:900px){
  .stats{
    grid-template-columns:repeat(2,1fr);
  }

  .order-info{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:650px){
  .nav-links{
    display:none;
  }

  .stats{
    grid-template-columns:1fr;
  }

  .form-grid{
    grid-template-columns:1fr;
  }

  .full{
    grid-column:auto;
  }

  .toolbar{
    grid-template-columns:1fr;
  }

  .order-info{
    grid-template-columns:1fr;
  }

  .order-top{
    flex-direction:column;
  }

  .footer{
    flex-direction:column;
  }
}
</style>
</head>

<body>

<header>
<div class="container nav">

<div class="logo">
<div class="logo-icon">🛒</div>
<span>Business Orders</span>
</div>

<nav class="nav-links">
<a href="#overview">Overview</a>
<a href="#add">New Order</a>
<a href="#orders">Orders</a>
</nav>

</div>
</header>


<main class="container">

<section class="hero">
<span class="eyebrow">ORDER MANAGEMENT</span>
<h1>Business Orders</h1>
<p>
Create, track and manage customer orders.
</p>
</section>


<div
id="status"
class="status"
>
Connecting to Firebase...
</div>


<!-- STATS -->

<section class="stats" id="overview">

<div class="stat">
<div class="stat-icon">🛒</div>
<span class="stat-label">Total Orders</span>
<strong class="stat-value" id="totalOrders">0</strong>
</div>

<div class="stat">
<div class="stat-icon">⏳</div>
<span class="stat-label">Pending</span>
<strong class="stat-value" id="pendingOrders">0</strong>
</div>

<div class="stat">
<div class="stat-icon">✅</div>
<span class="stat-label">Completed</span>
<strong class="stat-value" id="completedOrders">0</strong>
</div>

<div class="stat">
<div class="stat-icon">💰</div>
<span class="stat-label">Order Revenue</span>
<strong class="stat-value" id="totalRevenue">$0.00</strong>
</div>

</section>


<!-- ADD ORDER -->

<section class="card" id="add">

<h2 id="formTitle">Create Order</h2>

<p class="card-sub">
Enter customer and order information.
</p>

<form id="orderForm">

<div class="form-grid">

<div class="form-group">
<label for="customerName">
Customer Name *
</label>

<input
id="customerName"
required
placeholder="John Doe"
>
</div>


<div class="form-group">
<label for="customerEmail">
Customer Email
</label>

<input
id="customerEmail"
type="email"
placeholder="john@example.com"
>
</div>


<div class="form-group">
<label for="itemName">
Product / Service *
</label>

<input
id="itemName"
required
placeholder="Website Design"
>
</div>


<div class="form-group">
<label for="quantity">
Quantity *
</label>

<input
id="quantity"
type="number"
min="1"
value="1"
required
>
</div>


<div class="form-group">
<label for="price">
Unit Price *
</label>

<input
id="price"
type="number"
min="0"
step="0.01"
required
placeholder="100"
>
</div>


<div class="form-group">
<label for="statusSelect">
Order Status *
</label>

<select id="statusSelect" required>

<option value="Pending">
Pending
</option>

<option value="Processing">
Processing
</option>

<option value="Completed">
Completed
</option>

<option value="Cancelled">
Cancelled
</option>

</select>

</div>


<div class="form-group">
<label for="orderDate">
Order Date *
</label>

<input
id="orderDate"
type="date"
required
>
</div>


<div class="form-group">
<label for="payment">
Payment Status
</label>

<select id="payment">

<option value="Unpaid">
Unpaid
</option>

<option value="Paid">
Paid
</option>

<option value="Partial">
Partial
</option>

</select>

</div>


<div class="form-group full">

<label for="notes">
Notes
</label>

<textarea
id="notes"
placeholder="Delivery information, special instructions..."
></textarea>

</div>

</div>


<div class="buttons">

<button
type="submit"
class="primary"
id="saveBtn"
>
➕ Create Order
</button>

<button
type="button"
class="secondary"
id="cancelBtn"
style="display:none"
>
Cancel Edit
</button>

<button
type="reset"
class="secondary"
>
Reset
</button>

</div>

</form>

</section>


<!-- ORDERS -->

<section class="card" id="orders">

<h2>Order Directory</h2>

<p class="card-sub">
Search and filter your business orders.
</p>


<div class="toolbar">

<input
id="search"
placeholder="🔎 Search order, customer or item..."
>

<select id="filterStatus">

<option value="">
All Statuses
</option>

<option value="Pending">
Pending
</option>

<option value="Processing">
Processing
</option>

<option value="Completed">
Completed
</option>

<option value="Cancelled">
Cancelled
</option>

</select>

</div>


<div
class="orders"
id="orderList"
>

<div class="empty">
Loading orders...
</div>

</div>

</section>

</main>


<footer>

<div class="container footer">

<strong>🛒 Business Orders</strong>

<p>
© <span id="year"></span> Business Orders
</p>

</div>

</footer>


<script type="module">

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

import {
getFirestore,
collection,
addDoc,
doc,
updateDoc,
deleteDoc,
onSnapshot,
serverTimestamp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


/* =========================
   FIREBASE CONFIG
========================= */

const firebaseConfig = {

apiKey:
"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};


/* =========================
   INITIALIZE
========================= */

const app =
initializeApp(firebaseConfig);

const db =
getFirestore(app);

const ordersRef =
collection(
db,
"businessOrders"
);


/* =========================
   ELEMENTS
========================= */

const form =
document.getElementById(
"orderForm"
);

const orderList =
document.getElementById(
"orderList"
);

const statusBox =
document.getElementById(
"status"
);

const saveBtn =
document.getElementById(
"saveBtn"
);

const cancelBtn =
document.getElementById(
"cancelBtn"
);

const search =
document.getElementById(
"search"
);

const filterStatus =
document.getElementById(
"filterStatus"
);

let orders = [];
let editingId = null;


/* =========================
   DEFAULT DATE
========================= */

document.getElementById(
"orderDate"
).value =
new Date()
.toISOString()
.slice(0,10);


/* =========================
   STATUS MESSAGE
========================= */

function setStatus(
text,
error = false
){

statusBox.textContent = text;

statusBox.style.background =
error
? "#fee2e2"
: "#eff6ff";

statusBox.style.color =
error
? "#b91c1c"
: "#1d4ed8";

}


/* =========================
   FORM DATA
========================= */

function getFormData(){

const quantity =
Number(
document.getElementById(
"quantity"
).value
)||1;

const price =
Number(
document.getElementById(
"price"
).value
)||0;


return {

customerName:
document.getElementById(
"customerName"
).value.trim(),

customerEmail:
document.getElementById(
"customerEmail"
).value.trim(),

itemName:
document.getElementById(
"itemName"
).value.trim(),

quantity,

price,

total:
quantity * price,

status:
document.getElementById(
"statusSelect"
).value,

orderDate:
document.getElementById(
"orderDate"
).value,

payment:
document.getElementById(
"payment"
).value,

notes:
document.getElementById(
"notes"
).value.trim()

};

}


/* =========================
   CREATE / UPDATE
========================= */

form.addEventListener(
"submit",
async event => {

event.preventDefault();

const data =
getFormData();


if(
!data.customerName ||
!data.itemName
){

setStatus(
"Customer name and product/service are required.",
true
);

return;

}


try{

saveBtn.disabled = true;

saveBtn.textContent =
editingId
? "Updating..."
: "Creating...";


if(editingId){

await updateDoc(

doc(
db,
"businessOrders",
editingId
),

{
...data,
updatedAt:
serverTimestamp()
}

);

setStatus(
"Order updated successfully."
);

}else{

const orderCode =
"ORD-" +
Date.now()
.toString()
.slice(-8);


await addDoc(

ordersRef,

{
...data,
orderCode,
createdAt:
serverTimestamp(),
updatedAt:
serverTimestamp()
}

);

setStatus(
"Order created successfully."
);

}


form.reset();

editingId = null;

document.getElementById(
"orderDate"
).value =
new Date()
.toISOString()
.slice(0,10);

document.getElementById(
"formTitle"
).textContent =
"Create Order";

saveBtn.textContent =
"➕ Create Order";

cancelBtn.style.display =
"none";


}catch(error){

console.error(error);

setStatus(
"Operation failed: " +
error.message,
true
);

}finally{

saveBtn.disabled = false;

if(!editingId){

saveBtn.textContent =
"➕ Create Order";

}

}

});


/* =========================
   REAL-TIME FIRESTORE
========================= */

onSnapshot(

ordersRef,

snapshot => {

orders = [];

snapshot.forEach(
item => {

orders.push({

id:item.id,
...item.data()

});

});

renderOrders();
updateStats();

setStatus(
`${orders.length} order(s) loaded from Firestore.`
);

},

error => {

console.error(error);

setStatus(
"Firestore error: " +
error.message,
true
);

}

);


/* =========================
   RENDER ORDERS
========================= */

function renderOrders(){

const query =
search.value
.trim()
.toLowerCase();

const selectedStatus =
filterStatus.value;


const filtered =
orders.filter(
order => {

const searchable = [

order.orderCode,
order.customerName,
order.customerEmail,
order.itemName,
order.payment

]
.join(" ")
.toLowerCase();


const matchesSearch =
searchable.includes(query);


const matchesStatus =
!selectedStatus ||
order.status === selectedStatus;


return (
matchesSearch &&
matchesStatus
);

});


if(!filtered.length){

orderList.innerHTML = `
<div class="empty">
No orders found.
</div>
`;

return;

}


orderList.innerHTML =
filtered.map(
order => {

const statusClass =
getStatusClass(
order.status
);


return `

<article class="order">

<div class="order-top">

<div>

<div class="order-id">
${escapeHTML(
order.orderCode ||
"ORDER"
)}
</div>

<div class="order-customer">
${escapeHTML(
order.customerName ||
"Unknown Customer"
)}

${order.customerEmail
? " · " +
escapeHTML(order.customerEmail)
: ""}

</div>

</div>


<span class="badge ${statusClass}">
${escapeHTML(
order.status ||
"Pending"
)}
</span>

</div>


<div class="order-info">

<div class="info-box">

<small>Product / Service</small>

<strong>
${escapeHTML(
order.itemName ||
"—"
)}
</strong>

</div>


<div class="info-box">

<small>Quantity</small>

<strong>
${Number(
order.quantity || 0
).toLocaleString()}
</strong>

</div>


<div class="info-box">

<small>Total</small>

<strong>
${money(order.total)}
</strong>

</div>


<div class="info-box">

<small>Payment</small>

<strong>
${escapeHTML(
order.payment ||
"Unpaid"
)}
</strong>

</div>

</div>


<div class="order-info">

<div class="info-box">

<small>Unit Price</small>

<strong>
${money(order.price)}
</strong>

</div>


<div class="info-box">

<small>Order Date</small>

<strong>
${escapeHTML(
order.orderDate ||
"—"
)}
</strong>

</div>


<div class="info-box">

<small>Customer Email</small>

<strong>
${escapeHTML(
order.customerEmail ||
"—"
)}
</strong>

</div>


<div class="info-box">

<small>Payment Status</small>

<strong>
${escapeHTML(
order.payment ||
"Unpaid"
)}
</strong>

</div>

</div>


${
order.notes
? `
<div class="order-notes">
📝 ${escapeHTML(order.notes)}
</div>
`
: ""
}


<div class="order-actions">

<button
class="secondary small-btn"
data-edit="${order.id}"
>
✏️ Edit
</button>

<button
class="danger small-btn"
data-delete="${order.id}"
>
🗑️ Delete
</button>

</div>

</article>

`;

}
).join("");


document
.querySelectorAll("[data-edit]")
.forEach(button => {

button.addEventListener(
"click",
() => editOrder(
button.dataset.edit
)
);

});


document
.querySelectorAll("[data-delete]")
.forEach(button => {

button.addEventListener(
"click",
() => deleteOrder(
button.dataset.delete
)
);

});

}


/* =========================
   STATUS CLASS
========================= */

function getStatusClass(status){

if(status === "Processing")
return "processing";

if(status === "Completed")
return "completed";

if(status === "Cancelled")
return "cancelled";

return "pending";

}


/* =========================
   EDIT
========================= */

function editOrder(id){

const order =
orders.find(
item => item.id === id
);

if(!order)return;


document.getElementById(
"customerName"
).value =
order.customerName || "";

document.getElementById(
"customerEmail"
).value =
order.customerEmail || "";

document.getElementById(
"itemName"
).value =
order.itemName || "";

document.getElementById(
"quantity"
).value =
order.quantity || 1;

document.getElementById(
"price"
).value =
order.price || 0;

document.getElementById(
"statusSelect"
).value =
order.status || "Pending";

document.getElementById(
"orderDate"
).value =
order.orderDate ||
new Date()
.toISOString()
.slice(0,10);

document.getElementById(
"payment"
).value =
order.payment || "Unpaid";

document.getElementById(
"notes"
).value =
order.notes || "";


editingId = id;


document.getElementById(
"formTitle"
).textContent =
"Edit Order";

saveBtn.textContent =
"💾 Update Order";

cancelBtn.style.display =
"inline-block";


document
.getElementById("add")
.scrollIntoView({
behavior:"smooth"
});

}


/* =========================
   CANCEL EDIT
========================= */

cancelBtn.addEventListener(
"click",
() => {

editingId = null;

form.reset();

document.getElementById(
"orderDate"
).value =
new Date()
.toISOString()
.slice(0,10);

document.getElementById(
"formTitle"
).textContent =
"Create Order";

saveBtn.textContent =
"➕ Create Order";

cancelBtn.style.display =
"none";

}
);


/* =========================
   DELETE
========================= */

async function deleteOrder(id){

const order =
orders.find(
item => item.id === id
);

if(!order)return;


const confirmed =
confirm(
`Delete order "${order.orderCode}"?`
);

if(!confirmed)return;


try{

await deleteDoc(

doc(
db,
"businessOrders",
id
)

);

setStatus(
"Order deleted successfully."
);

}catch(error){

console.error(error);

setStatus(
"Could not delete order: " +
error.message,
true
);

}

}


/* =========================
   SEARCH / FILTER
========================= */

search.addEventListener(
"input",
renderOrders
);

filterStatus.addEventListener(
"change",
