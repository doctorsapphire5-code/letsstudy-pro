              </option>

              <option>
                Growing
              </option>

              <option>
                Established
              </option>

            </select>

          </div>


          <div class="form-group full">

            <label for="businessDescription">
              Business Description
            </label>

            <textarea
              id="businessDescription"
              placeholder="What does your business do?"
            ></textarea>

          </div>


        </div>

      </section>


      <!-- EXECUTIVE SUMMARY -->

      <section class="card">

        <h2>
          📋 Executive Summary
        </h2>

        <p class="section-description">
          Explain the business opportunity and
          what you want to achieve.
        </p>


        <div class="form-group">

          <label for="executiveSummary">
            Executive Summary
