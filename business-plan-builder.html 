<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width,initial-scale=1.0"
  >

  <title>Business Plan Builder | LetsStudy Pro</title>

  <meta
    name="description"
    content="Create, save and manage professional business plans with LetsStudy Pro."
  >

  <style>

    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
    }

    body{
      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background:#f5f7fb;
      color:#172033;

      line-height:1.6;
    }

    button,
    input,
    textarea,
    select{
      font:inherit;
    }

    button{
      cursor:pointer;
    }

    a{
      color:inherit;
      text-decoration:none;
    }


    /* =========================
       HEADER
    ========================= */

    header{
      position:sticky;
      top:0;
      z-index:100;

      background:#fff;

      border-bottom:
        1px solid #e5e9f0;

      padding:
        14px 5%;

      display:flex;
      align-items:center;
      justify-content:space-between;

      gap:20px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:11px;
    }

    .brand-icon{
      width:43px;
      height:43px;

      border-radius:12px;

      background:#4f46e5;
      color:#fff;

      display:grid;
      place-items:center;

      font-size:21px;
    }

    .brand-name{
      font-weight:850;
      font-size:17px;
    }

    .brand-sub{
      color:#7b8799;
      font-size:11px;
    }

    .header-actions{
      display:flex;
      gap:8px;
    }

    .icon-btn{
      width:42px;
      height:42px;

      border:
        1px solid #dfe4ec;

      background:#fff;

      border-radius:10px;
    }


    /* =========================
       MAIN
    ========================= */

    main{
      width:min(1200px,92%);

      margin:
        30px auto 70px;
    }


    .page-heading{
      margin-bottom:25px;
    }

    .page-heading h1{
      font-size:34px;

      letter-spacing:-.7px;

      margin-bottom:6px;
    }

    .page-heading p{
      color:#718096;

      font-size:14px;
    }


    /* =========================
       BUILDER
    ========================= */

    .builder{
      display:grid;

      grid-template-columns:
        1fr 390px;

      gap:22px;
    }


    .card{
      background:#fff;

      border:
        1px solid #e5e9f0;

      border-radius:18px;

      padding:25px;

      margin-bottom:20px;

      box-shadow:
        0 10px 35px
        rgba(15,23,42,.04);
    }


    .card h2{
      font-size:19px;

      margin-bottom:18px;
    }


    .section-description{
      color:#7b8799;

      font-size:12px;

      margin-top:-10px;

      margin-bottom:18px;
    }


    /* =========================
       FORM
    ========================= */

    .form-grid{
      display:grid;

      grid-template-columns:
        repeat(2,minmax(0,1fr));

      gap:17px;
    }


    .form-group{
      display:flex;

      flex-direction:column;

      gap:7px;
    }


    .form-group.full{
      grid-column:
        1 / -1;
    }


    label{
      font-size:12px;

      font-weight:800;

      color:#445066;
    }


    input,
    textarea,
    select{

      width:100%;

      border:
        1px solid #dfe4ec;

      background:#fff;

      color:#172033;

      border-radius:10px;

      padding:
        12px 13px;

      outline:none;

      transition:
        border-color .2s,
        box-shadow .2s;
    }


    input:focus,
    textarea:focus,
    select:focus{

      border-color:#6366f1;

      box-shadow:
        0 0 0 3px
        rgba(99,102,241,.10);
    }


    textarea{
      resize:vertical;

      min-height:120px;
    }


    .hint{
      color:#8994a6;

      font-size:10px;
    }


    /* =========================
       BUTTONS
    ========================= */

    .actions{
      display:flex;

      flex-wrap:wrap;

      gap:10px;

      margin-top:20px;
    }


    .btn{
      border:0;

      border-radius:10px;

      padding:
        12px 17px;

      font-weight:800;

      font-size:13px;

      display:inline-flex;

      align-items:center;

      justify-content:center;

      gap:8px;
    }


    .btn-primary{
      background:#4f46e5;
      color:#fff;
    }


    .btn-secondary{
      background:#eef2ff;
      color:#4338ca;
    }


    .btn-light{
      background:#f3f4f6;
      color:#374151;
    }


    .btn-danger{
      background:#fee2e2;
      color:#b91c1c;
    }


    /* =========================
       PREVIEW
    ========================= */

    .preview-wrapper{
      position:sticky;

      top:90px;
    }


    .preview{
      background:#fff;

      border:
        1px solid #e5e9f0;

      border-radius:18px;

      overflow:hidden;

      box-shadow:
        0 15px 45px
        rgba(15,23,42,.06);
    }


    .preview-header{
      background:#4f46e5;

      color:#fff;

      padding:27px;
    }


    .preview-header small{
      opacity:.8;

      font-size:10px;

      text-transform:uppercase;

      letter-spacing:1px;
    }


    .preview-header h2{
      font-size:25px;

      line-height:1.2;

      margin-top:7px;
    }


    .preview-body{
      padding:23px;
    }


    .preview-section{
      margin-bottom:20px;
    }


    .preview-section h3{
      font-size:12px;

      text-transform:uppercase;

      letter-spacing:.5px;

      color:#4f46e5;

      margin-bottom:7px;
    }


    .preview-section p{
      color:#59667a;

      font-size:12px;

      white-space:pre-line;
    }


    .preview-grid{
      display:grid;

      grid-template-columns:
        repeat(2,1fr);

      gap:9px;
    }


    .preview-item{
      background:#f8fafc;

      border:
        1px solid #edf0f4;

      border-radius:9px;

      padding:10px;
    }


    .preview-item span{
      display:block;

      color:#8994a6;

      font-size:9px;

      text-transform:uppercase;
    }


    .preview-item strong{
      display:block;

      font-size:11px;

      margin-top:2px;
    }


    /* =========================
       STATUS
    ========================= */

    .status{
      display:none;

      padding:
        11px 13px;

      border-radius:10px;

      margin-bottom:18px;

      font-size:12px;

      font-weight:700;
    }


    .status.show{
      display:block;
    }


    .status.success{
      background:#dcfce7;

      color:#166534;
    }


    .status.error{
      background:#fee2e2;

      color:#991b1b;
    }


    /* =========================
       TOAST
    ========================= */

    .toast{
      position:fixed;

      left:50%;
      bottom:25px;

      transform:
        translate(-50%,20px);

      opacity:0;

      background:#172033;

      color:#fff;

      padding:
        11px 18px;

      border-radius:10px;

      font-size:12px;

      font-weight:750;

      pointer-events:none;

      transition:.25s;

      z-index:500;
    }


    .toast.show{
      opacity:1;

      transform:
        translate(-50%,0);
    }


    /* =========================
       RESPONSIVE
    ========================= */

    @media(max-width:950px){

      .builder{
        grid-template-columns:1fr;
      }

      .preview-wrapper{
        position:static;
      }

    }


    @media(max-width:600px){

      main{
        width:94%;
      }

      .page-heading h1{
        font-size:28px;
      }

      .form-grid{
        grid-template-columns:1fr;
      }

      .form-group.full{
        grid-column:auto;
      }

      .actions{
        flex-direction:column;
      }

      .btn{
        width:100%;
      }

    }

  </style>

</head>


