          <textarea
            id="executiveSummary"
            placeholder="Summarize your business, customers, opportunity and goals..."
          ></textarea>

        </div>

      </section>


      <!-- PROBLEM & SOLUTION -->

      <section class="card">

        <h2>
          💡 Problem & Solution
        </h2>


        <div class="form-grid">


          <div class="form-group">

            <label for="problem">
              Problem
            </label>

            <textarea
              id="problem"
              placeholder="What problem are customers facing?"
            ></textarea>

          </div>


          <div class="form-group">

            <label for="solution">
              Solution
            </label>

            <textarea
              id="solution"
              placeholder="How does your business solve the problem?"
            ></textarea>

          </div>


        </div>

      </section>


      <!-- TARGET MARKET -->

      <section class="card">

        <h2>
          🎯 Target Market
        </h2>


        <div class="form-grid">


          <div class="form-group">

            <label for="targetCustomers">
              Target Customers
            </label>

            <textarea
              id="targetCustomers"
              placeholder="Who are your ideal customers?"
            ></textarea>

          </div>


          <div class="form-group">

            <label for="marketSize">
              Market Size
            </label>

            <textarea
              id="marketSize"
              placeholder="Describe the size and opportunity of your market."
            ></textarea>

          </div>


          <div class="form-group full">

            <label for="competitors">
              Competitors
            </label>

            <textarea
              id="competitors"
              placeholder="Who are your main competitors?"
            ></textarea>

          </div>


        </div>

      </section>


      <!-- PRODUCTS -->

      <section class="card">

        <h2>
          🛍️ Products & Services
        </h2>


        <div class="form-grid">


          <div class="form-group full">

            <label for="products">
              Products / Services
            </label>

            <textarea
              id="products"
              placeholder="Describe your main products or services."
            ></textarea>

          </div>


          <div class="form-group">

            <label for="pricing">
              Pricing Strategy
            </label>

            <textarea
              id="pricing"
              placeholder="How will you price your products?"
            ></textarea>

          </div>


          <div class="form-group">

            <label for="revenueModel">
              Revenue Model
            </label>

            <textarea
              id="revenueModel"
              placeholder="How will the business make money?"
            ></textarea>

          </div>


        </div>

      </section>


      <!-- MARKETING -->

      <section class="card">

        <h2>
          📣 Marketing & Sales
        </h2>


        <div class="form-grid">


          <div class="form-group">

            <label for="marketingStrategy">
              Marketing Strategy
            </label>

            <textarea
              id="marketingStrategy"
              placeholder="How will customers discover your business?"
            ></textarea>

          </div>


          <div class="form-group">

            <label for="salesStrategy">
              Sales Strategy
            </label>

            <textarea
              id="salesStrategy"
              placeholder="How will you convert prospects into customers?"
            ></textarea>

          </div>


          <div class="form-group full">

            <label for="channels">
              Marketing Channels
            </label>

            <input
              type="text"
              id="channels"
              placeholder="e.g. Instagram, TikTok, SEO, WhatsApp, Email"
            >

          </div>


        </div>

      </section>


      <!-- OPERATIONS -->

      <section class="card">

        <h2>
          ⚙️ Operations
        </h2>


        <div class="form-group">

          <label for="operations">
            Operational Plan
          </label>

          <textarea
            id="operations"
            placeholder="Describe how the business will operate day-to-day."
          ></textarea>

        </div>

      </section>


      <!-- TEAM -->

      <section class="card">

        <h2>
          👥 Team
        </h2>


        <div class="form-grid">


          <div class="form-group">

            <label for="founder">
              Founder / Owner
            </label>

            <input
              type="text"
              id="founder"
              placeholder="Founder name"
            >

          </div>


          <div class="form-group">

            <label for="teamSize">
              Team Size
            </label>

            <input
              type="number"
              id="teamSize"
              min="1"
              placeholder="e.g. 5"
            >

          </div>


          <div class="form-group full">

            <label for="teamDescription">
              Team Description
            </label>

            <textarea
              id="teamDescription"
              placeholder="Describe key team members and their responsibilities."
            ></textarea>

          </div>


        </div>

      </section>


      <!-- FINANCIAL PLAN -->

      <section class="card">

        <h2>
          💰 Financial Plan
        </h2>

        <p class="section-description">
          Enter estimated figures. You can update
          them as your business develops.
        </p>


        <div class="form-grid">


          <div class="form-group">

            <label for="startupCost">
              Estimated Startup Cost
            </label>

            <input
              type="number"
              id="startupCost"
              min="0"
              placeholder="e.g. 5000000"
            >

          </div>


          <div class="form-group">

            <label for="monthlyRevenue">
              Expected Monthly Revenue
            </label>

            <input
              type="number"
              id="monthlyRevenue"
              min="0"
              placeholder="e.g. 2000000"
            >

          </div>


          <div class="form-group">

            <label for="monthlyExpenses">
              Expected Monthly Expenses
            </label>

            <input
              type="number"
              id="monthlyExpenses"
              min="0"
              placeholder="e.g. 1200000"
            >

          </div>


          <div class="form-group">

            <label for="fundingRequired">
              Funding Required
            </label>

            <input
              type="number"
              id="fundingRequired"
              min="0"
              placeholder="e.g. 10000000"
            >

          </div>


        </div>

      </section>


      <!-- GOALS -->

      <section class="card">

        <h2>
          🚀 Goals & Milestones
        </h2>


        <div class="form-grid">


          <div class="form-group full">

            <label for="shortTermGoals">
              Short-Term Goals
            </label>

            <textarea
              id="shortTermGoals"
              placeholder="What do you want to achieve in the next 6–12 months?"
            ></textarea>

          </div>


          <div class="form-group full">

            <label for="longTermGoals">
              Long-Term Goals
            </label>

            <textarea
              id="longTermGoals"
              placeholder="What do you want the business to become in 3–5 years?"
                        </textarea>

          </div>


        </div>


        <div class="actions">

          <button
            type="button"
            class="btn btn-primary"
            id="saveBtn"
          >
            💾 Save Business Plan
          </button>

          <button
            type="button"
            class="btn btn-secondary"
            id="downloadBtn"
          >
            📄 Download Plan
          </button>

          <button
            type="button"
            class="btn btn-light"
            id="clearBtn"
          >
            🗑️ Clear
          </button>

        </div>

      </section>

    </div>


    <!-- =========================
         LIVE PREVIEW
    ========================= -->

    <aside class="preview-wrapper">

      <div class="preview">

        <div class="preview-header">

          <small>
            BUSINESS PLAN
