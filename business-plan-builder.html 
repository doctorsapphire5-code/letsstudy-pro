    storageBucket:
      "let-s-study-pro-course.firebasestorage.app",

    messagingSenderId:
      "474928293390",

    appId:
      "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

    measurementId:
      "G-85B7V5H5J0"

  };


  const app =
    initializeApp(
      firebaseConfig
    );


  const db =
    getFirestore(app);


  /* =========================
     HELPER
  ========================= */

  const get =
    id =>
      document.getElementById(id);


  function getValue(id){

    const element =
      get(id);

    return element
      ? element.value.trim()
      : "";

  }


  function formatMoney(
    amount
  ){

    if(
      !amount ||
      Number(amount) === 0
    ){

      return "—";

    }

    return new Intl.NumberFormat(
      "en-TZ"
    ).format(
      Number(amount)
    );

  }


  /* =========================
     TOAST
  ========================= */

  function showToast(
    message
  ){

    const toast =
      get("toast");

    toast.textContent =
      message;

    toast.classList.add(
      "show"
    );

    setTimeout(
      () => {

        toast.classList.remove(
          "show"
        );

      },
      2500
    );

  }


  /* =========================
     STATUS
  ========================= */

  function showStatus(
    message,
    type
  ){

    const status =
      get("status");

    if(!status){

      return;

    }

    status.textContent =
      message;

    status.className =
      `status show ${type}`;

  }


  /* =========================
     COLLECT BUSINESS PLAN
  ========================= */

  function collectPlan(){

    return {

      businessName:
        getValue(
          "businessName"
        ),

      industry:
        getValue(
          "industry"
        ),

      location:
        getValue(
          "location"
        ),

      businessStage:
        getValue(
          "businessStage"
        ),

      businessDescription:
        getValue(
          "businessDescription"
        ),

      executiveSummary:
        getValue(
          "executiveSummary"
        ),

      problem:
        getValue(
          "problem"
        ),

      solution:
        getValue(
          "solution"
        ),

      targetCustomers:
        getValue(
          "targetCustomers"
        ),

      marketSize:
        getValue(
          "marketSize"
        ),

      competitors:
        getValue(
          "competitors"
        ),

      products:
        getValue(
          "products"
        ),

      pricing:
        getValue(
          "pricing"
        ),

      revenueModel:
        getValue(
          "revenueModel"
        ),

      marketingStrategy:
        getValue(
          "marketingStrategy"
        ),

      salesStrategy:
        getValue(
          "salesStrategy"
        ),

      channels:
        getValue(
          "channels"
        ),

      operations:
        getValue(
          "operations"
        ),

      founder:
        getValue(
          "founder"
        ),

      teamSize:
        Number(
          getValue(
            "teamSize"
          )
        ) || 0,

      teamDescription:
        getValue(
          "teamDescription"
        ),

      startupCost:
        Number(
          getValue(
            "startupCost"
          )
        ) || 0,

      monthlyRevenue:
        Number(
          getValue(
            "monthlyRevenue"
          )
        ) || 0,

      monthlyExpenses:
        Number(
          getValue(
            "monthlyExpenses"
          )
        ) || 0,

      fundingRequired:
        Number(
          getValue(
            "fundingRequired"
          )
        ) || 0,

      shortTermGoals:
        getValue(
          "shortTermGoals"
        ),

      longTermGoals:
        getValue(
          "longTermGoals"
        )

    };

  }


  /* =========================
     LIVE PREVIEW
  ========================= */

  function updatePreview(){

    const plan =
      collectPlan();


    get("previewName")
      .textContent =
      plan.businessName ||
      "Your Business";


    get("previewIndustry")
      .textContent =
      plan.industry ||
      "—";


    get("previewDescription")
      .textContent =
      plan.businessDescription ||
      "Start filling in your business plan.";


    get("previewCustomers")
      .textContent =
      plan.targetCustomers ||
      "—";


    get("previewSolution")
      .textContent =
      plan.solution ||
      "—";


    get("previewStartup")
      .textContent =
      formatMoney(
        plan.startupCost
      );


    get("previewRevenue")
      .textContent =
      formatMoney(
        plan.monthlyRevenue
      );


    get("previewExpenses")
      .textContent =
      formatMoney(
        plan.monthlyExpenses
      );


    get("previewFunding")
      .textContent =
      formatMoney(
        plan.fundingRequired
      );

  }


  /* =========================
     AUTO UPDATE
  ========================= */

  document
    .querySelectorAll(
      "input, textarea, select"
    )
    .forEach(
      element => {

        element.addEventListener(
          "input",
          updatePreview
        );

        element.addEventListener(
          "change",
          updatePreview
        );

      }
    );


  /* =========================
     SAVE TO FIRESTORE
  ========================= */

  get("saveBtn")
    .addEventListener(
      "click",
      async () => {

        const plan =
          collectPlan();


        if(
          !plan.businessName
        ){

          showStatus(
            "Business name is required.",
            "error"
          );

          get(
            "businessName"
          ).focus();

          return;

        }


        const button =
          get("saveBtn");


        button.disabled =
          true;

        button.textContent =
          "Saving...";


        try{

          const docRef =
            await addDoc(
              collection(
                db,
                "businessPlans"
              ),
              {

                ...plan,

                createdAt:
                  serverTimestamp(),

                updatedAt:
                  serverTimestamp(),

                status:
                  "draft"

              }
            );


          console.log(
            "Business Plan ID:",
            docRef.id
          );


          showStatus(
            "Business plan saved successfully.",
            "success"
          );


          showToast(
            "Business plan saved."
          );


        }
        catch(error){

          console.error(
            "Firebase save error:",
            error
          );


          showStatus(
            "Unable to save the business plan.",
            "error"
          );


          showToast(
            "Save failed."
          );

        }
        finally{

          button.disabled =
            false;

          button.textContent =
            "💾 Save Business Plan";

        }

      }
    );


  /* =========================
     DOWNLOAD
  ========================= */

  get("downloadBtn")
    .addEventListener(
      "click",
      () => {

        const plan =
          collectPlan();


        if(
          !plan.businessName
        ){

          showStatus(
            "Enter a business name first.",
            "error"
          );

          return;

        }


        const text = `

BUSINESS PLAN
${plan.businessName}

========================================

BUSINESS INFORMATION

Industry:
${plan.industry}

Location:
${plan.location}

Business Stage:
${plan.businessStage}

Business Description:
${plan.businessDescription}


EXECUTIVE SUMMARY

${plan.executiveSummary}


PROBLEM

${plan.problem}


SOLUTION

${plan.solution}


TARGET MARKET

Target Customers:
${plan.targetCustomers}

Market Size:
${plan.marketSize}

Competitors:
${plan.competitors}


PRODUCTS & SERVICES

${plan.products}

Pricing:
${plan.pricing}

Revenue Model:
${plan.revenueModel}


MARKETING & SALES

Marketing Strategy:
${plan.marketingStrategy}

Sales Strategy:
${plan.salesStrategy}

Channels:
${plan.channels}


OPERATIONS

${plan.operations}


TEAM

Founder:
${plan.founder}

Team Size:
${plan.teamSize}

Team Description:
${plan.teamDescription}


FINANCIAL PLAN

Startup Cost:
${formatMoney(plan.startupCost)}

Monthly Revenue:
${formatMoney(plan.monthlyRevenue)}

Monthly Expenses:
${formatMoney(plan.monthlyExpenses)}

Funding Required:
${formatMoney(plan.fundingRequired)}


GOALS & MILESTONES

Short-Term Goals:
${plan.shortTermGoals}

Long-Term Goals:
${plan.longTermGoals}


========================================

Created with LetsStudy Pro
        `.trim();


        const blob =
          new Blob(
            [text],
            {
              type:
                "text/plain;charset=utf-8"
            }
          );


        const url =
          URL.createObjectURL(
            blob
          );


        const link =
          document.createElement(
            "a"
          );


        link.href =
          url;


        link.download =
          `${plan.businessName
            .replace(
              /[^a-z0-9]/gi,
              "-"
            )
            .toLowerCase()
          }-business-plan.txt`;


        document.body.appendChild(
          link
        );


        link.click();


        document.body.removeChild(
          link
        );


        URL.revokeObjectURL(
          url
        );


        showToast(
          "Business plan downloaded."
        );

      }
    );


  /* =========================
     CLEAR FORM
  ========================= */

  get("clearBtn")
    .addEventListener(
      "click",
      () => {

        document
          .querySelectorAll(
            "input, textarea"
          )
          .forEach(
            element => {

              element.value =
                "";

            }
          );


        document
          .querySelectorAll(
            "select"
          )
          .forEach(
            element => {

              element.selectedIndex =
                0;

            }
          );


        updatePreview();


        const status =
          get("status");


        if(status){

          status.className =
            "status";

          status.textContent =
            "";

        }


        showToast(
          "Business plan cleared."
        );

      }
    );


  /* =========================
     THEME
  ========================= */

  get("themeBtn")
    .addEventListener(
      "click",
      () => {

        document.body.classList.toggle(
          "dark"
        );


        const dark =
          document.body.classList.contains(
            "dark"
          );


        get(
          "themeBtn"
        ).textContent =
          dark
            ? "☀️"
            : "🌙";

      }
    );


  /* =========================
     INITIALIZE
  ========================= */

  updatePreview();

</script>


</body>

</html>