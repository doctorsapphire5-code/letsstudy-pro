<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Business Services</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
  --primary:#2563eb;
  --primary-dark:#1d4ed8;
  --dark:#0f172a;
  --text:#172033;
  --muted:#64748b;
  --bg:#f5f7fb;
  --white:#fff;
  --border:#e2e8f0;
  --danger:#dc2626;
  --success:#16a34a;
  --warning:#d97706;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--bg);
  color:var(--text);
}

.container{
  width:min(1150px,92%);
  margin:auto;
}

/* HEADER */

header{
  background:#fff;
  border-bottom:1px solid var(--border);
  position:sticky;
  top:0;
  z-index:50;
}

.nav{
  min-height:70px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  display:flex;
  align-items:center;
  gap:10px;
  font-weight:800;
}

.logo-icon{
  width:42px;
  height:42px;
  display:grid;
  place-items:center;
  border-radius:11px;
  background:var(--primary);
  color:#fff;
}

.nav-links{
  display:flex;
  gap:20px;
}

.nav-links a{
  color:var(--muted);
  text-decoration:none;
  font-size:14px;
  font-weight:700;
}

.nav-links a:hover{
  color:var(--primary);
}

/* MAIN */

main{
  padding:35px 0 60px;
}

.hero{
  margin-bottom:25px;
}

.eyebrow{
  color:var(--primary);
  font-size:12px;
  font-weight:800;
  letter-spacing:.12em;
}

.hero h1{
  margin-top:5px;
  font-size:clamp(28px,5vw,42px);
}

.hero p{
  color:var(--muted);
  margin-top:7px;
}

/* STATUS */

.status{
  padding:12px 15px;
  border-radius:10px;
  background:#eff6ff;
  color:#1d4ed8;
  font-size:13px;
  font-weight:700;
  margin-bottom:22px;
}

/* STATS */

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
  margin-bottom:22px;
}

.stat{
  background:#fff;
  border:1px solid var(--border);
  border-radius:15px;
  padding:20px;
  box-shadow:0 8px 25px #00000008;
}

.stat-icon{
  width:40px;
  height:40px;
  display:grid;
  place-items:center;
  background:#eff6ff;
  border-radius:10px;
}

.stat-label{
  display:block;
  color:var(--muted);
  font-size:12px;
  margin-top:13px;
}

.stat-value{
  display:block;
  font-size:25px;
  margin-top:3px;
}

/* CARD */

.card{
  background:#fff;
  border:1px solid var(--border);
  border-radius:16px;
  padding:23px;
  margin-bottom:22px;
  box-shadow:0 8px 25px #00000008;
}

.card h2{
  font-size:19px;
  margin-bottom:5px;
}

.card-sub{
  color:var(--muted);
  font-size:13px;
  margin-bottom:20px;
}

/* FORM */

.form-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:15px;
}

.form-group{
  display:flex;
  flex-direction:column;
  gap:6px;
}

.full{
  grid-column:1/-1;
}

label{
  font-size:13px;
  font-weight:800;
}

input,
select,
textarea{
  width:100%;
  padding:12px;
  border:1px solid var(--border);
  border-radius:9px;
  outline:none;
  font:inherit;
  background:#fff;
}

input:focus,
select:focus,
textarea:focus{
  border-color:var(--primary);
  box-shadow:0 0 0 3px #2563eb18;
}

textarea{
  min-height:100px;
  resize:vertical;
}

.buttons{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top:20px;
}

button{
  border:0;
  border-radius:9px;
  padding:11px 17px;
  cursor:pointer;
  font:inherit;
  font-weight:800;
}

.primary{
  background:var(--primary);
  color:#fff;
}

.primary:hover{
  background:var(--primary-dark);
}

.secondary{
  background:#eef2f7;
  color:var(--text);
}

.danger{
  background:#fee2e2;
  color:#b91c1c;
}

/* TOOLBAR */

.toolbar{
  display:grid;
  grid-template-columns:1fr 220px;
  gap:12px;
  margin-bottom:20px;
}

/* SERVICES */

.services{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
}

.service{
  border:1px solid var(--border);
  border-radius:14px;
  padding:18px;
  background:#fff;
}

.service-icon{
  width:48px;
  height:48px;
  display:grid;
  place-items:center;
  border-radius:12px;
  background:#eff6ff;
  font-size:23px;
  margin-bottom:14px;
}

.service-name{
  font-size:18px;
  font-weight:850;
}

.service-category{
  color:var(--primary);
  font-size:12px;
  font-weight:800;
  margin-top:3px;
}

.service-description{
  color:var(--muted);
  font-size:13px;
  margin-top:9px;
  min-height:42px;
}

.service-meta{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
  margin-top:16px;
}

.meta{
  padding:10px;
  border-radius:9px;
  background:#f8fafc;
}

.meta small{
  display:block;
  color:var(--muted);
  font-size:10px;
}

.meta strong{
  display:block;
  margin-top:2px;
  font-size:13px;
}

.availability{
  display:inline-block;
  margin-top:13px;
  padding:5px 9px;
  border-radius:20px;
  font-size:11px;
  font-weight:800;
}

.available{
  background:#dcfce7;
  color:#166534;
}

.unavailable{
  background:#fee2e2;
  color:#991b1b;
}

.service-actions{
  display:flex;
  gap:8px;
  margin-top:15px;
}

.small-btn{
  flex:1;
  padding:9px;
  font-size:12px;
}

.empty{
  grid-column:1/-1;
  text-align:center;
  padding:35px;
  color:var(--muted);
  border:1px dashed var(--border);
  border-radius:12px;
}

/* FOOTER */

footer{
  background:var(--dark);
  color:#fff;
  padding:30px 0;
}

.footer{
  display:flex;
  justify-content:space-between;
  gap:20px;
}

.footer p{
  color:#94a3b8;
  font-size:12px;
}

/* RESPONSIVE */

@media(max-width:950px){
  .stats{
    grid-template-columns:repeat(2,1fr);
  }

  .services{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:650px){
  .nav-links{
    display:none;
  }

  .stats{
    grid-template-columns:1fr;
  }

  .form-grid{
    grid-template-columns:1fr;
  }

  .full{
    grid-column:auto;
  }

  .toolbar{
    grid-template-columns:1fr;
  }

  .services{
    grid-template-columns:1fr;
  }

  .footer{
    flex-direction:column;
  }
}
</style>
</head>

<body>

<header>
<div class="container nav">

<div class="logo">
<div class="logo-icon">🛠️</div>
<span>Business Services</span>
</div>

<nav class="nav-links">
<a href="#overview">Overview</a>
<a href="#add">Add Service</a>
<a href="#services">Services</a>
</nav>

</div>
</header>


<main class="container">

<section class="hero">
<span class="eyebrow">SERVICE MANAGEMENT</span>
<h1>Business Services</h1>
<p>
Create and manage the services your business offers.
</p>
</section>


<div
id="status"
class="status"
>
Connecting to Firebase...
</div>


<!-- STATS -->

<section
class="stats"
id="overview"
>

<div class="stat">
<div class="stat-icon">🛠️</div>
<span class="stat-label">Total Services</span>
<strong
class="stat-value"
id="totalServices"
>
0
</strong>
</div>

<div class="stat">
<div class="stat-icon">✅</div>
<span class="stat-label">Available</span>
<strong
class="stat-value"
id="availableServices"
>
0
</strong>
</div>

<div class="stat">
<div class="stat-icon">💰</div>
<span class="stat-label">Average Price</span>
<strong
class="stat-value"
id="averagePrice"
>
$0
</strong>
</div>

<div class="stat">
<div class="stat-icon">📂</div>
<span class="stat-label">Categories</span>
<strong
class="stat-value"
id="totalCategories"
>
0
</strong>
</div>

</section>


<!-- ADD SERVICE -->

<section
class="card"
id="add"
>

<h2 id="formTitle">
Add Service
</h2>

<p class="card-sub">
Enter your service information below.
</p>


<form id="serviceForm">

<div class="form-grid">

<div class="form-group">
<label for="serviceName">
Service Name *
</label>

<input
id="serviceName"
required
placeholder="Example: Website Design"
>
</div>


<div class="form-group">
<label for="category">
Category *
</label>

<select
id="category"
required
>

<option value="">
Select category
</option>

<option>Consulting</option>
<option>Marketing</option>
<option>Technology</option>
<option>Design</option>
<option>Education</option>
<option>Finance</option>
<option>Repair</option>
<option>Delivery</option>
<option>Other</option>

</select>
</div>


<div class="form-group">
<label for="price">
Price *
</label>

<input
id="price"
type="number"
min="0"
step="0.01"
required
placeholder="100"
>
</div>


<div class="form-group">
<label for="duration">
Duration
</label>

<input
id="duration"
placeholder="2 hours"
>
</div>


<div class="form-group">
<label for="icon">
Icon / Emoji
</label>

<input
id="icon"
maxlength="4"
placeholder="🛠️"
>
</div>


<div class="form-group">
<label for="availability">
Availability *
</label>

<select
id="availability"
required
>

<option value="Available">
Available
</option>

<option value="Unavailable">
Unavailable
</option>

</select>
</div>


<div class="form-group full">

<label for="description">
Description
</label>

<textarea
id="description"
placeholder="Describe what this service includes..."
></textarea>

</div>

</div>


<div class="buttons">

<button
type="submit"
class="primary"
id="saveBtn"
>
➕ Add Service
</button>

<button
type="button"
class="secondary"
id="cancelBtn"
style="display:none"
>
Cancel Edit
</button>

<button
type="reset"
class="secondary"
>
Reset
</button>

</div>

</form>

</section>


<!-- SERVICES -->

<section
class="card"
id="services"
>

<h2>Service Catalog</h2>

<p class="card-sub">
Search and manage your business services.
</p>


<div class="toolbar">

<input
id="search"
placeholder="🔎 Search services..."
>

<select id="filterCategory">

<option value="">
All Categories
</option>

<option>Consulting</option>
<option>Marketing</option>
<option>Technology</option>
<option>Design</option>
<option>Education</option>
<option>Finance</option>
<option>Repair</option>
<option>Delivery</option>
<option>Other</option>

</select>

</div>


<div
class="services"
id="serviceList"
>

<div class="empty">
Loading services...
</div>

</div>

</section>

</main>


<footer>

<div class="container footer">

<strong>
🛠️ Business Services
</strong>

<p>
© <span id="year"></span> Business Services
</p>

</div>

</footer>


<script type="module">

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";


import {
getFirestore,
collection,
addDoc,
doc,
updateDoc,
deleteDoc,
onSnapshot,
serverTimestamp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


/* =========================
   FIREBASE CONFIG
========================= */

const firebaseConfig={

apiKey:
"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};


/* INIT */

const app=
initializeApp(firebaseConfig);

const db=
getFirestore(app);

const servicesRef=
collection(
db,
"businessServices"
);


/* ELEMENTS */

const form=
document.getElementById(
"serviceForm"
);

const serviceList=
document.getElementById(
"serviceList"
);

const status=
document.getElementById(
"status"
);

const saveBtn=
document.getElementById(
"saveBtn"
);

const cancelBtn=
document.getElementById(
"cancelBtn"
);

const search=
document.getElementById(
"search"
);

const filterCategory=
document.getElementById(
"filterCategory"
);


let services=[];
let editingId=null;


/* STATUS */

function setStatus(
text,
error=false
){

status.textContent=text;

if(error){

status.style.background="#fee2e2";
status.style.color="#b91c1c";

}else{

status.style.background="#eff6ff";
status.style.color="#1d4ed8";

}

}


/* FORM DATA */

function getFormData(){

return{

name:
document.getElementById(
"serviceName"
).value.trim(),

category:
document.getElementById(
"category"
).value,

price:
Number(
document.getElementById(
"price"
).value
)||0,

duration:
document.getElementById(
"duration"
).value.trim(),

icon:
document.getElementById(
"icon"
).value.trim()||"🛠️",

availability:
document.getElementById(
"availability"
).value,

description:
document.getElementById(
"description"
).value.trim()

};

}


/* SAVE / UPDATE */

form.addEventListener(
"submit",
async event=>{

event.preventDefault();

const data=
getFormData();


if(
!data.name ||
!data.category
){

setStatus(
"Service name and category are required.",
true
);

return;

}


try{

saveBtn.disabled=true;

saveBtn.textContent=
editingId
?"Updating..."
:"Adding...";


if(editingId){

await updateDoc(

doc(
db,
"businessServices",
editingId
),

{
...data,
updatedAt:
serverTimestamp()
}

);

setStatus(
"Service updated successfully."
);

}else{

await addDoc(

servicesRef,

{
...data,
createdAt:
serverTimestamp(),
updatedAt:
serverTimestamp()
}

);

setStatus(
"Service added successfully."
);

}


form.reset();

editingId=null;

document.getElementById(
"formTitle"
).textContent=
"Add Service";

saveBtn.textContent=
"➕ Add Service";

cancelBtn.style.display=
"none";


}catch(error){

console.error(error);

setStatus(
"Operation failed: "+
error.message,
true
);

}finally{

saveBtn.disabled=false;

if(!editingId){

saveBtn.textContent=
"➕ Add Service";

}

}

});


/* REAL-TIME FIRESTORE */

onSnapshot(

servicesRef,

snapshot=>{

services=[];

snapshot.forEach(
item=>{

services.push({

id:item.id,
...item.data()

});

});


renderServices();
updateStats();

setStatus(
`${services.length} service(s) loaded from Firestore.`
);

},

error=>{

console.error(error);

setStatus(
"Firestore error: "+
error.message,
true
);

}

);


/* RENDER */

function renderServices(){

const query=
search.value.trim().toLowerCase();

const category=
filterCategory.value;


const filtered=
services.filter(
service=>{

const matchesSearch=

(service.name||"")
.toLowerCase()
.includes(query)

||

(service.category||"")
.toLowerCase()
.includes(query)

||

(service.description||"")
.toLowerCase()
.includes(query);


const matchesCategory=
!category ||
service.category===category;


return matchesSearch &&
matchesCategory;

}
);


if(!filtered.length){

serviceList.innerHTML=`
<div class="empty">
No services found.
</div>
`;

return;

}


serviceList.innerHTML=
filtered.map(
service=>{

const isAvailable=
service.availability!=="Unavailable";


const availabilityClass=
isAvailable
?"available"
:"unavailable";


const icon=
service.icon||"🛠️";


return`

<article class="service">

<div class="service-icon">
${escapeHTML(icon)}
</div>

<div class="service-name">
${escapeHTML(
service.name||"Unnamed Service"
)}
</div>

<div class="service-category">
${escapeHTML(
service.category||"Other"
)}
</div>

<p class="service-description">
${escapeHTML(
service.description||
"No description available."
)}
</p>


<div class="service-meta">

<div class="meta">
<small>Price</small>
<strong>
${money(service.price)}
</strong>
</div>

<div class="meta">
<small>Duration</small>
<strong>
${escapeHTML(
service.duration||"—"
)}
</strong>
</div>

</div>


<span
class="availability ${availabilityClass}"
>
${escapeHTML(
service.availability||
"Available"
)}
</span>


<div class="service-actions">

<button
class="secondary small-btn"
data-edit="${service.id}"
>
✏️ Edit
</button>

<button
class="danger small-btn"
data-delete="${service.id}"
>
🗑️ Delete
</button>

</div>

</article>

`;

}
).join("");


document
.querySelectorAll("[data-edit]")
.forEach(button=>{

button.addEventListener(
"click",
()=>editService(
button.dataset.edit
)
);

});


document
.querySelectorAll("[data-delete]")
.forEach(button=>{

button.addEventListener(
"click",
()=>deleteService(
button.dataset.delete
)
);

});

}


/* EDIT */

function editService(id){

const service=
services.find(
item=>item.id===id
);

if(!service)return;


document.getElementById(
"serviceName"
).value=
service.name||"";

document.getElementById(
"category"
).value=
service.category||"";

document.getElementById(
"price"
).value=
service.price||0;

document.getElementById(
"duration"
).value=
service.duration||"";

document.getElementById(
"icon"
).value=
service.icon||"🛠️";

document.getElementById(
"availability"
).value=
service.availability||
"Available";

document.getElementById(
"description"
).value=
service.description||"";


editingId=id;


document.getElementById(
"formTitle"
).textContent=
"Edit Service";


saveBtn.textContent=
"💾 Update Service";


cancelBtn.style.display=
"inline-block";


document
.getElementById("add")
.scrollIntoView({
behavior:"smooth"
});

}


/* CANCEL */

cancelBtn.addEventListener(
"click",
()=>{

editingId=null;

form.reset();

document.getElementById(
"formTitle"
).textContent=
"Add Service";

saveBtn.textContent=
"➕ Add Service";

cancelBtn.style.display=
"none";

}
);


/* DELETE */

async function deleteService(id){

const service=
services.find(
item=>item.id===id
);

if(!service)return;


if(
!confirm(
`Delete "${service.name}"?`
)
)return;


try{

await deleteDoc(

doc(
db,
"businessServices",
id
)

);

setStatus(
"Service deleted successfully."
);

}catch(error){

console.error(error);

setStatus(
"Could not delete service: "+
error.message,
true
);

}

}


/* SEARCH */

search.addEventListener(
"input",
renderServices
);

filterCategory.addEventListener(
"change",
renderServices
);


/* STATS */

function updateStats(){

const total=
services.length;

const available=
services.filter(
service=>
service.availability!=="Unavailable"
).length;

const average=
total
?
services.reduce(
(sum,service)=>
sum+
Number(service.price||0),
0
)/total
:0;

const categories=
new Set(
services.map(
service=>service.category
)
).size;


document.getElementById(
"totalServices"
).textContent=
total.toLocaleString();

document.getElementById(
"availableServices"
).textContent=
available.toLocaleString();

document.getElementById(
"averagePrice"
).textContent=
money(average);

document.getElementById(
"totalCategories"
).textContent=
categories.toLocaleString();

}


/* MONEY */

function money(value){

return "$"+
Number(value||0)
.toLocaleString(
"en-US",
{
minimumFractionDigits:2,
maximumFractionDigits:2
}
);

}


/* ESCAPE HTML */

function escapeHTML(value){

return String(value)
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}


/* YEAR */

document.getElementById(
"year"
).textContent=
new Date().getFullYear();

</script>

</body>
</html>