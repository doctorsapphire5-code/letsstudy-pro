
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101828">
  <title>Reset Password | Vorix Career</title>

  <style>
    *{box-sizing:border-box}
    body{
      margin:0;min-height:100vh;padding:20px;
      display:flex;align-items:center;justify-content:center;
      background:#f3f5fa;color:#172033;font-family:Arial,sans-serif
    }
    .container{width:100%;max-width:430px}
    .brand{text-align:center;margin-bottom:25px}
    .logo{
      width:55px;height:55px;margin:0 auto 12px;
      border-radius:14px;background:#3156d8;color:white;
      display:flex;align-items:center;justify-content:center;
      font-size:23px;font-weight:bold
    }
    .brand h1{font-size:23px;margin:0 0 7px}
    .brand p{margin:0;color:#667085;font-size:13px}
    .card{
      background:#fff;border:1px solid #e5e7eb;
      border-radius:15px;padding:28px;
      box-shadow:0 8px 30px #1018280d
    }
    .icon{
      width:54px;height:54px;border-radius:13px;
      background:#eef2ff;color:#3156d8;
      display:flex;align-items:center;justify-content:center;
      font-size:25px;margin-bottom:18px
    }
    h2{font-size:21px;margin:0 0 9px}
    .description{color:#667085;font-size:14px;line-height:1.6;margin:0 0 22px}
    .field{margin-bottom:17px}
    label{display:block;font-size:13px;font-weight:bold;margin-bottom:8px;color:#344054}
    .password-wrap{position:relative}
    input{
      width:100%;padding:13px;border:1px solid #d0d5dd;
      border-radius:8px;outline:none;font-size:14px
    }
    input:focus{border-color:#3156d8;box-shadow:0 0 0 3px #3156d81a}
    .toggle{
      position:absolute;right:10px;top:50%;
      transform:translateY(-50%);border:0;
      background:none;color:#3156d8;font-size:12px;
      font-weight:bold;cursor:pointer;padding:7px
    }
    .password-wrap input{padding-right:65px}
    .hint{font-size:12px;color:#667085;margin-top:7px}
    button.submit{
      width:100%;padding:14px;border:0;border-radius:8px;
      background:#3156d8;color:white;font-size:14px;
      font-weight:bold;cursor:pointer;margin-top:5px
    }
    button:disabled{opacity:.6;cursor:not-allowed}
    .message{
      display:none;padding:12px;border-radius:8px;
      margin-bottom:17px;font-size:13px;line-height:1.5
    }
    .success{display:block;background:#e8f8ef;color:#137547}
    .error{display:block;background:#fff0f0;color:#b42318}
    .back{
      display:block;text-align:center;margin-top:20px;
      color:#3156d8;text-decoration:none;font-size:14px;font-weight:bold
    }
    .footer{text-align:center;color:#98a2b3;font-size:12px;margin-top:22px}
  </style>
</head>

<body>
<div class="container">

  <div class="brand">
    <div class="logo">V</div>
    <h1>VORIX CAREER</h1>
    <p>Administrator Account Security</p>
  </div>

  <div class="card">
    <div class="icon">&#128274;</div>

    <h2>Reset Password</h2>

    <p class="description">
      Create a new secure password for your administrator account.
      Your new password must contain at least 8 characters.
    </p>

    <div id="message" class="message" role="alert" aria-live="polite"></div>

    <form id="resetForm">

      <div class="field">
        <label for="newPassword">New Password</label>
        <div class="password-wrap">
          <input
            type="password"
            id="newPassword"
            placeholder="Enter new password"
            minlength="8"
            autocomplete="new-password"
            required
          >
          <button type="button" class="toggle" data-target="newPassword">Show</button>
        </div>
        <div class="hint">Use at least 8 characters.</div>
      </div>

      <div class="field">
        <label for="confirmPassword">Confirm New Password</label>
        <div class="password-wrap">
          <input
            type="password"
            id="confirmPassword"
            placeholder="Confirm new password"
            minlength="8"
            autocomplete="new-password"
            required
          >
          <button type="button" class="toggle" data-target="confirmPassword">Show</button>
        </div>
      </div>

      <button type="submit" class="submit" id="submitBtn">
        Reset Password
      </button>

    </form>

    <a href="career-admin-login.html" class="back">
      Back to Admin Login
    </a>
  </div>

  <div class="footer">
    Secure administrator authentication powered by Firebase.
  </div>

</div>

<script type="module">
  import { initializeApp } from
    "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

  import {
    getAuth,
    verifyPasswordResetCode,
    confirmPasswordReset
  } from
    "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

  const firebaseConfig = {
    apiKey: "AIzaSyBhEY3Igjv0oWcQ3cAQQy6KU8d0StydJdY",
    authDomain: "vorix-career.firebaseapp.com",
    projectId: "vorix-career",
    storageBucket: "vorix-career.firebasestorage.app",
    messagingSenderId: "601220299726",
    appId: "1:601220299726:web:21888081707f5d35c9899f"
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);

  const form = document.getElementById("resetForm");
  const newPasswordInput = document.getElementById("newPassword");
  const confirmPasswordInput = document.getElementById("confirmPassword");
  const submitBtn = document.getElementById("submitBtn");
  const messageBox = document.getElementById("message");

  const params = new URLSearchParams(window.location.search);
  const mode = params.get("mode");
  const actionCode = params.get("oobCode");

  let codeVerified = false;

  function showMessage(message, type) {
    messageBox.textContent = message;
    messageBox.className = "message " + type;
    messageBox.style.display = "block";
  }

  function hideMessage() {
    messageBox.style.display = "none";
  }

  function disableForm(message) {
    showMessage(message, "error");
    newPasswordInput.disabled = true;
    confirmPasswordInput.disabled = true;
    submitBtn.disabled = true;
  }

  // Show or hide password
  document.querySelectorAll(".toggle").forEach(button => {
    button.addEventListener("click", () => {
      const input = document.getElementById(button.dataset.target);
      const visible = input.type === "text";

      input.type = visible ? "password" : "text";
      button.textContent = visible ? "Show" : "Hide";
    });
  });

  // Validate Firebase password reset code
  async function verifyResetLink() {
    if (mode !== "resetPassword" || !actionCode) {
      disableForm(
        "Invalid password reset link. Please request a new reset link."
      );
      return;
    }

    try {
      await verifyPasswordResetCode(auth, actionCode);
      codeVerified = true;
    } catch (error) {
      console.error(error);

      disableForm(
        "This password reset link is invalid, expired, or already used. Request a new reset link."
      );
    }
  }

  await verifyResetLink();

  // Reset password
  form.addEventListener("submit", async event => {
    event.preventDefault();
    hideMessage();

    if (!codeVerified || !actionCode) {
      showMessage("Your reset link could not be verified.", "error");
      return;
    }

    const newPassword = newPasswordInput.value;
    const confirmPassword = confirmPasswordInput.value;

    if (newPassword.length < 8) {
      showMessage(
        "Password must contain at least 8 characters.",
        "error"
      );
      return;
    }

    if (newPassword !== confirmPassword) {
      showMessage("Passwords do not match.", "error");
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Updating Password...";

    try {
      await confirmPasswordReset(auth, actionCode, newPassword);

      codeVerified = false;
      form.reset();

      newPasswordInput.disabled = true;
      confirmPasswordInput.disabled = true;

      showMessage(
        "Your password has been reset successfully. You can now sign in using your new password.",
        "success"
      );

      submitBtn.textContent = "Password Updated";

      // Remove the sensitive reset code from the browser URL.
      window.history.replaceState(
        {},
        document.title,
        window.location.pathname
      );

    } catch (error) {
      console.error(error);

      let errorMessage = "Unable to reset password. Please try again.";

      if (error.code === "auth/expired-action-code" ||
          error.code === "auth/invalid-action-code") {
        errorMessage = "This reset link has expired or has already been used. Request a new link.";
      } else if (error.code === "auth/weak-password") {
        errorMessage = "Your password is too weak. Choose a stronger password.";
      } else if (error.code === "auth/network-request-failed") {
        errorMessage = "Network error. Check your internet connection.";
      }

      showMessage(errorMessage, "error");
      submitBtn.disabled = false;
      submitBtn.textContent = "Reset Password";
    }
  });
</script>

</body>
</html>
