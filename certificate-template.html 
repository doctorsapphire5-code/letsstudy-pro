<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Certificate Templates | LetsStudy Pro</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
}
header{
  background:#fff;
  padding:16px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  border-bottom:1px solid #eee;
}
.logo{font-size:21px;font-weight:800}
.logo span{color:#2563eb}
.btn{
  border:0;
  background:#2563eb;
  color:#fff;
  padding:10px 15px;
  border-radius:8px;
  cursor:pointer;
}
.container{
  width:92%;
  max-width:1200px;
  margin:35px auto;
}
.intro{
  color:#64748b;
  margin:8px 0 25px;
}
.grid{
  display:grid;
  grid-template-columns:
    repeat(auto-fill,minmax(280px,1fr));
  gap:20px;
}
.card{
  background:#fff;
  border-radius:15px;
  padding:15px;
  box-shadow:0 5px 20px #0000000b;
}
.preview{
  height:190px;
  border:8px solid #2563eb;
  position:relative;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  background:#fff;
}
.preview:before{
  content:"";
  position:absolute;
  inset:8px;
  border:1px solid #2563eb;
}
.preview>*{
  position:relative;
  z-index:1;
}
.preview h2{font-size:24px}
.preview p{color:#64748b;margin:7px}
.card h3{margin:15px 0 6px}
.muted{color:#64748b;font-size:14px}
.actions{
  display:flex;
  gap:8px;
  margin-top:14px;
}
.empty{
  text-align:center;
  padding:60px;
  color:#64748b;
  grid-column:1/-1;
}
.secondary{
  background:#eef2ff;
  color:#3730a3;
}
</style>
</head>

<body>

<header>

  <div class="logo">
    LetsStudy <span>Pro</span>
  </div>

  <button
    class="btn"
    onclick="location.href='certificate-maker.html'"
  >
    Certificate Maker
  </button>

</header>

<main class="container">

  <h1>Certificate Templates</h1>

  <p class="intro">
    Choose a professional certificate template
    for your LetsStudy Pro certificate.
  </p>

  <section
    id="templates"
    class="grid"
  >
    <div class="empty">
      Loading templates...
    </div>
  </section>

</main>

<script>

const API =
  "/api/data?collection=certificates&limit=100";

let templates = [];


/* =========================
   LOAD API
========================= */

async function loadTemplates(){

  const container =
    document.getElementById(
      "templates"
    );

  try{

    const response =
      await fetch(API);

    if(!response.ok)
      throw new Error("API failed");

    const data =
      await response.json();

    /*
      Supports certificate documents
      containing template information.
    */

    templates =
      (data.results || [])
      .filter(item =>
        item.template ||
        item.templateName ||
        item.name
      );


    /*
      If API has no templates,
      show built-in public template.
    */

    if(!templates.length){

      templates = [{
        id:"classic",
        name:"Classic",
        description:
          "Clean professional certificate design.",
        primaryColor:"#2563eb"
      }];

    }


    render();

  }catch(error){

    console.error(
      "CERTIFICATE TEMPLATE API:",
      error
    );

    templates = [{
      id:"classic",
      name:"Classic",
      description:
        "Clean professional certificate design.",
      primaryColor:"#2563eb"
    }];

    render();

  }

}


/* =========================
   RENDER
========================= */

function render(){

  const container =
    document.getElementById(
      "templates"
    );


  container.innerHTML =
    templates
    .map(
      (template,index)=>{

        const name =
          template.name ||
          template.templateName ||
          `Template ${index+1}`;


        const description =
          template.description ||
          "Professional certificate template.";


        const color =
          template.primaryColor ||
          "#2563eb";


        return `

          <article class="card">

            <div
              class="preview"
              style="
                border-color:${safeColor(color)}
              "
            >

              <h2>
                CERTIFICATE
              </h2>

              <p>
                OF COMPLETION
              </p>

              <strong>
                LetsStudy Pro
              </strong>

            </div>

            <h3>
              ${escapeHTML(name)}
            </h3>

            <p class="muted">
              ${escapeHTML(description)}
            </p>

            <div class="actions">

              <button
                class="btn"
                onclick="
                  useTemplate(
                    '${escapeAttr(template.id || "")}'
                  )
                "
              >
                Use Template
              </button>

              <button
                class="btn secondary"
                onclick="
                  previewTemplate(
                    '${escapeAttr(template.id || "")}'
                  )
                "
              >
                Preview
              </button>

            </div>

          </article>

        `;

      }
    )
    .join("");

}


/* =========================
   USE TEMPLATE
========================= */

function useTemplate(id){

  const template =
    templates.find(
      item => item.id === id
    );

  if(template){

    localStorage.setItem(
      "selectedCertificateTemplate",
      JSON.stringify(template)
    );

  }

  location.href =
    "certificate-maker.html";

}


/* =========================
   PREVIEW
========================= */

function previewTemplate(id){

  const template =
    templates.find(
      item => item.id === id
    );

  if(!template)
    return;

  alert(
    (
      template.name ||
      template.templateName ||
      "Certificate Template"
    ) +
    "\n\n" +
    (
      template.description ||
      "Professional certificate template."
    )
  );

}


/* =========================
   SECURITY HELPERS
========================= */

function escapeHTML(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


function escapeAttr(value){

  return escapeHTML(value);

}


function safeColor(value){

  const color =
    String(value || "");

  /*
    Allow only simple CSS colors.
  */

  if(
    /^#[0-9a-fA-F]{3,8}$/.test(color) ||
    /^[a-zA-Z]+$/.test(color)
  ){

    return color;

  }

  return "#2563eb";

}


/* =========================
   START
========================= */

loadTemplates();

</script>

</body>
</html>