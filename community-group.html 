<style>
:root{--p:#2563eb;--ink:#0f172a;--text:#1f2937;--muted:#64748b;--bg:#f6f8fb;--paper:#fff;--line:#e2e8f0;--soft:#eef2f8;--heart:#e11d48}
@media(prefers-color-scheme:dark){:root{--p:#60a5fa;--ink:#f1f5f9;--text:#d5dcea;--muted:#94a3b8;--bg:#0b1220;--paper:#111a2e;--line:#22304a;--soft:#17223a;--heart:#fb7185}}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--bg);color:var(--text);line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:var(--p)}
:focus-visible{outline:3px solid var(--p);outline-offset:3px;border-radius:4px}
.hd{background:#0f172a;position:sticky;top:0;z-index:50}
.hd>div{width:min(1100px,92%);margin:auto;min-height:62px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{color:#fff;font-weight:800;font-size:20px;text-decoration:none}
.brand span{color:#60a5fa}
.hd nav a{color:#cbd5e1;text-decoration:none;font-weight:600;font-size:14px;margin-left:18px}
.hd nav a:hover{color:#fff}
.wrap{width:min(780px,92%);margin:0 auto;padding:36px 0 70px}
.back{display:inline-block;margin-bottom:14px;font-weight:600;font-size:14px;text-decoration:none}
.btn{border:0;background:var(--p);color:#fff;padding:10px 20px;border-radius:12px;font:inherit;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block;text-align:center}
.btn.alt{background:var(--soft);color:var(--ink)}
.btn:disabled{opacity:.6;cursor:wait}
@media(prefers-color-scheme:dark){.btn{color:#0b1220}.btn.alt{color:var(--ink)}}
.hero{background:var(--paper);border:1px solid var(--line);border-radius:20px;overflow:hidden}
.cv{height:170px;background:var(--soft)}
.cv img{width:100%;height:100%;object-fit:cover;display:block}
.in{padding:20px 24px 24px;display:flex;flex-direction:column;gap:12px}
h1{font-size:clamp(26px,5vw,36px);line-height:1.15;letter-spacing:-.02em;font-weight:800;color:var(--ink);margin:0;overflow-wrap:anywhere}
.bd{display:flex;flex-wrap:wrap;gap:6px}
.b{padding:2px 10px;border-radius:999px;font-size:12px;font-weight:700;background:var(--soft);color:var(--muted);text-decoration:none}
.b.hot{background:#fef3c7;color:#92400e}.b.pn{background:var(--p);color:#fff}
@media(prefers-color-scheme:dark){.b.hot{background:#422006;color:#fbbf24}.b.pn{color:#0b1220}}
.ds{margin:0;font-size:17px;color:var(--muted);white-space:pre-wrap;overflow-wrap:anywhere}
.row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px}
.st{display:flex;gap:18px;font-size:13px;color:var(--muted)}
.st b{color:var(--ink);font-size:16px;margin-right:3px}
.acts{display:flex;gap:8px;flex-wrap:wrap}
.tabs{display:flex;gap:6px;border-bottom:1px solid var(--line);margin:22px 0 18px;overflow-x:auto}
.tab{flex:none;border:0;background:none;padding:10px 16px;font:inherit;font-weight:700;color:var(--muted);cursor:pointer;border-bottom:3px solid transparent;margin-bottom:-1px;white-space:nowrap}
.tab[aria-selected=true]{color:var(--ink);border-color:var(--p)}
.card{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:20px 22px;margin-bottom:16px}
.card h2{margin:0 0 10px;font-size:20px;color:var(--ink)}
.card p{margin:0;white-space:pre-wrap;overflow-wrap:anywhere}
.kv{display:grid;grid-template-columns:120px 1fr;gap:8px 14px;margin:0;font-size:15px}
.kv dt{color:var(--muted);font-weight:700}.kv dd{margin:0;overflow-wrap:anywhere}
.box textarea,.box input{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--text);font:inherit;font-size:16px}
.box textarea{min-height:90px;resize:vertical}
.box input{margin-top:10px}
.box textarea:focus,.box input:focus{outline:none;border-color:var(--p);box-shadow:0 0 0 3px color-mix(in srgb,var(--p) 25%,transparent)}
.r2{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:12px}
.r2 small{color:var(--muted)}
.post{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:18px 20px;margin-bottom:14px}
.post.pin{border-color:color-mix(in srgb,var(--p) 45%,var(--line))}
.top{display:flex;align-items:center;gap:12px}
.av{flex:none;width:44px;height:44px;border-radius:50%;background:var(--soft);color:var(--p);display:grid;place-items:center;font-weight:800;overflow:hidden}
.av img{width:100%;height:100%;object-fit:cover;display:block}
.who{min-width:0;flex:1}
.who b{display:block;color:var(--ink);line-height:1.3;overflow-wrap:anywhere}
.who span{font-size:13px;color:var(--muted)}
.tx{margin:12px 0 0;white-space:pre-wrap;overflow-wrap:anywhere}
.clamp{display:-webkit-box;-webkit-line-clamp:5;-webkit-box-orient:vertical;overflow:hidden}
.pimg{width:100%;max-height:380px;object-fit:cover;border-radius:12px;display:block;margin-top:12px}
.lnk{border:0;background:none;padding:0;font:inherit;font-weight:700;font-size:14px;color:var(--muted);cursor:pointer;text-decoration:none}
.lnk:hover{color:var(--p)}
.lnk.on{color:var(--heart)}
.pa{display:flex;flex-wrap:wrap;align-items:center;gap:6px 18px;margin-top:14px;padding-top:10px;border-top:1px solid var(--line)}
.pa .sp{margin-left:auto;display:flex;gap:16px}
.ml{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px}
.mi{display:flex;align-items:center;gap:12px;background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:12px 14px}
.mi b{display:block;color:var(--ink);line-height:1.3;overflow-wrap:anywhere}
.mi span{font-size:13px;color:var(--muted)}
.state{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:44px 20px;text-align:center;color:var(--muted)}
.state h2{color:var(--ink);margin:0 0 6px;font-size:20px}
.state.err h2{color:#dc2626}
.state .btn{margin-top:14px}
.more{display:block;margin:18px auto 0}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:#0f172a;color:#fff;padding:11px 18px;border-radius:10px;font-weight:700;font-size:14px;opacity:0;pointer-events:none;transition:opacity .2s;z-index:300}
.toast.show{opacity:1}
footer{border-top:1px solid var(--line);background:var(--paper);padding:28px 0;text-align:center;color:var(--muted);font-size:14px}
@media(max-width:600px){.wrap{padding-top:24px}.hd nav a{margin-left:12px}.cv{height:120px}.in{padding:16px}.card,.post{padding:16px}.kv{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
