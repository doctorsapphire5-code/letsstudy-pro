<script type="module">
import {initializeApp} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";
import {getAuth,onAuthStateChanged} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";
import {getFirestore,collection,doc,getDoc,getDocs,setDoc,updateDoc,deleteDoc,getCountFromServer,increment,arrayUnion,arrayRemove,serverTimestamp,query,where,limit}
  from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";

const fb=initializeApp({
  apiKey:"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",
  authDomain:"let-s-study-pro-course.firebaseapp.com",
  projectId:"let-s-study-pro-course",
  storageBucket:"let-s-study-pro-course.firebasestorage.app",
  messagingSenderId:"474928293390",
  appId:"1:474928293390:web:2bcc2aebf2351c12a9fe5f"
});
const auth=getAuth(fb),db=getFirestore(fb);

const $=s=>document.querySelector(s);
const qp=new URLSearchParams(location.search);
const gid=(qp.get("id")||qp.get("groupId")||"").trim(),slugParam=(qp.get("slug")||"").trim();
/* Settings. Change these if your collections or pages are named differently. */
const SOURCES=["communityGroups","communityCategories","communities","groups"];   /* where the group document lives */
const MEMBER_COLS=["communityGroupMembers","groupMembers"];                        /* first one is written to */
const CART=id=>`community-cart.html?id=${encodeURIComponent(id)}`;
const CHAT=c=>/^https?:\/\//i.test(c)?c:`messages.html?conversationId=${encodeURIComponent(c)}`;

const N=new Intl.NumberFormat(undefined,{notation:"compact",maximumFractionDigits:1});
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const safe=u=>{try{const x=new URL(String(u||"").trim());return /^https?:$/.test(x.protocol)?x.href:""}catch{return ""}};
const toD=v=>{if(!v)return null;const x=typeof v.toDate==="function"?v.toDate():new Date(v);return isNaN(x)?null:x};
const num=v=>Number(v)||0;
const cap=s=>s?String(s)[0].toUpperCase()+String(s).slice(1):s;
const rtf=new Intl.RelativeTimeFormat(undefined,{numeric:"auto"});
function ago(x){
  const s=(x-Date.now())/1000,a=Math.abs(s);
  for(const [u,v] of [["year",31536000],["month",2592000],["day",86400],["hour",3600],["minute",60]])
    if(a>=v)return rtf.format(Math.round(s/v),u);
  return "just now";
}
function toast(m){const t=$("#toast");t.textContent=m;t.classList.add("show");setTimeout(()=>t.classList.remove("show"),2600)}
const val=(d,keys,fb="")=>{for(const k of keys)if(d&&d[k]!==undefined&&d[k]!==null&&d[k]!=="")return d[k];return fb};

function norm(d){
  const access=String(val(d,["access","accessType","membership","plan"],"free")).toLowerCase();
  return {id:d.id,title:val(d,["name","title","communityName"],"Group"),category:val(d,["category","categoryName"]),description:val(d,["description","shortDescription"]),about:val(d,["about"]),
    image:safe(val(d,["image","cover","coverImage","coverPhoto"])),members:num(val(d,["membersCount","memberCount","members"],0)),postCount:num(d.postCount),
    featured:String(d.featured).toLowerCase()==="true",chat:String(d.chat||"").trim(),ownerId:val(d,["owerId","ownerId"]),
    premium:d.isPremium===true||d.premium===true||["premium","paid","pro","plan"].includes(access),
    status:String(val(d,["status"],"published")).toLowerCase(),createdAt:d.createdAt};
}

let user=null,g=null,mem=null,tab="posts",posts=null,members=null,shown=15,liveCount=null;
const ACTIVE=/^(active|approved|joined|member|accepted)$/i;
const isMember=()=>!!mem&&ACTIVE.test(mem.status||"");
const HIDE=/^(deleted|hidden|removed|rejected|spam|draft|pending|archived|flagged|blocked)$/i;

/* ---------------- load ---------------- */
async function loadGroup(){
  for(const name of SOURCES){
    try{
      if(gid){const s=await getDoc(doc(db,name,gid));if(s.exists())return norm({id:s.id,...s.data()})}
      if(slugParam){const q=await getDocs(query(collection(db,name),where("slug","==",slugParam),limit(1)));if(!q.empty)return norm({id:q.docs[0].id,...q.docs[0].data()})}
    }catch(e){console.warn(name,e)}
  }
  return null;
}
async function loadMembership(){
  mem=null;
  if(!user)return;
  for(const col of MEMBER_COLS){
    try{
      const s=await getDocs(query(collection(db,col),where("groupId","==",g.id),where("userId","==",user.uid),limit(1)));
      if(!s.empty){mem={col,id:s.docs[0].id,...s.docs[0].data()};if(ACTIVE.test(mem.status||""))return}
    }catch(e){console.warn(col,e)}
  }
}
async function countMembers(){
  let best=null;
  for(const col of MEMBER_COLS){
    try{const n=(await getCountFromServer(query(collection(db,col),where("groupId","==",g.id),where("status","==","active")))).data().count;best=Math.max(best??0,n)}catch{}
  }
  return best;
}

/* ---------------- hero + join ---------------- */
function renderHero(){
  const m=isMember(),own=!!user&&g.ownerId===user.uid;
  $("#hero").innerHTML=`<div class="hero"><div class="cv">${g.image?`<img src="${esc(g.image)}" alt="">`:""}</div><div class="in">
    <div class="bd">${g.featured?`<span class="b hot">Featured</span>`:""}${g.category?`<span class="b">${esc(g.category)}</span>`:""}${own?`<span class="b pn">Owner</span>`:m&&mem.role&&mem.role!=="member"?`<span class="b pn">${esc(cap(mem.role))}</span>`:""}</div>
    <h1>${esc(g.title)}</h1>${g.description?`<p class="ds">${esc(g.description)}</p>`:""}
    <div class="row"><div class="st"><span><b id="mc">${N.format(liveCount??g.members)}</b>members</span><span><b>${N.format(Math.max(g.postCount,posts?posts.length:0))}</b>posts</span></div>
      <div class="acts">${m?`<button class="btn alt" type="button" id="leave">Joined</button>`:`<button class="btn" type="button" id="join">Join group</button>`}
        ${m&&g.chat?`<a class="btn" href="${esc(CHAT(g.chat))}">Open chat</a>`:""}<button class="btn alt" type="button" id="share">Share</button></div></div></div></div>`;
}
async function refresh(){await loadMembership();members=null;renderHero();showTab(tab)}
$("#hero").addEventListener("click",async e=>{
  const t=e.target;
  if(t.closest("#join")){
    if(!user){location.href="login.html";return}
    t.closest("#join").disabled=true;
    const id=`${g.id}_${user.uid}`;
    try{await setDoc(doc(db,MEMBER_COLS[0],id),{memberId:id,groupId:g.id,joinedAt:new Date().toISOString(),role:"member",status:"active",userId:user.uid});toast("You joined "+g.title);liveCount=(liveCount??g.members)+1}
    catch(err){console.error(err);toast("Could not join. Please try again.")}
    await refresh();
  }else if(t.closest("#leave")){
    if(!confirm("Leave this group?"))return;
    try{await deleteDoc(doc(db,mem.col,mem.id));toast("You left the group");liveCount=Math.max(0,(liveCount??g.members)-1)}
    catch(err){console.error(err);toast("Something went wrong")}
    await refresh();
  }else if(t.closest("#share")){
    const url=`${location.origin}/community-group.html?id=${encodeURIComponent(g.id)}`;
    try{if(navigator.share)await navigator.share({title:g.title,url});else{await navigator.clipboard.writeText(url);toast("Link copied")}}catch{}
  }
});
$("#tabs").addEventListener("click",e=>{const b=e.target.closest(".tab");if(b)showTab(b.dataset.t)});
function showTab(t){
  tab=t;document.querySelectorAll(".tab").forEach(x=>x.setAttribute("aria-selected",String(x.dataset.t===t)));
  if(g.premium&&!isMember()&&t!=="about"){$("#panel").innerHTML=`<div class="state"><h2>Premium community</h2><p>Get access to take part in this group.</p><a class="btn" href="${CART(g.id)}">Get access</a></div>`;return}
  if(t==="posts")loadPosts();else if(t==="members")loadMembers();else about();
}

/* ---------------- about ---------------- */
function about(){
  const x=toD(g.createdAt);
  $("#panel").innerHTML=`<div class="card"><h2>About this group</h2><p>${esc(g.about||g.description||"No details have been added yet.")}</p></div>
    <div class="card"><dl class="kv">${g.category?`<dt>Category</dt><dd>${esc(g.category)}</dd>`:""}<dt>Members</dt><dd>${N.format(liveCount??g.members)}</dd>${x?`<dt>Created</dt><dd>${esc(x.toLocaleDateString(undefined,{year:"numeric",month:"long",day:"numeric"}))}</dd>`:""}<dt>Access</dt><dd>${g.premium?"Premium":"Free"}</dd></dl></div>`;
}

/* ---------------- discussions (communityPosts) ---------------- */
const liked=p=>!!user&&Array.isArray(p.likedBy)&&p.likedBy.includes(user.uid);
function postCard(p){
  const x=toD(p.createdAt),own=!!user&&p.userId===user.uid,img=safe(p.imageUrl),n=(p.userName||"?").trim()[0]?.toUpperCase()||"M",ph=safe(p.userPhoto),long=String(p.content||"").length>320;
  return `<article class="post${p.isPinned?" pin":""}" id="p-${esc(p.id)}"><div class="top"><div class="av" aria-hidden="true">${ph?`<img src="${esc(ph)}" alt="" loading="lazy" data-n="${esc(n)}">`:esc(n)}</div>
    <div class="who"><b>${esc(p.userName||"Member")}</b><span>${x?`<time datetime="${x.toISOString()}" title="${esc(x.toLocaleString())}">${esc(ago(x))}</time>`:""}${p.isEdited?" (edited)":""}</span></div>${p.isPinned?`<span class="b pn">Pinned</span>`:""}</div>
    <p class="tx${long?" clamp":""}">${esc(p.content)}</p>${long?`<button class="lnk" type="button" data-more="1">Read more</button>`:""}
    ${img?`<img class="pimg" src="${esc(img)}" alt="" loading="lazy">`:""}
    <div class="pa"><button class="lnk${liked(p)?" on":""}" type="button" data-like="${esc(p.id)}" aria-pressed="${liked(p)}">${liked(p)?"Liked":"Like"} · ${N.format(num(p.likesCount))}</button>
      ${p.allowComments===false?`<span class="lnk" style="cursor:default">Comments off</span>`:`<a class="lnk" href="communityComments.html?postId=${encodeURIComponent(p.id)}&back=${encodeURIComponent("community-group.html?id="+g.id)}">${N.format(num(p.commentsCount))} comments</a>`}
      <span class="sp"><a class="lnk" href="communityReports.html?targetType=post&targetId=${encodeURIComponent(p.id)}">Report</a>${own?`<button class="lnk" type="button" data-del="${esc(p.id)}">Delete</button>`:""}</span></div></article>`;
}
function renderPosts(){
  const box=!user?`<div class="state" style="margin-bottom:16px"><h2>Join the conversation</h2><p>Sign in to join this group and post.</p><a class="btn" href="login.html">Sign in</a></div>`
    :isMember()?`<div class="card box"><textarea id="pt" maxlength="3000" placeholder="Share something with the group. Use #hashtags to help others find it." aria-label="Post"></textarea><input id="pi" type="url" placeholder="Image URL (optional)" aria-label="Image URL">
      <div class="r2"><small>Be respectful and keep it relevant.</small><button class="btn" id="pgo" type="button">Post</button></div></div>`
    :`<div class="state" style="margin-bottom:16px"><h2>Members only</h2><p>Join this group to post and take part.</p></div>`;
  const items=posts.slice(0,shown);
  $("#panel").innerHTML=box+(items.length?items.map(postCard).join("")+(posts.length>shown?`<button class="btn alt more" id="more" type="button">Show more (${posts.length-shown})</button>`:""):`<div class="state"><h2>No discussions yet</h2><p>Be the first to start a conversation.</p></div>`);
}
async function loadPosts(){
  if(!posts){
    try{
      const s=await getDocs(query(collection(db,"communityPosts"),where("communityId","==",g.id),limit(100)));
      posts=s.docs.map(d=>({id:d.id,...d.data()})).filter(p=>!HIDE.test(p.status||"")&&(String(p.visibility||"public").toLowerCase()==="public"||isMember()||(user&&p.userId===user.uid)))
        .sort((a,b)=>(!!b.isPinned-!!a.isPinned)||(toD(b.createdAt)||0)-(toD(a.createdAt)||0));
    }catch(e){console.error(e);$("#panel").innerHTML=`<div class="state err"><h2>Unable to load discussions</h2><p>${esc(e.message||"")}</p></div>`;return}
  }
  shown=15;renderPosts();
}
async function toggleLike(p){
  if(!user){location.href="login.html";return}
  const was=liked(p),prevBy=Array.isArray(p.likedBy)?[...p.likedBy]:[],prevN=num(p.likesCount);
  p.likedBy=was?prevBy.filter(u=>u!==user.uid):[...prevBy,user.uid];p.likesCount=Math.max(0,prevN+(was?-1:1));renderPosts();
  try{await updateDoc(doc(db,"communityPosts",p.id),{likedBy:was?arrayRemove(user.uid):arrayUnion(user.uid),likesCount:increment(was?-1:1)})}
  catch(err){console.error(err);toast("Something went wrong. Please try again.");p.likedBy=prevBy;p.likesCount=prevN;renderPosts()}
}
$("#panel").addEventListener("click",async e=>{
  const t=e.target;
  if(t.closest("#more")){shown+=15;renderPosts();return}
  const m=t.closest("[data-more]");if(m){const c=m.previousElementSibling.classList.toggle("clamp");m.textContent=c?"Read more":"Show less";return}
  const l=t.closest("[data-like]");if(l){toggleLike(posts.find(p=>p.id===l.dataset.like));return}
  const d=t.closest("[data-del]");
  if(d&&confirm("Delete this post?")){
    try{await updateDoc(doc(db,"communityPosts",d.dataset.del),{status:"deleted",updatedAt:serverTimestamp()});posts=posts.filter(p=>p.id!==d.dataset.del);renderPosts();toast("Post deleted")}
    catch(err){console.error(err);toast("Could not delete the post")}
    return;
  }
  const go=t.closest("#pgo");if(!go)return;
  const content=$("#pt").value.trim(),img=$("#pi").value.trim();
  if(!content){toast("Write something first");return}
  if(img&&!safe(img)){toast("Image URL must start with https://");return}
  go.disabled=true;
  try{
    const ref=doc(collection(db,"communityPosts"));
    const data={userId:user.uid,userName:user.displayName||(user.email||"").split("@")[0]||"Member",userPhoto:user.photoURL||"",postId:ref.id,content,imageUrl:img,videoUrl:"",attachments:[],
      category:(g.category||"").toLowerCase(),communityId:g.id,communityName:g.title,visibility:"public",likesCount:0,commentsCount:0,sharesCount:0,viewsCount:0,likedBy:[],
      hashtags:[...new Set((content.match(/#[\p{L}\p{N}_]+/gu)||[]).map(x=>x.slice(1).toLowerCase()))].slice(0,10),mentions:[],status:"published",isPinned:false,isEdited:false,allowComments:true,
      createdAt:serverTimestamp(),updatedAt:serverTimestamp()};
    await setDoc(ref,data);posts.unshift({id:ref.id,...data,createdAt:new Date(),updatedAt:new Date()});renderPosts();toast("Posted");
  }catch(err){console.error(err);toast("Could not publish your post");go.disabled=false}
});

/* ---------------- members ---------------- */
async function loadMembers(){
  if(!members){
    try{
      let rows=[];
      for(const col of MEMBER_COLS){
        try{const s=await getDocs(query(collection(db,col),where("groupId","==",g.id),limit(100)));rows=s.docs.map(d=>d.data()).filter(m=>ACTIVE.test(m.status||""));if(rows.length)break}catch{}
      }
      members=await Promise.all(rows.slice(0,60).map(async m=>{
        let p={};try{const u=await getDoc(doc(db,"users",m.userId));if(u.exists())p=u.data()}catch{}
        return {role:m.role,joinedAt:m.joinedAt,owner:m.userId===g.ownerId,name:p.name||p.displayName||p.fullName||p.username||"Member",photo:safe(p.photoURL||p.photo||p.avatar||p.profilePicture)};
      }));
      members.sort((a,b)=>(b.owner-a.owner)||(/admin|owner/i.test(b.role||"")-/admin|owner/i.test(a.role||""))||(toD(a.joinedAt)||0)-(toD(b.joinedAt)||0));
    }catch(e){console.error(e);$("#panel").innerHTML=`<div class="state err"><h2>Unable to load members</h2><p>${esc(e.message||"")}</p></div>`;return}
  }
  $("#panel").innerHTML=members.length?`<div class="ml">${members.map(m=>{const n=(m.name||"?")[0].toUpperCase(),x=toD(m.joinedAt);
    return `<div class="mi"><div class="av" aria-hidden="true">${m.photo?`<img src="${esc(m.photo)}" alt="" loading="lazy" data-n="${esc(n)}">`:esc(n)}</div>
      <div><b>${esc(m.name)}</b><span>${m.owner?"Owner":/admin|owner/i.test(m.role||"")?esc(cap(m.role)):"Member"}${x?`, joined ${esc(ago(x))}`:""}</span></div></div>`}).join("")}</div>`
    :`<div class="state"><h2>No members yet</h2><p>Be the first to join this group.</p></div>`;
}
document.addEventListener("error",e=>{const i=e.target;if(i.tagName==="IMG"){if(i.dataset.n)i.replaceWith(document.createTextNode(i.dataset.n));else if(i.closest(".cv"))i.remove();else if(i.classList.contains("pimg"))i.remove()}},true);

/* ---------------- start ---------------- */
async function start(){
  if(!gid&&!slugParam){$("#msg").innerHTML=`<div class="state"><h2>No group selected</h2><p>Choose a community to open its group.</p><a class="btn" href="communities.html">Browse communities</a></div>`;return}
  if(!g){
    g=await loadGroup();
    if(!g||!/^(published|active|approved)$/i.test(g.status)){
      g=null;$("#msg").innerHTML=`<div class="state"><h2>Group not found</h2><p>It may have been unpublished or removed.</p><a class="btn" href="communities.html">Browse communities</a></div>`;return;
    }
    document.title=`${g.title} | LetsStudy Pro`;
    const md=document.querySelector('meta[name="description"]');if(md)md.content=g.description||g.title;
    countMembers().then(n=>{if(n!==null&&n>0){liveCount=n;const c=$("#mc");if(c)c.textContent=N.format(n)}});
  }
  $("#msg").innerHTML="";
  await loadMembership();posts=null;members=null;
  renderHero();$("#tabs").hidden=false;showTab(tab);
}
$("#year").textContent=new Date().getFullYear();
onAuthStateChanged(auth,u=>{user=u;start()});
</script>
