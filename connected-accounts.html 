
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#102b55">

  <title>Connected Accounts | LetsStudy Pro</title>
  <meta name="description" content="Manage the Google, Facebook and GitHub sign-in accounts connected to your LetsStudy Pro account.">
  <meta name="robots" content="noindex,nofollow">
  <link rel="canonical" href="https://www.letsstudy.pro/connected-accounts.html">

  <style>
    :root {
      --navy: #102b55;
      --blue: #1769d2;
      --background: #f3f6fb;
      --text: #263449;
      --muted: #6b788c;
      --border: #e2e8f0;
      --white: #ffffff;
      --green: #16845b;
      --red: #c03939;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--background);
      color: var(--text);
      line-height: 1.6;
    }

    a {
      color: var(--blue);
      text-decoration: none;
    }

    button {
      font: inherit;
      cursor: pointer;
    }

    header {
      background: var(--navy);
      color: white;
      padding: 17px 6%;
    }

    .header-inner {
      max-width: 1100px;
      margin: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    .brand {
      color: white;
      font-size: 21px;
      font-weight: 800;
    }

    .brand small {
      display: block;
      font-size: 11px;
      font-weight: 400;
      color: #cbd8eb;
    }

    .header-links {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
    }

    .header-links a {
      color: white;
      font-size: 13px;
    }

    .hero {
      background: linear-gradient(120deg, #102b55, #1b579e);
      color: white;
      padding: 45px 20px 65px;
      text-align: center;
    }

    .hero h1 {
      font-size: clamp(28px, 5vw, 38px);
      margin-bottom: 8px;
    }

    .hero p {
      color: #dce8f7;
      max-width: 650px;
      margin: auto;
      font-size: 14px;
    }

    .container {
      max-width: 850px;
      margin: -30px auto 55px;
      padding: 0 17px;
      position: relative;
    }

    .card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 25px;
      margin-bottom: 18px;
      box-shadow: 0 7px 25px rgba(16,43,85,.05);
    }

    .profile {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .avatar {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: #e7f0ff;
      color: var(--navy);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      font-weight: 800;
      overflow: hidden;
      flex-shrink: 0;
    }

    .avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .profile h2 {
      color: var(--navy);
      font-size: 18px;
    }

    .profile p {
      color: var(--muted);
      font-size: 13px;
      overflow-wrap: anywhere;
    }

    .section-title {
      color: var(--navy);
      font-size: 19px;
      margin-bottom: 7px;
    }

    .section-description {
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 20px;
    }

    .account-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 17px 0;
      border-top: 1px solid var(--border);
    }

    .provider-info {
      display: flex;
      align-items: center;
      gap: 13px;
      min-width: 0;
    }

    .provider-icon {
      width: 43px;
      height: 43px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 19px;
      font-weight: 800;
      background: #f0f4fa;
      color: var(--navy);
      flex-shrink: 0;
    }

    .provider-info h3 {
      font-size: 15px;
      color: var(--text);
    }

    .provider-info p {
      color: var(--muted);
      font-size: 12px;
      overflow-wrap: anywhere;
    }

    .status {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      padding: 4px 9px;
      border-radius: 20px;
      margin-top: 4px;
    }

    .connected {
      background: #e7f7ef;
      color: var(--green);
    }

    .not-connected {
      background: #f0f2f5;
      color: #697586;
    }

    .actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .btn {
      border: none;
      border-radius: 7px;
      padding: 9px 14px;
      font-size: 12px;
      font-weight: 700;
    }

    .btn-primary {
      background: var(--blue);
      color: white;
    }

    .btn-primary:hover {
      background: #1056b0;
    }

    .btn-danger {
      background: #fff0f0;
      color: var(--red);
      border: 1px solid #f0d0d0;
    }

    .btn-secondary {
      background: #edf1f7;
      color: var(--navy);
    }

    .btn:disabled {
      opacity: .55;
      cursor: not-allowed;
    }

    .notice {
      background: #edf5ff;
      border-left: 4px solid var(--blue);
      border-radius: 7px;
      padding: 14px 16px;
      font-size: 13px;
      color: #344b68;
      margin-bottom: 18px;
    }

    .message {
      display: none;
      padding: 13px 15px;
      border-radius: 8px;
      font-size: 13px;
      margin-bottom: 18px;
      overflow-wrap: anywhere;
    }

    .message.success {
      display: block;
      background: #e8f7ef;
      color: #176c48;
    }

    .message.error {
      display: block;
      background: #fff0f0;
      color: #a52c2c;
    }

    .message.info {
      display: block;
      background: #edf5ff;
      color: #244d7d;
    }

    .security-list {
      padding-left: 20px;
      color: var(--muted);
      font-size: 13px;
    }

    .security-list li {
      margin-bottom: 8px;
    }

    .loading {
      text-align: center;
      padding: 30px 10px;
      color: var(--muted);
      font-size: 14px;
    }

    .hidden {
      display: none !important;
    }

    footer {
      background: #0c2041;
      color: #d4deed;
      text-align: center;
      padding: 27px 15px;
      font-size: 12px;
    }

    footer a {
      color: white;
      margin: 0 7px;
    }

    @media(max-width: 600px) {
      .account-item {
        align-items: flex-start;
        flex-direction: column;
      }

      .actions {
        width: 100%;
        justify-content: flex-end;
      }

      .header-inner {
        align-items: flex-start;
        flex-direction: column;
      }

      .card {
        padding: 19px;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="header-inner">
    <a href="index.html" class="brand">
      LetsStudy Pro
      <small>Learn. Build. Work. Grow.</small>
    </a>

    <nav class="header-links">
      <a href="dashboard.html">Dashboard</a>
      <a href="profile.html">Profile</a>
      <a href="account.html">Account</a>
    </nav>
  </div>
</header>

<section class="hero">
  <h1>Connected Accounts</h1>
  <p>
    Manage external sign-in methods connected to your
    LetsStudy Pro account.
  </p>
</section>

<main class="container">

  <div id="loading" class="card loading">
    Checking your account...
  </div>

  <div id="pageContent" class="hidden">

    <div id="message" class="message" role="status"
         aria-live="polite"></div>

    <section class="card">
      <div class="profile">
        <div class="avatar" id="avatar">U</div>
        <div>
          <h2 id="userName">User Account</h2>
          <p id="userEmail">Loading email...</p>
          <p id="userId"></p>
        </div>
      </div>
    </section>

    <section class="card">
      <h2 class="section-title">Your Connected Accounts</h2>
      <p class="section-description">
        Connect external accounts to make signing in easier.
        Your connected sign-in methods are managed through
        Firebase Authentication.
      </p>

      <div class="notice">
        Connecting an account allows you to use that provider
        to sign in to the same LetsStudy Pro account. Make sure
        you select an account that belongs to you.
      </div>

      <div id="providerList">

        <div class="account-item" data-provider="google.com">
          <div class="provider-info">
            <div class="provider-icon">G</div>
            <div>
              <h3>Google</h3>
              <p id="googleDetail">Google sign-in</p>
              <span class="status not-connected" id="googleStatus">
                Not connected
              </span>
            </div>
          </div>
          <div class="actions" id="googleActions">
            <button class="btn btn-primary"
                    onclick="connectProvider('google.com')">
              Connect
            </button>
          </div>
        </div>

        <div class="account-item" data-provider="facebook.com">
          <div class="provider-info">
            <div class="provider-icon">f</div>
            <div>
              <h3>Facebook</h3>
              <p id="facebookDetail">Facebook sign-in</p>
              <span class="status not-connected" id="facebookStatus">
                Not connected
              </span>
            </div>
          </div>
          <div class="actions" id="facebookActions">
            <button class="btn btn-primary"
                    onclick="connectProvider('facebook.com')">
              Connect
            </button>
          </div>
        </div>

        <div class="account-item" data-provider="github.com">
          <div class="provider-info">
            <div class="provider-icon">GH</div>
            <div>
              <h3>GitHub</h3>
              <p id="githubDetail">GitHub sign-in</p>
              <span class="status not-connected" id="githubStatus">
                Not connected
              </span>
            </div>
          </div>
          <div class="actions" id="githubActions">
            <button class="btn btn-primary"
                    onclick="connectProvider('github.com')">
              Connect
            </button>
          </div>
        </div>

        <div class="account-item" data-provider="password">
          <div class="provider-info">
            <div class="provider-icon">E</div>
            <div>
              <h3>Email and Password</h3>
              <p id="passwordDetail">Email authentication</p>
              <span class="status not-connected" id="passwordStatus">
                Not connected
              </span>
            </div>
          </div>
          <div class="actions" id="passwordActions">
            <a href="account.html" class="btn btn-secondary">
              Account Settings
            </a>
          </div>
        </div>

        <div class="account-item" data-provider="phone">
          <div class="provider-info">
            <div class="provider-icon">P</div>
            <div>
              <h3>Phone Number</h3>
              <p id="phoneDetail">Phone authentication</p>
              <span class="status not-connected" id="phoneStatus">
                Not connected
              </span>
            </div>
          </div>
          <div class="actions" id="phoneActions">
            <a href="account.html" class="btn btn-secondary">
              Account Settings
            </a>
          </div>
        </div>

      </div>
    </section>

    <section class="card">
      <h2 class="section-title">Account Security</h2>
      <p class="section-description">
        Keep your account protected when using connected
        sign-in providers.
      </p>

      <ul class="security-list">
        <li>Only connect accounts that you own and control.</li>
        <li>Keep your Google, Facebook and GitHub credentials secure.</li>
        <li>Do not share authentication codes or passwords.</li>
        <li>Review your connected accounts regularly.</li>
        <li>Maintain at least one working sign-in method.</li>
      </ul>
    </section>

    <section class="card">
      <h2 class="section-title">Manage Your Account</h2>
      <p class="section-description">
        You can manage other account settings from the
        following pages.
      </p>

      <div class="actions" style="justify-content:flex-start;flex-wrap:wrap;">
        <a href="profile.html" class="btn btn-secondary">My Profile</a>
        <a href="account.html" class="btn btn-secondary">Account Settings</a>
        <a href="security.html" class="btn btn-secondary">Security Policy</a>
      </div>
    </section>

  </div>

  <div id="signedOut" class="card hidden">
    <h2 class="section-title">Sign In Required</h2>
    <p class="section-description">
      Please sign in to manage your connected accounts.
    </p>
    <a href="login.html" class="btn btn-primary">Go to Login</a>
  </div>

</main>

<footer>
  <p>© <span id="year"></span> LetsStudy Pro. All rights reserved.</p>
  <p style="margin-top:9px;">
    <a href="privacy.html">Privacy</a>
    <a href="terms.html">Terms</a>
    <a href="security.html">Security</a>
    <a href="contact.html">Contact</a>
  </p>
  <p style="margin-top:9px;">Learn. Build. Work. Grow.</p>
</footer>

<!-- Firebase SDK -->
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>

<script>
  // LetsStudy Pro Firebase Configuration
  const firebaseConfig = {
    apiKey: "AIzaSyBcOYDfAVKXbKXjsyRgI_0rjodBn678tCc",
    authDomain: "let-s-study-pro-course.firebaseapp.com",
    databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
    projectId: "let-s-study-pro-course",
    storageBucket: "let-s-study-pro-course.firebasestorage.app",
    messagingSenderId: "474928293390",
    appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
    measurementId: "G-85B7V5H5J0"
  };

  if (!firebase.apps.length) {
    firebase.initializeApp(firebaseConfig);
  }

  const auth = firebase.auth();
  const db = firebase.firestore();

  const $ = id => document.getElementById(id);

  $("year").textContent = new Date().getFullYear();

  let currentUser = null;
  let busy = false;

  const providerNames = {
    "google.com": "Google",
    "facebook.com": "Facebook",
    "github.com": "GitHub",
    "password": "Email and Password",
    "phone": "Phone Number"
  };

  function showMessage(message, type = "info") {
    const box = $("message");
    box.textContent = message;
    box.className = "message " + type;
    box.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  function clearMessage() {
    $("message").textContent = "";
    $("message").className = "message";
  }

  function getProvider(providerId) {
    switch (providerId) {
      case "google.com":
        return new firebase.auth.GoogleAuthProvider();

      case "facebook.com":
        return new firebase.auth.FacebookAuthProvider();

      case "github.com":
        return new firebase.auth.GithubAuthProvider();

      default:
        throw new Error("Unsupported sign-in provider.");
    }
  }

  function getProviderAccount(providerId) {
    if (!currentUser) return null;

    return currentUser.providerData.find(
      item => item.providerId === providerId
    ) || null;
  }

  function updateProviderDisplay(providerId) {
    const provider = getProviderAccount(providerId);
    const prefix = {
      "google.com": "google",
      "facebook.com": "facebook",
      "github.com": "github",
      "password": "password",
      "phone": "phone"
    }[providerId];

    if (!prefix) return;

    const status = $(prefix + "Status");
    const detail = $(prefix + "Detail");
    const actions = $(prefix + "Actions");

    if (provider) {
      status.textContent = "Connected";
      status.className = "status connected";

      const accountText =
        provider.email ||
        provider.phoneNumber ||
        provider.displayName ||
        "Account connected";

      detail.textContent = accountText;

      if (providerId !== "password" && providerId !== "phone") {
        actions.innerHTML = "";

        const button = document.createElement("button");
        button.className = "btn btn-danger";
        button.textContent = "Disconnect";
        button.onclick = () => disconnectProvider(providerId);

        actions.appendChild(button);
      }
    } else {
      status.textContent = "Not connected";
      status.className = "status not-connected";

      detail.textContent =
        providerNames[providerId] + " sign-in";

      if (
        providerId === "google.com" ||
        providerId === "facebook.com" ||
        providerId === "github.com"
      ) {
        actions.innerHTML = "";

        const button = document.createElement("button");
        button.className = "btn btn-primary";
        button.textContent = "Connect";
        button.onclick = () => connectProvider(providerId);

        actions.appendChild(button);
      }
    }
  }

  function refreshProviders() {
    if (!currentUser) return;

    [
      "google.com",
      "facebook.com",
      "github.com",
      "password",
      "phone"
    ].forEach(updateProviderDisplay);
  }

  async function loadUserProfile(user) {
    $("userName").textContent =
      user.displayName || "LetsStudy Pro User";

    $("userEmail").textContent =
      user.email || user.phoneNumber || "No email available";

    $("userId").textContent = "User ID: " + user.uid;

    const avatar = $("avatar");

    if (user.photoURL) {
      const img = document.createElement("img");
      img.src = user.photoURL;
      img.alt = "Profile picture";
      img.referrerPolicy = "no-referrer";
      img.onerror = () => {
        avatar.textContent =
          (user.displayName || "U").charAt(0).toUpperCase();
      };

      avatar.innerHTML = "";
      avatar.appendChild(img);
    } else {
      avatar.textContent =
        (user.displayName || "U").charAt(0).toUpperCase();
    }

    try {
      const doc = await db.collection("users").doc(user.uid).get();

      if (doc.exists) {
        const data = doc.data() || {};

        const name =
          data.fullName ||
          data.displayName ||
          [data.firstName, data.lastName].filter(Boolean).join(" ") ||
          user.displayName ||
          "LetsStudy Pro User";

        $("userName").textContent = name;

        if (data.email || user.email) {
          $("userEmail").textContent = data.email || user.email;
        }
      }
    } catch (error) {
      console.warn("Profile information could not be loaded:", error);
    }
  }

  async function connectProvider(providerId) {
    if (!currentUser || busy) return;

    clearMessage();

    if (getProviderAccount(providerId)) {
      showMessage("This account is already connected.", "info");
      return;
    }

    busy = true;
    refreshButtonState(true);

    try {
      const provider = getProvider(providerId);

      if (providerId === "google.com") {
        provider.setCustomParameters({
          prompt: "select_account"
        });
      }

      await currentUser.linkWithPopup(provider);

      currentUser = auth.currentUser;
      refreshProviders();

      showMessage(
        providerNames[providerId] +
        " has been successfully connected to your account.",
        "success"
      );

    } catch (error) {
      console.error("Provider connection error:", error);

      const messages = {
        "auth/provider-already-linked":
          "This sign-in provider is already connected.",
        "auth/credential-already-in-use":
          "This external account is already linked to another account.",
        
        "auth/account-exists-with-different-credential":
          "An account already exists with this email using a different sign-in method.",
        "auth/popup-blocked":
          "Your browser blocked the sign-in popup. Allow popups and try again.",
        "auth/popup-closed-by-user":
          "The sign-in window was closed before completion.",
        "auth/operation-not-allowed":
          "This provider is not enabled in Firebase Authentication.",
        "auth/cancelled-popup-request":
          "Another sign-in window is already open."
      };

      showMessage(
        messages[error.code] ||
        error.message ||
        "Unable to connect this account. Please try again.",
        "error"
      );

    } finally {
      busy = false;
      refreshButtonState(false);
    }
  }

  async function disconnectProvider(providerId) {
    if (!currentUser || busy) return;

    const linkedProviders = currentUser.providerData || [];

    if (linkedProviders.length <= 1) {
      showMessage(
        "You cannot disconnect your only sign-in method. Connect another sign-in method first.",
        "error"
      );
      return;
    }

    const name = providerNames[providerId] || providerId;

    const confirmed = confirm(
      "Are you sure you want to disconnect " + name +
      " from your LetsStudy Pro account?"
    );

    if (!confirmed) return;

    clearMessage();

    busy = true;
    refreshButtonState(true);

    try {
      await currentUser.unlink(providerId);

      currentUser = auth.currentUser;
      refreshProviders();

      showMessage(
        name + " has been disconnected successfully.",
        "success"
      );

    } catch (error) {
      console.error("Provider disconnection error:", error);

      const messages = {
        "auth/no-such-provider":
          "This provider is not connected to your account.",
        "auth/requires-recent-login":
          "Please sign in again before disconnecting this account."
      };

      showMessage(
        messages[error.code] ||
        error.message ||
        "Unable to disconnect this account.",
        "error"
      );

    } finally {
      busy = false;
      refreshButtonState(false);
    }
  }

  function refreshButtonState(disabled) {
    document.querySelectorAll(".actions button").forEach(button => {
      button.disabled = disabled;
    });
  }

  auth.onAuthStateChanged(async user => {
    $("loading").classList.add("hidden");

    if (!user) {
      currentUser = null;
      $("pageContent").classList.add("hidden");
      $("signedOut").classList.remove("hidden");
      return;
    }

    currentUser = user;

    $("signedOut").classList.add("hidden");
    $("pageContent").classList.remove("hidden");

    await loadUserProfile(user);

    if (auth.currentUser) {
      currentUser = auth.currentUser;
      refreshProviders();
    }
  });
</script>

</body>
</html>
