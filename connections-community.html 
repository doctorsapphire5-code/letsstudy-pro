<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Connections | LetsStudy Pro</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
}

header{
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  padding:15px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:20;
}

.logo{
  font-size:21px;
  font-weight:800;
}

.logo span{color:#2563eb}

.home{
  border:0;
  background:#2563eb;
  color:#fff;
  padding:10px 15px;
  border-radius:8px;
  cursor:pointer;
}

.container{
  width:92%;
  max-width:1100px;
  margin:30px auto;
}

.hero{
  margin-bottom:20px;
}

.hero h1{
  font-size:30px;
  margin-bottom:7px;
}

.hero p{
  color:#64748b;
}

.toolbar{
  background:#fff;
  padding:15px;
  border-radius:13px;
  margin-bottom:20px;
  box-shadow:0 4px 18px #00000008;
}

input{
  width:100%;
  padding:12px;
  border:1px solid #dce1e8;
  border-radius:8px;
  outline:none;
}

.grid{
  display:grid;
  grid-template-columns:
    repeat(auto-fill,minmax(270px,1fr));
  gap:18px;
}

.card{
  background:#fff;
  border-radius:14px;
  padding:20px;
  box-shadow:0 5px 20px #0000000b;
  text-align:center;
}

.avatar{
  width:80px;
  height:80px;
  border-radius:50%;
  object-fit:cover;
  background:#e5e7eb;
  margin:auto;
  display:block;
}

.name{
  font-weight:700;
  font-size:18px;
  margin-top:12px;
}

.muted{
  color:#64748b;
  font-size:14px;
  margin-top:5px;
}

.badge{
  display:inline-block;
  margin-top:9px;
  padding:5px 9px;
  border-radius:20px;
  font-size:11px;
  background:#eef2ff;
  color:#4338ca;
}

.actions{
  display:flex;
  gap:8px;
  margin-top:15px;
}

.btn{
  flex:1;
  border:0;
  padding:9px;
  border-radius:8px;
  cursor:pointer;
  background:#2563eb;
  color:white;
}

.btn.secondary{
  background:#eef2f7;
  color:#172033;
}

.empty{
  grid-column:1/-1;
  text-align:center;
  padding:60px 20px;
  color:#64748b;
}

.error{
  color:#dc2626;
}

@media(max-width:600px){
  .hero h1{font-size:25px}
  .container{width:94%}
}
</style>
</head>

<body>

<header>

  <div class="logo">
    LetsStudy <span>Pro</span>
  </div>

  <button
    class="home"
    onclick="location.href='index.html'"
  >
    <i class="fa-solid fa-house"></i>
    Home
  </button>

</header>

<main class="container">

  <section class="hero">

    <h1>
      My Connections
    </h1>

    <p>
      Discover and connect with people across
      the LetsStudy Pro community.
    </p>

  </section>

  <div class="toolbar">

    <input
      id="search"
      type="search"
      placeholder="Search connections..."
    >

  </div>

  <section
    id="grid"
    class="grid"
  >

    <div class="empty">

      <i class="fa-solid fa-spinner fa-spin"></i>

      <p>Loading connections...</p>

    </div>

  </section>

</main>

<script>

const API = "/api/data";

let users = [];


/* =========================
   API LOAD
========================= */

async function loadConnections(){

  const grid =
    document.getElementById("grid");

  try{

    /*
      Public API.

      Firebase remains the database.
      This page reads through:
      
      /api/data?collection=connections
    */

    const response =
      await fetch(
        API +
        "?collection=connections&limit=100"
      );

    const result =
      await response.json();

    if(!response.ok){

      throw new Error(
        result.error ||
        "Failed to load connections"
      );

    }

    users =
      Array.isArray(result.results)
      ? result.results
      : [];

    render();

  }catch(error){

    console.error(error);

    grid.innerHTML = `

      <div class="empty error">

        <i
          class="fa-solid fa-triangle-exclamation"
          style="font-size:35px"
        ></i>

        <h3>
          Failed to load connections
        </h3>

        <p>
          ${escapeHTML(error.message)}
        </p>

      </div>

    `;

  }

}


/* =========================
   RENDER
========================= */

function render(){

  const grid =
    document.getElementById("grid");

  const keyword =
    document
      .getElementById("search")
      .value
      .trim()
      .toLowerCase();

  const result =
    users.filter(user => {

      const text = [

        user.name,
        user.displayName,
        user.username,
        user.email,
        user.bio,
        user.role,
        user.country

      ]
      .filter(Boolean)
      .join(" ")
      .toLowerCase();

      return text.includes(keyword);

    });


  if(!result.length){

    grid.innerHTML = `

      <div class="empty">

        <i
          class="fa-solid fa-users"
          style="font-size:40px"
        ></i>

        <h3>
          No connections found
        </h3>

        <p>
          Try another search.
        </p>

      </div>

    `;

    return;

  }


  grid.innerHTML =
    result
      .map(createCard)
      .join("");

}


/* =========================
   CARD
========================= */

function createCard(user){

  const id =
    user.id ||
    user.documentId ||
    "";

  const name =
    user.displayName ||
    user.name ||
    user.username ||
    "User";

  const username =
    user.username
      ? "@" + user.username
      : "";

  const avatar =
    safeImage(
      user.photoURL ||
      user.avatar ||
      user.profileImage
    );

  const bio =
    user.bio ||
    user.shortBio ||
    "LetsStudy Pro member";

  return `

    <article class="card">

      <img
        class="avatar"
        src="${avatar}"
        alt="${escapeAttr(name)}"
        onerror="
          this.src='https://via.placeholder.com/100';
        "
      >

      <div class="name">

        ${escapeHTML(name)}

      </div>

      ${
        username
        ? `
          <div class="muted">
            ${escapeHTML(username)}
          </div>
        `
        : ""
      }

      ${
        user.country
        ? `
          <div class="muted">

            <i class="fa-solid fa-location-dot"></i>

            ${escapeHTML(user.country)}

          </div>
        `
        : ""
      }

      <span class="badge">

        ${escapeHTML(
          user.role ||
          "Member"
        )}

      </span>

      <p class="muted">

        ${escapeHTML(
          bio
        )}

      </p>

      <div class="actions">

        <button
          class="btn"
          onclick="
            viewProfile(
              '${escapeAttr(id)}'
            )
          "
        >

          <i class="fa-solid fa-user"></i>

          Profile

        </button>

        <button
          class="btn secondary"
          onclick="
            connect(
              '${escapeAttr(id)}'
            )
          "
        >

          <i class="fa-solid fa-user-plus"></i>

          Connect

        </button>

      </div>

    </article>

  `;

}


/* =========================
   PROFILE
========================= */

function viewProfile(id){

  if(!id) return;

  /*
    No unrelated internal link.
    Only navigate when a valid user ID exists.
  */

  location.href =
    "profile-community.html?id=" +
    encodeURIComponent(id);

}


/* =========================
   CONNECT
========================= */

async function connect(id){

  if(!id){

    alert(
      "User ID is not available."
    );

    return;

  }

  /*
    Connection creation should NOT be
    done with the public GET data API.

    Keep this action behind authenticated
    user API/Firebase Auth.
  */

  alert(
    "Connection request flow requires authenticated API."
  );

}


/* =========================
   SEARCH
========================= */

document
  .getElementById("search")
  .addEventListener(
    "input",
    render
  );


/* =========================
   SECURITY HELPERS
========================= */

function escapeHTML(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


function escapeAttr(value){

  return escapeHTML(value)
    .replace(/`/g,"&#096;");

}


function safeImage(url){

  if(!url){

    return "https://via.placeholder.com/100";

  }

  try{

    const parsed =
      new URL(
        String(url),
        location.origin
      );

    if(
      parsed.protocol === "https:" ||
      parsed.protocol === "http:"
    ){

      return escapeAttr(
        parsed.href
      );

    }

  }catch(e){}

  return "https://via.placeholder.com/100";

}


/* =========================
   START
========================= */

loadConnections();

</script>

</body>
</html>