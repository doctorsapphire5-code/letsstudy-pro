<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
>

<title>Connections | Let'sStudy Pro Community</title>

<meta
  name="description"
  content="Manage your Let'sStudy Pro Community connections."
>

<link
  rel="icon"
  href="/favicon.ico"
>

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

:root{
  --bg:#f6f8fb;
  --card:#ffffff;
  --text:#172033;
  --muted:#64748b;
  --border:#e2e8f0;
  --soft:#f1f5f9;
  --primary:#111827;
  --success:#166534;
  --success-bg:#dcfce7;
  --danger:#b91c1c;
  --danger-bg:#fee2e2;
  --warning:#92400e;
  --warning-bg:#fef3c7;
}

body{
  min-height:100vh;

  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  background:var(--bg);
  color:var(--text);
}


/* =========================
   HEADER
========================= */

.topbar{
  min-height:64px;

  position:sticky;
  top:0;
  z-index:100;

  display:flex;
  align-items:center;
  justify-content:space-between;

  padding:0 20px;

  background:
    rgba(255,255,255,.96);

  backdrop-filter:blur(12px);

  border-bottom:
    1px solid var(--border);
}

.brand{
  display:flex;
  align-items:center;
  gap:10px;

  font-size:14px;
  font-weight:850;
}

.brand-icon{
  width:38px;
  height:38px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:11px;

  background:var(--primary);
  color:#fff;
}

.back-btn{
  border:0;

  padding:9px 13px;

  border-radius:10px;

  background:var(--soft);
  color:var(--text);

  font-family:inherit;

  font-size:12px;
  font-weight:750;

  cursor:pointer;
}


/* =========================
   MAIN
========================= */

.container{
  width:100%;
  max-width:850px;

  margin:auto;

  padding:
    28px 16px
    70px;
}

.hero{
  margin-bottom:20px;
}

.hero h1{
  font-size:29px;
  font-weight:850;
}

.hero p{
  margin-top:6px;

  color:var(--muted);

  font-size:13px;
  line-height:1.6;
}


/* =========================
   ERROR
========================= */

.error{
  display:none;

  margin-bottom:15px;
  padding:12px;

  border:
    1px solid #fecaca;

  border-radius:10px;

  background:#fef2f2;

  color:var(--danger);

  font-size:12px;
}

.error.show{
  display:block;
}


/* =========================
   TABS
========================= */

.tabs{
  display:grid;

  grid-template-columns:
    repeat(3,1fr);

  gap:8px;

  margin-bottom:15px;
}

.tab{
  position:relative;

  min-height:44px;

  border:
    1px solid var(--border);

  border-radius:11px;

  background:#fff;

  color:var(--muted);

  font-family:inherit;

  font-size:11px;
  font-weight:800;

  cursor:pointer;
}

.tab.active{
  background:var(--primary);
  color:#fff;

  border-color:
    var(--primary);
}

.count{
  display:inline-flex;

  align-items:center;
  justify-content:center;

  min-width:18px;
  height:18px;

  margin-left:4px;

  padding:0 5px;

  border-radius:20px;

  background:var(--soft);

  color:var(--text);

  font-size:9px;
}

.tab.active .count{
  background:#fff;
  color:var(--primary);
}


/* =========================
   SEARCH
========================= */

.search{
  width:100%;
  height:45px;

  margin-bottom:15px;

  padding:
    0 14px;

  border:
    1px solid var(--border);

  border-radius:11px;

  outline:none;

  background:#fff;

  color:var(--text);

  font-family:inherit;

  font-size:13px;
}

.search:focus{
  border-color:#64748b;
}


/* =========================
   LIST
========================= */

.list{
  display:flex;

  flex-direction:column;

  gap:9px;
}

.connection{
  display:flex;

  align-items:center;

  gap:12px;

  padding:13px 14px;

  background:#fff;

  border:
    1px solid var(--border);

  border-radius:14px;
}

.avatar{
  width:48px;
  height:48px;

  flex-shrink:0;

  display:flex;

  align-items:center;
  justify-content:center;

  overflow:hidden;

  border-radius:50%;

  background:var(--soft);

  font-size:13px;
  font-weight:800;
}

.avatar img{
  width:100%;
  height:100%;

  object-fit:cover;
}

.info{
  min-width:0;
  flex:1;
}

.name{
  font-size:13px;
  font-weight:800;

  overflow:hidden;
  white-space:nowrap;
  text-overflow:ellipsis;
}

.username{
  margin-top:3px;

  color:var(--muted);

  font-size:10px;
}

.date{
  margin-top:5px;

  color:var(--muted);

  font-size:9px;
}

.actions{
  display:flex;

  align-items:center;

  gap:6px;

  flex-shrink:0;
}

.action{
  border:0;

  min-width:72px;

  padding:8px 10px;

  border-radius:8px;

  font-family:inherit;

  font-size:10px;
  font-weight:800;

  cursor:pointer;
}

.accept{
  background:var(--success-bg);
  color:var(--success);
}

.decline,
.cancel{
  background:var(--danger-bg);
  color:var(--danger);
}

.remove{
  background:var(--soft);
  color:var(--text);
}

.action:disabled{
  opacity:.55;
  cursor:not-allowed;
}


/* =========================
   STATUS
========================= */

.status{
  display:inline-flex;

  align-items:center;

  margin-top:6px;

  padding:3px 7px;

  border-radius:6px;

  background:var(--soft);

  color:var(--muted);

  font-size:9px;

  font-weight:800;

  text-transform:capitalize;
}

.status.pending{
  background:var(--warning-bg);
  color:var(--warning);
}

.status.accepted{
  background:var(--success-bg);
  color:var(--success);
}

.status.declined,
.status.blocked{
  background:var(--danger-bg);
  color:var(--danger);
}


/* =========================
   LOADING
========================= */

.loading{
  text-align:center;

  padding:55px;

  color:var(--muted);

  font-size:12px;
}

.spinner{
  width:31px;
  height:31px;

  margin:
    0 auto
    10px;

  border:
    3px solid var(--border);

  border-top-color:
    var(--primary);

  border-radius:50%;

  animation:
    spin .7s linear infinite;
}

@keyframes spin{
  to{
    transform:rotate(360deg);
  }
}


/* =========================
   EMPTY
========================= */

.empty{
  display:none;

  text-align:center;

  padding:55px 20px;

  background:#fff;

  border:
    1px solid var(--border);

  border-radius:15px;

  color:var(--muted);
}

.empty-icon{
  font-size:40px;

  margin-bottom:9px;
}

.empty h3{
  margin-bottom:5px;

  color:var(--text);

  font-size:16px;
}

.empty p{
  font-size:12px;
}


/* =========================
   MOBILE
========================= */

@media(max-width:600px){

  .topbar{
    padding:0 12px;
  }

  .brand{
    font-size:12px;
  }

  .container{
    padding:
      22px 11px
      60px;
  }

  .hero h1{
    font-size:24px;
  }

  .tabs{
    grid-template-columns:
      1fr;
  }

  .connection{
    align-items:flex-start;

    padding:12px;
  }

  .actions{
    flex-direction:column;
  }

  .action{
    min-width:70px;
  }

  .date{
    display:none;
  }

}

</style>

</head>


<body>


<header class="topbar">

  <div class="brand">

    <div class="brand-icon">
      🤝
    </div>

    <span>
      Let'sStudy Pro Community
    </span>

  </div>


  <button
    class="back-btn"
    type="button"
    onclick="goBack()"
  >
    ← Back
  </button>

</header>


<main class="container">


  <section class="hero">

    <h1>
      Connections
    </h1>

    <p>
      Manage your community connections
      and connection requests.
    </p>

  </section>


  <div
    id="errorBox"
    class="error"
  ></div>


  <div class="tabs">

    <button
      id="connectionsTab"
      class="tab active"
      type="button"
    >
      Connections
      <span
        id="connectionsCount"
        class="count"
      >0</span>
    </button>


    <button
      id="receivedTab"
      class="tab"
      type="button"
    >
      Requests
      <span
        id="receivedCount"
        class="count"
      >0</span>
    </button>


    <button
      id="sentTab"
      class="tab"
      type="button"
    >
      Sent
      <span
        id="sentCount"
        class="count"
      >0</span>
    </button>

  </div>


  <input
    id="searchInput"
    class="search"
    type="search"
    placeholder="Search connections..."
    autocomplete="off"
  >


  <div
    id="loading"
    class="loading"
  >

    <div class="spinner"></div>

    <p>
      Loading connections...
    </p>

  </div>


  <section
    id="list"
    class="list"
  ></section>


  <section
    id="empty"
    class="empty"
  >

    <div class="empty-icon">
      🤝
    </div>

    <h3>
      No connections found
    </h3>

    <p>
      There are no connections in this section.
    </p>

  </section>


</main>


<script src="https://www.gstatic.com/firebasejs/10.12.5/firebase-app-compat.js"></script>

<script src="https://www.gstatic.com/firebasejs/10.12.5/firebase-auth-compat.js"></script>

<script src="https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore-compat.js"></script>


<script>

/* =========================
   FIREBASE
========================= */

const firebaseConfig = {

  apiKey:
    "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-85B7V5H5J0"

};


firebase.initializeApp(
  firebaseConfig
);


const db =
  firebase.firestore();

const auth =
  firebase.auth();


/* =========================
   STATE
========================= */

let currentUser =
  null;

let activeTab =
  "connections";

let allConnections =
  [];


/* =========================
   HELPERS
========================= */

function escapeHTML(
  value
){

  return String(
    value ?? ""
  )
  .replaceAll(
    "&",
    "&amp;"
  )
  .replaceAll(
    "<",
    "&lt;"
  )
  .replaceAll(
    ">",
    "&gt;"
  )
  .replaceAll(
    '"',
    "&quot;"
  )
  .replaceAll(
    "'",
    "&#039;"
  );

}


function getInitials(
  name
){

  return String(
    name ||
    "Member"
  )
  .trim()
  .split(/\s+/)
  .slice(0,2)
  .map(
    word =>
      word
        .charAt(0)
        .toUpperCase()
  )
  .join("");

}


function formatDate(
  timestamp
){

  if(!timestamp){

    return "Recently";

  }

  try{

    const date =
      timestamp.toDate
        ? timestamp.toDate()
        : new Date(timestamp);

    return date.toLocaleDateString(
      undefined,
      {
        day:"numeric",
        month:"short",
        year:"numeric"
      }
    );

  }

  catch{

    return "Recently";

  }

}


function showError(
  message
){

  const box =
    document.getElementById(
      "errorBox"
    );

  box.textContent =
    message;

  box.classList.add(
    "show"
  );

}


/* =========================
   AUTH
========================= */

auth.onAuthStateChanged(
  async user => {

    currentUser =
      user;


    if(!user){

      document.getElementById(
        "loading"
      ).style.display =
        "none";

      showError(
        "Please sign in to manage your connections."
      );

      return;

    }


    await loadAllConnections();

  }
);


/* =========================
   LOAD CONNECTIONS
========================= */

async function loadAllConnections(){

  const loading =
    document.getElementById(
      "loading"
    );


  try{

    loading.style.display =
      "block";


    const [sent, received] =
      await Promise.all([

        db
          .collection("connections")
          .where(
            "requesterId",
            "==",
            currentUser.uid
          )
          .get(),

        db
          .collection("connections")
          .where(
            "receiverId",
            "==",
            currentUser.uid
          )
          .get()

      ]);


    const map =
      new Map();


    sent.forEach(
      doc => {

        map.set(
          doc.id,
          {
            id:doc.id,
            ...doc.data()
          }
        );

      }
    );


    received.forEach(
      doc => {

        map.set(
          doc.id,
          {
            id:doc.id,
            ...doc.data()
          }
        );

      }
    );


    allConnections =
      Array.from(
        map.values()
      );


    loading.style.display =
      "none";


    updateCounts();

    render();

  }

  catch(error){

    console.error(
      "Connections error:",
      error
    );


    loading.style.display =
      "none";


    showError(
      "Unable to load connections. Check your Firestore rules."
    );

  }

}


/* =========================
   COUNTS
========================= */

function updateCounts(){

  const connections =
    allConnections.filter(
      item =>
        item.status ===
        "accepted"
    );


  const received =
    allConnections.filter(
      item =>
        item.receiverId ===
        currentUser.uid &&
        item.status ===
        "pending"
    );


  const sent =
    allConnections.filter(
      item =>
        item.requesterId ===
        currentUser.uid &&
        item.status ===
        "pending"
    );


  document.getElementById(
    "connectionsCount"
  ).textContent =
    connections.length;


  document.getElementById(
    "receivedCount"
  ).textContent =
    received.length;


  document.getElementById(
    "sentCount"
  ).textContent =
    sent.length;

}


/* =========================
   RENDER
========================= */

async function render(){

  const list =
    document.getElementById(
      "list"
    );


  const empty =
    document.getElementById(
      "empty"
    );


  list.innerHTML =
    "";


  let filtered =
    [];


  if(
    activeTab ===
    "connections"
  ){

    filtered =
      allConnections.filter(
        item =>
          item.status ===
          "accepted"
      );

  }


  else if(
    activeTab ===
    "received"
  ){

    filtered =
      allConnections.filter(
        item =>
          item.receiverId ===
          currentUser.uid &&
          item.status ===
          "pending"
      );

  }


  else if(
    activeTab ===
    "sent"
  ){

    filtered =
      allConnections.filter(
        item =>
          item.requesterId ===
          currentUser.uid &&
          item.status ===
          "pending"
      );

  }


  const search =
    document
      .getElementById(
        "searchInput"
      )
      .value
      .trim()
      .toLowerCase();


  if(search){

    const result =
      [];


    for(
      const connection of filtered
    ){

      const userId =
        getOtherUserId(
          connection
        );


      const user =
        await getUser(
          userId
        );


      const name =
        String(
          user.displayName ||
          user.username ||
          ""
        ).toLowerCase();


      const username =
        String(
          user.username ||
          ""
        ).toLowerCase();


      if(
        name.includes(search) ||
        username.includes(search)
      ){

        result.push({
          connection,
          user
        });

      }

    }


    filtered =
      result;

  }


  else{

    const result =
      [];


    for(
      const connection of filtered
    ){

      const userId =
        getOtherUserId(
          connection
        );


      const user =
        await getUser(
          userId
        );


      result.push({
        connection,
        user
      });

    }


    filtered =
      result;

  }


  if(!filtered.length){

    empty.style.display =
      "block";

    return;

  }


  empty.style.display =
    "none";


  filtered.forEach(
    item => {

      renderConnection(
        item.connection,
        item.user
      );

    }
  );

}


/* =========================
   OTHER USER
========================= */

function getOtherUserId(
  connection
){

  if(
    connection.requesterId ===
    currentUser.uid
  ){

    return connection.receiverId;

  }


  return connection.requesterId;

}


/* =========================
   GET USER
========================= */

async function getUser(
  userId
){

  try{

    const snapshot =
      await db
        .collection("users")
        .doc(userId)
        .get();


    if(
      snapshot.exists
    ){

      return snapshot.data();

    }

  }

  catch(error){

    console.error(
      "User error:",
      error
    );

  }


  return {};

}


/* =========================
   RENDER CARD
========================= */

function renderConnection(
  connection,
  user
){

  const list =
    document.getElementById(
      "list"
    );


  const name =
    user.displayName ||
    user.username ||
    "Community Member";


  const username =
    user.username
      ? `@${user.username}`
      : "Community Member";


  const photo =
    user.photoURL ||
    "";


  const otherUserId =
    getOtherUserId(
      connection
    );


  const card =
    document.createElement(
      "article"
    );


  card.className =
    "connection";


  const avatar =
    photo

      ? `
        <img
          src="${escapeHTML(
            photo
          )}"
          alt="${escapeHTML(
            name
          )}"
          loading="lazy"
          referrerpolicy="no-referrer"
        >
      `

      : escapeHTML(
          getInitials(
            name
          )
        );


  let actions =
    "";


  if(
    activeTab ===
    "received"
  ){

    actions =
      `
        <button
          class="action accept"
          type="button"
          data-action="accept"
        >
          Accept
        </button>

        <button
          class="action decline"
          type="button"
          data-action="decline"
        >
          Decline
        </button>
      `;

  }


  else if(
    activeTab ===
    "sent"
  ){

    actions =
      `
        <button
          class="action cancel"
          type="button"
          data-action="cancel"
        >
          Cancel
        </button>
      `;

  }


  else{

    actions =
      `
        <button
          class="action remove"
          type="button"
          data-action="remove"
        >
          Remove
        </button>
      `;

  }


  card.innerHTML =
    `
      <div class="avatar">

        ${avatar}

      </div>


      <div class="info">

        <div class="name">

          ${escapeHTML(
            name
          )}

        </div>


        <div class="username">

          ${escapeHTML(
            username
          )}

        </div>


        <div class="date">

          Connected
          ${formatDate(
            connection.createdAt
          )}

        </div>


        <span
          class="status ${escapeHTML(
            connection.status ||
            ""
          )}"
        >

          ${escapeHTML(
            connection.status ||
            "pending"
          )}

        </span>

      </div>


      <div class="actions">

        ${actions}

      </div>
    `;


  card
    .querySelectorAll(
      "[data-action]"
    )
    .forEach(
      button => {

        button.addEventListener(
          "click",
          async () => {

            const action =
              button.dataset.action;


            button.disabled =
              true;


            await handleAction(
              action,
              connection,
              otherUserId
            );


            button.disabled =
              false;

          }
        );

      }
    );


  list.appendChild(
    card
  );

}


/* =========================
   HANDLE ACTION
========================= */

async function handleAction(
  action,
  connection,
  otherUserId
){

  try{

    if(
      action ===
      "accept"
    ){

      await updateConnection(
        connection.id,
        "accepted"
      );

    }


    else if(
      action ===
      "decline"
    ){

      await updateConnection(
        connection.id,
        "declined"
      );

    }


        else if(
      action ===
      "cancel"
    ){

      await updateConnection(
        connection.id,
        "cancelled"
      );

    }


    else if(
      action ===
      "remove"
    ){

      await removeConnection(
        connection.id
      );

    }


    await loadAllConnections();

  }

  catch(error){

    console.error(
      "Connection action error:",
      error
    );

    showError(
      "Unable to update this connection."
    );

  }

}


/* =========================
   UPDATE CONNECTION
========================= */

async function updateConnection(
  connectionId,
  status
){

  await db
    .collection(
      "connections"
    )
    .doc(
      connectionId
    )
    .update({

      status:
        status,

      updatedAt:
        firebase.firestore
          .FieldValue
          .serverTimestamp()

    });

}


/* =========================
   REMOVE CONNECTION
========================= */

async function removeConnection(
  connectionId
){

  await db
    .collection(
      "connections"
    )
    .doc(
      connectionId
    )
    .delete();

}


/* =========================
   TAB HANDLERS
========================= */

document
  .getElementById(
    "connectionsTab"
  )
  .addEventListener(
    "click",
    () => {

      setTab(
        "connections"
      );

    }
  );


document
  .getElementById(
    "receivedTab"
  )
  .addEventListener(
    "click",
    () => {

      setTab(
        "received"
      );

    }
  );


document
  .getElementById(
    "sentTab"
  )
  .addEventListener(
    "click",
    () => {

      setTab(
        "sent"
      );

    }
  );


function setTab(
  tab
){

  activeTab =
    tab;


  document
    .getElementById(
      "connectionsTab"
    )
    .classList.toggle(
      "active",
      tab ===
      "connections"
    );


  document
    .getElementById(
      "receivedTab"
    )
    .classList.toggle(
      "active",
      tab ===
      "received"
    );


  document
    .getElementById(
      "sentTab"
    )
    .classList.toggle(
      "active",
      tab ===
      "sent"
    );


  render();

}


/* =========================
   SEARCH
========================= */

document
  .getElementById(
    "searchInput"
  )
  .addEventListener(
    "input",
    () => {

      render();

    }
  );


/* =========================
   BACK
========================= */

function goBack(){

  if(
    document.referrer &&
    document.referrer.startsWith(
      window.location.origin
    )
  ){

    window.history.back();

  }

  else{

    window.location.href =
      "community.html";

  }

}


/* =========================
   GLOBAL ERROR
========================= */

window.addEventListener(
  "unhandledrejection",
  event => {

    console.error(
      "Unhandled Community error:",
      event.reason
    );

  }
);


/* =========================
   INITIALIZE
========================= */

auth.onAuthStateChanged(
  async user => {

    currentUser =
      user;


    if(!user){

      document.getElementById(
        "loading"
      ).style.display =
        "none";

      showError(
        "Please sign in to manage your connections."
      );

      return;

    }


    document.getElementById(
      "errorBox"
    ).classList.remove(
      "show"
    );


    await loadAllConnections();

  }
);

</script>

