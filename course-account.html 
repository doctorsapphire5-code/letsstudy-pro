
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#101827">
<title>My Account | Vorix Course</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f4f6fb;color:#172033}
header{background:#101827;color:white;padding:18px 20px}
.nav{max-width:950px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap}
.brand{font-size:20px;font-weight:700;color:white;text-decoration:none}
.nav-links{display:flex;gap:15px;flex-wrap:wrap}
.nav-links a{color:white;text-decoration:none;font-size:13px}
.container{max-width:950px;margin:30px auto;padding:0 16px}
.card{background:white;padding:25px;border-radius:14px;margin-bottom:20px;box-shadow:0 4px 18px rgba(0,0,0,.04)}
h1{font-size:25px;margin-bottom:8px}
h2{font-size:18px;margin-bottom:18px}
.subtitle{font-size:14px;color:#667085;line-height:1.6;margin-bottom:22px}
.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.info{padding:14px;background:#f8fafc;border-radius:8px;min-width:0}
.info small{display:block;color:#667085;margin-bottom:7px}
.info strong{font-size:14px;overflow-wrap:anywhere}
label{display:block;font-size:14px;font-weight:600;margin:15px 0 7px}
input,textarea{width:100%;padding:12px;border:1px solid #d0d5dd;border-radius:8px;font-size:14px;outline:none}
input:focus,textarea:focus{border-color:#315bea}
textarea{min-height:90px;resize:vertical}
button{padding:12px 18px;border:0;border-radius:8px;background:#315bea;color:white;font-weight:600;cursor:pointer}
button:hover{background:#2448c5}
button:disabled{opacity:.6;cursor:not-allowed}
.secondary{background:#e9efff;color:#315bea}
.secondary:hover{background:#dbe5ff}
.danger{background:#d92d20}
.danger:hover{background:#b42318}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.message{display:none;margin-top:15px;padding:12px;border-radius:8px;font-size:13px;line-height:1.5}
.success{display:block;background:#ecfdf3;color:#067647}
.error{display:block;background:#fef3f2;color:#b42318}
.warning{display:block;background:#fffaeb;color:#b54708}
footer{text-align:center;padding:25px;color:#98a2b3;font-size:12px}
@media(max-width:600px){.info-grid{grid-template-columns:1fr}.card{padding:20px}}
</style>
</head>

<body>

<header>
  <div class="nav">
    <a href="course-dashboard.html" class="brand">Vorix Course</a>
    <nav class="nav-links">
      <a href="course-dashboard.html">Dashboard</a>
      <a href="course-profile.html">Profile</a>
      <a href="course-settings.html">Settings</a>
    </nav>
  </div>
</header>

<main class="container">

  <section class="card">
    <h1>My Account</h1>
    <p class="subtitle">
      Manage your account information, security and account preferences.
    </p>

    <div class="info-grid">
      <div class="info">
        <small>Full Name</small>
        <strong id="fullName">—</strong>
      </div>

      <div class="info">
        <small>Email Address</small>
        <strong id="email">—</strong>
      </div>

      <div class="info">
        <small>User ID</small>
        <strong id="userId">—</strong>
      </div>

      <div class="info">
        <small>Username</small>
        <strong id="username">—</strong>
      </div>

      <div class="info">
        <small>Account Type</small>
        <strong id="accountType">—</strong>
      </div>

      <div class="info">
        <small>Account Status</small>
        <strong id="status">—</strong>
      </div>

      <div class="info">
        <small>Email Verification</small>
        <strong id="emailVerified">—</strong>
      </div>

      <div class="info">
        <small>Phone Verification</small>
        <strong id="phoneVerified">—</strong>
      </div>

      <div class="info">
        <small>Login Count</small>
        <strong id="loginCount">—</strong>
      </div>

      <div class="info">
        <small>Created At</small>
        <strong id="createdAt">—</strong>
      </div>

      <div class="info">
        <small>Last Login</small>
        <strong id="lastLoginAt">—</strong>
      </div>

      <div class="info">
        <small>Authentication Provider</small>
        <strong id="provider">—</strong>
      </div>
    </div>

    <div id="accountMessage" class="message"></div>
  </section>

  <section class="card">
    <h2>Change Email Address</h2>
    <p class="subtitle">
      Update the email address connected to your account. Recent login may be required.
    </p>

    <form id="emailForm">
      <label for="newEmail">New Email Address</label>
      <input type="email" id="newEmail" placeholder="new@example.com" required>

      <div class="actions">
        <button type="submit" id="emailButton">Update Email</button>
      </div>
    </form>

    <div id="emailMessage" class="message"></div>
  </section>

  <section class="card">
    <h2>Account Security</h2>
    <p class="subtitle">
      Keep your account secure by verifying your email and changing your password regularly.
    </p>

    <div class="actions">
      <button id="verifyButton" class="secondary">
        Send Verification Email
      </button>

      <button id="passwordButton" class="secondary">
        Send Password Reset
      </button>

      <button id="refreshButton" class="secondary">
        Refresh Account
      </button>
    </div>

    <div id="securityMessage" class="message"></div>
  </section>

  <section class="card">
    <h2>Sign Out</h2>
    <p class="subtitle">
      Sign out of your Vorix Course account on this device.
    </p>

    <button id="logoutButton">Sign Out</button>
  </section>

  <section class="card">
    <h2>Delete Account Request</h2>
    <p class="subtitle">
      Submit a request to delete your account. Your request will be reviewed before any permanent deletion.
    </p>

    <form id="deleteForm">
      <label for="deleteReason">Reason for deletion</label>
      <textarea id="deleteReason" maxlength="500"
        placeholder="Tell us why you want to delete your account..."
        required></textarea>

      <div class="actions">
        <button type="submit" class="danger" id="deleteButton">
          Submit Deletion Request
        </button>
      </div>
    </form>

    <div id="deleteMessage" class="message"></div>
  </section>

</main>

<footer>Vorix Course · Account Management</footer>

<script type="module">
import {initializeApp}
from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

import {
  getAuth,
  onAuthStateChanged,
  updateEmail,
  sendEmailVerification,
  sendPasswordResetEmail,
  signOut,
  reload
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

import {
  getFirestore,
  doc,
  getDoc,
  updateDoc,
  addDoc,
  collection,
  serverTimestamp
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";

// Vorix Course Firebase Configuration
const firebaseConfig = {
  apiKey: "AIzaSyDaJ0LKede-fzMTZl-V1SxZ4Ps0IETepE",
  authDomain: "vorix-course.firebaseapp.com",
  projectId: "vorix-course",
  storageBucket: "vorix-course.firebasestorage.app",
  messagingSenderId: "277814413742",
  appId: "1:277814413742:web:fb4515f03591ea07c7603f",
  measurementId: "G-SQ6PN704M7"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

let currentUser = null;
let currentData = {};

function showMessage(id,message,type){
  const element = document.getElementById(id);
  element.textContent = message;
  element.className = "message "+type;
}

function formatDate(value){
  if(!value) return "—";
  const date = value.toDate ? value.toDate() : new Date(value);
  return date.toLocaleString();
}

function setText(id,value){
  document.getElementById(id).textContent =
    value === undefined || value === null || value === ""
      ? "—" : String(value);
}

function getError(error){
  const errors = {
    "auth/email-already-in-use":"This email is already in use.",
    "auth/invalid-email":"Please enter a valid email address.",
    "auth/requires-recent-login":"Please sign in again before performing this action.",
    "auth/too-many-requests":"Too many attempts. Try again later.",
    "auth/network-request-failed":"Check your internet connection."
  };

  return errors[error.code] || error.message || "An error occurred.";
}

async function loadAccount(){
  if(!currentUser) return;

  try{
    await reload(currentUser);

    const ref = doc(db,"users",currentUser.uid);
    const snapshot = await getDoc(ref);

    if(!snapshot.exists()){
      showMessage("accountMessage","Account profile not found.","error");
      return;
    }

    currentData = snapshot.data();

    if(["suspended","banned","disabled"].includes(currentData.status)){
      await signOut(auth);
      window.location.href = "course-login.html";
      return;
    }

    setText("fullName",currentData.fullName || currentUser.displayName);
    setText("email",currentUser.email);
    setText("userId",currentUser.uid);
    setText("username",currentData.username);
    setText("accountType",currentData.accountType);
    setText("status",currentData.status);
    setText("emailVerified",currentUser.emailVerified ? "Verified" : "Not Verified");
    setText("phoneVerified",currentData.phoneVerified ? "Verified" : "Not Verified");
    setText("loginCount",currentData.loginCount ?? 0);
    setText("createdAt",formatDate(currentData.createdAt));
    setText("lastLoginAt",formatDate(currentData.lastLoginAt));
    setText("provider",currentUser.providerData.map(p=>p.providerId).join(", "));

  }catch(error){
    console.error(error);
    showMessage("accountMessage","Unable to load account information.","error");
  }
}

// Change email
document.getElementById("emailForm").addEventListener("submit",async(event)=>{
  event.preventDefault();

  if(!currentUser) return;

  const newEmail = document.getElementById("newEmail").value.trim();

  if(!newEmail || newEmail === currentUser.email){
    showMessage("emailMessage","Enter a different email address.","error");
    return;
  }

  const button = document.getElementById("emailButton");
  button.disabled = true;
  button.textContent = "Updating...";

  try{
    await updateEmail(currentUser,newEmail);

    await updateDoc(doc(db,"users",currentUser.uid),{
      email:newEmail,
      emailVerified:false,
      updatedAt:serverTimestamp()
    });

    await sendEmailVerification(currentUser);

    showMessage(
      "Email updated. Please verify your new email address.",
      "success"
    );

    document.getElementById("emailForm").reset();
    await loadAccount();

  }catch(error){
    console.error(error);
    showMessage("emailMessage",getError(error),"error");
  }finally{
    button.disabled = false;
    button.textContent = "Update Email";
  }
});

// Email verification
document.getElementById("verifyButton").addEventListener("click",async()=>{
  try{
    await reload(currentUser);

    if(currentUser.emailVerified){
      showMessage("securityMessage","Your email is already verified.","success");
      return;
    }

    await sendEmailVerification(currentUser);

    showMessage("securityMessage","Verification email sent. Check your inbox.","success");

  }catch(error){
    showMessage("securityMessage",getError(error),"error");
  }
});

// Password reset
document.getElementById("passwordButton").addEventListener("click",async()=>{
  try{
    if(!currentUser.email){
      showMessage("securityMessage","No email address is linked to this account.","error");
      return;
    }

    await sendPasswordResetEmail(auth,currentUser.email);

    showMessage("securityMessage","Password reset email sent. Check your inbox.","success");

  }catch(error){
    showMessage("securityMessage",getError(error),"error");
  }
});

// Refresh account
document.getElementById("refreshButton").addEventListener("click",async()=>{
  await loadAccount();
  showMessage("securityMessage","Account information refreshed.","success");
});

// Sign out
document.getElementById("logoutButton").addEventListener("click",async()=>{
  try{
    await signOut(auth);
    window.location.href = "course-login.html";
  }catch(error){
    showMessage("accountMessage",getError(error),"error");
  }
});

// Account deletion request
document.getElementById("deleteForm").addEventListener("submit",async(event)=>{
  event.preventDefault();

  if(!currentUser) return;

  const reason = document.getElementById("deleteReason").value.trim();

  if(!reason){
    showMessage("deleteMessage","Please provide a reason.","error");
    return;
  }

  const button = document.getElementById("deleteButton");
  button.disabled = true;
  button.textContent = "Submitting...";

  try{
    await addDoc(collection(db,"accountDeletionRequests"),{
      userId:currentUser.uid,
      email:currentUser.email || "",
      fullName:currentData.fullName || currentUser.displayName || "",
      status:"pending",
      reason:reason,
      requestedAt:serverTimestamp(),
      reviewedAt:null,
      reviewedBy:null
    });

    showMessage(
      "Your account deletion request has been submitted for review.",
      "success"
    );

    document.getElementById("deleteForm").reset();

  }catch(error){
    console.error(error);
    showMessage("deleteMessage",getError(error),"error");
  }finally{
    button.disabled = false;
    button.textContent = "Submit Deletion Request";
  }
});

// Authentication state
onAuthStateChanged(auth,async(user)=>{
  if(!user){
    window.location.href = "course-login.html";
    return;
  }

  currentUser = user;
  await loadAccount();
});
</script>

</body>
</html>
