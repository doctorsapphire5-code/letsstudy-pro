
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0f172a">

  <title>Admin Login | Vorix Course</title>
  <meta name="description" content="Secure administrator login for Vorix Course.">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f1f5f9;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      color: #0f172a;
    }

    .login-container {
      width: 100%;
      max-width: 420px;
      background: white;
      padding: 32px 26px;
      border-radius: 16px;
      box-shadow: 0 10px 35px rgba(0,0,0,.08);
    }

    .logo {
      text-align: center;
      margin-bottom: 28px;
    }

    .logo-icon {
      width: 60px;
      height: 60px;
      margin: 0 auto 14px;
      border-radius: 16px;
      background: #2563eb;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 27px;
      font-weight: bold;
    }

    .logo h1 {
      font-size: 24px;
      margin-bottom: 8px;
    }

    .logo h1 span {
      color: #2563eb;
    }

    .logo p {
      color: #64748b;
      font-size: 13px;
      line-height: 1.6;
    }

    .admin-label {
      display: inline-block;
      margin-top: 13px;
      background: #dbeafe;
      color: #1d4ed8;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: bold;
    }

    .form-group {
      margin-bottom: 19px;
    }

    label {
      display: block;
      font-size: 13px;
      font-weight: bold;
      margin-bottom: 8px;
    }

    input {
      width: 100%;
      padding: 13px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      outline: none;
      font-size: 14px;
    }

    input:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37,99,235,.1);
    }

    .password-wrapper {
      position: relative;
    }

    .password-wrapper input {
      padding-right: 65px;
    }

    .toggle-password {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      border: none;
      background: transparent;
      color: #2563eb;
      font-size: 11px;
      font-weight: bold;
      cursor: pointer;
    }

    .forgot {
      text-align: right;
      margin-top: -7px;
      margin-bottom: 20px;
    }

    .forgot a {
      color: #2563eb;
      text-decoration: none;
      font-size: 12px;
    }

    .login-btn {
      width: 100%;
      padding: 14px;
      background: #2563eb;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
    }

    .login-btn:hover {
      background: #1d4ed8;
    }

    .login-btn:disabled {
      opacity: .6;
      cursor: not-allowed;
    }

    .message {
      display: none;
      padding: 12px;
      margin-bottom: 18px;
      border-radius: 8px;
      font-size: 13px;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }

    .message.error {
      display: block;
      color: #991b1b;
      background: #fee2e2;
    }

    .message.success {
      display: block;
      color: #166534;
      background: #dcfce7;
    }

    .security {
      margin-top: 23px;
      padding: 13px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 9px;
      color: #64748b;
      font-size: 12px;
      line-height: 1.6;
      text-align: center;
    }

    .footer {
      text-align: center;
      margin-top: 23px;
      font-size: 12px;
      color: #94a3b8;
    }

    .footer a {
      color: #2563eb;
      text-decoration: none;
    }
  </style>
</head>

<body>

  <main class="login-container">

    <div class="logo">
      <div class="logo-icon">V</div>

      <h1>VORIX <span>COURSE</span></h1>

      <p>Secure administrator access portal.</p>

      <span class="admin-label">ADMINISTRATOR LOGIN</span>
    </div>

    <div id="message" class="message"></div>

    <form id="adminLoginForm">

      <div class="form-group">
        <label for="email">Administrator Email</label>

        <input
          type="email"
          id="email"
          placeholder="Enter your admin email"
          autocomplete="username"
          required
        >
      </div>

      <div class="form-group">
        <label for="password">Password</label>

        <div class="password-wrapper">
          <input
            type="password"
            id="password"
            placeholder="Enter your password"
            autocomplete="current-password"
            required
          >

          <button
            type="button"
            class="toggle-password"
            id="togglePassword"
          >
            SHOW
          </button>
        </div>
      </div>

      <div class="forgot">
        <a href="course-forgot-password.html">
          Forgot Password?
        </a>
      </div>

      <button
        type="submit"
        class="login-btn"
        id="loginBtn"
      >
        Sign In as Admin
      </button>

    </form>

    <div class="security">
      Secure administrator authentication powered by Firebase.
      Access is restricted to authorized administrators only.
    </div>

    <div class="footer">
      <a href="course-login.html">User Login</a>
      <br><br>
      © <span id="year"></span> Vorix Course.
      All rights reserved.
    </div>

  </main>


  <script type="module">

    import { initializeApp }
      from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

    import {
      getAuth,
      signInWithEmailAndPassword,
      onAuthStateChanged,
      signOut
    } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

    import {
      getFirestore,
      doc,
      getDoc,
      updateDoc,
      serverTimestamp,
      increment
    } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


    // FIREBASE CONFIGURATION
    const firebaseConfig = {
      apiKey: "AIzaSyDaJ0LKede-fz0MTZl-V1SxZ4Ps0IETepE",
      authDomain: "vorix-course.firebaseapp.com",
      projectId: "vorix-course",
      storageBucket: "vorix-course.firebasestorage.app",
      messagingSenderId: "277814413742",
      appId: "1:277814413742:web:fb4515f03591ea07c7603f",
      measurementId: "G-SQ6PN704M7"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);


    const form = document.getElementById("adminLoginForm");
    const loginBtn = document.getElementById("loginBtn");
    const message = document.getElementById("message");

    let checkingAuth = false;


    document.getElementById("year").textContent =
      new Date().getFullYear();


    // DISPLAY MESSAGE
    function showMessage(text, type = "error") {
      message.textContent = text;
      message.className = "message " + type;
    }


    // ERROR HANDLING
    function getErrorMessage(error) {

      const errors = {
        "auth/invalid-email":
          "Please enter a valid email address.",

        "auth/invalid-credential":
          "Invalid email or password.",

        "auth/user-not-found":
          "No account was found with this email.",

        "auth/wrong-password":
          "Incorrect password.",

        "auth/user-disabled":
          "This account has been disabled.",

        "auth/too-many-requests":
          "Too many attempts. Please try again later.",

        "auth/network-request-failed":
          "Network error. Check your internet connection.",

        "permission-denied":
          "Access denied. Please contact the system administrator."
      };

      return errors[error.code] ||
        "Login failed. Please try again.";
    }


    // VERIFY ADMIN ACCOUNT
    async function verifyAdmin(user) {

      const adminRef = doc(db, "admins", user.uid);

      const adminSnap = await getDoc(adminRef);

      if (!adminSnap.exists()) {
        throw new Error("ADMIN_ACCESS_DENIED");
      }

      const adminData = adminSnap.data();

      const role = String(adminData.role || "").toLowerCase();

      const status = String(adminData.status || "").toLowerCase();

      const adminId = adminData.adminId;

      if (role !== "admin") {
        throw new Error("ADMIN_ACCESS_DENIED");
      }

      if (status !== "active") {
        throw new Error("ADMIN_ACCOUNT_INACTIVE");
      }

      if (!adminId || typeof adminId !== "string") {
        throw new Error("ADMIN_ID_MISSING");
      }

      if (
        adminData.email &&
        adminData.email.toLowerCase() !== user.email.toLowerCase()
      ) {
        throw new Error("ADMIN_EMAIL_MISMATCH");
      }

      // Update last login information
      await updateDoc(adminRef, {
        lastLoginAt: serverTimestamp(),
        loginCount: increment(1),
        updatedAt: serverTimestamp()
      });

      return adminData;
    }


    // LOGIN FORM
    form.addEventListener("submit", async (event) => {

      event.preventDefault();

      const email = document.getElementById("email")
        .value.trim();

      const password = document.getElementById("password")
        .value;

      if (!email || !password) {
        showMessage("Please enter your email and password.");
        return;
      }

      try {

        loginBtn.disabled = true;
        loginBtn.textContent = "Authenticating...";

        message.className = "message";

        // Firebase Authentication
        const credential = await signInWithEmailAndPassword(
          auth,
          email,
          password
        );

        // Firestore Admin Verification
        const adminData = await verifyAdmin(credential.user);

        // Save admin details for this browser session
        sessionStorage.setItem("vorixAdminId", adminData.adminId);

        showMessage(
          "Admin authentication successful. Redirecting...",
          "success"
        );

        window.location.replace("course-admin-dashboard.html");

      } catch (error) {

        console.error("Admin Login Error:", error);

        // Sign out unauthorized authenticated users
        if (auth.currentUser) {
          try {
            await signOut(auth);
          } catch (signOutError) {
            console.error("Sign out error:", signOutError);
          }
        }

        if (error.message === "ADMIN_ACCESS_DENIED") {
          showMessage(
            "Access denied. This account is not registered as an administrator."
          );

        } else if (error.message === "ADMIN_ACCOUNT_INACTIVE") {
          showMessage(
            "Your administrator account is not active. Contact the system administrator."
          );

        } else if (error.message === "ADMIN_ID_MISSING") {
          showMessage(
            "Your admin account is missing adminId. Contact the system administrator."
          );

        } else if (error.message === "ADMIN_EMAIL_MISMATCH") {
          showMessage(
            "The administrator email does not match the authenticated account."
          );

        } else {
          showMessage(getErrorMessage(error));
        }

        loginBtn.disabled = false;
        loginBtn.textContent = "Sign In as Admin";

      }

    });


    // SHOW / HIDE PASSWORD
    document.getElementById("togglePassword")
      .addEventListener("click", () => {

        const password = document.getElementById("password");
        const toggle = document.getElementById("togglePassword");

        if (password.type === "password") {
          password.type = "text";
          toggle.textContent = "HIDE";
        } else {
          password.type = "password";
          toggle.textContent = "SHOW";
        }

      });


    // CHECK EXISTING AUTH SESSION
    onAuthStateChanged(auth, async (user) => {

      if (checkingAuth) return;

      if (!user) return;

      checkingAuth = true;

      try {

        const adminRef = doc(db, "admins", user.uid);
        const adminSnap = await getDoc(adminRef);

        if (adminSnap.exists()) {

          const adminData = adminSnap.data();

          if (
            String(adminData.role || "").toLowerCase() === "admin" &&
            String(adminData.status || "").toLowerCase() === "active" &&
            typeof adminData.adminId === "string" &&
            adminData.adminId.length > 0
          ) {

            window.location.replace(
              "course-admin-dashboard.html"
            );

            return;
          }

        }

        // Authenticated user is not an active admin
        await signOut(auth);

      } catch (error) {

        console.error("Admin session verification error:", error);

      } finally {

        checkingAuth = false;

      }

    });

  </script>

</body>
</html>
