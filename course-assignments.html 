<header class="topbar">
  <a class="brand" href="index.html"><span class="brand-mark">L</span>LetsStudy Pro</a>
  <a class="back-btn" id="backBtn" href="course-learn.html"><svg class="i"><use href="#i-arrow"/></svg>Back to course</a>
</header>

<main class="container">
  <section class="hero">
    <h1>Course assignments</h1>
    <p>Instructions, points and submission deadlines. The next due date comes first.</p>
    <div class="chips">
      <span class="chip" id="courseName"></span>
      <span class="chip" id="countChip"></span>
    </div>
  </section>

  <div class="toolbar">
    <label class="search">
      <svg class="i"><use href="#i-search"/></svg>
      <input type="search" id="searchInput" placeholder="Search assignments" aria-label="Search assignments" autocomplete="off">
    </label>
    <div class="filters" id="filters" role="group" aria-label="Filter by deadline"></div>
  </div>

  <section id="assignmentList" class="assignment-list" aria-live="polite">
    <div class="sk"></div><div class="sk"></div><div class="sk"></div>
  </section>
</main>

