<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Course Assignments | LetsStudy Pro</title>

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#f5f7fb;
  color:#111827;
}

.header{
  height:70px;
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 25px;
  position:sticky;
  top:0;
  z-index:100;
}

.logo{
  font-size:22px;
  font-weight:800;
}

.logo span{
  color:#2563eb;
}

.back-btn{
  text-decoration:none;
  background:#eff6ff;
  color:#2563eb;
  padding:10px 15px;
  border-radius:9px;
  font-weight:700;
}

.container{
  max-width:1050px;
  margin:auto;
  padding:30px 18px 50px;
}

.hero{
  background:linear-gradient(135deg,#2563eb,#4f46e5);
  color:white;
  padding:30px;
  border-radius:18px;
  margin-bottom:25px;
}

.hero h1{
  font-size:30px;
  margin-bottom:8px;
}

.hero p{
  line-height:1.6;
  opacity:.92;
}

.course-info{
  margin-top:15px;
  font-size:14px;
  opacity:.9;
}

.search-box{
  background:white;
  border:1px solid #e5e7eb;
  border-radius:13px;
  padding:15px;
  margin-bottom:20px;
}

.search-box input{
  width:100%;
  padding:13px 15px;
  border:1px solid #d1d5db;
  border-radius:9px;
  outline:none;
}

.search-box input:focus{
  border-color:#2563eb;
}

.assignment-list{
  display:flex;
  flex-direction:column;
  gap:17px;
}

.assignment{
  background:white;
  border:1px solid #e5e7eb;
  border-radius:15px;
  padding:22px;
}

.assignment-top{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:20px;
  margin-bottom:12px;
}

.assignment-title{
  font-size:21px;
  font-weight:800;
  line-height:1.4;
}

.badge{
  display:inline-block;
  padding:6px 11px;
  border-radius:20px;
  font-size:12px;
  font-weight:800;
  white-space:nowrap;
}

.badge-points{
  background:#dcfce7;
  color:#166534;
}

.badge-type{
  background:#dbeafe;
  color:#1d4ed8;
}

.instructions{
  color:#475569;
  line-height:1.7;
  white-space:pre-wrap;
  margin-bottom:18px;
}

.details{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  border-top:1px solid #f1f5f9;
  padding-top:15px;
}

.detail{
  background:#f8fafc;
  color:#475569;
  padding:8px 11px;
  border-radius:8px;
  font-size:13px;
}

.deadline{
  color:#b91c1c;
  background:#fee2e2;
}

.created{
  margin-top:13px;
  color:#94a3b8;
  font-size:12px;
}

.loading,
.empty,
.error{
  background:white;
  border-radius:15px;
  padding:45px 20px;
  text-align:center;
  border:1px solid #e5e7eb;
}

.loading{
  color:#64748b;
}

.empty{
  color:#64748b;
}

.error{
  background:#fee2e2;
  color:#991b1b;
  border-color:#fecaca;
}

@media(max-width:600px){

  .header{
    padding:0 15px;
  }

  .logo{
    font-size:19px;
  }

  .container{
    padding:20px 12px 40px;
  }

  .hero{
    padding:23px;
  }

  .hero h1{
    font-size:25px;
  }

  .assignment{
    padding:18px;
  }

  .assignment-top{
    flex-direction:column;
    gap:10px;
  }

}

</style>

</head>

<body>


<header class="header">

  <div class="logo">
    LetsStudy <span>Pro</span>
  </div>

  <a
    href="course-learn.html"
    class="back-btn">

    ← Back to Course

  </a>

</header>


<main class="container">


  <section class="hero">

    <h1>
      Course Assignments
    </h1>

    <p>
      View your assignments, instructions,
      points and submission deadlines.
    </p>

    <div
      class="course-info"
      id="courseInfo">

      Loading assignments...

    </div>

  </section>


  <div class="search-box">

    <input
      type="search"
      id="searchInput"
      placeholder="Search assignments...">

  </div>


  <section
    id="assignmentList"
    class="assignment-list">

    <div class="loading">

      Loading assignments...

    </div>

  </section>


</main>


<script type="module">

import {
  initializeApp
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";


import {
  getFirestore,
  collection,
  getDocs,
  query,
  where
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";


/* =====================================================
   FIREBASE
===================================================== */

const firebaseConfig = {

  apiKey:
    "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-85B7V5H5J0"

};


const app =
  initializeApp(firebaseConfig);


const db =
  getFirestore(app);


/* =====================================================
   ELEMENTS
===================================================== */

const assignmentList =
  document.getElementById(
    "assignmentList"
  );

const searchInput =
  document.getElementById(
    "searchInput"
  );

const courseInfo =
  document.getElementById(
    "courseInfo"
  );


/* =====================================================
   COURSE ID
===================================================== */

const params =
  new URLSearchParams(
    window.location.search
  );


const courseId =
  params.get("courseId") ||
  params.get("id");


/* =====================================================
   DATA
===================================================== */

let assignments = [];


/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHTML(value){

  if(
    value === undefined ||
    value === null
  ){

    return "";

  }

  return String(value)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


/* =====================================================
   DATE
===================================================== */

function getDate(value){

  if(!value){

    return null;

  }

  try{

    if(
      typeof value === "object" &&
      value.seconds
    ){

      return new Date(
        Number(value.seconds) * 1000
      );

    }

    const date =
      new Date(value);

    if(
      Number.isNaN(
        date.getTime()
      )
    ){

      return null;

    }

    return date;

  }catch(error){

    return null;

  }

}


function formatDate(value){

  const date =
    getDate(value);


  if(!date){

    return "Not specified";

  }


  return date.toLocaleString(
    undefined,
    {
      year:"numeric",
      month:"short",
      day:"numeric",
      hour:"2-digit",
      minute:"2-digit"
    }
  );

}


/* =====================================================
   DEADLINE STATUS
===================================================== */

function deadlineClass(value){

  const date =
    getDate(value);


  if(
    date &&
    date.getTime() < Date.now()
  ){

    return "deadline";

  }

  return "";

}


/* =====================================================
   LOAD ASSIGNMENTS
===================================================== */

async function loadAssignments(){

  try{

    let snapshot;


    if(courseId){

      const assignmentQuery =
        query(

          collection(
            db,
            "assignments"
          ),

          where(
            "courseId",
            "==",
            courseId
          )

        );


      snapshot =
        await getDocs(
          assignmentQuery
        );

    }else{

      snapshot =
        await getDocs(
          collection(
            db,
            "assignments"
          )
        );

    }


    assignments = [];


    snapshot.forEach(
      assignmentDoc => {

        assignments.push({

          id:
            assignmentDoc.id,

          ...assignmentDoc.data()

        });

      }
    );


    assignments.sort(
      (a,b) => {

        const dateA =
          getDate(
            a.deadline
          );

        const dateB =
          getDate(
            b.deadline
          );


        if(!dateA) return 1;

        if(!dateB) return -1;


        return (
          dateA.getTime() -
          dateB.getTime()
        );

      }
    );


    courseInfo.textContent =
      courseId
      ? `Course ID: ${courseId} • ${assignments.length} assignment${assignments.length === 1 ? "" : "s"}`
      : `All assignments • ${assignments.length} assignment${assignments.length === 1 ? "" : "s"}`;


    renderAssignments();

  }catch(error){

    console.error(
      "Assignments loading error:",
      error
    );


    assignmentList.innerHTML = `

      <div class="error">

        Unable to load assignments.
        Please try again.

      </div>

    `;

  }

}


/* =====================================================
   RENDER
===================================================== */

function renderAssignments(){

  const search =
    searchInput.value
      .trim()
      .toLowerCase();


  const filtered =
    assignments.filter(
      assignment => {

        const text = [

          assignment.title,

          assignment.instructions,

          assignment.submissionType,

          assignment.createdBy

        ]
          .filter(Boolean)
          .join(" ")
          .toLowerCase();


        return (
          !search ||
          text.includes(search)
        );

      }
    );


  if(
    filtered.length === 0
  ){

    assignmentList.innerHTML = `

      <div class="empty">

        <h3 style="margin-bottom:8px;">
          No assignments found
        </h3>

        <p>
          There are currently no assignments
          available for this course.
        </p>

      </div>

    `;

    return;

  }


  assignmentList.innerHTML =
    filtered.map(
      assignment => {

        const points =
          assignment.points ??
          0;


        const submissionType =
          assignment.submissionType ||
          "Not specified";


        return `

          <article
            class="assignment">

            <div
              class="assignment-top">

              <h2
                class="assignment-title">

                ${escapeHTML(
                  assignment.title ||
                  "Untitled Assignment"
                )}

              </h2>


              <span
                class="badge badge-points">

                ${escapeHTML(
                  points
                )} points

              </span>

            </div>


            <div
              class="instructions">

              ${escapeHTML(
                assignment.instructions ||
                "No instructions available."
              )}

            </div>


            <div
              class="details">


              <span
                class="detail badge-type">

                📤

                Submission:
                ${escapeHTML(
                  submissionType
                )}

              </span>


              ${
                assignment.deadline
                ?
                `
                <span
                  class="detail
                  ${deadlineClass(
                    assignment.deadline
                  )}">

                  ⏰

                  Deadline:
                  ${formatDate(
                    assignment.deadline
                  )}

                </span>
                `
                :
                ""
              }


              ${
                assignment.courseId
                ?
                `
                <span
                  class="detail">

                  🎓

                  Course:
                  ${escapeHTML(
                    assignment.courseId
                  )}

                </span>
                `
                :
                ""
              }

            </div>


            ${
              assignment.createdBy
              ?
              `
              <div
                class="created">

                Created by
                ${escapeHTML(
                  assignment.createdBy
                )}

              </div>
              `
              :
              ""
            }

          </article>

        `;

      }
    ).join("");

}


/* =====================================================
   SEARCH
===================================================== */

searchInput.addEventListener(
  "input",
  renderAssignments
);


/* =====================================================
   START
===================================================== */

loadAssignments();

</script>

</body>
</html>