<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Course Assignments | LetsStudy Pro</title>
  <meta name="description" content="Complete and submit assignments for your course on LetsStudy Pro.">

  <link rel="icon" href="favicon.ico">

  <style>
    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
    }

    body{
      font-family:Inter,Arial,sans-serif;
      background:#f5f7fb;
      color:#172033;
    }

    header{
      background:#fff;
      border-bottom:1px solid #e5e7eb;
      position:sticky;
      top:0;
      z-index:20;
    }

    .nav{
      max-width:1150px;
      margin:auto;
      padding:16px 20px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:15px;
    }

    .brand{
      font-size:21px;
      font-weight:800;
      color:#111827;
      text-decoration:none;
    }

    .brand span{
      color:#2563eb;
    }

    .back{
      text-decoration:none;
      color:#2563eb;
      font-weight:600;
    }

    main{
      max-width:1050px;
      margin:auto;
      padding:35px 20px 60px;
    }

    .hero{
      background:linear-gradient(135deg,#111827,#2563eb);
      color:white;
      border-radius:22px;
      padding:32px;
      margin-bottom:25px;
    }

    .hero small{
      opacity:.8;
      font-weight:600;
    }

    .hero h1{
      font-size:32px;
      margin:8px 0;
    }

    .hero p{
      max-width:750px;
      line-height:1.6;
      opacity:.9;
    }

    .loading,
    .empty,
    .error{
      background:#fff;
      border-radius:18px;
      padding:35px;
      text-align:center;
      border:1px solid #e5e7eb;
    }

    .assignment-list{
      display:grid;
      gap:18px;
    }

    .assignment{
      background:#fff;
      border:1px solid #e5e7eb;
      border-radius:18px;
      padding:24px;
      box-shadow:0 5px 18px rgba(0,0,0,.04);
    }

    .assignment-top{
      display:flex;
      justify-content:space-between;
      gap:15px;
      align-items:flex-start;
      margin-bottom:12px;
    }

    .assignment h2{
      font-size:21px;
      margin-bottom:7px;
    }

    .badge{
      padding:7px 11px;
      border-radius:999px;
      font-size:12px;
      font-weight:700;
      background:#eef2ff;
      color:#4338ca;
      white-space:nowrap;
    }

    .description{
      color:#667085;
      line-height:1.65;
      margin-bottom:18px;
    }

    .meta{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin-bottom:18px;
    }

    .meta span{
      background:#f8fafc;
      border:1px solid #e5e7eb;
      border-radius:9px;
      padding:8px 11px;
      font-size:13px;
      color:#475467;
    }

    .instructions{
      background:#f8fafc;
      border-radius:12px;
      padding:15px;
      margin-bottom:18px;
      line-height:1.6;
      white-space:pre-wrap;
    }

    .actions{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
    }

    button,
    .btn{
      border:0;
      cursor:pointer;
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:11px 17px;
      border-radius:10px;
      font-weight:700;
      font-size:14px;
    }

    .primary{
      background:#2563eb;
      color:white;
    }

    .secondary{
      background:#eef2f7;
      color:#344054;
    }

    .submit-box{
      display:none;
      margin-top:20px;
      border-top:1px solid #e5e7eb;
      padding-top:20px;
    }

    .submit-box textarea{
      width:100%;
      min-height:130px;
      resize:vertical;
      border:1px solid #d0d5dd;
      border-radius:12px;
      padding:13px;
      font:inherit;
      outline:none;
      margin-bottom:10px;
    }

    .submit-box textarea:focus{
      border-color:#2563eb;
    }

    .status{
      margin-top:12px;
      font-size:14px;
      font-weight:600;
    }

    footer{
      text-align:center;
      padding:25px;
      color:#667085;
      font-size:13px;
    }

    @media(max-width:650px){
      .hero{
        padding:24px;
      }

      .hero h1{
        font-size:26px;
      }

      .assignment-top{
        flex-direction:column;
      }

      .nav{
        padding:14px 16px;
      }

      main{
        padding:25px 15px 50px;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="nav">
    <a class="brand" href="index.html">LetsStudy <span>Pro</span></a>
    <a class="back" id="backLink" href="#">← Course</a>
  </div>
</header>

<main>

  <section class="hero">
    <small>COURSE ASSIGNMENTS</small>
    <h1 id="courseTitle">Loading course...</h1>
    <p id="courseDescription">
      Complete the assignments provided for this course and track your progress.
    </p>
  </section>

  <div id="loading" class="loading">
    Loading assignments...
  </div>

  <div id="error" class="error" style="display:none;">
    <h2>Unable to load assignments</h2>
    <p id="errorText">Please try again.</p>
  </div>

  <div id="empty" class="empty" style="display:none;">
    <h2>No assignments yet</h2>
    <p>This course does not have any assignments available yet.</p>
  </div>

  <section id="assignmentList" class="assignment-list"></section>

</main>

<footer>
  © <span id="year"></span> LetsStudy Pro. Learn. Practice. Grow.
</footer>

<script type="module">

  import { initializeApp }
    from "https://www.gstatic.com/firebasejs/10.12.5/firebase-app.js";

  import {
    getFirestore,
    doc,
    getDoc
  } from "https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyBcOYDfAVK5XbkljsyRgI_0rj0odBn678tCc",
    authDomain: "let-s-study-pro-course.firebaseapp.com",
    databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
    projectId: "let-s-study-pro-course",
    storageBucket: "let-s-study-pro-course.firebasestorage.app",
    messagingSenderId: "474928293390",
    appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
    measurementId: "G-85B7V5H5J0"
  };

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);

  const params = new URLSearchParams(window.location.search);
  const courseId = params.get("id");

  const courseTitle = document.getElementById("courseTitle");
  const courseDescription = document.getElementById("courseDescription");
  const assignmentList = document.getElementById("assignmentList");

  const loading = document.getElementById("loading");
  const empty = document.getElementById("empty");
  const error = document.getElementById("error");
  const errorText = document.getElementById("errorText");
  const backLink = document.getElementById("backLink");

  document.getElementById("year").textContent =
    new Date().getFullYear();

  backLink.href = courseId
    ? `course-details.html?id=${encodeURIComponent(courseId)}`
    : "course-details.html";

  function first(obj, fields, fallback=""){
    for(const field of fields){
      if(
        obj &&
        obj[field] !== undefined &&
        obj[field] !== null &&
        String(obj[field]).trim() !== ""
      ){
        return obj[field];
      }
    }
    return fallback;
  }

  function getAssignments(course){

    let data =
      course.assignments ??
      course.assignment ??
      course.courseAssignments ??
      course.tasks ??
      [];

    if(Array.isArray(data)){
      return data;
    }

    if(data && Array.isArray(data.items)){
      return data.items;
    }

    if(data && Array.isArray(data.assignments)){
      return data.assignments;
    }

    if(data && typeof data === "object"){
      return Object.entries(data).map(([id,value]) => ({
        ...(typeof value === "object" ? value : {}),
        assignmentId:id
      }));
    }

    return [];
  }

  function getAssignmentTitle(assignment,index){
    return first(
      assignment,
      ["title","name","assignmentTitle","taskTitle"],
      `Assignment ${index + 1}`
    );
  }

  function getDescription(assignment){
    return first(
      assignment,
      ["description","content","summary","details"],
      "Complete this assignment according to the course instructions."
    );
  }

  function getInstructions(assignment){
    return first(
      assignment,
      ["instructions","instruction","requirements","task"],
      ""
    );
  }

  function getDueDate(assignment){
    return first(
      assignment,
      ["dueDate","deadline","due","submissionDeadline"],
      ""
    );
  }

  function getPoints(assignment){
    return first(
      assignment,
      ["points","marks","score","maxScore"],
      ""
    );
  }

  function getType(assignment){
    return first(
      assignment,
      ["type","assignmentType","submissionType"],
      "Assignment"
    );
  }

  function renderAssignments(assignments){

    assignmentList.innerHTML = "";

    if(!assignments.length){
      empty.style.display = "block";
      return;
    }

    assignments.forEach((assignment,index)=>{

      const title = getAssignmentTitle(assignment,index);
      const description = getDescription(assignment);
      const instructions = getInstructions(assignment);
      const dueDate = getDueDate(assignment);
      const points = getPoints(assignment);
      const type = getType(assignment);

      const card = document.createElement("article");
      card.className = "assignment";

      card.innerHTML = `
        <div class="assignment-top">
          <div>
            <h2>${escapeHTML(title)}</h2>
          </div>

          <span class="badge">
            ${escapeHTML(type)}
          </span>
        </div>

        <p class="description">
          ${escapeHTML(description)}
        </p>

        <div class="meta">
          ${
            dueDate
              ? `<span>Due: ${escapeHTML(formatDate(dueDate))}</span>`
              : ""
          }

          ${
            points !== ""
              ? `<span>Points: ${escapeHTML(String(points))}</span>`
              : ""
          }

          <span>Assignment ${index + 1}</span>
        </div>

        ${
          instructions
            ? `
              <div class="instructions">
                <strong>Instructions</strong><br>
                ${escapeHTML(instructions)}
              </div>
            `
            : ""
        }

        <div class="actions">
          <button class="primary submit-btn">
            Submit Assignment
          </button>

          <button class="secondary details-btn">
            ${instructions ? "Hide Instructions" : "Assignment Details"}
          </button>
        </div>

        <div class="submit-box">

          <textarea
            placeholder="Write your answer or submission here..."
          ></textarea>

          <button class="primary save-btn">
            Save Submission
          </button>

          <div class="status"></div>

        </div>
      `;

      assignmentList.appendChild(card);

      const submitBtn =
        card.querySelector(".submit-btn");

      const detailsBtn =
        card.querySelector(".details-btn");

      const submitBox =
        card.querySelector(".submit-box");

      const textarea =
        card.querySelector("textarea");

      const saveBtn =
        card.querySelector(".save-btn");

      const status =
        card.querySelector(".status");

      const storageKey =
        `courseAssignment_${courseId}_${index}`;

      const saved =
        localStorage.getItem(storageKey);

      if(saved){
        textarea.value = saved;
        status.textContent = "Draft saved locally.";
      }

      submitBtn.addEventListener("click",()=>{
        submitBox.style.display =
          submitBox.style.display === "block"
            ? "none"
            : "block";

        textarea.focus();
      });

      detailsBtn.addEventListener("click",()=>{

        const instructionBox =
          card.querySelector(".instructions");

        if(!instructionBox){
          submitBox.style.display = "block";
          textarea.focus();
          return;
        }

        const hidden =
          instructionBox.style.display === "none";

        instructionBox.style.display =
          hidden ? "block" : "none";

        detailsBtn.textContent =
          hidden
            ? "Hide Instructions"
            : "Show Instructions";
      });

      saveBtn.addEventListener("click",()=>{

        const answer =
          textarea.value.trim();

        if(!answer){
          status.textContent =
            "Please enter your submission first.";
          return;
        }

        localStorage.setItem(
          storageKey,
          answer
        );

        status.textContent =
          "Submission saved locally.";
      });

    });
  }

  function formatDate(value){

    if(!value) return "";

    try{

      const date = new Date(value);

      if(Number.isNaN(date.getTime())){
        return String(value);
      }

      return date.toLocaleDateString(
        undefined,
        {
          year:"numeric",
          month:"short",
          day:"numeric"
        }
      );

    }catch{
      return String(value);
    }
  }

  function escapeHTML(value){

    return String(value ?? "")
      .replace(/&/g,"&amp;")
      .replace(/</g,"&lt;")
      .replace(/>/g,"&gt;")
      .replace(/"/g,"&quot;")
      .replace(/'/g,"&#039;");
  }

  async function loadCourse(){

    if(!courseId){

      loading.style.display = "none";
      error.style.display = "block";

      errorText.textContent =
        "Course information is missing.";

      return;
    }

    try{

      const courseRef =
        doc(db,"courses",courseId);

      const snapshot =
        await getDoc(courseRef);

      if(!snapshot.exists()){

        loading.style.display = "none";
        error.style.display = "block";

        errorText.textContent =
          "The requested course could not be found.";

        return;
      }

      const course =
        snapshot.data();

      const title =
        first(
          course,
          ["title","name","courseTitle"],
          "Course"
        );

      const description =
        first(
          course,
          ["description","summary","shortDescription"],
          "Complete the assignments provided for this course."
        );

      courseTitle.textContent = title;
      courseDescription.textContent = description;

      const assignments =
        getAssignments(course);

      loading.style.display = "none";

      renderAssignments(assignments);

    }catch(err){

      console.error(err);

      loading.style.display = "none";
      error.style.display = "block";

      errorText.textContent =
        "There was a problem loading this course. Please try again.";
    }
  }

  loadCourse();

</script>

</body>
</html>
