<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getFirestore, collection, getDocs, getDoc, doc, query, where } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

/* FIREBASE */
const firebaseConfig = {
  apiKey: "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",
  authDomain: "let-s-study-pro-course.firebaseapp.com",
  databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
  projectId: "let-s-study-pro-course",
  storageBucket: "let-s-study-pro-course.firebasestorage.app",
  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
};
const db = getFirestore(initializeApp(firebaseConfig));

/* ELEMENTS */
const $ = (id) => document.getElementById(id);
const list = $("assignmentList"), searchInput = $("searchInput"), filtersEl = $("filters");

/* COURSE ID */
const params = new URLSearchParams(window.location.search);
const courseId = params.get("courseId") || params.get("id");
if(courseId) $("backBtn").href = `course-learn.html?courseId=${encodeURIComponent(courseId)}`;

/* STATE */
let assignments = [];
let activeFilter = "all";
const FILTERS = [["all","All"],["upcoming","Upcoming"],["overdue","Overdue"],["none","No deadline"]];

/* HELPERS */
const icon = (n) => `<svg class="i"><use href="#i-${n}"/></svg>`;
const escapeHTML = (v) => (v === undefined || v === null) ? "" : String(v).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;");

function getDate(value){
  if(!value) return null;
  try{
    if(typeof value.toDate === "function") return value.toDate();
    if(typeof value === "object" && value.seconds) return new Date(Number(value.seconds) * 1000);
    const d = new Date(value);
    return Number.isNaN(d.getTime()) ? null : d;
  }catch(e){ return null; }
}

const formatDate = (d) => d.toLocaleString(undefined, { year:"numeric", month:"short", day:"numeric", hour:"2-digit", minute:"2-digit" });

/* Deadline status: overdue | soon (within 72 h) | upcoming | none */
function dueInfo(value){
  const d = getDate(value);
  if(!d) return { status: "none", group: "none", label: "", date: null };
  const mins = Math.round((d.getTime() - Date.now()) / 60000);
  const abs = Math.abs(mins);
  const span = abs < 60 ? `${abs} min` : abs < 1440 ? `${Math.floor(abs / 60)} h` : `${Math.floor(abs / 1440)} d`;
  if(mins < 0) return { status: "overdue", group: "overdue", label: `Overdue by ${span}`, date: d };
  return { status: mins <= 4320 ? "soon" : "upcoming", group: "upcoming", label: `Due in ${span}`, date: d };
}

/* LOAD: only this course's assignments */
async function loadAssignments(){
  if(!courseId){
    list.innerHTML = `
      <div class="error"><div class="state-icon">${icon("alert")}</div>
        <h3>Course not specified</h3>
        <p>Open assignments from a course page to see its tasks.</p>
      </div>`;
    return;
  }

  try{
    const [snapshot, courseSnap] = await Promise.all([
      getDocs(query(collection(db, "assignments"), where("courseId", "==", courseId))),
      getDoc(doc(db, "courses", courseId)).catch(() => null)
    ]);

    assignments = [];
    snapshot.forEach((d) => {
      const data = d.data();
      if(String(data.courseId || "") === String(courseId)) assignments.push({ id: d.id, ...data });
    });

    /* Upcoming first (soonest), then no deadline, then overdue (most recent first) */
    const rank = (a) => { const t = getDate(a.deadline)?.getTime(); return t === undefined ? [1, 0] : t >= Date.now() ? [0, t] : [2, -t]; };
    assignments.sort((a, b) => { const x = rank(a), y = rank(b); return x[0] - y[0] || x[1] - y[1]; });

    const c = courseSnap && courseSnap.exists() ? courseSnap.data() : {};
    $("courseName").textContent = c.title || c.name || c.courseName || "";
    $("countChip").textContent = `${assignments.length} ${assignments.length === 1 ? "assignment" : "assignments"}`;

    renderFilters();
    renderAssignments();
  }catch(error){
    console.error("Assignments loading error:", error);
    list.innerHTML = `
      <div class="error"><div class="state-icon">${icon("alert")}</div>
        <h3>Unable to load assignments</h3>
        <p>Check your connection and try again.</p>
        <button class="retry" id="retryBtn" type="button">Try again</button>
      </div>`;
    $("retryBtn").addEventListener("click", () => window.location.reload());
  }
}

/* FILTERS */
function renderFilters(){
  const counts = { all: assignments.length, upcoming: 0, overdue: 0, none: 0 };
  assignments.forEach(a => counts[dueInfo(a.deadline).group]++);
  filtersEl.innerHTML = FILTERS
    .filter(([key]) => key === "all" || counts[key])
    .map(([key, label]) => `<button class="filter" type="button" data-f="${key}" aria-pressed="${key === activeFilter}">${label}<small>${counts[key]}</small></button>`)
    .join("");
}

filtersEl.addEventListener("click", (e) => {
  const btn = e.target.closest(".filter");
  if(!btn) return;
  activeFilter = btn.dataset.f;
  filtersEl.querySelectorAll(".filter").forEach(b => b.setAttribute("aria-pressed", String(b === btn)));
  renderAssignments();
});

/* RENDER */
function renderAssignments(){
  const search = searchInput.value.trim().toLowerCase();

  const filtered = assignments.filter((a) => {
    if(activeFilter !== "all" && dueInfo(a.deadline).group !== activeFilter) return false;
    if(!search) return true;
    return [a.title, a.instructions, a.submissionType, a.createdBy].filter(Boolean).join(" ").toLowerCase().includes(search);
  });

  if(!filtered.length){
    const none = !assignments.length;
    list.innerHTML = `
      <div class="empty"><div class="state-icon">${icon(none ? "task" : "search")}</div>
        <h3>${none ? "No assignments yet" : "No matching assignments"}</h3>
        <p>${none ? "When your instructor adds an assignment, it will appear here." : "Try a different search or choose another filter."}</p>
      </div>`;
    return;
  }

  list.innerHTML = filtered.map((a) => {
    const due = dueInfo(a.deadline);
    const instructions = a.instructions || "No instructions available.";
    const long = instructions.length > 240 || instructions.split("\n").length > 4;
    return `
      <article class="assignment s-${due.status}">
        <div class="assignment-top">
          <h2 class="assignment-title">${escapeHTML(a.title || "Untitled assignment")}</h2>
          <div class="points"><b>${escapeHTML(a.points ?? 0)}</b><span>points</span></div>
        </div>
        <div class="instructions">${escapeHTML(instructions)}</div>
        ${long ? `<button class="more" type="button" aria-expanded="false">Show more</button>` : ""}
        <div class="details">
          <span class="detail">${icon("upload")}<span>Submit as <span class="cap">${escapeHTML(a.submissionType || "not specified")}</span></span></span>
          ${due.date ? `<span class="detail">${icon("clock")}<span>${escapeHTML(formatDate(due.date))}</span></span><span class="detail due-${due.status}">${escapeHTML(due.label)}</span>` : ""}
        </div>
        ${a.createdBy ? `<div class="created">Posted by ${escapeHTML(a.createdBy)}</div>` : ""}
      </article>`;
  }).join("");
}

/* Show more / less */
list.addEventListener("click", (e) => {
  const btn = e.target.closest(".more");
  if(!btn) return;
  const open = btn.closest(".assignment").classList.toggle("open");
  btn.textContent = open ? "Show less" : "Show more";
  btn.setAttribute("aria-expanded", String(open));
});

searchInput.addEventListener("input", renderAssignments);

loadAssignments();
</script>
</body>
