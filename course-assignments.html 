<style>
:root{
  --ink:#0d1b2a;--ink-2:#16293f;--paper:#f2f5f9;--card:#fff;--line:#dde4ec;
  --mute:#5b6b7e;--brand:#0a7c66;--brand-soft:#e2f4ef;--amber:#f2a93b;--red:#c0392b;
  --head:"Bricolage Grotesque","Figtree",system-ui,sans-serif;
  --body:"Figtree",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:var(--body);background:var(--paper);color:var(--ink);line-height:1.55;-webkit-font-smoothing:antialiased;min-height:100vh;display:flex;flex-direction:column}
a{color:inherit}
:focus-visible{outline:3px solid var(--amber);outline-offset:2px;border-radius:6px}
.i{width:17px;height:17px;min-width:17px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}

/* TOP BAR */
.topbar{position:sticky;top:0;z-index:50;height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 max(18px,5%);background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--head);font-size:20px;font-weight:700;letter-spacing:-.3px;text-decoration:none}
.brand-mark{width:32px;height:32px;border-radius:9px;background:var(--ink);color:var(--amber);display:grid;place-items:center;font-size:16px}
.back-btn{display:inline-flex;align-items:center;gap:8px;padding:9px 15px;border-radius:10px;background:var(--ink);color:#fff;font-size:14px;font-weight:600;text-decoration:none}
.back-btn:hover{background:var(--ink-2)}
.back-btn .i{width:15px;height:15px;transform:rotate(180deg)}

.container{flex:1;width:min(900px,92%);margin:0 auto;padding:30px 0 64px}

/* HERO */
.hero{background:var(--ink);color:#fff;border-radius:22px;padding:34px 36px;margin-bottom:20px;position:relative;overflow:hidden}
.hero::after{content:"";position:absolute;right:-80px;top:-80px;width:260px;height:260px;border-radius:50%;border:40px solid rgba(242,169,59,.08);pointer-events:none}
.hero h1{font-family:var(--head);font-size:clamp(28px,4vw,40px);line-height:1.1;letter-spacing:-.8px;margin-bottom:10px}
.hero p{color:#b6c3d2;max-width:56ch}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
.chip{padding:7px 13px;border-radius:999px;background:rgba(255,255,255,.1);color:#dbe4ee;font-size:13px;font-weight:500}
.chip:empty{display:none}

/* TOOLBAR */
.toolbar{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:18px;display:grid;gap:12px}
.search{position:relative}
.search .i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--mute)}
.search input{width:100%;padding:12px 14px 12px 42px;border:1px solid var(--line);border-radius:11px;background:var(--paper);font:500 15px var(--body);color:var(--ink)}
.search input:focus{outline:none;border-color:var(--brand);background:#fff;box-shadow:0 0 0 3px var(--brand-soft)}
.filters{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}
.filters::-webkit-scrollbar{display:none}
.filter{flex-shrink:0;padding:7px 14px;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--mute);font:600 13px var(--body);cursor:pointer;transition:all .2s}
.filter:hover{border-color:var(--ink);color:var(--ink)}
.filter[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:#fff}
.filter small{font-weight:700;margin-left:5px;opacity:.7}

/* LIST */
.assignment-list{display:grid;gap:14px}
.assignment{position:relative;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px 24px 20px 28px;overflow:hidden;transition:border-color .2s}
.assignment::before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--bar,var(--brand))}
.assignment:hover{border-color:#c4cfdb}
.assignment.s-overdue{--bar:var(--red)}
.assignment.s-soon{--bar:var(--amber)}
.assignment.s-none{--bar:#b6c2d0}
.assignment-top{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:10px}
.assignment-title{font-family:var(--head);font-size:21px;line-height:1.28;letter-spacing:-.3px}
.points{flex-shrink:0;text-align:center;min-width:64px;padding:8px 12px;border-radius:12px;background:var(--brand-soft);color:var(--brand);line-height:1.1}
.points b{display:block;font-family:var(--head);font-size:22px}
.points span{font-size:12px;font-weight:600}
.instructions{color:#3b4a5d;white-space:pre-wrap;word-break:break-word;max-width:70ch;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
.assignment.open .instructions{display:block;-webkit-line-clamp:unset}
.more{margin-top:6px;padding:0;border:0;background:none;color:var(--brand);font:700 13.5px var(--body);cursor:pointer}
.details{display:flex;flex-wrap:wrap;gap:8px;border-top:1px solid #edf1f5;margin-top:16px;padding-top:14px}
.detail{display:inline-flex;align-items:center;gap:7px;padding:7px 12px;border-radius:9px;background:var(--paper);color:#3b4a5d;font-size:13px;font-weight:500}
.detail.due-overdue{background:#fde4e1;color:#a8281b;font-weight:700}
.detail.due-soon{background:#fdf0d6;color:#8a5a06;font-weight:700}
.detail.due-upcoming{background:var(--brand-soft);color:var(--brand);font-weight:700}
.cap{text-transform:capitalize}
.created{margin-top:12px;color:var(--mute);font-size:12.5px}

/* STATES */
.empty,.error{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:48px 24px;text-align:center;color:var(--mute)}
.empty h3,.error h3{font-family:var(--head);font-size:19px;color:var(--ink);margin-bottom:6px}
.state-icon{width:54px;height:54px;border-radius:16px;margin:0 auto 14px;display:grid;place-items:center;background:var(--brand-soft);color:var(--brand)}
.state-icon .i{width:26px;height:26px}
.error{border-color:#fecaca}
.error .state-icon{background:#fee2e2;color:#b91c1c}
.retry{margin-top:16px;padding:11px 20px;border:0;border-radius:10px;background:var(--ink);color:#fff;font:600 14px var(--body);cursor:pointer}
@keyframes sh{to{background-position:-200% 0}}
.sk{height:150px;border-radius:16px;background:linear-gradient(90deg,#e6ebf1 25%,#f4f7fa 50%,#e6ebf1 75%) 0 0/200% 100%;animation:sh 1.4s linear infinite}

.footer{padding:26px;background:#fff;border-top:1px solid var(--line);text-align:center;color:var(--mute);font-size:14px}

@media(max-width:600px){
  .container{padding:18px 0 44px}
  .hero{padding:26px 22px}
  .assignment{padding:18px 18px 16px 22px}
  .assignment-title{font-size:19px}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>

