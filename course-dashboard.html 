/* =====================================================
   PRICE FORMAT
===================================================== */

function formatPrice() {

  if (
    course.isFree === true ||
    Number(course.price || 0) === 0
  ) {

    return "FREE";

  }


  if (
    course.price == null
  ) {

    return "-";

  }


  return `${
    course.currency ||
    "TZS"
  } ${
    Number(
      course.price
    ).toLocaleString()
  }`;

}


/* =====================================================
   DASHBOARD STATISTICS
===================================================== */

function renderStats() {

  const progress =
    getProgress();


  text(
    "totalLessons",
    lessons.length
  );


  text(
    "completedLessons",
    completedLessons.size
  );


  text(
    "completionPercent",
    progress + "%"
  );


  text(
    "quizCount",
    quizzes.length
  );


  text(
    "assignmentCount",
    assignments.length
  );


  text(
    "ratingNumber",
    getRating().toFixed(1)
  );

}


/* =====================================================
   COURSE PROGRESS
===================================================== */

function getProgress() {

  if (
    lessons.length === 0
  ) {

    return 0;

  }


  const completed =
    Math.min(
      completedLessons.size,
      lessons.length
    );


  return Math.round(
    (
      completed /
      lessons.length
    ) * 100
  );

}


/* =====================================================
   RENDER PROGRESS
===================================================== */

function renderProgress() {

  const progress =
    getProgress();


  text(
    "heroProgress",
    progress + "%"
  );


  text(
    "circleText",
    progress + "%"
  );


  text(
    "completedText",
    completedLessons.size
  );


  text(
    "totalText",
    lessons.length
  );


  const heroFill =
    document.getElementById(
      "heroProgressFill"
    );


  if (
    heroFill
  ) {

    heroFill.style.width =
      progress + "%";

  }


  const circle =
    document.getElementById(
      "circleProgress"
    );


  if (
    circle
  ) {

    const degrees =
      progress * 3.6;


    circle.style.background =
      `conic-gradient(
        var(--primary)
        ${degrees}deg,
        #e5e7eb
        ${degrees}deg
      )`;

  }


  const message =
    document.getElementById(
      "completionMessage"
    );


  if (
    message
  ) {

    if (
      progress >= 100
    ) {

      message.textContent =
        "🎉 Course Completed!";

    }

    else if (
      progress > 0
    ) {

      message.textContent =
        "Keep going! You're making great progress.";

    }

    else {

      message.textContent =
        "Start your learning journey.";

    }

  }

}


/* =====================================================
   RENDER COURSE MODULES
===================================================== */

function renderModules() {

  const container =
    document.getElementById(
      "modulesContainer"
    );


  if (
    !container
  ) {

    return;

  }


  container.innerHTML = "";


  if (
    modules.length === 0
  ) {

    const module =
      document.createElement(
        "div"
      );


    module.className =
      "module";


    module.innerHTML = `

      <div class="module-header">

        <div>

          <div class="module-title">
            Course Lessons
          </div>

          <div class="module-meta">
            ${lessons.length} lessons
          </div>

        </div>

      </div>

      <div class="lesson-list">

        ${
          lessons.length > 0

            ?

            lessons
              .map(
                (
                  lesson,
                  index
                ) =>
                  lessonHTML(
                    lesson,
                    index
                  )
              )
              .join("")

            :

            `
              <div class="lesson">

                <div class="lesson-info">

                  <div class="lesson-title">
                    No lessons available
                  </div>

                  <div class="lesson-meta">
                    Course lessons will appear here.
                  </div>

                </div>

              </div>
            `
        }

      </div>

    `;


    container.appendChild(
      module
    );


    return;

  }


  modules
    .sort(
      (a, b) =>
        Number(
          a.order || 0
        ) -
        Number(
          b.order || 0
        )
    )
    .forEach(
      (
        module,
        moduleIndex
      ) => {

        const moduleLessons =
          lessons.filter(
            lesson =>

              lesson.moduleId ===
                module.id

              ||

              lesson.module ===
                module.id

              ||

              lesson.moduleTitle ===
                module.title
          );


        const completed =
          moduleLessons.filter(
            lesson =>
              completedLessons.has(
                lesson.id
              )
          ).length;


        const moduleProgress =
          moduleLessons.length > 0

            ?

            Math.round(
              (
                completed /
                moduleLessons.length
              ) * 100
            )

            :

            0;


        const element =
          document.createElement(
            "div"
          );


        element.className =
          "module";


        element.innerHTML = `

          <div class="module-header">

            <div>

              <div class="module-title">

                ${escapeHtml(
                  module.title ||
                  `Module ${moduleIndex + 1}`
                )}

              </div>

              <div class="module-meta">

                ${moduleLessons.length}
                lessons

              </div>

            </div>

            <div class="module-progress">

              ${moduleProgress}%

            </div>

          </div>

          <div class="lesson-list">

            ${
              moduleLessons.length > 0

                ?

                moduleLessons
                  .map(
                    (
                      lesson,
                      index
                    ) =>
                      lessonHTML(
                        lesson,
                        index
                      )
                  )
                  .join("")

                :

                `
                  <div class="lesson">

                    <div class="lesson-info">

                      <div class="lesson-title">
                        No lessons in this module
                      </div>

                    </div>

                  </div>
                `
            }

          </div>

        `;


        container.appendChild(
          element
        );

      }
    );

}


/* =====================================================
   LESSON HTML
===================================================== */

function lessonHTML(
  lesson,
  index
) {

  const completed =
    completedLessons.has(
      lesson.id
    );


  const lessonUrl =
    `course-lesson.html?courseId=${
      encodeURIComponent(
        courseId
      )
    }&lessonId=${
      encodeURIComponent(
        lesson.id
      )
    }`;


  return `

    <div
      class="lesson ${
        completed
          ? "completed"
          : ""
      }"
    >

      <div class="lesson-status">

        ${
          completed
            ? "✓"
            : index + 1
        }

      </div>


      <div class="lesson-info">

        <div class="lesson-title">

          ${escapeHtml(
            lesson.title ||
            `Lesson ${index + 1}`
          )}

        </div>


        <div class="lesson-meta">

          ${
            lesson.type ||
            "Lesson"
          }

          •

          ${
            lesson.duration ||
            "Self-paced"
          }

          ${
            completed
              ? " • Completed"
              : ""
          }

        </div>

      </div>


      <a
        href="${lessonUrl}"
        class="lesson-btn"
      >

        ${
          completed
            ? "Review"
            : "Start"
        }

      </a>

    </div>

  `;

}


/* =====================================================
   RESOURCES
===================================================== */

function renderResources() {

  const container =
    document.getElementById(
      "resourcesContainer"
    );


  if (
    !container
  ) {

    return;

  }


  container.innerHTML = "";


  if (
    resources.length === 0
  ) {

    container.innerHTML = `

      <div class="resource">

        <div class="resource-icon">
          📁
        </div>

        <div class="resource-info">

          <div class="resource-title">
            No resources available
          </div>

          <div class="resource-meta">
            Course materials will appear here.
          </div>

        </div>

      </div>

    `;


    return;

  }


  resources
    .slice(0, 6)
    .forEach(
      resource => {

        const item =
          document.createElement(
            "div"
          );


        item.className =
          "resource";


        const resourceUrl =
          resource.url ||
          resource.fileUrl ||
          "#";


        item.innerHTML = `

          <div class="resource-icon">
            📄
          </div>

          <div class="resource-info">

            <div class="resource-title">

              ${escapeHtml(
                resource.title ||
                "Course Resource"
              )}

            </div>

            <div class="resource-meta">

              ${
                resource.type ||
                "Study Material"
              }

            </div>

          </div>

          <a
            href="${escapeAttribute(
              resourceUrl
            )}"
            target="_blank"
            rel="noopener"
            class="resource-link"
          >
            Open
          </a>

        `;


        container.appendChild(
          item
        );

      }
    );

}


/* =====================================================
   COURSE RATING
===================================================== */

function getRating() {

  if (
    reviews.length === 0
  ) {

    return Number(
      course.rating || 0
    );

  }


  const total =
    reviews.reduce(
      (
        sum,
        review
      ) => {

        return (
          sum +
          Number(
            review.rating || 0
          )
        );

      },
      0
    );


  return total /
    reviews.length;

}


/* =====================================================
   RENDER REVIEWS
===================================================== */

function renderReviews() {

  const rating =
    getRating();


  text(
    "courseRating",
    rating.toFixed(1)
  );


  text(
    "ratingNumber",
    rating.toFixed(1)
  );


  text(
    "courseStars",
    getStars(
      rating
    )
  );


  text(
    "reviewCount",
    reviews.length === 1

      ? "1 review"

      : `${reviews.length} reviews`
  );

}


/* =====================================================
   STARS
===================================================== */

function getStars(
  rating
) {

  let stars = "";


  for (
    let i = 1;
    i <= 5;
    i++
  ) {

    stars +=
      i <= Math.round(
        rating
      )

        ? "★"

        : "☆";

  }


  return stars;

}


/* =====================================================
   ANNOUNCEMENTS
===================================================== */

function renderAnnouncements() {

  const container =
    document.getElementById(
      "announcementsContainer"
    );


  if (
    !container
  ) {

    return;

  }


  container.innerHTML = "";


  if (
    announcements.length === 0
  ) {

    container.innerHTML = `

      <div class="announcement">

        <div class="announcement-title">
          No announcements yet
        </div>

        <div class="announcement-date">
          Check back later.
        </div>

      </div>

    `;


    return;

  }


  announcements
    .slice(0, 5)
    .forEach(
      announcement => {

        const item =
          document.createElement(
            "div"
          );


        item.className =
          "announcement";


        item.innerHTML = `

          <div class="announcement-title">

            ${escapeHtml(
              announcement.title ||
              "Course Announcement"
            )}

          </div>

          <div class="announcement-date">

            ${
              announcement.date ||
              "Course announcement"
            }

          </div>

        `;


        container.appendChild(
          item
        );

      }
    );

}


/* =====================================================
   CERTIFICATE
===================================================== */

function renderCertificate() {

  const progress =
    getProgress();


  const completed =
    progress >= 100;


  const certificateLink =
    document.getElementById(
      "certificateLink"
    );


  if (
    completed
  ) {

    text(
      "certificateTitle",
      "🎉 Certificate Available"
    );


    text(
      "certificateMessage",
      "Congratulations! You have completed this course."
    );


    if (
      certificateLink
    ) {

      certificateLink.href =
        `course-certificate.html?id=${
          encodeURIComponent(
            courseId
          )
        }`;

    }

  }

  else {

    text(
      "certificateTitle",
      "Certificate Locked"
    );


    text(
      "certificateMessage",
      "Complete the course requirements to unlock your certificate."
    );


    if (
      certificateLink
    ) {

      certificateLink.href =
        `course-certificate.html?id=${
          encodeURIComponent(
            courseId
          )
        }`;

    }

  }


  setCheck(
    "checkLessons",
    progress >= 100
  );


  setCheck(
    "checkQuiz",
    quizzes.length === 0 ||
    course.quizCompleted === true
  );


  setCheck(
    "checkAssignments",
    assignments.length === 0 ||
    course.assignmentsCompleted === true
  );


  setCheck(
    "checkReview",
    course.reviewCompleted === true
  );


  setCheck(
    "checkCertificate",
    completed
  );

}


/* =====================================================
   CHECKLIST
===================================================== */

function setCheck(
  id,
  completed
) {

  const element =
    document.getElementById(
      id
    );


  if (
    !element
  ) {

    return;

  }


  element.classList.toggle(
    "done",
    Boolean(
      completed
    )
  );


  element.textContent =
    completed
      ? "✓"
      : "○";

}


/* =====================================================
   COURSE LINKS
===================================================== */

function renderLinks() {

  const id =
    encodeURIComponent(
      courseId
    );


  const links = {

    overviewLink:
      `course.html?id=${id}`,

    lessonsLink:
      `course-lessons.html?id=${id}`,

    allLessonsLink:
      `course-lessons.html?id=${id}`,

    resourcesLink:
      `course-resources.html?id=${id}`,

    allResourcesLink:
      `course-resources.html?id=${id}`,

    quizLink:
      `course-quiz.html?id=${id}`,

    assignmentLink:
      `course-assignments.html?id=${id}`,

    discussionLink:
      `course-discussion.html?id=${id}`,

    notesLink:
      `course-notes.html?id=${id}`,

    bookmarkLink:
      `course-bookmarks.html?id=${id}`,

    progressLink:
      `course-progress.html?id=${id}`,

    reviewsLink:
      `course-reviews.html?id=${id}`,

    announcementsLink:
      `course-announcements.html?id=${id}`,

    discussionSupportLink:
      `course-discussion.html?id=${id}`,

    supportLink:
      `course-support.html?id=${id}`,

    reportLink:
      `course-support.html?id=${id}&type=report`

  };


  Object.entries(
    links
  ).forEach(
    (
      [key, url]
    ) => {

      const element =
        document.getElementById(
          key
        );


      if (
        element
      ) {

        element.href =
          url;

      }

    }
  );


  const continueButton =
    document.getElementById(
      "continueButton"
    );


  if (
    continueButton
  ) {

    continueButton.onclick =
      () => {

        const nextLesson =
          lessons.find(
            lesson =>
              !completedLessons.has(
                lesson.id
              )
          );


        if (
          !nextLesson
        ) {

          window.location.href =
            `course-lessons.html?id=${id}`;

          return;

        }


        window.location.href =
          `course-lesson.html?courseId=${id}&lessonId=${
            encodeURIComponent(
              nextLesson.id
            )
          }`;

      };

  }

}


/* =====================================================
   REVIEW SUBMISSION
===================================================== */

const reviewForm =
  document.getElementById(
    "reviewForm"
  );


if (
  reviewForm
) {

  reviewForm.addEventListener(
    "submit",
    async event => {

      event.preventDefault();


      const rating =
        Number(
          document
            .getElementById(
              "reviewRating"
            )
            ?.value || 0
        );


      const reviewText =
        document
          .getElementById(
            "reviewText"
          )
          ?.value
          ?.trim();


      if (
        rating < 1 ||
        rating > 5 ||
        !reviewText
      ) {

        alert(
          "Please enter a rating and review."
        );

        return;

      }


      try {

        await addDoc(

          collection(
            db,
            "courses",
            courseId,
            "reviews"
          ),

          {

            rating,

            text:
              reviewText,

            userId:
              "guest",

            userName:
              "Learner",

            createdAt:
              serverTimestamp()

          }

        );


        alert(
          "Review submitted successfully."
        );


        reviewForm.reset();


        reviews =
          await loadSubcollection(
            "reviews"
          );


        renderReviews();

      }

      catch (
        error
      ) {

        console.error(
          "Review error:",
          error
        );


        alert(
          "Unable to submit review."
        );

      }

    }
  );

}


/* =====================================================
   COMPLETE LESSON
===================================================== */

window.completeLesson =
  async function(
    lessonId
  ) {

    if (
      !lessonId
    ) {

      return;

    }


    completedLessons.add(
      lessonId
    );


    renderStats();

    renderProgress();

    renderModules();

    renderCertificate();

  };


/* =====================================================
   TEXT HELPER
===================================================== */

function text(
  id,
  value
) {

  const element =
    document.getElementById(
      id
    );


  if (
  element
) {

  element.textContent =
    value ?? "";

}

}


/* =====================================================
   HTML ESCAPE
===================================================== */

function escapeHtml(
  value
) {

  return String(
    value ?? ""
  )

    .replace(
      /&/g,
      "&amp;"
    )

    .replace(
      /</g,
      "&lt;"
    )

    .replace(
      />/g,
      "&gt;"
    )

    .replace(
      /"/g,
      "&quot;"
    )

    .replace(
      /'/g,
      "&#039;"
    );

}


/* =====================================================
   ATTRIBUTE ESCAPE
===================================================== */

function escapeAttribute(
  value
) {

  return escapeHtml(
    value
  );

}


/* =====================================================
   ERROR HANDLER
===================================================== */

function showError(
  message
) {

  const loading =
    document.getElementById(
      "loading"
    );


  if (
    loading
  ) {

    loading.innerHTML = `

      <div
        style="
          max-width:520px;
          margin:40px auto;
          padding:30px;
          text-align:center;
        "
      >

        <div
          style="
            font-size:52px;
            margin-bottom:15px;
          "
        >
          ⚠️
        </div>


        <h2>
          Course Dashboard
        </h2>


        <p
          style="
            color:#6b7280;
            margin:12px 0 22px;
            line-height:1.6;
          "
        >
          ${escapeHtml(
            message
          )}
        </p>


        <a
          href="courses.html"
          class="primary-btn"
        >
          ← Back to Courses
        </a>

      </div>

    `;

  }

}


/* =====================================================
   INITIALIZE COURSE DASHBOARD
===================================================== */

if (
  courseId
) {

  loadDashboard();

}


/* =====================================================
   MISSING COURSE ID
===================================================== */

else {

  showError(
    "No course ID was provided."
  );

}


