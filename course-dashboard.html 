    doc,
    getDoc,
    collection,
    getDocs,
    addDoc,
    serverTimestamp
  } from
  "https://www.gstatic.com/firebasejs/11.0.2/firebase-firestore.js";


  /* =====================================================
     FIREBASE CONFIG
  ===================================================== */

  // For Firebase JS SDK v7.20.0 and later, measurementId is optional
const firebaseConfig = {
  apiKey: "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",
  authDomain: "let-s-study-pro-course.firebaseapp.com",
  databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
  projectId: "let-s-study-pro-course",
  storageBucket: "let-s-study-pro-course.firebasestorage.app",
  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
};


  const app =
    initializeApp(
      firebaseConfig
    );


  const db =
    getFirestore(
      app
    );


  /* =====================================================
     COURSE ID
  ===================================================== */

  const params =
    new URLSearchParams(
      window.location.search
    );


  const coursesId =
    params.get("id");


  if (!coursesId) {

    showError(
      "Course ID is missing from the URL."
    );

  }


  /* =====================================================
     DATA
  ===================================================== */

  let course = {};

  let lessons = [];

  let modules = [];

  let resources = [];

  let quizzes = [];

  let assignments = [];

  let reviews = [];

  let announcements = [];

  let completedLessons =
    new Set();


  /* =====================================================
     LOAD COURSE
  ===================================================== */

  async function loadCourse() {

    const courseRef =
      doc(
        db,
        "courses",
        coursesId
      );


    const snapshot =
      await getDoc(
        courseRef
      );


    if (
      !snapshot.exists()
    ) {

      throw new Error(
        "Course not found."
      );

    }


    course = {

      id:
        snapshot.id,

      ...snapshot.data()

    };


    if (
      Array.isArray(
        course.completedLessons
      )
    ) {

      completedLessons =
        new Set(
          course.completedLessons
        );

    }

  }


  /* =====================================================
     LOAD SUB COLLECTION
  ===================================================== */

  async function loadSubcollection(
    name
  ) {

    const reference =
      collection(
        db,
        "courses",
        coursesId,
        name
      );


    const snapshot =
      await getDocs(
        reference
      );


    return snapshot.docs.map(
      item => ({

        id:
          item.id,

        ...item.data()

      })
    );

  }


  /* =====================================================
     LOAD EVERYTHING
  ===================================================== */

  async function loadDashboard() {

    try {

      await loadCourse();


      [
        lessons,
        modules,
        resources,
        quizzes,
        assignments,
        reviews,
        announcements
      ] = await Promise.all([

        loadSubcollection(
          "lessons"
        ),

        loadSubcollection(
          "modules"
        ),

        loadSubcollection(
          "resources"
        ),

        loadSubcollection(
          "quizzes"
        ),

        loadSubcollection(
          "assignments"
        ),

        loadSubcollection(
          "reviews"
        ),

        loadSubcollection(
          "announcements"
        )

      ]);


      renderDashboard();

    }

    catch(error) {

      console.error(
        error
      );

      showError(
        "Unable to load course dashboard."
      );

    }

  }


  /* =====================================================
     RENDER
  ===================================================== */

  function renderDashboard() {

    renderCourseInfo();

    renderStats();

    renderProgress();

    renderModules();

    renderResources();

    renderReviews();

    renderAnnouncements();

    renderCertificate();

    renderLinks();

    document
      .getElementById(
        "loading"
      )
      .style.display =
      "none";


    document
      .getElementById(
        "dashboard"
      )
      .style.display =
      "block";

  }


  /* =====================================================
     COURSE INFO
  ===================================================== */

  function renderCourseInfo() {

    const title =
