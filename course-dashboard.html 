<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="LetsStudy Pro Course Dashboard - Learn, track progress, complete lessons, quizzes, assignments and earn certificates."
  >

  <title>Course Dashboard | LetsStudy Pro</title>

  <style>

    /* =====================================================
       RESET
    ===================================================== */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --secondary: #7c3aed;

      --success: #16a34a;
      --warning: #f59e0b;
      --danger: #dc2626;

      --dark: #111827;
      --text: #1f2937;
      --muted: #6b7280;

      --bg: #f5f7fb;
      --card: #ffffff;
      --border: #e5e7eb;

      --radius: 14px;
    }

    body {
      font-family:
        Inter,
        Arial,
        Helvetica,
        sans-serif;

      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }


    /* =====================================================
       HEADER
    ===================================================== */

    .topbar {
      height: 70px;

      background: #fff;

      border-bottom:
        1px solid var(--border);

      position: sticky;
      top: 0;

      z-index: 1000;
    }

    .topbar-inner {
      max-width: 1400px;

      height: 100%;

      margin: auto;

      padding: 0 20px;

      display: flex;

      align-items: center;

      justify-content: space-between;
    }

    .brand {
      display: flex;

      align-items: center;

      gap: 10px;

      font-size: 21px;

      font-weight: 800;

      color: var(--primary);
    }

    .brand span {
      color: var(--dark);
    }

    .top-actions {
      display: flex;

      align-items: center;

      gap: 12px;
    }

    .top-link {
      padding: 8px 12px;

      color: var(--muted);

      font-size: 14px;

      font-weight: 600;
    }

    .top-link:hover {
      color: var(--primary);
    }

    .profile {
      width: 38px;
      height: 38px;

      border-radius: 50%;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          var(--secondary)
        );

      color: #fff;

      display: flex;

      align-items: center;

      justify-content: center;

      font-weight: 800;
    }


    /* =====================================================
       LOADING
    ===================================================== */

    #loading {
      min-height: 70vh;

      display: flex;

      flex-direction: column;

      align-items: center;

      justify-content: center;

      text-align: center;
    }

    .loader {
      width: 45px;
      height: 45px;

      border:
        4px solid #e5e7eb;

      border-top-color:
        var(--primary);

      border-radius: 50%;

      animation:
        spin 1s linear infinite;

      margin-bottom: 15px;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }


    /* =====================================================
       HERO
    ===================================================== */

    .hero {
      background:
        linear-gradient(
          135deg,
          #172554,
          #2563eb 60%,
          #4f46e5
        );

      color: #fff;

      padding: 42px 20px;
    }

    .hero-inner {
      max-width: 1400px;

      margin: auto;

      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        360px;

      gap: 35px;

      align-items: center;
    }

    .breadcrumb {
      display: flex;

      gap: 8px;

      color: #dbeafe;

      font-size: 13px;

      margin-bottom: 14px;
    }

    .category {
      display: inline-flex;

      padding: 6px 12px;

      background:
        rgba(255,255,255,.13);

      border:
        1px solid
        rgba(255,255,255,.2);

      border-radius: 20px;

      font-size: 12px;

      font-weight: 700;

      margin-bottom: 13px;
    }

    .hero h1 {
      font-size: 38px;

      line-height: 1.2;

      margin-bottom: 12px;
    }

    .hero-description {
      color: #dbeafe;

      max-width: 760px;

      margin-bottom: 20px;
    }

    .course-meta {
      display: flex;

      flex-wrap: wrap;

      gap: 15px;

      color: #e0e7ff;

      font-size: 13px;
    }

    .hero-progress {
      background:
        rgba(255,255,255,.1);

      border:
        1px solid
        rgba(255,255,255,.2);

      border-radius: var(--radius);

      padding: 25px;
    }

    .hero-progress-number {
      font-size: 42px;

      font-weight: 800;
    }

    .hero-progress-label {
      color: #dbeafe;

      font-size: 13px;

      margin-bottom: 15px;
    }

    .progress-track {
      height: 9px;

      background:
        rgba(255,255,255,.2);

      border-radius: 20px;

      overflow: hidden;
    }

    .progress-fill {
      height: 100%;

      width: 0%;

      background: #fff;

      border-radius: 20px;

      transition:
        width .5s ease;
    }

    .continue-btn {
      width: 100%;

      margin-top: 18px;

      padding: 12px;

      border: 0;

      border-radius: 9px;

      background: #fff;

      color: var(--primary);

      font-weight: 800;
    }

    .continue-btn:hover {
      background: #eff6ff;
    }


    /* =====================================================
       MAIN
    ===================================================== */

    .container {
      max-width: 1400px;

      margin: auto;

      padding: 32px 20px;
    }


    /* =====================================================
       STATS
    ===================================================== */

    .stats {
      display: grid;

      grid-template-columns:
        repeat(6, 1fr);

      gap: 15px;

      margin-bottom: 25px;
    }

    .stat {
      background: var(--card);

      border:
        1px solid var(--border);

      border-radius: var(--radius);

      padding: 18px;
    }

    .stat-icon {
      font-size: 21px;

      margin-bottom: 7px;
    }

    .stat-number {
      font-size: 24px;

      font-weight: 800;
    }

    .stat-label {
      color: var(--muted);

      font-size: 12px;
    }


    /* =====================================================
       LAYOUT
    ===================================================== */

    .dashboard-layout {
      display: grid;

      grid-template-columns:
        minmax(0, 1.7fr)
        370px;

      gap: 25px;

      align-items: start;
    }

    .panel {
      background: var(--card);

      border:
        1px solid var(--border);

      border-radius: var(--radius);

      padding: 23px;

      margin-bottom: 22px;
    }

    .panel-header {
      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      margin-bottom: 20px;
    }

    .panel-header h2 {
      font-size: 19px;
    }

    .panel-link {
      color: var(--primary);

      font-size: 13px;

      font-weight: 700;
    }


    /* =====================================================
       QUICK ACTIONS
    ===================================================== */

    .quick-actions {
      display: grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap: 12px;
    }

    .action-card {
      border:
        1px solid var(--border);

      border-radius: 10px;

      padding: 15px;

      transition:
        .2s ease;
    }

    .action-card:hover {
      border-color: var(--primary);

      transform:
        translateY(-2px);
    }

    .action-icon {
      font-size: 22px;

      margin-bottom: 8px;
    }

    .action-title {
      font-size: 13px;

      font-weight: 800;
    }

    .action-text {
      color: var(--muted);

      font-size: 11px;
    }


    /* =====================================================
       COMPLETION
    ===================================================== */

    .completion {
      display: flex;

      align-items: center;

      gap: 25px;
    }

    .circle-progress {
      width: 135px;
      height: 135px;

      border-radius: 50%;

      background:
        conic-gradient(
          var(--primary) 0deg,
          #e5e7eb 0deg
        );

      display: flex;

      align-items: center;

      justify-content: center;

      flex-shrink: 0;
    }

    .circle-inner {
      width: 103px;
      height: 103px;

      border-radius: 50%;

      background: #fff;

      display: flex;

      align-items: center;

      justify-content: center;

      font-size: 25px;

      font-weight: 800;
    }

    .completion-info h3 {
      margin-bottom: 5px;
    }

    .completion-info p {
      color: var(--muted);

      font-size: 14px;
    }


    /* =====================================================
       MODULES
    ===================================================== */

    .module {
      border:
        1px solid var(--border);

      border-radius: 11px;

      overflow: hidden;

      margin-bottom: 12px;
    }

    .module-header {
      padding: 15px;

      background: #f9fafb;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 10px;
    }

    .module-title {
      font-weight: 800;

      font-size: 14px;
    }

    .module-meta {
      color: var(--muted);

      font-size: 11px;
    }

    .module-progress {
      color: var(--primary);

      font-size: 12px;

      font-weight: 700;
    }


    /* =====================================================
       LESSONS
    ===================================================== */

    .lesson-list {
      padding: 8px;
    }

    .lesson {
      display: flex;

      align-items: center;

      gap: 12px;

      padding: 12px;

      border-radius: 9px;
    }

    .lesson:hover {
      background: #f9fafb;
    }

    .lesson-status {
      width: 31px;
      height: 31px;

      border-radius: 50%;

      background: #f3f4f6;

      display: flex;

      align-items: center;

      justify-content: center;

      flex-shrink: 0;

      font-size: 12px;

      font-weight: 800;
    }

    .lesson.completed
    .lesson-status {
      background: var(--success);

      color: #fff;
    }

    .lesson-info {
      flex: 1;
    }

    .lesson-title {
      font-size: 13px;

      font-weight: 700;
    }

    .lesson-meta {
      color: var(--muted);

      font-size: 11px;
    }

    .lesson-btn {
      color: var(--primary);

      font-size: 12px;

      font-weight: 800;
    }


    /* =====================================================
       CHECKLIST
    ===================================================== */

    .check-list {
      display: grid;

      gap: 10px;
    }

    .check-item {
      display: flex;

      align-items: center;

      gap: 10px;

      padding: 11px;

      background: #f9fafb;

      border-radius: 8px;

      font-size: 13px;
    }

    .check-icon {
      width: 23px;
      height: 23px;

      border-radius: 50%;

      background: #e5e7eb;

      color: var(--muted);

      display: flex;

      align-items: center;

      justify-content: center;

      font-size: 11px;
    }

    .check-icon.done {
      background: var(--success);

      color: #fff;
    }


    /* =====================================================
       RESOURCE LIST
    ===================================================== */

    .resource {
      display: flex;

      align-items: center;

      gap: 12px;

      padding: 12px;

      border:
        1px solid var(--border);

      border-radius: 9px;

      margin-bottom: 9px;
    }

    .resource-icon {
      font-size: 22px;
    }

    .resource-info {
      flex: 1;
    }

    .resource-title {
      font-size: 13px;

      font-weight: 700;
    }

    .resource-meta {
      color: var(--muted);

      font-size: 11px;
    }

    .resource-link {
      color: var(--primary);

      font-size: 12px;

      font-weight: 700;
    }


    /* =====================================================
       RATING
    ===================================================== */

    .rating-summary {
      display: flex;

      align-items: center;

      gap: 18px;

      margin-bottom: 20px;
    }

    .rating-number {
      font-size: 42px;

      font-weight: 800;
    }

    .stars {
      color: var(--warning);

      font-size: 20px;

      letter-spacing: 2px;
    }

    .rating-count {
      color: var(--muted);

      font-size: 12px;
    }

    .review-form {
      display: grid;

      gap: 10px;
    }

    .review-form textarea {
      width: 100%;

      min-height: 95px;

      resize: vertical;

      border:
        1px solid var(--border);

      border-radius: 9px;

      padding: 12px;

      outline: none;
    }

    .review-form textarea:focus {
      border-color: var(--primary);
    }

    .review-form select {
      padding: 10px;

      border:
        1px solid var(--border);

      border-radius: 8px;

      outline: none;
    }

    .primary-btn {
      border: 0;

      background: var(--primary);

      color: #fff;

      padding: 11px 17px;

      border-radius: 8px;

      font-weight: 800;
    }

    .primary-btn:hover {
      background:
        var(--primary-dark);
    }


    /* =====================================================
       INSTRUCTOR
    ===================================================== */

    .instructor {
      display: flex;

      align-items: center;

      gap: 13px;
    }

    .avatar {
      width: 52px;
      height: 52px;

      border-radius: 50%;

      background: #dbeafe;

      color: var(--primary);

      display: flex;

      align-items: center;

      justify-content: center;

      font-weight: 800;
    }

    .instructor-name {
      font-weight: 800;
    }

    .instructor-role {
      color: var(--muted);

      font-size: 12px;
    }


    /* =====================================================
       ANNOUNCEMENTS
    ===================================================== */

    .announcement {
      padding: 12px;

      background: #f9fafb;

      border-radius: 9px;

      margin-bottom: 9px;
    }

    .announcement-title {
      font-size: 13px;

      font-weight: 800;
    }

    .announcement-date {
      color: var(--muted);

      font-size: 11px;
    }


    /* =====================================================
       CERTIFICATE
    ===================================================== */

    .certificate {
      text-align: center;

      padding: 15px;
    }

    .certificate-icon {
      font-size: 45px;

      margin-bottom: 10px;
    }

    .certificate p {
      color: var(--muted);

      font-size: 13px;

      margin: 8px 0 15px;
    }


    /* =====================================================
       FOOTER
    ===================================================== */

    footer {
      background: #111827;

      color: #9ca3af;

      text-align: center;

      padding: 30px 20px;

      font-size: 13px;

      margin-top: 20px;
    }


    /* =====================================================
       MOBILE
    ===================================================== */

    @media (
      max-width: 1150px
    ) {

      .stats {
        grid-template-columns:
          repeat(3, 1fr);
      }

      .dashboard-layout {
        grid-template-columns:
          1fr;
      }

    }


    @media (
      max-width: 800px
    ) {

      .hero-inner {
        grid-template-columns:
          1fr;
      }

      .quick-actions {
        grid-template-columns:
          repeat(2, 1fr);
      }

    }


    @media (
      max-width: 600px
    ) {

      .stats {
        grid-template-columns:
          repeat(2, 1fr);
      }

      .hero h1 {
        font-size: 28px;
      }

      .completion {
        flex-direction: column;

        align-items:
          flex-start;
      }

      .circle-progress {
        margin: auto;
      }

      .top-link {
        display: none;
      }

    }

  </style>
</head>


