<script type="module">

import {
  initializeApp
}
from "https://www.gstatic.com/firebasejs/10.12.5/firebase-app.js";

import {
  getFirestore,
  doc,
  getDoc
}
from "https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore.js";


/* =====================================================
   FIREBASE
===================================================== */

const firebaseConfig = {

  /*
   * FIXED API KEY
   */
  apiKey:
    "AIzaSyBcOYDfAVKbljsyRgI_0rjodBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-85B7V5H5J0"

};


const app =
  initializeApp(firebaseConfig);

const db =
  getFirestore(app);


/* =====================================================
   HELPERS
===================================================== */

const page =
  document.getElementById("page");


function text(value){

  if(
    value === undefined ||
    value === null
  ){

    return "";

  }

  return String(value).trim();

}


function escapeHtml(value){

  return text(value)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


function first(data,fields){

  for(const field of fields){

    const value =
      text(data?.[field]);

    if(value){

      return value;

    }

  }

  return "";

}


/* =====================================================
   PLAN DETECTION
===================================================== */

function isPlanCourse(data){

  const access =
    first(
      data,
      [
        "access",
        "accessType",
        "membership",
        "plan",
        "pricing"
      ]
    ).toLowerCase();


  if(
    access === "plan" ||
    access === "premium" ||
    access === "paid" ||
    access === "pro"
  ){

    return true;

  }


  if(
    data?.premium === true ||
    data?.isPremium === true ||
    data?.paid === true
  ){

    return true;

  }


  return false;

}


/* =====================================================
   PRICE
===================================================== */

function getPrice(data){

  return first(
    data,
    [
      "price",
      "amount",
      "coursePrice",
      "planPrice"
    ]
  );

}


/* =====================================================
   IMAGE
===================================================== */

function getImage(data){

  return first(
    data,
    [
      "thumbnail",
      "thumbnailUrl",
      "image",
      "imageUrl",
      "cover",
      "coverImage"
    ]
  );

}


/* =====================================================
   COURSE ID
===================================================== */

const params =
  new URLSearchParams(
    window.location.search
  );


const courseId =
  params.get("id");


/* =====================================================
   LOAD COURSE
===================================================== */

async function loadCourse(){

  if(!courseId){

    showError(
      "Course not found",
      "No course was selected."
    );

    return;

  }


  try{

    const ref =
      doc(
        db,
        "courses",
        courseId
      );


    const snapshot =
      await getDoc(ref);


    if(!snapshot.exists()){

      showError(
        "Course not found",
        "This course is unavailable."
      );

      return;

    }


    const course =
      snapshot.data() || {};


    renderCourse(course);


  }catch(error){

    console.error(
      "Course loading error:",
      error
    );


    showError(
      "Unable to load course",
      "Please try again later."
    );

  }

}


/* =====================================================
   RENDER COURSE
===================================================== */

function renderCourse(course){

  const title =
    first(
      course,
      [
        "title",
        "name",
        "courseTitle"
      ]
    ) ||
    "Untitled Course";


  const description =
    first(
      course,
      [
        "description",
        "shortDescription",
        "summary",
        "excerpt",
        "about"
      ]
    );


  const instructor =
    first(
      course,
      [
        "instructor",
        "instructorName",
        "teacher",
        "author"
      ]
    );


  const category =
    first(
      course,
      [
        "category",
        "subject",
        "field"
      ]
    );


  const image =
    getImage(course);


  const plan =
    isPlanCourse(course);


  const price =
    getPrice(course);


  document.title =
    `${title} | LetsStudy Pro`;


  page.innerHTML = `

    <section class="hero">

      <div class="container">

        <div class="hero-grid">

          <div>

            <div class="category">

              LetsStudy Pro

              ${
                category
                  ? ` · ${escapeHtml(category)}`
                  : ""
              }

            </div>


            <h1>
              ${escapeHtml(title)}
            </h1>


            <div class="badges">

              <span class="badge ${
                plan ? "plan" : "free"
              }">

                ${
                  plan
                    ? "Plan"
                    : "Free"
                }

              </span>


              ${
                course.sponsored
                  ? `
                    <span class="badge sponsored">
                      Sponsored
                    </span>
                  `
                  : ""
              }

            </div>


            ${
              description
                ? `
                  <p class="description">
                    ${escapeHtml(description)}
                  </p>
                `
                : ""
            }

          </div>


          <aside class="course-card">

            ${
              image
                ? `
                  <img
                    class="thumbnail"
                    src="${escapeHtml(image)}"
                    alt="${escapeHtml(title)}"
                  >
                `
                : `
                  <div class="thumbnail"></div>
                `
            }


            <div class="card-body">

              <div class="price ${
                plan
                  ? ""
                  : "free-price"
              }">

                ${
                  plan
                    ? escapeHtml(
                        price || "Plan"
                      )
                    : "Free"
                }

              </div>


              <div id="actionArea">

                ${
                  plan
                    ? `
                      <button
                        class="action"
                        id="cartButton"
                        type="button">

                        Choose Plan

                      </button>
                    `
                    : `
                      <a
                        class="action"
                        href="enroll.html?id=${encodeURIComponent(courseId)}">

                        Enroll Free

                      </a>
                    `
                }

              </div>

            </div>

          </aside>

        </div>

      </div>

    </section>


    <main class="main">

      <div class="container">

        <div class="content-grid">

          <div>

            <section class="section">

              <h2>
                Course Overview
              </h2>


              <p class="description">

                ${escapeHtml(
                  description ||
                  "Explore this course and start learning with LetsStudy Pro."
                )}

              </p>

            </section>


            <section class="section">

              <h2>
                Course Content
              </h2>


              <div id="modules">
                Loading lessons...
              </div>

            </section>

          </div>


          <aside>

            <section class="section">

              <h2>
                Course Information
              </h2>


              <div class="info-list">

                ${
                  instructor
                    ? `
                      <div class="info">

                        <strong>
                          Instructor
                        </strong>

                        <span>
                          ${escapeHtml(instructor)}
                        </span>

                      </div>
                    `
                    : ""
                }


                ${
                  category
                    ? `
                      <div class="info">

                        <strong>
                          Category
                        </strong>

                        <span>
                          ${escapeHtml(category)}
                        </span>

                      </div>
                    `
                    : ""
                }


                <div class="info">

                  <strong>
                    ${plan ? "Plan" : "Free"}
                  </strong>

                  <span>
                    Course access
                  </span>

                </div>

              </div>

            </section>

          </aside>

        </div>

      </div>

    </main>

  `;


  /* ===================================================
     PLAN BUTTON
  =================================================== */

  if(plan){

    const cartButton =
      document.getElementById(
        "cartButton"
      );


    if(cartButton){

      cartButton.addEventListener(
        "click",
        () => addToCart(course)
      );

    }

  }


  /* ===================================================
     MODULES
  =================================================== */

  renderModules(course);

}


/* =====================================================
   ADD PLAN COURSE TO CART
===================================================== */

function addToCart(course){

  let cart = [];


  try{

    cart =
      JSON.parse(
        localStorage.getItem(
          "courseCart"
        ) || "[]"
      );

  }catch(error){

    cart = [];

  }


  if(!Array.isArray(cart)){

    cart = [];

  }


  const existing =
    cart.some(
      item =>
        item.id === courseId
    );


  if(!existing){

    cart.push({

      id:
        courseId,

      courseId:
        courseId,

      title:
        first(
          course,
          [
            "title",
            "name",
            "courseTitle"
          ]
        ),

      price:
        getPrice(course),

      image:
        getImage(course),

      type:
        "plan",

      addedAt:
        Date.now()

    });


    localStorage.setItem(
      "courseCart",
      JSON.stringify(cart)
    );

  }


  /*
   * PLAN COURSE
   * ↓
   * COURSE CART
   */

  window.location.href =
    "course-cart.html?id=" +
    encodeURIComponent(courseId);

}


/* =====================================================
   MODULES / LESSONS
===================================================== */

function renderModules(course){

  const target =
    document.getElementById(
      "modules"
    );


  if(!target){

    return;

  }


  const modules =
    Array.isArray(course.modules)
      ? course.modules
      : [];


  if(!modules.length){

    target.innerHTML = `

      <div class="description">

        Course lessons will appear here.

      </div>

    `;

    return;

  }


  target.innerHTML =
    modules.map(
      (module,index) => {

        const moduleTitle =
          text(
            module?.title ||
            module?.name
          ) ||
          `Module ${index + 1}`;


        const lessons =
          Array.isArray(
            module?.lessons
          )
            ? module.lessons
            : [];


        return `

          <div class="module">

            <div class="module-header">

              ${escapeHtml(
                moduleTitle
              )}

            </div>


            ${
              lessons.length
                ? lessons.map(
                    lesson => `

                      <div class="lesson">

                        ${escapeHtml(
                          text(
                            lesson?.title ||
                            lesson?.name ||
                            lesson
                          )
                        )}

                      </div>

                    `
                  ).join("")
                : `
                    <div class="lesson">

                      Lessons coming soon.

                    </div>
                  `
            }

          </div>

        `;

      }
    ).join("");

}


/* =====================================================
   ERROR
===================================================== */

function showError(
  title,
  message
){

  page.innerHTML = `

    <div class="error">

      <h1>
        ${escapeHtml(title)}
      </h1>


      <p class="description">

        ${escapeHtml(message)}

      </p>


      <br>


      <a
        class="action"
        href="search.html"
        style="display:inline-block;width:auto">

        Back to Search

      </a>

    </div>

  `;

}


