<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Inter,Arial,sans-serif;
  background:#f7f9fc;
  color:#172033;
}

a{
  text-decoration:none;
  color:inherit;
}

.navbar{
  height:64px;
  background:#fff;
  border-bottom:1px solid #e7ebf2;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 6%;
  position:sticky;
  top:0;
  z-index:20;
}

.logo{
  font-size:21px;
  font-weight:800;
}

.back{
  color:#526174;
  font-size:14px;
}

.container{
  width:min(1150px,92%);
  margin:auto;
}

.hero{
  background:#fff;
  padding:45px 0;
  border-bottom:1px solid #e8edf4;
}

.hero-grid{
  display:grid;
  grid-template-columns:1.5fr .8fr;
  gap:40px;
  align-items:start;
}

.category{
  color:#526174;
  font-size:14px;
  margin-bottom:12px;
}

h1{
  font-size:42px;
  line-height:1.12;
  margin:0 0 18px;
  letter-spacing:-1px;
}

.description{
  color:#5b6678;
  line-height:1.7;
  font-size:16px;
  max-width:750px;
}

.badges{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin:20px 0;
}

.badge{
  display:inline-flex;
  padding:7px 12px;
  border-radius:999px;
  font-size:13px;
  font-weight:700;
}

.free{
  background:#e9f8ef;
  color:#167443;
}

.plan{
  background:#eee9ff;
  color:#6040b5;
}

.sponsored{
  background:#fff3d9;
  color:#8a5a00;
}

.course-card{
  background:#fff;
  border:1px solid #e4e9f1;
  border-radius:18px;
  overflow:hidden;
  box-shadow:0 10px 35px rgba(20,35,60,.08);
  position:sticky;
  top:85px;
}

.thumbnail{
  width:100%;
  height:210px;
  object-fit:cover;
  background:#e9eef5;
}

.card-body{
  padding:24px;
}

.price{
  font-size:28px;
  font-weight:800;
  margin-bottom:18px;
}

.price.free-price{
  color:#167443;
}

.action{
  display:block;
  width:100%;
  border:0;
  border-radius:10px;
  padding:14px 18px;
  font-size:15px;
  font-weight:800;
  cursor:pointer;
  text-align:center;
  background:#111827;
  color:white;
}

.action:hover{
  opacity:.9;
}

.main{
  padding:45px 0 80px;
}

.content-grid{
  display:grid;
  grid-template-columns:1fr .35fr;
  gap:35px;
}

.section{
  background:#fff;
  border:1px solid #e5eaf1;
  border-radius:16px;
  padding:28px;
  margin-bottom:25px;
}

.section h2{
  margin-top:0;
  font-size:22px;
}

.info-list{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}

.info{
  padding:18px;
  background:#f7f9fc;
  border-radius:12px;
}

.info strong{
  display:block;
  font-size:18px;
  margin-bottom:5px;
}

.info span{
  color:#697587;
  font-size:13px;
}

.module{
  border:1px solid #e5e9f0;
  border-radius:12px;
  margin-bottom:12px;
  overflow:hidden;
}

.module-header{
  padding:17px;
  background:#fafbfc;
  font-weight:700;
}

.lesson{
  padding:13px 17px;
  border-top:1px solid #edf0f4;
  color:#5b6678;
  font-size:14px;
}

.loading{
  padding:100px 20px;
  text-align:center;
  color:#657184;
}

.error{
  padding:80px 20px;
  text-align:center;
}

.footer{
  padding:35px;
  text-align:center;
  color:#7a8493;
  border-top:1px solid #e5e9f1;
  background:#fff;
}

@media(max-width:800px){

  .hero-grid,
  .content-grid{
    grid-template-columns:1fr;
  }

  h1{
    font-size:32px;
  }

  .course-card{
    position:static;
  }

  .info-list{
    grid-template-columns:1fr;
  }
}
