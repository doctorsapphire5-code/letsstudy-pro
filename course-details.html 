<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getFirestore, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

const app = initializeApp({
  apiKey: "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",
  authDomain: "let-s-study-pro-course.firebaseapp.com",
  databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
  projectId: "let-s-study-pro-course",
  storageBucket: "let-s-study-pro-course.firebasestorage.app",
  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
});
const db = getFirestore(app);

const courseId = new URLSearchParams(location.search).get("id");
const $ = id => document.getElementById(id);
const page = $("page"), errorBox = $("error");
const CACHE_KEY = "lsp:course:" + courseId;

const text = v => (v === undefined || v === null) ? "" : String(v).trim();
function first(data, fields){
  for(const f of fields){ const v = text(data?.[f]); if(v) return v; }
  return "";
}
function isPlan(d){
  const a = first(d,["access","accessType","membership","plan","pricing"]).toLowerCase();
  return ["plan","premium","paid","pro"].includes(a) || d?.premium === true || d?.isPremium === true || d?.paid === true;
}
const getPrice = d => first(d,["price","amount","coursePrice","planPrice"]);
const getImage = d => first(d,["thumbnail","thumbnailUrl","image","imageUrl","cover","coverImage"]);

/* Plan price is always shown in Tanzanian shillings: TZS 50,000 */
function formatTZS(raw){
  const s = text(raw);
  if(!s) return "Plan";
  const n = Number(s.replace(/[^0-9.]/g,""));
  if(/^[^0-9]*[0-9][0-9,.\s]*[^0-9]*$/.test(s) && Number.isFinite(n) && n > 0){
    return "TZS " + n.toLocaleString("en-US", { maximumFractionDigits: 2 });
  }
  return s;
}
function safeUrl(v){
  const s = text(v);
  if(!s) return "";
  try{ return new URL(/^https?:\/\//i.test(s) ? s : "https://" + s).href; }catch(e){ return ""; }
}
function setMeta(sel, attr, val){ const el = document.querySelector(sel); if(el && val) el.setAttribute(attr, val); }
function clip(s, n){ s = text(s).replace(/\s+/g," "); return s.length > n ? s.slice(0, n-1).trimEnd() + "…" : s; }
function el(tag, cls, txt){ const e = document.createElement(tag); if(cls) e.className = cls; if(txt !== undefined) e.textContent = txt; return e; }

function addToCart(course){
  let cart = [];
  try{ cart = JSON.parse(localStorage.getItem("courseCart") || "[]"); }catch(e){ cart = []; }
  if(!Array.isArray(cart)) cart = [];
  if(!cart.some(i => i && i.id === courseId)){
    cart.push({
      id: courseId, courseId,
      title: first(course,["title","name","courseTitle"]),
      price: getPrice(course), currency: "TZS",
      image: getImage(course), type: "plan", addedAt: Date.now()
    });
    try{ localStorage.setItem("courseCart", JSON.stringify(cart)); }catch(e){}
  }
  location.href = "course-cart.html?id=" + encodeURIComponent(courseId);
}

function renderModules(course){
  const target = $("modules");
  target.replaceChildren();
  const modules = Array.isArray(course.modules) ? course.modules : [];
  if(!modules.length){
    target.appendChild(el("p","description","Course lessons will appear here."));
    return;
  }
  modules.forEach((m, i) => {
    const box = el("div","module");
    box.appendChild(el("div","module-header", text(m?.title || m?.name) || "Module " + (i + 1)));
    const lessons = Array.isArray(m?.lessons) ? m.lessons : [];
    if(!lessons.length) box.appendChild(el("div","lesson","Lessons coming soon."));
    lessons.forEach(l => {
      const t = (l && typeof l === "object") ? text(l.title || l.name) : text(l);
      box.appendChild(el("div","lesson", t || "Lesson"));
    });
    target.appendChild(box);
  });
}

function render(course){
  const title = first(course,["title","name","courseTitle"]) || "Untitled course";
  const description = first(course,["description","shortDescription","summary","excerpt","about"]);
  const instructor = first(course,["instructor","instructorName","teacher","author"]);
  const category = first(course,["category","subject","field"]);
  const image = getImage(course);
  const plan = isPlan(course);

  document.title = title + " | LetsStudy Pro";
  $("category").textContent = "LetsStudy Pro" + (category ? " · " + category : "");
  $("title").textContent = title;
  $("description").textContent = description;
  $("description").style.display = description ? "" : "none";
  $("overview").textContent = description || "Explore this course and start learning with LetsStudy Pro.";
  $("sponsoredBadge").style.display = course.sponsored ? "inline-flex" : "none";

  const thumb = $("thumbnail");
  if(image){
    thumb.alt = title;
    thumb.onerror = () => { thumb.style.display = "none"; };
    thumb.src = image;
    thumb.style.display = "block";
  }else{
    thumb.removeAttribute("src");
    thumb.style.display = "none";
  }

  const badge = $("accessBadge"), price = $("price"), btn = $("actionBtn");
  if(plan){
    badge.textContent = "Plan"; badge.className = "badge plan";
    price.textContent = formatTZS(getPrice(course)); price.className = "price";
    btn.textContent = "Choose plan";
    btn.href = "course-cart.html?id=" + encodeURIComponent(courseId);
    btn.onclick = e => { e.preventDefault(); addToCart(course); };
  }else{
    badge.textContent = "Free"; badge.className = "badge free";
    price.textContent = "Free"; price.className = "price free-price";
    btn.textContent = "Enroll free";
    btn.href = "enroll.html?id=" + encodeURIComponent(courseId);
    btn.onclick = null;
  }

  const info = $("infoList");
  info.replaceChildren();
  [["Instructor", instructor], ["Category", category], ["Course access", plan ? "Plan" : "Free"]]
    .filter(r => r[1])
    .forEach(([label, value]) => {
      const row = el("div","info");
      row.appendChild(el("span", "", label));
      row.appendChild(el("strong", "", value));
      info.appendChild(row);
    });

  renderModules(course);

  const desc = clip(description || "Learn " + title + " on LetsStudy Pro.", 155);
  setMeta('meta[name="description"]',"content",desc);
  setMeta('meta[property="og:title"]',"content",document.title);
  setMeta('meta[property="og:description"]',"content",desc);
  if(safeUrl(image)){
    setMeta('meta[property="og:image"]',"content",safeUrl(image));
    setMeta('meta[name="twitter:image"]',"content",safeUrl(image));
  }
  setMeta("#canonicalLink","href",location.origin + location.pathname + "?id=" + encodeURIComponent(courseId));

  errorBox.style.display = "none";
  page.classList.remove("is-loading");
  page.classList.add("ready");
}

function showError(title, message){
  page.style.display = "none";
  errorBox.replaceChildren(el("h1","",title), el("p","",message));
  const a = el("a","","Back to Search"); a.href = "search.html";
  errorBox.appendChild(a);
  errorBox.style.display = "block";
}

function readCache(){
  try{ const c = JSON.parse(localStorage.getItem(CACHE_KEY) || "null"); return c && c.data ? c : null; }catch(e){ return null; }
}
function writeCache(data){
  try{ localStorage.setItem(CACHE_KEY, JSON.stringify({ t: Date.now(), data })); }catch(e){}
}

async function init(){
  if(!courseId){ showError("Course not found","No course was selected."); return; }

  const cached = readCache();
  if(cached) render(cached.data);
  if(cached && Date.now() - cached.t < 60000) return;

  try{
    const snap = await getDoc(doc(db, "courses", courseId));
    if(!snap.exists()){
      try{ localStorage.removeItem(CACHE_KEY); }catch(e){}
      showError("Course not found","This course is unavailable.");
      return;
    }
    const data = JSON.parse(JSON.stringify(snap.data() || {}));
    if(!cached || JSON.stringify(cached.data) !== JSON.stringify(data)) render(data);
    writeCache(data);
  }catch(err){
    console.error("Course loading error:", err);
    if(!cached) showError("Unable to load course","Check your connection and try again.");
  }
}

/* Share: native sheet on phones, copy link elsewhere */
const toast = el("div","toast"); toast.setAttribute("role","status");
document.body.appendChild(toast);
let toastTimer;
function notify(msg){
  toast.textContent = msg; toast.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove("show"), 2200);
}
async function copyLink(url){
  try{ await navigator.clipboard.writeText(url); }
  catch(e){
    const t = document.createElement("textarea");
    t.value = url; t.style.position = "fixed"; t.style.opacity = "0";
    document.body.appendChild(t); t.select();
    try{ document.execCommand("copy"); }catch(_){}
    t.remove();
  }
  notify("Link copied");
}
$("shareBtn").addEventListener("click", async () => {
  const url = location.origin + location.pathname + "?id=" + encodeURIComponent(courseId || "");
  const data = {
    title: ($("title").textContent || "Course") + " | LetsStudy Pro",
    text: clip($("description").textContent || "Learn on LetsStudy Pro", 120),
    url
  };
  if(navigator.share){
    try{ await navigator.share(data); }
    catch(e){ if(e.name !== "AbortError") copyLink(url); }
  }else{
    copyLink(url);
  }
});

init();
