.action:hover{background:#1d4ed8}
.share-btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;margin-top:10px;padding:12px;border-radius:12px;border:1px solid var(--line);background:#fff;color:var(--ink);font:inherit;font-weight:700;font-size:15px;cursor:pointer}
.share-btn:hover{background:var(--tint)}
.share-btn svg{width:18px;height:18px}

.main{padding:36px 0 40px}
.content-grid{display:grid;grid-template-columns:1fr 320px;gap:28px;align-items:start}
.section{background:#fff;border:1px solid var(--line);border-radius:18px;padding:26px;margin-bottom:20px}
.section h2{font-size:20px;color:var(--ink);margin-bottom:14px;letter-spacing:-.2px}
.section .description{color:#43506c;max-width:75ch;overflow-wrap:anywhere;white-space:pre-line}
.info{padding:12px 0;border-bottom:1px solid var(--line)}
.info:last-child{border-bottom:0}
.info span{display:block;color:var(--muted);font-size:13px}
.info strong{color:var(--ink);overflow-wrap:anywhere}
.module{border:1px solid var(--line);border-radius:12px;margin-bottom:12px;overflow:hidden}
.module-header{padding:15px 17px;background:#f8fafd;font-weight:700;color:var(--ink)}
.lesson{padding:12px 17px;border-top:1px solid var(--line);color:var(--muted);font-size:14px}

/* Related, WhatsApp, quick links */
.lsp-rtl-inner{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin:8px 0 20px}
.lsp-rtl-button{display:inline-flex;align-items:center;justify-content:center;min-width:150px;padding:13px 24px;border-radius:999px;font-size:15px;font-weight:800;transition:transform .2s,box-shadow .2s}
.lsp-rtl-button:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(15,27,61,.15)}
.lsp-related-button{background:var(--ink);color:#fff}
.lsp-trending-button{background:#fff;color:var(--ink);border:1px solid var(--line)}
.whatsapp-channel-btn{display:flex;width:fit-content;margin:0 auto 10px;padding:13px 24px;border-radius:999px;background:#25d366;color:#073b1d;font-weight:800}
.lsp-quick-buttons{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin:22px auto;width:min(1150px,92%)}
.lsp-btn{display:inline-flex;align-items:center;gap:7px;padding:11px 17px;border-radius:10px;background:#fff;color:var(--ink);border:1px solid var(--line);font-size:14px;font-weight:600;transition:transform .2s}
.lsp-btn:hover{transform:translateY(-2px)}
.footer{padding:30px;text-align:center;color:#8a95b0;font-size:14px}

.lsp-bottom-bar{position:fixed;left:0;right:0;bottom:0;z-index:99999;display:flex;gap:10px;padding:10px 12px calc(10px + env(safe-area-inset-bottom,0px));background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-top:1px solid var(--line)}
.lsp-bottom-item{flex:1;min-height:50px;display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;border-radius:12px;color:#fff;background:#1565c0;font-size:14px;text-align:center}
.lsp-bottom-item:last-child{background:var(--ink)}
.lsp-bottom-item span{font-size:18px}

.toast{position:fixed;left:50%;bottom:96px;transform:translate(-50%,20px);background:var(--ink);color:#fff;padding:11px 18px;border-radius:12px;font-size:14px;font-weight:600;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;z-index:100000}
.toast.show{opacity:1;transform:translate(-50%,0)}
.ready .hero-grid{animation:rise .45s ease both}
@keyframes rise{from{opacity:.4;transform:translateY(10px)}to{opacity:1;transform:none}}

@media(max-width:800px){
  .hero-grid,.content-grid{grid-template-columns:1fr}
  .course-card{position:static}
  .hero{padding:30px 0 36px}
}
@media(max-width:600px){
