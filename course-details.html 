<style>
:root{--ink:#0f1b3d;--text:#1c2740;--muted:#5b6785;--line:#e3e8f1;--paper:#f4f6fb;--card:#fff;--blue:#2563eb;--blue-d:#1d4ed8;--tint:#eaf1ff}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;background:var(--paper);color:var(--text);line-height:1.65;padding-bottom:88px}
a{color:inherit;text-decoration:none}
a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid var(--blue);outline-offset:3px}

header{background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:100}
.header-inner{max-width:1150px;margin:auto;min-height:64px;padding:0 20px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{color:var(--ink);font-size:21px;font-weight:800;letter-spacing:-.3px}
.brand span{color:var(--blue)}
.pill{color:var(--blue);border:1px solid var(--line);padding:8px 15px;border-radius:10px;font-weight:700;font-size:14px;background:#fff;transition:background .2s;white-space:nowrap}
.pill:hover{background:var(--tint)}
main{max-width:1150px;margin:28px auto;padding:0 20px}

.error{background:#fff;border:1px solid #fecaca;border-radius:16px;padding:44px 24px;text-align:center;color:#991b1b;display:none;margin-bottom:24px}
.error h1{font-size:24px;margin-bottom:8px;font-family:inherit}
.error a{display:inline-block;margin-top:16px;background:var(--blue);color:#fff;padding:12px 20px;border-radius:12px;font-weight:800}

.sk-wrap{display:none}
.is-loading .sk-wrap{display:block}
.is-loading .real{display:none!important}
.sk{height:14px;margin:10px 0;border-radius:8px;background:linear-gradient(90deg,#e6ebf4 25%,#f3f6fb 40%,#e6ebf4 60%);background-size:300% 100%;animation:shimmer 1.4s linear infinite}
.hero .sk{background:linear-gradient(90deg,rgba(255,255,255,.1) 25%,rgba(255,255,255,.2) 40%,rgba(255,255,255,.1) 60%);background-size:300% 100%}
.sk.w30{width:30%}.sk.w40{width:40%}.sk.w60{width:60%}.sk.w80{width:80%}.sk.h-title{height:38px;width:65%;margin:14px 0}.sk.h-pill{height:26px;width:110px;border-radius:999px}
@keyframes shimmer{from{background-position:100% 0}to{background-position:-100% 0}}

.hero{background:var(--ink);color:#fff;border-radius:22px;overflow:hidden;margin-bottom:24px;box-shadow:0 14px 40px rgba(15,27,61,.18)}
.hero-image{width:100%;height:320px;object-fit:cover;display:none;background:#1b2a55}
.hero-content{padding:36px}
.badges{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
.badge{display:inline-block;background:rgba(255,255,255,.12);color:#cfe0ff;padding:6px 14px;border-radius:999px;font-size:13px;font-weight:700}
.badge.free{background:#bbf7d0;color:#14532d}
.badge.plan{background:#ddd6fe;color:#3b0f8c}
.badge.gold{background:#fbbf24;color:#4a3000}
h1{font-family:Georgia,"Times New Roman",serif;font-size:clamp(30px,5vw,46px);line-height:1.12;letter-spacing:-.5px;margin-bottom:12px;font-weight:700;overflow-wrap:anywhere}
.tagline{font-size:18px;color:#b9c6e4;max-width:760px}
.by{margin-top:10px;color:#9fb2dc;font-size:15px}
.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
.btn{display:inline-flex;align-items:center;justify-content:center;padding:13px 22px;border-radius:12px;font:inherit;font-weight:800;font-size:15px;border:1px solid transparent;cursor:pointer;text-align:center;transition:transform .2s,background .2s}
.btn:active{transform:scale(.97)}
.btn-primary{background:var(--blue);color:#fff}.btn-primary:hover{background:var(--blue-d)}
.btn-share{background:rgba(255,255,255,.12);color:#fff;gap:8px}
.btn-share:hover{background:rgba(255,255,255,.2)}
.btn-share svg{width:18px;height:18px;flex:none}
.toast{position:fixed;left:50%;bottom:96px;transform:translate(-50%,20px);background:var(--ink);color:#fff;padding:11px 18px;border-radius:12px;font-size:14px;font-weight:600;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;z-index:100000}
.toast.show{opacity:1;transform:translate(-50%,0)}

.layout{display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,1fr);gap:24px;align-items:start}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:26px;margin-bottom:20px}
.card h2{font-size:20px;margin-bottom:14px;color:var(--ink);letter-spacing:-.2px}
.description{white-space:pre-line;color:#43506c;max-width:75ch;overflow-wrap:anywhere}
.checks{list-style:none;display:grid;gap:10px;max-width:75ch}
.checks li{position:relative;padding-left:28px;color:#43506c}
.checks li::before{content:"✓";position:absolute;left:0;top:3px;width:20px;height:20px;border-radius:50%;background:#dcfce7;color:#15803d;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center}
.sum{color:var(--muted);font-size:14px;margin:-6px 0 14px}
details.module{border:1px solid var(--line);border-radius:12px;margin-bottom:10px;overflow:hidden}
details.module summary{padding:14px 17px;background:#f8fafd;font-weight:700;color:var(--ink);cursor:pointer;display:flex;justify-content:space-between;gap:12px;list-style:none}
details.module summary::-webkit-details-marker{display:none}
details.module summary small{color:var(--muted);font-weight:600;flex:none}
details.module[open] summary{border-bottom:1px solid var(--line)}
.lesson{padding:11px 17px;border-top:1px solid var(--line);color:var(--muted);font-size:14px}
.lesson:first-of-type{border-top:0}
aside{position:sticky;top:84px}
.get .price{font-size:32px;font-weight:800;color:var(--ink);line-height:1.1;margin-bottom:4px}
.get .price.f{color:#15803d}
.get .note{font-size:13px;color:var(--muted);margin-bottom:16px}
.get .btn{width:100%}
.info-list{display:flex;flex-direction:column;gap:14px}
.info-item{border-bottom:1px solid var(--line);padding-bottom:12px}
.info-item:last-child{border-bottom:0;padding-bottom:0}
.info-label{font-size:13px;color:var(--muted);margin-bottom:2px}
.info-value{color:var(--ink);font-weight:700;overflow-wrap:anywhere}

/* Account call-to-action */
.access{margin:32px 0 0;padding:44px 22px;border-radius:22px;text-align:center;color:#fff;background:radial-gradient(circle at top right,#294b91 0%,transparent 42%),linear-gradient(135deg,#0b1530,#142b55)}
.access h2{font-size:clamp(26px,4.5vw,38px);line-height:1.2;margin-bottom:12px;font-family:Georgia,"Times New Roman",serif}
.access p{color:#d0d9eb;max-width:520px;margin:0 auto 26px}
.access-actions{display:grid;grid-template-columns:1fr 1fr;gap:14px;max-width:560px;margin:auto}
.access-btn{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-radius:12px;font-weight:800;transition:transform .2s,box-shadow .2s}
.access-btn:hover{transform:translateY(-3px);box-shadow:0 10px 25px #0004}
.login-btn{background:#fff;color:#12264b}
.register-btn{background:#3478f6;color:#fff}
.access small{display:block;margin-top:22px;color:#b9c8df;font-size:13px}

.discover{margin:36px 0 12px}
.discover h2{font-size:24px;color:var(--ink);letter-spacing:-.3px;margin-bottom:4px}
.discover .sub{color:var(--muted);font-size:15px;margin-bottom:14px}
.tabs{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:4px 2px 12px;margin-bottom:6px}
.tabs::-webkit-scrollbar{display:none}
.tab{flex:none;padding:10px 18px;border-radius:999px;border:1px solid var(--line);background:#fff;color:var(--ink);font:700 14px/1 inherit;font-family:inherit;cursor:pointer;transition:background .2s,color .2s}
.tab:hover{background:var(--tint)}
.tab[aria-selected="true"]{background:var(--ink);color:#fff;border-color:var(--ink)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px;min-height:120px}
.c{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s}
a.c:hover{transform:translateY(-3px);box-shadow:0 12px 26px rgba(15,27,61,.12)}
.c img,.c .ph{width:100%;height:130px;object-fit:cover;display:block;background:#e6ebf4}
.c .ph{background:linear-gradient(135deg,#1b2a55,#2563eb)}
.c-b{padding:14px 16px 16px}
.c-cat{font-size:12px;color:var(--blue);font-weight:800}
.c-t{font-weight:800;color:var(--ink);margin:3px 0;line-height:1.3;overflow-wrap:anywhere}
.c-d{font-size:13.5px;color:var(--muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.c-m{font-size:13px;font-weight:700;margin-top:8px;color:#15803d}
.c-m.plan{color:#5b21b6}
.empty{grid-column:1/-1;text-align:center;color:var(--muted);padding:34px 16px;background:#fff;border:1px dashed var(--line);border-radius:16px}

.lsp-rtl-inner{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin:32px 0 18px}
.lsp-rtl-button{display:inline-flex;align-items:center;justify-content:center;min-width:150px;padding:13px 24px;border-radius:999px;font-size:15px;font-weight:800;transition:transform .2s,box-shadow .2s}
.lsp-rtl-button:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(15,27,61,.15)}
.lsp-related-button{background:var(--ink);color:#fff}
.lsp-trending-button{background:#fff;color:var(--ink);border:1px solid var(--line)}
.whatsapp-channel-btn{display:flex;width:fit-content;max-width:100%;text-align:center;margin:0 auto;padding:13px 24px;border-radius:999px;background:#25d366;color:#073b1d;font-weight:800}
.whatsapp-channel-btn:hover{filter:brightness(.95)}
.lsp-quick-buttons{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin:22px auto;max-width:1150px;padding:0 20px}
.lsp-btn{display:inline-flex;align-items:center;gap:7px;padding:11px 17px;border-radius:10px;background:#fff;color:var(--ink);border:1px solid var(--line);font-size:14px;font-weight:600;transition:.2s}
.lsp-btn:hover{transform:translateY(-2px);background:var(--tint)}
footer{text-align:center;color:#8a95b0;padding:20px 20px 32px;font-size:14px}

.lsp-bottom-bar{position:fixed;left:0;right:0;bottom:0;z-index:99999;display:flex;gap:10px;padding:10px 12px calc(10px + env(safe-area-inset-bottom,0px));background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-top:1px solid var(--line)}
.lsp-bottom-item{flex:1;min-height:50px;display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;border-radius:12px;color:#fff;background:#1565c0;font-size:14px;text-align:center}
.lsp-bottom-item:last-child{background:var(--ink)}
.lsp-bottom-item span{font-size:18px}

.course.ready .hero{animation:rise .45s ease both}
@keyframes rise{from{opacity:.4;transform:translateY(10px)}to{opacity:1;transform:none}}

@media(max-width:800px){
  .layout{grid-template-columns:1fr}
  aside{position:static}
  .hero-image{height:220px}
  .hero-content{padding:26px}
  .card{padding:22px}
}
@media(max-width:500px){
  main{margin:18px auto;padding:0 13px}
  .brand{font-size:19px}
  .header-inner{padding:0 14px}
  .pill{padding:7px 11px;font-size:13px}
  .tagline{font-size:16px}
  .actions .btn{flex:1 1 100%}
  .access-actions{grid-template-columns:1fr}
  .grid{grid-template-columns:1fr 1fr;gap:12px}
  .c img,.c .ph{height:100px}
  .c-b{padding:12px}
  .lsp-quick-buttons{display:grid;grid-template-columns:repeat(2,1fr);padding:0 13px}
  .lsp-btn{justify-content:center}
  .lsp-bottom-item{font-size:12px}
  .lsp-rtl-button{flex:1;min-width:130px}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>

