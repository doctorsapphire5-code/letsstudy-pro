<style>
:root{--ink:#0f1b3d;--text:#1c2740;--muted:#5b6785;--line:#e3e8f1;--paper:#f4f6fb;--blue:#2563eb;--tint:#eaf1ff}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;background:var(--paper);color:var(--text);line-height:1.65;padding-bottom:88px}
a{color:inherit;text-decoration:none}
a:focus-visible,button:focus-visible{outline:3px solid var(--blue);outline-offset:3px}

.navbar{height:64px;background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 max(20px,4%);position:sticky;top:0;z-index:100}
.logo{font-size:21px;font-weight:800;color:var(--ink);letter-spacing:-.3px}
.logo span{color:var(--blue)}
.back{color:var(--blue);border:1px solid var(--line);padding:8px 15px;border-radius:10px;font-weight:700;font-size:14px;background:#fff}
.back:hover{background:var(--tint)}
.container{width:min(1150px,92%);margin:auto}

.error{display:none;margin:40px auto;width:min(1150px,92%);background:#fff;border:1px solid #fecaca;border-radius:16px;padding:44px 24px;text-align:center;color:#991b1b}
.error h1{font-size:24px;margin-bottom:8px}
.error a{display:inline-block;margin-top:16px;background:var(--blue);color:#fff;padding:12px 20px;border-radius:12px;font-weight:800}

/* Skeleton, shown instantly instead of "Loading..." */
.sk-wrap{display:none}
.is-loading .sk-wrap{display:block}
.is-loading .real{display:none!important}
.sk{height:14px;margin:10px 0;border-radius:8px;background:linear-gradient(90deg,#e6ebf4 25%,#f3f6fb 40%,#e6ebf4 60%);background-size:300% 100%;animation:shimmer 1.4s linear infinite}
.hero .sk{background:linear-gradient(90deg,rgba(255,255,255,.1) 25%,rgba(255,255,255,.2) 40%,rgba(255,255,255,.1) 60%);background-size:300% 100%}
.sk.w30{width:30%}.sk.w40{width:40%}.sk.w60{width:60%}.sk.w80{width:80%}.sk.h-title{height:40px;width:70%;margin:16px 0}.sk.h-pill{height:26px;width:90px;border-radius:999px}.sk.h-img{height:200px;border-radius:14px;margin:0 0 14px}.sk.h-btn{height:48px;border-radius:12px;margin-top:18px}
@keyframes shimmer{from{background-position:100% 0}to{background-position:-100% 0}}

.hero{background:var(--ink);color:#fff;padding:44px 0 52px}
.hero-grid{display:grid;grid-template-columns:1.5fr .8fr;gap:40px;align-items:start}
.category{color:#9fc0ff;font-size:14px;font-weight:600;margin-bottom:12px}
h1{font-family:Georgia,"Times New Roman",serif;font-size:clamp(30px,5vw,44px);line-height:1.12;letter-spacing:-.5px;margin-bottom:16px;font-weight:700;overflow-wrap:anywhere}
.hero .description{color:#b9c6e4;line-height:1.7;max-width:720px}
.badges{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}
.badge{display:inline-flex;padding:6px 13px;border-radius:999px;font-size:13px;font-weight:700}
.free{background:#bbf7d0;color:#14532d}
.plan{background:#ddd6fe;color:#4c1d95}
.sponsored{background:#fde68a;color:#78350f}

.course-card{background:#fff;color:var(--text);border-radius:18px;overflow:hidden;box-shadow:0 18px 45px rgba(0,0,0,.25);position:sticky;top:84px}
.thumbnail{width:100%;height:200px;object-fit:cover;background:#e9eef5;display:block}
