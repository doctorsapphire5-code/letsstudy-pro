  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
};
const db = getFirestore(initializeApp(firebaseConfig));

const courseId = new URLSearchParams(location.search).get("id");
const $ = id => document.getElementById(id);
const page = $("page"), errorBox = $("error");
const CACHE_KEY = "lsp:course:" + courseId;
const WK = Math.floor(Date.now() / 6048e5);
const col = collection(db, "courses");

/* ---------- Helpers ---------- */
const text = v => (v === undefined || v === null) ? "" : String(v).trim();
const first = (d, f) => { for(const k of f){ const v = text(d?.[k]); if(v) return v; } return ""; };
const firstKey = (d, f) => f.find(k => text(d?.[k]));
const fmt = n => new Intl.NumberFormat("en").format(Number(n) || 0);
const K = {
  title: ["title","name","courseTitle"],
  tagline: ["tagline","subtitle","headline","shortDescription","summary","excerpt"],
  description: ["description","about","overview","content"],
  instructor: ["instructor","instructorName","teacher","author"],
  category: ["category","subject","field"],
  level: ["level","difficulty"],
  duration: ["duration","courseDuration","length"],
  language: ["language","lang"],
  certificate: ["certificate","certification"],
  access: ["access","accessType","membership","plan","pricing"],
  price: ["price","amount","coursePrice","planPrice"],
  image: ["thumbnail","thumbnailUrl","image","imageUrl","cover","coverImage"],
  learn: ["outcomes","whatYouWillLearn","learn","objectives","learningOutcomes"],
  req: ["requirements","prerequisites"]
};
const isPlan = d => ["plan","premium","paid","pro"].includes(first(d, K.access).toLowerCase()) || d?.premium === true || d?.isPremium === true || d?.paid === true;
const getPrice = d => first(d, K.price);
const getImage = d => first(d, K.image);
/* Plan price is always shown in Tanzanian shillings: TZS 50,000 */
function formatTZS(raw){
  const s = text(raw);
  if(!s) return "Plan";
  const n = Number(s.replace(/[^0-9.]/g, ""));
  if(/^[^0-9]*[0-9][0-9,.\s]*[^0-9]*$/.test(s) && Number.isFinite(n) && n > 0) return "TZS " + n.toLocaleString("en-US", { maximumFractionDigits: 2 });
  return s;
}
function safeUrl(v){
  const s = text(v); if(!s) return "";
  try{ return new URL(/^https?:\/\//i.test(s) ? s : "https://" + s).href; }catch(e){ return ""; }
}
function setMeta(sel, attr, val){ const e = document.querySelector(sel); if(e && val) e.setAttribute(attr, val); }
function clip(s, n){ s = text(s).replace(/\s+/g, " "); return s.length > n ? s.slice(0, n-1).trimEnd() + "…" : s; }
function el(tag, cls, txt){ const e = document.createElement(tag); if(cls) e.className = cls; if(txt !== undefined) e.textContent = txt; return e; }
function listOf(v){ return (Array.isArray(v) ? v.map(text) : text(v).split(/\n+/)).map(s => s.trim()).filter(Boolean); }

/* ---------- Cart (courseCart = array of course objects) ---------- */
function addToCart(course){
  let cart = [];
  try{ cart = JSON.parse(localStorage.getItem("courseCart") || "[]"); }catch(e){ cart = []; }
  if(!Array.isArray(cart)) cart = [];
  if(!cart.some(i => i && i.id === courseId)){
    cart.push({ id: courseId, courseId, title: first(course, K.title), price: getPrice(course), currency: "TZS", image: getImage(course), type: "plan", addedAt: Date.now() });
    try{ localStorage.setItem("courseCart", JSON.stringify(cart)); }catch(e){}
  }
  location.href = "course-cart.html?id=" + encodeURIComponent(courseId);
}

/* ---------- Discover ---------- */
const ctx = { pairs: [] };
const lists = {};
async function run(...c){
  try{
    const snap = await getDocs(query(col, ...c));
    return snap.docs.map(d => ({ id: d.id, data: d.data() })).filter(x => x.id !== courseId);
  }catch(e){ console.warn("Discover query failed:", e.message); return []; }
}
const LOADERS = {
  related: async () => {
    for(const [k, v] of ctx.pairs){ const r = await run(where(k, "==", v), limit(13)); if(r.length) return r; }
    return [];
  },
  trending: async () => {
    const r = (await run(orderBy("weekViews", "desc"), limit(20))).filter(x => x.data.weekKey === WK && Number(x.data.weekViews) > 0);
    return r.length ? r : LOADERS.popular();
  },
  featured: () => run(where("featured", "==", true), limit(13)),
  recent: async () => { const r = await run(orderBy("createdAt", "desc"), limit(13)); return r.length ? r : run(limit(13)); },
  popular: () => run(orderBy("views", "desc"), limit(13))
};
const EMPTY = {
  related: "No related courses yet.",
  trending: "Nothing is trending yet. Check back soon.",
  featured: "No featured courses right now.",
  recent: "No courses have been added yet.",
  popular: "Popular courses will appear as people explore them."
};
function card(item){
  const d = item.data, title = first(d, K.title) || item.id, plan = isPlan(d);
  const a = el("a", "c");
  a.href = "course-details.html?id=" + encodeURIComponent(item.id);
  const img = safeUrl(getImage(d));
  if(img){
    const i = el("img"); i.loading = "lazy"; i.decoding = "async"; i.alt = title; i.src = img;
    i.onerror = () => i.replaceWith(el("div", "ph"));
    a.appendChild(i);
  }else a.appendChild(el("div", "ph"));
  const b = el("div", "c-b");
  const cat = first(d, K.category);
  if(cat) b.appendChild(el("div", "c-cat", cat));
  b.appendChild(el("div", "c-t", title));
  const desc = clip(first(d, K.tagline) || first(d, K.description), 110);
  if(desc) b.appendChild(el("div", "c-d", desc));
  b.appendChild(el("div", "c-m" + (plan ? " plan" : ""), plan ? formatTZS(getPrice(d)) : "Free"));
  a.appendChild(b);
  return a;
}
function skeletons(){
  const g = $("grid"); g.replaceChildren();
  for(let i = 0; i < 4; i++){
    const c = el("div", "c");
    c.innerHTML = '<div class="ph" style="background:#e6ebf4"></div><div class="c-b"><div class="sk w40"></div><div class="sk"></div><div class="sk w60"></div></div>';
    g.appendChild(c);
  }
}
let current = "";
async function show(kind){
  current = kind;
  document.querySelectorAll(".tab").forEach(t => t.setAttribute("aria-selected", String(t.dataset.k === kind)));
  if(!lists[kind]){ skeletons(); lists[kind] = await LOADERS[kind](); }
  if(current !== kind) return;
  const g = $("grid"); g.replaceChildren();
  const items = lists[kind].slice(0, 12);
  if(!items.length){ g.appendChild(el("div", "empty", EMPTY[kind])); return; }
  items.forEach(i => g.appendChild(card(i)));
}
document.querySelectorAll(".tab").forEach(t => t.addEventListener("click", () => show(t.dataset.k)));
let discoverStarted = false;
async function startDiscover(){
  if(discoverStarted) return;
  discoverStarted = true;
  lists.related = await LOADERS.related();
  show(lists.related.length ? "related" : "trending");
}

/* ---------- Count a view once per session (feeds Trending and Most popular) ---------- */
let lastData = null;
function countView(){
  const k = "lsp:seen:course:" + courseId;
  try{ if(sessionStorage.getItem(k)) return; sessionStorage.setItem(k, "1"); }catch(e){}
  const cur = lastData || {};
  const u = { views: increment(1), lastViewedAt: serverTimestamp() };
  if(cur.weekKey === WK) u.weekViews = increment(1); else { u.weekKey = WK; u.weekViews = 1; }
  updateDoc(doc(db, "courses", courseId), u).catch(() => {});
}

/* ---------- Render ---------- */
function renderModules(course){
  const target = $("modules"); target.replaceChildren();
  const modules = Array.isArray(course.modules) ? course.modules : [];
  let lessonTotal = 0;
  if(!modules.length){
    target.appendChild(el("p", "description", "Course lessons will appear here."));
    $("contentSum").textContent = "";
    return;
  }
  modules.forEach((m, i) => {
    const lessons = Array.isArray(m?.lessons) ? m.lessons : [];
    lessonTotal += lessons.length;
    const box = el("details", "module");
    if(i === 0) box.open = true;
    const sm = el("summary");
    sm.append(el("span", "", text(m?.title || m?.name) || "Module " + (i + 1)), el("small", "", lessons.length + (lessons.length === 1 ? " lesson" : " lessons")));
    box.appendChild(sm);
    if(!lessons.length) box.appendChild(el("div", "lesson", "Lessons coming soon."));
    lessons.forEach(l => {
      const t = (l && typeof l === "object") ? text(l.title || l.name) : text(l);
      box.appendChild(el("div", "lesson", t || "Lesson"));
    });
    target.appendChild(box);
  });
  $("contentSum").textContent = modules.length + (modules.length === 1 ? " module" : " modules") + " • " + lessonTotal + (lessonTotal === 1 ? " lesson" : " lessons");
}

function fillList(cardId, ulId, items){
  const ul = $(ulId); ul.replaceChildren();
  items.forEach(s => ul.appendChild(el("li", "", s)));
  $(cardId).style.display = items.length ? "block" : "none";
}

function render(course){
  lastData = course;
  const title = first(course, K.title) || "Untitled course";
  const tagline = first(course, K.tagline);
  const description = first(course, K.description) || tagline;
  const instructor = first(course, K.instructor);
  const category = first(course, K.category);
  const image = getImage(course);
  const plan = isPlan(course);

  document.title = title + " | LetsStudy Pro";
  $("title").textContent = title;
  $("tagline").textContent = tagline && tagline !== description ? tagline : clip(description, 220);
  $("by").textContent = instructor ? "Taught by " + instructor : "";
  $("by").style.display = instructor ? "" : "none";
  $("overview").textContent = description || "Explore this course and start learning with LetsStudy Pro.";
  $("sponsoredBadge").style.display = course.sponsored ? "inline-block" : "none";
  $("featuredBadge").style.display = (course.featured === true || course.featured === "true") ? "inline-block" : "none";
  $("categoryBadge").textContent = category;
  $("categoryBadge").style.display = category ? "inline-block" : "none";
  $("viewsBadge").textContent = fmt(course.views) + " views";
  $("viewsBadge").style.display = Number(course.views) > 0 ? "inline-block" : "none";

  const thumb = $("thumbnail");
  if(image){ thumb.alt = title; thumb.onerror = () => { thumb.style.display = "none"; }; thumb.src = image; thumb.style.display = "block"; }
  else{ thumb.removeAttribute("src"); thumb.style.display = "none"; }

  const badge = $("accessBadge"), price = $("price"), note = $("priceNote");
  const btns = [$("actionBtn"), $("heroAction")];
  if(plan){
    badge.textContent = "Plan"; badge.className = "badge plan";
    price.textContent = formatTZS(getPrice(course)); price.className = "price";
    note.textContent = "Choose a plan to unlock the full course.";
    btns.forEach(b => {
      b.textContent = "Choose plan";
      b.href = "course-cart.html?id=" + encodeURIComponent(courseId);
      b.onclick = e => { e.preventDefault(); addToCart(course); };
    });
  }else{
    badge.textContent = "Free"; badge.className = "badge free";
    price.textContent = "Free"; price.className = "price f";
    note.textContent = "No payment needed. Enroll and start now.";
    btns.forEach(b => { b.textContent = "Enroll free"; b.href = "enroll.html?id=" + encodeURIComponent(courseId); b.onclick = null; });
  }

  const mods = Array.isArray(course.modules) ? course.modules : [];
  const lessons = mods.reduce((n, m) => n + (Array.isArray(m?.lessons) ? m.lessons.length : 0), 0);
  const rows = [
    ["Instructor", instructor], ["Category", category], ["Level", first(course, K.level)],
    ["Duration", first(course, K.duration)], ["Language", first(course, K.language)],
    ["Content", mods.length ? mods.length + " modules, " + lessons + " lessons" : ""],
    ["Certificate", first(course, K.certificate)], ["Course access", plan ? "Plan" : "Free"]
  ].filter(r => r[1]);
  const info = $("infoList"); info.replaceChildren();
  rows.forEach(([l, v]) => { const it = el("div", "info-item"); it.append(el("div", "info-label", l), el("div", "info-value", v)); info.appendChild(it); });

  fillList("learnCard", "learn", listOf(course[firstKey(course, K.learn)]));
  fillList("reqCard", "req", listOf(course[firstKey(course, K.req)]));
  renderModules(course);

  const desc = clip(tagline || description || "Learn " + title + " on LetsStudy Pro.", 155);
  const canonical = location.origin + location.pathname + "?id=" + encodeURIComponent(courseId);
  setMeta('meta[name="description"]', "content", desc);
  setMeta('meta[property="og:title"]', "content", document.title);
  setMeta('meta[property="og:description"]', "content", desc);
  setMeta('meta[property="og:url"]', "content", canonical);
  if(safeUrl(image)){ setMeta('meta[property="og:image"]', "content", safeUrl(image)); setMeta('meta[name="twitter:image"]', "content", safeUrl(image)); }
  setMeta("#canonicalLink", "href", canonical);

  let ld = $("courseLd");
  if(!ld){ ld = document.createElement("script"); ld.type = "application/ld+json"; ld.id = "courseLd"; document.head.appendChild(ld); }
  ld.textContent = JSON.stringify({ "@context": "https://schema.org", "@type": "Course", name: title, description: desc, url: canonical,
    provider: { "@type": "Organization", name: "LetsStudy Pro", sameAs: location.origin }, ...(safeUrl(image) && { image: safeUrl(image) }) });

  const ck = firstKey(course, K.category);
  ctx.pairs = ck && typeof course[ck] === "string" ? [[ck, course[ck]]] : [];

  errorBox.style.display = "none";
  page.classList.remove("is-loading");
  page.classList.add("ready");
  startDiscover();
}

function showError(title, message){
  page.style.display = "none";
  errorBox.replaceChildren(el("h1", "", title), el("p", "", message));
  const a = el("a", "", "Back to Search"); a.href = "search.html";
  errorBox.appendChild(a);
  errorBox.style.display = "block";
  startDiscover();
}
function readCache(){
  try{ const c = JSON.parse(localStorage.getItem(CACHE_KEY) || "null"); return c && c.data ? c : null; }catch(e){ return null; }
}
function writeCache(data){ try{ localStorage.setItem(CACHE_KEY, JSON.stringify({ t: Date.now(), data })); }catch(e){} }

async function init(){
  if(!courseId){ showError("Course not found", "No course was selected."); return; }
  const cached = readCache();
  if(cached) render(cached.data);
  try{
    const snap = await getDoc(doc(db, "courses", courseId));
    if(!snap.exists()){
      try{ localStorage.removeItem(CACHE_KEY); }catch(e){}
      showError("Course not found", "This course is unavailable.");
      return;
    }
    const data = JSON.parse(JSON.stringify(snap.data() || {}));
    if(!cached || JSON.stringify(cached.data) !== JSON.stringify(data)) render(data);
    lastData = data;
    writeCache(data);
    countView();
  }catch(err){
    console.error("Course loading error:", err);
    if(!cached) showError("Unable to load course", "Check your connection and try again.");
  }
}

/* ---------- Toast + Share ---------- */
const toast = $("toast");
let toastTimer;
function notify(m){
  toast.textContent = m; toast.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove("show"), 2200);
}
async function copyLink(url){
  try{ await navigator.clipboard.writeText(url); }
  catch(e){
    const t = document.createElement("textarea");
    t.value = url; t.style.position = "fixed"; t.style.opacity = "0";
    document.body.appendChild(t); t.select();
    try{ document.execCommand("copy"); }catch(_){}
    t.remove();
  }
  notify("Link copied");
}
$("shareBtn").addEventListener("click", async () => {
  const url = location.origin + location.pathname + "?id=" + encodeURIComponent(courseId || "");
  const data = { title: ($("title").textContent || "Course") + " | LetsStudy Pro", text: clip($("tagline").textContent || "Learn on LetsStudy Pro", 120), url };
  if(navigator.share){
    try{ await navigator.share(data); }catch(e){ if(e.name !== "AbortError") copyLink(url); }
  }else copyLink(url);
});

init();
</script>
