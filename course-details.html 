  }

}

/* ACCESSIBILITY */

@media (prefers-reduced-motion: reduce) {

  .lsp-related-trending-links,
  .lsp-rtl-button {
    animation: none !important;
    transition: none !important;
  }

  .lsp-rtl-button:hover {
    transform: none;
  }

}

