
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Profile | Vorix Course</title>
  <meta name="description" content="Edit and update your Vorix Course user profile.">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f4f6fb;
      color: #172033;
      line-height: 1.6;
    }

    header {
      background: #102b55;
      color: white;
      padding: 17px 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    header h2 {
      font-size: 21px;
    }

    header a {
      color: white;
      text-decoration: none;
      font-size: 14px;
    }

    .container {
      width: 92%;
      max-width: 850px;
      margin: 30px auto;
    }

    .heading {
      margin-bottom: 22px;
    }

    .heading h1 {
      font-size: 27px;
      margin-bottom: 5px;
    }

    .heading p {
      font-size: 14px;
      color: #748094;
    }

    .card {
      background: white;
      padding: 22px;
      border-radius: 13px;
      margin-bottom: 20px;
      box-shadow: 0 3px 15px rgba(0,0,0,.045);
    }

    .card h3 {
      font-size: 18px;
      color: #102b55;
      margin-bottom: 5px;
    }

    .description {
      color: #7a8495;
      font-size: 13px;
      margin-bottom: 18px;
    }

    .profile-preview {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 20px;
    }

    .profile-preview img {
      width: 85px;
      height: 85px;
      border-radius: 50%;
      object-fit: cover;
      background: #edf1f7;
      border: 3px solid #e8edf5;
    }

    .profile-preview p {
      font-size: 13px;
      color: #748094;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .form-group {
      margin-bottom: 15px;
    }

    .full-width {
      grid-column: 1 / -1;
    }

    label {
      display: block;
      font-weight: 600;
      font-size: 14px;
      margin-bottom: 7px;
    }

    input, select, textarea {
      width: 100%;
      padding: 12px;
      border: 1px solid #dce2eb;
      border-radius: 8px;
      font-family: inherit;
      font-size: 14px;
      color: #172033;
      background: white;
    }

    textarea {
      resize: vertical;
      min-height: 100px;
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: #2463eb;
    }

    input[readonly] {
      background: #f1f3f7;
      color: #788397;
      cursor: not-allowed;
    }

    .hint {
      color: #8992a1;
      font-size: 12px;
      margin-top: 5px;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 15px;
    }

    button {
      border: none;
      padding: 12px 18px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }

    button:disabled {
      opacity: .6;
      cursor: not-allowed;
    }

    .primary {
      background: #2463eb;
      color: white;
    }

    .secondary {
      background: #edf1f7;
      color: #172033;
    }

    #message {
      display: none;
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 18px;
      font-size: 14px;
      overflow-wrap: anywhere;
    }

    #message.success {
      display: block;
      background: #e8f8ee;
      color: #16743a;
    }

    #message.error {
      display: block;
      background: #fff0f0;
      color: #b42323;
    }

    footer {
      text-align: center;
      color: #8992a1;
      padding: 25px 10px;
      font-size: 12px;
    }

    @media(max-width: 600px) {
      .container {
        width: 94%;
        margin: 20px auto;
      }

      .card {
        padding: 17px;
      }

      .heading h1 {
        font-size: 23px;
      }

      .form-grid {
        grid-template-columns: 1fr;
        gap: 0;
      }
    }
  </style>
</head>

<body>

<header>
  <h2>Vorix Course</h2>
  <a href="course-dashboard.html">← Dashboard</a>
</header>

<main class="container">

  <div class="heading">
    <h1>Edit Profile</h1>
    <p>Update your personal and professional information.</p>
  </div>

  <div id="message"></div>

  <form id="profileForm">

    <!-- PROFILE PHOTO -->
    <section class="card">
      <h3>Profile Photo</h3>
      <p class="description">
        Add a public image URL for your profile picture.
      </p>

      <div class="profile-preview">
        <img
          id="photoPreview"
          src="https://placehold.co/120x120?text=Profile"
          alt="Profile preview"
        >

        <div>
          <strong id="previewName">Your Profile</strong>
          <p>Profile picture preview</p>
        </div>
      </div>

      <div class="form-group">
        <label for="photoURL">Profile Photo URL</label>
        <input
          type="url"
          id="photoURL"
          placeholder="https://example.com/photo.jpg"
        >
        <p class="hint">
          Use a publicly accessible image URL.
        </p>
      </div>
    </section>

    <!-- PERSONAL INFORMATION -->
    <section class="card">
      <h3>Personal Information</h3>
      <p class="description">
        Update your personal details.
      </p>

      <div class="form-grid">

        <div class="form-group">
          <label for="firstName">First Name</label>
          <input type="text" id="firstName" maxlength="80">
        </div>

        <div class="form-group">
          <label for="lastName">Last Name</label>
          <input type="text" id="lastName" maxlength="80">
        </div>

        <div class="form-group full-width">
          <label for="fullName">Full Name</label>
          <input type="text" id="fullName" maxlength="160" required>
        </div>

        <div class="form-group">
          <label for="username">Username</label>
          <input type="text" id="username" maxlength="40">
        </div>

        <div class="form-group">
          <label for="dateOfBirth">Date of Birth</label>
          <input type="date" id="dateOfBirth">
        </div>

        <div class="form-group">
          <label for="gender">Gender</label>
          <select id="gender">
            <option value="">Select gender</option>
            <option value="male">Male</option>
            <option value="female">Female</option>
            <option value="other">Other</option>
            <option value="prefer_not_to_say">Prefer not to say</option>
          </select>
        </div>

        <div class="form-group">
          <label for="phoneNumber">Phone Number</label>
          <input
            type="tel"
            id="phoneNumber"
            maxlength="25"
            placeholder="+255..."
          >
        </div>

        <div class="form-group full-width">
          <label for="email">Email Address</label>
          <input type="email" id="email" readonly>
          <p class="hint">
            To change your email, visit Account Management.
          </p>
        </div>

      </div>
    </section>

    <!-- LOCATION -->
    <section class="card">
      <h3>Location Information</h3>
      <p class="description">
        Add your country and location details.
      </p>

      <div class="form-grid">

        <div class="form-group">
          <label for="country">Country</label>
          <input type="text" id="country" maxlength="100">
        </div>

        <div class="form-group">
          <label for="region">Region / State</label>
          <input type="text" id="region" maxlength="100">
        </div>

        <div class="form-group">
          <label for="city">City</label>
          <input type="text" id="city" maxlength="100">
        </div>

        <div class="form-group">
          <label for="postalCode">Postal Code</label>
          <input type="text" id="postalCode" maxlength="20">
        </div>

        <div class="form-group full-width">
          <label for="address">Street Address</label>
          <input type="text" id="address" maxlength="250">
        </div>

      </div>
    </section>

    <!-- PROFESSIONAL INFORMATION -->
    <section class="card">
      <h3>Education and Professional Information</h3>
      <p class="description">
        Share your education and professional background.
      </p>

      <div class="form-grid">

        <div class="form-group">
          <label for="educationLevel">Education Level</label>
          <select id="educationLevel">
            <option value="">Select education level</option>
            <option value="primary">Primary Education</option>
            <option value="secondary">Secondary Education</option>
            <option value="certificate">Certificate</option>
            <option value="diploma">Diploma</option>
            <option value="bachelor">Bachelor's Degree</option>
            <option value="master">Master's Degree</option>
            <option value="phd">PhD</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div class="form-group">
          <label for="occupation">Occupation</label>
          <input type="text" id="occupation" maxlength="120">
        </div>

        <div class="form-group full-width">
          <label for="organizationName">Organization Name</label>
          <input type="text" id="organizationName" maxlength="160">
        </div>

      </div>
    </section>

    <!-- ABOUT -->
    <section class="card">
      <h3>About You</h3>
      <p class="description">
        Tell other people about your background and interests.
      </p>

      <div class="form-group">
        <label for="bio">Biography</label>
        <textarea
          id="bio"
          maxlength="1000"
          placeholder="Write a short biography..."
        ></textarea>
      </div>

      <div class="form-group">
        <label for="skills">Skills</label>
        <input
          type="text"
          id="skills"
          placeholder="Teaching, Programming, Design"
        >
        <p class="hint">Separate skills with commas.</p>
      </div>

      <div class="form-group">
        <label for="interests">Interests</label>
        <input
          type="text"
          id="interests"
          placeholder="Technology, Business, Education"
        >
        <p class="hint">Separate interests with commas.</p>
      </div>
    </section>

    <!-- ONLINE PRESENCE -->
    <section class="card">
      <h3>Online Presence</h3>
      <p class="description">
        Add your website or professional portfolio.
      </p>

      <div class="form-group">
        <label for="website">Website</label>
        <input
          type="url"
          id="website"
          placeholder="https://example.com"
        >
      </div>
    </section>

    <!-- SAVE -->
    <section class="card">
      <h3>Save Profile</h3>
      <p class="description">
        Review your information before saving.
      </p>

      <div class="actions">
        <button type="submit" class="primary" id="saveBtn">
          Save Changes
        </button>

        <button type="button" class="secondary" id="cancelBtn">
          Cancel
        </button>
      </div>
    </section>

  </form>

</main>

<footer>
  © <span id="year"></span> Vorix Course. All rights reserved.
</footer>

<script type="module">

  import {
    initializeApp
  } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

  import {
    getAuth,
    onAuthStateChanged,
    updateProfile,
    signOut
  } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

  import {
    getFirestore,
    doc,
    getDoc,
    updateDoc,
    serverTimestamp
  } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";

  // FIREBASE CONFIGURATION
  const firebaseConfig = {
    apiKey: "AIzaSyDaJ0LKede-fz0MTZl-V1SxZ4Ps0IETepE",
    authDomain: "vorix-course.firebaseapp.com",
    projectId: "vorix-course",
    storageBucket: "vorix-course.firebasestorage.app",
    messagingSenderId: "277814413742",
    appId: "1:277814413742:web:fb4515f03591ea07c7603f",
    measurementId: "G-SQ6PN704M7"
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);

  const $ = id => document.getElementById(id);

  let currentUser = null;
  let originalProfile = null;

  $("year").textContent = new Date().getFullYear();

  function getValue(id) {
    return $(id).value.trim();
  }

  function setValue(id, value) {
    $(id).value = value ?? "";
  }

  function showMessage(message, type = "success") {
    const element = $("message");
    element.textContent = message;
    element.className = type;
    element.style.display = "block";

    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });
  }

  function getProfileData() {
    return {
      fullName: getValue("fullName"),
      username: getValue("username"),
      firstName: getValue("firstName"),
      lastName: getValue("lastName"),
      phoneNumber: getValue("phoneNumber"),
      dateOfBirth: getValue("dateOfBirth"),
      gender: getValue("gender"),
      photoURL: getValue("photoURL"),
      country: getValue("country"),
      region: getValue("region"),
      city: getValue("city"),
      postalCode: getValue("postalCode"),
      address: getValue("address"),
      educationLevel: getValue("educationLevel"),
      occupation: getValue("occupation"),
      organizationName: getValue("organizationName"),
      bio: getValue("bio"),
      skills: getValue("skills")
        .split(",")
        .map(item => item.trim())
        .filter(Boolean),
      interests: getValue("interests")
        .split(",")
        .map(item => item.trim())
        .filter(Boolean),
      website: getValue("website")
    };
  }

  function fillProfile(data, user) {
    setValue("fullName", data.fullName || user.displayName || "");
    setValue("username", data.username);
    setValue("firstName", data.firstName);
    setValue("lastName", data.lastName);
    setValue("phoneNumber", data.phoneNumber);
    setValue("dateOfBirth", data.dateOfBirth);
    setValue("gender", data.gender);
    setValue("photoURL", data.photoURL || user.photoURL || "");
    setValue("email", user.email);
    setValue("country", data.country);
    setValue("region", data.region);
    setValue("city", data.city);
    setValue("postalCode", data.postalCode);
    setValue("address", data.address);
    setValue("educationLevel", data.educationLevel);
    setValue("occupation", data.occupation);
    setValue("organizationName", data.organizationName);
    setValue("bio", data.bio);
    setValue("skills", Array.isArray(data.skills)
      ? data.skills.join(", ")
      : "");
    setValue("interests", Array.isArray(data.interests)
      ? data.interests.join(", ")
      : "");
    setValue("website", data.website);

    $("photoPreview").src =
      data.photoURL ||
      user.photoURL ||
      "https://placehold.co/120x120?text=Profile";

    $("previewName").textContent =
      data.fullName || user.displayName || "Your Profile";

    originalProfile = getProfileData();
  }

  async function loadProfile(user) {
    try {
      const userRef = doc(db, "users", user.uid);
      const userSnap = await getDoc(userRef);

      if (!userSnap.exists()) {
        showMessage("User profile not found.", "error");
        return;
      }

      const data = userSnap.data();

      if (data.status && data.status !== "active") {
        await signOut(auth);
        window.location.href = "course-login.html";
        return;
      }

      fillProfile(data, user);

    } catch (error) {
      console.error("Profile loading error:", error);
      showMessage("Unable to load your profile.", "error");
    }
  }

  // SAVE PROFILE
  $("profileForm").addEventListener("submit", async event => {
    event.preventDefault();

    if (!currentUser) return;

    const fullName = getValue("fullName");

    if (!fullName) {
      showMessage("Please enter your full name.", "error");
      return;
    }

    const photoURL = getValue("photoURL");

    if (photoURL) {
      try {
        const parsedURL = new URL(photoURL);

        if (!["http:", "https:"].includes(parsedURL.protocol)) {
          throw new Error("Invalid photo URL");
        }
      } catch {
        showMessage("Please enter a valid profile photo URL.", "error");
        return;
      }
    }

    const website = getValue("website");

    if (website) {
      try {
        const parsedURL = new URL(website);

        if (!["http:", "https:"].includes(parsedURL.protocol)) {
          throw new Error("Invalid website URL");
        }
      } catch {
        showMessage("Please enter a valid website URL.", "error");
        return;
      }
    }

    const saveBtn = $("saveBtn");

    try {
      saveBtn.disabled = true;
      saveBtn.textContent = "Saving...";

      const profileData = getProfileData();

      await updateDoc(
        doc(db, "users", currentUser.uid),
        {
          ...profileData,
          updatedAt: serverTimestamp()
        }
      );

      await updateProfile(currentUser, {
        displayName: profileData.fullName,
        photoURL: profileData.photoURL || null
      });

      originalProfile = profileData;

      $("previewName").textContent = profileData.fullName;

      showMessage("Your profile has been updated successfully.");

    } catch (error) {
      console.error("Profile update error:", error);

      showMessage(
        error.message || "Unable to update your profile.",
        "error"
      );

    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = "Save Changes";
    }
  });

  // CANCEL CHANGES
  $("cancelBtn").addEventListener("click", () => {
    if (currentUser && originalProfile) {
      fillProfile(originalProfile, currentUser);
      showMessage("Your unsaved changes have been discarded.");
    }
  });

  // PHOTO PREVIEW
  $("photoURL").addEventListener("input", () => {
    const value = getValue("photoURL");

    $("photoPreview").src =
      value || "https://placehold.co/120x120?text=Profile";
  });

  // NAME PREVIEW
  $("fullName").addEventListener("input", () => {
    $("previewName").textContent =
      getValue("fullName") || "Your Profile";
  });

  // AUTHENTICATION
  onAuthStateChanged(auth, async user => {
    if (!user) {
      window.location.href = "course-login.html";
      return;
    }

    currentUser = user;
    await loadProfile(user);
  });

</script>

</body>
</html>
