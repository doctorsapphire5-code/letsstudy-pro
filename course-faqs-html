<style>
:root{
  --ink:#0d1b2a;--ink-2:#16293f;--paper:#f2f5f9;--card:#fff;--line:#dde4ec;
  --mute:#5b6b7e;--brand:#0a7c66;--brand-soft:#e2f4ef;--amber:#f2a93b;--red:#c0392b;
  --head:"Bricolage Grotesque","Figtree",system-ui,sans-serif;
  --body:"Figtree",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:var(--body);background:var(--paper);color:var(--ink);line-height:1.55;-webkit-font-smoothing:antialiased;min-height:100vh;display:flex;flex-direction:column}
a{color:inherit}
button{font-family:inherit}
:focus-visible{outline:3px solid var(--amber);outline-offset:2px;border-radius:6px}
.i{width:17px;height:17px;min-width:17px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}

/* TOP BAR */
.topbar{position:sticky;top:0;z-index:50;height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 max(18px,5%);background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--head);font-size:20px;font-weight:700;letter-spacing:-.3px;text-decoration:none}
.brand-mark{width:32px;height:32px;border-radius:9px;background:var(--ink);color:var(--amber);display:grid;place-items:center;font-size:16px}
.back-btn{display:inline-flex;align-items:center;gap:8px;padding:9px 15px;border-radius:10px;background:var(--ink);color:#fff;font-size:14px;font-weight:600;text-decoration:none}
.back-btn:hover{background:var(--ink-2)}
.back-btn .i{width:15px;height:15px;transform:rotate(180deg)}

.container{flex:1;width:min(860px,92%);margin:0 auto;padding:30px 0 64px}

/* HERO */
.hero{background:var(--ink);color:#fff;border-radius:22px;padding:34px 36px;margin-bottom:20px;position:relative;overflow:hidden}
.hero::after{content:"";position:absolute;right:-80px;top:-80px;width:260px;height:260px;border-radius:50%;border:40px solid rgba(242,169,59,.08);pointer-events:none}
.hero > *{position:relative;z-index:1}
.hero h1{font-family:var(--head);font-size:clamp(28px,4vw,40px);line-height:1.1;letter-spacing:-.8px;margin-bottom:10px}
.hero p{color:#b6c3d2;max-width:56ch}
.hero-foot{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px;margin-top:20px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{padding:7px 13px;border-radius:999px;background:rgba(255,255,255,.1);color:#dbe4ee;font-size:13px;font-weight:500}
.chip:empty{display:none}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:11px;padding:11px 18px;font:700 14.5px var(--body);cursor:pointer;transition:transform .2s,box-shadow .2s,background .2s}
.btn:disabled{opacity:.6;cursor:not-allowed}
.btn-amber{background:var(--amber);color:var(--ink)}
.btn-amber:hover:not(:disabled){transform:translateY(-2px);box-shadow:0 10px 24px rgba(242,169,59,.35)}
.btn-dark{background:var(--ink);color:#fff}
.btn-dark:hover:not(:disabled){background:var(--ink-2)}
.btn-ghost{background:#fff;color:var(--ink);border:1px solid var(--line)}
.btn-ghost:hover:not(:disabled){border-color:var(--ink)}
.btn-danger{background:var(--red);color:#fff}
.btn-sm{padding:8px 13px;font-size:13.5px;border-radius:9px}

/* TOOLBAR */
.toolbar{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:18px;display:flex;gap:10px;flex-wrap:wrap}
.search{position:relative;flex:1;min-width:200px}
.search .i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--mute)}
.search input{width:100%;padding:12px 14px 12px 42px;border:1px solid var(--line);border-radius:11px;background:var(--paper);font:500 15px var(--body);color:var(--ink)}
.search input:focus,.field input:focus,.field textarea:focus{outline:none;border-color:var(--brand);background:#fff;box-shadow:0 0 0 3px var(--brand-soft)}

/* FAQ LIST */
.faq-list{display:grid;gap:10px}
.faq{background:var(--card);border:1px solid var(--line);border-radius:16px;transition:border-color .2s}
.faq:hover,.faq[open]{border-color:#c4cfdb}
.faq summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 22px;font-family:var(--head);font-size:18px;font-weight:600;line-height:1.3;letter-spacing:-.2px;border-radius:16px}
.faq summary::-webkit-details-marker{display:none}
.faq summary .i{width:20px;height:20px;color:var(--mute);transition:transform .25s}
.faq[open] summary .i{transform:rotate(180deg)}
.faq-body{padding:0 22px 20px}
.faq-answer{color:#3b4a5d;white-space:pre-wrap;word-break:break-word;max-width:68ch}
.faq-answer a{color:var(--brand);font-weight:600;text-decoration:underline}
.faq-tools{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid #edf1f5}
.faq-meta{margin-right:auto;font-size:12.5px;color:var(--mute)}

/* STATES */
.empty,.error{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:48px 24px;text-align:center;color:var(--mute)}
.empty h3,.error h3{font-family:var(--head);font-size:19px;color:var(--ink);margin-bottom:6px}
.empty .btn,.error .btn{margin-top:16px}
.state-icon{width:54px;height:54px;border-radius:16px;margin:0 auto 14px;display:grid;place-items:center;background:var(--brand-soft);color:var(--brand)}
.state-icon .i{width:26px;height:26px}
.error{border-color:#fecaca}
.error .state-icon{background:#fee2e2;color:#b91c1c}
@keyframes sh{to{background-position:-200% 0}}
.sk{height:62px;border-radius:16px;background:linear-gradient(90deg,#e6ebf1 25%,#f4f7fa 50%,#e6ebf1 75%) 0 0/200% 100%;animation:sh 1.4s linear infinite}

/* DIALOGS */
dialog{border:0;border-radius:20px;padding:0;width:min(560px,calc(100% - 32px));margin:auto;color:var(--ink);box-shadow:0 30px 80px rgba(13,27,42,.35)}
dialog::backdrop{background:rgba(13,27,42,.6)}
.dlg{padding:26px}
.dlg-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.dlg-head h2{font-family:var(--head);font-size:22px;letter-spacing:-.3px}
.x{width:36px;height:36px;border:0;border-radius:10px;background:var(--paper);display:grid;place-items:center;cursor:pointer;color:var(--ink)}
.field{margin-bottom:16px}
.field label{display:block;margin-bottom:6px;font-size:14px;font-weight:600}
.field input,.field textarea{width:100%;border:1px solid var(--line);border-radius:11px;padding:12px 14px;background:var(--paper);font:500 15px var(--body);color:var(--ink)}
.field textarea{min-height:150px;resize:vertical}
.field small{display:block;margin-top:5px;color:var(--mute);font-size:12.5px}
.dlg-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:20px}
.dlg p{color:var(--mute)}

/* TOAST */
.toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);opacity:0;pointer-events:none;z-index:2000;max-width:min(520px,92%);padding:13px 20px;border-radius:13px;background:var(--ink);color:#fff;font-size:14.5px;font-weight:600;transition:all .3s}
.toast.show{opacity:1;transform:translate(-50%,0)}
.toast.err{background:#a8281b}

.footer{padding:26px;background:#fff;border-top:1px solid var(--line);text-align:center;color:var(--mute);font-size:14px}

@media(max-width:600px){
  .container{padding:18px 0 44px}
  .hero{padding:26px 22px}
  .faq summary{padding:16px 18px;font-size:17px}
  .faq-body{padding:0 18px 18px}
  .dlg{padding:20px}
  .dlg-actions .btn{flex:1}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>

