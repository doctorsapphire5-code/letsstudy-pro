<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Course FAQs | LetsStudy Pro</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0
}

body{
  font-family:Inter,Arial,sans-serif;
  background:#f6f8fc;
  color:#101828;
  line-height:1.6
}

.header{
  background:#fff;
  border-bottom:1px solid #eaecf0;
  padding:17px 20px;
  position:sticky;
  top:0;
  z-index:10
}

.header-inner{
  width:min(1100px,100%);
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:space-between
}

.logo{
  color:#155eef;
  font-size:21px;
  font-weight:900
}

.back{
  color:#475467;
  text-decoration:none;
  font-weight:700
}

.container{
  width:min(1000px,100%);
  margin:auto;
  padding:35px 16px 60px
}

.hero{
  margin-bottom:25px
}

.hero h1{
  font-size:32px;
  line-height:1.2;
  margin-bottom:8px
}

.hero p{
  color:#667085
}

.course-id{
  display:inline-block;
  margin-top:12px;
  padding:6px 11px;
  background:#eef4ff;
  color:#155eef;
  border-radius:20px;
  font-size:12px;
  font-weight:800
}

.search-box{
  background:#fff;
  border:1px solid #eaecf0;
  padding:15px;
  border-radius:15px;
  margin-bottom:18px
}

.search{
  width:100%;
  padding:13px 15px;
  border:1px solid #d0d5dd;
  border-radius:10px;
  outline:none;
  font-size:15px
}

.search:focus{
  border-color:#155eef;
  box-shadow:0 0 0 3px #155eef12
}

.faq-list{
  display:grid;
  gap:12px
}

.faq{
  background:#fff;
  border:1px solid #eaecf0;
  border-radius:15px;
  overflow:hidden
}

.faq-question{
  width:100%;
  border:0;
  background:#fff;
  padding:20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  text-align:left;
  cursor:pointer;
  font-size:16px;
  font-weight:850;
  color:#101828
}

.faq-question:hover{
  background:#f9fafb
}

.icon{
  width:30px;
  height:30px;
  min-width:30px;
  border-radius:50%;
  background:#eef4ff;
  color:#155eef;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:20px;
  font-weight:500;
  transition:.2s
}

.faq.open .icon{
  transform:rotate(45deg)
}

.answer{
  display:none;
  padding:0 20px 20px;
  color:#667085;
  border-top:1px solid #f2f4f7;
  white-space:pre-wrap
}

.faq.open .answer{
  display:block;
  padding-top:16px
}

.meta{
  font-size:11px;
  color:#98a2b3;
  margin-top:12px
}

.loading,
.empty,
.error{
  background:#fff;
  border:1px solid #eaecf0;
  border-radius:15px;
  padding:40px 20px;
  text-align:center
}

.loading{
  color:#667085
}

.empty h3{
  margin-bottom:5px
}

.empty p{
  color:#667085
}

.error{
  display:none;
  color:#b42318;
  background:#fef3f2;
  border-color:#fecdca;
  margin-bottom:15px
}

.footer{
  text-align:center;
  color:#98a2b3;
  font-size:13px;
  margin-top:40px
}

@media(max-width:600px){

.hero h1{
  font-size:27px
}

.faq-question{
  padding:17px;
  font-size:15px
}

}
</style>
</head>

<body>

<header class="header">

<div class="header-inner">

<div class="logo">
LetsStudy Pro
</div>

<a
href="javascript:history.back()"
class="back">

← Back

</a>

</div>

</header>


<main class="container">

<section class="hero">

<h1>
Frequently Asked Questions
</h1>

<p>
Find answers to common questions about this course.
</p>

<span
id="courseIdBadge"
class="course-id">

Loading course...

</span>

</section>


<div
id="error"
class="error">
</div>


<div class="search-box">

<input
id="search"
class="search"
type="search"
placeholder="Search questions and answers..."
>

</div>


<section
id="faqList"
class="faq-list">

<div class="loading">
Loading FAQs...
</div>

</section>


<div class="footer">
© LetsStudy Pro • Online Learning Platform
</div>

</main>


<script type="module">

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";

import {
getFirestore,
collection,
getDocs
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-firestore.js";


/* =====================================
FIREBASE CONFIG
===================================== */

const firebaseConfig={

apiKey:
"AIzaSyBcXKAVXKbXkljsyRgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};


const app=
initializeApp(firebaseConfig);

const db=
getFirestore(app);


/* =====================================
COURSE ID
===================================== */

const params=
new URLSearchParams(
location.search
);

const courseId=
params.get("courseId");


document.getElementById(
"courseIdBadge"
).textContent=

courseId
? `Course ID: ${courseId}`
: "All Course FAQs";


/* =====================================
ELEMENTS
===================================== */

const faqList=
document.getElementById(
"faqList"
);

const errorBox=
document.getElementById(
"error"
);

const search=
document.getElementById(
"search"
);


/* =====================================
DATA
===================================== */

let faqs=[];


/* =====================================
LOAD FAQs
===================================== */

async function loadFAQs(){

try{

const snapshot=
await getDocs(
collection(
db,
"courseFAQs"
)
);


faqs=
snapshot.docs
.map(doc=>({

id:doc.id,
...doc.data()

}))
.filter(faq=>{

if(!courseId)
return true;

return String(
faq.courseId||""
).trim() === String(
courseId
).trim();

});


/*
Sort using order field.
*/

faqs.sort((a,b)=>{

const orderA=
Number(a.order ?? 999999);

const orderB=
Number(b.order ?? 999999);

return orderA-orderB;

});


renderFAQs();


}catch(error){

console.error(error);

errorBox.textContent=
"Failed to load FAQs: "+
error.message;

errorBox.style.display=
"block";

faqList.innerHTML="";

}

}


/* =====================================
RENDER
===================================== */

function renderFAQs(){

const term=
search.value
.toLowerCase()
.trim();


const filtered=
faqs.filter(faq=>{

const question=
String(
faq.question||""
).toLowerCase();

const answer=
String(
faq.answer||""
).toLowerCase();

return(
!term||
question.includes(term)||
answer.includes(term)
);

});


if(!filtered.length){

faqList.innerHTML=`

<div class="empty">

<h3>
No FAQs found
</h3>

<p>
There are no frequently asked questions matching your search.
</p>

</div>

`;

return;

}


faqList.innerHTML=
filtered
.map((faq,index)=>`

<article class="faq">

<button
class="faq-question"
type="button"
onclick="toggleFAQ('${faq.id}')">

<span>
${escapeHTML(
faq.question ||
"Untitled Question"
)}
</span>

<span class="icon">
+
</span>

</button>


<div
id="answer-${faq.id}"
class="answer">

${escapeHTML(
faq.answer ||
"No answer available."
)}


<div class="meta">

FAQ #${index+1}

</div>

</div>

</article>

`)
.join("");

}


/* =====================================
TOGGLE FAQ
===================================== */

window.toggleFAQ=function(id){

const answer=
document.getElementById(
"answer-"+id
);

if(!answer)
return;

const faq=
answer.closest(".faq");

faq.classList.toggle("open");

};


/* =====================================
SEARCH
===================================== */

search.addEventListener(
"input",
renderFAQs
);


/* =====================================
ESCAPE HTML
===================================== */

function escapeHTML(value){

return String(
value ?? ""
)

.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}


/* =====================================
START
===================================== */

loadFAQs();

</script>

</body>
</html>