<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Course FAQs | Let'sStudy Pro</title>

<style>
*{box-sizing:border-box}

body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f6f8fc;
  color:#172033;
}

.container{
  max-width:850px;
  margin:auto;
  padding:20px;
}

.header{
  margin-bottom:20px;
}

.header h1{
  margin:0;
  font-size:26px;
}

.header p{
  color:#64748b;
  font-size:14px;
}

.faq{
  background:#fff;
  border-radius:14px;
  margin-bottom:12px;
  box-shadow:0 3px 14px rgba(0,0,0,.06);
  overflow:hidden;
}

.question{
  width:100%;
  padding:18px;
  border:0;
  background:#fff;
  text-align:left;
  font-size:15px;
  font-weight:bold;
  cursor:pointer;
  display:flex;
  justify-content:space-between;
  gap:15px;
  color:#172033;
}

.question i{
  transition:.25s;
}

.answer{
  display:none;
  padding:0 18px 18px;
  color:#64748b;
  line-height:1.7;
  font-size:14px;
}

.faq.open .answer{
  display:block;
}

.faq.open .question i{
  transform:rotate(180deg);
}

.empty{
  text-align:center;
  padding:45px 20px;
  color:#64748b;
}

.loading{
  text-align:center;
  padding:45px;
  color:#64748b;
}

@media(max-width:600px){
  .container{
    padding:15px;
  }

  .header h1{
    font-size:22px;
  }
}
</style>
</head>

<body>

<div class="container">

<div class="header">

<h1>
Course FAQs
</h1>

<p>
Frequently asked questions about this course
</p>

</div>

<div id="faqList">

<div class="loading">
Loading FAQs...
</div>

</div>

</div>


<script type="module">

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.7.0/firebase-app.js";

import {
getFirestore,
collection,
getDocs
}
from
"https://www.gstatic.com/firebasejs/12.7.0/firebase-firestore.js";


const firebaseConfig = {

apiKey:
"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};


const app =
initializeApp(firebaseConfig);

const db =
getFirestore(app);

const faqList =
document.getElementById("faqList");


/* =====================================
   GET COURSE ID AUTOMATICALLY
===================================== */

const params =
new URLSearchParams(
window.location.search
);

const courseId =
params.get("courseId");


/* =====================================
   ESCAPE HTML
===================================== */

function escapeHTML(value){

return String(value ?? "")
.replaceAll("&","&amp;")
.replaceAll("<","&lt;")
.replaceAll(">","&gt;")
.replaceAll('"',"&quot;")
.replaceAll("'","&#039;");

}


/* =====================================
   LOAD FAQs
===================================== */

async function loadFAQs(){

if(!courseId){

faqList.innerHTML = `

<div class="empty">

No course selected.

</div>

`;

return;

}


try{

const snapshot =
await getDocs(
collection(
db,
"courseFAQs"
)
);


let faqs =
snapshot.docs
.map(doc => ({
id:doc.id,
...doc.data()
}))
.filter(
faq =>
faq.courseId === courseId
);


faqs.sort(
(a,b)=>
Number(a.order || 0) -
Number(b.order || 0)
);


if(!faqs.length){

faqList.innerHTML = `

<div class="empty">

No FAQs available for this course yet.

</div>

`;

return;

}


faqList.innerHTML =
faqs.map(
faq => `

<div class="faq">

<button
class="question">

<span>
${escapeHTML(
faq.question
)}
</span>

<i>⌄</i>

</button>

<div class="answer">

${escapeHTML(
faq.answer
)}

</div>

</div>

`
).join("");


document
.querySelectorAll(".question")
.forEach(button => {

button.addEventListener(
"click",
() => {

const faq =
button.parentElement;

faq.classList.toggle(
"open"
);

}
);

});


}
catch(error){

console.error(error);

faqList.innerHTML = `

<div class="empty">

Unable to load course FAQs.

</div>

`;

}

}


loadFAQs();

</script>

</body>
</html>