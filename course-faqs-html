<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Course FAQs | LetsStudy Pro</title>

<meta name="description"
content="Find answers to frequently asked questions about this course on LetsStudy Pro.">

<link rel="icon" href="favicon.ico">

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Inter,Arial,sans-serif;
  background:#f6f8fc;
  color:#172033;
}

header{
  background:#fff;
  border-bottom:1px solid #e8ebf2;
  position:sticky;
  top:0;
  z-index:50;
}

.header-inner{
  max-width:1150px;
  margin:auto;
  padding:17px 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.logo{
  text-decoration:none;
  font-size:21px;
  font-weight:900;
  color:#111827;
}

.logo span{
  color:#2563eb;
}

.back{
  color:#2563eb;
  text-decoration:none;
  font-weight:700;
}

.container{
  max-width:900px;
  margin:45px auto;
  padding:0 20px;
}

.hero{
  background:linear-gradient(135deg,#eff6ff,#ffffff);
  border:1px solid #dbe7ff;
  border-radius:22px;
  padding:35px;
  margin-bottom:28px;
}

.badge{
  display:inline-block;
  background:#e0ecff;
  color:#1d4ed8;
  font-size:12px;
  font-weight:800;
  padding:7px 11px;
  border-radius:999px;
  margin-bottom:15px;
}

h1{
  font-size:34px;
  line-height:1.2;
  margin:0 0 12px;
}

.course-description{
  color:#667085;
  line-height:1.7;
  margin:0;
}

.card{
  background:#fff;
  border:1px solid #e6eaf0;
  border-radius:18px;
  overflow:hidden;
  box-shadow:0 8px 30px rgba(15,23,42,.05);
}

.card-title{
  padding:24px 25px 10px;
}

.card-title h2{
  margin:0;
  font-size:21px;
}

.faq{
  border-top:1px solid #edf0f5;
}

.question{
  width:100%;
  border:0;
  background:#fff;
  padding:20px 25px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  text-align:left;
  cursor:pointer;
  font-size:16px;
  font-weight:800;
  color:#172033;
}

.question:hover{
  background:#f8fafc;
}

.icon{
  width:30px;
  height:30px;
  min-width:30px;
  border-radius:50%;
  background:#eef4ff;
  color:#2563eb;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:20px;
  transition:.2s;
}

.faq.open .icon{
  transform:rotate(45deg);
}

.answer{
  max-height:0;
  overflow:hidden;
  transition:max-height .25s ease;
}

.answer-inner{
  padding:0 25px 22px;
  color:#667085;
  line-height:1.7;
  font-size:14px;
}

.loading,
.empty,
.error{
  background:#fff;
  border:1px solid #e6eaf0;
  border-radius:18px;
  padding:40px;
  text-align:center;
}

.error{
  color:#b42318;
  background:#fff7f7;
  border-color:#ffd6d6;
}

.hidden{
  display:none!important;
}

footer{
  margin-top:50px;
  padding:30px 20px;
  text-align:center;
  color:#667085;
  font-size:13px;
}

@media(max-width:650px){

  .container{
    margin:25px auto;
  }

  .hero{
    padding:25px 20px;
    border-radius:17px;
  }

  h1{
    font-size:28px;
  }

  .question{
    padding:18px 18px;
  }

  .answer-inner{
    padding:0 18px 20px;
  }
}
</style>
</head>

<body>

<header>
  <div class="header-inner">

    <a href="index.html" class="logo">
      LetsStudy <span>Pro</span>
    </a>

    <a href="#" id="backLink" class="back">
      ← Course
    </a>

  </div>
</header>


<main class="container">

  <section id="loading" class="loading">
    Loading course FAQs...
  </section>


  <section id="errorBox" class="error hidden"></section>


  <section id="content" class="hidden">

    <div class="hero">

      <div class="badge">
        COURSE FAQs
      </div>

      <h1 id="courseTitle">
        Course FAQs
      </h1>

      <p id="courseDescription"
         class="course-description">
      </p>

    </div>


    <div class="card">

      <div class="card-title">
        <h2>Frequently Asked Questions</h2>
      </div>

      <div id="faqList"></div>

    </div>

  </section>


  <section id="empty" class="empty hidden">

    <h2>No FAQs available</h2>

    <p>
      Frequently asked questions for this course
      have not been added yet.
    </p>

  </section>

</main>


<footer>
  © <span id="year"></span> LetsStudy Pro. All rights reserved.
</footer>


<script type="module">

import {
  initializeApp
}
from "https://www.gstatic.com/firebasejs/10.12.5/firebase-app.js";

import {
  getFirestore,
  doc,
  getDoc
}
from "https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore.js";


/* =====================================================
   FIREBASE
===================================================== */

const firebaseConfig = {
  apiKey: "AIzaSyBcOYDfAVK5XbkljsyRgI_0rj0odBn678tCc",
  authDomain: "let-s-study-pro-course.firebaseapp.com",
  databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
  projectId: "let-s-study-pro-course",
  storageBucket: "let-s-study-pro-course.firebasestorage.app",
  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
};

const app = initializeApp(firebaseConfig);
const db = getFirestore(app);


/* =====================================================
   ELEMENTS
===================================================== */

const loading =
  document.getElementById("loading");

const errorBox =
  document.getElementById("errorBox");

const content =
  document.getElementById("content");

const empty =
  document.getElementById("empty");

const courseTitle =
  document.getElementById("courseTitle");

const courseDescription =
  document.getElementById("courseDescription");

const faqList =
  document.getElementById("faqList");

const backLink =
  document.getElementById("backLink");

document.getElementById("year")
  .textContent = new Date().getFullYear();


/* =====================================================
   COURSE ID
===================================================== */

const params =
  new URLSearchParams(window.location.search);

const courseId =
  params.get("id");


/* =====================================================
   HELPERS
===================================================== */

function first(obj, fields, fallback=""){

  for(const field of fields){

    if(
      obj &&
      obj[field] !== undefined &&
      obj[field] !== null &&
      String(obj[field]).trim() !== ""
    ){
      return obj[field];
    }

  }

  return fallback;
}


function escapeHTML(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}


/* =====================================================
   NORMALIZE FAQ DATA
===================================================== */

function normalizeFAQs(course){

  /*
    Supported Firebase structures:

    faqs: [
      {
        question: "...",
        answer: "..."
      }
    ]

    faq: [
      ...
    ]

    frequentlyAskedQuestions: [
      ...
    ]
  */

  let source = first(
    course,
    [
      "faqs",
      "faq",
      "frequentlyAskedQuestions",
      "frequentlyAskedQuestionsAndAnswers"
    ],
    []
  );

  if(!Array.isArray(source)){
    return [];
  }

  return source
    .map(item => {

      if(typeof item === "string"){

        return {
          question:item,
          answer:""
        };

      }

      return {
        question:first(
          item,
          [
            "question",
            "q",
            "title"
          ],
          ""
        ),

        answer:first(
          item,
          [
            "answer",
            "a",
            "description",
            "content"
          ],
          ""
        )
      };

    })
    .filter(
      item => item.question
    );

}


/* =====================================================
   DEFAULT FAQs
===================================================== */

function defaultFAQs(course){

  const title =
    first(
      course,
      ["title","name","courseTitle"],
      "this course"
    );

  return [

    {
      question:"What will I learn in this course?",
      answer:
        `This course is designed to help you learn the main concepts, skills and practical knowledge covered by ${title}.`
    },

    {
      question:"How do I access the course?",
      answer:
        "After enrolling or completing the required purchase process, you can access the course through the course learning page."
    },

    {
      question:"Is this course free?",
      answer:
        "Course access depends on the access type configured by the course provider. Check the course details page for the current access information."
    },

    {
      question:"Can I learn at my own pace?",
      answer:
        "Yes. You can normally study the available lessons according to your own learning schedule."
    },

    {
      question:"Where can I find the course lessons?",
      answer:
        "Once you have the required access, open the course learning area to view the available modules and lessons."
    },

    {
      question:"Will I receive a certificate?",
      answer:
        "Certificate availability depends on the course completion and certificate settings configured for the course."
    }

  ];

}


/* =====================================================
   RENDER FAQs
===================================================== */

function renderFAQs(faqs){

  faqList.innerHTML = "";

  faqs.forEach(
    (faq,index) => {

      const wrapper =
        document.createElement("div");

      wrapper.className = "faq";

      wrapper.innerHTML = `

        <button
          class="question"
          type="button"
          aria-expanded="false">

          <span>
            ${escapeHTML(faq.question)}
          </span>

          <span class="icon">
            +
          </span>

        </button>

        <div class="answer">

          <div class="answer-inner">
            ${
              faq.answer
                ? escapeHTML(faq.answer)
                : "More information will be provided by the course provider."
            }
          </div>

        </div>

      `;

      const question =
        wrapper.querySelector(".question");

      const answer =
        wrapper.querySelector(".answer");

      question.addEventListener(
        "click",
        () => {

          const isOpen =
            wrapper.classList.contains("open");

          document
            .querySelectorAll(".faq.open")
            .forEach(item => {

              item.classList.remove("open");

              const btn =
                item.querySelector(".question");

              const panel =
                item.querySelector(".answer");

              btn.setAttribute(
                "aria-expanded",
                "false"
              );

              panel.style.maxHeight = null;

            });


          if(!isOpen){

            wrapper.classList.add("open");

            question.setAttribute(
              "aria-expanded",
              "true"
            );

            answer.style.maxHeight =
              answer.scrollHeight + "px";

          }

        }
      );

      faqList.appendChild(wrapper);

    }
  );

}


/* =====================================================
   LOAD COURSE
===================================================== */

async function loadCourse(){

  if(!courseId){

    loading.classList.add("hidden");

    errorBox.textContent =
      "Course information could not be identified.";

    errorBox.classList.remove("hidden");

    return;
  }


  /*
    Firebase document ID is used internally.

    courses/{COURSE_ID}
  */

  try{

    const courseRef =
      doc(
        db,
        "courses",
        courseId
      );

    const snapshot =
      await getDoc(courseRef);


    if(!snapshot.exists()){

      loading.classList.add("hidden");

      errorBox.textContent =
        "This course could not be found.";

      errorBox.classList.remove("hidden");

      return;
    }


    const course =
      snapshot.data();


    const title =
      first(
        course,
        [
          "title",
          "name",
          "courseTitle"
        ],
        "Course FAQs"
      );


    const description =
      first(
        course,
        [
          "description",
          "shortDescription",
          "summary"
        ],
        "Find answers to frequently asked questions about this course."
      );


    courseTitle.textContent =
      title;

    courseDescription.textContent =
      description;


    document.title =
      `${title} FAQs | LetsStudy Pro`;


    backLink.href =
      `course-details.html?id=${encodeURIComponent(courseId)}`;


    let faqs =
      normalizeFAQs(course);


    /*
      If admin has not added FAQs,
      show useful default questions.
    */

    if(faqs.length === 0){

      faqs =
        defaultFAQs(course);

    }


    renderFAQs(faqs);


    loading.classList.add("hidden");

    content.classList.remove("hidden");


  }catch(error){

    console.error(
      "Course FAQ error:",
      error
    );

    loading.classList.add("hidden");

    errorBox.textContent =
      "Unable to load this course. Please try again.";

    errorBox.classList.remove("hidden");

  }

}


/* =====================================================
   START
===================================================== */

loadCourse();

</script>

</body>
</html>
