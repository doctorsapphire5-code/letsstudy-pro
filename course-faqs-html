<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Course FAQs | LetsStudy Pro</title>

<meta
  name="description"
  content="Frequently asked questions about this course on LetsStudy Pro."
>

<link rel="icon" href="/favicon.ico">

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
>

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:
    Inter,
    Arial,
    sans-serif;
  background:#f5f7fb;
  color:#172033;
  line-height:1.6;
}

header{
  position:sticky;
  top:0;
  z-index:50;
  background:#fff;
  border-bottom:1px solid #e5e7eb;
}

.nav{
  width:92%;
  max-width:1150px;
  min-height:68px;
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  color:#172033;
  text-decoration:none;
  font-size:22px;
  font-weight:800;
}

.logo span{
  color:#2563eb;
}

.back-btn{
  display:inline-flex;
  align-items:center;
  gap:8px;
  text-decoration:none;
  background:#2563eb;
  color:#fff;
  padding:10px 15px;
  border-radius:9px;
  font-size:14px;
  font-weight:700;
}

.hero{
  padding:55px 20px;
  background:
    linear-gradient(
      135deg,
      #eff6ff,
      #ffffff
    );
  border-bottom:1px solid #e5e7eb;
}

.hero-inner{
  width:92%;
  max-width:900px;
  margin:auto;
}

.eyebrow{
  color:#2563eb;
  font-size:13px;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.08em;
  margin-bottom:8px;
}

.hero h1{
  font-size:38px;
  line-height:1.15;
  margin-bottom:12px;
}

.hero p{
  color:#64748b;
  max-width:700px;
}

.container{
  width:92%;
  max-width:900px;
  margin:30px auto 70px;
}

.course-box{
  display:none;
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:15px;
  padding:20px;
  margin-bottom:24px;
}

.course-box.show{
  display:block;
}

.course-title{
  font-size:23px;
  font-weight:800;
}

.course-description{
  color:#64748b;
  margin-top:6px;
}

.search-box{
  position:relative;
  margin-bottom:20px;
}

.search-box i{
  position:absolute;
  left:15px;
  top:50%;
  transform:translateY(-50%);
  color:#94a3b8;
}

.search-box input{
  width:100%;
  border:1px solid #dbe1ea;
  border-radius:10px;
  padding:13px 15px 13px 43px;
  outline:none;
  font-size:14px;
  background:#fff;
}

.search-box input:focus{
  border-color:#2563eb;
}

.count{
  color:#64748b;
  font-size:14px;
  margin-bottom:12px;
}

.faq-list{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.faq{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:13px;
  overflow:hidden;
}

.faq-question{
  width:100%;
  border:0;
  background:#fff;
  padding:18px 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  text-align:left;
  cursor:pointer;
  color:#172033;
  font-size:16px;
  font-weight:750;
}

.faq-question:hover{
  background:#f8fafc;
}

.faq-question i{
  color:#2563eb;
  transition:.2s;
  flex-shrink:0;
}

.faq.open .faq-question i{
  transform:rotate(180deg);
}

.faq-answer{
  display:none;
  padding:0 20px 19px;
  color:#64748b;
  font-size:14px;
}

.faq.open .faq-answer{
  display:block;
}

.loading,
.empty,
.error{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:15px;
  padding:55px 20px;
  text-align:center;
  color:#64748b;
}

.loading i,
.empty i,
.error i{
  font-size:30px;
  margin-bottom:12px;
}

.empty h3,
.error h3{
  color:#172033;
  margin-bottom:5px;
}

.retry-btn{
  margin-top:15px;
  border:0;
  background:#2563eb;
  color:#fff;
  padding:10px 16px;
  border-radius:9px;
  cursor:pointer;
  font-weight:700;
}

footer{
  background:#fff;
  border-top:1px solid #e5e7eb;
  padding:25px 20px;
  text-align:center;
  color:#64748b;
  font-size:13px;
}

@media(max-width:650px){

  .hero{
    padding:40px 15px;
  }

  .hero h1{
    font-size:29px;
  }

  .container{
    width:94%;
  }

  .faq-question{
    padding:16px;
    font-size:15px;
  }

  .faq-answer{
    padding:0 16px 17px;
  }

}

</style>

</head>

<body>


<header>

  <nav class="nav">

    <a
      href="/"
      class="logo"
    >
      LetsStudy <span>Pro</span>
    </a>

    <a
      href="/courses.html"
      class="back-btn"
    >
      <i class="fa-solid fa-arrow-left"></i>
      Courses
    </a>

  </nav>

</header>


<section class="hero">

  <div class="hero-inner">

    <div class="eyebrow">
      Course Support
    </div>

    <h1>
      Frequently Asked Questions
    </h1>

    <p>
      Find answers to common questions
      about this course.
    </p>

  </div>

</section>


<main class="container">


  <section
    id="courseBox"
    class="course-box"
  >

    <div
      id="courseTitle"
      class="course-title"
    ></div>

    <div
      id="courseDescription"
      class="course-description"
    ></div>

  </section>


  <div class="search-box">

    <i class="fa-solid fa-magnifying-glass"></i>

    <input
      id="searchInput"
      type="search"
      placeholder="Search questions..."
      autocomplete="off"
    >

  </div>


  <div
    id="count"
    class="count"
  >
    Loading...
  </div>


  <section
    id="faqList"
    class="faq-list"
  >

    <div class="loading">

      <i class="
        fa-solid
        fa-spinner
        fa-spin
      "></i>

      <p>
        Loading FAQs...
      </p>

    </div>

  </section>


</main>


<footer>

  ©
  <span id="year"></span>
  LetsStudy Pro. All rights reserved.

</footer>


<script>

"use strict";


/* ================= CONFIG ================= */

const API_BASE = "/api/data";


/* ================= PARAMS ================= */

const params =
  new URLSearchParams(
    window.location.search
  );

const courseId =
  params.get("courseId") ||
  params.get("id");


/* ================= STATE ================= */

let allFAQs = [];


/* ================= DOM ================= */

const faqList =
  document.getElementById(
    "faqList"
  );

const searchInput =
  document.getElementById(
    "searchInput"
  );

const count =
  document.getElementById(
    "count"
  );

const courseBox =
  document.getElementById(
    "courseBox"
  );

const courseTitle =
  document.getElementById(
    "courseTitle"
  );

const courseDescription =
  document.getElementById(
    "courseDescription"
  );


document.getElementById(
  "year"
).textContent =
  new Date().getFullYear();


/* ================= ESCAPE ================= */

function escapeHTML(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


/* ================= LOAD COURSE ================= */

async function loadCourse(){

  if(!courseId){
    return;
  }

  try{

    const response =
      await fetch(
        `${API_BASE}?collection=courses&id=${encodeURIComponent(courseId)}`,
        {
          headers:{
            "Accept":"application/json"
          }
        }
      );


    if(!response.ok){
      return;
    }


    const result =
      await response.json();


    if(
      !result.success ||
      !result.data
    ){
      return;
    }


    const course =
      result.data;


    courseTitle.textContent =
      course.title ||
      course.name ||
      "Course";


    courseDescription.textContent =
      course.description ||
      course.shortDescription ||
      "";


    courseBox.classList.add(
      "show"
    );


  }catch(error){

    console.error(
      "COURSE ERROR:",
      error
    );

  }

}


/* ================= LOAD FAQS ================= */

async function loadFAQs(){

  faqList.innerHTML = `

    <div class="loading">

      <i class="
        fa-solid
        fa-spinner
        fa-spin
      "></i>

      <p>
        Loading FAQs...
      </p>

    </div>

  `;


  if(!courseId){

    showEmpty(
      "Course ID is missing."
    );

    return;

  }


  try{

    const response =
      await fetch(
        `${API_BASE}?collection=courseFaqs&courseId=${encodeURIComponent(courseId)}&limit=100`,
        {
          headers:{
            "Accept":"application/json"
          }
        }
      );


    if(!response.ok){

      throw new Error(
        `HTTP ${response.status}`
      );

    }


    const result =
      await response.json();


    if(!result.success){

      throw new Error(
        result.error ||
        "Unable to load FAQs"
      );

    }


    allFAQs =
      Array.isArray(result.results)
        ? result.results
        : [];


    /*
      Support different possible
      Firestore field names.
    */

    allFAQs =
      allFAQs.filter(faq => {

        const owner =
          faq.courseId ||
          faq.courseID ||
          faq.parentCourseId ||
          faq.course;


        if(!owner){
          return true;
        }


        return String(owner) ===
          String(courseId);

      });


    sortFAQs();

    renderFAQs();


  }catch(error){

    console.error(
      "FAQ API ERROR:",
      error
    );


    faqList.innerHTML = `

      <div class="error">

        <i class="
          fa-solid
          fa-triangle-exclamation
        "></i>

        <h3>
          Unable to load FAQs
        </h3>

        <p>
          Please try again.
        </p>

        <button
          class="retry-btn"
          onclick="loadFAQs()"
        >
          Try Again
        </button>

      </div>

    `;

    count.textContent =
      "Error";

  }

}


/* ================= SORT ================= */

function sortFAQs(){

  allFAQs.sort(
    (a,b) => {

      const orderA =
        Number(
          a.order ??
          a.position ??
          a.sortOrder ??
          a.faqNumber ??
          9999
        );


      const orderB =
        Number(
          b.order ??
          b.position ??
          b.sortOrder ??
          b.faqNumber ??
          9999
        );


      return orderA - orderB;

    }
  );

}


/* ================= RENDER ================= */

function renderFAQs(){

  const keyword =
    searchInput.value
      .trim()
      .toLowerCase();


  const filtered =
    allFAQs.filter(faq => {

      const question =
        faq.question ||
        faq.title ||
        faq.name ||
        "";


      const answer =
        faq.answer ||
        faq.description ||
        faq.content ||
        faq.response ||
        "";


      const text =
        `${question} ${answer}`
          .toLowerCase();


      return text.includes(
        keyword
      );

    });


  count.textContent =
    `${filtered.length} question${
      filtered.length === 1
        ? ""
        : "s"
    }`;


  if(!filtered.length){

    showEmpty(
      keyword
        ? "No questions match your search."
        : "No FAQs are available for this course yet."
    );

    return;

  }


  faqList.innerHTML =
    filtered
      .map(
        createFAQ
      )
      .join("");


  bindFAQEvents();

}


/* ================= FAQ CARD ================= */

function createFAQ(faq,index){

  const question =
    faq.question ||
    faq.title ||
    faq.name ||
    `Question ${index + 1}`;


  const answer =
    faq.answer ||
    faq.description ||
    faq.content ||
    faq.response ||
    "No answer available.";


  return `

    <article class="faq">

      <button
        type="button"
        class="faq-question"
        aria-expanded="false"
      >

        <span>
          ${escapeHTML(question)}
        </span>

        <i class="
          fa-solid
          fa-chevron-down
        "></i>

      </button>


      <div class="faq-answer">

        ${escapeHTML(answer)}

      </div>

    </article>

  `;

}


/* ================= ACCORDION ================= */

function bindFAQEvents(){

  const buttons =
    faqList.querySelectorAll(
      ".faq-question"
    );


  buttons.forEach(
    button => {

      button.addEventListener(
        "click",
        () => {

          const faq =
            button.closest(
              ".faq"
            );


          const isOpen =
            faq.classList.contains(
              "open"
            );


          /*
            Close all other FAQs
          */

          faqList
            .querySelectorAll(
              ".faq.open"
            )
            .forEach(
              item => {

                item.classList.remove(
                  "open"
                );

                const btn =
                  item.querySelector(
                    ".faq-question"
                  );

                if(btn){

                  btn.setAttribute(
                    "aria-expanded",
                    "false"
                  );

                }

              }
            );


          if(!isOpen){

            faq.classList.add(
              "open"
            );

            button.setAttribute(
              "aria-expanded",
              "true"
            );

          }

        }
      );

    }
  );

}


/* ================= EMPTY ================= */

function showEmpty(message){

  faqList.innerHTML = `

    <div class="empty">

      <i class="
        fa-solid
        fa-circle-question
      "></i>

      <h3>
        No FAQs
      </h3>

      <p>
        ${escapeHTML(message)}
      </p>

    </div>

  `;

  count.textContent =
    "0 questions";

}


/* ================= SEARCH ================= */

searchInput.addEventListener(
  "input",
  renderFAQs
);


/* ================= START ================= */

loadCourse();

loadFAQs();

</script>

</body>
</html>