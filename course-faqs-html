<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Course FAQs | LetsStudy Pro</title>

  <style>
    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
    }

    body{
      font-family:Arial,Helvetica,sans-serif;
      background:#f5f7fb;
      color:#111827;
    }

    .header{
      background:#111827;
      color:#fff;
      padding:18px 25px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      position:sticky;
      top:0;
      z-index:100;
    }

    .brand{
      font-size:20px;
      font-weight:700;
    }

    .course-id{
      font-size:13px;
      color:#d1d5db;
    }

    .container{
      max-width:1100px;
      margin:30px auto;
      padding:0 20px;
    }

    .top{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:15px;
      margin-bottom:25px;
      flex-wrap:wrap;
    }

    h1{
      font-size:28px;
      margin-bottom:6px;
    }

    .subtitle{
      color:#6b7280;
      font-size:14px;
    }

    button{
      border:none;
      cursor:pointer;
      font-weight:600;
      border-radius:8px;
      padding:11px 17px;
    }

    .btn-primary{
      background:#2563eb;
      color:white;
    }

    .btn-primary:hover{
      background:#1d4ed8;
    }

    .btn-secondary{
      background:#e5e7eb;
      color:#111827;
    }

    .btn-danger{
      background:#dc2626;
      color:#fff;
    }

    .btn-edit{
      background:#f59e0b;
      color:#fff;
    }

    .faq-list{
      display:flex;
      flex-direction:column;
      gap:15px;
    }

    .faq-card{
      background:#fff;
      border:1px solid #e5e7eb;
      border-radius:12px;
      padding:20px;
      box-shadow:0 2px 8px rgba(0,0,0,.04);
    }

    .faq-head{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:15px;
    }

    .faq-number{
      width:34px;
      height:34px;
      border-radius:50%;
      background:#eff6ff;
      color:#2563eb;
      display:flex;
      align-items:center;
      justify-content:center;
      font-weight:700;
      flex-shrink:0;
    }

    .faq-question{
      font-size:17px;
      font-weight:700;
      flex:1;
    }

    .faq-answer{
      margin:15px 0 0 49px;
      color:#4b5563;
      line-height:1.7;
      white-space:pre-wrap;
    }

    .faq-meta{
      margin:15px 0 0 49px;
      color:#9ca3af;
      font-size:12px;
    }

    .actions{
      display:flex;
      gap:8px;
      margin-top:15px;
      margin-left:49px;
      flex-wrap:wrap;
    }

    .actions button{
      padding:8px 12px;
      font-size:13px;
    }

    .empty{
      background:#fff;
      border:1px dashed #d1d5db;
      border-radius:12px;
      padding:50px 20px;
      text-align:center;
      color:#6b7280;
    }

    .loading{
      text-align:center;
      padding:50px;
      color:#6b7280;
    }

    .modal{
      display:none;
      position:fixed;
      inset:0;
      background:rgba(0,0,0,.55);
      z-index:1000;
      align-items:center;
      justify-content:center;
      padding:20px;
    }

    .modal.show{
      display:flex;
    }

    .modal-box{
      background:#fff;
      width:100%;
      max-width:600px;
      border-radius:14px;
      padding:25px;
      max-height:90vh;
      overflow-y:auto;
    }

    .modal-header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:20px;
    }

    .modal-header h2{
      font-size:21px;
    }

    .close{
      background:#f3f4f6;
      width:35px;
      height:35px;
      padding:0;
      font-size:20px;
    }

    .form-group{
      margin-bottom:18px;
    }

    label{
      display:block;
      margin-bottom:7px;
      font-size:14px;
      font-weight:600;
      color:#374151;
    }

    input,
    textarea{
      width:100%;
      border:1px solid #d1d5db;
      border-radius:8px;
      padding:12px;
      font-size:14px;
      outline:none;
    }

    input:focus,
    textarea:focus{
      border-color:#2563eb;
      box-shadow:0 0 0 3px rgba(37,99,235,.1);
    }

    textarea{
      min-height:150px;
      resize:vertical;
    }

    .modal-actions{
      display:flex;
      justify-content:flex-end;
      gap:10px;
      margin-top:20px;
    }

    .status{
      display:none;
      padding:12px;
      border-radius:8px;
      margin-bottom:15px;
      font-size:14px;
    }

    .success{
      background:#dcfce7;
      color:#166534;
    }

    .error{
      background:#fee2e2;
      color:#991b1b;
    }

    @media(max-width:700px){

      .header{
        padding:15px;
      }

      .container{
        margin:20px auto;
        padding:0 14px;
      }

      h1{
        font-size:23px;
      }

      .faq-head{
        align-items:flex-start;
      }

      .faq-question{
        font-size:15px;
      }

      .faq-answer,
      .faq-meta,
      .actions{
        margin-left:0;
      }

      .faq-answer{
        margin-top:14px;
      }

      .actions{
        margin-top:15px;
      }

      .modal-box{
        padding:20px;
      }
    }
  </style>
</head>

<body>

<header class="header">
  <div class="brand">LetsStudy Pro</div>
  <div class="course-id" id="courseIdDisplay">
    Course FAQ
  </div>
</header>

<main class="container">

  <div class="top">

    <div>
      <h1>Course FAQs</h1>

      <div class="subtitle">
        Manage frequently asked questions for this course.
      </div>
    </div>

    <button
      class="btn-primary"
      id="addFaqBtn"
    >
      + Add FAQ
    </button>

  </div>

  <div
    id="successMessage"
    class="status success"
  ></div>

  <div
    id="errorMessage"
    class="status error"
  ></div>

  <div
    id="loading"
    class="loading"
  >
    Loading FAQs...
  </div>

  <div
    id="faqList"
    class="faq-list"
    style="display:none;"
  ></div>

  <div
    id="empty"
    class="empty"
    style="display:none;"
  >
    <h3>No FAQs yet</h3>

    <p style="margin-top:8px;">
      Add the first frequently asked question for this course.
    </p>

    <button
      class="btn-primary"
      style="margin-top:18px;"
      onclick="openAddModal()"
    >
      + Add First FAQ
    </button>
  </div>

</main>


<!-- FAQ MODAL -->

<div
  class="modal"
  id="faqModal"
>

  <div class="modal-box">

    <div class="modal-header">

      <h2 id="modalTitle">
        Add Course FAQ
      </h2>

      <button
        class="close"
        id="closeModal"
      >
        ×
      </button>

    </div>

    <form id="faqForm">

      <div class="form-group">

        <label>
          Question *
        </label>

        <input
          type="text"
          id="question"
          placeholder="Example: How long do I have access to this course?"
          required
        >

      </div>


      <div class="form-group">

        <label>
          Answer *
        </label>

        <textarea
          id="answer"
          placeholder="Write the answer..."
          required
        ></textarea>

      </div>


      <div class="form-group">

        <label>
          Order
        </label>

        <input
          type="number"
          id="order"
          min="0"
          value="0"
        >

      </div>


      <div class="modal-actions">

        <button
          type="button"
          class="btn-secondary"
          id="cancelBtn"
        >
          Cancel
        </button>

        <button
          type="submit"
          class="btn-primary"
          id="saveBtn"
        >
          Save FAQ
        </button>

      </div>

    </form>

  </div>

</div>


<script type="module">

  import {
    initializeApp
  } from
  "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";


  import {
    getFirestore,
    collection,
    addDoc,
    getDocs,
    getDoc,
    doc,
    updateDoc,
    deleteDoc,
    serverTimestamp
  } from
  "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";


  /*
  =====================================================
  FIREBASE
  =====================================================
  */

  const firebaseConfig = {

    apiKey:
      "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

    authDomain:
      "let-s-study-pro-course.firebaseapp.com",

    databaseURL:
      "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

    projectId:
      "let-s-study-pro-course",

    storageBucket:
      "let-s-study-pro-course.firebasestorage.app",

    messagingSenderId:
      "474928293390",

    appId:
      "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

    measurementId:
      "G-85B7V5H5J0"

  };


  const app =
    initializeApp(firebaseConfig);

  const db =
    getFirestore(app);


  /*
  =====================================================
  COURSE ID
  =====================================================
  */

  const params =
    new URLSearchParams(
      window.location.search
    );

  const courseId =
    params.get("courseId") ||
    params.get("id");


  if(!courseId){

    document.getElementById("loading").style.display =
      "none";

    document.getElementById("errorMessage").textContent =
      "Course ID is missing. Open this page using ?courseId=COURSE_ID";

    document.getElementById("errorMessage").style.display =
      "block";

  }


  document.getElementById(
    "courseIdDisplay"
  ).textContent =
    courseId
      ? "Course: " + courseId
      : "Course FAQ";


  /*
  =====================================================
  ELEMENTS
  =====================================================
  */

  const faqList =
    document.getElementById("faqList");

  const loading =
    document.getElementById("loading");

  const empty =
    document.getElementById("empty");

  const modal =
    document.getElementById("faqModal");

  const faqForm =
    document.getElementById("faqForm");

  const modalTitle =
    document.getElementById("modalTitle");

  const questionInput =
    document.getElementById("question");

  const answerInput =
    document.getElementById("answer");

  const orderInput =
    document.getElementById("order");

  const saveBtn =
    document.getElementById("saveBtn");


  let editingFaqId = null;


  /*
  =====================================================
  HELPERS
  =====================================================
  */

  function escapeHtml(value){

    return String(value ?? "")
      .replace(/&/g,"&amp;")
      .replace(/</g,"&lt;")
      .replace(/>/g,"&gt;")
      .replace(/"/g,"&quot;")
      .replace(/'/g,"&#039;");

  }


  function showSuccess(message){

    const box =
      document.getElementById(
        "successMessage"
      );

    box.textContent = message;

    box.style.display = "block";

    setTimeout(() => {

      box.style.display = "none";

    },3000);

  }


  function showError(message){

    const box =
      document.getElementById(
        "errorMessage"
      );

    box.textContent = message;

    box.style.display = "block";

  }


  function clearMessages(){

    document.getElementById(
      "successMessage"
    ).style.display = "none";

    document.getElementById(
      "errorMessage"
    ).style.display = "none";

  }


  /*
  =====================================================
  LOAD FAQS
  =====================================================
  */

  async function loadFAQs(){

    if(!courseId) return;

    try{

      loading.style.display =
        "block";

      faqList.style.display =
        "none";

      empty.style.display =
        "none";


      const snapshot =
        await getDocs(
          collection(
            db,
            "courseFAQs"
          )
        );


      const faqs = [];


      snapshot.forEach(
        faqDoc => {

          const data =
            faqDoc.data();


          if(
            String(data.courseId || "")
              ===
            String(courseId)
          ){

            faqs.push({

              id: faqDoc.id,

              ...data

            });

          }

        }
      );


      faqs.sort(
        (a,b) =>
          Number(a.order || 0)
          -
          Number(b.order || 0)
      );


      loading.style.display =
        "none";


      if(faqs.length === 0){

        faqList.style.display =
          "none";

        empty.style.display =
          "block";

        return;

      }


      faqList.innerHTML =
        faqs.map(
          (faq,index) => `

          <div class="faq-card">

            <div class="faq-head">

              <div class="faq-number">
                ${index + 1}
              </div>

              <div class="faq-question">
                ${escapeHtml(faq.question)}
              </div>

            </div>


            <div class="faq-answer">
              ${escapeHtml(faq.answer)}
            </div>


            <div class="faq-meta">

              Order:
              ${Number(faq.order || 0)}

              ${faq.createdBy
                ? ` • Created by: ${escapeHtml(faq.createdBy)}`
                : ""
              }

            </div>


            <div class="actions">

              <button
                class="btn-edit"
                onclick="editFAQ('${faq.id}')"
              >
                Edit
              </button>

              <button
                class="btn-danger"
                onclick="deleteFAQ('${faq.id}')"
              >
                Delete
              </button>

            </div>

          </div>

        `
        ).join("");


      faqList.style.display =
        "flex";


    }catch(error){

      console.error(
        "Load FAQs error:",
        error
      );

      loading.style.display =
        "none";

      showError(
        "Unable to load course FAQs."
      );

    }

  }


  /*
  =====================================================
  OPEN ADD MODAL
  =====================================================
  */

  window.openAddModal =
    function(){

      clearMessages();

      editingFaqId =
        null;

      modalTitle.textContent =
        "Add Course FAQ";

      saveBtn.textContent =
        "Save FAQ";

      faqForm.reset();

      orderInput.value =
        "0";

      modal.classList.add(
        "show"
      );

      questionInput.focus();

    };


  /*
  =====================================================
  ADD BUTTON
  =====================================================
  */

  document.getElementById(
    "addFaqBtn"
  ).addEventListener(
    "click",
    openAddModal
  );


  /*
  =====================================================
  EDIT FAQ
  =====================================================
  */

  window.editFAQ =
    async function(faqId){

      clearMessages();

      try{

        const faqRef =
          doc(
            db,
            "courseFAQs",
            faqId
          );


        const faqSnap =
          await getDoc(
            faqRef
          );


        if(!faqSnap.exists()){

          showError(
            "FAQ not found."
          );

          return;

        }


        const data =
          faqSnap.data();


        editingFaqId =
          faqId;


        modalTitle.textContent =
          "Edit Course FAQ";

        saveBtn.textContent =
          "Update FAQ";


        questionInput.value =
          data.question || "";

        answerInput.value =
          data.answer || "";

        orderInput.value =
          data.order ?? 0;


        modal.classList.add(
          "show"
        );


        questionInput.focus();


      }catch(error){

        console.error(
          "Edit FAQ error:",
          error
        );

        showError(
          "Unable to open FAQ."
        );

      }

    };


  /*
  =====================================================
  SAVE / UPDATE FAQ
  =====================================================
  */

  faqForm.addEventListener(
    "submit",
    async event => {

      event.preventDefault();

      clearMessages();


      const question =
        questionInput.value.trim();

      const answer =
        answerInput.value.trim();

      const order =
        Number(
          orderInput.value || 0
        );


      if(!question){

        showError(
          "Please enter a question."
        );

        return;

      }


      if(!answer){

        showError(
          "Please enter an answer."
        );

        return;

      }


      try{

        saveBtn.disabled =
          true;

        saveBtn.textContent =
          editingFaqId
            ? "Updating..."
            : "Saving...";


        /*
        =================================================
        UPDATE
        =================================================
        */

        if(editingFaqId){

          await updateDoc(

            doc(
              db,
              "courseFAQs",
              editingFaqId
            ),

            {

              question,

              answer,

              order,

              updatedAt:
                serverTimestamp()

            }

          );


          showSuccess(
            "FAQ updated successfully."
          );

        }

        /*
        =================================================
        CREATE
        =================================================
        */

        else{

          await addDoc(

            collection(
              db,
              "courseFAQs"
            ),

            {

              courseId,

              question,

              answer,

              order,

              createdBy:
                "admin",

              createdAt:
                serverTimestamp()

            }

          );


          showSuccess(
            "FAQ added successfully."
          );

        }


        modal.classList.remove(
          "show"
        );


        faqForm.reset();

        editingFaqId =
          null;


        await loadFAQs();


      }catch(error){

        console.error(
          "Save FAQ error:",
          error
        );

        showError(
          "Unable to save FAQ. Please try again."
        );

      }finally{

        saveBtn.disabled =
          false;

        saveBtn.textContent =
          editingFaqId
            ? "Update FAQ"
            : "Save FAQ";

      }

    }
  );


  /*
  =====================================================
  DELETE FAQ
  =====================================================
  */

  window.deleteFAQ =
    async function(faqId){

      const confirmed =
        confirm(
          "Are you sure you want to delete this FAQ?"
        );


      if(!confirmed)
        return;


      try{

        await deleteDoc(

          doc(
            db,
            "courseFAQs",
            faqId
          )

        );


        showSuccess(
          "FAQ deleted successfully."
        );


        await loadFAQs();


      }catch(error){

        console.error(
          "Delete FAQ error:",
          error
        );

        showError(
          "Unable to delete FAQ."
        );

      }

    };


  /*
  =====================================================
  CLOSE MODAL
  =====================================================
  */

  function closeModal(){

    modal.classList.remove(
      "show"
    );

    faqForm.reset();

    editingFaqId =
      null;

  }


  document.getElementById(
    "closeModal"
  ).addEventListener(
    "click",
    closeModal
  );


  document.getElementById(
    "cancelBtn"
  ).addEventListener(
    "click",
    closeModal
  );


  modal.addEventListener(
    "click",
    event => {

      if(
        event.target === modal
      ){

        closeModal();

      }

    }
  );


  /*
  =====================================================
  ESC KEY
  =====================================================
  */

      document.addEventListener(
      "keydown",
      event => {

        if(
          event.key === "Escape"
        ){

          closeModal();

        }

      }
    );


    /*
    =====================================================
    START
    =====================================================
    */

    if(courseId){

      loadFAQs();

    }else{

      loading.style.display =
        "none";

      empty.style.display =
        "none";

    }

  </script>

</body>
</html>