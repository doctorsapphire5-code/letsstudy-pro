    </div>
  </div>
</dialog>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getFirestore, collection, addDoc, getDocs, getDoc, doc, updateDoc, deleteDoc, serverTimestamp, query, where } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

/* FIREBASE */
const firebaseConfig = {
  apiKey: "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",
  authDomain: "let-s-study-pro-course.firebaseapp.com",
  databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
  projectId: "let-s-study-pro-course",
  storageBucket: "let-s-study-pro-course.firebasestorage.app",
  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
};
const db = getFirestore(initializeApp(firebaseConfig));

/* COURSE ID + MODE
   Add / edit / delete tools show by default. Add &manage=0 to a link to give learners a read-only view. */
const params = new URLSearchParams(window.location.search);
const courseId = params.get("courseId") || params.get("id");
const canManage = !!courseId && params.get("manage") !== "0";

const $ = (id) => document.getElementById(id);
const list = $("faqList"), searchInput = $("searchInput"), faqDialog = $("faqDialog"), confirmDialog = $("confirmDialog");
const icon = (n) => `<svg class="i"><use href="#i-${n}"/></svg>`;
const escapeHtml = (v) => String(v ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;");
const formatText = (v) => escapeHtml(v).replace(/(https?:\/\/[^\s<]+)/g, (u) => `<a href="${u}" target="_blank" rel="noopener noreferrer">${u}</a>`);

let faqs = [], editingId = null, pendingDeleteId = null, allOpen = false;

if(courseId) $("backBtn").href = `course-learn.html?courseId=${encodeURIComponent(courseId)}`;
if(canManage){
  $("addFaqBtn").hidden = false;
  $("heroText").textContent = "Manage the questions learners ask most about this course.";
}

/* TOAST */
let toastTimer;
function toast(message, isError = false){
  const t = $("toast");
  t.textContent = message;
  t.classList.toggle("err", isError);
  t.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove("show"), isError ? 6000 : 3500);
}

/* LOAD: only this course's FAQs. Sorting is done here, so no composite index is needed. */
async function loadFAQs(){
  if(!courseId){
    list.innerHTML = `
      <div class="error"><div class="state-icon">${icon("alert")}</div>
        <h3>Course not specified</h3>
        <p>Open the FAQs from a course page, or use a link like course-faqs.html?courseId=COURSE_ID.</p>
      </div>`;
    return;
  }
  try{
    const [snapshot, courseSnap] = await Promise.all([
      getDocs(query(collection(db, "courseFAQs"), where("courseId", "==", courseId))),
      getDoc(doc(db, "courses", courseId)).catch(() => null)
    ]);

    faqs = [];
    snapshot.forEach((d) => {
      const data = d.data();
      if(String(data.courseId || "") === String(courseId)) faqs.push({ id: d.id, ...data });
    });
    faqs.sort((a, b) => Number(a.order ?? 0) - Number(b.order ?? 0));

    const c = courseSnap && courseSnap.exists() ? courseSnap.data() : {};
    $("courseName").textContent = c.title || c.name || c.courseName || "";
    $("countChip").textContent = `${faqs.length} ${faqs.length === 1 ? "question" : "questions"}`;
    render();
  }catch(error){
    console.error("Load FAQs error:", error);
    list.innerHTML = `
      <div class="error"><div class="state-icon">${icon("alert")}</div>
        <h3>Unable to load FAQs</h3>
        <p>Check your connection and try again.</p>
        <button class="btn btn-dark" id="retryBtn" type="button">Try again</button>
      </div>`;
    $("retryBtn").addEventListener("click", () => window.location.reload());
  }
}

/* RENDER */
function render(){
  const search = searchInput.value.trim().toLowerCase();
  const shown = faqs.filter((f) => !search || `${f.question} ${f.answer}`.toLowerCase().includes(search));

  if(!shown.length){
    const none = !faqs.length;
    list.innerHTML = `
      <div class="empty"><div class="state-icon">${icon(none ? "help" : "search")}</div>
        <h3>${none ? "No FAQs yet" : "No matching questions"}</h3>
        <p>${none ? (canManage ? "Add the first question learners are likely to ask." : "Answers to common questions will appear here.") : "Try different words."}</p>
        ${none && canManage ? `<button class="btn btn-amber" type="button" data-add>${icon("plus")}Add first FAQ</button>` : ""}
      </div>`;
    return;
  }

  list.innerHTML = shown.map((f) => `
    <details class="faq" data-id="${escapeHtml(f.id)}" ${(search || allOpen) ? "open" : ""}>
      <summary>${escapeHtml(f.question || "Untitled question")}${icon("chev")}</summary>
      <div class="faq-body">
        <div class="faq-answer">${formatText(f.answer || "No answer yet.")}</div>
        ${canManage ? `
        <div class="faq-tools">
          <span class="faq-meta">Order ${Number(f.order ?? 0)}${f.createdBy ? ` • ${escapeHtml(f.createdBy)}` : ""}</span>
          <button class="btn btn-ghost btn-sm" type="button" data-edit="${escapeHtml(f.id)}">${icon("edit")}Edit</button>
          <button class="btn btn-ghost btn-sm" type="button" data-delete="${escapeHtml(f.id)}">${icon("trash")}Delete</button>
        </div>` : ""}
      </div>
    </details>`).join("");
}

searchInput.addEventListener("input", render);

$("toggleAll").addEventListener("click", () => {
  allOpen = !allOpen;
  list.querySelectorAll("details").forEach(d => d.open = allOpen);
  $("toggleAll").textContent = allOpen ? "Collapse all" : "Expand all";
});

/* DIALOG HELPERS */
document.querySelectorAll("dialog").forEach((dlg) => {
  dlg.addEventListener("click", (e) => { if(e.target === dlg || e.target.closest("[data-close]")) dlg.close(); });
});

/* ADD / EDIT */
function openAdd(){
  if(!courseId){ toast("Course ID is missing, so a FAQ can't be added.", true); return; }
  editingId = null;
  $("dlgTitle").textContent = "Add FAQ";
  $("saveBtn").textContent = "Save FAQ";
  $("faqForm").reset();
  $("order").value = faqs.length ? Math.max(...faqs.map(f => Number(f.order ?? 0))) + 1 : 0;
  faqDialog.showModal();
  $("question").focus();
}

async function openEdit(id){
  try{
    const snap = await getDoc(doc(db, "courseFAQs", id));
    if(!snap.exists()){ toast("This FAQ no longer exists.", true); return; }
    const data = snap.data();
    if(String(data.courseId || "") !== String(courseId)){ toast("This FAQ does not belong to this course.", true); return; }
    editingId = id;
    $("dlgTitle").textContent = "Edit FAQ";
    $("saveBtn").textContent = "Update FAQ";
    $("question").value = data.question || "";
    $("answer").value = data.answer || "";
    $("order").value = data.order ?? 0;
    faqDialog.showModal();
    $("question").focus();
  }catch(error){
    console.error("Edit FAQ error:", error);
    toast("Unable to open this FAQ.", true);
  }
}

$("addFaqBtn").addEventListener("click", openAdd);

$("faqForm").addEventListener("submit", async (event) => {
  event.preventDefault();
  if(!courseId){ toast("Course ID is missing. The FAQ can't be saved.", true); return; }

  const question = $("question").value.trim();
  const answer = $("answer").value.trim();
  const order = Number($("order").value || 0);
  if(!question){ toast("Please enter a question.", true); $("question").focus(); return; }
  if(!answer){ toast("Please enter an answer.", true); $("answer").focus(); return; }

  const btn = $("saveBtn");
  btn.disabled = true;
  btn.textContent = editingId ? "Updating…" : "Saving…";

  try{
    if(editingId){
      const ref = doc(db, "courseFAQs", editingId);
      const snap = await getDoc(ref);
      if(!snap.exists()) throw new Error("FAQ_NOT_FOUND");
      if(String(snap.data().courseId || "") !== String(courseId)) throw new Error("FAQ_COURSE_MISMATCH");
      await updateDoc(ref, { question, answer, order, updatedAt: serverTimestamp() });
      toast("FAQ updated.");
    }else{
      await addDoc(collection(db, "courseFAQs"), { courseId, question, answer, order, createdAt: serverTimestamp(), updatedAt: serverTimestamp() });
      toast("FAQ added.");
    }
    faqDialog.close();
    await loadFAQs();
  }catch(error){
    console.error("Save FAQ error:", error);
    toast(error.message === "FAQ_NOT_FOUND" ? "This FAQ no longer exists." : error.message === "FAQ_COURSE_MISMATCH" ? "This FAQ does not belong to this course." : "Unable to save the FAQ. Please try again.", true);
  }finally{
    btn.disabled = false;
    btn.textContent = editingId ? "Update FAQ" : "Save FAQ";
  }
});

/* DELETE */
$("confirmDelete").addEventListener("click", async () => {
  if(!pendingDeleteId) return;
  const btn = $("confirmDelete");
  btn.disabled = true;
  btn.textContent = "Deleting…";
  try{
    const ref = doc(db, "courseFAQs", pendingDeleteId);
    const snap = await getDoc(ref);
    if(snap.exists() && String(snap.data().courseId || "") !== String(courseId)){
      toast("This FAQ does not belong to this course.", true);
    }else{
      if(snap.exists()) await deleteDoc(ref);
      toast("FAQ deleted.");
    }
    confirmDialog.close();
    await loadFAQs();
  }catch(error){
    console.error("Delete FAQ error:", error);
    toast("Unable to delete the FAQ. Please try again.", true);
  }finally{
    pendingDeleteId = null;
    btn.disabled = false;
    btn.textContent = "Delete FAQ";
  }
});

/* LIST ACTIONS */
list.addEventListener("click", (e) => {
  const edit = e.target.closest("[data-edit]");
  const del = e.target.closest("[data-delete]");
  if(e.target.closest("[data-add]")) openAdd();
  else if(edit && canManage) openEdit(edit.dataset.edit);
  else if(del && canManage){ pendingDeleteId = del.dataset.delete; confirmDialog.showModal(); }
});

loadFAQs();
</script>
</body>
</html>
