
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Forgot Password | Vorix Course</title>

  <meta name="description" content="Recover your Vorix Course account by requesting a secure password reset link.">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f4f6fb;
      color: #172033;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    header {
      background: #102b55;
      color: white;
      padding: 18px 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    header h2 {
      font-size: 21px;
    }

    header a {
      color: white;
      text-decoration: none;
      font-size: 14px;
    }

    main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 30px 15px;
    }

    .reset-card {
      background: white;
      width: 100%;
      max-width: 440px;
      padding: 32px 27px;
      border-radius: 15px;
      box-shadow: 0 5px 25px rgba(0,0,0,.07);
    }

    .icon {
      width: 65px;
      height: 65px;
      background: #eaf0ff;
      color: #2463eb;
      display: flex;
      justify-content: center;
      align-items: center;
      border-radius: 50%;
      font-size: 29px;
      margin-bottom: 20px;
    }

    h1 {
      font-size: 25px;
      margin-bottom: 10px;
      color: #102b55;
    }

    .description {
      color: #748094;
      font-size: 14px;
      line-height: 1.7;
      margin-bottom: 24px;
    }

    label {
      display: block;
      font-size: 14px;
      font-weight: 600;
      margin-bottom: 8px;
    }

    input {
      width: 100%;
      padding: 14px;
      border: 1px solid #dce2eb;
      border-radius: 8px;
      font-size: 15px;
      margin-bottom: 16px;
    }

    input:focus {
      outline: none;
      border-color: #2463eb;
    }

    button {
      width: 100%;
      padding: 14px;
      background: #2463eb;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
    }

    button:disabled {
      opacity: .6;
      cursor: not-allowed;
    }

    #message {
      display: none;
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 18px;
      font-size: 13px;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }

    #message.success {
      display: block;
      background: #e8f8ee;
      color: #16743a;
    }

    #message.error {
      display: block;
      background: #fff0f0;
      color: #b42323;
    }

    .links {
      text-align: center;
      margin-top: 22px;
      font-size: 14px;
    }

    .links a {
      color: #2463eb;
      text-decoration: none;
      font-weight: 600;
    }

    .security {
      margin-top: 24px;
      padding-top: 18px;
      border-top: 1px solid #edf0f5;
      text-align: center;
      font-size: 12px;
      color: #8992a1;
    }

    footer {
      text-align: center;
      padding: 20px;
      font-size: 12px;
      color: #8992a1;
    }

    @media(max-width: 480px) {
      .reset-card {
        padding: 26px 20px;
      }

      h1 {
        font-size: 23px;
      }
    }
  </style>
</head>

<body>

<header>
  <h2>Vorix Course</h2>
  <a href="course-login.html">Login</a>
</header>

<main>

  <section class="reset-card">

    <div class="icon">🔐</div>

    <h1>Forgot Password?</h1>

    <p class="description">
      Don't worry. Enter the email address associated with
      your Vorix Course account. We will send you instructions
      to reset your password.
    </p>

    <div id="message" role="status" aria-live="polite"></div>

    <form id="resetForm">

      <label for="email">Email Address</label>

      <input
        type="email"
        id="email"
        placeholder="Enter your registered email"
        autocomplete="email"
        required
      >

      <button type="submit" id="submitBtn">
        Send Reset Link
      </button>

    </form>

    <div class="links">
      Remember your password?
      <a href="course-login.html">Back to Login</a>
    </div>

    <div class="security">
      Secure password recovery powered by Firebase Authentication.
    </div>

  </section>

</main>

<footer>
  © <span id="year"></span> Vorix Course. All rights reserved.
</footer>

<script type="module">

  import {
    initializeApp
  } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

  import {
    getAuth,
    sendPasswordResetEmail
  } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

  // FIREBASE CONFIGURATION
  const firebaseConfig = {
    apiKey: "AIzaSyDaJ0LKede-fz0MTZl-V1SxZ4Ps0IETepE",
    authDomain: "vorix-course.firebaseapp.com",
    projectId: "vorix-course",
    storageBucket: "vorix-course.firebasestorage.app",
    messagingSenderId: "277814413742",
    appId: "1:277814413742:web:fb4515f03591ea07c7603f",
    measurementId: "G-SQ6PN704M7"
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);

  const form = document.getElementById("resetForm");
  const emailInput = document.getElementById("email");
  const submitBtn = document.getElementById("submitBtn");
  const message = document.getElementById("message");

  document.getElementById("year").textContent =
    new Date().getFullYear();

  function showMessage(text, type) {
    message.textContent = text;
    message.className = type;
    message.style.display = "block";
  }

  form.addEventListener("submit", async event => {
    event.preventDefault();

    const email = emailInput.value.trim().toLowerCase();

    if (!email) {
      showMessage("Please enter your email address.", "error");
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Sending...";

    try {

      await sendPasswordResetEmail(auth, email);

      // Generic confirmation avoids revealing whether
      // an email address has a registered account.
      showMessage(
        "If an account exists for this email address, " +
        "a password reset link has been sent. " +
        "Please check your inbox and spam folder.",
        "success"
      );

      form.reset();

    } catch (error) {

      console.error("Password reset error:", error);

      if (
        error.code === "auth/invalid-email"
      ) {
        showMessage(
          "Please enter a valid email address.",
          "error"
        );

      } else if (
        error.code === "auth/too-many-requests"
      ) {
        showMessage(
          "Too many attempts. Please wait and try again later.",
          "error"
        );

      } else if (
        error.code === "auth/network-request-failed"
      ) {
        showMessage(
          "Network error. Check your internet connection and try again.",
          "error"
        );

      } else {
        showMessage(
          "Unable to process your request. Please try again later.",
          "error"
        );
      }

    } finally {

      submitBtn.disabled = false;
      submitBtn.textContent = "Send Reset Link";

    }
  });

</script>

</body>
</html>
