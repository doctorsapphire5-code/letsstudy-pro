
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#101827">
<title>My Profile | Vorix Course</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f4f6fb;color:#172033}
header{background:#101827;color:white;padding:18px 20px}
header .nav{max-width:1000px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap}
header a{color:white;text-decoration:none;font-size:14px}
.brand{font-size:20px;font-weight:700}
.container{max-width:1000px;margin:30px auto;padding:0 16px}
.card{background:white;border-radius:14px;padding:25px;margin-bottom:20px;box-shadow:0 4px 18px rgba(0,0,0,.04)}
.profile-head{display:flex;align-items:center;gap:18px;margin-bottom:25px}
.avatar{width:85px;height:85px;border-radius:50%;background:#e9efff;object-fit:cover;display:grid;place-items:center;color:#315bea;font-size:30px}
h1{font-size:25px;margin-bottom:7px}
.subtitle{color:#667085;font-size:14px;line-height:1.6}
h2{font-size:18px;margin-bottom:20px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.field{margin-bottom:5px}
.full{grid-column:1/-1}
label{display:block;font-size:13px;font-weight:600;margin-bottom:7px}
input,textarea,select{width:100%;padding:12px;border:1px solid #d0d5dd;border-radius:8px;font-size:14px;outline:none;background:white}
input:focus,textarea:focus,select:focus{border-color:#315bea}
textarea{min-height:100px;resize:vertical}
button{padding:12px 18px;border:0;border-radius:8px;background:#315bea;color:white;font-weight:600;cursor:pointer}
button:hover{background:#2448c5}
button:disabled{opacity:.6;cursor:not-allowed}
.secondary{background:#e9efff;color:#315bea}
.secondary:hover{background:#dbe5ff}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}
.message{display:none;margin-top:15px;padding:12px;border-radius:8px;font-size:13px;line-height:1.5}
.success{display:block;background:#ecfdf3;color:#067647}
.error{display:block;background:#fef3f2;color:#b42318}
.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.info{padding:14px;background:#f8fafc;border-radius:8px}
.info small{display:block;color:#667085;margin-bottom:6px}
.info strong{font-size:14px;overflow-wrap:anywhere}
footer{text-align:center;padding:25px;color:#98a2b3;font-size:12px}
.hidden{display:none}
@media(max-width:600px){.grid,.info-grid{grid-template-columns:1fr}.profile-head{align-items:flex-start}.card{padding:20px}}
</style>
</head>

<body>

<header>
  <div class="nav">
    <a class="brand" href="course-dashboard.html">Vorix Course</a>
    <nav>
      <a href="course-dashboard.html">Dashboard</a> |
      <a href="my-course.html">My Courses</a> |
      <a href="course-account.html">Account</a>
    </nav>
  </div>
</header>

<main class="container">

  <section class="card">
    <div class="profile-head">
      <img id="avatar" class="avatar" alt="Profile photo">
      <div>
        <h1 id="displayName">My Profile</h1>
        <p class="subtitle">Manage your personal information and profile.</p>
        <p class="subtitle" id="profileEmail"></p>
      </div>
    </div>
  </section>

  <section class="card">
    <h2>Edit Profile</h2>

    <form id="profileForm">
      <div class="grid">

        <div class="field full">
          <label for="fullName">Full Name</label>
          <input id="fullName" type="text" required maxlength="100">
        </div>

        <div class="field">
          <label for="username">Username</label>
          <input id="username" type="text" maxlength="30">
        </div>

        <div class="field">
          <label for="phoneNumber">Phone Number</label>
          <input id="phoneNumber" type="tel">
        </div>

        <div class="field full">
          <label for="photoURL">Profile Photo URL</label>
          <input id="photoURL" type="url" placeholder="https://example.com/photo.jpg">
        </div>

        <div class="field full">
          <label for="bio">Bio</label>
          <textarea id="bio" maxlength="500" placeholder="Tell us about yourself"></textarea>
        </div>

        <div class="field">
          <label for="country">Country</label>
          <input id="country" type="text">
        </div>

        <div class="field">
          <label for="city">City</label>
          <input id="city" type="text">
        </div>

        <div class="field">
          <label for="educationLevel">Education Level</label>
          <select id="educationLevel">
            <option value="">Select education level</option>
            <option>Primary</option>
            <option>Secondary</option>
            <option>Certificate</option>
            <option>Diploma</option>
            <option>Bachelor</option>
            <option>Master</option>
            <option>PhD</option>
            <option>Other</option>
          </select>
        </div>

        <div class="field">
          <label for="occupation">Occupation</label>
          <input id="occupation" type="text">
        </div>

        <div class="field full">
          <label for="organizationName">Organization</label>
          <input id="organizationName" type="text">
        </div>

      </div>

      <div class="actions">
        <button type="submit" id="saveButton">Save Profile</button>
        <button type="button" class="secondary" id="reloadButton">Reload</button>
      </div>

      <div id="message" class="message"></div>
    </form>
  </section>

  <section class="card">
    <h2>Profile Information</h2>

    <div class="info-grid">
      <div class="info">
        <small>User ID</small>
        <strong id="userId">—</strong>
      </div>

      <div class="info">
        <small>Email Verification</small>
        <strong id="emailVerified">—</strong>
      </div>

      <div class="info">
        <small>Account Status</small>
        <strong id="accountStatus">—</strong>
      </div>

      <div class="info">
        <small>Account Type</small>
        <strong id="accountType">—</strong>
      </div>

      <div class="info">
        <small>Created At</small>
        <strong id="createdAt">—</strong>
      </div>

      <div class="info">
        <small>Last Login</small>
        <strong id="lastLoginAt">—</strong>
      </div>
    </div>
  </section>

</main>

<footer>Vorix Course · User Profile</footer>

<script type="module">
import {initializeApp}
from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

import {
  getAuth,
  onAuthStateChanged,
  updateProfile,
  signOut
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

import {
  getFirestore,
  doc,
  getDoc,
  updateDoc,
  serverTimestamp
} from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";

// Vorix Course Firebase Configuration
const firebaseConfig = {
  apiKey: "AIzaSyDaJ0LKede-fzMTZl-V1SxZ4Ps0IETepE",
  authDomain: "vorix-course.firebaseapp.com",
  projectId: "vorix-course",
  storageBucket: "vorix-course.firebasestorage.app",
  messagingSenderId: "277814413742",
  appId: "1:277814413742:web:fb4515f03591ea07c7603f",
  measurementId: "G-SQ6PN704M7"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

const form = document.getElementById("profileForm");
const saveButton = document.getElementById("saveButton");
const messageBox = document.getElementById("message");

let currentUser = null;

function showMessage(message,type){
  messageBox.textContent = message;
  messageBox.className = "message "+type;
}

function setValue(id,value){
  document.getElementById(id).value = value || "";
}

function formatDate(value){
  if(!value) return "—";
  const date = value.toDate ? value.toDate() : new Date(value);
  return date.toLocaleString();
}

async function loadProfile(){
  if(!currentUser) return;

  try{
    const ref = doc(db,"users",currentUser.uid);
    const snapshot = await getDoc(ref);

    if(!snapshot.exists()){
      showMessage("User profile document was not found.","error");
      return;
    }

    const data = snapshot.data();

    setValue("fullName",data.fullName || currentUser.displayName);
    setValue("username",data.username);
    setValue("phoneNumber",data.phoneNumber);
    setValue("photoURL",data.photoURL);
    setValue("bio",data.bio);
    setValue("country",data.country);
    setValue("city",data.city);
    setValue("educationLevel",data.educationLevel);
    setValue("occupation",data.occupation);
    setValue("organizationName",data.organizationName);

    document.getElementById("displayName").textContent =
      data.fullName || currentUser.displayName || "My Profile";

    document.getElementById("profileEmail").textContent =
      currentUser.email || "";

    const avatar = document.getElementById("avatar");
    avatar.src = data.photoURL || currentUser.photoURL ||
      "https://placehold.co/100x100/e9efff/315bea?text=U";

    avatar.onerror = () => {
      avatar.src = "https://placehold.co/100x100/e9efff/315bea?text=U";
    };

    document.getElementById("userId").textContent =
      currentUser.uid;

    document.getElementById("emailVerified").textContent =
      currentUser.emailVerified ? "Verified" : "Not Verified";

    document.getElementById("accountStatus").textContent =
      data.status || "active";

    document.getElementById("accountType").textContent =
      data.accountType || "user";

    document.getElementById("createdAt").textContent =
      formatDate(data.createdAt);

    document.getElementById("lastLoginAt").textContent =
      formatDate(data.lastLoginAt);

  }catch(error){
    console.error(error);
    showMessage("Unable to load profile. Check Firestore Rules.","error");
  }
}

form.addEventListener("submit",async(event)=>{
  event.preventDefault();

  if(!currentUser) return;

  const fullName =
    document.getElementById("fullName").value.trim();

  const username =
    document.getElementById("username").value.trim();

  const phoneNumber =
    document.getElementById("phoneNumber").value.trim();

  const photoURL =
    document.getElementById("photoURL").value.trim();

  const bio =
    document.getElementById("bio").value.trim();

  const country =
    document.getElementById("country").value.trim();

  const city =
    document.getElementById("city").value.trim();

  const educationLevel =
    document.getElementById("educationLevel").value;

  const occupation =
    document.getElementById("occupation").value.trim();

  const organizationName =
    document.getElementById("organizationName").value.trim();

  if(!fullName){
    showMessage("Full name is required.","error");
    return;
  }

  if(photoURL && !/^https?:\/\//i.test(photoURL)){
    showMessage("Enter a valid HTTP or HTTPS photo URL.","error");
    return;
  }

  saveButton.disabled = true;
  saveButton.textContent = "Saving...";

  try{
    await updateDoc(doc(db,"users",currentUser.uid),{
      fullName,
      displayName:fullName,
      firstName:fullName.split(" ")[0] || "",
      lastName:fullName.split(" ").slice(1).join(" "),
      username,
      phoneNumber,
      photoURL,
      bio,
      country,
      city,
      educationLevel,
      occupation,
      organizationName,
      updatedAt:serverTimestamp()
    });

    await updateProfile(currentUser,{
      displayName:fullName,
      photoURL:photoURL || null
    });

    showMessage("Profile updated successfully!","success");

    await loadProfile();

  }catch(error){
    console.error(error);
    showMessage("Unable to save profile. Check Firestore Rules.","error");
  }finally{
    saveButton.disabled = false;
    saveButton.textContent = "Save Profile";
  }
});

document.getElementById("reloadButton").addEventListener("click",loadProfile);

onAuthStateChanged(auth,async(user)=>{
  if(!user){
    window.location.href="course-login.html";
    return;
  }

  currentUser=user;
  await loadProfile();
});
</script>

</body>
</html>
