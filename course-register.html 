
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101827">
  <title>Create Account | Vorix Course</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      padding: 30px 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #101827;
      font-family: Arial, sans-serif;
      color: #172033;
    }

    .container {
      width: 100%;
      max-width: 520px;
      padding: 35px 28px;
      background: white;
      border-radius: 16px;
      box-shadow: 0 15px 45px rgba(0,0,0,.25);
    }

    .logo {
      width: 58px;
      height: 58px;
      display: grid;
      place-items: center;
      margin: 0 auto 18px;
      border-radius: 16px;
      background: #e9efff;
      color: #315bea;
      font-size: 27px;
    }

    h1 {
      text-align: center;
      font-size: 26px;
      margin-bottom: 10px;
    }

    .subtitle {
      text-align: center;
      color: #667085;
      font-size: 14px;
      line-height: 1.6;
      margin-bottom: 25px;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .field {
      margin-bottom: 15px;
    }

    .full {
      grid-column: 1 / -1;
    }

    label {
      display: block;
      margin-bottom: 7px;
      font-size: 14px;
      font-weight: 600;
    }

    input {
      width: 100%;
      padding: 13px;
      border: 1px solid #d0d5dd;
      border-radius: 8px;
      outline: none;
      font-size: 14px;
    }

    input:focus {
      border-color: #315bea;
      box-shadow: 0 0 0 3px rgba(49,91,234,.12);
    }

    .terms {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin: 8px 0 18px;
      font-size: 13px;
      color: #667085;
      line-height: 1.5;
    }

    .terms input {
      width: auto;
      margin-top: 3px;
    }

    .terms a {
      color: #315bea;
      text-decoration: none;
    }

    button {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 8px;
      background: #315bea;
      color: white;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
    }

    button:hover {
      background: #2448c5;
    }

    button:disabled {
      opacity: .6;
      cursor: not-allowed;
    }

    .message {
      display: none;
      padding: 12px;
      margin-top: 18px;
      border-radius: 8px;
      font-size: 13px;
      line-height: 1.5;
    }

    .success {
      display: block;
      background: #ecfdf3;
      color: #067647;
    }

    .error {
      display: block;
      background: #fef3f2;
      color: #b42318;
    }

    .login {
      text-align: center;
      margin-top: 22px;
      font-size: 14px;
      color: #667085;
    }

    .login a {
      color: #315bea;
      font-weight: 600;
      text-decoration: none;
    }

    .footer {
      text-align: center;
      margin-top: 25px;
      color: #98a2b3;
      font-size: 12px;
    }

    @media (max-width: 480px) {
      .grid {
        grid-template-columns: 1fr;
        gap: 0;
      }

      .container {
        padding: 28px 20px;
      }
    }
  </style>
</head>

<body>

  <main class="container">

    <div class="logo">🎓</div>

    <h1>Create Account</h1>

    <p class="subtitle">
      Join Vorix Course and start your learning journey.
    </p>

    <form id="registerForm">

      <div class="grid">

        <div class="field full">
          <label for="fullName">Full Name</label>
          <input
            type="text"
            id="fullName"
            placeholder="Enter your full name"
            autocomplete="name"
            required
          >
        </div>

        <div class="field">
          <label for="username">Username</label>
          <input
            type="text"
            id="username"
            placeholder="Username"
            minlength="3"
            maxlength="30"
            required
          >
        </div>

        <div class="field">
          <label for="phoneNumber">Phone Number</label>
          <input
            type="tel"
            id="phoneNumber"
            placeholder="+255..."
            autocomplete="tel"
          >
        </div>

        <div class="field full">
          <label for="email">Email Address</label>
          <input
            type="email"
            id="email"
            placeholder="name@example.com"
            autocomplete="email"
            required
          >
        </div>

        <div class="field">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            placeholder="Create password"
            minlength="8"
            autocomplete="new-password"
            required
          >
        </div>

        <div class="field">
          <label for="confirmPassword">Confirm Password</label>
          <input
            type="password"
            id="confirmPassword"
            placeholder="Repeat password"
            minlength="8"
            autocomplete="new-password"
            required
          >
        </div>

      </div>

      <label class="terms">
        <input type="checkbox" id="terms" required>
        <span>
          I agree to the
          <a href="course-terms.html" target="_blank">Terms</a>
          and
          <a href="course-privacy.html" target="_blank">Privacy Policy</a>.
        </span>
      </label>

      <button type="submit" id="registerButton">
        Create Account
      </button>

    </form>

    <div id="message" class="message"></div>

    <div class="login">
      Already have an account?
      <a href="course-login.html">Sign In</a>
    </div>

    <div class="footer">
      Vorix Course · Create Your Account
    </div>

  </main>

  <script type="module">
    import { initializeApp }
      from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

    import {
      getAuth,
      createUserWithEmailAndPassword,
      updateProfile,
      sendEmailVerification
    } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

    import {
      getFirestore,
      doc,
      setDoc,
      serverTimestamp
    } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";

    // Vorix Course Firebase Configuration
    const firebaseConfig = {
      apiKey: "AIzaSyDaJ0LKede-fzMTZl-V1SxZ4Ps0IETepE",
      authDomain: "vorix-course.firebaseapp.com",
      projectId: "vorix-course",
      storageBucket: "vorix-course.firebasestorage.app",
      messagingSenderId: "277814413742",
      appId: "1:277814413742:web:fb4515f03591ea07c7603f",
      measurementId: "G-SQ6PN704M7"
    };

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);

    const registerForm =
      document.getElementById("registerForm");

    const registerButton =
      document.getElementById("registerButton");

    const messageBox =
      document.getElementById("message");

    function showMessage(message, type) {
      messageBox.textContent = message;
      messageBox.className = "message " + type;
    }

    function getFirebaseError(error) {
      const errors = {
        "auth/email-already-in-use":
          "This email is already registered. Please sign in.",
        "auth/invalid-email":
          "Please enter a valid email address.",
        "auth/weak-password":
          "Password is too weak. Use at least 8 characters.",
        "auth/operation-not-allowed":
          "Email and password registration is not enabled.",
        "auth/network-request-failed":
          "Network error. Check your internet connection.",
        "permission-denied":
          "Registration could not be completed. Check Firestore Security Rules."
      };

      return errors[error.code] ||
        "Registration failed. Please try again.";
    }

    registerForm.addEventListener("submit", async (event) => {
      event.preventDefault();

      const fullName =
        document.getElementById("fullName").value.trim();

      const username =
        document.getElementById("username").value.trim();

      const phoneNumber =
        document.getElementById("phoneNumber").value.trim();

      const email =
        document.getElementById("email").value.trim();

      const password =
        document.getElementById("password").value;

      const confirmPassword =
        document.getElementById("confirmPassword").value;

      if (password.length < 8) {
        showMessage(
          "Password must contain at least 8 characters.",
          "error"
        );
        return;
      }

      if (password !== confirmPassword) {
        showMessage(
          "Passwords do not match.",
          "error"
        );
        return;
      }

      registerButton.disabled = true;
      registerButton.textContent = "Creating Account...";

      let userCredential = null;

      try {
        // Create Firebase Authentication account
        userCredential =
          await createUserWithEmailAndPassword(
            auth,
            email,
            password
          );

        const user = userCredential.user;

        await updateProfile(user, {
          displayName: fullName
        });

        // Create Firestore user document
        await setDoc(doc(db, "users", user.uid), {
          userId: user.uid,
          adminId: null,

          fullName: fullName,
          displayName: fullName,
          firstName: fullName.split(" ")[0] || "",
          lastName: fullName.split(" ").slice(1).join(" "),
          username: username,

          email: email,
          phoneNumber: phoneNumber,
          photoURL: user.photoURL || "",
          bio: "",

          accountType: "user",
          role: "user",
          status: "active",

          provider: "password",
          providers: ["password"],

          emailVerified: false,
          phoneVerified: false,

          language: "en",
          timezone: "Africa/Dar_es_Salaam",

          country: "",
          region: "",
          city: "",
          address: "",
          postalCode: "",

          educationLevel: "",
          occupation: "",
          organizationName: "",

          interests: [],
          skills: [],
          socialLinks: {},

          preferences: {
            theme: "light",
            language: "en"
          },

          notificationsEnabled: true,

          loginCount: 0,
          createdAt: serverTimestamp(),
          updatedAt: serverTimestamp(),
          lastLoginAt: null
        });

        // Send email verification
        await sendEmailVerification(user);

        showMessage(
          "Account created successfully! A verification email has been sent. Please check your inbox.",
          "success"
        );

        registerForm.reset();

        registerButton.textContent = "Account Created";

        setTimeout(() => {
          window.location.href = "course-dashboard.html";
        }, 2500);

      } catch (error) {
        console.error("Registration error:", error);

        // Clean up Auth user if Firestore write fails
        if (
          userCredential &&
          error.code !== "auth/email-already-in-use"
        ) {
          try {
            // Keep account if email verification succeeded or
            // the failure was only in sending verification email.
            if (
              error.code !== "auth/invalid-email" &&
              error.code !== "auth/weak-password"
            ) {
              // Do not automatically delete an authenticated user.
              // The user can retry Firestore registration/login.
            }
          } catch (cleanupError) {
            console.error(cleanupError);
          }
        }

        showMessage(getFirebaseError(error), "error");

        registerButton.disabled = false;
        registerButton.textContent = "Create Account";
      }
    });
  </script>

</body>
</html>
