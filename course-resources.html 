<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Course Resources | LetsStudy Pro</title>

<meta name="description"
content="Access course resources, notes, documents, videos and learning materials on LetsStudy Pro.">

<style>
*{
box-sizing:border-box;
margin:0;
padding:0
}

body{
font-family:Inter,Arial,sans-serif;
background:#f6f8fc;
color:#101828;
line-height:1.6
}

.header{
height:68px;
background:#fff;
border-bottom:1px solid #eaecf0;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 22px;
position:sticky;
top:0;
z-index:50
}

.logo{
color:#155eef;
font-size:21px;
font-weight:900;
text-decoration:none
}

.back{
color:#475467;
text-decoration:none;
font-size:14px;
font-weight:700
}

.container{
width:min(1100px,100%);
margin:auto;
padding:28px 18px 60px
}

.hero{
background:linear-gradient(135deg,#155eef,#3538cd);
color:#fff;
border-radius:22px;
padding:30px;
margin-bottom:20px;
box-shadow:0 12px 35px #155eef20
}

.hero small{
opacity:.8;
font-weight:800
}

.hero h1{
font-size:32px;
margin:5px 0
}

.hero p{
opacity:.9;
max-width:700px
}

.course-id{
display:inline-block;
margin-top:15px;
padding:7px 12px;
background:#ffffff20;
border-radius:30px;
font-size:12px
}

.toolbar{
background:#fff;
border:1px solid #eaecf0;
border-radius:16px;
padding:14px;
margin-bottom:18px
}

.search{
width:100%;
border:1px solid #d0d5dd;
border-radius:10px;
padding:12px 14px;
outline:none
}

.search:focus{
border-color:#155eef;
box-shadow:0 0 0 3px #155eef15
}

.resource-list{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:16px
}

.resource{
background:#fff;
border:1px solid #eaecf0;
border-radius:18px;
padding:21px;
transition:.2s
}

.resource:hover{
transform:translateY(-2px);
box-shadow:0 10px 25px #10182810
}

.resource-top{
display:flex;
gap:14px;
align-items:flex-start
}

.icon{
width:48px;
height:48px;
border-radius:13px;
background:#eef4ff;
display:flex;
align-items:center;
justify-content:center;
font-size:22px;
flex:none
}

.resource h2{
font-size:18px;
line-height:1.3
}

.type{
display:inline-block;
margin-top:5px;
font-size:11px;
font-weight:800;
color:#155eef;
text-transform:uppercase
}

.description{
color:#667085;
font-size:14px;
margin-top:14px
}

.resource-actions{
display:flex;
gap:9px;
margin-top:18px;
flex-wrap:wrap
}

.btn{
display:inline-flex;
align-items:center;
justify-content:center;
padding:10px 15px;
border-radius:10px;
text-decoration:none;
font-size:13px;
font-weight:800
}

.primary{
background:#155eef;
color:#fff
}

.secondary{
background:#eef4ff;
color:#155eef
}

.empty,
.loading,
.no-course{
background:#fff;
border:1px solid #eaecf0;
border-radius:18px;
padding:50px 20px;
text-align:center;
color:#667085
}

.empty-icon{
font-size:40px;
margin-bottom:8px
}

.error{
display:none;
background:#fef3f2;
border:1px solid #fecdca;
color:#b42318;
padding:13px;
border-radius:12px;
margin-bottom:18px
}

.footer{
text-align:center;
padding:25px;
font-size:13px;
color:#98a2b3
}

@media(max-width:700px){

.container{
padding:18px 12px 45px
}

.hero{
padding:24px 20px
}

.hero h1{
font-size:26px
}

.resource-list{
grid-template-columns:1fr
}

.resource{
padding:18px
}

}
</style>
</head>

<body>

<header class="header">

<a href="index.html" class="logo">
LetsStudy Pro
</a>

<a
href="javascript:history.back()"
class="back">

← Back

</a>

</header>


<main class="container">

<section class="hero">

<small>
COURSE LEARNING MATERIALS
</small>

<h1>
Resources
</h1>

<p>
Access notes, documents, videos, links and other learning materials for this course.
</p>

<span
id="courseBadge"
class="course-id">

Loading course...

</span>

</section>


<div id="error" class="error"></div>


<div
id="noCourse"
class="no-course"
style="display:none">

<h2>
Course ID Required
</h2>

<p style="margin-top:8px">

Open this page using:

<br><br>

<strong>
resources.html?courseId=YOUR_COURSE_ID
</strong>

</p>

</div>


<div
id="courseContent"
style="display:none">


<div class="toolbar">

<input
id="search"
class="search"
type="search"
placeholder="Search resources..."
autocomplete="off">

</div>


<div
id="resourceList"
class="resource-list">

<div class="loading">
Loading resources...
</div>

</div>

</div>

</main>


<footer class="footer">

© 2026 LetsStudy Pro. All rights reserved.

</footer>


<script type="module">

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";


import {
getFirestore,
collection,
query,
where,
getDocs
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-firestore.js";


/*
========================================
FIREBASE CONFIG
========================================
*/

const firebaseConfig={

apiKey:
"AIzaSyBcXKAVXKbXkljsyRgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};


const app=
initializeApp(firebaseConfig);

const db=
getFirestore(app);


/*
========================================
GET COURSE ID
========================================
*/

const params=
new URLSearchParams(
window.location.search
);

const courseId=
params.get("courseId");


const courseBadge=
document.getElementById(
"courseBadge"
);

const courseContent=
document.getElementById(
"courseContent"
);

const noCourse=
document.getElementById(
"noCourse"
);

const resourceList=
document.getElementById(
"resourceList"
);

const search=
document.getElementById(
"search"
);

let resources=[];


/*
========================================
CHECK COURSE
========================================
*/

if(!courseId){

noCourse.style.display="block";

}else{

courseContent.style.display="block";

courseBadge.textContent=
"Course ID: "+courseId;

loadResources();

}


/*
========================================
LOAD RESOURCES
========================================
*/

async function loadResources(){

try{

const q=
query(

collection(
db,
"resources"
),

where(
"courseId",
"==",
courseId
)

);


const snapshot=
await getDocs(q);


resources=
snapshot.docs.map(
d=>({

id:d.id,
...d.data()

})
);


/*
SORT NEWEST FIRST
*/

resources.sort(
(a,b)=>{

const da=
toDate(a.createdAt);

const db=
toDate(b.createdAt);

if(!da&&!db)return 0;

if(!da)return 1;

if(!db)return -1;

return db-da;

}
);


renderResources();


}catch(error){

console.error(error);

showError(
"Failed to load resources: "+
error.message
);

resourceList.innerHTML="";

}

}


/*
========================================
SEARCH
========================================
*/

search.addEventListener(
"input",
renderResources
);


/*
========================================
RENDER
========================================
*/

function renderResources(){

const keyword=
search.value
.trim()
.toLowerCase();


const filtered=
resources.filter(r=>{

const text=`

${r.name||""}
${r.type||""}
${r.description||""}

`.toLowerCase();

return text.includes(
keyword
);

});


if(!filtered.length){

resourceList.innerHTML=`

<div class="empty">

<div class="empty-icon">
📚
</div>

<h2>
No Resources Found
</h2>

<p>
There are currently no resources available for this course.
</p>

</div>

`;

return;

}


resourceList.innerHTML=
filtered
.map(renderResource)
.join("");

}


/*
========================================
RESOURCE CARD
========================================
*/

function renderResource(r){

const name=
escapeHTML(
r.name||
"Untitled Resource"
);


const type=
escapeHTML(
r.type||
"Resource"
);


const description=
escapeHTML(
r.description||
"No description available."
);


const url=
String(
r.url||
""
).trim();


const icon=
getIcon(
r.type
);


return`

<article class="resource">

<div class="resource-top">

<div class="icon">
${icon}
</div>

<div>

<h2>
${name}
</h2>

<span class="type">
${type}
</span>

</div>

</div>


<p class="description">
${description}
</p>


<div class="resource-actions">

${
url
?
`

<a
class="btn primary"
href="${escapeAttribute(url)}"
target="_blank"
rel="noopener noreferrer">

Open Resource →

</a>

<a
class="btn secondary"
href="${escapeAttribute(url)}"
download>

Download

</a>

`
:
`

<span
class="btn secondary">

No URL Available

</span>

`
}

</div>

</article>

`;

}


/*
========================================
RESOURCE ICON
========================================
*/

function getIcon(type){

const t=
String(
type||""
).toLowerCase();


if(
t.includes("pdf")
)return"📕";

if(
t.includes("video"))
return"🎬";

if(
t.includes("audio"))
return"🎧";

if(
t.includes("image")||
t.includes("photo"))
return"🖼️";

if(
t.includes("document")||
t.includes("doc"))
return"📄";

if(
t.includes("link")||
t.includes("url"))
return"🔗";

if(
t.includes("zip")||
t.includes("file"))
return"📦";

return"📚";

}


/*
========================================
FIREBASE DATE
========================================
*/

function toDate(value){

if(!value)
return null;


if(
typeof value.toDate==="function"
){

return value.toDate();

}


if(
value instanceof Date
){

return value;

}


if(
typeof value==="string"||
typeof value==="number"
){

const date=
new Date(value);

return isNaN(
date.getTime()
)
?
null
:
date;

}


if(
value.seconds!==undefined
){

return new Date(
value.seconds*1000
);

}


return null;

}


/*
========================================
ESCAPE HTML
========================================
*/

function escapeHTML(value){

return String(
value??""
)

.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}


/*
========================================
ESCAPE URL ATTRIBUTE
========================================
*/

function escapeAttribute(value){

return String(value)
.replace(/&/g,"&amp;")
.replace(/"/g,"&quot;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;");

}


/*
========================================
ERROR
========================================
*/

function showError(message){

const el=
document.getElementById(
"error"
);

el.textContent=
message;

el.style.display=
"block";

}

</script>

</body>
</html>