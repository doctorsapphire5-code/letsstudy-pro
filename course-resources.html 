<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Course Resources | LetsStudy Pro</title>

<meta
  name="description"
  content="Access course resources, study materials and downloadable files on LetsStudy Pro."
>

<link
  rel="icon"
  href="/favicon.ico"
>

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
>

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:
    Inter,
    Arial,
    sans-serif;
  background:#f5f7fb;
  color:#172033;
  line-height:1.5;
}

header{
  position:sticky;
  top:0;
  z-index:50;
  background:#fff;
  border-bottom:1px solid #e5e7eb;
}

.nav{
  width:92%;
  max-width:1200px;
  margin:auto;
  min-height:68px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
}

.logo{
  font-size:22px;
  font-weight:800;
  color:#172033;
  text-decoration:none;
}

.logo span{
  color:#2563eb;
}

.home-btn{
  border:0;
  background:#2563eb;
  color:#fff;
  text-decoration:none;
  padding:10px 16px;
  border-radius:9px;
  font-weight:600;
  display:inline-flex;
  align-items:center;
  gap:8px;
}

.hero{
  background:
    linear-gradient(
      135deg,
      #eff6ff,
      #ffffff
    );
  border-bottom:1px solid #e5e7eb;
  padding:55px 20px;
}

.hero-inner{
  width:92%;
  max-width:1200px;
  margin:auto;
}

.eyebrow{
  color:#2563eb;
  font-size:13px;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.08em;
  margin-bottom:8px;
}

.hero h1{
  font-size:38px;
  line-height:1.15;
  margin-bottom:12px;
}

.hero p{
  color:#64748b;
  max-width:700px;
}

.container{
  width:92%;
  max-width:1200px;
  margin:30px auto 70px;
}

.course-info{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:16px;
  padding:20px;
  margin-bottom:24px;
  display:none;
}

.course-info.show{
  display:block;
}

.course-title{
  font-size:24px;
  font-weight:800;
}

.course-description{
  margin-top:7px;
  color:#64748b;
}

.toolbar{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:14px;
  padding:15px;
  margin-bottom:24px;
  display:flex;
  gap:12px;
  align-items:center;
  justify-content:space-between;
  flex-wrap:wrap;
}

.search{
  position:relative;
  flex:1;
  min-width:220px;
}

.search i{
  position:absolute;
  left:13px;
  top:50%;
  transform:translateY(-50%);
  color:#94a3b8;
}

.search input{
  width:100%;
  border:1px solid #dbe1ea;
  border-radius:9px;
  padding:12px 14px 12px 40px;
  outline:none;
  font-size:14px;
}

.search input:focus{
  border-color:#2563eb;
}

.count{
  color:#64748b;
  font-size:14px;
}

.grid{
  display:grid;
  grid-template-columns:
    repeat(
      auto-fill,
      minmax(300px,1fr)
    );
  gap:20px;
}

.resource-card{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:16px;
  padding:20px;
  display:flex;
  gap:15px;
  transition:.2s ease;
}

.resource-card:hover{
  transform:translateY(-3px);
  box-shadow:
    0 12px 30px
    rgba(15,23,42,.08);
}

.resource-icon{
  flex:0 0 52px;
  width:52px;
  height:52px;
  border-radius:12px;
  background:#eff6ff;
  color:#2563eb;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:22px;
}

.resource-content{
  min-width:0;
  flex:1;
}

.resource-title{
  font-size:18px;
  font-weight:750;
  margin-bottom:6px;
  overflow-wrap:anywhere;
}

.resource-description{
  color:#64748b;
  font-size:14px;
  margin-bottom:12px;
}

.meta{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
  margin-bottom:15px;
}

.badge{
  display:inline-flex;
  align-items:center;
  gap:5px;
  background:#f1f5f9;
  color:#475569;
  border-radius:20px;
  padding:5px 9px;
  font-size:11px;
  font-weight:700;
}

.badge.free{
  background:#dcfce7;
  color:#15803d;
}

.badge.premium{
  background:#fef3c7;
  color:#b45309;
}

.download-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  background:#2563eb;
  color:#fff;
  text-decoration:none;
  border:0;
  border-radius:9px;
  padding:10px 14px;
  font-size:13px;
  font-weight:700;
  cursor:pointer;
}

.download-btn:hover{
  background:#1d4ed8;
}

.premium-btn{
  background:#f59e0b;
}

.premium-btn:hover{
  background:#d97706;
}

.unavailable{
  color:#94a3b8;
  font-size:13px;
}

.loading,
.empty,
.error{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:16px;
  padding:55px 20px;
  text-align:center;
  color:#64748b;
}

.loading i,
.empty i,
.error i{
  font-size:30px;
  margin-bottom:12px;
}

.empty h3,
.error h3{
  color:#172033;
  margin-bottom:6px;
}

.retry-btn{
  margin-top:16px;
  border:0;
  background:#2563eb;
  color:#fff;
  padding:10px 16px;
  border-radius:9px;
  cursor:pointer;
  font-weight:600;
}

footer{
  background:#fff;
  border-top:1px solid #e5e7eb;
  padding:25px 20px;
  text-align:center;
  color:#64748b;
  font-size:13px;
}

@media(max-width:650px){

  .hero{
    padding:40px 15px;
  }

  .hero h1{
    font-size:29px;
  }

  .container{
    width:94%;
  }

  .resource-card{
    padding:16px;
  }

  .resource-icon{
    flex-basis:44px;
    width:44px;
    height:44px;
    font-size:18px;
  }

}

</style>
</head>

<body>

<header>

  <nav class="nav">

    <a
      class="logo"
      href="/"
    >
      LetsStudy <span>Pro</span>
    </a>

    <a
      class="home-btn"
      href="/courses.html"
    >
      <i class="fa-solid fa-arrow-left"></i>
      Courses
    </a>

  </nav>

</header>


<section class="hero">

  <div class="hero-inner">

    <div class="eyebrow">
      Learning Resources
    </div>

    <h1>
      Course Resources
    </h1>

    <p>
      Access and download learning materials
      provided for this course.
    </p>

  </div>

</section>


<main class="container">

  <section
    id="courseInfo"
    class="course-info"
  >

    <div
      id="courseTitle"
      class="course-title"
    ></div>

    <div
      id="courseDescription"
      class="course-description"
    ></div>

  </section>


  <section class="toolbar">

    <div class="search">

      <i class="fa-solid fa-magnifying-glass"></i>

      <input
        id="searchInput"
        type="search"
        placeholder="Search course resources..."
        autocomplete="off"
      >

    </div>

    <div
      id="count"
      class="count"
    >
      Loading...
    </div>

  </section>


  <section
    id="resources"
    class="grid"
  >

    <div class="loading">

      <i class="fa-solid fa-spinner fa-spin"></i>

      <p>
        Loading course resources...
      </p>

    </div>

  </section>

</main>


<footer>

  © <span id="year"></span>
  LetsStudy Pro. All rights reserved.

</footer>


<script>

"use strict";


/* ================= CONFIG ================= */

const API_BASE = "/api/data";


/* ================= STATE ================= */

let allResources = [];


/* ================= PARAMS ================= */

const params =
  new URLSearchParams(
    window.location.search
  );

const courseId =
  params.get("courseId") ||
  params.get("id");


/* ================= DOM ================= */

const resourcesEl =
  document.getElementById(
    "resources"
  );

const searchEl =
  document.getElementById(
    "searchInput"
  );

const countEl =
  document.getElementById(
    "count"
  );

const courseInfoEl =
  document.getElementById(
    "courseInfo"
  );

const courseTitleEl =
  document.getElementById(
    "courseTitle"
  );

const courseDescriptionEl =
  document.getElementById(
    "courseDescription"
  );


document.getElementById(
  "year"
).textContent =
  new Date().getFullYear();


/* ================= ESCAPE ================= */

function escapeHTML(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


/* ================= SAFE URL ================= */

function safeURL(value){

  const url =
    String(value || "").trim();

  if(
    url.startsWith("https://") ||
    url.startsWith("http://")
  ){

    return url;

  }

  return "";

}


/* ================= RESOURCE URL ================= */

function getFileURL(resource){

  return safeURL(
    resource.downloadUrl ||
    resource.downloadURL ||
    resource.fileUrl ||
    resource.fileURL ||
    resource.url ||
    resource.downloadLink ||
    resource.link ||
    ""
  );

}


/* ================= ACCESS ================= */

function getAccess(resource){

  return String(
    resource.access ||
    resource.plan ||
    resource.visibility ||
    "free"
  ).toLowerCase();

}


/* ================= LOAD COURSE ================= */

async function loadCourse(){

  if(!courseId){
    return;
  }

  try{

    const response =
      await fetch(
        `${API_BASE}?collection=courses&id=${encodeURIComponent(courseId)}`,
        {
          headers:{
            "Accept":"application/json"
          }
        }
      );


    if(!response.ok){
      return;
    }


    const result =
      await response.json();


    if(
      !result.success ||
      !result.data
    ){
      return;
    }


    const course =
      result.data;


    const title =
      course.title ||
      course.name ||
      "Course";


    const description =
      course.description ||
      course.shortDescription ||
      "";


    courseTitleEl.textContent =
      title;


    courseDescriptionEl.textContent =
      description;


    courseInfoEl.classList.add(
      "show"
    );


  }catch(error){

    console.error(
      "COURSE API ERROR:",
      error
    );

  }

}


/* ================= LOAD RESOURCES ================= */

async function loadResources(){

  resourcesEl.innerHTML = `

    <div class="loading">

      <i class="
        fa-solid
        fa-spinner
        fa-spin
      "></i>

      <p>
        Loading course resources...
      </p>

    </div>

  `;


  if(!courseId){

    showEmpty(
      "Course ID is missing."
    );

    return;

  }


  try{

    const response =
      await fetch(
        `${API_BASE}?collection=courseResources&courseId=${encodeURIComponent(courseId)}&limit=100`,
        {
          headers:{
            "Accept":"application/json"
          }
        }
      );


    if(!response.ok){

      throw new Error(
        `HTTP ${response.status}`
      );

    }


    const result =
      await response.json();


    if(!result.success){

      throw new Error(
        result.error ||
        "API request failed"
      );

    }


    allResources =
      Array.isArray(result.results)
        ? result.results
        : [];


    /*
      Support databases where the
      API returns all course resources
      but the course ID field has
      different names.
    */

    allResources =
      allResources.filter(resource => {

        const owner =
          resource.courseId ||
          resource.courseID ||
          resource.parentCourseId ||
          resource.course;


        if(!owner){
          return true;
        }


        return String(owner) ===
          String(courseId);

      });


    render();

  }catch(error){

    console.error(
      "RESOURCE API ERROR:",
      error
    );


    resourcesEl.innerHTML = `

      <div class="error">

        <i class="
          fa-solid
          fa-triangle-exclamation
        "></i>

        <h3>
          Unable to load resources
        </h3>

        <p>
          Please try again.
        </p>

        <button
          class="retry-btn"
          onclick="loadResources()"
        >
          Try Again
        </button>

      </div>

    `;

    countEl.textContent =
      "Error";

  }

}


/* ================= RENDER ================= */

function render(){

  const keyword =
    searchEl.value
      .trim()
      .toLowerCase();


  const filtered =
    allResources.filter(resource => {

      const text = [

        resource.title,
        resource.name,
        resource.description,
        resource.subject,
        resource.category,
        resource.type,
        resource.fileType

      ]
      .filter(Boolean)
      .join(" ")
      .toLowerCase();


      return text.includes(
        keyword
      );

    });


  countEl.textContent =
    `${filtered.length} resource${
      filtered.length === 1
        ? ""
        : "s"
    }`;


  if(!filtered.length){

    showEmpty(
      keyword
        ? "No resources match your search."
        : "No resources are available for this course."
    );

    return;

  }


  resourcesEl.innerHTML =
    filtered
      .map(
        createCard
      )
      .join("");

}


/* ================= CARD ================= */

function createCard(resource){

  const title =
    resource.title ||
    resource.name ||
    "Course Resource";


  const description =
    resource.description ||
    resource.shortDescription ||
    "";


  const fileURL =
    getFileURL(resource);


  const type =
    resource.fileType ||
    resource.format ||
    resource.type ||
    "File";


  const size =
    resource.fileSize ||
    resource.size ||
    "";


  const access =
    getAccess(resource);


  const free =
    access === "free" ||
    access === "public";


  const premium =
    access === "premium" ||
    access === "paid" ||
    access === "plan";


  let action = "";


  if(fileURL && free){

    action = `

      <a
        class="download-btn"
        href="${escapeHTML(fileURL)}"
        target="_blank"
        rel="noopener noreferrer"
        download
      >

        <i class="
          fa-solid
          fa-download
        "></i>

        Download

      </a>

    `;

  }
  else if(fileURL && premium){

    action = `

      <a
        class="
          download-btn
          premium-btn
        "
        href="/premium.html"
      >

        <i class="
          fa-solid
          fa-lock
        "></i>

        Premium Access

      </a>

    `;

  }
  else{

    action = `

      <span class="unavailable">
        File unavailable
      </span>

    `;

  }


  return `

    <article class="resource-card">

      <div class="resource-icon">

        <i class="
          fa-solid
          fa-file-arrow-down
        "></i>

      </div>


      <div class="resource-content">

        <h2 class="resource-title">

          ${escapeHTML(title)}

        </h2>


        ${
          description
            ? `
              <p class="resource-description">
                ${escapeHTML(description)}
              </p>
            `
            : ""
        }


        <div class="meta">

          <span class="badge">

            <i class="
              fa-solid
              fa-file
            "></i>

            ${escapeHTML(type)}

          </span>


          ${
            size
              ? `
                <span class="badge">
                  ${escapeHTML(size)}
                </span>
              `
              : ""
          }


          ${
            free
              ? `
                <span class="badge free">
                  FREE
                </span>
              `
              : ""
          }


          ${
            premium
              ? `
                <span class="badge premium">
                  PREMIUM
                </span>
              `
              : ""
          }

        </div>


        ${action}

      </div>

    </article>

  `;

}


/* ================= EMPTY ================= */

function showEmpty(message){

  resourcesEl.innerHTML = `

    <div class="empty">

      <i class="
        fa-solid
        fa-folder-open
      "></i>

      <h3>
        No resources
      </h3>

      <p>
        ${escapeHTML(message)}
      </p>

    </div>

  `;

  countEl.textContent =
    "0 resources";

}


/* ================= SEARCH ================= */

searchEl.addEventListener(
  "input",
  render
);


/* ================= START ================= */

loadCourse();

loadResources();

</script>

</body>
</html>