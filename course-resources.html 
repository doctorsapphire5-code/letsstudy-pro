<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
>

<title>Course Resources | LetsStudy Pro</title>

<meta
  name="description"
  content="Access notes, documents, links and other learning resources for your course on LetsStudy Pro."
>

<meta
  name="robots"
  content="index,follow"
>

<link
  rel="canonical"
  href="https://letsstudy.pro/course-resources.html"
>

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:
    Arial,
    Helvetica,
    sans-serif;

  background:#f5f7fb;
  color:#111827;
}

button,
input{
  font:inherit;
}


/* =====================================================
   HEADER
===================================================== */

.header{
  min-height:70px;

  background:#fff;

  border-bottom:
    1px solid #e5e7eb;

  display:flex;

  align-items:center;

  justify-content:space-between;

  gap:15px;

  padding:
    0 25px;

  position:sticky;

  top:0;

  z-index:100;
}

.logo{
  font-size:22px;

  font-weight:800;

  white-space:nowrap;
}

.logo span{
  color:#2563eb;
}

.back-btn{
  text-decoration:none;

  background:#eff6ff;

  color:#2563eb;

  padding:
    10px 15px;

  border-radius:9px;

  font-weight:700;

  transition:.2s;
}

.back-btn:hover{
  background:#dbeafe;
}


/* =====================================================
   CONTAINER
===================================================== */

.container{
  max-width:1100px;

  margin:auto;

  padding:
    30px 18px 50px;
}


/* =====================================================
   HERO
===================================================== */

.hero{
  background:
    linear-gradient(
      135deg,
      #2563eb,
      #4f46e5
    );

  color:white;

  padding:30px;

  border-radius:18px;

  margin-bottom:25px;
}

.hero h1{
  font-size:30px;

  margin-bottom:8px;

  line-height:1.25;
}

.hero p{
  line-height:1.6;

  opacity:.92;

  max-width:760px;
}

.course-info{
  margin-top:15px;

  font-size:14px;

  opacity:.9;
}

.course-id{
  margin-top:8px;

  font-size:12px;

  opacity:.78;

  word-break:break-all;
}


/* =====================================================
   SEARCH
===================================================== */

.search-box{
  background:#fff;

  border:
    1px solid #e5e7eb;

  border-radius:13px;

  padding:15px;

  margin-bottom:20px;
}

.search-box input{
  width:100%;

  padding:
    13px 15px;

  border:
    1px solid #d1d5db;

  border-radius:9px;

  outline:none;

  background:#fff;
}

.search-box input:focus{
  border-color:#2563eb;

  box-shadow:
    0 0 0 3px
    rgba(37,99,235,.08);
}


/* =====================================================
   RESOURCES
===================================================== */

.resources{
  display:grid;

  grid-template-columns:
    repeat(3,1fr);

  gap:18px;
}

.resource-card{
  background:#fff;

  border:
    1px solid #e5e7eb;

  border-radius:15px;

  padding:20px;

  transition:.2s;

  display:flex;

  flex-direction:column;

  min-width:0;
}

.resource-card:hover{
  transform:
    translateY(-2px);

  box-shadow:
    0 10px 25px
    rgba(15,23,42,.08);
}

.resource-icon{
  width:52px;

  height:52px;

  display:flex;

  align-items:center;

  justify-content:center;

  background:#eff6ff;

  border-radius:12px;

  font-size:25px;

  margin-bottom:15px;
}

.resource-type{
  display:inline-block;

  align-self:flex-start;

  background:#f1f5f9;

  color:#475569;

  padding:
    5px 9px;

  border-radius:20px;

  font-size:11px;

  font-weight:800;

  text-transform:uppercase;

  margin-bottom:10px;
}

.resource-name{
  font-size:18px;

  font-weight:800;

  line-height:1.4;

  margin-bottom:8px;

  overflow-wrap:anywhere;
}

.resource-description{
  color:#64748b;

  font-size:14px;

  line-height:1.6;

  margin-bottom:18px;

  flex:1;

  overflow-wrap:anywhere;
}

.resource-meta{
  color:#94a3b8;

  font-size:12px;

  margin-bottom:14px;

  line-height:1.5;
}

.open-btn{
  display:block;

  text-align:center;

  text-decoration:none;

  background:#2563eb;

  color:white;

  padding:
    11px 14px;

  border-radius:9px;

  font-weight:700;

  transition:.2s;
}

.open-btn:hover{
  background:#1d4ed8;
}


/* =====================================================
   STATES
===================================================== */

.loading,
.empty,
.error{
  background:#fff;

  border-radius:15px;

  padding:
    45px 20px;

  text-align:center;

  border:
    1px solid #e5e7eb;

  grid-column:
    1 / -1;
}

.loading{
  color:#64748b;
}

.empty{
  color:#64748b;
}

.empty h3{
  color:#111827;

  margin-bottom:7px;
}

.error{
  background:#fee2e2;

  color:#991b1b;

  border-color:#fecaca;
}

.error h3{
  margin-bottom:7px;
}

.retry-btn{
  margin-top:16px;

  border:0;

  background:#2563eb;

  color:#fff;

  padding:
    11px 18px;

  border-radius:9px;

  font-weight:700;

  cursor:pointer;
}

.retry-btn:hover{
  background:#1d4ed8;
}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width:850px){

  .resources{
    grid-template-columns:
      repeat(2,1fr);
  }

}


@media(max-width:600px){

  .header{
    padding:
      0 15px;
  }

  .logo{
    font-size:19px;
  }

  .back-btn{
    padding:
      9px 12px;

    font-size:13px;
  }

  .container{
    padding:
      20px 12px 40px;
  }

  .hero{
    padding:23px;
  }

  .hero h1{
    font-size:25px;
  }

  .hero p{
    font-size:14px;
  }

  .resources{
    grid-template-columns:1fr;
  }

}

</style>

</head>


<body>


<header class="header">

  <div class="logo">

    LetsStudy <span>Pro</span>

  </div>


  <a
    href="#"
    id="backBtn"
    class="back-btn"
  >

    ← Back to Course

  </a>

</header>


<main class="container">


  <!-- =================================================
       HERO
  ================================================== -->

  <section class="hero">

    <h1>
      Course Resources
    </h1>

    <p id="heroDescription">

      Access notes, documents, links and other
      learning resources for this course.

    </p>


    <div
      class="course-info"
      id="courseInfo"
    >

      Loading course...

    </div>


    <div
      class="course-id"
      id="courseIdBox"
    >

      Course ID: —

    </div>

  </section>


  <!-- =================================================
       SEARCH
  ================================================== -->

  <div class="search-box">

    <input
      type="search"
      id="searchInput"
      placeholder="Search resources..."
      autocomplete="off"
      aria-label="Search course resources"
    >

  </div>


  <!-- =================================================
       RESOURCE LIST
  ================================================== -->

  <section
    id="resourceList"
    class="resources"
    aria-live="polite"
  >

    <div class="loading">

      Loading resources...

    </div>

  </section>


</main>


<script type="module">


/* =====================================================
   FIREBASE IMPORTS
===================================================== */

import {
  initializeApp
}
from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";


import {
  getFirestore,
  collection,
  getDocs,
  query,
  where,
  doc,
  getDoc
}
from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";


/* =====================================================
   FIREBASE CONFIG
===================================================== */

const firebaseConfig = {

  apiKey:
    "AIzaSyBcOYDfAVK5XbkljsyRgI_0rj0odBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-85B7V5H5J0"

};


/* =====================================================
   INITIALIZE
===================================================== */

const app =
  initializeApp(
    firebaseConfig
  );


const db =
  getFirestore(
    app
  );


/* =====================================================
   ELEMENTS
===================================================== */

const resourceList =
  document.getElementById(
    "resourceList"
  );


const searchInput =
  document.getElementById(
    "searchInput"
  );


const courseInfo =
  document.getElementById(
    "courseInfo"
  );


const courseIdBox =
  document.getElementById(
    "courseIdBox"
  );


const heroDescription =
  document.getElementById(
    "heroDescription"
  );


const backBtn =
  document.getElementById(
    "backBtn"
  );


/* =====================================================
   COURSE ID
===================================================== */

const params =
  new URLSearchParams(
    window.location.search
  );


const courseId =
  (
    params.get("courseId") ||
    params.get("courseID") ||
    params.get("id") ||
    params.get("course") ||
    ""
  ).trim();


/* =====================================================
   DATA
===================================================== */

let resources = [];

let course = null;


/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHTML(
  value
){

  if(
    value === undefined ||
    value === null
  ){

    return "";

  }


  return String(value)

    .replace(
      /&/g,
      "&amp;"
    )

    .replace(
      /</g,
      "&lt;"
    )

    .replace(
      />/g,
      "&gt;"
    )

    .replace(
      /"/g,
      "&quot;"
    )

    .replace(
      /'/g,
      "&#039;"
    );

}


/* =====================================================
   GET VALUE
===================================================== */

function getValue(
  data,
  fields,
  fallback = ""
){

  if(
    !data ||
    typeof data !== "object"
  ){

    return fallback;

  }


  for(
    const field of fields
  ){

    if(
      data[field] !== undefined &&
      data[field] !== null &&
      String(
        data[field]
      ).trim() !== ""
    ){

      return data[field];

    }

  }


  return fallback;

}


/* =====================================================
   RESOURCE ICON
===================================================== */

function resourceIcon(
  type
){

  const value =
    String(
      type || ""
    )
    .toLowerCase();


  if(
    value.includes("pdf")
  ){

    return "📕";

  }


  if(
    value.includes("video") ||
    value.includes("mp4") ||
    value.includes("youtube")
  ){

    return "🎬";

  }


  if(
    value.includes("audio") ||
    value.includes("mp3")
  ){

    return "🎧";

  }


  if(
    value.includes("image") ||
    value.includes("jpg") ||
    value.includes("jpeg") ||
    value.includes("png") ||
    value.includes("webp")
  ){

    return "🖼️";

  }


  if(
    value.includes("link") ||
    value.includes("url") ||
    value.includes("website")
  ){

    return "🔗";

  }


  if(
    value.includes("document") ||
    value.includes("doc") ||
    value.includes("word")
  ){

    return "📄";

  }


  if(
    value.includes("spreadsheet") ||
    value.includes("excel") ||
    value.includes("xlsx")
  ){

    return "📊";

  }


  if(
    value.includes("presentation") ||
    value.includes("powerpoint") ||
    value.includes("ppt")
  ){

    return "📑";

  }


  return "📁";

}


/* =====================================================
   DATE TIME
===================================================== */

function getTime(
  value
){

  if(
    value === undefined ||
    value === null ||
    value === ""
  ){

    return 0;

  }


  try{

    if(
      typeof value === "object" &&
      typeof value.toDate === "function"
    ){

      return value
        .toDate()
        .getTime();

    }


    if(
      typeof value === "object" &&
      value.seconds !== undefined
    ){

      return Number(
        value.seconds
      ) * 1000;

    }


    if(
      value instanceof Date
    ){

      return value.getTime();

    }


    const date =
      new Date(value);


    const time =
      date.getTime();


    return Number.isNaN(time)
      ? 0
      : time;

  }catch(error){

    return 0;

  }

}


/* =====================================================
   FORMAT DATE
===================================================== */

function formatDate(
  value
){

  const time =
    getTime(value);


  if(
    !time
  ){

    return "";

  }


  try{

    return new Date(
      time
    ).toLocaleDateString(
      undefined,
      {
        year:"numeric",
        month:"short",
        day:"numeric"
      }
    );

  }catch(error){

    return "";

  }

}


/* =====================================================
   CLEAN URL
===================================================== */

function cleanUrl(
  value
){

  if(
    value === undefined ||
    value === null
  ){

    return "";

  }


  let url =
    String(value).trim();


  if(
    !url
  ){

    return "";

  }


  /*
    Allow normal http/https URLs.
  */

  if(
    /^https?:\/\//i.test(
      url
    )
  ){

    return url;

  }


  /*
    Support www.example.com
    and domain.com
  */

  if(
    /^[a-z0-9.-]+\.[a-z]{2,}(\/.*)?$/i.test(
      url
    )
  ){

    return (
      "https://" +
      url
    );

  }


  return "";

}


/* =====================================================
   LOAD COURSE
===================================================== */

async function loadCourse(){

  /*
    Course ID is required.

    NEVER load all courses
    or use the first course.
  */

  if(
    !courseId
  ){

    courseInfo.textContent =
      "Course ID is missing.";

    courseIdBox.textContent =
      "Course ID: —";


    resourceList.innerHTML = `

      <div class="error">

        <h3>
          Course ID is required
        </h3>

        <p>
          Please open this page using
          ?courseId=COURSE_ID
        </p>

      </div>

    `;

    return false;

  }


  try{

    /*
      Read ONLY the requested
      course document.
    */

    const courseRef =
      doc(
        db,
        "courses",
        courseId
      );


    const courseSnapshot =
      await getDoc(
        courseRef
      );


    if(
      !courseSnapshot.exists()
    ){

      throw new Error(
        "The requested course could not be found."
      );

    }


    course =
      courseSnapshot.data() || {};


    const title =
      getValue(
        course,
        [
          "title",
          "name",
          "courseTitle",
          "courseName"
        ],
        "Course"
      );


    const description =
      getValue(
        course,
        [
          "description",
          "details",
          "summary"
        ],
        "Access learning resources for this course."
      );


    courseInfo.textContent =
      String(title);


    courseIdBox.textContent =
      `Course ID: ${courseId}`;


    heroDescription.textContent =
      String(description);


    /*
      Update browser title.
    */

    document.title =
      `${title} Resources | LetsStudy Pro`;


    /*
      Back to this exact course.
    */

    backBtn.href =
      `course-learn.html?courseId=${
        encodeURIComponent(
          courseId
        )
      }`;


    return true;

  }catch(error){

    console.error(
      "Course loading error:",
      error
    );


    courseInfo.textContent =
      "Unable to load course.";


    courseIdBox.textContent =
      `Course ID: ${courseId}`;


    resourceList.innerHTML = `

      <div class="error">

        <h3>
          Unable to load course
        </h3>

        <p>
          ${
            escapeHTML(
              error.message ||
              "Please try again later."
            )
          }
        </p>

      </div>

    `;


    return false;

  }

}


/* =====================================================
   LOAD RESOURCES
===================================================== */

async function loadResources(){

  /*
    Do NOT load all resources.

    Only resources belonging
    to the current course.
  */

  if(
    !courseId
  ){

    return;

  }


  resourceList.innerHTML = `

    <div class="loading">

      Loading resources...

    </div>

  `;


  try{

    const resourceQuery =
      query(

        collection(
          db,
          "resources"
        ),

        where(
          "courseId",
          "==",
          courseId
        )

      );


    const snapshot =
      await getDocs(
        resourceQuery
      );


    resources = [];


    snapshot.forEach(
      resourceDoc => {

        const data =
          resourceDoc.data() || {};


        /*
          Extra safety check.

          The Firestore query already limits
          the result to the requested course.
        */

        if(
          String(
            data.courseId ||
            ""
          ).trim() !==
          String(courseId)
        ){

          return;

        }


        resources.push({

          id:
            resourceDoc.id,

          ...data

        });

      }
    );


    /*
      Newest first.
    */

    resources.sort(
      (a,b) => {

        return (
          getTime(
            b.createdAt
          ) -
          getTime(
            a.createdAt
          )
        );

      }
    );


    renderResources();

  }catch(error){

    console.error(
      "Resources loading error:",
      error
    );


    resourceList.innerHTML = `

      <div class="error">

        <h3>
          Unable to load resources
        </h3>

        <p>
          ${
            escapeHTML(
              error.message ||
              "Please try again later."
            )
          }
        </p>

        <button
          class="retry-btn"
          id="retryResourcesBtn"
          type="button"
        >
          Try Again
        </button>

      </div>

    `;


    const retry =
      document.getElementById(
        "retryResourcesBtn"
      );


    if(retry){

      retry.addEventListener(
        "click",
        loadResources
      );

    }

  }

}


/* =====================================================
   RENDER RESOURCES
===================================================== */

function renderResources(){

  const search =
    searchInput.value
      .trim()
      .toLowerCase();


  const filtered =
    resources.filter(
      resource => {

        const text = [

          getValue(
            resource,
            [
              "name",
              "title",
              "resourceName"
            ]
          ),

          getValue(
            resource,
            [
              "type",
              "resourceType",
              "format"
            ]
          ),

          getValue(
            resource,
            [
              "description",
              "details"
            ]
          ),

          getValue(
            resource,
            [
              "category"
            ]
          )

        ]
        .join(" ")
        .toLowerCase();


        return (
          !search ||
          text.includes(search)
        );

      }
    );


  if(
    filtered.length === 0
  ){

    resourceList.innerHTML = `

      <div class="empty">

        <div
          style="
            font-size:38px;
            margin-bottom:10px;
          "
        >
          📚
        </div>

        <h3>
          No resources found
        </h3>

        <p>
          ${
            search
              ? "No resources match your search."
              : "There are currently no resources available for this course."
          }
        </p>

      </div>

    `;

    return;

  }


  resourceList.innerHTML =
filtered
.map(
(resource) => `
<article class="resource-card">
<div class="resource-icon">
<i class="${resourceIcon(resource.type)}"></i>
</div>

      <div class="resource-content">
        <div class="resource-top">
          <span class="resource-type">
            ${escapeHtml(resource.type || "Resource")}
          </span>

          <span class="resource-date">
            ${escapeHtml(getTime(resource.createdAt))}
          </span>
        </div>

        <h3>
          ${escapeHtml(resource.name || "Untitled Resource")}
        </h3>

        <p>
          ${escapeHtml(
            resource.description || "No description available."
          )}
        </p>

        <div class="resource-meta">
          ${
            resource.createdBy
              ? `
                <span>
                  <i class="fas fa-user"></i>
                  ${escapeHtml(resource.createdBy)}
                </span>
              `
              : ""
          }

          <span>
            <i class="fas fa-file-alt"></i>
            Course Resource
          </span>
        </div>

        ${
          resource.url
            ? `
              <a
                class="resource-btn"
                href="${escapeAttribute(resource.url)}"
                target="_blank"
                rel="noopener noreferrer"
              >
                <i class="fas fa-external-link-alt"></i>
                Open Resource
              </a>
            `
            : `
              <button class="resource-btn disabled" disabled>
                <i class="fas fa-ban"></i>
                Resource Unavailable
              </button>
            `
        }
      </div>
    </article>
  `
)
.join("");

resourceCount.textContent = filtered.length;

if (!filtered.length) {
resourceList.innerHTML = `
<div class="empty-state">
<div class="empty-icon">
<i class="fas fa-folder-open"></i>
</div>

    <h3>No Resources Found</h3>

    <p>
      ${
        searchTerm
          ? "No resources match your search."
          : "There are currently no resources available for this course."
      }
    </p>

    ${
      searchTerm
        ? `
          <button class="retry-btn" onclick="clearSearch()">
            <i class="fas fa-times"></i>
            Clear Search
          </button>
        `
        : ""
    }
  </div>
`;

}
}

function clearSearch() {
const searchInput = document.getElementById("searchInput");

if (searchInput) {
searchInput.value = "";
}

searchTerm = "";
renderResources();
}

function escapeHtml(value) {
return String(value ?? "")
.replace(/&/g, "&")
.replace(/</g, "<")
.replace(/>/g, ">")
.replace(/"/g, """)
.replace(/'/g, "'");
}

function escapeAttribute(value) {
return String(value ?? "")
.replace(/&/g, "&")
.replace(/"/g, """)
.replace(/</g, "<")
.replace(/>/g, ">");
}

function resourceIcon(type) {
const value = String(type || "").toLowerCase();

if (value.includes("pdf")) {
return "fas fa-file-pdf";
}

if (
value.includes("video") ||
value.includes("mp4") ||
value.includes("youtube")
) {
return "fas fa-video";
}

if (
value.includes("audio") ||
value.includes("mp3") ||
value.includes("podcast")
) {
return "fas fa-headphones";
}

if (
value.includes("image") ||
value.includes("jpg") ||
value.includes("jpeg") ||
value.includes("png")
) {
return "fas fa-image";
}

if (
value.includes("spreadsheet") ||
value.includes("excel") ||
value.includes("xlsx")
) {
return "fas fa-file-excel";
}

if (
value.includes("presentation") ||
value.includes("powerpoint") ||
value.includes("ppt")
) {
return "fas fa-file-powerpoint";
}

if (
value.includes("document") ||
value.includes("word") ||
value.includes("doc")
) {
return "fas fa-file-word";
}

if (
value.includes("link") ||
value.includes("url") ||
value.includes("website")
) {
return "fas fa-link";
}

return "fas fa-file-alt";
}

function getTime(value) {
if (!value) return "Recently added";

try {
if (typeof value.toDate === "function") {
return value.toDate().toLocaleDateString();
}

if (
  typeof value === "object" &&
  typeof value.seconds === "number"
) {
  return new Date(value.seconds * 1000).toLocaleDateString();
}

if (value instanceof Date) {
  return value.toLocaleDateString();
}

const date = new Date(value);

if (!Number.isNaN(date.getTime())) {
  return date.toLocaleDateString();
}

} catch (error) {
console.warn("Unable to format resource date:", error);
}

return "Recently added";
}

function showError(message) {
resourceList.innerHTML = `
<div class="empty-state error-state">
<div class="empty-icon">
<i class="fas fa-exclamation-triangle"></i>
</div>

  <h3>Unable to Load Resources</h3>

  <p>${escapeHtml(message)}</p>

  <button class="retry-btn" onclick="loadResources()">
    <i class="fas fa-redo"></i>
    Try Again
  </button>
</div>

`;
}

window.clearSearch = clearSearch;
window.loadResources = loadResources;

if (searchInput) {
searchInput.addEventListener("input", (event) => {
searchTerm = event.target.value.trim().toLowerCase();
renderResources();
});
}

if (backButton) {
backButton.addEventListener("click", () => {
if (courseId) {
window.location.href =
"course-learn.html?courseId=${encodeURIComponent(courseId)}";
} else {
window.history.back();
}
});
}

loadCourseAndResources();
</script>

