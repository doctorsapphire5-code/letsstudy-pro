<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Course Resources | LetsStudy Pro</title>

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#f5f7fb;
  color:#111827;
}

.header{
  height:70px;
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 25px;
  position:sticky;
  top:0;
  z-index:100;
}

.logo{
  font-size:22px;
  font-weight:800;
}

.logo span{
  color:#2563eb;
}

.back-btn{
  text-decoration:none;
  background:#eff6ff;
  color:#2563eb;
  padding:10px 15px;
  border-radius:9px;
  font-weight:700;
}

.container{
  max-width:1100px;
  margin:auto;
  padding:30px 18px 50px;
}

.hero{
  background:linear-gradient(135deg,#2563eb,#4f46e5);
  color:white;
  padding:30px;
  border-radius:18px;
  margin-bottom:25px;
}

.hero h1{
  font-size:30px;
  margin-bottom:8px;
}

.hero p{
  line-height:1.6;
  opacity:.92;
}

.course-info{
  margin-top:15px;
  font-size:14px;
  opacity:.9;
}

.search-box{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:13px;
  padding:15px;
  margin-bottom:20px;
}

.search-box input{
  width:100%;
  padding:13px 15px;
  border:1px solid #d1d5db;
  border-radius:9px;
  outline:none;
}

.search-box input:focus{
  border-color:#2563eb;
}

.resources{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.resource-card{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:15px;
  padding:20px;
  transition:.2s;
  display:flex;
  flex-direction:column;
}

.resource-card:hover{
  transform:translateY(-2px);
  box-shadow:0 10px 25px rgba(15,23,42,.08);
}

.resource-icon{
  width:52px;
  height:52px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#eff6ff;
  border-radius:12px;
  font-size:25px;
  margin-bottom:15px;
}

.resource-type{
  display:inline-block;
  align-self:flex-start;
  background:#f1f5f9;
  color:#475569;
  padding:5px 9px;
  border-radius:20px;
  font-size:11px;
  font-weight:800;
  text-transform:uppercase;
  margin-bottom:10px;
}

.resource-name{
  font-size:18px;
  font-weight:800;
  line-height:1.4;
  margin-bottom:8px;
}

.resource-description{
  color:#64748b;
  font-size:14px;
  line-height:1.6;
  margin-bottom:18px;
  flex:1;
}

.resource-meta{
  color:#94a3b8;
  font-size:12px;
  margin-bottom:14px;
}

.open-btn{
  display:block;
  text-align:center;
  text-decoration:none;
  background:#2563eb;
  color:white;
  padding:11px 14px;
  border-radius:9px;
  font-weight:700;
}

.open-btn:hover{
  background:#1d4ed8;
}

.loading,
.empty,
.error{
  background:#fff;
  border-radius:15px;
  padding:45px 20px;
  text-align:center;
  border:1px solid #e5e7eb;
}

.loading{
  color:#64748b;
}

.empty{
  color:#64748b;
}

.error{
  background:#fee2e2;
  color:#991b1b;
  border-color:#fecaca;
}

@media(max-width:850px){

  .resources{
    grid-template-columns:repeat(2,1fr);
  }

}

@media(max-width:600px){

  .header{
    padding:0 15px;
  }

  .logo{
    font-size:19px;
  }

  .container{
    padding:20px 12px 40px;
  }

  .hero{
    padding:23px;
  }

  .hero h1{
    font-size:25px;
  }

  .resources{
    grid-template-columns:1fr;
  }

}

</style>

</head>

<body>


<header class="header">

  <div class="logo">
    LetsStudy <span>Pro</span>
  </div>

  <a
    href="course-learn.html"
    class="back-btn">

    ← Back to Course

  </a>

</header>


<main class="container">


  <section class="hero">

    <h1>
      Course Resources
    </h1>

    <p>
      Access notes, documents, links and other
      learning resources for this course.
    </p>

    <div
      class="course-info"
      id="courseInfo">

      Loading course resources...

    </div>

  </section>


  <div class="search-box">

    <input
      type="search"
      id="searchInput"
      placeholder="Search resources...">

  </div>


  <section
    id="resourceList"
    class="resources">

    <div class="loading">

      Loading resources...

    </div>

  </section>


</main>


<script type="module">

import {
  initializeApp
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";


import {
  getFirestore,
  collection,
  getDocs,
  query,
  where
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";


/* =====================================================
   FIREBASE
===================================================== */

const firebaseConfig = {

  apiKey:
    "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-85B7V5H5J0"

};


const app =
  initializeApp(firebaseConfig);


const db =
  getFirestore(app);


/* =====================================================
   ELEMENTS
===================================================== */

const resourceList =
  document.getElementById(
    "resourceList"
  );

const searchInput =
  document.getElementById(
    "searchInput"
  );

const courseInfo =
  document.getElementById(
    "courseInfo"
  );


/* =====================================================
   COURSE ID
===================================================== */

const params =
  new URLSearchParams(
    window.location.search
  );


const courseId =
  params.get("courseId") ||
  params.get("id");


/* =====================================================
   DATA
===================================================== */

let resources = [];


/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHTML(value){

  if(
    value === undefined ||
    value === null
  ){

    return "";

  }

  return String(value)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


/* =====================================================
   RESOURCE ICON
===================================================== */

function resourceIcon(type){

  const value =
    String(
      type || ""
    ).toLowerCase();


  if(
    value.includes("pdf")
  ){

    return "📕";

  }


  if(
    value.includes("video") ||
    value.includes("mp4")
  ){

    return "🎬";

  }


  if(
    value.includes("audio") ||
    value.includes("mp3")
  ){

    return "🎧";

  }


  if(
    value.includes("image") ||
    value.includes("jpg") ||
    value.includes("png")
  ){

    return "🖼️";

  }


  if(
    value.includes("link") ||
    value.includes("url")
  ){

    return "🔗";

  }


  if(
    value.includes("document") ||
    value.includes("doc")
  ){

    return "📄";

  }


  return "📁";

}


/* =====================================================
   DATE
===================================================== */

function formatDate(value){

  if(!value){

    return "";

  }

  try{

    let date;


    if(
      typeof value === "object" &&
      value.seconds
    ){

      date =
        new Date(
          value.seconds * 1000
        );

    }else{

      date =
        new Date(value);

    }


    if(
      Number.isNaN(
        date.getTime()
      )
    ){

      return "";

    }


    return date.toLocaleDateString(
      undefined,
      {
        year:"numeric",
        month:"short",
        day:"numeric"
      }
    );

  }catch(error){

    return "";

  }

}


/* =====================================================
   CLEAN URL
===================================================== */

function cleanUrl(url){

  if(!url){

    return "#";

  }


  url =
    String(url).trim();


  if(
    !/^https?:\/\//i.test(url)
  ){

    url =
      "https://" + url;

  }


  return url;

}


/* =====================================================
   LOAD RESOURCES
===================================================== */

async function loadResources(){

  try{

    let snapshot;


    if(courseId){

      const resourceQuery =
        query(

          collection(
            db,
            "resources"
          ),

          where(
            "courseId",
            "==",
            courseId
          )

        );


      snapshot =
        await getDocs(
          resourceQuery
        );

    }else{

      snapshot =
        await getDocs(
          collection(
            db,
            "resources"
          )
        );

    }


    resources = [];


    snapshot.forEach(
      resourceDoc => {

        resources.push({

          id:
            resourceDoc.id,

          ...resourceDoc.data()

        });

      }
    );


    resources.sort(
      (a,b) => {

        const dateA =
          getTime(
            a.createdAt
          );

        const dateB =
          getTime(
            b.createdAt
          );

        return dateB - dateA;

      }
    );


    courseInfo.textContent =
      courseId
      ? `Course ID: ${courseId} • ${resources.length} resource${resources.length === 1 ? "" : "s"}`
      : `All resources • ${resources.length} resource${resources.length === 1 ? "" : "s"}`;


    renderResources();

  }catch(error){

    console.error(
      "Resources loading error:",
      error
    );


    resourceList.innerHTML = `

      <div class="error">

        Unable to load course resources.
        Please try again.

      </div>

    `;

  }

}


/* =====================================================
   TIME
===================================================== */

function getTime(value){

  if(!value){

    return 0;

  }


  try{

    if(
      typeof value === "object" &&
      value.seconds
    ){

      return (
        Number(value.seconds) * 1000
      );

    }


    const date =
      new Date(value);


    return (
      date.getTime() || 0
    );

  }catch(error){

    return 0;

  }

}


/* =====================================================
   RENDER
===================================================== */

function renderResources(){

  const search =
    searchInput.value
      .trim()
      .toLowerCase();


  const filtered =
    resources.filter(
      resource => {

        const text = [

          resource.name,

          resource.type,

          resource.description,

          resource.createdBy

        ]
          .filter(Boolean)
          .join(" ")
          .toLowerCase();


        return (
          !search ||
          text.includes(search)
        );

      }
    );


  if(
    filtered.length === 0
  ){

    resourceList.innerHTML = `

      <div class="empty">

        <h3 style="margin-bottom:8px;">
          No resources found
        </h3>

        <p>
          There are currently no resources
          available for this course.
        </p>

      </div>

    `;

    return;

  }


  resourceList.innerHTML =
    filtered.map(
      resource => {

        const name =
          resource.name ||
          "Untitled Resource";


        const type =
          resource.type ||
          "Resource";


        const description =
          resource.description ||
          "No description available.";


        const url =
          cleanUrl(
            resource.url
          );


        return `

          <article
            class="resource-card">

            <div
              class="resource-icon">

              ${resourceIcon(type)}

            </div>


            <span
              class="resource-type">

              ${escapeHTML(type)}

            </span>


            <h2
              class="resource-name">

              ${escapeHTML(name)}

            </h2>


            <p
              class="resource-description">

              ${escapeHTML(
                description
              )}

            </p>


            <div
              class="resource-meta">

              ${
                resource.createdBy
                ?
                `Created by ${escapeHTML(
                  resource.createdBy
                )}`
                :
                ""
              }

              ${
                resource.createdAt
                ?
                ` • ${formatDate(
                  resource.createdAt
                )}`
                :
                ""
              }

            </div>


            <a
              href="${escapeHTML(url)}"
              target="_blank"
              rel="noopener noreferrer"
              class="open-btn">

              Open Resource →

            </a>

          </article>

        `;

      }
    ).join("");

}


/* =====================================================
   SEARCH
===================================================== */

searchInput.addEventListener(
  "input",
  renderResources
);


/* =====================================================
   INITIAL LOAD
===================================================== */

loadResources();

</script>

</body>
</html>