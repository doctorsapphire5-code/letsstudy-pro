<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>Admin Resources | LetsStudy Pro</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>

*{
box-sizing:border-box;
}

body{
margin:0;
font-family:Arial,Helvetica,sans-serif;
background:#f5f7fb;
color:#172033;
}

.container{
max-width:1200px;
margin:auto;
padding:18px;
}

.header{
margin-bottom:18px;
}

.header h1{
margin:0;
font-size:25px;
}

.header p{
margin:6px 0 0;
color:#64748b;
font-size:13px;
}

.card{
background:#fff;
border-radius:16px;
padding:20px;
margin-bottom:18px;
box-shadow:0 4px 18px rgba(0,0,0,.06);
}

.grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:15px;
}

.field{
display:flex;
flex-direction:column;
gap:7px;
}

.full{
grid-column:1/-1;
}

label{
font-size:13px;
font-weight:bold;
color:#334155;
}

input,
select,
textarea{
width:100%;
padding:12px;
border:1px solid #dbe2ea;
border-radius:9px;
font-family:inherit;
outline:none;
background:#fff;
}

textarea{
min-height:120px;
resize:vertical;
}

input:focus,
select:focus,
textarea:focus{
border-color:#2563eb;
}

.actions{
display:flex;
gap:10px;
margin-top:16px;
}

.btn{
border:0;
border-radius:9px;
padding:11px 16px;
font-weight:bold;
cursor:pointer;
}

.primary{
background:#2563eb;
color:#fff;
}

.secondary{
background:#e2e8f0;
color:#334155;
}

.search{
margin-bottom:15px;
}

.search input{
max-width:450px;
}

.resource-list{
display:grid;
gap:12px;
}

.resource{
display:flex;
justify-content:space-between;
align-items:flex-start;
gap:15px;
padding:16px;
border:1px solid #e5e7eb;
border-radius:13px;
}

.resource h3{
margin:0 0 8px;
font-size:17px;
}

.resource p{
margin:0 0 10px;
color:#64748b;
font-size:13px;
line-height:1.6;
}

.meta{
display:flex;
gap:7px;
flex-wrap:wrap;
}

.badge{
display:inline-flex;
align-items:center;
gap:5px;
padding:6px 9px;
border-radius:20px;
background:#f1f5f9;
color:#475569;
font-size:11px;
}

.actions-list{
display:flex;
gap:7px;
}

.icon-btn{
width:38px;
height:38px;
border:0;
border-radius:8px;
cursor:pointer;
background:#f1f5f9;
}

.edit{
color:#2563eb;
}

.delete{
color:#dc2626;
}

.message{
display:none;
padding:12px;
border-radius:9px;
margin-bottom:15px;
font-size:13px;
}

.message.success{
display:block;
background:#dcfce7;
color:#166534;
}

.message.error{
display:block;
background:#fee2e2;
color:#991b1b;
}

.loading,
.empty{
text-align:center;
padding:40px 20px;
color:#64748b;
}

@media(max-width:700px){

.grid{
grid-template-columns:1fr;
}

.full{
grid-column:auto;
}

.resource{
flex-direction:column;
}

.actions-list{
width:100%;
}

.header h1{
font-size:21px;
}

}

</style>

</head>

<body>

<div class="container">


<!-- HEADER -->

<div class="header">

<h1>

<i class="fa-solid fa-folder-open"></i>

Admin Resources

</h1>

<p>
Manage course learning resources
</p>

</div>


<!-- MESSAGE -->

<div
id="message"
class="message">
</div>


<!-- FORM -->

<div class="card">

<h2 id="formTitle">
Add Resource
</h2>


<form id="resourceForm">

<div class="grid">


<div class="field">

<label>
Course ID
</label>

<input
id="courseId"
type="text"
placeholder="Enter course ID"
required>

</div>


<div class="field">

<label>
Resource Name
</label>

<input
id="name"
type="text"
placeholder="e.g. Biology Notes PDF"
required>

</div>


<div class="field">

<label>
Resource Type
</label>

<select
id="type">

<option value="pdf">
PDF
</option>

<option value="document">
Document
</option>

<option value="video">
Video
</option>

<option value="audio">
Audio
</option>

<option value="link">
External Link
</option>

<option value="image">
Image
</option>

<option value="other">
Other
</option>

</select>

</div>


<div class="field">

<label>
Resource URL
</label>

<input
id="url"
type="url"
placeholder="https://..."
required>

</div>


<div class="field full">

<label>
Description
</label>

<textarea
id="description"
placeholder="Describe this resource...">
</textarea>

</div>

</div>


<div class="actions">

<button
id="saveBtn"
class="btn primary"
type="submit">

<i class="fa-solid fa-plus"></i>

Add Resource

</button>


<button
id="cancelBtn"
class="btn secondary"
type="button"
style="display:none">

<i class="fa-solid fa-xmark"></i>

Cancel

</button>

</div>

</form>

</div>


<!-- RESOURCES -->

<div class="card">

<h2>
Resources
</h2>


<div class="search">

<input
id="searchInput"
type="search"
placeholder="Search resources...">

</div>


<div
id="resourceList"
class="resource-list">

<div class="loading">

<i class="fa-solid fa-spinner fa-spin"></i>

<br><br>

Loading resources...

</div>

</div>

</div>

</div>


<script type="module">

/* =====================================================
   FIREBASE
===================================================== */

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.7.0/firebase-app.js";

import {
getFirestore,
collection,
getDocs,
addDoc,
doc,
updateDoc,
deleteDoc,
serverTimestamp
}
from
"https://www.gstatic.com/firebasejs/12.7.0/firebase-firestore.js";

import {
getAuth,
onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.7.0/firebase-auth.js";


const firebaseConfig = {

apiKey:
"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};


const app =
initializeApp(firebaseConfig);

const db =
getFirestore(app);

const auth =
getAuth(app);


/* =====================================================
   ELEMENTS
===================================================== */

const form =
document.getElementById(
"resourceForm"
);

const formTitle =
document.getElementById(
"formTitle"
);

const courseIdInput =
document.getElementById(
"courseId"
);

const nameInput =
document.getElementById(
"name"
);

const typeInput =
document.getElementById(
"type"
);

const urlInput =
document.getElementById(
"url"
);

const descriptionInput =
document.getElementById(
"description"
);

const saveBtn =
document.getElementById(
"saveBtn"
);

const cancelBtn =
document.getElementById(
"cancelBtn"
);

const resourceList =
document.getElementById(
"resourceList"
);

const searchInput =
document.getElementById(
"searchInput"
);

const message =
document.getElementById(
"message"
);


let resources = [];

let editingResourceId = null;

let currentUser = null;


/* =====================================================
   ESCAPE
===================================================== */

function escapeHTML(value){

return String(value ?? "")
.replaceAll("&","&amp;")
.replaceAll("<","&lt;")
.replaceAll(">","&gt;")
.replaceAll('"',"&quot;")
.replaceAll("'","&#039;");

}


/* =====================================================
   MESSAGE
===================================================== */

function showMessage(
text,
type="success"
){

message.textContent =
text;

message.className =
"message " + type;

setTimeout(
()=>{

message.className =
"message";

},
4000
);

}


/* =====================================================
   LOAD RESOURCES
===================================================== */

async function loadResources(){

resourceList.innerHTML = `

<div class="loading">

<i class="fa-solid fa-spinner fa-spin"></i>

<br><br>

Loading resources...

</div>

`;


try{

const snapshot =
await getDocs(
collection(
db,
"resources"
)
);


resources =
snapshot.docs.map(
item => ({

id:item.id,

...item.data()

})
);


renderResources();

}
catch(error){

console.error(
error
);

resourceList.innerHTML = `

<div class="empty">

<i class="fa-solid fa-triangle-exclamation"></i>

<br><br>

${escapeHTML(
error.message ||
"Failed to load resources."
)}

</div>

`;

}

}


/* =====================================================
   RENDER
===================================================== */

function renderResources(){

const search =
searchInput.value
.trim()
.toLowerCase();


const filtered =
resources.filter(
resource => {

return (

String(
resource.name || ""
)
.toLowerCase()
.includes(search)

||

String(
resource.courseId || ""
)
.toLowerCase()
.includes(search)

||

String(
resource.type || ""
)
.toLowerCase()
.includes(search)

);

}
);


if(!filtered.length){

resourceList.innerHTML = `

<div class="empty">

<i class="fa-solid fa-folder-open"></i>

<br><br>

No resources found.

</div>

`;

return;

}


resourceList.innerHTML =
filtered.map(
resource => `

<div class="resource">

<div>

<h3>

${escapeHTML(
resource.name ||
"Untitled Resource"
)}

</h3>


<p>

${escapeHTML(
resource.description ||
"No description."
)}

</p>


<div class="meta">

<span class="badge">

<i class="fa-solid fa-book"></i>

Course:
${escapeHTML(
resource.courseId ||
"-"
)}

</span>


<span class="badge">

<i class="fa-solid fa-file"></i>

${escapeHTML(
resource.type ||
"other"
)}

</span>


${
resource.url
?
`
<span class="badge">

<i class="fa-solid fa-link"></i>

URL Available

</span>
`
:
""
}

</div>

</div>


<div class="actions-list">

<button
class="icon-btn edit"
title="Edit"
onclick="editResource('${resource.id}')">

<i class="fa-solid fa-pen"></i>

</button>


<button
class="icon-btn delete"
title="Delete"
onclick="deleteResource('${resource.id}')">

<i class="fa-solid fa-trash"></i>

</button>

</div>

</div>

`
).join("");

}


/* =====================================================
   ADD / UPDATE
===================================================== */

form.addEventListener(
"submit",
async event => {

event.preventDefault();


if(!currentUser){

showMessage(
"Please login first.",
"error"
);

return;

}


const courseId =
courseIdInput.value.trim();

const name =
nameInput.value.trim();

const type =
typeInput.value;

const url =
urlInput.value.trim();

const description =
descriptionInput.value.trim();


if(!courseId){

showMessage(
"Course ID is required.",
"error"
);

return;

}


if(!name){

showMessage(
"Resource name is required.",
"error"
);

return;

}


if(!url){

showMessage(
"Resource URL is required.",
"error"
);

return;

}


saveBtn.disabled =
true;


try{

/* UPDATE */

if(editingResourceId){

await updateDoc(

doc(
db,
"resources",
editingResourceId
),

{

courseId,

name,

type,

url,

description,

updatedAt:
serverTimestamp()

}

);


showMessage(
"Resource updated successfully."
);

}


/* CREATE */

else{

const resourceRef =
await addDoc(

collection(
db,
"resources"
),

{

courseId,

name,

type,

url,

description,

createdBy:
currentUser.uid,

createdAt:
serverTimestamp()

}

);


console.log(
"Automatic Resource ID:",
resourceRef.id
);


showMessage(
"Resource created successfully."
);

}


resetForm();

await loadResources();

}
catch(error){

console.error(
error
);

showMessage(
error.message ||
"Failed to save resource.",
"error"
);

}


saveBtn.disabled =
false;

}
);


/* =====================================================
   EDIT
===================================================== */

window.editResource =
function(id){

const resource =
resources.find(
item =>
item.id === id
);


if(!resource)
return;


editingResourceId =
id;


courseIdInput.value =
resource.courseId || "";

nameInput.value =
resource.name || "";

typeInput.value =
resource.type || "other";

urlInput.value =
resource.url || "";

descriptionInput.value =
resource.description || "";


formTitle.textContent =
"Edit Resource";


saveBtn.innerHTML = `

<i class="fa-solid fa-save"></i>

Update Resource

`;


cancelBtn.style.display =
"inline-block";


window.scrollTo({

top:0,

behavior:"smooth"

});

};


/* =====================================================
   DELETE
===================================================== */

window.deleteResource =
async function(id){

const resource =
resources.find(
item =>
item.id === id
);


if(!resource)
return;


const confirmed =
confirm(
`Delete "${resource.name || "this resource"}"?`
);


if(!confirmed)
return;


try{

await deleteDoc(

doc(
db,
"resources",
id
)

);


showMessage(
"Resource deleted successfully."
);


await loadResources();

}
catch(error){

console.error(
error
);

showMessage(
error.message ||
"Failed to delete resource.",
"error"
);

}

};


/* =====================================================
   RESET
===================================================== */

function resetForm(){

editingResourceId =
null;

form.reset();

typeInput.value =
"pdf";

formTitle.textContent =
"Add Resource";

saveBtn.innerHTML = `

<i class="fa-solid fa-plus"></i>

Add Resource

`;

cancelBtn.style.display =
"none";

}


/* =====================================================
   CANCEL
===================================================== */

cancelBtn.addEventListener(
"click",
resetForm
);


/* =====================================================
   SEARCH
===================================================== */

searchInput.addEventListener(
"input",
renderResources
);


/* =====================================================
   AUTH
===================================================== */

onAuthStateChanged(
auth,
async user => {

if(!user){

currentUser = null;

resourceList.innerHTML = `

<div class="empty">

<i class="fa-solid fa-lock"></i>

<br><br>

Please login as administrator.

</div>

`;

return;

}


currentUser =
user;

await loadResources();

}
);

</script>

</body>
</html>