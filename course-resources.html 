<style>
:root{
  --ink:#0d1b2a;--ink-2:#16293f;--paper:#f2f5f9;--card:#fff;--line:#dde4ec;
  --mute:#5b6b7e;--brand:#0a7c66;--brand-soft:#e2f4ef;--amber:#f2a93b;
  --head:"Bricolage Grotesque","Figtree",system-ui,sans-serif;
  --body:"Figtree",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:var(--body);background:var(--paper);color:var(--ink);line-height:1.55;-webkit-font-smoothing:antialiased;min-height:100vh;display:flex;flex-direction:column}
a{color:inherit;text-decoration:none}
:focus-visible{outline:3px solid var(--amber);outline-offset:2px;border-radius:6px}
.i{width:17px;height:17px;min-width:17px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}

/* TOP BAR */
.topbar{position:sticky;top:0;z-index:50;height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 max(18px,5%);background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--head);font-size:20px;font-weight:700;letter-spacing:-.3px}
.brand-mark{width:32px;height:32px;border-radius:9px;background:var(--ink);color:var(--amber);display:grid;place-items:center;font-size:16px}
.back-btn{display:inline-flex;align-items:center;gap:8px;padding:9px 15px;border-radius:10px;background:var(--ink);color:#fff;font-size:14px;font-weight:600}
.back-btn:hover{background:var(--ink-2)}
.back-btn .i{width:15px;height:15px;transform:rotate(180deg)}

.container{flex:1;width:min(1120px,92%);margin:0 auto;padding:30px 0 64px}

/* HERO */
.hero{background:var(--ink);color:#fff;border-radius:22px;padding:34px 36px;margin-bottom:20px;position:relative;overflow:hidden}
.hero::after{content:"";position:absolute;right:-80px;top:-80px;width:260px;height:260px;border-radius:50%;border:40px solid rgba(242,169,59,.08);pointer-events:none}
.hero > *{position:relative;z-index:1}
.hero h1{font-family:var(--head);font-size:clamp(28px,4vw,40px);line-height:1.1;letter-spacing:-.8px;margin-bottom:10px}
.hero p{color:#b6c3d2;max-width:60ch;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
.chip{padding:7px 13px;border-radius:999px;background:rgba(255,255,255,.1);color:#dbe4ee;font-size:13px;font-weight:500}
.chip:empty{display:none}

/* TOOLBAR */
.toolbar{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:20px;display:grid;gap:12px}
.search{position:relative;display:block}
.search .i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--mute)}
.search input{width:100%;padding:12px 14px 12px 42px;border:1px solid var(--line);border-radius:11px;background:var(--paper);font:500 15px var(--body);color:var(--ink)}
.search input:focus{outline:none;border-color:var(--brand);background:#fff;box-shadow:0 0 0 3px var(--brand-soft)}
.filters{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}
.filters::-webkit-scrollbar{display:none}
.filter{flex-shrink:0;padding:7px 14px;border:1px solid var(--line);border-radius:999px;background:#fff;color:var(--mute);font:600 13px var(--body);cursor:pointer;transition:all .2s}
.filter:hover{border-color:var(--ink);color:var(--ink)}
.filter[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:#fff}
.filter small{font-weight:700;margin-left:5px;opacity:.7}

/* RESOURCES */
.resources{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.resource-card{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:22px;display:flex;flex-direction:column;min-width:0;transition:border-color .2s,transform .2s}
.resource-card:hover{border-color:var(--brand);transform:translateY(-3px)}
.r-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:16px}
.r-icon{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;background:var(--brand-soft);color:var(--brand)}
.r-icon .i{width:23px;height:23px}
.k-pdf .r-icon,.k-slides .r-icon{background:#fde4e1;color:#a8281b}
.k-doc .r-icon,.k-sheet .r-icon{background:#fdf0d6;color:#8a5a06}
.k-video .r-icon,.k-audio .r-icon{background:#e4ebf5;color:#26405c}
.r-type{padding:5px 11px;border-radius:999px;background:var(--paper);color:var(--mute);font-size:12px;font-weight:700}
.resource-card h2{font-family:var(--head);font-size:19px;line-height:1.3;letter-spacing:-.3px;margin-bottom:8px;overflow-wrap:anywhere}
.r-desc{color:var(--mute);font-size:14.5px;margin-bottom:16px;flex:1;overflow-wrap:anywhere;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
.r-meta{display:flex;flex-wrap:wrap;gap:4px 14px;color:var(--mute);font-size:12.5px;margin-bottom:16px}
.open-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:12px 14px;border:0;border-radius:12px;background:var(--ink);color:#fff;font:700 14.5px var(--body);cursor:pointer;transition:background .2s,transform .2s}
.open-btn:hover:not(:disabled){background:var(--ink-2)}
.open-btn.go{background:var(--amber);color:var(--ink)}
.open-btn.go:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(242,169,59,.35)}
.open-btn:disabled{opacity:.5;cursor:not-allowed}

/* STATES */
.empty,.error{grid-column:1/-1;background:var(--card);border:1px solid var(--line);border-radius:20px;padding:52px 24px;text-align:center;color:var(--mute)}
.empty h3,.error h3{font-family:var(--head);font-size:20px;color:var(--ink);margin-bottom:6px}
.state-icon{width:54px;height:54px;border-radius:16px;margin:0 auto 14px;display:grid;place-items:center;background:var(--brand-soft);color:var(--brand)}
.state-icon .i{width:26px;height:26px}
.error{border-color:#fecaca}
.error .state-icon{background:#fee2e2;color:#b91c1c}
.retry-btn{margin-top:16px;padding:11px 20px;border:0;border-radius:10px;background:var(--ink);color:#fff;font:600 14px var(--body);cursor:pointer}
.clear-btn{margin-top:14px;padding:10px 18px;border:1px solid var(--line);border-radius:10px;background:#fff;font:600 14px var(--body);cursor:pointer}
@keyframes sh{to{background-position:-200% 0}}
.sk{height:250px;border-radius:20px;background:linear-gradient(90deg,#e6ebf1 25%,#f4f7fa 50%,#e6ebf1 75%) 0 0/200% 100%;animation:sh 1.4s linear infinite}

.footer{padding:26px;background:#fff;border-top:1px solid var(--line);text-align:center;color:var(--mute);font-size:14px}

@media(max-width:850px){.resources{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){
  .container{padding:18px 0 44px}
  .hero{padding:26px 22px}
  .resources{grid-template-columns:1fr}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>

