<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>Course Resources | Let'sStudy Pro</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
*{
box-sizing:border-box;
}

body{
margin:0;
font-family:Arial,Helvetica,sans-serif;
background:#f5f7fb;
color:#172033;
}

.container{
max-width:1100px;
margin:auto;
padding:20px;
}

.header{
background:#172033;
color:white;
border-radius:18px;
padding:25px;
margin-bottom:20px;
}

.header h1{
margin:0 0 8px;
font-size:28px;
}

.header p{
margin:0;
color:#cbd5e1;
font-size:14px;
}

.search{
background:white;
padding:15px;
border-radius:14px;
margin-bottom:18px;
box-shadow:0 4px 15px rgba(0,0,0,.05);
}

.search input{
width:100%;
padding:13px 15px;
border:1px solid #dbe2ea;
border-radius:9px;
outline:none;
font-size:14px;
}

.search input:focus{
border-color:#2563eb;
}

.grid{
display:grid;
grid-template-columns:
repeat(auto-fit,minmax(260px,1fr));
gap:16px;
}

.resource{
background:white;
border-radius:16px;
padding:18px;
box-shadow:0 4px 18px rgba(0,0,0,.06);
transition:.2s;
}

.resource:hover{
transform:translateY(-3px);
box-shadow:0 8px 25px rgba(0,0,0,.09);
}

.resource-icon{
width:50px;
height:50px;
display:flex;
align-items:center;
justify-content:center;
background:#eff6ff;
color:#2563eb;
border-radius:12px;
font-size:22px;
margin-bottom:14px;
}

.resource h3{
margin:0 0 8px;
font-size:17px;
}

.description{
color:#64748b;
font-size:13px;
line-height:1.6;
margin-bottom:12px;
}

.meta{
display:flex;
flex-wrap:wrap;
gap:6px;
margin-bottom:15px;
}

.badge{
background:#f1f5f9;
color:#475569;
font-size:11px;
padding:6px 9px;
border-radius:20px;
}

.open-btn{
display:inline-flex;
align-items:center;
gap:8px;
background:#2563eb;
color:white;
text-decoration:none;
padding:10px 14px;
border-radius:8px;
font-size:13px;
font-weight:bold;
}

.open-btn:hover{
background:#1d4ed8;
}

.loading,
.empty,
.error{
background:white;
padding:45px 20px;
border-radius:16px;
text-align:center;
color:#64748b;
}

.error{
color:#991b1b;
}

.stats{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-top:15px;
}

.stat{
background:rgba(255,255,255,.1);
padding:8px 12px;
border-radius:20px;
font-size:12px;
}

@media(max-width:600px){

.container{
padding:12px;
}

.header h1{
font-size:23px;
}

.grid{
grid-template-columns:1fr;
}

}
</style>
</head>

<body>

<div class="container">

<!-- HEADER -->

<div class="header">

<h1>
<i class="fa-solid fa-folder-open"></i>
Course Resources
</h1>

<p>
Access learning materials and resources for your course.
</p>

<div class="stats">

<div class="stat">
Resources:
<span id="totalResources">0</span>
</div>

</div>

</div>


<!-- SEARCH -->

<div class="search">

<input
id="searchInput"
type="search"
placeholder="Search resources...">

</div>


<!-- RESOURCE LIST -->

<div
id="resourceList"
class="loading">

<i class="fa-solid fa-spinner fa-spin"></i>

<br><br>

Loading resources...

</div>

</div>


<script type="module">

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.7.0/firebase-app.js";

import {
getFirestore,
collection,
getDocs
}
from
"https://www.gstatic.com/firebasejs/12.7.0/firebase-firestore.js";


/* ==========================================
   FIREBASE CONFIG
========================================== */

const firebaseConfig={

apiKey:
"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};


const app=
initializeApp(firebaseConfig);

const db=
getFirestore(app);


/* ==========================================
   ELEMENTS
========================================== */

const resourceList=
document.getElementById(
"resourceList"
);

const searchInput=
document.getElementById(
"searchInput"
);

const totalResources=
document.getElementById(
"totalResources"
);


let resources=[];


/* ==========================================
   ESCAPE HTML
========================================== */

function escapeHTML(value){

return String(value ?? "")
.replaceAll("&","&amp;")
.replaceAll("<","&lt;")
.replaceAll(">","&gt;")
.replaceAll('"',"&quot;")
.replaceAll("'","&#039;");

}


/* ==========================================
   RESOURCE ICON
========================================== */

function getIcon(type){

const t=
String(type||"")
.toLowerCase();

if(
t.includes("pdf")
)return "fa-file-pdf";

if(
t.includes("video")
)
return "fa-video";

if(
t.includes("audio")
)
return "fa-headphones";

if(
t.includes("image")
)
return "fa-image";

if(
t.includes("doc")
)
return "fa-file-word";

if(
t.includes("zip")
)
return "fa-file-zipper";

if(
t.includes("link") ||
t.includes("url")
)
return "fa-link";

return "fa-file";

}


/* ==========================================
   LOAD RESOURCES
========================================== */

async function loadResources(){

try{

const snapshot=
await getDocs(
collection(
db,
"resources"
)
);


resources=
snapshot.docs.map(
doc=>({

id:doc.id,

...doc.data()

})
);


totalResources.textContent=
resources.length;


renderResources();

}catch(error){

console.error(error);

resourceList.className=
"error";

resourceList.innerHTML=`

<i class="fa-solid fa-triangle-exclamation"></i>

<br><br>

Unable to load resources.

`;

}

}


/* ==========================================
   RENDER
========================================== */

function renderResources(){

const query=
searchInput.value
.trim()
.toLowerCase();


const filtered=
resources.filter(resource=>{

return (

String(
resource.name||""
)
.toLowerCase()
.includes(query)

||

String(
resource.type||""
)
.toLowerCase()
.includes(query)

||

String(
resource.description||""
)
.toLowerCase()
.includes(query)

||

String(
resource.courseId||""
)
.toLowerCase()
.includes(query)

);

});


if(!filtered.length){

resourceList.className=
"empty";

resourceList.innerHTML=`

<i class="fa-solid fa-folder-open fa-2x"></i>

<br><br>

No resources found.

`;

return;

}


resourceList.className=
"grid";


resourceList.innerHTML=
filtered.map(resource=>{

const url=
resource.url || "#";


return `

<div class="resource">

<div class="resource-icon">

<i class="fa-solid
${getIcon(resource.type)}"></i>

</div>


<h3>
${escapeHTML(resource.name)}
</h3>


<div class="description">

${escapeHTML(
resource.description ||
"No description available."
)}

</div>


<div class="meta">

<span class="badge">

Type:
${escapeHTML(
resource.type || "Resource"
)}

</span>


<span class="badge">

Course:
${escapeHTML(
resource.courseId || "-"
)}

</span>

</div>


<a
href="${escapeHTML(url)}"
target="_blank"
rel="noopener noreferrer"
class="open-btn">

<i class="fa-solid fa-arrow-up-right-from-square"></i>

Open Resource

</a>

</div>

`;

}).join("");

}


/* ==========================================
   SEARCH
========================================== */

searchInput.addEventListener(
"input",
renderResources
);


/* ==========================================
   START
========================================== */

loadResources();

</script>

</body>
</html>