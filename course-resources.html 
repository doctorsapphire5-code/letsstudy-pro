<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getFirestore, collection, getDocs, query, where, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

/* FIREBASE */
const firebaseConfig = {
  apiKey: "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",
  authDomain: "let-s-study-pro-course.firebaseapp.com",
  databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
  projectId: "let-s-study-pro-course",
  storageBucket: "let-s-study-pro-course.firebasestorage.app",
  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
};
const db = getFirestore(initializeApp(firebaseConfig));

/* COURSE ID: required. This page never loads another course's resources. */
const params = new URLSearchParams(window.location.search);
const courseId = (params.get("courseId") || params.get("courseID") || params.get("id") || params.get("course") || "").trim();

const $ = (id) => document.getElementById(id);
const list = $("resourceList"), searchInput = $("searchInput"), filtersEl = $("filters");
const icon = (n) => `<svg class="i"><use href="#i-${n}"/></svg>`;
const escapeHTML = (v) => (v === undefined || v === null) ? "" : String(v).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;");
const HIDDEN = ["draft","private","disabled"];

let resources = [], activeKind = "all";

if(courseId) $("backBtn").href = `course-learn.html?courseId=${encodeURIComponent(courseId)}`;

function getValue(data, fields, fallback = ""){
  if(!data || typeof data !== "object") return fallback;
  for(const f of fields){
    if(data[f] !== undefined && data[f] !== null && String(data[f]).trim() !== "") return data[f];
  }
  return fallback;
}

function getTime(v){
  if(!v) return 0;
  try{
    if(typeof v.toDate === "function") return v.toDate().getTime();
    if(typeof v === "object" && v.seconds !== undefined) return Number(v.seconds) * 1000;
    const t = new Date(v).getTime();
    return Number.isNaN(t) ? 0 : t;
  }catch(e){ return 0; }
}
const formatDate = (v) => { const t = getTime(v); return t ? new Date(t).toLocaleDateString(undefined, { year:"numeric", month:"short", day:"numeric" }) : ""; };

/* Only real web links are ever opened; anything else (javascript:, data:) is dropped */
function cleanUrl(value){
  const url = String(value ?? "").trim();
  if(!url) return "";
  if(/^https?:\/\//i.test(url)) return url;
  if(/^[a-z0-9.-]+\.[a-z]{2,}(\/.*)?$/i.test(url)) return "https://" + url;
  return "";
}
const urlOf = (r) => cleanUrl(getValue(r, ["url","link","fileUrl","resourceUrl","downloadUrl"], ""));

/* Resource kinds, from the type field or the link itself */
const KINDS = { pdf:"PDF", video:"Video", audio:"Audio", image:"Image", link:"Link", doc:"Document", sheet:"Spreadsheet", slides:"Slides", file:"Other" };
function kindOf(r){
  const t = `${getValue(r, ["type","resourceType","format"], "")} ${urlOf(r)}`.toLowerCase();
  if(t.includes("pdf")) return "pdf";
  if(/video|mp4|youtube|youtu\.be|vimeo|\.mov|\.webm/.test(t)) return "video";
  if(/audio|mp3|podcast|\.wav/.test(t)) return "audio";
  if(/image|jpg|jpeg|png|webp|gif/.test(t)) return "image";
  if(/spreadsheet|excel|xlsx|xls|csv/.test(t)) return "sheet";
  if(/presentation|powerpoint|ppt|slides/.test(t)) return "slides";
  if(/document|word|docx|\.doc|notes/.test(t)) return "doc";
  if(/link|url|website|web/.test(t)) return "link";
  return "file";
}
const nameOf = (r) => String(getValue(r, ["name","title","resourceName"], "Untitled resource"));

/* LOAD COURSE */
async function loadCourse(){
  if(!courseId){
    list.innerHTML = `
      <div class="error"><div class="state-icon">${icon("alert")}</div>
        <h3>Course ID is required</h3>
        <p>Open the resources from a course page, or use a link like course-resources.html?courseId=COURSE_ID.</p>
      </div>`;
    return false;
  }
  try{
    const snap = await getDoc(doc(db, "courses", courseId));
    if(!snap.exists()) throw new Error("The requested course could not be found.");
    const c = snap.data() || {};
    const title = String(getValue(c, ["title","name","courseTitle","courseName"], "Course"));
    $("courseInfo").textContent = title;
    $("heroDescription").textContent = String(getValue(c, ["description","details","summary"], "Access learning resources for this course."));
    document.title = `${title} Resources | LetsStudy Pro`;
    return true;
  }catch(error){
    console.error("Course loading error:", error);
    list.innerHTML = `
      <div class="error"><div class="state-icon">${icon("alert")}</div>
        <h3>Unable to load course</h3>
        <p>${escapeHTML(error.message || "Please try again later.")}</p>
      </div>`;
    return false;
  }
}

/* LOAD RESOURCES: only this course's */
async function loadResources(){
  if(!courseId) return;
  list.innerHTML = `<div class="sk"></div><div class="sk"></div><div class="sk"></div>`;
  try{
    const snapshot = await getDocs(query(collection(db, "resources"), where("courseId", "==", courseId)));
    resources = [];
    snapshot.forEach((d) => {
      const data = d.data() || {};
      if(String(data.courseId || "").trim() !== String(courseId)) return;
      if(HIDDEN.includes(String(data.status || "").toLowerCase())) return;
      resources.push({ id: d.id, ...data });
    });
    resources.sort((a, b) => getTime(b.createdAt) - getTime(a.createdAt));
    $("countChip").textContent = `${resources.length} ${resources.length === 1 ? "resource" : "resources"}`;
    renderFilters();
    renderResources();
  }catch(error){
    console.error("Resources loading error:", error);
    list.innerHTML = `
      <div class="error"><div class="state-icon">${icon("alert")}</div>
        <h3>Unable to load resources</h3>
        <p>${escapeHTML(error.message || "Please try again later.")}</p>
        <button class="retry-btn" id="retryBtn" type="button">Try again</button>
      </div>`;
    $("retryBtn").addEventListener("click", loadResources);
  }
}

/* FILTERS */
function renderFilters(){
  const counts = {};
  resources.forEach(r => { const k = kindOf(r); counts[k] = (counts[k] || 0) + 1; });
  const kinds = Object.keys(KINDS).filter(k => counts[k]);
  filtersEl.hidden = kinds.length < 2;
  filtersEl.innerHTML = [["all", "All", resources.length], ...kinds.map(k => [k, KINDS[k], counts[k]])]
    .map(([k, label, n]) => `<button class="filter" type="button" data-k="${k}" aria-pressed="${k === activeKind}">${label}<small>${n}</small></button>`).join("");
}
filtersEl.addEventListener("click", (e) => {
  const b = e.target.closest(".filter");
  if(!b) return;
  activeKind = b.dataset.k;
  filtersEl.querySelectorAll(".filter").forEach(x => x.setAttribute("aria-pressed", String(x === b)));
  renderResources();
});

/* RENDER */
function renderResources(){
  const search = searchInput.value.trim().toLowerCase();
  const filtered = resources.filter((r) => {
    if(activeKind !== "all" && kindOf(r) !== activeKind) return false;
    if(!search) return true;
    return [nameOf(r), getValue(r, ["type","resourceType","format"]), getValue(r, ["description","details"]), getValue(r, ["category"])].join(" ").toLowerCase().includes(search);
  });

  if(!filtered.length){
    const none = !resources.length;
    list.innerHTML = `
      <div class="empty"><div class="state-icon">${icon(none ? "folder" : "search")}<});

  if(!filtered.length){
    const none = !resources.length;
    list.innerHTML = `
      <div class="empty"><div class="state-icon">${icon(none ? "folder" : "search")}</div>
        <h3>${none ? "No resources yet" : "No resources found"}</h3>
        <p>${none ? "There are currently no resources available for this course." : "No resources match your search."}</p>
        ${!none ? `<button class="clear-btn" id="clearBtn" type="button">Clear search and filters</button>` : ""}
      </div>`;
    const clear = $("clearBtn");
    if(clear) clear.addEventListener("click", () => {
      searchInput.value = "";
      activeKind = "all";
      renderFilters();
      renderResources();
    });
    return;
  }

  list.innerHTML = filtered.map((r) => {
    const kind = kindOf(r), url = urlOf(r), date = formatDate(r.createdAt);
    const typeLabel = String(getValue(r, ["type","resourceType","format"], KINDS[kind]));
    return `
      <article class="resource-card k-${kind}">
        <div class="r-top">
          <div class="r-icon">${icon(kind)}</div>
          <span class="r-type">${escapeHTML(typeLabel)}</span>
        </div>
        <h2>${escapeHTML(nameOf(r))}</h2>
        <p class="r-desc">${escapeHTML(getValue(r, ["description","details"], "No description available."))}</p>
        <div class="r-meta">
          ${date ? `<span>Added ${escapeHTML(date)}</span>` : ""}
          ${r.createdBy ? `<span>By ${escapeHTML(r.createdBy)}</span>` : ""}
        </div>
        ${url
          ? `<a class="open-btn go" href="${escapeHTML(url)}" target="_blank" rel="noopener noreferrer">Open resource${icon("ext")}</a>`
          : `<button class="open-btn" type="button" disabled>Resource unavailable</button>`}
      </article>`;
  }).join("");
}

searchInput.addEventListener("input", renderResources);

/* START */
(async () => { if(await loadCourse()) await loadResources(); })();
</script>
</body>
