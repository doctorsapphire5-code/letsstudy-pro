<script type="module">

  import {
    initializeApp
  } from
  "https://www.gstatic.com/firebasejs/11.0.2/firebase-app.js";

  import {
    getFirestore,
    doc,
    getDoc,
    collection,
    query,
    where,
    getDocs,
    increment,
    updateDoc
  } from
  "https://www.gstatic.com/firebasejs/11.0.2/firebase-firestore.js";


  /* =========================================
     FIREBASE CONFIG
  ========================================= */

  const firebaseConfig = {

    apiKey:
      "AIzaSyBcOYDfAVKXbkljsyRgI0rjodBn678tCc",

    authDomain:
      "let-s-study-pro-course.firebaseapp.com",

    databaseURL:
      "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

    projectId:
      "let-s-study-pro-course",

    storageBucket:
      "let-s-study-pro-course.firebasestorage.app",

    messagingSenderId:
      "474928293390",

    appId:
      "1:474928293390:web:2bcc2aebf2351c12a9fe5f"
  };


  const app = initializeApp(firebaseConfig);

  const db = getFirestore(app);


  /* =========================================
     URL PARAMETER
  ========================================= */

  const params =
    new URLSearchParams(window.location.search);

  const creatorId =
    params.get("id") ||
    params.get("creatorId") ||
    params.get("uid");


  let creatorData = null;


  /* =========================================
     HELPERS
  ========================================= */

  function escapeHTML(value) {

    if (value === null ||
        value === undefined) {
      return "";
    }

    return String(value)
     .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }


  function formatNumber(value) {

    const number = Number(value || 0);

    return new Intl.NumberFormat("en-US", {
      notation: "compact",
      maximumFractionDigits: 1
    }).format(number);
  }


  function formatDate(value) {

    if (!value) {
      return "—";
    }

    try {

      let date;

      if (value?.toDate) {
        date = value.toDate();
      } else if (value?.seconds) {
        date = new Date(value.seconds * 1000);
      } else {
        date = new Date(value);
      }

      if (isNaN(date.getTime())) {
        return "—";
      }

      return date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric"
      });

    } catch (error) {
      return "—";
    }
  }


  function normalizeArray(value) {

    if (Array.isArray(value)) {
      return value;
    }

    if (typeof value === "string") {

      return value
        .split(",")
        .map(item => item.trim())
        .filter(Boolean);
    }

    return [];
  }


  /* =========================================
     GET CREATOR ID FROM URL
  ========================================= */

  const params =
    new URLSearchParams(window.location.search);

  const creatorId =
    params.get("id") ||
    params.get("creatorId") ||
    params.get("uid");


  let creatorData = null;


  /* =========================================
     LOAD CREATOR
  ========================================= */

  async function loadCreator() {

    if (!creatorId) {

      showError(
        "No creator ID was provided in the URL."
      );

      return;
    }


    try {

      let snapshot = null;


      /*
       * Primary collection
       */

      snapshot = await getDoc(
        doc(
          db,
          "creators",
          creatorId
        )
      );


      /*
       * Fallback: creatorProfiles
       */

      if (!snapshot.exists()) {

        snapshot = await getDoc(
          doc(
            db,
            "creatorProfiles",
            creatorId
          )
        );
      }


      /*
       * Fallback: users
       */

      if (!snapshot.exists()) {

        snapshot = await getDoc(
          doc(
            db,
            "users",
            creatorId
          )
        );
      }


      if (!snapshot.exists()) {

        showError(
          "This creator profile does not exist or is no longer available."
        );

        return;
      }


      creatorData = {
        id: snapshot.id,
        ...snapshot.data()
      };


      renderCreator(creatorData);


      /*
       * Update views.
       * If Firestore Rules don't allow public
       * updates, the page will continue normally.
       */

      try {

        await updateDoc(
          doc(
            db,
            "creators",
            creatorId
          ),
          {
            views: increment(1)
          }
        );

      } catch (viewError) {

        console.warn(
          "View counter was not updated:",
          viewError
        );
      }


    } catch (error) {

      console.error(
        "Creator loading error:",
        error
      );

      showError(
        "Unable to load this creator. Please try again."
      );
    }
  }


  /* =========================================
     RENDER CREATOR
  ========================================= */

  function renderCreator(data) {

    const name =
      data.name ||
      data.displayName ||
      data.fullName ||
      "Creator";


    const username =
      data.username ||
      data.handle ||
      data.userName ||
      "creator";


    const avatar =
      data.photoURL ||
      data.photoUrl ||
      data.avatar ||
      data.image ||
      "https://via.placeholder.com/250";


    const category =
      data.category ||
      data.creatorType ||
      data.type ||
      "Digital Creator";


    const bio =
      data.bio ||
      data.description ||
      data.about ||
      "This creator has not added a biography yet.";


    document.title =
      `${name} - Creator | LetsStudy Pro`;


    document.getElementById(
      "creatorAvatar"
    ).src = avatar;


    document.getElementById(
      "creatorAvatar"
    ).alt =
      `${name} - LetsStudy Pro Creator`;


    document.getElementById(
      "creatorName"
    ).textContent = name;


    document.getElementById(
      "creatorUsername"
    ).textContent =
      username.startsWith("@")
        ? username
        : `@${username}`;


    document.getElementById(
      "creatorCategory"
    ).textContent = category;


    document.getElementById(
      "infoCategory"
    ).textContent = category;


    document.getElementById(
      "creatorBio"
    ).textContent = bio;


    document.getElementById(
      "creatorLocation"
    ).textContent =
      data.location ||
      data.city ||
      data.country ||
      "Global";


    document.getElementById(
      "joinedDate"
    ).textContent =
      formatDate(
        data.createdAt ||
        data.joinedAt ||
        data.dateCreated
      );


    /*
     * VERIFIED CREATOR
     */

    const verified =
      data.verified === true ||
      data.isVerified === true ||
      data.verificationStatus === "verified";


    document.getElementById(
      "verifiedBadge"
    ).style.display =
      verified
        ? "inline-flex"
        : "none";


    /*
     * STATISTICS
     */

    document.getElementById(
      "followersCount"
    ).textContent =
      formatNumber(
        data.followers ||
        data.followersCount ||
        0
      );


    document.getElementById(
      "viewsCount"
    ).textContent =
      formatNumber(
        data.views ||
        data.viewCount ||
        0
      );


    /*
     * SKILLS
     */

    renderSkills(
      normalizeArray(data.skills)
    );


    /*
     * SOCIAL LINKS
     */

    renderSocials(data);


    /*
     * CONTENT
     */

    renderContent(
      data.content ||
      data.contents ||
      data.posts ||
      []
    );


    /*
     * SERVICES
     */

    renderServices(
      data.services ||
      []
    );


    /*
     * SHOW PAGE
     */

    document.getElementById(
      "loading"
    ).style.display = "none";


    document.getElementById(
      "mainContent"
    ).style.display = "block";
  }


  /* =========================================
     RENDER SKILLS
  ========================================= */

  function renderSkills(skills) {

    const container =
      document.getElementById("skills");


    if (!skills.length) {

      container.innerHTML = `
        <div class="empty">
          No skills listed yet.
        </div>
      `;

      return;
    }


    container.innerHTML =
      skills.map(skill => `
        <span class="skill">
          ${escapeHTML(skill)}
        </span>
      `).join("");
  }


  /* =========================================
     SOCIAL LINKS
  ========================================= */

  function renderSocials(data) {

    const container =
      document.getElementById("socialLinks");


    const social = {

      Website:
        data.website ||
        data.websiteUrl,

      YouTube:
        data.youtube ||
        data.youtubeUrl,

      Instagram:
        data.instagram ||
        data.instagramUrl,

      TikTok:
        data.tiktok ||
        data.tiktokUrl,

      LinkedIn:
        data.linkedin ||
        data.linkedinUrl,

      Facebook:
        data.facebook ||
        data.facebookUrl,

      X:
        data.twitter ||
        data.twitterUrl
    };


    const available =
      Object.entries(social)
        .filter(
          ([, value]) =>
            value
        );


    if (!available.length) {

      container.innerHTML = `
        <div class="empty">
          No social links available.
        </div>
      `;

      return;
    }


    container.innerHTML =
      available.map(([name, url]) => {

        let safeURL =
          String(url).trim();


        if (
          !safeURL.startsWith("http://") &&
          !safeURL.startsWith("https://")
        ) {

          safeURL =
            "https://" + safeURL;
        }


        return `
          <a
            class="social-link"
            href="${escapeHTML(safeURL)}"
            target="_blank"
            rel="noopener noreferrer">

            <span class="social-name">
              ${escapeHTML(name)}
            </span>

            <span class="social-value">
              Visit →
            </span>

          </a>
        `;

      }).join("");
  }


  /* =========================================
     RENDER CREATOR CONTENT
  ========================================= */

  function renderContent(content) {

    const container =
      document.getElementById(
        "contentItems"
      );


    if (
      !Array.isArray(content) ||
      !content.length
    ) {

      container.innerHTML = `
        <div class="empty">
          No creator content available yet.
        </div>
      `;

      document.getElementById(
        "contentCount"
      ).textContent = "0";

      return;
    }


    document.getElementById(
      "contentCount"
    ).textContent =
      formatNumber(content.length);


    container.innerHTML =
      content.slice(0, 10)
        .map(item => {

          const title =
            item.title ||
            item.name ||
            "Untitled Content";


          const description =
            item.description ||
            item.excerpt ||
            "Creator content";


          const type =
            item.type ||
            item.contentType ||
            "";


          const category =
            item.category ||
            "";


          return `
            <article class="item">

              <h3>
                ${escapeHTML(title)}
              </h3>

              <p>
                ${escapeHTML(description)}
              </p>

              <div class="item-meta">

                ${
                  type
                    ? `
                      <span class="badge">
                        ${escapeHTML(type)}
                      </span>
                    `
                    : ""
                }

                ${
                  category
                    ? `
                      <span class="badge">
                        ${escapeHTML(category)}
                      </span>
                    `
                    : ""
                }

              </div>

            </article>
          `;

        })
        .join("");
  }


  /* =========================================
     RENDER SERVICES
  ========================================= */

  function renderServices(services) {

    const container =
      document.getElementById(
        "serviceItems"
      );


    if (
      !Array.isArray(services) ||
      !services.length
    ) {

      container.innerHTML = `
        <div class="empty">
          No services available yet.
        </div>
      `;

      document.getElementById(
        "serviceCount"
      ).textContent = "0";

      return;
    }


    document.getElementById(
      "serviceCount"
    ).textContent =
      formatNumber(services.length);


    container.innerHTML =
      services.slice(0, 10)
        .map(service => {

          const title =
            service.title ||
            service.name ||
            "Creator Service";


          const description =
            service.description ||
            "Professional service offered by this creator.";


          return `
            <article class="item">

              <h3>
                ${escapeHTML(title)}
              </h3>

              <p>
                ${escapeHTML(description)}
              </p>

              <div class="item-meta">

                ${
                  service.category
                    ? `
                      <span class="badge">
                        ${escapeHTML(
                          service.category
                        )}
                      </span>
                    `
                    : ""
                }

                ${
                  service.price !== undefined &&
                  service.price !== null &&
                  service.price !== ""
                    ? `
                      <span class="badge">
                        ${escapeHTML(
                          String(service.price)
                        )}
                      </span>
                    `
                    : ""
                }

              </div>

            </article>
          `;

        })
        .join("");
  }


  /* =========================================
     ERROR HANDLER
  ========================================= */

  function showError(message) {

    document.getElementById(
      "loading"
    ).style.display = "none";


    document.getElementById(
      "mainContent"
    ).style.display = "none";


    document.getElementById(
      "errorMessage"
    ).textContent = message;


    document.getElementById(
      "errorBox"
    ).style.display = "block";
  }


  /* =========================================
     FOLLOW BUTTON
  ========================================= */

  window.toggleFollow = function () {

    const button =
      document.getElementById(
        "followBtn"
      );


    const following =
      button.dataset.following === "true";


    if (following) {

      button.textContent =
        "Follow";

      button.dataset.following =
        "false";

    } else {

      button.textContent =
        "Following ✓";

      button.dataset.following =
        "true";
    }
  };


  /* =========================================
     SHARE PROFILE
  ========================================= */

  window.shareCreator =
    async function () {

      const name =
        creatorData?.name ||
        creatorData?.displayName ||
        "Creator";


      const url =
        window.location.href;


      if (
        navigator.share
      ) {

        try {

          await navigator.share({

            title:
              `${name} - LetsStudy Pro Creator`,

            text:
              `Check out ${name} on LetsStudy Pro.`,

            url: url
          });

          return;

        } catch (error) {

          console.log(
            "Share cancelled."
          );
        }
      }


      try {

        await navigator.clipboard.writeText(
          url
        );

        alert(
          "Creator profile link copied!"
        );

      } catch (error) {

        prompt(
          "Copy this creator profile link:",
          url
        );
      }
    };


  /* =========================================
     CURRENT YEAR
  ========================================= */

  document.getElementById(
    "year"
  ).textContent =
    new Date().getFullYear();


  /* =========================================
     START APPLICATION
  ========================================= */

  loadCreator();

</script>

</body>
