<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <meta name="description"
        content="Explore creator profiles, skills, content, services and achievements on LetsStudy Pro.">

  <meta name="keywords"
        content="LetsStudy Pro, creator, creator profile, digital creator, freelancer, education, skills, services">

  <meta name="author"
        content="LetsStudy Pro">

  <meta name="theme-color"
        content="#0f172a">

  <title>Creator Details - LetsStudy Pro</title>

  <link rel="canonical"
        href="https://letsstudy.pro/creator-details.html">

  <link rel="icon"
        href="https://letsstudy.pro/favicon.ico">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --secondary: #7c3aed;
      --success: #16a34a;
      --dark: #0f172a;
      --dark-2: #1e293b;
      --text: #334155;
      --muted: #64748b;
      --light: #f8fafc;
      --border: #e2e8f0;
      --white: #ffffff;
      --danger: #dc2626;
      --radius: 18px;
      --shadow: 0 12px 35px rgba(15, 23, 42, .08);
    }

    body {
      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      background: var(--light);
      color: var(--text);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    .container {
      width: min(1180px, 92%);
      margin: auto;
    }

    /* =========================
       HEADER
    ========================= */

    header {
      background: rgba(255,255,255,.96);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(12px);
    }

    .nav {
      min-height: 70px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 800;
      font-size: 20px;
      color: var(--dark);
    }

    .brand-logo {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      object-fit: cover;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .nav-btn {
      border: 1px solid var(--border);
      background: var(--white);
      padding: 9px 14px;
      border-radius: 10px;
      cursor: pointer;
      color: var(--dark);
      font-weight: 600;
    }

    .nav-btn:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    /* =========================
       LOADING
    ========================= */

    .loading {
      min-height: 70vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .loader-box {
      background: var(--white);
      padding: 35px;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .spinner {
      width: 45px;
      height: 45px;
      border: 4px solid #dbeafe;
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: spin .8s linear infinite;
      margin: 0 auto 15px;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* =========================
       ERROR
    ========================= */

    .error-box {
      display: none;
      margin: 50px auto;
      max-width: 650px;
      padding: 35px;
      background: #fff;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      text-align: center;
    }

    .error-icon {
      font-size: 45px;
      margin-bottom: 10px;
    }

    .error-box h2 {
      color: var(--dark);
      margin-bottom: 8px;
    }

    .error-box p {
      color: var(--muted);
      margin-bottom: 20px;
    }

    .primary-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: none;
      background: var(--primary);
      color: #fff;
      padding: 12px 20px;
      border-radius: 11px;
      cursor: pointer;
      font-weight: 700;
    }

    .primary-btn:hover {
      background: var(--primary-dark);
    }

    /* =========================
       MAIN
    ========================= */

    main {
      padding: 35px 0 70px;
    }

    .breadcrumb {
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 22px;
    }

    .breadcrumb a {
      color: var(--primary);
      font-weight: 600;
    }

    /* =========================
       PROFILE HERO
    ========================= */

    .profile-hero {
      background:
        linear-gradient(
          135deg,
          #0f172a,
          #1e3a8a,
          #4c1d95
        );
      border-radius: 26px;
      padding: 35px;
      color: #fff;
      box-shadow: var(--shadow);
      overflow: hidden;
      position: relative;
    }

    .profile-hero::before {
      content: "";
      position: absolute;
      width: 300px;
      height: 300px;
      border-radius: 50%;
      background: rgba(255,255,255,.07);
      right: -100px;
      top: -100px;
    }

    .profile-main {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 130px 1fr auto;
      gap: 25px;
      align-items: center;
    }

    .avatar {
      width: 125px;
      height: 125px;
      border-radius: 50%;
      object-fit: cover;
      border: 5px solid rgba(255,255,255,.8);
      background: #e2e8f0;
    }

    .profile-info h1 {
      font-size: clamp(28px, 5vw, 42px);
      margin-bottom: 5px;
    }

    .username {
      color: #cbd5e1;
      margin-bottom: 12px;
    }

    .verified {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: rgba(34,197,94,.15);
      border: 1px solid rgba(134,239,172,.35);
      color: #bbf7d0;
      padding: 4px 9px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
    }

    .profile-category {
      display: inline-block;
      margin-top: 10px;
      padding: 6px 11px;
      background: rgba(255,255,255,.1);
      border-radius: 8px;
      font-size: 13px;
    }

    .profile-actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-width: 145px;
    }

    .follow-btn,
    .share-btn {
      border: none;
      border-radius: 10px;
      padding: 11px 18px;
      cursor: pointer;
      font-weight: 700;
    }

    .follow-btn {
      background: #fff;
      color: var(--primary);
    }

    .share-btn {
      background: rgba(255,255,255,.12);
      color: #fff;
      border: 1px solid rgba(255,255,255,.2);
    }

    .follow-btn:hover {
      background: #eff6ff;
    }

    .share-btn:hover {
      background: rgba(255,255,255,.2);
    }

    /* =========================
       STATS
    ========================= */

    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-top: 25px;
    }

    .stat {
      background: rgba(255,255,255,.08);
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 14px;
      padding: 16px;
      text-align: center;
    }

    .stat strong {
      display: block;
      font-size: 24px;
      color: #fff;
    }

    .stat span {
      color: #cbd5e1;
      font-size: 13px;
    }

    /* =========================
       GRID
    ========================= */

    .content-grid {
      display: grid;
      grid-template-columns: 1.65fr .85fr;
      gap: 25px;
      margin-top: 25px;
    }

    .card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 25px;
      box-shadow: var(--shadow);
      margin-bottom: 25px;
    }

    .card:last-child {
      margin-bottom: 0;
    }

    .card h2 {
      color: var(--dark);
      font-size: 21px;
      margin-bottom: 15px;
    }

    .bio {
      color: var(--text);
      white-space: pre-line;
    }

    /* =========================
       SKILLS
    ========================= */

    .skills {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
    }

    .skill {
      padding: 7px 12px;
      border-radius: 999px;
      background: #eff6ff;
      color: #1d4ed8;
      border: 1px solid #dbeafe;
      font-size: 13px;
      font-weight: 600;
    }

    /* =========================
       SOCIAL
    ========================= */

    .social-list {
      display: grid;
      gap: 10px;
    }

    .social-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 11px 13px;
      border: 1px solid var(--border);
      border-radius: 10px;
      transition: .2s;
    }

    .social-link:hover {
      border-color: var(--primary);
      color: var(--primary);
      transform: translateY(-1px);
    }

    .social-name {
      font-weight: 700;
    }

    .social-value {
      color: var(--muted);
      font-size: 13px;
    }

    /* =========================
       ITEMS
    ========================= */

    .items {
      display: grid;
      gap: 13px;
    }

    .item {
      border: 1px solid var(--border);
      padding: 16px;
      border-radius: 13px;
      transition: .2s;
    }

    .item:hover {
      border-color: #bfdbfe;
      transform: translateY(-2px);
    }

    .item h3 {
      color: var(--dark);
      margin-bottom: 4px;
      font-size: 17px;
    }

    .item p {
      color: var(--muted);
      font-size: 14px;
    }

    .item-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 9px;
    }

    .badge {
      font-size: 11px;
      font-weight: 700;
      padding: 4px 8px;
      border-radius: 7px;
      background: #f1f5f9;
      color: #475569;
    }

    /* =========================
       EMPTY
    ========================= */

    .empty {
      color: var(--muted);
      background: #f8fafc;
      border: 1px dashed var(--border);
      border-radius: 12px;
      padding: 18px;
      text-align: center;
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
      background: var(--dark);
      color: #cbd5e1;
      padding: 45px 0 25px;
      margin-top: 30px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.5fr repeat(3, 1fr);
      gap: 30px;
    }

    .footer-title {
      color: #fff;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .footer-links {
      display: grid;
      gap: 7px;
      font-size: 14px;
    }

    .footer-links a:hover {
      color: #fff;
    }

    .copyright {
      border-top: 1px solid rgba(255,255,255,.1);
      margin-top: 30px;
      padding-top: 20px;
      text-align: center;
      font-size: 13px;
      color: #94a3b8;
    }

    /* =========================
       RESPONSIVE
    ========================= */

    @media (max-width: 850px) {
      .profile-main {
        grid-template-columns: 90px 1fr;
      }

      .avatar {
        width: 90px;
        height: 90px;
      }

      .profile-actions {
        grid-column: 1 / -1;
        flex-direction: row;
      }

      .profile-actions button {
        flex: 1;
      }

      .stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .content-grid {
        grid-template-columns: 1fr;
      }

      .footer-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 520px) {
      .profile-hero {
        padding: 22px;
      }

      .profile-main {
        grid-template-columns: 75px 1fr;
        gap: 15px;
      }

      .avatar {
        width: 75px;
        height: 75px;
      }

      .profile-info h1 {
        font-size: 25px;
      }

      .stats {
        gap: 8px;
      }

      .stat {
        padding: 12px 7px;
      }

      .stat strong {
        font-size: 20px;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }

      .nav-btn {
        padding: 8px 10px;
      }
    }
  </style>
</head>

