<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Cyber Security Skills</title>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --success: #16a34a;
      --shadow: 0 10px 30px rgba(15, 23, 42, .08);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    .container {
      width: min(1150px, 92%);
      margin: auto;
    }

    header {
      background:
        linear-gradient(
          135deg,
          #0f172a,
          #1e3a8a,
          #2563eb
        );
      color: white;
      padding: 70px 0;
    }

    .eyebrow {
      display: inline-flex;
      gap: 8px;
      align-items: center;
      background: rgba(255,255,255,.12);
      padding: 8px 13px;
      border-radius: 30px;
      font-size: .85rem;
      margin-bottom: 18px;
    }

    header h1 {
      font-size: clamp(2.2rem, 6vw, 4rem);
      margin: 0 0 15px;
    }

    header p {
      max-width: 700px;
      line-height: 1.7;
      color: #dbeafe;
      margin: 0;
    }

    main {
      padding: 40px 0;
    }

    .filters {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 15px;
      background: var(--card);
      border: 1px solid var(--border);
      padding: 20px;
      border-radius: 15px;
      box-shadow: var(--shadow);
      margin-bottom: 25px;
    }

    .filter-group label {
      display: block;
      font-weight: 700;
      font-size: .9rem;
      margin-bottom: 8px;
    }

    input,
    select {
      width: 100%;
      border: 1px solid var(--border);
      background: white;
      padding: 12px 14px;
      border-radius: 9px;
      font-size: .95rem;
      outline: none;
    }

    input:focus,
    select:focus {
      border-color: var(--primary);
    }

    .input-wrap {
      position: relative;
    }

    .input-wrap i {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
    }

    .input-wrap input {
      padding-left: 40px;
    }

    .result-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 20px;
    }

    .result-bar select {
      width: auto;
      min-width: 170px;
    }

    .course-grid {
      display: grid;
      grid-template-columns:
        repeat(auto-fit, minmax(280px, 1fr));
      gap: 22px;
    }

    .course-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 15px;
      overflow: hidden;
      box-shadow: var(--shadow);
      transition: .25s ease;
    }

    .course-card:hover {
      transform: translateY(-5px);
    }

    .course-cover {
      height: 175px;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 4rem;
      color: white;
    }

    .cover-network {
      background: linear-gradient(135deg,#0f172a,#334155);
    }

    .cover-ethical {
      background: linear-gradient(135deg,#7c3aed,#4c1d95);
    }

    .cover-soc {
      background: linear-gradient(135deg,#0369a1,#0c4a6e);
    }

    .cover-cloud {
      background: linear-gradient(135deg,#0891b2,#164e63);
    }

    .cover-forensics {
      background: linear-gradient(135deg,#be123c,#881337);
    }

    .cover-app {
      background: linear-gradient(135deg,#15803d,#14532d);
    }

    .cover-iam {
      background: linear-gradient(135deg,#ca8a04,#713f12);
    }

    .cover-governance {
      background: linear-gradient(135deg,#475569,#1e293b);
    }

    .course-content {
      padding: 20px;
    }

    .course-content h3 {
      margin: 10px 0;
      font-size: 1.2rem;
    }

    .course-content p {
      color: var(--muted);
      line-height: 1.6;
    }

    .course-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-bottom: 12px;
    }

    .badge {
      background: #eff6ff;
      color: #1d4ed8;
      border-radius: 20px;
      padding: 6px 10px;
      font-size: .78rem;
      font-weight: 700;
    }

    .btn {
      width: 100%;
      padding: 12px 16px;
      border: none;
      border-radius: 9px;
      cursor: pointer;
      font-weight: 700;
      font-size: .95rem;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background: var(--primary-dark);
    }

    .empty {
      grid-column: 1 / -1;
      text-align: center;
      background: white;
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 60px 20px;
      color: var(--muted);
    }

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(15,23,42,.7);
      display: none;
      justify-content: center;
      align-items: center;
      padding: 20px;
      z-index: 1000;
    }

    .modal.active {
      display: flex;
    }

    .modal-box {
      background: white;
      width: min(700px, 100%);
      max-height: 90vh;
      overflow-y: auto;
      border-radius: 16px;
      padding: 28px;
      position: relative;
    }

    .close {
      position: absolute;
      right: 16px;
      top: 12px;
      border: 0;
      background: transparent;
      font-size: 30px;
      cursor: pointer;
      color: var(--muted);
    }

    .modal-box h2 {
      margin-top: 5px;
    }

    .modal-box li {
      margin: 10px 0;
      color: var(--muted);
    }

    footer {
      text-align: center;
      padding: 35px 20px;
      color: var(--muted);
    }

    @media (max-width: 750px) {
      .filters {
        grid-template-columns: 1fr;
      }

      .result-bar {
        align-items: stretch;
        flex-direction: column;
      }

      .result-bar select {
        width: 100%;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="container">

    <div class="eyebrow">
      <i class="fa-solid fa-shield-halved"></i>
      Career Skills
    </div>

    <h1>Cyber Security Skills</h1>

    <p>
      Develop practical cybersecurity knowledge for protecting
      systems, networks, applications, cloud environments,
      and digital information.
    </p>

  </div>
</header>


<main class="container">

  <!-- FILTERS -->
  <section class="filters">

    <div class="filter-group">
      <label for="search">Search Skills</label>

      <div class="input-wrap">
        <i class="fa-solid fa-magnifying-glass"></i>

        <input
          type="search"
          id="search"
          placeholder="Search cybersecurity skills..."
        >
      </div>
    </div>


    <div class="filter-group">
      <label for="level">Level</label>

      <select id="level">
        <option value="all">All Levels</option>
        <option value="Beginner">Beginner</option>
        <option value="Intermediate">Intermediate</option>
        <option value="Advanced">Advanced</option>
      </select>
    </div>


    <div class="filter-group">
      <label for="category">Category</label>

      <select id="category">
        <option value="all">All Categories</option>
        <option value="Network Security">Network Security</option>
        <option value="Ethical Hacking">Ethical Hacking</option>
        <option value="Security Operations">Security Operations</option>
        <option value="Cloud Security">Cloud Security</option>
        <option value="Digital Forensics">Digital Forensics</option>
        <option value="Application Security">Application Security</option>
        <option value="Identity Security">Identity Security</option>
        <option value="Governance">Governance</option>
      </select>
    </div>

  </section>


  <div class="result-bar">

    <strong id="resultCount">
      0 skills
    </strong>

    <select id="sort">
      <option value="popularity">Most Popular</option>
      <option value="az">A-Z</option>
      <option value="level">Level</option>
    </select>

  </div>


  <!-- DYNAMIC SKILLS -->
  <section
    class="course-grid"
    id="courseGrid"
  ></section>

</main>


<!-- DETAILS MODAL -->
<div
  class="modal"
  id="detailsModal"
>

  <div class="modal-box">

    <button
      type="button"
      class="close"
      id="closeModal"
    >
      &times;
    </button>

    <div id="modalContent"></div>

  </div>

</div>


<footer>
  <p>
    © 2026 Cyber Security Skills Platform
  </p>
</footer>


<script>

  /* =========================================
     CYBER SECURITY SKILLS DATA
  ========================================= */

  const cyberSkills = [

    {
      id: 1,
      title: "Network Security",
      category: "Network Security",
      level: "Beginner",
      duration: "6 weeks",
      popularity: 98,
      icon: "fa-solid fa-network-wired",
      cover: "network",
      description:
        "Learn how networks are protected against unauthorized access, attacks, and security threats.",
      skills: [
        "Network fundamentals",
        "Firewalls",
        "VPNs",
        "Network monitoring",
        "Security protocols"
      ]
    },


    {
      id: 2,
      title: "Ethical Hacking",
      category: "Ethical Hacking",
      level: "Intermediate",
      duration: "10 weeks",
      popularity: 100,
      icon: "fa-solid fa-user-secret",
      cover: "ethical",
      description:
        "Learn authorized security testing techniques used to identify weaknesses in systems and applications.",
      skills: [
        "Security assessment",
        "Vulnerability analysis",
        "Penetration testing",
        "Security reporting",
        "Defensive remediation"
      ]
    },


    {
      id: 3,
      title: "Security Operations",
      category: "Security Operations",
      level: "Intermediate",
      duration: "8 weeks",
      popularity: 96,
      icon: "fa-solid fa-eye",
      cover: "soc",
      description:
        "Develop skills for monitoring security events and responding to cybersecurity incidents.",
      skills: [
        "Security monitoring",
        "Log analysis",
        "Incident response",
        "Threat detection",
        "Security alerts"
      ]
    },


    {
      id: 4,
      title: "Cloud Security",
      category: "Cloud Security",
      level: "Advanced",
      duration: "9 weeks",
      popularity: 95,
      icon: "fa-solid fa-cloud",
      cover: "cloud",
      description:
        "Understand how to secure cloud infrastructure, applications, identities, and data.",
      skills: [
        "Cloud security fundamentals",
        "Access control",
        "Cloud monitoring",
        "Data protection",
        "Security architecture"
      ]
    },


    {
      id: 5,
      title: "Digital Forensics",
      category: "Digital Forensics",
      level: "Advanced",
      duration: "10 weeks",
      popularity: 91,
      icon: "fa-solid fa-magnifying-glass",
      cover: "forensics",
      description:
        "Learn the fundamentals of investigating digital evidence after security incidents.",
      skills: [
        "Evidence handling",
        "Disk analysis",
        "Digital investigation",
        "Incident analysis",
        "Forensic reporting"
      ]
    },


    {
      id: 6,
      title: "Application Security",
      category: "Application Security",
      level: "Intermediate",
      duration: "7 weeks",
      popularity: 94,
      icon: "fa-solid fa-code",
      cover: "app",
      description:
        "Learn secure software development principles and how to reduce common application security risks.",
      skills: [
        "Secure coding",
        "Application threat modeling",
        "Input validation",
        "Authentication security",
        "Security testing"
      ]
    },


    {
      id: 7,
      title: "Identity and Access Management",
      category: "Identity Security",
      level: "Intermediate",
      duration: "6 weeks",
      popularity: 89,
      icon: "fa-solid fa-key",
      cover: "iam",
      description:
        "Learn how organizations manage identities, authentication, authorization, and access.",
      skills: [
        "Authentication",
        "Authorization",
        "Role-based access",
        "Multi-factor authentication",
        "Identity lifecycle"
      ]
    },


    {
      id: 8,
      title: "Cybersecurity Governance",
      category: "Governance",
      level: "Advanced",
      duration: "7 weeks",
      popularity: 86,
      icon: "fa-solid fa-scale-balanced",
      cover: "governance",
      description:
        "Understand cybersecurity policies, risk management, compliance, and organizational security.",
      skills: [
        "Security policies",
        "Risk management",
        "Compliance",
        "Security frameworks",
        "Security governance"
      ]
    }

  ];


  /* =========================================
     DOM
  ========================================= */

  const grid =
    document.getElementById("courseGrid");

  const searchInput =
    document.getElementById("search");

  const levelSelect =
    document.getElementById("level");

  const categorySelect =
    document.getElementById("category");

  const sortSelect =
    document.getElementById("sort");

  const resultCount =
    document.getElementById("resultCount");

  const modal =
    document.getElementById("detailsModal");

  const modalContent =
    document.getElementById("modalContent");

  const closeModal =
    document.getElementById("closeModal");


  /* =========================================
     ESCAPE HTML
  ========================================= */

  function escapeHTML(value) {

    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

  }


  /* =========================================
     RENDER
  ========================================= */

  function renderSkills(list) {

    if (!list.length) {

      grid.innerHTML = `

        <div class="empty">

          <i
            class="fa-solid fa-shield-halved"
            style="font-size:3rem;"
          ></i>

          <h2>No skills found</h2>

          <p>
            Try changing your search or filters.
          </p>

        </div>

      `;

      resultCount.textContent = "0 skills";

      return;
    }


    grid.innerHTML = list.map(skill => `

      <article class="course-card">

        <div class="course-cover cover-${skill.cover}">
          <i class="${skill.icon}"></i>
        </div>


        <div class="course-content">

          <div class="course-meta">

            <span class="badge">
              ${escapeHTML(skill.level)}
            </span>

            <span class="badge">
              ${escapeHTML(skill.category)}
            </span>

          </div>


          <h3>
            ${escapeHTML(skill.title)}
          </h3>


          <p>
            ${escapeHTML(skill.description)}
          </p>


          <div class="course-meta">

            <span class="badge">
              <i class="fa-regular fa-clock"></i>
              ${escapeHTML(skill.duration)}
            </span>

            <span class="badge">
              <i class="fa-solid fa-fire"></i>
              ${skill.popularity}%
            </span>

          </div>


          <button
            type="button"
            class="btn btn-primary"
            onclick="showDetails(${skill.id})"
          >
            View Details
          </button>

        </div>

      </article>

    `).join("");


    resultCount.textContent =
      `${list.length} skill${list.length === 1 ? "" : "s"}`;
  }


  /* =========================================
     FILTER
  ========================================= */

  function filterSkills() {

    const search =
      searchInput.value
        .trim()
        .toLowerCase();

    const level =
      levelSelect.value;

    const category =
      categorySelect.value;


    let filtered =
      cyberSkills.filter(skill => {

        const searchableText = [

          skill.title,
          skill.category,
          skill.level,
          skill.description,
          ...skill.skills

        ]
          .join(" ")
          .toLowerCase();


        const matchesSearch =
          !search ||
          searchableText.includes(search);


        const matchesLevel =
          level === "all" ||
          skill.level === level;


        const matchesCategory =
          category === "all" ||
          skill.category === category;


        return (
          matchesSearch &&
          matchesLevel &&
          matchesCategory
        );

      });


    /* SORT */

    if (sortSelect.value === "az") {

      filtered.sort((a, b) =>
        a.title.localeCompare(b.title)
      );

    }

    else if (sortSelect.value === "level") {

      const order = {
        Beginner: 1,
        Intermediate: 2,
        Advanced: 3
      };

      filtered.sort(
        (a, b) =>
          order[a.level] - order[b.level]
      );

    }

    else {

      filtered.sort(
        (a, b) =>
          b.popularity - a.popularity
      );

    }


    renderSkills(filtered);
  }


  /* =========================================
     DETAILS
  ========================================= */

  function showDetails(id) {

    const skill =
      cyberSkills.find(
        item => item.id === id
      );

    if (!skill) return;


    modalContent.innerHTML = `

      <div
        class="course-cover cover-${skill.cover}"
        style="border-radius:12px;margin-bottom:20px;"
      >
        <i class="${skill.icon}"></i>
      </div>


      <span class="badge">
        ${escapeHTML(skill.category)}
      </span>


      <h2>
        ${escapeHTML(skill.title)}
      </h2>


      <p>
        ${escapeHTML(skill.description)}
      </p>


      <p>
        <strong>Level:</strong>
        ${escapeHTML(skill.level)}
      </p>


      <p>
        <strong>Duration:</strong>
        ${escapeHTML(skill.duration)}
      </p>


      <h3>
        Key Skills
      </h3>


      <ul>

        ${skill.skills.map(item => `

          <li>
            <i
              class="fa-solid fa-check"
              style="color:#16a34a;margin-right:7px;"
            ></i>

            ${escapeHTML(item)}
          </li>

        `).join("")}

      </ul>


      <button
        type="button"
        class="btn btn-primary"
        onclick="startLearning(${skill.id})"
      >
        Start Learning
      </button>

    `;


    modal.classList.add("active");

    document.body.style.overflow = "hidden";
  }


  /* =========================================
     START LEARNING
  ========================================= */

  function startLearning(id) {

    const skill =
      cyberSkills.find(
        item => item.id === id
      );

    if (!skill) return;

    alert(
      `You selected "${skill.title}". Connect this button to your learning/course page.`
    );
  }


  /* =========================================
     CLOSE MODAL
  ========================================= */

  function closeDetails() {

    modal.classList.remove("active");

    document.body.style.overflow = "";
  }


  closeModal.addEventListener(
    "click",
    closeDetails
  );


  modal.addEventListener(
    "click",
    event => {

      if (event.target === modal) {
        closeDetails();
      }

    }
  );


  document.addEventListener(
    "keydown",
    event => {

      if (event.key === "Escape") {
        closeDetails();
      }

    }
  );


  /* =========================================
     EVENTS
  ========================================= */

     /* =========================================
       EVENTS
    ========================================= */

    searchInput.addEventListener(
      "input",
      filterSkills
    );

    levelSelect.addEventListener(
      "change",
      filterSkills
    );

    categorySelect.addEventListener(
      "change",
      filterSkills
    );

    sortSelect.addEventListener(
      "change",
      filterSkills
    );


    /* =========================================
       KEYBOARD SHORTCUT
    ========================================= */

    document.addEventListener(
      "keydown",
      function(event) {

        if (
          event.key === "/" &&
          document.activeElement.tagName !== "INPUT" &&
          document.activeElement.tagName !== "SELECT"
        ) {

          event.preventDefault();

          searchInput.focus();

        }

      }
    );


    /* =========================================
       RESET FILTERS
    ========================================= */

    function resetFilters() {

      searchInput.value = "";
      levelSelect.value = "all";
      categorySelect.value = "all";
      sortSelect.value = "popularity";

      filterSkills();

    }


    /* =========================================
       INITIAL LOAD
    ========================================= */

    renderSkills(
      [...cyberSkills].sort(
        (a, b) =>
          b.popularity - a.popularity
      )
    );


    /* =========================================
       END OF PAGE SCRIPT
    ========================================= */

  </script>

</body>
</html>