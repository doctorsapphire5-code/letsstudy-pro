<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Data Science Skills</title>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --shadow: 0 10px 30px rgba(15, 23, 42, .08);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    .container {
      width: min(1150px, 92%);
      margin: auto;
    }

    header {
      background:
        linear-gradient(135deg, #0f172a, #1d4ed8, #06b6d4);
      color: white;
      padding: 70px 0;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255,255,255,.13);
      padding: 8px 14px;
      border-radius: 30px;
      font-size: .85rem;
      margin-bottom: 18px;
    }

    header h1 {
      margin: 0 0 15px;
      font-size: clamp(2.2rem, 6vw, 4rem);
    }

    header p {
      max-width: 720px;
      line-height: 1.7;
      color: #dbeafe;
      margin: 0;
    }

    main {
      padding: 40px 0;
    }

    .filters {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 15px;
      background: var(--card);
      border: 1px solid var(--border);
      padding: 20px;
      border-radius: 15px;
      box-shadow: var(--shadow);
      margin-bottom: 25px;
    }

    .filter-group label {
      display: block;
      font-weight: 700;
      font-size: .9rem;
      margin-bottom: 8px;
    }

    input,
    select {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--border);
      border-radius: 9px;
      background: white;
      font-size: .95rem;
      outline: none;
    }

    input:focus,
    select:focus {
      border-color: var(--primary);
    }

    .input-wrap {
      position: relative;
    }

    .input-wrap i {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
    }

    .input-wrap input {
      padding-left: 40px;
    }

    .result-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 20px;
    }

    .result-bar select {
      width: auto;
      min-width: 180px;
    }

    .skills-grid {
      display: grid;
      grid-template-columns:
        repeat(auto-fit, minmax(280px, 1fr));
      gap: 22px;
    }

    .skill-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 15px;
      overflow: hidden;
      box-shadow: var(--shadow);
      transition: .25s ease;
    }

    .skill-card:hover {
      transform: translateY(-5px);
    }

    .skill-cover {
      height: 175px;
      display: flex;
      justify-content: center;
      align-items: center;
      color: white;
      font-size: 4rem;
    }

    .cover-fundamentals {
      background: linear-gradient(135deg,#2563eb,#1e40af);
    }

    .cover-python {
      background: linear-gradient(135deg,#eab308,#ca8a04);
    }

    .cover-statistics {
      background: linear-gradient(135deg,#7c3aed,#4c1d95);
    }

    .cover-analysis {
      background: linear-gradient(135deg,#0891b2,#155e75);
    }

    .cover-visualization {
      background: linear-gradient(135deg,#16a34a,#166534);
    }

    .cover-sql {
      background: linear-gradient(135deg,#ea580c,#9a3412);
    }

    .cover-ml {
      background: linear-gradient(135deg,#db2777,#831843);
    }

    .cover-bigdata {
      background: linear-gradient(135deg,#475569,#1e293b);
    }

    .skill-content {
      padding: 20px;
    }

    .skill-content h3 {
      margin: 10px 0;
    }

    .skill-content p {
      color: var(--muted);
      line-height: 1.6;
    }

    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin-bottom: 12px;
    }

    .badge {
      background: #eff6ff;
      color: #1d4ed8;
      border-radius: 20px;
      padding: 6px 10px;
      font-size: .78rem;
      font-weight: 700;
    }

    .btn {
      width: 100%;
      border: none;
      border-radius: 9px;
      padding: 12px 16px;
      cursor: pointer;
      font-weight: 700;
      font-size: .95rem;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background: var(--primary-dark);
    }

    .empty {
      grid-column: 1 / -1;
      text-align: center;
      background: white;
      border: 1px solid var(--border);
      border-radius: 15px;
      padding: 60px 20px;
      color: var(--muted);
    }

    .empty i {
      font-size: 3rem;
      margin-bottom: 15px;
    }

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(15,23,42,.7);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 1000;
    }

    .modal.active {
      display: flex;
    }

    .modal-box {
      width: min(700px, 100%);
      max-height: 90vh;
      overflow-y: auto;
      background: white;
      border-radius: 16px;
      padding: 28px;
      position: relative;
    }

    .close {
      position: absolute;
      right: 16px;
      top: 12px;
      border: none;
      background: transparent;
      font-size: 30px;
      cursor: pointer;
      color: var(--muted);
    }

    .modal-box li {
      margin: 10px 0;
      color: var(--muted);
    }

    footer {
      text-align: center;
      padding: 35px 20px;
      color: var(--muted);
    }

    @media (max-width: 750px) {
      .filters {
        grid-template-columns: 1fr;
      }

      .result-bar {
        flex-direction: column;
        align-items: stretch;
      }

      .result-bar select {
        width: 100%;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="container">

    <div class="eyebrow">
      <i class="fa-solid fa-chart-line"></i>
      Career Skills
    </div>

    <h1>Data Science Skills</h1>

    <p>
      Build practical data science skills for analyzing data,
      discovering insights, creating visualizations, and developing
      intelligent data-driven solutions.
    </p>

  </div>
</header>


<main class="container">

  <!-- FILTERS -->
  <section class="filters">

    <div class="filter-group">
      <label for="search">Search Skills</label>

      <div class="input-wrap">
        <i class="fa-solid fa-magnifying-glass"></i>

        <input
          type="search"
          id="search"
          placeholder="Search data science skills..."
        >
      </div>
    </div>


    <div class="filter-group">
      <label for="level">Level</label>

      <select id="level">
        <option value="all">All Levels</option>
        <option value="Beginner">Beginner</option>
        <option value="Intermediate">Intermediate</option>
        <option value="Advanced">Advanced</option>
      </select>
    </div>


    <div class="filter-group">
      <label for="category">Category</label>

      <select id="category">
        <option value="all">All Categories</option>
        <option value="Data Fundamentals">Data Fundamentals</option>
        <option value="Python">Python</option>
        <option value="Statistics">Statistics</option>
        <option value="Data Analysis">Data Analysis</option>
        <option value="Data Visualization">Data Visualization</option>
        <option value="SQL">SQL</option>
        <option value="Machine Learning">Machine Learning</option>
        <option value="Big Data">Big Data</option>
      </select>
    </div>

  </section>


  <div class="result-bar">

    <strong id="resultCount">
      0 skills
    </strong>

    <select id="sort">
      <option value="popularity">Most Popular</option>
      <option value="az">A-Z</option>
      <option value="level">Level</option>
    </select>

  </div>


  <!-- SKILLS -->
  <section
    class="skills-grid"
    id="skillsGrid"
  ></section>

</main>


<!-- DETAILS MODAL -->
<div
  class="modal"
  id="detailsModal"
>

  <div class="modal-box">

    <button
      type="button"
      class="close"
      id="closeModal"
      aria-label="Close"
    >
      &times;
    </button>

    <div id="modalContent"></div>

  </div>

</div>


<footer>
  <p>
    © 2026 Data Science Skills Platform
  </p>
</footer>


<script>

  /* =========================================
     DATA SCIENCE SKILLS
  ========================================= */

  const dataScienceSkills = [

    {
      id: 1,
      title: "Data Science Fundamentals",
      category: "Data Fundamentals",
      level: "Beginner",
      duration: "4 weeks",
      popularity: 98,
      icon: "fa-solid fa-database",
      cover: "fundamentals",
      description:
        "Learn the essential concepts, workflows, and tools used in modern data science.",
      skills: [
        "Data science lifecycle",
        "Data collection",
        "Data cleaning",
        "Exploratory analysis",
        "Data-driven decision making"
      ]
    },


    {
      id: 2,
      title: "Python for Data Science",
      category: "Python",
      level: "Beginner",
      duration: "6 weeks",
      popularity: 100,
      icon: "fa-brands fa-python",
      cover: "python",
      description:
        "Learn Python programming and the core libraries used for data science.",
      skills: [
        "Python programming",
        "NumPy",
        "Pandas",
        "Functions",
        "Data manipulation"
      ]
    },


    {
      id: 3,
      title: "Statistics for Data Science",
      category: "Statistics",
      level: "Intermediate",
      duration: "7 weeks",
      popularity: 94,
      icon: "fa-solid fa-square-root-variable",
      cover: "statistics",
      description:
        "Develop statistical reasoning skills for analyzing data and interpreting results.",
      skills: [
        "Probability",
        "Descriptive statistics",
        "Distributions",
        "Hypothesis testing",
        "Correlation"
      ]
    },


    {
      id: 4,
      title: "Data Analysis",
      category: "Data Analysis",
      level: "Intermediate",
      duration: "6 weeks",
      popularity: 97,
      icon: "fa-solid fa-magnifying-glass-chart",
      cover: "analysis",
      description:
        "Learn how to transform raw datasets into useful insights and conclusions.",
      skills: [
        "Data cleaning",
        "Exploratory data analysis",
        "Feature analysis",
        "Data transformation",
        "Business insights"
      ]
    },


    {
      id: 5,
      title: "Data Visualization",
      category: "Data Visualization",
      level: "Beginner",
      duration: "5 weeks",
      popularity: 92,
      icon: "fa-solid fa-chart-column",
      cover: "visualization",
      description:
        "Learn how to communicate data insights using effective charts and visualizations.",
      skills: [
        "Charts",
        "Dashboards",
        "Visual storytelling",
        "Interactive visualization",
        "Data presentation"
      ]
    },


    {
      id: 6,
      title: "SQL for Data Science",
      category: "SQL",
      level: "Intermediate",
      duration: "5 weeks",
      popularity: 96,
      icon: "fa-solid fa-table",
      cover: "sql",
      description:
        "Master SQL techniques for querying, filtering, joining, and analyzing structured data.",
      skills: [
        "SELECT queries",
        "Filtering",
        "JOINs",
        "Aggregation",
        "Subqueries"
      ]
    },


    {
      id: 7,
      title: "Machine Learning",
      category: "Machine Learning",
      level: "Advanced",
      duration: "10 weeks",
      popularity: 99,
      icon: "fa-solid fa-robot",
      cover: "ml",
      description:
        "Learn how machine learning models discover patterns and make predictions from data.",
      skills: [
        "Regression",
        "Classification",
        "Clustering",
        "Feature engineering",
        "Model evaluation"
      ]
    },


    {
      id: 8,
      title: "Big Data Analytics",
      category: "Big Data",
      level: "Advanced",
      duration: "9 weeks",
      popularity: 89,
      icon: "fa-solid fa-server",
      cover: "bigdata",
      description:
        "Learn concepts and tools for working with large-scale datasets and distributed systems.",
      skills: [
        "Big data concepts",
        "Distributed processing",
        "Data pipelines",
        "Large-scale analytics",
        "Data engineering"
      ]
    }

  ];


  /* =========================================
     DOM ELEMENTS
  ========================================= */

  const skillsGrid =
    document.getElementById("skillsGrid");

  const searchInput =
    document.getElementById("search");

  const levelSelect =
    document.getElementById("level");

  const categorySelect =
    document.getElementById("category");

  const sortSelect =
    document.getElementById("sort");

  const resultCount =
    document.getElementById("resultCount");

  const modal =
    document.getElementById("detailsModal");

  const modalContent =
    document.getElementById("modalContent");

  const closeModal =
    document.getElementById("closeModal");


  /* =========================================
     SECURITY
  ========================================= */

  function escapeHTML(value) {

    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

  }


  /* =========================================
     RENDER SKILLS
  ========================================= */

  function renderSkills(list) {

    if (!list.length) {

      skillsGrid.innerHTML = `

        <div class="empty">

          <i class="fa-solid fa-chart-line"></i>

          <h2>No skills found</h2>

          <p>
            Try another search term or change your filters.
          </p>

        </div>

      `;

      resultCount.textContent = "0 skills";

      return;
    }


    skillsGrid.innerHTML =
      list.map(skill => `

        <article class="skill-card">

          <div
            class="skill-cover cover-${skill.cover}"
          >
            <i class="${skill.icon}"></i>
          </div>


          <div class="skill-content">

            <div class="meta">

              <span class="badge">
                ${escapeHTML(skill.level)}
              </span>

              <span class="badge">
                ${escapeHTML(skill.category)}
              </span>

            </div>


            <h3>
              ${escapeHTML(skill.title)}
            </h3>


            <p>
              ${escapeHTML(skill.description)}
            </p>


            <div class="meta">

              <span class="badge">
                <i class="fa-regular fa-clock"></i>
                ${escapeHTML(skill.duration)}
              </span>

              <span class="badge">
                <i class="fa-solid fa-fire"></i>
                ${skill.popularity}%
              </span>

            </div>


            <button
              type="button"
              class="btn btn-primary"
              onclick="showDetails(${skill.id})"
            >
              View Details
            </button>

          </div>

        </article>

      `).join("");


    resultCount.textContent =
      `${list.length} skill${list.length === 1 ? "" : "s"}`;

  }


  /* =========================================
     FILTER SKILLS
  ========================================= */

  function filterSkills() {

    const search =
      searchInput.value
        .trim()
        .toLowerCase();

    const level =
      levelSelect.value;

    const category =
      categorySelect.value;


    let filtered =
      dataScienceSkills.filter(skill => {

        const searchableText = [

          skill.title,
          skill.category,
          skill.level,
          skill.description,
          skill.duration,
          ...skill.skills

        ]
          .join(" ")
          .toLowerCase();


        const matchesSearch =
          !search ||
          searchableText.includes(search);


        const matchesLevel =
          level === "all" ||
          skill.level === level;


        const matchesCategory =
          category === "all" ||
          skill.category === category;


        return (
          matchesSearch &&
          matchesLevel &&
          matchesCategory
        );

      });


    /* =====================================
       SORT
    ===================================== */

    if (sortSelect.value === "az") {

      filtered.sort(
        (a, b) =>
          a.title.localeCompare(b.title)
      );

    }

    else if (sortSelect.value === "level") {

      const levelOrder = {
        Beginner: 1,
        Intermediate: 2,
        Advanced: 3
      };

      filtered.sort(
        (a, b) =>
          levelOrder[a.level] -
          levelOrder[b.level]
      );

    }

    else {

      filtered.sort(
        (a, b) =>
          b.popularity -
          a.popularity
      );

    }


    renderSkills(filtered);

  }


  /* =========================================
     SHOW DETAILS
  ========================================= */

  function showDetails(id) {

    const skill =
      dataScienceSkills.find(
        item => item.id === id
      );

    if (!skill) return;


    modalContent.innerHTML = `

      <div
        class="skill-cover cover-${skill.cover}"
        style="
          border-radius:12px;
          margin-bottom:20px;
        "
      >
        <i class="${skill.icon}"></i>
      </div>


      <span class="badge">
        ${escapeHTML(skill.category)}
      </span>


      <h2>
        ${escapeHTML(skill.title)}
      </h2>


      <p>
        ${escapeHTML(skill.description)}
      </p>


      <p>
        <strong>Level:</strong>
        ${escapeHTML(skill.level)}
      </p>


      <p>
        <strong>Duration:</strong>
        ${escapeHTML(skill.duration)}
      </p>


      <h3>
        Key Skills
      </h3>


      <ul>

        ${skill.skills.map(item => `

          <li>
            <i
              class="fa-solid fa-check"
              style="
                color:#16a34a;
                margin-right:7px;
              "
            ></i>

            ${escapeHTML(item)}
          </li>

        `).join("")}

      </ul>


      <button
        type="button"
        class="btn btn-primary"
        onclick="startLearning(${skill.id})"
      >
        Start Learning
      </button>

    `;


    modal.classList.add("active");

    document.body.style.overflow = "hidden";

  }


  /* =========================================
     START LEARNING
  ========================================= */

  function startLearning(id) {

    const skill =
      dataScienceSkills.find(
        item => item.id === id
      );

    if (!skill) return;


    alert(
      `You selected "${skill.title}". Connect this button to your course or learning page.`
    );

  }


  /* =========================================
     CLOSE MODAL
  ========================================= */

  function closeDetails() {

    modal.classList.remove("active");

    document.body.style.overflow = "";

  }


  closeModal.addEventListener(
    "click",
    closeDetails
  );


  modal.addEventListener(
    "click",
    function(event) {

      if (event.target === modal) {
        closeDetails();
      }

    }
  );


  document.addEventListener(
    "keydown",
    function(event) {

      if (event.key === "Escape") {
        closeDetails();
      }

    }
  );


  /* =========================================
     EVENTS
  ========================================= */

    /* =========================================
     EVENTS
  ========================================= */

  searchInput.addEventListener(
    "input",
    filterSkills
  );

  levelSelect.addEventListener(
    "change",
    filterSkills
  );

  categorySelect.addEventListener(
    "change",
    filterSkills
  );

  sortSelect.addEventListener(
    "change",
    filterSkills
  );


  /* =========================================
     KEYBOARD SHORTCUT
  ========================================= */

  document.addEventListener(
    "keydown",
    function(event) {

      if (
        event.key === "/" &&
        document.activeElement.tagName !== "INPUT" &&
        document.activeElement.tagName !== "SELECT"
      ) {

        event.preventDefault();

        searchInput.focus();

      }

    }
  );


  /* =========================================
     RESET FILTERS
  ========================================= */

  function resetFilters() {

    searchInput.value = "";
    levelSelect.value = "all";
    categorySelect.value = "all";
    sortSelect.value = "popularity";

    filterSkills();

  }


  /* =========================================
     INITIAL LOAD
  ========================================= */

  renderSkills(
    [...dataScienceSkills].sort(
      (a, b) =>
        b.popularity - a.popularity
    )
  );


  /* =========================================
     PAGE READY
  ========================================= */

  document.addEventListener(
    "DOMContentLoaded",
    function() {
      filterSkills();
    }
  );

</script>

</body>
</html>