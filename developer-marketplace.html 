<script>

/* =========================
   MARKET DATA
========================= */

const PRODUCTS_KEY =
"letsstudy_developer_products";

const CART_KEY =
"letsstudy_developer_cart";

const FAVORITES_KEY =
"letsstudy_developer_favorites";


const defaultProducts = [

{
id:"p1",
name:"AI Study Assistant",
category:"Plugins",
description:
"AI-powered learning assistant for courses, notes and student support.",
price:0,
rating:4.9,
downloads:3200,
developer:"LetsStudy Labs",
icon:"🤖",
featured:true
},

{
id:"p2",
name:"Education Pro Theme",
category:"Themes",
description:
"Professional education dashboard theme for learning platforms.",
price:25000,
rating:4.8,
downloads:2100,
developer:"DesignHub",
icon:"🎨",
featured:true
},

{
id:"p3",
name:"Course Dashboard UI",
category:"Templates",
description:
"Complete responsive course dashboard template.",
price:15000,
rating:4.7,
downloads:1800,
developer:"UI Masters",
icon:"📚",
featured:true
},

{
id:"p4",
name:"Firebase Auth Kit",
category:"Components",
description:
"Reusable authentication components for Firebase applications.",
price:10000,
rating:4.8,
downloads:1450,
developer:"DevStack",
icon:"🔐",
featured:true
},

{
id:"p5",
name:"Payments API",
category:"APIs",
description:
"Developer API integration layer for payment workflows.",
price:30000,
rating:4.6,
downloads:980,
developer:"API Forge",
icon:"🔌",
featured:false
},

{
id:"p6",
name:"Creator UI Kit",
category:"UI Kits",
description:
"Modern UI components for creator dashboards and tools.",
price:20000,
rating:4.9,
downloads:1200,
developer:"Pixel Studio",
icon:"✨",
featured:false
},

{
id:"p7",
name:"SEO Toolkit",
category:"Developer Tools",
description:
"SEO utilities for metadata, sitemap and content optimization.",
price:0,
rating:4.5,
downloads:4200,
developer:"WebTools",
icon:"🔎",
featured:false
},

{
id:"p8",
name:"Community Theme",
category:"Themes",
description:
"Clean community interface for groups, discussions and profiles.",
price:18000,
rating:4.7,
downloads:870,
developer:"Community Labs",
icon:"👥",
featured:false
}

];


let products = [];

let cart = [];

let favorites = [];

let activeCategory = "All";


/* =========================
   HELPERS
========================= */

function get(id){
    return document.getElementById(id);
}


function escapeHTML(value){

    return String(value ?? "")
    .replace(
        /[&<>"']/g,
        char => ({
            "&":"&amp;",
            "<":"&lt;",
            ">":"&gt;",
            '"':"&quot;",
            "'":"&#039;"
        }[char])
    );

}


function showToast(message){

    const toast =
        get("toast");

    toast.textContent =
        message;

    toast.classList.add("show");

    clearTimeout(
        window.marketToast
    );

    window.marketToast =
        setTimeout(
            () =>
                toast.classList.remove(
                    "show"
                ),
            2200
        );

}


/* =========================
   LOAD DATA
========================= */

function loadData(){

    try{

        const saved =
            JSON.parse(
                localStorage.getItem(
                    PRODUCTS_KEY
                )
            );

        products =
            Array.isArray(saved)
            ? saved
            : defaultProducts;

    }catch(error){

        products =
            defaultProducts;

    }


    try{

        const savedCart =
            JSON.parse(
                localStorage.getItem(
                    CART_KEY
                )
            );

        cart =
            Array.isArray(savedCart)
            ? savedCart
            : [];

    }catch(error){

        cart = [];

    }


    try{

        const savedFavorites =
            JSON.parse(
                localStorage.getItem(
                    FAVORITES_KEY
                )
            );

        favorites =
            Array.isArray(savedFavorites)
            ? savedFavorites
            : [];

    }catch(error){

        favorites = [];

    }

}


/* =========================
   SAVE DATA
========================= */

function saveData(){

    localStorage.setItem(
        PRODUCTS_KEY,
        JSON.stringify(products)
    );

    localStorage.setItem(
        CART_KEY,
        JSON.stringify(cart)
    );

    localStorage.setItem(
        FAVORITES_KEY,
        JSON.stringify(favorites)
    );

}


/* =========================
   FILTER
========================= */

function filterCategory(category){

    activeCategory =
        category;

    document
    .querySelectorAll(
        ".category"
    )
    .forEach(button => {

        button.classList.toggle(
            "active",
            button.dataset.category ===
            category
        );

    });

    renderProducts();

}


/* =========================
   GET FILTERED
========================= */

function getFilteredProducts(){

    const search =
        get("searchInput")
        .value
        .toLowerCase()
        .trim();

    const price =
        get("priceFilter")
        .value;

    const sort =
        get("sortSelect")
        .value;


    let result =
        products.filter(product => {

            const matchesCategory =
                activeCategory === "All" ||
                product.category ===
                activeCategory;

            const matchesSearch =
                !search ||
                product.name
                .toLowerCase()
                .includes(search) ||

                product.description
                .toLowerCase()
                .includes(search) ||

                product.category
                .toLowerCase()
                .includes(search) ||

                product.developer
                .toLowerCase()
                .includes(search);


            const matchesPrice =
                price === "all" ||

                (
                                    price === "free" &&
                Number(product.price) === 0
            ) ||

            (
                price === "paid" &&
                Number(product.price) > 0
            );


        return (
            matchesCategory &&
            matchesSearch &&
            matchesPrice
        );

    });


    /* =========================
       SORT PRODUCTS
    ========================= */

    if(sort === "priceLow"){

        result.sort(
            (a,b) =>
                Number(a.price) -
                Number(b.price)
        );

    }


    if(sort === "priceHigh"){

        result.sort(
            (a,b) =>
                Number(b.price) -
                Number(a.price)
        );

    }


    if(sort === "rating"){

        result.sort(
            (a,b) =>
                Number(b.rating || 0) -
                Number(a.rating || 0)
        );

    }


    if(sort === "newest"){

        result.sort(
            (a,b) =>
                Number(b.createdAt || 0) -
                Number(a.createdAt || 0)
        );

    }


    if(sort === "popular"){

        result.sort(
            (a,b) =>
                Number(b.downloads || 0) -
                Number(a.downloads || 0)
        );

    }


    return result;

}


/* =========================
   RENDER PRODUCTS
========================= */

function renderProducts(){

