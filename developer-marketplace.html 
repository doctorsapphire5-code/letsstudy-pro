<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Developer Market | LetsStudy Pro</title>

<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

:root{
    --primary:#2563eb;
    --primary-light:#edf3ff;
    --dark:#172033;
    --muted:#737d90;
    --border:#e4e8f0;
    --bg:#f4f6fa;
    --card:#fff;
    --success:#15803d;
    --danger:#dc2626;
    --warning:#d97706;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:var(--bg);
    color:var(--dark);
}

button,
input,
select,
textarea{
    font:inherit;
}

button{
    cursor:pointer;
}

a{
    text-decoration:none;
    color:inherit;
}

.topbar{
    height:66px;
    background:#fff;
    border-bottom:1px solid var(--border);
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 20px;
    position:sticky;
    top:0;
    z-index:50;
}

.brand{
    display:flex;
    align-items:center;
    gap:10px;
    font-weight:900;
}

.brand-icon{
    width:38px;
    height:38px;
    border-radius:10px;
    background:var(--dark);
    color:#fff;
    display:grid;
    place-items:center;
}

.top-actions{
    display:flex;
    gap:8px;
    align-items:center;
}

.btn{
    border:0;
    border-radius:9px;
    padding:10px 14px;
    font-weight:800;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:7px;
}

.primary{
    background:var(--primary);
    color:#fff;
}

.secondary{
    background:#eaf0f7;
    color:var(--dark);
}

.success{
    background:var(--success);
    color:#fff;
}

.danger{
    background:var(--danger);
    color:#fff;
}

.layout{
    display:grid;
    grid-template-columns:225px 1fr;
    min-height:calc(100vh - 66px);
}

.sidebar{
    background:#fff;
    border-right:1px solid var(--border);
    padding:18px 12px;
}

.sidebar-title{
    color:#8992a4;
    font-size:11px;
    font-weight:900;
    text-transform:uppercase;
    padding:8px;
}

.nav{
    display:flex;
    flex-direction:column;
    gap:4px;
}

.nav a{
    padding:11px;
    border-radius:8px;
    color:#596478;
    font-weight:600;
}

.nav a:hover,
.nav a.active{
    background:var(--primary-light);
    color:var(--primary);
}

.main{
    width:100%;
    max-width:1450px;
    margin:auto;
    padding:25px;
}

.hero{
    background:
        linear-gradient(
            135deg,
            #172033,
            #2563eb
        );
    color:#fff;
    border-radius:16px;
    padding:28px;
    margin-bottom:20px;
}

.hero h1{
    font-size:30px;
    margin-bottom:8px;
}

.hero p{
    opacity:.82;
    max-width:700px;
    line-height:1.6;
}

.hero-actions{
    display:flex;
    gap:8px;
    margin-top:18px;
    flex-wrap:wrap;
}

.search-bar{
    background:#fff;
    border:1px solid var(--border);
    border-radius:13px;
    padding:12px;
    display:grid;
    grid-template-columns:1fr 170px 140px;
    gap:8px;
    margin-bottom:18px;
}

.search-bar input,
.search-bar select{
    width:100%;
    padding:12px;
    border:1px solid #d8deea;
    border-radius:8px;
    outline:none;
}

.search-bar input:focus,
.search-bar select:focus{
    border-color:var(--primary);
}

.categories{
    display:flex;
    gap:8px;
    overflow:auto;
    padding-bottom:5px;
    margin-bottom:20px;
}

.category{
    white-space:nowrap;
    border:1px solid var(--border);
    background:#fff;
    padding:9px 14px;
    border-radius:20px;
    font-weight:700;
}

.category.active,
.category:hover{
    background:var(--primary);
    color:#fff;
    border-color:var(--primary);
}

.market-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:14px;
}

.market-header h2{
    font-size:20px;
}

.muted{
    color:var(--muted);
    font-size:13px;
}

.product-grid{
    display:grid;
    grid-template-columns:
        repeat(4,minmax(0,1fr));
    gap:15px;
}

.product{
    background:#fff;
    border:1px solid var(--border);
    border-radius:13px;
    overflow:hidden;
    transition:.2s;
}

.product:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 30px rgba(0,0,0,.07);
}

.product-cover{
    height:150px;
    display:grid;
    place-items:center;
    font-size:48px;
    background:#eef2ff;
}

.product-body{
    padding:14px;
}

.product-category{
    font-size:10px;
    text-transform:uppercase;
    color:var(--primary);
    font-weight:900;
}

.product-title{
    font-size:16px;
    margin:6px 0;
}

.product-description{
    color:var(--muted);
    font-size:12px;
    line-height:1.5;
    min-height:36px;
}

.rating{
    margin-top:9px;
    font-size:12px;
}

.stars{
    color:#f59e0b;
}

.product-bottom{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-top:12px;
}

.price{
    font-weight:900;
}

.free{
    color:var(--success);
}

.product-actions{
    display:flex;
    gap:6px;
}

.icon-btn{
    width:34px;
    height:34px;
    border:1px solid var(--border);
    background:#fff;
    border-radius:8px;
}

.icon-btn:hover{
    background:var(--primary-light);
}

.developer-section{
    margin-top:28px;
}

.stats{
    display:grid;
    grid-template-columns:
        repeat(4,1fr);
    gap:12px;
    margin-bottom:20px;
}

.stat{
    background:#fff;
    border:1px solid var(--border);
    border-radius:12px;
    padding:16px;
}

.stat strong{
    display:block;
    font-size:23px;
    margin-top:5px;
}

.empty{
    background:#fff;
    border:1px dashed #cbd5e1;
    padding:35px;
    text-align:center;
    border-radius:12px;
    color:var(--muted);
}

.modal{
    position:fixed;
    inset:0;
    background:rgba(15,23,42,.55);
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
    z-index:100;
}

.modal.show{
    display:flex;
}

.modal-box{
    background:#fff;
    width:100%;
    max-width:700px;
    max-height:90vh;
    overflow:auto;
    border-radius:15px;
    padding:20px;
}

.modal-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:15px;
}

.close{
    border:0;
    background:#edf0f5;
    width:35px;
    height:35px;
    border-radius:8px;
}

.modal-cover{
    height:190px;
    border-radius:12px;
    display:grid;
    place-items:center;
    font-size:65px;
    background:#eef2ff;
    margin-bottom:15px;
}

.form-group{
    margin-bottom:14px;
}

label{
    display:block;
    font-size:12px;
    font-weight:900;
    margin-bottom:6px;
}

input,
textarea,
.form-select{
    width:100%;
    border:1px solid #d8deea;
    border-radius:8px;
    padding:11px;
    outline:none;
}

textarea{
    min-height:110px;
    resize:vertical;
}

.form-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}

.modal-actions{
    display:flex;
    gap:8px;
    margin-top:15px;
}

.cart-count{
    min-width:19px;
    height:19px;
    border-radius:50%;
    background:#dc2626;
    color:#fff;
    display:grid;
    place-items:center;
    font-size:10px;
}

.toast{
    position:fixed;
    right:20px;
    bottom:20px;
    background:var(--dark);
    color:#fff;
    padding:12px 16px;
    border-radius:9px;
    display:none;
    z-index:200;
}

.toast.show{
    display:block;
}

@media(max-width:1150px){

    .product-grid{
        grid-template-columns:
            repeat(3,1fr);
    }

}

@media(max-width:900px){

    .layout{
        display:block;
    }

    .sidebar{
        display:none;
    }

    .product-grid{
        grid-template-columns:
            repeat(2,1fr);
    }

    .stats{
        grid-template-columns:
            repeat(2,1fr);
    }

}

@media(max-width:650px){

    .main{
        padding:15px;
    }

    .topbar{
        padding:0 12px;
    }

    .top-actions .desktop{
        display:none;
    }

    .search-bar{
        grid-template-columns:1fr;
    }

    .product-grid{
        grid-template-columns:1fr;
    }

    .stats{
        grid-template-columns:1fr;
    }

    .form-row{
        grid-template-columns:1fr;
    }

}

</style>
</head>


