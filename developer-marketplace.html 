function publishProduct(){

    const name =
        get("uploadName")
        ?.value
        .trim() ||
        "";

    const category =
        get("uploadCategory")
        ?.value ||
        "Plugins";

    const price =
        Number(
            get("uploadPrice")
            ?.value ||
            0
        );

    const description =
        get("uploadDescription")
        ?.value
        .trim() ||
        "";

    const developer =
        get("uploadDeveloper")
        ?.value
        .trim() ||
        "";


    if(!name){

        showToast(
            "Enter product name."
        );

        return;

    }


    if(!description){

        showToast(
            "Enter product description."
        );

        return;

    }


    const icons = {

        Plugins:"🧩",

        Themes:"🎨",

        Templates:"📦",

        Components:"🧱",

        APIs:"🔌",

        "UI Kits":"✨",

        "Developer Tools":"🛠"

    };


    const product = {

        id:
            "user-" +
            Date.now()
            .toString(),

        name,

        category,

        price:
            Math.max(
                0,
                price
            ),

        description,

        developer:
            developer ||
            "My Developer Profile",

        rating:5,

        downloads:0,

        icon:
            icons[category] ||
            "🧩",

        featured:false,

        createdAt:
            Date.now()

    };


    products.unshift(
        product
    );


    saveData();

    renderProducts();

    renderMyProducts();

    closeModal(
        "uploadModal"
    );


    [
        "uploadName",
        "uploadPrice",
        "uploadDescription",
        "uploadDeveloper"
    ]
    .forEach(
        id => {

            const field =
                get(id);

            if(field){
                field.value = "";
            }

        }
    );


    showToast(
        "Product published successfully."
    );

}


/* =========================
   MY PRODUCTS
========================= */

function renderMyProducts(){

    const container =
        get("myProducts");


    if(!container){
        return;
    }


    const mine =
        products.filter(
            product =>
                String(
                    product.id
                ).startsWith(
