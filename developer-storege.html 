<script>

/* =========================
   STORAGE SYSTEM
========================= */

const FILES_KEY =
    "letsstudy_developer_files";

const FOLDERS_KEY =
    "letsstudy_developer_folders";

const STORAGE_LIMIT =
    50 * 1024 * 1024;


let files = [];

let folders = ["/"];

let renameId = null;


/* =========================
   HELPERS
========================= */

function get(id){
    return document.getElementById(id);
}


function escapeHTML(value){

    return String(value ?? "")
        .replace(
            /[&<>"']/g,
            char => ({
                "&":"&amp;",
                "<":"&lt;",
                ">":"&gt;",
                '"':"&quot;",
                "'":"&#039;"
            }[char])
        );

}


function formatBytes(bytes){

    if(!bytes){
        return "0 B";
    }

    const units =
        ["B","KB","MB","GB"];

    const index =
        Math.floor(
            Math.log(bytes) /
            Math.log(1024)
        );

    return (
        bytes /
        Math.pow(1024,index)
    ).toFixed(
        index ? 2 : 0
    ) +
    " " +
    units[index];

}


function showToast(message){

    const toast =
        get("toast");

    toast.textContent =
        message;

    toast.classList.add(
        "show"
    );

    clearTimeout(
        window.toastTimer
    );

    window.toastTimer =
        setTimeout(
            () =>
                toast.classList.remove(
                    "show"
                ),
            2200
        );

}


/* =========================
   FILE TYPE
========================= */

function getType(file){

    const name =
        file.name ||
        "";

    const ext =
        name
        .split(".")
        .pop()
        .toLowerCase();


    if([
        "jpg",
        "jpeg",
        "png",
        "gif",
        "webp",
        "svg"
    ].includes(ext)){

        return "image";

    }


    if([
        "html",
        "css",
        "js",
        "json",
        "php",
        "py",
        "java",
        "ts"
    ].includes(ext)){

        return "code";

    }


    if([
        "pdf",
        "doc",
        "docx",
        "txt",
        "csv",
        "xls",
        "xlsx"
    ].includes(ext)){

        return "document";

    }


    return "other";

}


function fileIcon(type){

    return {

        image:"🖼️",

        code:"💻",

        document:"📄",

        other:"📦"

    }[type] || "📦";

}


/* =========================
   SAVE / LOAD
========================= */

function save(){

    localStorage.setItem(
        FILES_KEY,
        JSON.stringify(files)
    );

    localStorage.setItem(
        FOLDERS_KEY,
        JSON.stringify(folders)
    );

}


function load(){

    try{

        const savedFiles =
            localStorage.getItem(
                FILES_KEY
            );

        const savedFolders =
            localStorage.getItem(
                FOLDERS_KEY
            );


        files =
            savedFiles
            ? JSON.parse(savedFiles)
            : [];


        folders =
            savedFolders
            ? JSON.parse(savedFolders)
            : ["/"];


    }catch(error){

        files = [];

        folders = ["/"];

    }

}


/* =========================
   RENDER
========================= */

function render(){

    const grid =
        get("fileGrid");


    const search =
        get("search")
        .value
        .toLowerCase()
        .trim();


    const filter =
        get("filter")
        .value;


    const sort =
        get("sort")
        .value;


    let list =
        files.filter(file => {

            const matchesSearch =
                !search ||
                file.name
                    .toLowerCase()
                    .includes(search);


            const matchesFilter =
                filter === "all" ||
                file.type === filter;


            return (
                matchesSearch &&
                matchesFilter
            );

        });


    if(sort === "newest"){

        list.sort(
            (a,b) =>
                b.created -
                a.created
        );

    }


    if(sort === "oldest"){

        list.sort(
            (a,b) =>
                a.created -
                b.created
        );

    }


    if(sort === "name"){

        list.sort(
            (a,b) =>
                a.name.localeCompare(
                    b.name
                )
        );

    }


    if(sort === "size"){

        list.sort(
            (a,b) =>
                b.size -
                a.size
        );

    }


    updateStats();


    if(!list.length){

        grid.innerHTML = `

        <div class="empty">

            <div style="font-size:38px">
                📂
            </div>

            <strong>
                No files found
            </strong>

            <p style="margin-top:7px">
                Upload your first developer file.
            </p>

        </div>

        `;

        return;

    }


    grid.innerHTML =
        list.map(
            fileCard
        ).join("");

}


/* =========================
   FILE CARD
========================= */

function fileCard(file){

    return `

    <article class="file">

        <div class="file-icon">

            ${fileIcon(file.type)}

        </div>


        <div class="file-name">

            ${escapeHTML(file.name)}

        </div>


        <div class="file-meta">

            ${formatBytes(file.size)}
            ·
            ${escapeHTML(file.folder)}

        </div>


        <div class="file-meta">

            ${new Date(
                file.created
            ).toLocaleString()}

        </div>


        <div class="file-actions">

            <button
                onclick="previewFile('${file.id}')"
            >
                👁
            </button>

            <button
                onclick="rename('${file.id}')"
            >
                ✏
            </button>

            <button
                onclick="downloadFile('${file.id}')"
            >
                ⬇
            </button>

            <button
                onclick="deleteFile('${file.id}')"
                style="
                    color:#dc2626
                "
            >
                🗑
            </button>

        </div>

    </article>

    `;

}


/* =========================
   STATS
========================= */

function updateStats(){

    const total =
        files.reduce(
            (sum,file) =>
                sum +
                Number(file.size || 0),
            0
        );


    get("fileCount")
        .textContent =
        files.length;


    get("storageUsed")
        .textContent =
        formatBytes(total);


    get("folderCount")
        .textContent =
        Math.max(
            0,
            folders.length - 1
        );


    get("storageFill")
        .style.width =
        Math.min(
            100,
            total /
            STORAGE_LIMIT *
            100
        ) + "%";

}


/* =========================
   UPLOAD
========================= */

function openUpload(){

    updateFolderSelect();

    get("uploadModal")
        .classList.add(
            "show"
        );

}


function uploadFiles(){

    const input =
        get("fileInput");


    if(!input.files.length){

        showToast(
            "Choose files first."
        );

        return;

    }


    const folder =
        get("uploadFolder")
        .value;


    let used =
        files.reduce(
            (sum,file) =>
                sum + file.size,
            0
        );


    Array.from(
        input.files
    ).forEach(file => {

        if(
            used + file.size >
            STORAGE_LIMIT
        ){

            showToast(
                "Storage limit reached."
            );

            return;

        }


        const reader =
            new FileReader();


        reader.onload = function(event){

            files.unshift({

                id:
                    "file-" +
                    Date.now() +
                    "-" +
                    Math.random()
                    .toString(36)
                    .slice(2),

                name:
                    file.name,

                size:
                    file.size,

                type:
                    getType(file),

                folder:
                    folder,

                mime:
                    file.type,

                data:
                    event.target.result,

                created:
                    Date.now()

            });


            save();

            render();

        };


        reader.readAsDataURL(file);

        used += file.size;

    });


    closeModal(
        "uploadModal"
    );

    input.value = "";

    showToast(
        "Upload completed."
    );

}


/* =========================
   DOWNLOAD
========================= */

function downloadFile(id){

    const file =
        files.find(
            item =>
                item.id === id
        );


    if(!file){
        return;
    }


    const link =
        document.createElement(
            "a"
        );

    link.href =
        file.data;

    link.download =
        file.name;

    document.body.appendChild(
        link
    );

    link.click();

    link.remove();

}


/* =========================
   PREVIEW
========================= */

function previewFile(id){

    const file =
        files.find(
            item =>
                item.id === id
        );


    if(!file){
        return;
    }


    get("previewTitle")
        .textContent =
        file.name;


    const content =
        get("previewContent");


    if(file.type === "image"){

        content.innerHTML = `

            <img
                class="preview"
                src="${file.data}"
                alt="${escapeHTML(
                    file.name
                )}"
            >

        `;

    }else if(
        file.type === "code" ||
        file.type === "document"
    ){

        content.innerHTML = `

            <p class="muted">
                ${escapeHTML(
    file.mime ||
    "File"
)}
</p>

<p style="
    margin-top:12px;
    line-height:1.6
">

    Size:
    <strong>
        ${formatBytes(file.size)}
    </strong>

    <br>

    Folder:
    <strong>
        ${escapeHTML(
            file.folder || "/"
        )}
    </strong>

    <br>

    Uploaded:
    <strong>
        ${new Date(
            file.created
        ).toLocaleString()}
    </strong>

</p>

<div style="
    display:flex;
    gap:8px;
    margin-top:18px
">

    <button
        class="btn primary"
        onclick="downloadFile('${escapeHTML(
            file.id
        )}')"
    >
        ⬇ Download
    </button>

    <button
        class="btn secondary"
        onclick="closeModal('previewModal')"
    >
        Close
    </button>

</div>

`;

    }


    get("previewModal")
        .classList.add(
            "show"
        );

}


/* =========================
   RENAME FILE
========================= */

function rename(id){

    const file =
        files.find(
            item =>
                item.id === id
        );


    if(!file){
        return;
    }


    renameId =
        id;


    get("renameInput")
        .value =
        file.name;


    get("renameModal")
        .classList.add(
            "show"
        );

}


function renameFile(){

    const input =
        get("renameInput");

    const newName =
        input
        ?.value
        .trim();


    if(!newName){

        showToast(
            "Enter a file name."
        );

        return;

    }


    const file =
        files.find(
            item =>
                item.id === renameId
        );


    if(!file){

        showToast(
            "File not found."
        );

        return;

    }


    file.name =
        newName;


    file.updated =
        Date.now();


    save();

    render();

    closeModal(
        "renameModal"
    );


    showToast(
        "File renamed successfully."
    );

}


/* =========================
   DELETE FILE
========================= */

function deleteFile(id){

    const file =
        files.find(
            item =>
                item.id === id
        );


    if(!file){
        return;
    }


    const confirmed =
        confirm(
            `Delete "${file.name}"?`
        );


    if(!confirmed){
        return;
    }


    files =
        files.filter(
            item =>
                item.id !== id
        );


    save();

    render();


    showToast(
        "File deleted."
    );

}


/* =========================
   CREATE FOLDER
========================= */

function createFolder(){

    const name =
        prompt(
            "Enter folder name:"
        );


    if(name === null){
        return;
    }


    const cleanName =
        name.trim()
            .replace(
                /[\/\\]/g,
                "-"
            );


    if(!cleanName){

        showToast(
            "Folder name is required."
        );

        return;

    }


    const folder =
        "/" + cleanName;


    if(
        folders.includes(folder)
    ){

        showToast(
            "Folder already exists."
        );

        return;

    }


    folders.push(
        folder
    );


    save();

    updateFolderSelect();

    render();


    showToast(
        "Folder created."
    );

}


/* =========================
   UPDATE FOLDER SELECT
========================= */

function updateFolderSelect(){

    const select =
        get("uploadFolder");


    if(!select){
        return;
    }


    select.innerHTML =
        folders
        .map(
            folder => `

                <option
                    value="${escapeHTML(
                        folder
                    )}"
                >

                    ${escapeHTML(
                        folder
                    )}

                </option>

            `
        )
        .join("");

}


/* =========================
   DRAG & DROP
========================= */

const dropzone =
    get("dropzone");


if(dropzone){

    dropzone.addEventListener(
        "dragover",
        event => {

            event.preventDefault();

            dropzone.classList.add(
                "drag"
            );

        }
    );


    dropzone.addEventListener(
        "dragleave",
        () => {

            dropzone.classList.remove(
                "drag"
            );

        }
    );


    dropzone.addEventListener(
        "drop",
        event => {

            event.preventDefault();

            dropzone.classList.remove(
                "drag"
            );


            const droppedFiles =
                event
                .dataTransfer
                .files;


            if(
                !droppedFiles ||
                !droppedFiles.length
            ){

                return;

            }


            const input =
                get("fileInput");


            /*
             * FileList is read-only in many
             * browsers, therefore use DataTransfer.
             */

            try{

                const transfer =
                    new DataTransfer();


                Array.from(
                    droppedFiles
                ).forEach(
                    file =>
                        transfer.items
                            .add(file)
                );


                input.files =
                    transfer.files;


                openUpload();

            }catch(error){

                console.error(
                    error
                );

                openUpload();

            }

        }
    );

}


/* =========================
   MODAL HANDLING
========================= */

function closeModal(id){

    const modal =
        get(id);


    if(modal){

        modal.classList.remove(
            "show"
        );

    }

}


document
.querySelectorAll(".modal")
.forEach(
    modal => {

        modal.addEventListener(
            "click",
            event => {

                if(
                    event.target ===
                    modal
                ){

                    modal.classList.remove(
                        "show"
                    );

                }

            }
        );

    }
);


/* =========================
   ESC KEY
========================= */

document.addEventListener(
    "keydown",
    event => {

        if(
            event.key ===
            "Escape"
        ){

            document
            .querySelectorAll(
                ".modal.show"
            )
            .forEach(
                modal =>
                    modal.classList.remove(
                        "show"
                    )
            );

        }

    }
);


/* =========================
   SEARCH
========================= */

const search =
    get("search");


if(search){

    search.addEventListener(
        "input",
        render
    );

}


/* =========================
   FILTER
========================= */

const filter =
    get("filter");


if(filter){

    filter.addEventListener(
        "change",
        render
    );

}


/* =========================
   SORT
========================= */

const sort =
    get("sort");


if(sort){

    sort.addEventListener(
        "change",
        render
    );

}


/* =========================
   INITIALIZATION
========================= */

document.addEventListener(
    "DOMContentLoaded",
    () => {

        load();

        updateFolderSelect();

        render();

    }
);


/* =========================
   GLOBAL API
========================= */

window.openUpload =
    openUpload;

window.uploadFiles =
