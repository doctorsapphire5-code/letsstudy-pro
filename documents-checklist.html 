<!-- =====================================
     HERO
===================================== -->

<section class="hero">

  <div class="container hero-content">

    <span class="badge">

      <i class="fa-solid fa-folder-open"></i>

      Application Preparation

    </span>


    <h1>
      Documents Checklist
    </h1>


    <p>
      Keep track of the important documents
      you may need for your university,
      scholarship, admission and visa
      applications.
    </p>

  </div>

</section>


<!-- =====================================
     MAIN
===================================== -->

<main>

  <div class="container dashboard">


    <!-- =================================
         CHECKLIST
    ================================== -->

    <section class="checklist-card">

      <div class="card-header">

        <h2>
          Your Document Checklist
        </h2>

        <p>
          Tick each document when it is ready.
          Your progress is saved automatically.
        </p>

      </div>


      <!-- TOOLBAR -->

      <div class="toolbar">

        <div class="search-box">

          <i class="fa-solid fa-search"></i>

          <input
            type="search"
            id="documentSearch"
            placeholder="Search documents..."
          >

        </div>


        <select
          class="filter"
          id="statusFilter"
        >

          <option value="all">
            All Documents
          </option>

          <option value="pending">
            Not Ready
          </option>

          <option value="completed">
            Completed
          </option>

        </select>

      </div>


      <!-- =================================
           IDENTITY
      ================================== -->

      <div class="category">

        <div class="category-title">

          <i class="fa-solid fa-id-card"></i>

          Identity Documents

        </div>


        <label
          class="document-item"
          data-document="passport"
          data-name="passport valid passport"
        >

          <span class="checkbox">

            <input
              type="checkbox"
              class="document-check"
              data-id="passport"
            >

            <span class="checkmark">

              <i class="fa-solid fa-check"></i>

            </span>

          </span>


          <span class="document-info">

            <h3>
              Valid Passport

              <span class="required">
                REQUIRED
              </span>

            </h3>

            <p>
              Valid passport and clear copies
              of relevant pages.
            </p>

          </span>

        </label>


        <label
          class="document-item"
          data-document="photo"
          data-name="passport photos photographs"
        >

          <span class="checkbox">

            <input
              type="checkbox"
              class="document-check"
              data-id="photo"
            >

            <span class="checkmark">

              <i class="fa-solid fa-check"></i>

            </span>

          </span>


          <span class="document-info">

            <h3>
              Passport Photos

              <span class="required">
                REQUIRED
              </span>

            </h3>

            <p>
              Recent photographs that meet the
              official specifications.
            </p>

          </span>

        </label>

      </div>


      <!-- =================================
           ACADEMIC
      ================================== -->

      <div class="category">

        <div class="category-title">

          <i class="fa-solid fa-graduation-cap"></i>

          Academic Documents

        </div>


        <label
          class="document-item"
          data-document="admission"
          data-name="admission letter offer"
        >

          <span class="checkbox">

            <input
              type="checkbox"
              class="document-check"
              data-id="admission"
            >

            <span class="checkmark">

              <i class="fa-solid fa-check"></i>

            </span>

          </span>


          <span class="document-info">

            <h3>
              Admission / Offer Letter

              <span class="required">
                REQUIRED
              </span>

            </h3>

            <p>
              Official confirmation from your
              university or institution.
            </p>

          </span>

        </label>


        <label
          class="document-item"
          data-document="transcripts"
          data-name="academic transcripts grades"
        >

          <span class="checkbox">

            <input
              type="checkbox"
              class="document-check"
              data-id="transcripts"
            >

            <span class="checkmark">

              <i class="fa-solid fa-check"></i>

            </span>

          </span>


          <span class="document-info">

            <h3>
              Academic Transcripts

              <span class="required">
                REQUIRED
              </span>

            </h3>

            <p>
              Official academic records and
              transcripts where required.
            </p>

          </span>

        </label>


                <label
          class="document-item"
          data-document="admission"
          data-name="admission letter offer letter university acceptance"
        >

          <span class="checkbox">

            <input
              type="checkbox"
              class="document-check"
              data-id="admission"
            >

            <span class="checkmark">

              <i class="fa-solid fa-check"></i>

            </span>

          </span>


          <span class="document-info">

            <h3>
              Admission / Offer Letter

              <span class="required">
                REQUIRED
              </span>

            </h3>

            <p>
              Official admission or offer letter
              issued by your university or college.
            </p>

          </span>

        </label>


        <label
          class="document-item"
          data-document="transcripts"
          data-name="academic transcripts grades results"
        >

          <span class="checkbox">

            <input
              type="checkbox"
              class="document-check"
              data-id="transcripts"
            >

            <span class="checkmark">

              <i class="fa-solid fa-check"></i>

            </span>

          </span>


          <span class="document-info">

            <h3>
              Academic Transcripts

              <span class="required">
                REQUIRED
              </span>

            </h3>

            <p>
              Official transcripts showing your
              previous academic performance.
            </p>

          </span>

        </label>


        <label
          class="document-item"
          data-document="certificates"
          data-name="academic certificates diploma degree qualification"
        >

          <span class="checkbox">

            <input
              type="checkbox"
              class="document-check"
              data-id="certificates"
            >

            <span class="checkmark">

              <i class="fa-solid fa-check"></i>

            </span>

          </span>


          <span class="document-info">

            <h3>
              Academic Certificates

              <span class="optional">
                OPTIONAL
              </span>

            </h3>

            <p>
              Certificates, diplomas or degrees
              requested by the institution.
            </p>

          </span>

        </label>


        <label
          class="document-item"
          data-document="recommendation"
          data-name="recommendation letter reference academic"
        >

          <span class="checkbox">

            <input
              type="checkbox"
              class="document-check"
              data-id="recommendation"
            >

            <span class="checkmark">

              <i class="fa-solid fa-check"></i>

            </span>

          </span>


          <span class="document-info">

            <h3>
              Recommendation Letter

              <span class="optional">
                OPTIONAL
              </span>

            </h3>

            <p>
              Academic or professional reference
              letter where required.
            </p>

          </span>

        </label>


        <label
          class="document-item"
          data-document="personal-statement"
          data-name="personal statement motivation letter essay"
        >

          <span class="checkbox">

            <input
              type="checkbox"
              class="document-check"
              data-id="personal-statement"
            >

            <span class="checkmark">

              <i class="fa-solid fa-check"></i>

            </span>

          </span>


          <span class="document-info">

            <h3>
              Personal Statement

              <span class="optional">
                OPTIONAL
              </span>

            </h3>

            <p>
              Personal statement, motivation letter
              or study essay when requested.
            </p>

          </span>

        </label>


      </div>


      <!-- =================================
           LANGUAGE REQUIREMENTS
      ================================== -->

      <div class="category">

        <div class="category-title">

          <i class="fa-solid fa-language"></i>

          Language Requirements

        </div>


        <label
          class="document-item"
          data-document="english-test"
          data-name="english test IELTS TOEFL language proficiency"
        >

          <span class="checkbox">

            <input
              type="checkbox"
              class="document-check"
