<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="LetsStudy Pro Documents Checklist - Organize and track documents required for your study abroad application."
  >

  <title>Documents Checklist | LetsStudy Pro</title>

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
  >

  <style>

    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
    }

    :root{
      --primary:#2563eb;
      --primary-dark:#1d4ed8;
      --dark:#0f172a;
      --text:#1e293b;
      --muted:#64748b;
      --bg:#f8fafc;
      --white:#ffffff;
      --border:#e2e8f0;
      --success:#16a34a;
      --warning:#d97706;
      --danger:#dc2626;
      --radius:16px;
      --shadow:0 10px 30px rgba(15,23,42,.07);
    }

    html{
      scroll-behavior:smooth;
    }

    body{
      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      background:var(--bg);
      color:var(--text);
      line-height:1.6;
    }

    a{
      text-decoration:none;
      color:inherit;
    }

    button,
    input,
    select{
      font:inherit;
    }

    .container{
      width:min(1120px,92%);
      margin:auto;
    }

    /* =====================================
       HEADER
    ===================================== */

    header{
      position:sticky;
      top:0;
      z-index:1000;
      background:rgba(255,255,255,.96);
      backdrop-filter:blur(12px);
      border-bottom:1px solid var(--border);
    }

    .navbar{
      min-height:72px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:25px;
    }

    .logo{
      display:flex;
      align-items:center;
      gap:9px;
      color:var(--dark);
      font-size:20px;
      font-weight:800;
    }

    .logo i{
      color:var(--primary);
      font-size:24px;
    }

    .nav-links{
      display:flex;
      align-items:center;
      gap:23px;
    }

    .nav-links a{
      color:#475569;
      font-size:14px;
      font-weight:600;
    }

    .nav-links a:hover,
    .nav-links a.active{
      color:var(--primary);
    }

    .menu-btn{
      display:none;
      border:0;
      background:none;
      cursor:pointer;
      font-size:22px;
    }

    /* =====================================
       HERO
    ===================================== */

    .hero{
      padding:65px 0;
      background:
        linear-gradient(
          135deg,
          #eff6ff,
          #ffffff 60%,
          #f8fafc
        );
      border-bottom:1px solid var(--border);
    }

    .hero-content{
      max-width:850px;
      margin:auto;
      text-align:center;
    }

    .badge{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:7px 14px;
      margin-bottom:16px;
      border-radius:999px;
      background:#dbeafe;
      color:#1d4ed8;
      font-size:13px;
      font-weight:700;
    }

    .hero h1{
      color:var(--dark);
      font-size:clamp(34px,5vw,52px);
      line-height:1.1;
      margin-bottom:15px;
      letter-spacing:-1px;
    }

    .hero p{
      max-width:700px;
      margin:auto;
      color:var(--muted);
      font-size:16px;
    }

    /* =====================================
       MAIN
    ===================================== */

    main{
      padding:50px 0 70px;
    }

    .dashboard{
      display:grid;
      grid-template-columns:1fr 330px;
      gap:24px;
      align-items:start;
    }

    /* =====================================
       CHECKLIST CARD
    ===================================== */

    .checklist-card{
      background:var(--white);
      border:1px solid var(--border);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      overflow:hidden;
    }

    .card-header{
      padding:24px;
      border-bottom:1px solid var(--border);
    }

    .card-header h2{
      color:var(--dark);
      font-size:23px;
      margin-bottom:5px;
    }

    .card-header p{
      color:var(--muted);
      font-size:14px;
    }

    /* =====================================
       SEARCH
    ===================================== */

    .toolbar{
      display:flex;
      gap:12px;
      padding:18px 24px;
      border-bottom:1px solid var(--border);
      background:#fafcff;
    }

    .search-box{
      position:relative;
      flex:1;
    }

    .search-box i{
      position:absolute;
      left:15px;
      top:50%;
      transform:translateY(-50%);
      color:#94a3b8;
    }

    .search-box input{
      width:100%;
      height:46px;
      padding:0 15px 0 43px;
      border:1px solid var(--border);
      border-radius:10px;
      outline:none;
      background:#fff;
    }

    .search-box input:focus{
      border-color:var(--primary);
      box-shadow:0 0 0 3px rgba(37,99,235,.1);
    }

    .filter{
      height:46px;
      min-width:140px;
      padding:0 12px;
      border:1px solid var(--border);
      border-radius:10px;
      background:#fff;
      color:var(--text);
      outline:none;
    }

    /* =====================================
       CHECKLIST ITEMS
    ===================================== */

    .category{
      border-bottom:1px solid var(--border);
    }

    .category:last-child{
      border-bottom:0;
    }

    .category-title{
      display:flex;
      align-items:center;
      gap:10px;
      padding:19px 24px 12px;
      color:var(--dark);
      font-size:16px;
      font-weight:800;
    }

    .category-title i{
      color:var(--primary);
    }

    .document-item{
      display:flex;
      align-items:flex-start;
      gap:14px;
      padding:15px 24px;
      transition:.2s ease;
    }

    .document-item:hover{
      background:#f8fafc;
    }

    .document-item.completed{
      background:#f0fdf4;
    }

    .checkbox{
      position:relative;
      flex-shrink:0;
      margin-top:2px;
    }

    .checkbox input{
      position:absolute;
      opacity:0;
      pointer-events:none;
    }

    .checkmark{
      width:22px;
      height:22px;
      display:flex;
      align-items:center;
      justify-content:center;
      border:2px solid #cbd5e1;
      border-radius:6px;
      color:#fff;
      cursor:pointer;
      transition:.2s ease;
    }

    .checkbox input:checked + .checkmark{
      background:var(--success);
      border-color:var(--success);
    }

    .checkmark i{
      font-size:12px;
      opacity:0;
    }

    .checkbox input:checked + .checkmark i{
      opacity:1;
    }

    .document-info{
      flex:1;
    }

    .document-info h3{
      color:var(--dark);
      font-size:15px;
      margin-bottom:3px;
    }

    .document-item.completed h3{
      text-decoration:line-through;
      color:#64748b;
    }

    .document-info p{
      color:var(--muted);
      font-size:13px;
    }

    .required{
      display:inline-flex;
      align-items:center;
      padding:3px 8px;
      margin-left:7px;
      border-radius:999px;
      background:#fee2e2;
      color:#b91c1c;
      font-size:10px;
      font-weight:800;
      vertical-align:middle;
    }

    .optional{
      display:inline-flex;
      align-items:center;
      padding:3px 8px;
      margin-left:7px;
      border-radius:999px;
      background:#f1f5f9;
      color:#64748b;
      font-size:10px;
      font-weight:800;
      vertical-align:middle;
    }

    .empty-state{
      display:none;
      padding:50px 25px;
      text-align:center;
    }

    .empty-state i{
      font-size:35px;
      color:#94a3b8;
      margin-bottom:12px;
    }

    .empty-state h3{
      color:var(--dark);
      margin-bottom:5px;
    }

    .empty-state p{
      color:var(--muted);
      font-size:14px;
    }

    /* =====================================
       SIDEBAR
    ===================================== */

    .sidebar{
      display:grid;
      gap:18px;
    }

    .side-card{
      background:#fff;
      border:1px solid var(--border);
      border-radius:var(--radius);
      padding:22px;
      box-shadow:var(--shadow);
    }

    .side-card h3{
      color:var(--dark);
      margin-bottom:15px;
      font-size:17px;
    }

    /* =====================================
       PROGRESS
    ===================================== */

    .progress-number{
      display:flex;
      align-items:end;
      justify-content:space-between;
      margin-bottom:9px;
    }

    .progress-number strong{
      color:var(--dark);
      font-size:28px;
    }

    .progress-number span{
      color:var(--muted);
      font-size:13px;
    }

    .progress-track{
      width:100%;
      height:10px;
      overflow:hidden;
      border-radius:999px;
      background:#e2e8f0;
    }

    .progress-fill{
      width:0%;
      height:100%;
      border-radius:999px;
      background:var(--primary);
      transition:.3s ease;
    }

    .progress-message{
      margin-top:12px;
      color:var(--muted);
      font-size:13px;
    }

    /* =====================================
       ACTIONS
    ===================================== */

    .action-list{
      display:grid;
      gap:10px;
    }

    .action-btn{
      width:100%;
      min-height:44px;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:9px;
      border:1px solid var(--border);
      border-radius:10px;
      background:#fff;
      color:var(--text);
      cursor:pointer;
      font-size:13px;
      font-weight:700;
      transition:.2s ease;
    }

    .action-btn:hover{
      border-color:#bfdbfe;
      background:#eff6ff;
      color:var(--primary);
    }

    .action-btn.primary{
      border-color:var(--primary);
      background:var(--primary);
      color:#fff;
    }

    .action-btn.primary:hover{
      background:var(--primary-dark);
      color:#fff;
    }

    .action-btn.danger:hover{
      border-color:#fecaca;
      background:#fef2f2;
      color:var(--danger);
    }

    /* =====================================
       INFO CARD
    ===================================== */

    .info-box{
      display:flex;
      gap:12px;
      padding:15px;
      border-radius:12px;
      background:#eff6ff;
      border:1px solid #bfdbfe;
    }

    .info-box i{
      color:var(--primary);
      margin-top:3px;
    }

    .info-box p{
      color:#475569;
      font-size:13px;
    }

    /* =====================================
       FOOTER
    ===================================== */

    footer{
      padding:38px 0 20px;
      background:#0f172a;
      color:#cbd5e1;
    }

    .footer-top{
      display:flex;
      justify-content:space-between;
      gap:30px;
      padding-bottom:25px;
      border-bottom:1px solid rgba(255,255,255,.1);
    }

    .footer-brand{
      max-width:420px;
    }

    .footer-brand h3{
      color:#fff;
      margin-bottom:8px;
    }

    .footer-brand p{
      font-size:13px;
    }

    .footer-links{
      display:flex;
      flex-wrap:wrap;
      gap:17px;
      align-items:center;
    }

    .footer-links a{
      font-size:13px;
    }

    .footer-links a:hover{
      color:#fff;
    }

    .footer-bottom{
      display:flex;
      justify-content:space-between;
      gap:20px;
      padding-top:18px;
      font-size:12px;
    }

    /* =====================================
       TOAST
    ===================================== */

    .toast{
      position:fixed;
      left:50%;
      bottom:25px;
      transform:
        translate(-50%,20px);
      z-index:2000;
      min-width:260px;
      max-width:90%;
      padding:13px 17px;
      display:flex;
      align-items:center;
      gap:10px;
      border-radius:11px;
      background:#0f172a;
      color:#fff;
      box-shadow:0 15px 35px rgba(0,0,0,.2);
      opacity:0;
      visibility:hidden;
      transition:.25s ease;
      font-size:13px;
    }

    .toast.show{
      opacity:1;
      visibility:visible;
      transform:
        translate(-50%,0);
    }

    /* =====================================
       RESPONSIVE
    ===================================== */

    @media(max-width:850px){

      .dashboard{
        grid-template-columns:1fr;
      }

      .sidebar{
        grid-template-columns:
          repeat(2,1fr);
      }

    }

    @media(max-width:700px){

      .menu-btn{
        display:block;
      }

      .nav-links{
        position:absolute;
        top:72px;
        left:0;
        right:0;
        display:none;
        flex-direction:column;
        align-items:stretch;
        gap:0;
        background:#fff;
        border-bottom:1px solid var(--border);
      }

      .nav-links.open{
        display:flex;
      }

      .nav-links a{
        padding:14px 4%;
        border-bottom:1px solid #f1f5f9;
      }

      .toolbar{
        flex-direction:column;
      }

      .filter{
        width:100%;
      }

      .sidebar{
        grid-template-columns:1fr;
      }

      .footer-top,
      .footer-bottom{
        flex-direction:column;
      }

    }

    /* =====================================
       PRINT
    ===================================== */

    @media print{

      header,
      .hero,
      .toolbar,
      .sidebar,
      footer,
      .toast{
        display:none !important;
      }

      body{
        background:#fff;
      }

      main{
        padding:0;
      }

      .container{
        width:100%;
      }

      .checklist-card{
        border:0;
        box-shadow:none;
      }

      .document-item{
        break-inside:avoid;
      }

    }

  </style>

</head>


