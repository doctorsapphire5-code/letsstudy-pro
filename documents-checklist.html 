<!-- =====================================
     JAVASCRIPT
===================================== -->

<script>

  const visaSearch =
    document.getElementById(
      "visaSearch"
    );

  const visaGuides =
    document.querySelectorAll(
      ".guide-card"
    );

  const resultsCount =
    document.getElementById(
      "resultsCount"
    );

  const emptyState =
    document.getElementById(
      "emptyState"
    );

  const clearSearch =
    document.getElementById(
      "clearSearch"
    );


  function filterVisaGuides(){

    const query =
      visaSearch.value
        .trim()
        .toLowerCase();


    let visible =
      0;


    visaGuides.forEach(
      guide => {

        const text =
          guide.dataset.search
            .toLowerCase();


        const matches =
          !query ||
          text.includes(query);


        guide.style.display =
          matches
            ? ""
            : "none";


        if(matches){

          visible++;

        }

      }
    );


    resultsCount.textContent =
      visible;


    emptyState.style.display =
      visible === 0
        ? "block"
        : "none";

  }


  visaSearch.addEventListener(
    "input",
    filterVisaGuides
  );


  clearSearch.addEventListener(
    "click",
    function(){

      visaSearch.value = "";

      filterVisaGuides();

      visaSearch.focus();

    }
  );


  /* =====================================
     ESCAPE KEY
  ===================================== */

  document.addEventListener(
    "keydown",
    function(event){

      if(
        event.key === "Escape"
      ){

        visaSearch.value = "";

        filterVisaGuides();

      }

    }
  );


  /* =====================================
     YEAR
  ===================================== */

  document.getElementById(
    "year"
  ).textContent =
    new Date().getFullYear();


  filterVisaGuides();

</script>


