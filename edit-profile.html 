
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#102b55">
<title>Edit Profile | LetsStudy Pro</title>

<style>
*{box-sizing:border-box}
body{margin:0;background:#f3f6fb;color:#17243a;font-family:Arial,sans-serif}
header{background:#102b55;color:white;padding:20px}
header h2{margin:0;font-size:21px}
header p{margin:6px 0 0;color:#d8e5fa;font-size:13px}
.container{max-width:800px;width:93%;margin:28px auto}
.card{background:white;padding:24px;border-radius:15px;box-shadow:0 5px 25px #17243a0c}
h1{font-size:25px;margin:0 0 8px}
h2{font-size:18px;margin:0 0 10px}
.subtitle,.hint{color:#64748b;font-size:13px;line-height:1.6}
.avatar{width:85px;height:85px;border-radius:50%;background:#e6edfa;display:flex;align-items:center;justify-content:center;overflow:hidden;font-size:28px;font-weight:bold;color:#185adb;margin:18px 0}
.avatar img{width:100%;height:100%;object-fit:cover}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:0 16px}
label{display:block;font-size:13px;font-weight:bold;margin:17px 0 7px}
input,select,textarea{width:100%;padding:12px;border:1px solid #d5deeb;border-radius:8px;background:white;font-size:14px;outline:none}
input:focus,select:focus,textarea:focus{border-color:#185adb}
input:disabled{background:#f1f5f9;color:#64748b}
textarea{min-height:90px;resize:vertical}
button{border:0;padding:13px 18px;border-radius:8px;background:#185adb;color:white;font-weight:bold;cursor:pointer}
button:disabled{opacity:.6;cursor:not-allowed}
.secondary{background:#eaf0fa;color:#173b70}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
.message{display:none;margin-top:16px;padding:12px;border-radius:8px;font-size:14px}
.success{display:block;background:#e8f8ef;color:#176b3a}
.error{display:block;background:#fff0f0;color:#a32020}
.info{padding:12px;background:#eef4ff;color:#234b85;border-radius:8px;font-size:13px;line-height:1.5;margin-top:15px}
footer{text-align:center;padding:25px;color:#718096;font-size:12px}
a{color:#185adb;text-decoration:none}
@media(max-width:600px){.grid{grid-template-columns:1fr}.card{padding:19px}}
</style>
</head>

<body>

<header>
<h2>LetsStudy Pro</h2>
<p>Learn. Build. Work. Grow.</p>
</header>

<main class="container">
<section class="card">

<h1>Edit Profile</h1>
<p class="subtitle">Update your personal, educational and professional information.</p>

<div class="avatar" id="avatar">U</div>

<form id="editProfileForm">

<h2>Personal Information</h2>

<div class="grid">
<div>
<label for="firstName">First Name</label>
<input id="firstName" maxlength="80">
</div>

<div>
<label for="lastName">Last Name</label>
<input id="lastName" maxlength="80">
</div>

<div>
<label for="displayName">Display Name *</label>
<input id="displayName" maxlength="100" required>
</div>

<div>
<label for="username">Username</label>
<input id="username" maxlength="40">
</div>

<div>
<label for="email">Email Address</label>
<input id="email" type="email" disabled>
</div>

<div>
<label for="phoneNumber">Phone Number</label>
<input id="phoneNumber" type="tel" maxlength="30">
</div>

<div>
<label for="dateOfBirth">Date of Birth</label>
<input id="dateOfBirth" type="date">
</div>

<div>
<label for="gender">Gender</label>
<select id="gender">
<option value="">Select gender</option>
<option value="male">Male</option>
<option value="female">Female</option>
<option value="other">Other</option>
<option value="prefer_not_to_say">Prefer not to say</option>
</select>
</div>
</div>

<hr style="border:0;border-top:1px solid #e5eaf1;margin:25px 0">

<h2>Location Information</h2>

<div class="grid">
<div>
<label for="country">Country</label>
<input id="country" maxlength="100">
</div>

<div>
<label for="region">Region / State</label>
<input id="region" maxlength="100">
</div>

<div>
<label for="city">City</label>
<input id="city" maxlength="100">
</div>

<div>
<label for="address">Address</label>
<input id="address" maxlength="250">
</div>

<div>
<label for="postalCode">Postal Code</label>
<input id="postalCode" maxlength="20">
</div>

<div>
<label for="timezone">Timezone</label>
<input id="timezone" placeholder="Africa/Dar_es_Salaam" maxlength="80">
</div>
</div>

<hr style="border:0;border-top:1px solid #e5eaf1;margin:25px 0">

<h2>Education & Professional Information</h2>

<div class="grid">
<div>
<label for="accountType">Account Type</label>
<select id="accountType">
<option value="">Select account type</option>
<option value="individual">Individual</option>
<option value="student">Student</option>
<option value="professional">Professional</option>
<option value="teacher">Teacher</option>
<option value="creator">Creator</option>
<option value="business">Business</option>
<option value="organization">Organization</option>
<option value="entrepreneur">Entrepreneur</option>
<option value="freelancer">Freelancer</option>
</select>
</div>

<div>
<label for="educationLevel">Education Level</label>
<select id="educationLevel">
<option value="">Select education level</option>
<option value="primary">Primary</option>
<option value="secondary">Secondary</option>
<option value="certificate">Certificate</option>
<option value="diploma">Diploma</option>
<option value="bachelor">Bachelor's Degree</option>
<option value="master">Master's Degree</option>
<option value="phd">PhD</option>
<option value="other">Other</option>
</select>
</div>

<div>
<label for="occupation">Occupation</label>
<input id="occupation" maxlength="120">
</div>

<div>
<label for="organizationName">Organization / Company</label>
<input id="organizationName" maxlength="150">
</div>
</div>

<label for="bio">About Me</label>
<textarea id="bio" maxlength="1000" placeholder="Tell us about yourself..."></textarea>

<label for="interests">Interests</label>
<textarea id="interests" maxlength="500" placeholder="Your interests"></textarea>

<label for="skills">Skills</label>
<textarea id="skills" maxlength="500" placeholder="Your skills"></textarea>

<hr style="border:0;border-top:1px solid #e5eaf1;margin:25px 0">

<h2>Online Presence</h2>

<label for="website">Website</label>
<input id="website" type="url" placeholder="https://example.com">

<label for="photoURL">Profile Photo URL</label>
<input id="photoURL" type="url" placeholder="https://example.com/photo.jpg">

<p class="hint">Enter an image URL that you own or are authorized to use.</p>

<hr style="border:0;border-top:1px solid #e5eaf1;margin:25px 0">

<h2>Preferences</h2>

<div class="grid">
<div>
<label for="language">Preferred Language</label>
<select id="language">
<option value="English">English</option>
<option value="Swahili">Swahili</option>
</select>
</div>

<div>
<label for="notificationsEnabled">Notifications</label>
<select id="notificationsEnabled">
<option value="true">Enabled</option>
<option value="false">Disabled</option>
</select>
</div>
</div>

<div class="info">
Your email, account ID, role, premium status and wallet balance are protected and cannot be edited here.
</div>

<div class="actions">
<button type="submit" id="saveBtn">Save Changes</button>
<button type="button" class="secondary" id="cancelBtn">Cancel</button>
</div>

<div id="message" class="message" role="status"></div>

</form>
</section>
</main>

<footer>
© <span id="year"></span> LetsStudy Pro. All rights reserved.
<br><br>
<a href="profile.html">My Profile</a> |
<a href="dashboard.html">Dashboard</a> |
<a href="index.html">Home</a>
</footer>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>

<script>
const firebaseConfig = {
  apiKey: "AIzaSyBcOYDfAVKXbKXjsyRgI_0rjodBn678tCc",
  authDomain: "let-s-study-pro-course.firebaseapp.com",
  databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
  projectId: "let-s-study-pro-course",
  storageBucket: "let-s-study-pro-course.firebasestorage.app",
  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
};

if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);

const auth = firebase.auth();
const db = firebase.firestore();

const $ = id => document.getElementById(id);

let currentUser = null;
let originalData = {};

const editableFields = [
  "firstName","lastName","displayName","username","phoneNumber",
  "dateOfBirth","gender","country","region","city","address",
  "postalCode","timezone","accountType","educationLevel",
  "occupation","organizationName","bio","interests","skills",
  "website","photoURL","language","notificationsEnabled"
];

function showMessage(text,type){
  $("message").textContent = text;
  $("message").className = "message " + type;
}

function dateValue(value){
  if(!value) return "";
  if(typeof value === "string") return value.slice(0,10);
  if(value.toDate) return value.toDate().toISOString().slice(0,10);
  return "";
}

function displayAvatar(data){
  const avatar = $("avatar");
  avatar.replaceChildren();

  if(data.photoURL){
    const img = document.createElement("img");
    img.src = data.photoURL;
    img.alt = "Profile photo";
    img.onerror = () => {
      avatar.textContent = (data.displayName || "U").charAt(0).toUpperCase();
    };
    avatar.appendChild(img);
  }else{
    avatar.textContent =
      (data.displayName || data.firstName || "U").charAt(0).toUpperCase();
  }
}

async function loadProfile(user){
  currentUser = user;

  const snapshot = await db.collection("users").doc(user.uid).get();

  if(!snapshot.exists){
    throw new Error("Your user profile was not found in Firestore.");
  }

  const data = snapshot.data();
  originalData = {...data};

  $("email").value = user.email || "";

  editableFields.forEach(field => {
    let value = data[field];

    if(field === "dateOfBirth"){
      value = dateValue(value);
    }

    if(field === "notificationsEnabled"){
      value = value === false || value === "false" ? "false" : "true";
    }

    $(field).value = value == null ? "" : String(value);
  });

  displayAvatar(data);
}

auth.onAuthStateChanged(async user => {
  if(!user){
    location.replace("login.html");
    return;
  }

  try{
    await loadProfile(user);
  }catch(error){
    console.error(error);
    showMessage(error.message || "Unable to load profile.", "error");
  }
});

$("photoURL").addEventListener("input", () => {
  const url = $("photoURL").value.trim();
  const avatar = $("avatar");

  if(!url){
    avatar.textContent = "U";
    return;
  }

  try{
    const parsed = new URL(url);
    if(!["http:","https:"].includes(parsed.protocol)) return;

    const img = document.createElement("img");
    img.src = url;
    img.alt = "Profile preview";
    img.onerror = () => {
      avatar.textContent = "U";
    };
    avatar.replaceChildren(img);
  }catch(error){}
});

$("editProfileForm").addEventListener("submit", async event => {
  event.preventDefault();

  if(!currentUser){
    showMessage("Please sign in first.", "error");
    return;
  }

  const saveBtn = $("saveBtn");
  saveBtn.disabled = true;
  saveBtn.textContent = "Saving...";

  try{
    const updates = {};

    editableFields.forEach(field => {
      const value = $(field).value.trim();

      if(field === "notificationsEnabled"){
        updates[field] = value === "true";
      }else{
        updates[field] = value;
      }
    });

    if(!updates.displayName){
      throw new Error("Display Name is required.");
    }

    ["website","photoURL"].forEach(field => {
      if(updates[field]){
        const parsed = new URL(updates[field]);
        if(!["http:","https:"].includes(parsed.protocol)){
          throw new Error("Please enter a valid HTTP or HTTPS URL.");
        }
      }
    });

    // Derive fullName from editable name fields.
    updates.fullName = [
      updates.firstName,
      updates.lastName
    ].filter(Boolean).join(" ");

    updates.updatedAt =
      firebase.firestore.FieldValue.serverTimestamp();

    // The UID and protected account fields are not editable.
    await db.collection("users").doc(currentUser.uid).set(
      updates,
      {merge:true}
    );

    originalData = {...originalData,...updates};
    displayAvatar(updates);

    showMessage("Your profile has been updated successfully.", "success");

  }catch(error){
    console.error(error);
    showMessage(error.message || "Unable to save changes.", "error");
  }finally{
    saveBtn.disabled = false;
    saveBtn.textContent = "Save Changes";
  }
});

$("cancelBtn").addEventListener("click", () => {
  location.href = "profile.html";
});

$("year").textContent = new Date().getFullYear();
</script>

</body>
</html>
