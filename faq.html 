<script>

/*
=====================================================
FAQ ACCORDION
=====================================================
*/

const questions =
document.querySelectorAll(
".question"
);


questions.forEach(
button => {

button.addEventListener(
"click",
()=>{

const faq =
button.parentElement;

faq.classList.toggle(
"active"
);

});

});


/*
=====================================================
FAQ SEARCH
=====================================================
*/

const search =
document.getElementById(
"search"
);

const faqs =
document.querySelectorAll(
".faq"
);


search.addEventListener(
"input",
function(){

const query =
this.value
.toLowerCase()
.trim();


faqs.forEach(
faq => {

const text =
faq.textContent
.toLowerCase();


if(
text.includes(query)
){

faq.style.display =
"block";

}else{

faq.style.display =
"none";

}

});

});


</script>


