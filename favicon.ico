<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>LetsStudy Pro Ecosystem</title>

<meta name="description"
content="LetsStudy Pro Ecosystem — Education, Jobs, Internships, Freelancing, Courses, Marketplace and Career opportunities.">

<!-- =========================
     FAVICON ECOSYSTEM
========================= -->

<link rel="icon"
      href="/favicon.ico"
      type="image/x-icon">

<link rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32x32.png">

<link rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16x16.png">

<link rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png">

<meta name="theme-color"
      content="#155eef">

<!-- =========================
     FONT
========================= -->

<link rel="preconnect"
      href="https://fonts.googleapis.com">

<link rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet">


<style>

*{
 box-sizing:border-box;
 margin:0;
 padding:0;
}

body{
 font-family:Inter,Arial,sans-serif;
 background:#f6f8fb;
 color:#172033;
}

a{
 text-decoration:none;
 color:inherit;
}

.top{
 height:68px;
 background:#fff;
 border-bottom:1px solid #e5e7eb;
 display:flex;
 align-items:center;
 justify-content:space-between;
 padding:0 6%;
 position:sticky;
 top:0;
 z-index:100;
}

.logo{
 display:flex;
 align-items:center;
 gap:10px;
 font-weight:900;
 color:#155eef;
 font-size:20px;
}

.logo-icon{
 width:38px;
 height:38px;
 border-radius:10px;
 background:#155eef;
 color:#fff;
 display:flex;
 align-items:center;
 justify-content:center;
 font-weight:900;
}

.nav{
 display:flex;
 gap:20px;
 font-size:13px;
 font-weight:700;
}

.nav a:hover{
 color:#155eef;
}

.hero{
 background:
 linear-gradient(135deg,#155eef,#073bba);
 color:#fff;
 padding:75px 20px;
}

.hero-inner{
 max-width:1100px;
 margin:auto;
 text-align:center;
}

.hero h1{
 font-size:42px;
 line-height:1.2;
 margin-bottom:15px;
}

.hero p{
 max-width:720px;
 margin:auto;
 color:#dbe7ff;
 line-height:1.8;
 font-size:14px;
}

.container{
 max-width:1100px;
 margin:35px auto;
 padding:0 20px;
}

.section{
 margin-bottom:45px;
}

.section-title{
 text-align:center;
 margin-bottom:20px;
}

.section-title h2{
 font-size:24px;
 margin-bottom:8px;
}

.section-title p{
 color:#667085;
 font-size:13px;
}

.ecosystem{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:15px;
}

.card{
 background:#fff;
 border:1px solid #e5e7eb;
 border-radius:16px;
 padding:22px;
 transition:.2s;
}

.card:hover{
 transform:translateY(-4px);
 box-shadow:0 15px 35px #00000012;
 border-color:#155eef;
}

.icon{
 width:48px;
 height:48px;
 border-radius:12px;
 background:#eef4ff;
 color:#155eef;
 display:flex;
 align-items:center;
 justify-content:center;
 font-size:21px;
 margin-bottom:15px;
}

.card h3{
 font-size:15px;
 margin-bottom:7px;
}

.card p{
 color:#667085;
 font-size:12px;
 line-height:1.7;
}

.status{
 display:inline-block;
 margin-top:12px;
 padding:5px 9px;
 border-radius:20px;
 background:#ecfdf3;
 color:#027a48;
 font-size:10px;
 font-weight:800;
}

.brand{
 background:#fff;
 border:1px solid #e5e7eb;
 border-radius:18px;
 padding:30px;
 text-align:center;
}

.brand-logo{
 width:90px;
 height:90px;
 background:#155eef;
 color:#fff;
 border-radius:22px;
 display:flex;
 align-items:center;
 justify-content:center;
 margin:0 auto 18px;
 font-size:35px;
 font-weight:900;
 box-shadow:0 12px 30px #155eef33;
}

.brand h2{
 font-size:24px;
 margin-bottom:8px;
}

.brand p{
 color:#667085;
 max-width:650px;
 margin:auto;
 font-size:13px;
 line-height:1.8;
}

.footer{
 background:#101828;
 color:#fff;
 padding:35px 20px;
 text-align:center;
}

.footer strong{
 color:#fff;
}

.footer p{
 color:#98a2b3;
 font-size:11px;
 margin-top:8px;
}

@media(max-width:850px){

 .ecosystem{
  grid-template-columns:repeat(2,1fr);
 }

 .nav{
  display:none;
 }

 .hero h1{
  font-size:34px;
 }

}

@media(max-width:500px){

 .ecosystem{
  grid-template-columns:1fr;
 }

 .hero{
  padding:55px 20px;
 }

 .hero h1{
  font-size:29px;
 }

 .container{
  padding:0 15px;
 }

}

</style>

</head>


<body>


<!-- =========================
     HEADER
========================= -->

<header class="top">

<a href="index.html"
   class="logo">

<div class="logo-icon">
L
</div>

LetsStudy Pro

</a>


<nav class="nav">

<a href="index.html">
Home
</a>

<a href="course.html">
Courses
</a>

<a href="jobs.html">
Jobs
</a>

<a href="internships.html">
Internships
</a>

<a href="freelance.html">
Freelancers
</a>

</nav>

</header>



<!-- =========================
     HERO
========================= -->

<section class="hero">

<div class="hero-inner">

<h1>
LetsStudy Pro Ecosystem
</h1>

<p>
One professional ecosystem connecting education,
skills, careers, jobs, internships, freelancing,
marketplace opportunities and professional growth.
</p>

</div>

</section>



<main class="container">


<!-- =========================
     BRAND
========================= -->

<section class="section">

<div class="brand">

<div class="brand-logo">
L
</div>

<h2>
LetsStudy Pro
</h2>

<p>
Learn. Build Skills. Find Opportunities. Work.
Grow your career through one connected digital ecosystem.
</p>

</div>

</section>



<!-- =========================
     ECOSYSTEM
========================= -->

<section class="section">

<div class="section-title">

<h2>
Everything in One Ecosystem
</h2>

<p>
Professional services designed for students,
job seekers, freelancers and professionals.
</p>

</div>


<div class="ecosystem">


<div class="card">

<div class="icon">
🎓
</div>

<h3>
Courses
</h3>

<p>
Learn practical and professional skills through
structured online courses.
</p>

<span class="status">
ACTIVE
</span>

</div>



<div class="card">

<div class="icon">
💼
</div>

<h3>
Jobs
</h3>

<p>
Discover local, international, remote and
high-value career opportunities.
</p>

<span class="status">
ACTIVE
</span>

</div>



<div class="card">

<div class="icon">
🚀
</div>

<h3>
Internships
</h3>

<p>
Find internships and practical opportunities
to gain professional experience.
</p>

<span class="status">
ACTIVE
</span>

</div>



<div class="card">

<div class="icon">
👨‍💻
</div>

<h3>
Freelancing
</h3>

<p>
Connect with clients and offer professional
services through the marketplace.
</p>

<span class="status">
ACTIVE
</span>

</div>



<div class="card">

<div class="icon">
🛒
</div>

<h3>
Marketplace
</h3>

<p>
Discover digital services, products and
professional solutions.
</p>

<span class="status">
ACTIVE
</span>

</div>



<div class="card">

<div class="icon">
🏆
</div>

<h3>
Certificates
</h3>

<p>
Build verifiable evidence of your learning
and professional achievements.
</p>

<span class="status">
ACTIVE
</span>

</div>



<div class="card">

<div class="icon">
💰
</div>

<h3>
Affiliate
</h3>

<p>
Earn commissions by referring users and
promoting LetsStudy Pro opportunities.
</p>

<span class="status">
ACTIVE
</span>

</div>



<div class="card">

<div class="icon">
⭐
</div>

<h3>
Premium
</h3>

<p>
Access premium features, learning resources
and professional ecosystem benefits.
</p>

<span class="status">
ACTIVE
</span>

</div>


</div>

</section>



<!-- =========================
     FOOTER
========================= -->

</main>


<footer class="footer">

<strong>
LetsStudy Pro
</strong>

<p>
Education • Careers • Jobs • Internships • Freelancing • Marketplace
</p>

<p>
© 2026 LetsStudy Pro. All rights reserved.
</p>

</footer>


</body>
</html>