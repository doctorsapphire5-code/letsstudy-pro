      "";

  }


  countryFilter.value =
    "";

  categoryFilter.value =
    "";

  fundingFilter.value =
    "";

  statusFilter.value =
    "";

  fundedOnly.checked =
    false;

  featuredOnly.checked =
    false;

  sortFilter.value =
    "newest";


  applyFilters();

}


