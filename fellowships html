/* =====================================
   BACK TO TOP
===================================== */

const backToTop =
  document.getElementById(
    "backToTop"
  );


if(backToTop){

  const updateBackToTop =
    () => {

      const visible =
        window.scrollY >
        400;


      backToTop.style.opacity =
        visible
          ? "1"
          : "0";


      backToTop.style.visibility =
        visible
          ? "visible"
          : "hidden";


      backToTop.style.transform =
        visible
          ? "translateY(0)"
          : "translateY(10px)";

    };


  window.addEventListener(
    "scroll",
    updateBackToTop
  );


  backToTop.addEventListener(
    "click",
    () => {

      window.scrollTo({

        top:0,

        behavior:"smooth"

      });

    }
  );


  updateBackToTop();

}


/* =====================================
   BROKEN IMAGE FALLBACK
===================================== */

document.addEventListener(
  "error",
  event => {

    const target =
      event.target;


    if(
      target.tagName !==
      "IMG"
    ){

      return;

    }


    target.style.display =
      "none";


    const parent =
      target.parentElement;


    if(
      parent &&
      !parent.querySelector(
        ".image-placeholder"
      )
    ){

      const placeholder =
        document.createElement(
          "div"
        );


      placeholder.className =
        "image-placeholder";


      placeholder.innerHTML = `

        <i
          class="
            fa-solid
            fa-people-group
          "
        ></i>

      `;


      parent.appendChild(
        placeholder
      );

    }

  },
  true
);


