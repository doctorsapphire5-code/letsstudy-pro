/* =====================================
   SHARE
===================================== */

document.addEventListener(
  "click",
  async event => {

    const button =
      event.target.closest(
        "[data-share-id]"
      );


    if(!button){

      return;

    }


    const id =
      button.dataset.shareId;


    const title =
      button.dataset.shareTitle;


    const url =
      new URL(
        `fellowship-details.html?id=${
          encodeURIComponent(id)
        }`,
        window.location.href
      ).href;


    try{

      if(
        navigator.share
      ){

        await navigator.share({

          title:
            title,

          text:
            `${title} | LetsStudy Pro`,

          url:
            url

        });

      }
      else{

        await navigator.clipboard.writeText(
          url
        );

        alert(
          "Fellowship link copied!"
        );

      }

    }
    catch(error){

      console.log(
        "Share cancelled."
      );

    }

  }
);


