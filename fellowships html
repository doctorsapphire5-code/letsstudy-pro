  const date =
    getDate(value);


  if(!date){

    return false;

  }


  return date <
    new Date();

}


/* =====================================
   LOAD FELLOWSHIPS
===================================== */

async function loadFellowships(){

  try{

    grid.innerHTML = `

      <div class="loading">

        <i
          class="
            fa-solid
            fa-spinner
            fa-spin
          "
        ></i>

        <p>
          Loading fellowships...
        </p>

      </div>

    `;


    const snapshot =
      await getDocs(
        collection(
          db,
          "fellowships"
        )
      );


    fellowships =
      snapshot.docs.map(
        docSnap => ({

          id:
            docSnap.id,

          ...docSnap.data()

        })
      )
      .filter(
        item =>
          item.status !==
          "draft"
      );


    updateStats();

    populateFilters();

    applyFilters();

  }
  catch(error){

    console.error(
      error
    );


    grid.innerHTML = `

      <div class="empty">

        <i
          class="
            fa-solid
            fa-triangle-exclamation
          "
        ></i>

        <h3>
          Unable to load fellowships
        </h3>

        <p>
          Please check your internet
          connection and try again.
        </p>

        <button
          id="retryBtn"
          class="clear-btn"
          type="button"
        >

          <i
            class="
              fa-solid
              fa-rotate-right
            "
          ></i>

          Try Again

        </button>

      </div>

    `;


    document
      .getElementById(
        "retryBtn"
      )
      ?.addEventListener(
        "click",
        loadFellowships
      );

  }

}


/* =====================================
   UPDATE STATS
===================================== */

function updateStats(){

  const countries =
    new Set(
      fellowships
        .map(
          item =>
            item.country
        )
        .filter(Boolean)
    );


  const funded =
    fellowships.filter(
      item =>
        String(
          item.fundingType ||
          ""
        )
        .toLowerCase()
        .includes(
          "full"
        )
    );


  const featured =
    fellowships.filter(
      item =>
        item.featured === true
    );


  document.getElementById(
    "totalCount"
  ).textContent =
    fellowships.length;


  document.getElementById(
    "countryCount"
  ).textContent =
    countries.size;


  document.getElementById(
    "fundedCount"
  ).textContent =
    funded.length;


  document.getElementById(
    "featuredCount"
  ).textContent =
    featured.length;

}


/* =====================================
   POPULATE FILTERS
===================================== */

function populateFilters(){

  fillSelect(
    countryFilter,
    fellowships.map(
      item =>
        item.country
    ),
    "All Countries"
  );


  fillSelect(
    categoryFilter,
    fellowships.map(
      item =>
        item.category
    ),
    "All Categories"
  );


  fillSelect(
    fundingFilter,
    fellowships.map(
      item =>
        item.fundingType
    ),
    "All Funding Types"
  );

}


/* =====================================
   FILL SELECT
===================================== */

function fillSelect(
  select,
  values,
  placeholder
){

  if(!select){

    return;

  }


  select.innerHTML = `

    <option value="">
      ${placeholder}
    </option>

  `;


  const unique =
    [
      ...new Set(
        values
          .filter(Boolean)
          .map(
            value =>
              String(
                value
              ).trim()
          )
      )
    ]
    .sort(
      (a,b) =>
        a.localeCompare(b)
    );


  unique.forEach(
    value => {

      const option =
        document.createElement(
          "option"
        );


      option.value =
        value;


      option.textContent =
        value;


      select.appendChild(
        option
      );

    }
  );

}


/* =====================================
   APPLY FILTERS
===================================== */

function applyFilters(){

  const query =
    search?.value
      ?.trim()
      .toLowerCase() ||
    "";


  filteredFellowships =
    fellowships.filter(
      item => {

        const searchable =
          [

            item.title,

            item.organization,

            item.provider,

            item.country,

            item.location,

            item.category,

            item.studyArea,

            item.description,

            item.shortDescription,

            item.fundingType

          ]
          .filter(Boolean)
          .join(" ")
          .toLowerCase();


        const searchMatch =
          !query ||
          searchable.includes(
            query
          );


        const countryMatch =
          !countryFilter.value ||
          item.country ===
          countryFilter.value;


        const categoryMatch =
          !categoryFilter.value ||
          item.category ===
          categoryFilter.value;


        const fundingMatch =
          !fundingFilter.value ||
          item.fundingType ===
          fundingFilter.value;


        const funded =
          String(
            item.fundingType ||
            ""
          )
          .toLowerCase()
          .includes(
            "full"
          );


        const fundedMatch =
          !fundedOnly.checked ||
          funded;


        const featuredMatch =
          !featuredOnly.checked ||
          item.featured === true;


        let statusMatch =
          true;


        if(
          statusFilter.value ===
          "funded"
        ){

          statusMatch =
            funded;

        }


        if(
          statusFilter.value ===
          "featured"
        ){

          statusMatch =
            item.featured === true;

        }


        return (

          searchMatch &&

          countryMatch &&

          categoryMatch &&

          fundingMatch &&

          fundedMatch &&

          featuredMatch &&

          statusMatch

        );

      }
    );


  sortFellowships();

}


/* =====================================
   SORT FELLOWSHIPS
===================================== */

function sortFellowships(){

  const sort =
    sortFilter.value;


  filteredFellowships.sort(
    (a,b) => {

      if(
        sort ===
        "name"
      ){

        return String(
          a.title || ""
        ).localeCompare(
          String(
            b.title || ""
          )
        );

      }


      if(
        sort ===
        "country"
      ){

        return String(
          a.country || ""
        ).localeCompare(
          String(
            b.country || ""
          )
        );

      }


      if(
        sort ===
        "popular"
      ){

        return (
          Number(
            b.views || 0
          ) -
          Number(
            a.views || 0
          )
        );

      }


      if(
        sort ===
        "deadline"
      ){

        const dateA =
          getDate(
            a.deadline
          )?.getTime() ||
          Infinity;


        const dateB =
          getDate(
            b.deadline
          )?.getTime() ||
          Infinity;


        return dateA -
          dateB;

      }


      const dateA =
        getDate(
          a.createdAt
        )?.getTime() ||
        0;


      const dateB =
        getDate(
          b.createdAt
        )?.getTime() ||
        0;


      return dateB -
        dateA;

    }
  );


  renderFellowships();

}


/* =====================================
   RENDER FELLOWSHIPS
===================================== */

function renderFellowships(){

  const count =
    filteredFellowships.length;


  document.getElementById(
    "resultCount"
  ).innerHTML = `

    Showing
    <strong>
      ${count}
    </strong>
    ${
      count === 1
        ? "fellowship"
        : "fellowships"
    }

  `;


  if(!count){

    grid.innerHTML = `

      <div class="empty">

        <i
          class="
            fa-solid
            fa-people-group
          "
        ></i>

        <h3>
          No Fellowships Found
        </h3>

        <p>
          Try changing your search
          or filters.
        </p>

        <button
          id="emptyClear"
          type="button"
          class="clear-btn"
        >

          Clear Filters

        </button>

      </div>

    `;


    document
      .getElementById(
        "emptyClear"
      )
      ?.addEventListener(
        "click",
        clearFilters
      );


    return;

  }


  grid.innerHTML =
    filteredFellowships
      .map(
        createCard
      )
      .join("");

}


