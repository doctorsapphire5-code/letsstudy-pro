{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/index-auth.html",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/api/pesapal/create-order",
        "function": {
          "functionId": "createPesapalOrder",
          "region": "africa-south1"
        }
      },
      {
        "source": "/api/pesapal/payment-status",
        "function": {
          "functionId": "pesapalPaymentStatus",
          "region": "africa-south1"
        }
      },
      {
        "source": "/api/pesapal/callback",
        "function": {
          "functionId": "pesapalCallback",
          "region": "africa-south1"
        }
      },
      {
        "source": "/api/pesapal/ipn",
        "function": {
          "functionId": "pesapalIPN",
          "region": "africa-south1"
        }
      },
      {
        "source": "/share/**",
        "function": {
          "functionId": "sharePreview",
          "region": "africa-south1"
        }
      }
    ]
  }
}