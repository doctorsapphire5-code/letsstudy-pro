{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/index-auth.html",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/share/**",
        "function": {
          "functionId": "sharePreview",
          "region": "africa-south1"
        }
      }
    ]
  }
}