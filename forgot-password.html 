<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="Reset your LetsStudy Pro password securely using your registered email address."
  >

  <title>Forgot Password | LetsStudy Pro</title>


  <style>

    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
    }


    body{
      min-height:100vh;

      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      background:
        linear-gradient(
          135deg,
          #eef4ff,
          #f8f9fc
        );

      color:#172033;

      display:flex;
      align-items:center;
      justify-content:center;

      padding:20px;
    }


    .page{
      width:100%;
      max-width:1050px;

      display:grid;
      grid-template-columns:1fr 1fr;

      background:#fff;

      border-radius:28px;

      overflow:hidden;

      box-shadow:
        0 25px 70px
        rgba(20,35,70,.12);
    }


    /* =====================================================
       BRAND PANEL
    ====================================================== */

    .brand-panel{
      padding:55px;

      color:white;

      background:
        linear-gradient(
          145deg,
          #1769ff,
          #573cff
        );

      position:relative;

      overflow:hidden;
    }


    .brand-panel::before{
      content:"";

      position:absolute;

      width:300px;
      height:300px;

      border-radius:50%;

      background:
        rgba(255,255,255,.08);

      right:-120px;
      top:-100px;
    }


    .brand-panel::after{
      content:"";

      position:absolute;

      width:220px;
      height:220px;

      border-radius:50%;

      background:
        rgba(255,255,255,.06);

      left:-100px;
      bottom:-90px;
    }


    .logo{
      position:relative;
      z-index:2;

      display:flex;
      align-items:center;

      gap:11px;

      font-size:22px;
      font-weight:800;
    }


    .logo-icon{
      width:44px;
      height:44px;

      border-radius:13px;

      background:
        rgba(255,255,255,.16);

      display:flex;
      align-items:center;
      justify-content:center;

      font-size:23px;
    }


    .brand-content{
      position:relative;
      z-index:2;

      margin-top:100px;
    }


    .brand-content h1{
      font-size:
        clamp(32px,4vw,48px);

      line-height:1.1;

      margin-bottom:18px;
    }


    .brand-content p{
      line-height:1.7;

      opacity:.9;

      max-width:420px;
    }


    .security{
      position:relative;
      z-index:2;

      margin-top:35px;

      display:flex;
      align-items:center;

      gap:10px;

      font-size:13px;

      opacity:.9;
    }


    /* =====================================================
       FORM PANEL
    ====================================================== */

    .form-panel{
      padding:55px;

      display:flex;
      align-items:center;
    }


    .form-content{
      width:100%;
      max-width:430px;
      margin:auto;
    }


    .back{
      display:inline-flex;

      align-items:center;

      gap:7px;

      border:0;

      background:none;

      color:#637086;

      margin-bottom:28px;

      cursor:pointer;
    }


    .back:hover{
      color:#1769ff;
    }


    .form-content h2{
      font-size:30px;

      margin-bottom:10px;
    }


    .subtitle{
      color:#6d788c;

      line-height:1.6;

      font-size:14px;

      margin-bottom:27px;
    }


    .field{
      margin-bottom:18px;
    }


    .field label{
      display:block;

      font-size:13px;

      font-weight:700;

      margin-bottom:8px;
    }


    .input-wrap{
      position:relative;
    }


    .input-icon{
      position:absolute;

      left:14px;
      top:50%;

      transform:
        translateY(-50%);

      font-size:17px;

      color:#7b8799;
    }


    .input{
      width:100%;

      padding:
        14px
        14px
        14px
        44px;

      border:1px solid #dce2eb;

      border-radius:12px;

      outline:none;

      background:#fff;

      transition:.2s;
    }


    .input:focus{
      border-color:#1769ff;

      box-shadow:
        0 0 0 4px
        rgba(23,105,255,.08);
    }


    .submit{
      width:100%;

      border:0;

      border-radius:12px;

      padding:14px;

      background:#1769ff;

      color:white;

      font-weight:750;

      cursor:pointer;

      display:flex;

      align-items:center;

      justify-content:center;

      gap:10px;

      transition:.2s;
    }


    .submit:hover{
      background:#0f5ae4;
    }


    .submit:disabled{
      opacity:.65;

      cursor:not-allowed;
    }


    .spinner{
      width:18px;
      height:18px;

      border:2px solid
        rgba(255,255,255,.35);

      border-top-color:white;

      border-radius:50%;

      animation:
        spin .7s linear infinite;

      display:none;
    }


    .spinner.show{
      display:block;
    }


    @keyframes spin{
      to{
        transform:rotate(360deg);
      }
    }


    /* =====================================================
       ALERT
    ====================================================== */

    .alert{
      display:none;

      padding:13px 14px;

      border-radius:11px;

      font-size:13px;

      line-height:1.5;

      margin-bottom:17px;
    }


    .alert.show{
      display:block;
    }


    .alert.success{
      background:#eaf9f1;
      color:#187347;
      border:1px solid #ccefdc;
    }


    .alert.error{
      background:#fff0f0;
      color:#b42323;
      border:1px solid #ffd3d3;
    }


    .alert.info{
      background:#eef5ff;
      color:#245cae;
      border:1px solid #d6e5ff;
    }


    /* =====================================================
       SUCCESS
    ====================================================== */

    .success-box{
      display:none;

      text-align:center;
    }


    .success-box.show{
      display:block;
    }


    .success-icon{
      width:75px;
      height:75px;

      margin:0 auto 20px;

      border-radius:50%;

      background:#eaf9f1;

      color:#18a05d;

      display:flex;
      align-items:center;
      justify-content:center;

      font-size:35px;
    }


    .success-box h2{
      margin-bottom:10px;
    }


    .success-box p{
      color:#6d788c;

      font-size:14px;

      line-height:1.7;

      margin-bottom:22px;
    }


    .login-btn{
      width:100%;

      padding:13px;

      border-radius:11px;

      border:1px solid #dce2eb;

      background:white;

      color:#1769ff;

      font-weight:700;

      cursor:pointer;
    }


    /* =====================================================
       FOOTER
    ====================================================== */

    .footer{
      margin-top:24px;

      text-align:center;

      color:#7a8496;

      font-size:12px;

      line-height:1.7;
    }


    .footer a{
      color:#1769ff;

      text-decoration:none;
    }


    /* =====================================================
       RESPONSIVE
    ====================================================== */

    @media(max-width:780px){

      .page{
        grid-template-columns:1fr;
      }


      .brand-panel{
        padding:30px;
      }


      .brand-content{
        margin-top:45px;
      }


      .brand-content h1{
        font-size:34px;
      }


      .form-panel{
        padding:35px 25px;
      }

    }


    @media(max-width:480px){

      body{
        padding:10px;
      }


      .page{
        border-radius:20px;
      }


      .brand-panel{
        padding:25px;
      }


      .form-panel{
        padding:28px 20px;
      }

    }

  </style>

</head>


<body>


  <main class="page">


    <!-- ===================================================
         BRAND
    ==================================================== -->

    <section class="brand-panel">

      <div class="logo">

        <div class="logo-icon">
          📚
        </div>

        LetsStudy Pro

      </div>


      <div class="brand-content">

        <h1>
          Get back to learning.
        </h1>

        <p>
          Forgot your password?
          No problem. Enter the email
          associated with your LetsStudy Pro
          account and we'll send you a secure
          password reset link.
        </p>


        <div class="security">

          🔒

          <span>
            Secure Firebase Authentication
          </span>

        </div>

      </div>

    </section>


    <!-- ===================================================
         FORM
    ==================================================== -->

    <section class="form-panel">

      <div class="form-content">


        <button
          type="button"
          class="back"
          id="backBtn"
        >
          ← Back to Login
        </button>


        <!-- FORM -->

        <div id="resetFormBox">

          <h2>
            Forgot password?
          </h2>


          <p class="subtitle">

            Enter your email address below.
            We'll send you a link to create
            a new password.

          </p>


          <div
            class="alert"
            id="alertBox"
          ></div>


          <form
            id="resetForm"
            novalidate
          >

            <div class="field">

              <label
                for="email"
              >
                Email Address
              </label>


              <div class="input-wrap">

                <span class="input-icon">
                  ✉️
                </span>


                <input
                  class="input"
                  id="email"
                  type="email"
                  placeholder="you@example.com"
                  autocomplete="email"
                  required
                >

              </div>

            </div>


            <button
              type="submit"
              class="submit"
              id="resetBtn"
            >

              <span
                class="spinner"
                id="spinner"
              ></span>

              <span id="btnText">
                Send Reset Link
              </span>

            </button>

          </form>


          <div class="footer">

            Remember your password?

            <a
              href="login.html"
            >
              Sign in
            </a>

            <br>

            ©
            <span id="year"></span>
            LetsStudy Pro

          </div>

        </div>


        <!-- SUCCESS -->

        <div
          class="success-box"
          id="successBox"
        >

          <div class="success-icon">
            ✓
          </div>


          <h2>
            Check your email
          </h2>


          <p>

            We've sent a password reset
            link to

            <strong id="sentEmail">
            </strong>.

            <br><br>

            Open your email and follow
            the instructions to create
            a new password.

          </p>


          <button
            type="button"
            class="login-btn"
            id="loginBtn"
          >
            ← Back to Login
          </button>

        </div>


      </div>

    </section>

  </main>


  <!-- =====================================================
       FIREBASE
  ====================================================== -->

  <script type="module">

    import {
      initializeApp
    }
    from
    "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";


    import {
      getAuth,
      sendPasswordResetEmail
    }
    from
    "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";


    /* =====================================================
       FIREBASE CONFIG
    ====================================================== */

    const firebaseConfig = {

      apiKey:
        "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

      authDomain:
        "let-s-study-pro-course.firebaseapp.com",

      databaseURL:
        "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

      projectId:
        "let-s-study-pro-course",

      storageBucket:
        "let-s-study-pro-course.firebasestorage.app",

      messagingSenderId:
        "474928293390",

      appId:
        "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

      measurementId:
        "G-M7Z6SPNH1N"

    };


    const app =
      initializeApp(
        firebaseConfig
      );


    const auth =
      getAuth(app);


    /* =====================================================
       ELEMENTS
    ====================================================== */

    const form =
      document.getElementById(
        "resetForm"
      );


    const emailInput =
      document.getElementById(
        "email"
      );


    const resetBtn =
      document.getElementById(
        "resetBtn"
      );


    const btnText =
      document.getElementById(
        "btnText"
      );


    const spinner =
      document.getElementById(
        "spinner"
      );


    const alertBox =
      document.getElementById(
        "alertBox"
      );


    const resetFormBox =
      document.getElementById(
        "resetFormBox"
      );


    const successBox =
      document.getElementById(
        "successBox"
      );


    const sentEmail =
      document.getElementById(
        "sentEmail"
      );


    /* =====================================================
       YEAR
    ====================================================== */

    document.getElementById(
      "year"
    ).textContent =
      new Date().getFullYear();


    /* =====================================================
       ALERT
    ====================================================== */

    function showAlert(
      message,
      type = "error"
    ){

      alertBox.textContent =
        message;

      alertBox.className =
        "alert " +
        type +
        " show";

    }


    function hideAlert(){

      alertBox.className =
        "alert";

      alertBox.textContent =
        "";

    }


    /* =====================================================
       FORM
    ====================================================== */

    form.addEventListener(
      "submit",
      async event => {

        event.preventDefault();


        hideAlert();


        const email =
          emailInput.value
            .trim()
            .toLowerCase();


        /* VALIDATION */

        if(!email){

          showAlert(
            "Please enter your email address."
          );

          emailInput.focus();

          return;

        }


        const emailPattern =
          /^[^\s@]+@[^\s@]+\.[^\s@]+$/;


        if(
          !emailPattern.test(
            email
          )
        ){

          showAlert(
            "Please enter a valid email address."
          );

          emailInput.focus();

          return;

        }


        /* LOADING */

        resetBtn.disabled =
          true;

        spinner.classList.add(
          "show"
        );

        btnText.textContent =
          "Sending reset link...";


        try{

          await sendPasswordResetEmail(
            auth,
            email
          );


          /* SUCCESS */

          sentEmail.textContent =
            email;


          resetFormBox.style.display =
            "none";


          successBox.classList.add(
            "show"
          );


        }catch(error){

          console.error(
            "Password reset error:",
            error
          );


          let message =
            "Unable to send the reset link. Please try again.";


          switch(
            error.code
          ){

            case
              "auth/invalid-email":

              message =
                "The email address is not valid.";

              break;


            case
              "auth/user-not-found":

              /*
               * Firebase projects may hide whether
               * an account exists depending on
               * account-enumeration protection.
               */

              message =
                "If an account exists for this email, a reset link will be sent.";

              showAlert(
                message,
                "info"
              );

              break;


            case
              "auth/too-many-requests":

              message =
                "Too many requests. Please wait a few minutes and try again.";

              break;


            case
              "auth/network-request-failed":

              message =
                "Network error. Check your internet connection and try again.";

              break;


            case
              "auth/operation-not-allowed":

              message =
                "Password reset is currently unavailable. Check Firebase Authentication settings.";

              break;

          }


          if(
            error.code !==
            "auth/user-not-found"
          ){

            showAlert(
              message,
              "error"
            );

          }


        }finally{

          resetBtn.disabled =
            false;

          spinner.classList.remove(
            "show"
          );

          btnText.textContent =
            "Send Reset Link";

        }

      }
    );


    /* =====================================================
       BACK TO LOGIN
    ====================================================== */

    function goToLogin(){

      const params =
        new URLSearchParams(
          window.location.search
        );


      const redirect =
        params.get(
          "redirect"
        );


      if(redirect){

        window.location.href =
          "login.html?redirect=" +
          encodeURIComponent(
            redirect
          );

        return;

      }


      window.location.href =
        "login.html";

    }


    document
      .getElementById(
        "backBtn"
      )
      .addEventListener(
        "click",
        goToLogin
      );


    document
      .getElementById(
        "loginBtn"
      )
      .addEventListener(
        "click",
        goToLogin
      );


    /* =====================================================
       AUTO FOCUS
    ====================================================== */

    window.addEventListener(
      "load",
      () => {

        emailInput.focus();

      }
    );

  </script>


  <!-- =====================================================
       GOOGLE ANALYTICS
  ====================================================== -->

  <script
    async
    src="https://www.googletagmanager.com/gtag/js?id=G-M7Z6SPNH1N"
  ></script>


  <script>

    window.dataLayer =
      window.dataLayer || [];


    function gtag(){

      dataLayer.push(
        arguments
      );

    }


    gtag(
      "js",
      new Date()
    );


    gtag(
      "config",
      "G-M7Z6SPNH1N"
    );

  </script>


</body>
</html>