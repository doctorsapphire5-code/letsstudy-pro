<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="Forgot your LetsStudy Pro password? Request a secure password reset link."
  >

  <meta
    name="robots"
    content="noindex, nofollow"
  >

  <title>Forgot Password | LetsStudy Pro</title>

  <style>

    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
    }

    body{
      min-height:100vh;
      font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Arial,
        sans-serif;

      background:
        linear-gradient(
          135deg,
          #f4f7ff 0%,
          #eef3ff 50%,
          #ffffff 100%
        );

      color:#172033;
    }

    a{
      text-decoration:none;
    }

    button,
    input{
      font:inherit;
    }

    .page{
      min-height:100vh;
      display:flex;
      flex-direction:column;
    }

    /* =========================
       HEADER
    ========================= */

    header{
      padding:18px 24px;
      background:rgba(255,255,255,.94);
      border-bottom:1px solid #e8ecf4;
      backdrop-filter:blur(12px);
    }

    .header-inner{
      max-width:1100px;
      margin:auto;

      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:20px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;

      color:#172033;
      font-size:19px;
      font-weight:800;
    }

    .brand-logo{
      width:38px;
      height:38px;

      border-radius:12px;

      display:flex;
      align-items:center;
      justify-content:center;

      background:#315efb;
      color:#fff;

      font-size:18px;
      font-weight:900;

      box-shadow:
        0 8px 20px rgba(49,94,251,.22);
    }

    .home-link{
      color:#4d5870;
      font-size:14px;
      font-weight:600;
    }

    .home-link:hover{
      color:#315efb;
    }

    /* =========================
       MAIN
    ========================= */

    main{
      flex:1;

      display:flex;
      align-items:center;
      justify-content:center;

      padding:45px 20px;
    }

    .card{
      width:100%;
      max-width:480px;

      padding:36px;

      background:#fff;

      border:1px solid #e8ecf4;
      border-radius:24px;

      box-shadow:
        0 25px 70px rgba(34,49,88,.10);
    }

    .icon{
      width:68px;
      height:68px;

      margin:0 auto 20px;

      border-radius:20px;

      display:flex;
      align-items:center;
      justify-content:center;

      background:#eef3ff;

      font-size:30px;
    }

    .title{
      text-align:center;

      font-size:30px;
      line-height:1.2;

      font-weight:800;

      margin-bottom:12px;
    }

    .subtitle{
      text-align:center;

      color:#69748a;

      font-size:15px;
      line-height:1.7;

      margin-bottom:28px;
    }

    /* =========================
       ALERTS
    ========================= */

    .alert{
      display:none;

      padding:13px 14px;

      margin-bottom:18px;

      border-radius:13px;

      font-size:14px;
      line-height:1.55;

      white-space:pre-line;
    }

    .alert.show{
      display:block;
    }

    .alert.error{
      background:#fff1f2;
      border:1px solid #fecdd3;
      color:#be123c;
    }

    .alert.success{
      background:#ecfdf5;
      border:1px solid #a7f3d0;
      color:#047857;
    }

    /* =========================
       FORM
    ========================= */

    .form-group{
      margin-bottom:20px;
    }

    label{
      display:block;

      margin-bottom:8px;

      color:#303b52;

      font-size:14px;
      font-weight:700;
    }

    .input-wrapper{
      position:relative;
    }

    .input-icon{
      position:absolute;

      left:15px;
      top:50%;

      transform:translateY(-50%);

      font-size:17px;
      opacity:.7;

      pointer-events:none;
    }

    input{
      width:100%;
      height:52px;

      padding:0 15px 0 44px;

      border:1px solid #dce2ed;

      border-radius:13px;

      outline:none;

      background:#fff;
      color:#172033;

      transition:
        border-color .2s,
        box-shadow .2s;
    }

    input:focus{
      border-color:#315efb;

      box-shadow:
        0 0 0 4px rgba(49,94,251,.10);
    }

    input::placeholder{
      color:#9aa4b6;
    }

    /* =========================
       BUTTON
    ========================= */

    .submit-btn{
      width:100%;
      height:52px;

      border:0;
      border-radius:13px;

      background:#315efb;
      color:#fff;

      font-size:15px;
      font-weight:750;

      cursor:pointer;

      display:flex;
      align-items:center;
      justify-content:center;
      gap:9px;

      transition:
        transform .15s,
        box-shadow .2s,
        opacity .2s;
    }

    .submit-btn:hover{
      transform:translateY(-1px);

      box-shadow:
        0 10px 25px rgba(49,94,251,.22);
    }

    .submit-btn:disabled{
      opacity:.65;
      cursor:not-allowed;
      transform:none;
      box-shadow:none;
    }

    .spinner{
      width:18px;
      height:18px;

      border:2px solid rgba(255,255,255,.45);
      border-top-color:#fff;

      border-radius:50%;

      display:none;

      animation:
        spin .7s linear infinite;
    }

    .loading .spinner{
      display:block;
    }

    .loading .button-text{
      display:none;
    }

    @keyframes spin{
      to{
        transform:rotate(360deg);
      }
    }

    /* =========================
       LINKS
    ========================= */

    .links{
      display:flex;
      justify-content:center;
      flex-wrap:wrap;

      gap:10px 18px;

      margin-top:24px;

      font-size:14px;
    }

    .links a{
      color:#315efb;
      font-weight:650;
    }

    .links a:hover{
      text-decoration:underline;
    }

    .divider{
      height:1px;
      background:#edf0f5;

      margin:27px 0 21px;
    }

    /* =========================
       INFO
    ========================= */

    .info{
      padding:15px;

      background:#f8fafc;

      border:1px solid #edf0f5;

      border-radius:14px;

      color:#69748a;

      font-size:13px;
      line-height:1.65;
    }

    .info strong{
      color:#303b52;
    }

    /* =========================
       FOOTER
    ========================= */

    footer{
      padding:22px 20px;

      text-align:center;

      color:#7b8598;

      font-size:13px;
    }

    .footer-links{
      display:flex;

      justify-content:center;
      flex-wrap:wrap;

      gap:15px;

      margin-top:8px;
    }

    .footer-links a{
      color:#69748a;
    }

    .footer-links a:hover{
      color:#315efb;
    }

    /* =========================
       MOBILE
    ========================= */

    @media(max-width:600px){

      header{
        padding:15px 16px;
      }

      .brand{
        font-size:17px;
      }

      .brand-logo{
        width:35px;
        height:35px;
      }

      main{
        padding:28px 15px;
        align-items:flex-start;
      }

      .card{
        padding:28px 21px;
        border-radius:20px;
      }

      .title{
        font-size:26px;
      }

      .subtitle{
        font-size:14px;
      }

    }

  </style>

</head>


<body>

<div class="page">


  <!-- =========================
       HEADER
  ========================= -->

  <header>

    <div class="header-inner">

      <a
        href="index.html"
        class="brand"
      >

        <span class="brand-logo">
          L
        </span>

        <span>
          LetsStudy Pro
        </span>

      </a>

      <a
        href="index.html"
        class="home-link"
      >
        ← Home
      </a>

    </div>

  </header>


  <!-- =========================
       MAIN
  ========================= -->

  <main>

    <section class="card">

      <div class="icon">
        🔑
      </div>

      <h1 class="title">
        Forgot Password?
      </h1>

      <p class="subtitle">
        Enter the email address connected to
        your LetsStudy Pro account and we'll
        send you a secure password reset link.
      </p>


      <!-- ERROR -->

      <div
        id="errorMessage"
        class="alert error"
        role="alert"
      ></div>


      <!-- SUCCESS -->

      <div
        id="successMessage"
        class="alert success"
        role="status"
      ></div>


      <!-- =========================
           FORM
      ========================= -->

      <form
        id="forgotForm"
        novalidate
      >

        <div class="form-group">

          <label for="email">
            Email Address
          </label>

          <div class="input-wrapper">

            <span class="input-icon">
              ✉️
            </span>

            <input
              type="email"
              id="email"
              name="email"
              placeholder="doctorsapphire5@gmail.com"
              autocomplete="email"
              required
            >

          </div>

        </div>


        <button
          type="submit"
          id="submitButton"
          class="submit-btn"
        >

          <span class="spinner"></span>

          <span class="button-text">
            Send Reset Link
          </span>

        </button>

      </form>


      <!-- =========================
           LINKS
      ========================= -->

      <div class="links">

        <a href="login.html">
          ← Back to Login
        </a>

        <a href="register.html">
          Create Account →
        </a>

      </div>


      <div class="divider"></div>


      <!-- =========================
           INFORMATION
      ========================= -->

      <div class="info">

        💡 <strong>What happens next?</strong>

        <br><br>

        1. We'll send a password reset email.

        <br>

        2. Open the link in your email.

        <br>

        3. Choose a new secure password.

        <br>

        4. Return to LetsStudy Pro and login.

        <br><br>

        Check your spam or junk folder if you
        don't see the email.

      </div>

    </section>

  </main>


  <!-- =========================
       FOOTER
  ========================= -->

  <footer>

    © 2026 LetsStudy Pro

    <div class="footer-links">

      <a href="login.html">
        Login
      </a>

      <a href="register.html">
        Register
      </a>

      <a href="privacy.html">
        Privacy
      </a>

      <a href="terms.html">
        Terms
      </a>

      <a href="index.html">
        Home
      </a>

    </div>

  </footer>


</div>


<!-- =====================================================
     FIREBASE AUTH
===================================================== -->

<script type="module">

  import {
    initializeApp
  }
  from
  "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";


  import {
    getAuth,
    sendPasswordResetEmail
  }
  from
  "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";


  /* =====================================================
     FIREBASE CONFIG

     Use the config from:
     let-s-study-pro-course
  ===================================================== */

  // For Firebase JS SDK v7.20.0 and later, measurementId is optional
const firebaseConfig = {
  apiKey: "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",
  authDomain: "let-s-study-pro-course.firebaseapp.com",
  databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
  projectId: "let-s-study-pro-course",
  storageBucket: "let-s-study-pro-course.firebasestorage.app",
  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
};


  /* =====================================================
     INITIALIZE FIREBASE
  ===================================================== */

  const app =
    initializeApp(firebaseConfig);

  const auth =
    getAuth(app);


  /* =====================================================
     ELEMENTS
  ===================================================== */

  const form =
    document.getElementById("forgotForm");

  const emailInput =
    document.getElementById("email");

  const submitButton =
    document.getElementById("submitButton");

  const errorMessage =
    document.getElementById("errorMessage");

  const successMessage =
    document.getElementById("successMessage");


  /* =====================================================
     HELPERS
  ===================================================== */

  function clearMessages(){

    errorMessage.textContent = "";

    successMessage.textContent = "";

    errorMessage.classList.remove(
      "show"
    );

    successMessage.classList.remove(
      "show"
    );

  }


  function showError(message){

    errorMessage.textContent =
      message;

    errorMessage.classList.add(
      "show"
    );

    successMessage.classList.remove(
      "show"
    );

  }


  function showSuccess(message){

    successMessage.textContent =
      message;

    successMessage.classList.add(
      "show"
    );

    errorMessage.classList.remove(
      "show"
    );

  }


  function setLoading(loading){

    submitButton.disabled =
      loading;

    submitButton.classList.toggle(
      "loading",
      loading
    );

  }


  /* =====================================================
     FIREBASE ERROR HANDLER
  ===================================================== */

  function getErrorMessage(error){

    console.error(
      "🔥 FORGOT PASSWORD ERROR:",
      error
    );


    switch(error.code){

      case "auth/invalid-email":

        return (
          "Please enter a valid email address."
        );


      case "auth/user-not-found":

        /*
         Security-friendly message.
        */

        return (
          "If an account exists for this email, " +
          "a password reset link will be sent."
        );


      case "auth/too-many-requests":

        return (
          "Too many requests. Please wait " +
          "and try again later."
        );


      case "auth/network-request-failed":

        return (
          "Network error. Please check your " +
          "internet connection."
        );


      case "auth/unauthorized-domain":

        return (
          "This domain is not authorized in " +
          "Firebase Authentication."
        );


      case "auth/api-key-not-valid":

      case "auth/invalid-api-key":

        return (
          "Firebase API configuration is invalid."
        );


      case "auth/operation-not-allowed":

        return (
          "Password reset is not enabled in " +
          "Firebase Authentication."
        );


      default:

        return (
          error.code +
          ": " +
          error.message
        );

    }

  }


  /* =====================================================
     SUBMIT
  ===================================================== */

  form.addEventListener(
    "submit",
    async function(event){

      event.preventDefault();

      clearMessages();


      const email =
        emailInput.value.trim();


      /* =========================
         VALIDATION
      ========================= */

      if(!email){

        showError(
          "Please enter your email address."
        );

        emailInput.focus();

        return;
      }


      if(
        !email.includes("@") ||
        !email.includes(".")
      ){

        showError(
          "Please enter a valid email address."
        );

        emailInput.focus();

        return;
      }


      setLoading(true);


      try{

        await sendPasswordResetEmail(
          auth,
          email
        );


        showSuccess(
          "Password reset email sent successfully. " +
          "Please check your inbox or spam folder."
        );


        form.reset();


      }catch(error){

        showError(
          getErrorMessage(error)
        );

      }finally{

        setLoading(false);

      }

    }
  );


  /* =====================================================
     URL EMAIL PREFILL
     
     Example:
     forgot-password.html?email=user@example.com
  ===================================================== */

  const params =
    new URLSearchParams(
      window.location.search
    );

  const emailFromUrl =
    params.get("email");


  if(emailFromUrl){

    emailInput.value =
      emailFromUrl;

  }


  /* =====================================================
     CLEAR ERROR WHEN TYPING
  ===================================================== */

  emailInput.addEventListener(
    "input",
    function(){

      if(
        errorMessage.classList.contains(
          "show"
        )
      ){

        clearMessages();

      }

    }
  );


  console.log(
    "LetsStudy Pro Forgot Password initialized."
  );

</script>


