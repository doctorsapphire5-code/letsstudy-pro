
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#102b55">
<title>Forgot Password | LetsStudy Pro</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f3f6fb;
  color:#17243a;
}
header{
  background:#102b55;
  color:white;
  padding:20px;
}
header h2{margin:0;font-size:21px}
header p{margin:6px 0 0;color:#d8e5fa;font-size:13px}
.container{max-width:480px;width:92%;margin:55px auto}
.card{
  background:white;
  padding:28px;
  border-radius:15px;
  box-shadow:0 5px 25px #17243a0c;
}
.icon{
  width:65px;height:65px;
  border-radius:50%;
  background:#eaf1ff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:29px;
  margin-bottom:20px;
}
h1{font-size:25px;margin:0 0 10px}
.subtitle{font-size:14px;color:#64748b;line-height:1.7}
label{
  display:block;
  font-size:13px;
  font-weight:bold;
  margin:22px 0 8px;
}
input{
  width:100%;
  padding:14px;
  border:1px solid #d5deeb;
  border-radius:8px;
  font-size:14px;
  outline:none;
}
input:focus{border-color:#185adb}
button{
  width:100%;
  border:0;
  padding:14px;
  border-radius:8px;
  background:#185adb;
  color:white;
  font-size:14px;
  font-weight:bold;
  cursor:pointer;
  margin-top:20px;
}
button:disabled{opacity:.6;cursor:not-allowed}
.message{
  display:none;
  padding:13px;
  border-radius:8px;
  margin-top:17px;
  font-size:13px;
  line-height:1.6;
}
.success{display:block;background:#e8f8ef;color:#176b3a}
.error{display:block;background:#fff0f0;color:#a32020}
.links{
  text-align:center;
  margin-top:22px;
  font-size:13px;
  line-height:2;
}
a{color:#185adb;text-decoration:none}
footer{text-align:center;padding:25px;color:#718096;font-size:12px}
</style>
</head>

<body>

<header>
<h2>LetsStudy Pro</h2>
<p>Learn. Build. Work. Grow.</p>
</header>

<main class="container">
<section class="card">

<div class="icon">🔐</div>

<h1>Forgot Password?</h1>

<p class="subtitle">
Don't worry. Enter the email address associated with your account.
We will send you instructions to reset your password.
</p>

<form id="forgotForm">

<label for="email">Email Address</label>
<input
  type="email"
  id="email"
  placeholder="Enter your registered email"
  autocomplete="email"
  required
  maxlength="150"
>

<button type="submit" id="submitBtn">
Send Reset Link
</button>

<div id="message" class="message" role="status"></div>

</form>

<div class="links">
<a href="login.html">Back to Login</a>
<br>
<a href="register.html">Create an Account</a>
<br>
<a href="index.html">Home</a>
</div>

</section>
</main>

<footer>
© <span id="year"></span> LetsStudy Pro. All rights reserved.
</footer>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>

<script>
const firebaseConfig = {
  apiKey: "AIzaSyBcOYDfAVKXbKXjsyRgI_0rjodBn678tCc",
  authDomain: "let-s-study-pro-course.firebaseapp.com",
  databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
  projectId: "let-s-study-pro-course",
  storageBucket: "let-s-study-pro-course.firebasestorage.app",
  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
};

if(!firebase.apps.length){
  firebase.initializeApp(firebaseConfig);
}

const auth = firebase.auth();

const $ = id => document.getElementById(id);

function showMessage(text,type){
  $("message").textContent = text;
  $("message").className = "message " + type;
}

$("forgotForm").addEventListener("submit",async event=>{
  event.preventDefault();

  const email = $("email").value.trim().toLowerCase();

  if(!email){
    showMessage("Please enter your email address.","error");
    return;
  }

  const button = $("submitBtn");
  button.disabled = true;
  button.textContent = "Sending...";

  try{
    await auth.sendPasswordResetEmail(email);

    // Generic response avoids revealing whether an email is registered.
    showMessage(
      "If an account exists for this email, a password reset link has been sent. Check your inbox and spam folder.",
      "success"
    );

    $("forgotForm").reset();

  }catch(error){
    console.error("Password reset error:",error);

    if(error.code === "auth/too-many-requests"){
      showMessage("Too many requests. Please wait and try again later.","error");
    }else if(error.code === "auth/network-request-failed"){
      showMessage("Network error. Check your internet connection.","error");
    }else if(error.code === "auth/invalid-email"){
      showMessage("Please enter a valid email address.","error");
    }else{
      showMessage(
        "We could not process your request right now. Please try again later.",
        "error"
      );
    }
  }finally{
    button.disabled = false;
    button.textContent = "Send Reset Link";
  }
});

$("year").textContent = new Date().getFullYear();
</script>

</body>
</html>
