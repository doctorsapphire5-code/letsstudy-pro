</style>

</head>


<body>


<!-- =========================
     NAVBAR
========================= -->

<header class="navbar">

<div class="nav-container">

<a href="/" class="logo">

<div class="logo-icon">
LS
</div>

LetsStudy Pro

</a>


<nav class="nav-links">

<a href="/">
Home
</a>

<a href="/courses.html">
Courses
</a>

<a href="/login.html">
Login
</a>

</nav>

</div>

</header>



<!-- =========================
     MAIN
========================= -->

<main>

<section class="card">


<!-- FORM -->

<div id="formBox">


<div class="icon">
🔐
</div>


<div class="header">

<h1>
Forgot Password?
</h1>

<p>
Enter the email address connected to your
