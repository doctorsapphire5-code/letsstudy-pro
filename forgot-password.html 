}


/* =========================
   FORM
========================= */

.form-group{

  margin-bottom:16px;

}

label{

  display:block;

  margin-bottom:7px;

  font-size:12px;

  font-weight:800;

}

input{

  width:100%;

  padding:13px;

  border:
  1px solid #cbd5e1;

  border-radius:9px;

  outline:none;

  font-size:13px;

  background:#fff;

}

input:focus{

  border-color:#2563eb;

  box-shadow:
