<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Freelancer Checkout | LetsStudy Pro</title>

<meta name="description"
content="Complete your freelancer service booking on LetsStudy Pro.">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
*{box-sizing:border-box}

body{
 margin:0;
 background:#f6f8fb;
 color:#172033;
 font-family:Inter,Arial,sans-serif
}

a{
 text-decoration:none;
 color:inherit
}

.top{
 height:64px;
 background:#fff;
 border-bottom:1px solid #e5e7eb;
 display:flex;
 align-items:center;
 justify-content:space-between;
 padding:0 6%;
 position:sticky;
 top:0;
 z-index:20
}

.logo{
 color:#155eef;
 font-size:21px;
 font-weight:800
}

.nav{
 display:flex;
 gap:18px;
 font-size:13px;
 font-weight:700
}

.container{
 max-width:1050px;
 margin:30px auto;
 padding:0 20px
}

.title{
 margin-bottom:20px
}

.title h1{
 margin:0 0 7px;
 font-size:30px
}

.title p{
 margin:0;
 color:#667085;
 font-size:13px
}

.layout{
 display:grid;
 grid-template-columns:1.5fr 1fr;
 gap:20px
}

.card{
 background:#fff;
 border:1px solid #e5e7eb;
 border-radius:16px;
 padding:20px
}

.freelancer{
 display:flex;
 gap:15px;
 align-items:center;
 padding-bottom:18px;
 border-bottom:1px solid #eef0f3
}

.avatar{
 width:65px;
 height:65px;
 border-radius:50%;
 object-fit:cover;
 background:#eef2f6
}

.name{
 font-size:19px;
 font-weight:800;
 margin-bottom:5px
}

.headline{
 color:#667085;
 font-size:12px
}

.verified{
 color:#027a48;
 font-size:11px;
 font-weight:700;
 margin-top:5px
}

.info{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:10px;
 margin-top:18px
}

.info-box{
 background:#f8fafc;
 border-radius:10px;
 padding:12px
}

.label{
 display:block;
 color:#667085;
 font-size:10px;
 margin-bottom:5px
}

.value{
 font-size:14px;
 font-weight:800
}

.form-group{
 margin-bottom:15px
}

label{
 display:block;
 font-size:12px;
 font-weight:700;
 margin-bottom:7px
}

input,
textarea,
select{
 width:100%;
 padding:12px;
 border:1px solid #d9dee8;
 border-radius:9px;
 outline:none;
 font-family:inherit
}

textarea{
 min-height:110px;
 resize:vertical
}

.summary-title{
 font-size:17px;
 font-weight:800;
 margin-bottom:15px
}

.row{
 display:flex;
 justify-content:space-between;
 gap:15px;
 margin:12px 0;
 font-size:13px
}

.row span:first-child{
 color:#667085
}

.total{
 border-top:1px solid #e5e7eb;
 margin-top:18px;
 padding-top:18px;
 display:flex;
 justify-content:space-between;
 font-size:19px;
 font-weight:800
}

.btn{
 width:100%;
 border:0;
 padding:13px;
 border-radius:9px;
 background:#155eef;
 color:#fff;
 font-size:13px;
 font-weight:800;
 cursor:pointer;
 margin-top:18px
}

.btn:disabled{
 opacity:.6;
 cursor:not-allowed
}

.secure{
 text-align:center;
 color:#667085;
 font-size:10px;
 margin-top:12px
}

.loading{
 text-align:center;
 padding:70px 20px;
 color:#667085
}

.error{
 background:#fff;
 border:1px solid #fecdca;
 color:#b42318;
 border-radius:12px;
 padding:25px;
 text-align:center
}

@media(max-width:750px){

 .layout{
  grid-template-columns:1fr
 }

 .nav{
  display:none
 }

 .title h1{
  font-size:25px
 }

 .info{
  grid-template-columns:1fr
 }

}
</style>
</head>

<body>

<header class="top">

<a href="freelance.html" class="logo">
LetsStudy Pro
</a>

<nav class="nav">

<a href="course.html">Courses</a>
<a href="marketplace.html">Marketplace</a>
<a href="freelance.html">Freelancers</a>
<a href="careers.html">Careers</a>

</nav>

</header>


<main class="container">

<div class="title">

<h1>Freelancer Checkout</h1>

<p>
Review freelancer information and submit your project request.
</p>

</div>


<div id="page">

<div class="loading">

<i class="fa fa-spinner fa-spin"></i>

<p>Loading freelancer...</p>

</div>

</div>

</main>


<script type="module">

import {
 initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

import {
 getFirestore,
 doc,
 getDoc
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


/* =========================
FIREBASE
========================= */

const firebaseConfig={

 apiKey:
 "AIzaSyBcOYDfAVKXbkljsYrgI_0rjodBn678tCc",

 authDomain:
 "let-s-study-pro-course.firebaseapp.com",

 databaseURL:
 "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

 projectId:
 "let-s-study-pro-course",

 storageBucket:
 "let-s-study-pro-course.firebasestorage.app",

 messagingSenderId:
 "474928293390",

 appId:
 "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

 measurementId:
 "G-85B7V5H5J0"

};


const app=
initializeApp(firebaseConfig);

const db=
getFirestore(app);


/* =========================
DOM
========================= */

const page=
document.getElementById("page");


/* =========================
ESCAPE
========================= */

function esc(value=""){

 return String(value)
 .replace(/&/g,"&amp;")
 .replace(/</g,"&lt;")
 .replace(/>/g,"&gt;")
 .replace(/"/g,"&quot;")
 .replace(/'/g,"&#039;");

}


/* =========================
URL
========================= */

const params=
new URLSearchParams(
 window.location.search
);

const freelancerId=
params.get("id");


/* =========================
LOAD FREELANCER
========================= */

async function loadFreelancer(){

 if(!freelancerId){

  showError(
   "Freelancer ID is missing."
  );

  return;

 }


 try{

  const ref=
   doc(
    db,
    "freelancers",
    freelancerId
   );


  const snap=
   await getDoc(ref);


  if(!snap.exists()){

   showError(
    "Freelancer not found."
   );

   return;

  }


  const f=
   snap.data();


  if(
   f.status &&
   f.status!=="published"
  ){

   showError(
    "This freelancer is currently unavailable."
   );

   return;

  }


  render(f);


 }catch(error){

  console.error(error);

  showError(
   "Unable to load freelancer information."
  );

 }

}


/* =========================
ERROR
========================= */

function showError(message){

 page.innerHTML=`

 <div class="error">

  <i class="fa fa-triangle-exclamation"></i>

  <h3>
   ${esc(message)}
  </h3>

  <a
   href="freelance.html"
   style="
    display:inline-block;
    margin-top:10px;
    color:#155eef;
    font-weight:700
   ">

   Back to Freelancers

  </a>

 </div>

 `;

}


/* =========================
RENDER
========================= */

function render(f){

 const name=
  f.name||
  f.username||
  "Freelancer";


 const currency=
  f.currency||
  "TZS";


 const rate=
  Number(
   f.hourlyRate||0
  );


 const rating=
  Number(
   f.rating||0
  );


 const ratingCount=
  Number(
   f.ratingCount||0
  );


 const avatar=
  f.profileImage||
  "https://via.placeholder.com/100?text=F";


 const location=
  [
   f.city,
   f.region,
   f.country
  ]
  .filter(Boolean)
  .join(", ")||
  "Not specified";


 page.innerHTML=`

 <div class="layout">


  <!-- LEFT -->

  <section class="card">

   <div class="freelancer">

    <img
     class="avatar"
     src="${esc(avatar)}"
     alt="${esc(name)}">

    <div>

     <div class="name">

      ${esc(name)}

     </div>

     <div class="headline">

      ${esc(
       f.headline||
       "Professional Freelancer"
      )}

     </div>


     ${
      f.verified
      ?
      `
      <div class="verified">

       <i class="fa fa-circle-check"></i>

       Verified Freelancer

      </div>
      `
      :
      ""
     }

    </div>

   </div>


   <div class="info">


    <div class="info-box">

     <span class="label">
      Hourly Rate
     </span>

     <span class="value">

      ${esc(currency)}
      ${rate.toLocaleString()}

     </span>

    </div>


    <div class="info-box">

     <span class="label">
      Rating
     </span>

     <span class="value">

      ★ ${rating.toFixed(1)}
      (${ratingCount})

     </span>

    </div>


    <div class="info-box">

     <span class="label">
      Location
     </span>

     <span class="value">

      ${esc(location)}

     </span>

    </div>


    <div class="info-box">

     <span class="label">
      Availability
     </span>

     <span class="value">

      ${esc(
       f.availability||
       "Available"
      )}

     </span>

    </div>


    <div class="info-box">

     <span class="label">
      Experience
     </span>

     <span class="value">

      ${esc(
       f.experienceLevel||
       "Professional"
      )}

     </span>

    </div>


    <div class="info-box">

     <span class="label">
      Response Time
     </span>

     <span class="value">

      ${esc(
       f.responseTime||
       "Flexible"
      )}

     </span>

    </div>

   </div>


   <div
    style="
     margin-top:20px;
     font-size:13px;
     line-height:1.7;
     color:#667085
    ">

    ${esc(
     f.bio||
     "Professional freelancer available for project work."
    )}

   </div>

  </section>


  <!-- RIGHT -->

  <section class="card">

   <div class="summary-title">

    Project Details

   </div>


   <form id="checkoutForm">


    <div class="form-group">

     <label>
      Project Title
     </label>

     <input
      id="projectTitle"
      required
      placeholder="e.g. Website design">

    </div>


    <div class="form-group">

     <label>
      Describe Your Project
     </label>

     <textarea
      id="description"
      required
      placeholder="Tell the freelancer what you need..."></textarea>

    </div>


    <div class="form-group">

     <label>
      Estimated Hours
     </label>

     <input
      id="hours"
      type="number"
      min="1"
      value="1"
      required>

    </div>


    <div class="form-group">

     <label>
      Deadline
     </label>

     <input
      id="deadline"
      type="date"
      required>

    </div>


    <div class="row">

     <span>
      Freelancer
     </span>

     <strong>
      ${esc(name)}
     </strong>

    </div>


    <div class="row">

     <span>
      Rate
     </span>

     <strong id="rate">

      ${esc(currency)}
      ${rate.toLocaleString()}/hr

     </strong>

    </div>


    <div class="row">

     <span>
      Hours
     </span>

     <strong id="hoursDisplay">
      1
     </strong>

    </div>


    <div class="total">

     <span>
      Total
     </span>

     <span id="total">

      ${esc(currency)}
      ${rate.toLocaleString()}

     </span>

    </div>


    <button
     class="btn"
     id="continueBtn"
     type="submit">

     Continue to Payment
     <i class="fa fa-arrow-right"></i>

    </button>


    <div class="secure">

     <i class="fa fa-lock"></i>

     Your project information is securely processed.

    </div>


   </form>

  </section>

 </div>

 `;


 const hoursInput=
  document.getElementById("hours");

 const hoursDisplay=
  document.getElementById("hoursDisplay");

 const total=
  document.getElementById("total");


 function updateTotal(){

  let hours=
   Number(
    hoursInput.value
   )||1;


  if(hours<1){

   hours=1;

   hoursInput.value=1;

  }


  hoursDisplay.textContent=
   hours;


  total.textContent=
   `${currency} ${
    (rate*hours)
    .toLocaleString()
   }`;

 }


 hoursInput.addEventListener(
  "input",
  updateTotal
 );


 document
  .getElementById("checkoutForm")
  .addEventListener(
   "submit",
   function(event){

    event.preventDefault();


    const hours=
     Number(
      hoursInput.value
     )||1;


    const amount=
     rate*hours;


    const projectTitle=
     document
      .getElementById("projectTitle")
      .value
      .trim();


    const description=
     document
      .getElementById("description")
      .value
      .trim();


    const deadline=
     document
      .getElementById("deadline")
      .value;


    if(!projectTitle||
       !description||
       !deadline){

     return;

    }


    /*
     SEND ALL REQUIRED INFORMATION
     TO PAYMENT PAGE
    */

    const checkoutData={

     type:"freelancer",

     freelancerId:

      freelancerId,

     freelancerName:

      name,

     freelancerUsername:

      f.username||"",

     currency:

      currency,

     hourlyRate:

      rate,

     hours:

      hours,

     amount:

      amount,

     projectTitle:

      projectTitle,

     description:

      description,

     deadline:

      deadline

    };


    sessionStorage.setItem(

     "freelancerCheckout",

     JSON.stringify(
      checkoutData
     )

    );


    window.location.href=
     `payment.html?type=freelancer&freelancerId=${encodeURIComponent(freelancerId)}`;

   }

  );

}


/* =========================
START
========================= */

loadFreelancer();

</script>

</body>
</html>