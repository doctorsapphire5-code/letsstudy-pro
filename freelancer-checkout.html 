<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>

<title>Freelance Checkout | LetsStudy Pro</title>

<meta
  name="description"
  content="Checkout for freelance services on LetsStudy Pro."
>

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
}

header{
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  padding:15px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo{
  font-size:21px;
  font-weight:800;
}

.logo span{
  color:#2563eb;
}

.back{
  border:0;
  background:#eef2f7;
  padding:10px 15px;
  border-radius:8px;
  cursor:pointer;
}

.container{
  width:92%;
  max-width:900px;
  margin:30px auto;
}

.checkout{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
}

.card{
  background:#fff;
  padding:22px;
  border-radius:16px;
  box-shadow:0 5px 25px #0000000a;
}

h1{
  font-size:26px;
  margin-bottom:8px;
}

h2{
  font-size:19px;
  margin-bottom:15px;
}

.muted{
  color:#64748b;
  line-height:1.6;
}

.freelancer{
  display:flex;
  gap:12px;
  align-items:center;
  margin:18px 0;
  padding-bottom:18px;
  border-bottom:1px solid #e5e7eb;
}

.avatar{
  width:55px;
  height:55px;
  border-radius:50%;
  background:#2563eb;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
  overflow:hidden;
  flex-shrink:0;
}

.avatar img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.name{
  font-weight:700;
}

.title{
  color:#64748b;
  font-size:13px;
  margin-top:4px;
}

.field{
  margin-bottom:15px;
}

.field label{
  display:block;
  font-size:13px;
  font-weight:700;
  margin-bottom:6px;
}

.field input,
.field textarea,
.field select{
  width:100%;
  padding:12px;
  border:1px solid #dbe2ea;
  border-radius:8px;
  outline:none;
  font:inherit;
}

.field input:focus,
.field textarea:focus,
.field select:focus{
  border-color:#2563eb;
}

.field textarea{
  min-height:110px;
  resize:vertical;
}

.summary{
  display:flex;
  justify-content:space-between;
  gap:15px;
  padding:10px 0;
  border-bottom:1px solid #edf0f4;
}

.summary strong{
  text-align:right;
  word-break:break-word;
}

.total{
  display:flex;
  justify-content:space-between;
  font-size:20px;
  font-weight:800;
  margin-top:16px;
}

.submit{
  width:100%;
  margin-top:20px;
  border:0;
  background:#2563eb;
  color:#fff;
  padding:13px;
  border-radius:9px;
  font-size:15px;
  font-weight:700;
  cursor:pointer;
}

.submit:disabled{
  opacity:.6;
  cursor:not-allowed;
}

.message{
  display:none;
  padding:12px;
  border-radius:8px;
  margin-bottom:15px;
  line-height:1.5;
}

.message.show{
  display:block;
}

.success{
  background:#dcfce7;
  color:#166534;
}

.error{
  background:#fee2e2;
  color:#991b1b;
}

.loading{
  text-align:center;
  padding:50px;
  color:#64748b;
}

.quote{
  color:#64748b;
  font-weight:600;
}

@media(max-width:700px){

  .checkout{
    grid-template-columns:1fr;
  }

  .container{
    margin:20px auto;
  }

  .card{
    padding:18px;
  }

}

</style>

</head>

<body>


<header>

  <div class="logo">
    LetsStudy <span>Pro</span>
  </div>

  <button
    class="back"
    type="button"
    onclick="history.back()"
  >
    Back
  </button>

</header>


<main class="container">

  <div
    id="loading"
    class="card loading"
  >
    Loading checkout...
  </div>


  <div
    id="checkout"
    class="checkout"
    style="display:none;"
  >

    <!-- =========================================
         SERVICE
    ========================================== -->

    <section class="card">

      <h1>
        Freelance Checkout
      </h1>

      <p class="muted">
        Send your project request and continue
        securely to payment.
      </p>


      <div
        id="freelancer"
        class="freelancer"
      ></div>


      <div
        id="message"
        class="message"
      ></div>


      <form id="checkoutForm">


        <div class="field">

          <label for="customerName">
            Your Name
          </label>

          <input
            id="customerName"
            type="text"
            required
            maxlength="100"
            autocomplete="name"
            placeholder="Enter your name"
          >

        </div>


        <div class="field">

          <label for="customerEmail">
            Email
          </label>

          <input
            id="customerEmail"
            type="email"
            required
            maxlength="150"
            autocomplete="email"
            placeholder="you@example.com"
          >

        </div>


        <div class="field">

          <label for="service">
            Service
          </label>

          <input
            id="service"
            type="text"
            required
            maxlength="150"
            placeholder="What do you need?"
          >

        </div>


        <div class="field">

          <label for="details">
            Project Details
          </label>

          <textarea
            id="details"
            required
            maxlength="2000"
            placeholder="Describe your project..."
          ></textarea>

        </div>


        <div class="field">

          <label for="paymentMethod">
            Payment Method
          </label>

          <select
            id="paymentMethod"
            required
          >

            <option value="">
              Select payment method
            </option>

            <option value="pesapal">
              Pay securely with Pesapal
            </option>

          </select>

        </div>


        <button
          id="submitButton"
          class="submit"
          type="submit"
        >
          Continue to Payment
        </button>

      </form>

    </section>


    <!-- =========================================
         SUMMARY
    ========================================== -->

    <aside class="card">

      <h2>
        Order Summary
      </h2>


      <div class="summary">

        <span>
          Freelancer
        </span>

        <strong id="summaryName">
          —
        </strong>

      </div>


      <div class="summary">

        <span>
          Service
        </span>

        <strong id="summaryService">
          —
        </strong>

      </div>


      <div class="summary">

        <span>
          Rate
        </span>

        <strong id="summaryRate">
          —
        </strong>

      </div>


      <div class="total">

        <span>
          Total
        </span>

        <span id="total">
          —
        </span>

      </div>


      <p
        class="muted"
        style="margin-top:18px;font-size:13px;"
      >
        Payment is processed securely through
        Pesapal. Your freelance order will be
        created before payment.
      </p>

    </aside>

  </div>

</main>


<script>

"use strict";


/* =====================================================
   CONFIGURATION
===================================================== */

const PAYMENT_API =
  "https://api.letsstudy.pro";


/* =====================================================
   URL PARAMETERS
===================================================== */

const params =
  new URLSearchParams(
    window.location.search
  );


const freelancerId =
  params.get("id") ||
  params.get("freelancerId") ||
  params.get("documentId") ||
  "";


/* =====================================================
   ELEMENTS
===================================================== */

const loading =
  document.getElementById(
    "loading"
  );

const checkout =
  document.getElementById(
    "checkout"
  );

const freelancerBox =
  document.getElementById(
    "freelancer"
  );

const form =
  document.getElementById(
    "checkoutForm"
  );

const message =
  document.getElementById(
    "message"
  );

const submitButton =
  document.getElementById(
    "submitButton"
  );


let freelancerData = null;


/* =====================================================
   VALIDATE
===================================================== */

if(!freelancerId){

  showError(
    "No freelancer was selected."
  );

}else{

  loadFreelancer();

}


/* =====================================================
   LOAD FREELANCER
===================================================== */

async function loadFreelancer(){

  try{

    const response =
      await fetch(
        "/api/data?collection=freelancers&id=" +
        encodeURIComponent(
          freelancerId
        )
      );


    const result =
      await response.json();


    if(!response.ok){

      throw new Error(
        result.error ||
        "Unable to load freelancer."
      );

    }


    if(!result.data){

      throw new Error(
        "Freelancer not found."
      );

    }


    freelancerData =
      result.data;


    renderFreelancer(
      freelancerData
    );


    loading.style.display =
      "none";

    checkout.style.display =
      "grid";


  }catch(error){

    console.error(
      "LOAD FREELANCER:",
      error
    );

    showError(
      error.message ||
      "Unable to load freelancer."
    );

  }

}


/* =====================================================
   GET FREELANCER NAME
===================================================== */

function getFreelancerName(){

  return (
    freelancerData?.name ||
    freelancerData?.displayName ||
    freelancerData?.username ||
    "Freelancer"
  );

}


/* =====================================================
   GET SERVICE NAME
===================================================== */

function getServiceName(){

  return (
    freelancerData?.service ||
    freelancerData?.title ||
    freelancerData?.serviceName ||
    freelancerData?.category ||
    "Freelance Service"
  );

}


/* =====================================================
   GET PRICE
===================================================== */

function getPrice(){

  const possiblePrices = [

    freelancerData?.price,

    freelancerData?.amount,

    freelancerData?.rate,

    freelancerData?.hourlyRate,

    freelancerData?.startingPrice,

    freelancerData?.startingRate,

    freelancerData?.packagePrice

  ];


  for(
    const value of possiblePrices
  ){

    if(
      value !== null &&
      value !== undefined &&
      value !== "" &&
      !Number.isNaN(
        Number(value)
      )
    ){

      const number =
        Number(value);


      if(number >= 0){

        return number;

      }

    }

  }


  return null;

}


/* =====================================================
   GET CURRENCY
===================================================== */

function getCurrency(){

  return (
    freelancerData?.currency ||
    "TZS"
  );

}


/* =====================================================
   FORMAT MONEY
===================================================== */

function formatMoney(
  amount,
  currency
){

  if(
    amount === null ||
    amount === undefined ||
    amount === ""
  ){

    return "Quote";

  }


  try{

    return new Intl.NumberFormat(
      "en-TZ",
      {
        style:"currency",
        currency:currency || "TZS",
        maximumFractionDigits:2
      }
    ).format(
      Number(amount)
    );

  }catch(error){

    return (
      Number(amount).toLocaleString() +
      " " +
      (currency || "TZS")
    );

  }

}


/* =====================================================
   RENDER FREELANCER
===================================================== */

function renderFreelancer(
  data
){

  const name =
    getFreelancerName();


  const title =
    getServiceName();


  const rate =
    getPrice();


  const currency =
    getCurrency();


  const photo =
    safeImage(
      data.photoURL ||
      data.photo ||
      data.avatar ||
      data.profileImage ||
      data.image
    );


  const initial =
    String(name)
      .trim()
      .charAt(0)
      .toUpperCase() ||
    "F";


  freelancerBox.innerHTML = `

    <div class="avatar">

      ${
        photo
        ?

        `<img
          src="${photo}"
          alt="${escapeAttr(name)}"
        >`

        :

        escapeHTML(initial)
      }

    </div>


    <div>

      <div class="name">

        ${escapeHTML(name)}

      </div>

      <div class="title">

        ${escapeHTML(title)}

      </div>

    </div>

  `;


  document
    .getElementById(
      "summaryName"
    )
    .textContent =
      name;


  document
    .getElementById(
      "summaryService"
    )
    .textContent =
      title;


  document
    .getElementById(
      "summaryRate"
    )
    .textContent =
      formatMoney(
        rate,
        currency
      );


  document
    .getElementById(
      "total"
    )
    .textContent =
      formatMoney(
        rate,
        currency
      );


  document
    .getElementById(
      "service"
    )
    .value =
      title;

}


/* =====================================================
   SUBMIT CHECKOUT
===================================================== */

form.addEventListener(
  "submit",
  async event => {

    event.preventDefault();


    if(!freelancerData){

      return;

    }


    const paymentMethod =
      document
        .getElementById(
          "paymentMethod"
        )
        .value;


    if(
      paymentMethod !==
      "pesapal"
    ){

      showMessage(
        "Please select Pesapal as the payment method.",
        "error"
      );

      return;

    }


    const customerName =
      document
        .getElementById(
          "customerName"
        )
        .value
        .trim();


    const customerEmail =
      document
        .getElementById(
          "customerEmail"
        )
        .value
        .trim();


    const service =
      document
        .getElementById(
          "service"
        )
        .value
        .trim();


    const details =
      document
        .getElementById(
          "details"
        )
        .value
        .trim();


    if(
      !customerName ||
      !customerEmail ||
      !service ||
      !details
    ){

      showMessage(
        "Please complete all required fields.",
        "error"
      );

      return;

    }


    submitButton.disabled =
      true;

    submitButton.textContent =
      "Creating Order...";


    hideMessage();


    const freelancerName =
      getFreelancerName();


    const amount =
      getPrice();


    const currency =
      getCurrency();


    /*
     * If this freelancer has no fixed price,
     * the backend can reject it or handle
     * quote-based orders separately.
     */

    if(
      amount === null ||
      amount <= 0
    ){

      showMessage(
        "This service does not have a payable price yet. Please contact the freelancer for a quote.",
        "error"
      );

      submitButton.disabled =
        false;

      submitButton.textContent =
        "Continue to Payment";

      return;

    }


    try{

      /* =========================================
         CREATE FREELANCE ORDER
      ========================================== */

      const orderResponse =
        await fetch(
          PAYMENT_API +
          "/api/freelance-orders",
          {
            method:"POST",

            headers:{
              "Content-Type":
                "application/json"
            },

            body:JSON.stringify({

              freelancerId,

              freelancerName,

              customerName,

              customerEmail,

              service,

              details,

              paymentMethod,

              amount,

              currency

            })

          }
        );


      const orderResult =
        await orderResponse.json();


      if(!orderResponse.ok){

        throw new Error(
          orderResult.error ||
          "Unable to create freelance order."
        );

      }


      /*
       * Backend may return:
       *
       * orderId
       * merchantReference
       * redirectUrl
       * paymentUrl
       * orderTrackingId
       */

      const orderId =
        orderResult.orderId ||
        orderResult.orderID ||
        orderResult.id ||
        orderResult.order?.orderId ||
        "";


      const merchantReference =
        orderResult.merchantReference ||
        orderResult.merchant_reference ||
        orderResult.order?.merchantReference ||
        "";


      const orderTrackingId =
        orderResult.orderTrackingId ||
        orderResult.OrderTrackingId ||
        orderResult.order?.orderTrackingId ||
        "";


      const redirectUrl =
        orderResult.redirectUrl ||
        orderResult.redirect_url ||
        orderResult.paymentUrl ||
        orderResult.payment_url ||
        orderResult.order?.redirectUrl ||
        "";


      /*
       * We need either a Pesapal URL
       * or a tracking ID that the payment
       * page can resolve.
       */

      if(
        !redirectUrl &&
        !orderTrackingId
      ){

        throw new Error(
          "Payment URL was not returned by the payment server."
        );

      }


      /* =========================================
         SAVE PENDING ORDER
      ========================================== */

      const pendingOrder = {

        orderId,

        freelancerId,

        freelancerName,

        customerName,

        customerEmail,

        service,

        details,

        amount,

        currency,

        paymentMethod,

        merchantReference,

        orderTrackingId,

        redirectUrl,

        createdAt:
          new Date().toISOString()

      };


      try{

        localStorage.setItem(
          "pendingFreelanceOrder",
          JSON.stringify(
            pendingOrder
          )
        );

      }catch(error){

        console.warn(
          "Unable to save pending order:",
          error
        );

      }


      /* =========================================
         GO TO PAYMENT
      ========================================== */

      const paymentParams =
        new URLSearchParams();


      if(orderId){

        paymentParams.set(
          "orderId",
          orderId
        );

      }


      if(orderTrackingId){

        paymentParams.set(
          "orderTrackingId",
          orderTrackingId
        );

      }


      if(merchantReference){

        paymentParams.set(
          "merchantReference",
          merchantReference
        );

      }


      if(redirectUrl){

        paymentParams.set(
          "redirectUrl",
          redirectUrl
        );

      }


      /*
       * Use the universal payment page.
       *
       * If your actual file is:
       * payment.html
       *
       * keep this exactly.
       */

      window.location.href =
        `payment.html?${paymentParams.toString()}`;


    }catch(error){

      console.error(
        "FREELANCE CHECKOUT:",
        error
      );


      showMessage(
        error.message ||
        "Unable to create your payment.",
        "error"
      );


      submitButton.disabled =
        false;

      submitButton.textContent =
        "Continue to Payment";

    }

  }
);


/* =====================================================
   MESSAGE
===================================================== */

function showMessage(
  text,
  type
){

  message.className =
    "message show " +
    type;

  message.textContent =
    text;

}


function hideMessage(){

  message.className =
    "message";

  message.textContent =
    "";

}


/* =====================================================
   ERROR
===================================================== */

function showError(
  text
){

  loading.className =
    "card loading error";

  loading.innerHTML = `

    <h2>
      Checkout unavailable
    </h2>

    <p       style="margin-top:8px;">
      ${escapeHTML(text)}
    </p>

  `;

}


/* ===============================
   SAFE IMAGE
=============================== */

function safeImage(url){

  if(!url) return "";

  try{

    const parsed =
      new URL(
        String(url),
        location.origin
      );

    if(
      parsed.protocol === "https:" ||
      parsed.protocol === "http:"
    ){

      return escapeAttr(
        parsed.href
      );

    }

  }catch(error){

    console.warn(
      "Invalid image URL:",
      error
    );

  }

  return "";

}


/* ===============================
   ESCAPE HTML
=============================== */

function escapeHTML(value){

  return String(
    value ?? ""
  )
  .replace(
    /&/g,
    "&amp;"
  )
  .replace(
    /</g,
    "&lt;"
  )
  .replace(
    />/g,
    "&gt;"
  )
  .replace(
    /"/g,
    "&quot;"
  )
  .replace(
    /'/g,
    "&#039;"
  );

}


/* ===============================
   ESCAPE ATTRIBUTE
=============================== */

function escapeAttr(value){

  return escapeHTML(
    value
  ).replace(
    /`/g,
    "&#096;"
  );

}


/* ===============================
   END
=============================== */

</script>

</body>
</html>