<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Freelance Checkout | LetsStudy Pro</title>

<meta
  name="description"
  content="Checkout for freelance services on LetsStudy Pro."
>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
}

header{
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  padding:15px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo{
  font-size:21px;
  font-weight:800;
}

.logo span{
  color:#2563eb;
}

.back{
  border:0;
  background:#eef2f7;
  padding:10px 15px;
  border-radius:8px;
  cursor:pointer;
}

.container{
  width:92%;
  max-width:900px;
  margin:30px auto;
}

.checkout{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
}

.card{
  background:#fff;
  padding:22px;
  border-radius:16px;
  box-shadow:0 5px 25px #0000000a;
}

h1{
  font-size:26px;
  margin-bottom:8px;
}

h2{
  font-size:19px;
  margin-bottom:15px;
}

.muted{
  color:#64748b;
  line-height:1.6;
}

.freelancer{
  display:flex;
  gap:12px;
  align-items:center;
  margin:18px 0;
  padding-bottom:18px;
  border-bottom:1px solid #e5e7eb;
}

.avatar{
  width:55px;
  height:55px;
  border-radius:50%;
  background:#2563eb;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
  overflow:hidden;
}

.avatar img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.name{
  font-weight:700;
}

.title{
  color:#64748b;
  font-size:13px;
  margin-top:4px;
}

.field{
  margin-bottom:15px;
}

.field label{
  display:block;
  font-size:13px;
  font-weight:700;
  margin-bottom:6px;
}

.field input,
.field textarea,
.field select{
  width:100%;
  padding:12px;
  border:1px solid #dbe2ea;
  border-radius:8px;
  outline:none;
  font:inherit;
}

.field textarea{
  min-height:110px;
  resize:vertical;
}

.summary{
  display:flex;
  justify-content:space-between;
  padding:10px 0;
  border-bottom:1px solid #edf0f4;
}

.total{
  display:flex;
  justify-content:space-between;
  font-size:20px;
  font-weight:800;
  margin-top:16px;
}

.submit{
  width:100%;
  margin-top:20px;
  border:0;
  background:#2563eb;
  color:#fff;
  padding:13px;
  border-radius:9px;
  font-size:15px;
  font-weight:700;
  cursor:pointer;
}

.submit:disabled{
  opacity:.6;
  cursor:not-allowed;
}

.message{
  display:none;
  padding:12px;
  border-radius:8px;
  margin-bottom:15px;
}

.message.show{
  display:block;
}

.success{
  background:#dcfce7;
  color:#166534;
}

.error{
  background:#fee2e2;
  color:#991b1b;
}

.loading{
  text-align:center;
  padding:50px;
  color:#64748b;
}

@media(max-width:700px){

  .checkout{
    grid-template-columns:1fr;
  }

}
</style>
</head>

<body>

<header>

  <div class="logo">
    LetsStudy <span>Pro</span>
  </div>

  <button
    class="back"
    onclick="history.back()"
  >
    Back
  </button>

</header>


<main class="container">

  <div
    id="loading"
    class="card loading"
  >
    Loading checkout...
  </div>


  <div
    id="checkout"
    class="checkout"
    style="display:none;"
  >

    <!-- SERVICE -->

    <section class="card">

      <h1>
        Freelance Checkout
      </h1>

      <p class="muted">
        Send your project request to this freelancer.
      </p>


      <div
        id="freelancer"
        class="freelancer"
      ></div>


      <div
        id="message"
        class="message"
      ></div>


      <form id="checkoutForm">

        <div class="field">

          <label>
            Your Name
          </label>

          <input
            id="customerName"
            type="text"
            required
            maxlength="100"
            placeholder="Enter your name"
          >

        </div>


        <div class="field">

          <label>
            Email
          </label>

          <input
            id="customerEmail"
            type="email"
            required
            maxlength="150"
            placeholder="you@example.com"
          >

        </div>


        <div class="field">

          <label>
            Service
          </label>

          <input
            id="service"
            type="text"
            required
            maxlength="150"
            placeholder="What do you need?"
          >

        </div>


        <div class="field">

          <label>
            Project Details
          </label>

          <textarea
            id="details"
            required
            maxlength="2000"
            placeholder="Describe your project..."
          ></textarea>

        </div>


        <div class="field">

          <label>
            Payment Method
          </label>

          <select
            id="paymentMethod"
            required
          >

            <option value="">
              Select payment method
            </option>

            <option value="pending">
              Pay after request
            </option>

          </select>

        </div>


        <button
          id="submitButton"
          class="submit"
          type="submit"
        >
          Send Request
        </button>

      </form>

    </section>


    <!-- SUMMARY -->

    <aside class="card">

      <h2>
        Order Summary
      </h2>


      <div class="summary">

        <span>
          Freelancer
        </span>

        <strong id="summaryName">
          —
        </strong>

      </div>


      <div class="summary">

        <span>
          Service
        </span>

        <strong id="summaryService">
          —
        </strong>

      </div>


      <div class="summary">

        <span>
          Rate
        </span>

        <strong id="summaryRate">
          —
        </strong>

      </div>


      <div class="total">

        <span>
          Total
        </span>

        <span id="total">
          —
        </span>

      </div>


      <p
        class="muted"
        style="margin-top:18px;font-size:13px;"
      >
        Your request will be submitted securely.
        Payment processing can be connected to
        your preferred payment provider.
      </p>

    </aside>

  </div>

</main>


<script>

/*
==================================================
FREELANCE-CHECKOUT.HTML

PUBLIC CHECKOUT

LOAD:
GET /api/data?collection=freelancers&id=ID

ORDER:
POST /api/freelance-orders

Expected order payload:

{
  freelancerId,
  freelancerName,
  customerName,
  customerEmail,
  service,
  details,
  paymentMethod,
  amount,
  currency
}

IMPORTANT:
The API must validate the amount server-side.
Never trust the browser price.

ADMIN:
NOT USED
==================================================
*/


const params =
  new URLSearchParams(
    location.search
  );


const freelancerId =
  params.get("id") ||
  params.get("freelancerId") ||
  params.get("documentId");


const loading =
  document.getElementById(
    "loading"
  );

const checkout =
  document.getElementById(
    "checkout"
  );

const freelancerBox =
  document.getElementById(
    "freelancer"
  );

const form =
  document.getElementById(
    "checkoutForm"
  );

const message =
  document.getElementById(
    "message"
  );

const submitButton =
  document.getElementById(
    "submitButton"
  );


let freelancerData = null;


/* =========================
   VALIDATE
========================= */

if(!freelancerId){

  showError(
    "No freelancer was selected."
  );

}else{

  loadFreelancer();

}


/* =========================
   LOAD FREELANCER
========================= */

async function loadFreelancer(){

  try{

    const response =
      await fetch(
        "/api/data?collection=freelancers&id=" +
        encodeURIComponent(
          freelancerId
        )
      );


    const result =
      await response.json();


    if(!response.ok){

      throw new Error(
        result.error ||
        "Unable to load freelancer."
      );

    }


    if(!result.data){

      throw new Error(
        "Freelancer not found."
      );

    }


    freelancerData =
      result.data;


    renderFreelancer(
      freelancerData
    );


    loading.style.display =
      "none";

    checkout.style.display =
      "grid";


  }catch(error){

    showError(
      error.message
    );

  }

}


/* =========================
   RENDER
========================= */

function renderFreelancer(
  data
){

  const name =
    data.name ||
    data.displayName ||
    data.username ||
    "Freelancer";


  const title =
    data.title ||
    data.service ||
    data.category ||
    "Freelance Service";


  const rate =
    data.price ||
    data.rate ||
    data.hourlyRate ||
    "";


  const photo =
    safeImage(
      data.photoURL ||
      data.photo ||
      data.avatar
    );


  const initial =
    String(name)
      .trim()
      .charAt(0)
      .toUpperCase() ||
    "F";


  freelancerBox.innerHTML = `

    <div class="avatar">

      ${
        photo
        ? `

          <img
            src="${photo}"
            alt="${escapeAttr(name)}"
          >

        `
        : escapeHTML(initial)
      }

    </div>


    <div>

      <div class="name">

        ${escapeHTML(name)}

      </div>

      <div class="title">

        ${escapeHTML(title)}

      </div>

    </div>

  `;


  document
    .getElementById(
      "summaryName"
    )
    .textContent =
      name;


  document
    .getElementById(
      "summaryService"
    )
    .textContent =
      title;


  document
    .getElementById(
      "summaryRate"
    )
    .textContent =
      rate || "Quote";


  document
    .getElementById(
      "total"
    )
    .textContent =
      rate || "Quote";


  document
    .getElementById(
      "service"
    )
    .value =
      title;

}


/* =========================
   SUBMIT
========================= */

form.addEventListener(
  "submit",
  async event => {

    event.preventDefault();


    if(!freelancerData){

      return;

    }


    submitButton.disabled =
      true;

    submitButton.textContent =
      "Sending...";


    hideMessage();


    const name =
      document
        .getElementById(
          "customerName"
        )
        .value
        .trim();


    const email =
      document
        .getElementById(
          "customerEmail"
        )
        .value
        .trim();


    const service =
      document
        .getElementById(
          "service"
        )
        .value
        .trim();


    const details =
      document
        .getElementById(
          "details"
        )
        .value
        .trim();


    const paymentMethod =
      document
        .getElementById(
          "paymentMethod"
        )
        .value;


    const freelancerName =
      freelancerData.name ||
      freelancerData.displayName ||
      freelancerData.username ||
      "Freelancer";


    const amount =
      freelancerData.price ||
      freelancerData.rate ||
      freelancerData.hourlyRate ||
      null;


    try{

      const response =
        await fetch(
          "/api/freelance-orders",
          {
            method:"POST",

            headers:{
              "Content-Type":
                "application/json"
            },

            body:JSON.stringify({

              freelancerId,

              freelancerName,

              customerName:name,

              customerEmail:email,

              service,

              details,

              paymentMethod,

              amount,

              currency:
                freelancerData.currency ||
                "TZS"

            })

          }
        );


      const result =
        await response.json();


      if(!response.ok){

        throw new Error(
          result.error ||
          "Unable to submit request."
        );

      }


      showMessage(
        "Your freelance request was submitted successfully.",
        "success"
      );


      form.reset();


      document
        .getElementById(
          "service"
        )
        .value =
          service;


      submitButton.textContent =
        "Request Sent";


    }catch(error){

      console.error(
        "FREELANCE CHECKOUT:",
        error
      );


      showMessage(
        error.message ||
        "Unable to submit request.",
        "error"
      );


      submitButton.disabled =
        false;

      submitButton.textContent =
        "Send Request";

    }

  }
);


/* =========================
   MESSAGE
========================= */

function showMessage(
  text,
  type
){

  message.className =
    "message show " +
    type;

  message.textContent =
    text;

}


function hideMessage(){

  message.className =
    "message";

  message.textContent =
    "";

}


/* =========================
   ERROR
========================= */

function showError(
  text
){

  loading.className =
    "card loading error";

  loading.innerHTML = `

    <h2>
      Checkout unavailable
    </h2>

    <p style="margin-top:8px;">
      ${escapeHTML(text)}
    </p>

  `;

}


/* =========================
   SECURITY
========================= */

function safeImage(url){

  if(!url) return "";


  try{

    const parsed =
      new URL(
        String(url),
        location.origin
      );


    if(
      parsed.protocol === "https:" ||
      parsed.protocol === "http:"
    ){

      return escapeAttr(
        parsed.href
      );

    }

  }catch(error){}


  return "";

}


function escapeHTML(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


function escapeAttr(value){

  return escapeHTML(value)
    .replace(/`/g,"&#096;");

}

</script>

</body>
</html>