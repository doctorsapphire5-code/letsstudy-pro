<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>

<title>Freelance Checkout | LetsStudy Pro</title>

<meta
  name="description"
  content="Checkout for freelance services on LetsStudy Pro."
>

<link rel="icon" href="favicon.ico">

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
}

header{
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  padding:15px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo{
  font-size:21px;
  font-weight:800;
}

.logo span{
  color:#2563eb;
}

.back{
  border:0;
  background:#eef2f7;
  padding:10px 15px;
  border-radius:8px;
  cursor:pointer;
  text-decoration:none;
  color:#172033;
}

.container{
  width:92%;
  max-width:900px;
  margin:30px auto;
}

.checkout{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
}

.card{
  background:#fff;
  padding:22px;
  border-radius:16px;
  box-shadow:0 5px 25px #0000000a;
}

h1{
  font-size:26px;
  margin-bottom:8px;
}

h2{
  font-size:19px;
  margin-bottom:15px;
}

.muted{
  color:#64748b;
  line-height:1.6;
}

.freelancer{
  display:flex;
  gap:12px;
  align-items:center;
  margin:18px 0;
  padding-bottom:18px;
  border-bottom:1px solid #e5e7eb;
}

.avatar{
  width:55px;
  height:55px;
  border-radius:50%;
  background:#2563eb;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
  overflow:hidden;
  flex-shrink:0;
}

.avatar img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.name{
  font-weight:700;
}

.title{
  color:#64748b;
  font-size:13px;
  margin-top:4px;
}

.field{
  margin-bottom:15px;
}

.field label{
  display:block;
  font-size:13px;
  font-weight:700;
  margin-bottom:6px;
}

.field input,
.field textarea,
.field select{
  width:100%;
  padding:12px;
  border:1px solid #dbe2ea;
  border-radius:8px;
  outline:none;
  font:inherit;
}

.field input:focus,
.field textarea:focus,
.field select:focus{
  border-color:#2563eb;
}

.field textarea{
  min-height:110px;
  resize:vertical;
}

.summary{
  display:flex;
  justify-content:space-between;
  gap:15px;
  padding:10px 0;
  border-bottom:1px solid #edf0f4;
}

.summary strong{
  text-align:right;
  word-break:break-word;
}

.total{
  display:flex;
  justify-content:space-between;
  font-size:20px;
  font-weight:800;
  margin-top:16px;
}

.submit{
  width:100%;
  margin-top:20px;
  border:0;
  background:#2563eb;
  color:#fff;
  padding:13px;
  border-radius:9px;
  font-size:15px;
  font-weight:700;
  cursor:pointer;
}

.submit:disabled{
  opacity:.6;
  cursor:not-allowed;
}

.message{
  display:none;
  padding:12px;
  border-radius:8px;
  margin-bottom:15px;
  line-height:1.5;
}

.message.show{
  display:block;
}

.success{
  background:#dcfce7;
  color:#166534;
}

.error{
  background:#fee2e2;
  color:#991b1b;
}

.loading{
  text-align:center;
  padding:50px;
  color:#64748b;
}

@media(max-width:700px){

  .checkout{
    grid-template-columns:1fr;
  }

  .container{
    margin:20px auto;
  }

  .card{
    padding:18px;
  }

}

</style>

</head>

<body>

<header>

  <div class="logo">
    LetsStudy <span>Pro</span>
  </div>

  <a
    class="back"
    href="javascript:history.back()"
  >
    Back
  </a>

</header>


<main class="container">

  <div
    id="loading"
    class="card loading"
  >
    Loading checkout...
  </div>


  <div
    id="checkout"
    class="checkout"
    style="display:none;"
  >

    <section class="card">

      <h1>
        Freelance Checkout
      </h1>

      <p class="muted">
        Send your project request and continue
        securely to payment.
      </p>


      <div
        id="freelancer"
        class="freelancer"
      ></div>


      <div
        id="message"
        class="message"
      ></div>


      <form id="checkoutForm">

        <div class="field">

          <label for="customerName">
            Your Name
          </label>

          <input
            id="customerName"
            type="text"
            required
            maxlength="100"
            autocomplete="name"
            placeholder="Enter your name"
          >

        </div>


        <div class="field">

          <label for="customerEmail">
            Email
          </label>

          <input
            id="customerEmail"
            type="email"
            required
            maxlength="150"
            autocomplete="email"
            placeholder="you@example.com"
          >

        </div>


        <div class="field">

          <label for="phone">
            Phone Number
          </label>

          <input
            id="phone"
            type="tel"
            required
            maxlength="30"
            autocomplete="tel"
            placeholder="+255700000000"
          >

        </div>


        <div class="field">

          <label for="country">
            Country
          </label>

          <select
            id="country"
            required
          >

            <option value="">
              Select country
            </option>

            <option value="TZ">
              Tanzania
            </option>

            <option value="KE">
              Kenya
            </option>

            <option value="UG">
              Uganda
            </option>

            <option value="RW">
              Rwanda
            </option>

            <option value="NG">
              Nigeria
            </option>

            <option value="GH">
              Ghana
            </option>

            <option value="ZA">
              South Africa
            </option>

            <option value="OTHER">
              Other
            </option>

          </select>

        </div>


        <div class="field">

          <label for="service">
            Service
          </label>

          <input
            id="service"
            type="text"
            required
            maxlength="150"
            placeholder="What do you need?"
          >

        </div>


        <div class="field">

          <label for="details">
            Project Details
          </label>

          <textarea
            id="details"
            required
            maxlength="2000"
            placeholder="Describe your project..."
          ></textarea>

        </div>


        <div class="field">

          <label for="paymentMethod">
            Payment Method
          </label>

          <select
            id="paymentMethod"
            required
          >

            <option value="">
              Select payment method
            </option>

            <option value="mobile_money">
              Mobile Money
            </option>

            <option value="card">
              Bank Card
            </option>

            <option value="bank">
              Bank Payment
            </option>

          </select>

        </div>


        <button
          id="submitButton"
          class="submit"
          type="submit"
        >
          Continue to Payment
        </button>

      </form>


      <p
        class="muted"
        style="margin-top:15px;font-size:13px;"
      >
        Payment is processed securely through
        Pesapal. Your order becomes successful
        only after payment confirmation.
      </p>

    </section>


    <aside class="card">

      <h2>
        Order Summary
      </h2>


      <div class="summary">

        <span>
          Freelancer
        </span>

        <strong id="summaryName">
          —
        </strong>

      </div>


      <div class="summary">

        <span>
          Service
        </span>

        <strong id="summaryService">
          —
        </strong>

      </div>


      <div class="summary">

        <span>
          Rate
        </span>

        <strong id="summaryRate">
          —
        </strong>

      </div>


      <div class="total">

        <span>
          Total
        </span>

        <span id="total">
          —
        </span>

      </div>


      <p
        class="muted"
        style="margin-top:18px;font-size:13px;"
      >
        Your freelance order is created through
        the LetsStudy Pro payment system before
        you continue to Pesapal.
      </p>

    </aside>

  </div>

</main>


<script>

"use strict";


/* =====================================================
   CONFIGURATION
===================================================== */

const PAYMENT_API =
  "https://api.letsstudy.pro";


/* =====================================================
   URL PARAMETERS
===================================================== */

const params =
  new URLSearchParams(
    window.location.search
  );

const freelancerId =
  params.get("id") ||
  params.get("freelancerId") ||
  params.get("documentId") ||
  "";


/* =====================================================
   ELEMENTS
===================================================== */

const loading =
  document.getElementById(
    "loading"
  );

const checkout =
  document.getElementById(
    "checkout"
  );

const freelancerBox =
  document.getElementById(
    "freelancer"
  );

const form =
  document.getElementById(
    "checkoutForm"
  );

const message =
  document.getElementById(
    "message"
  );

const submitButton =
  document.getElementById(
    "submitButton"
  );


let freelancerData = null;


/* =====================================================
   START
===================================================== */

if(!freelancerId){

  showFatalError(
    "No freelancer was selected."
  );

}else{

  loadFreelancer();

}


/* =====================================================
   LOAD FREELANCER
===================================================== */

async function loadFreelancer(){

  try{

    const response =
      await fetch(
        "/api/data?collection=freelancers&id=" +
        encodeURIComponent(
          freelancerId
        )
      );


    const result =
      await response.json();


    if(!response.ok){

      throw new Error(
        result?.error ||
        result?.message ||
        "Unable to load freelancer."
      );

    }


    if(!result?.data){

      throw new Error(
        "Freelancer not found."
      );

    }


    freelancerData =
      result.data;


    renderFreelancer(
      freelancerData
    );


    loading.style.display =
      "none";

    checkout.style.display =
      "grid";


  }catch(error){

    console.error(
      "LOAD FREELANCER:",
      error
    );

    showFatalError(
      error.message ||
      "Unable to load freelancer."
    );

  }

}


/* =====================================================
   FREELANCER DATA
===================================================== */

function getFreelancerName(){

  return (
    freelancerData?.name ||
    freelancerData?.displayName ||
    freelancerData?.username ||
    freelancerData?.fullName ||
    "Freelancer"
  );

}


function getServiceName(){

  return (
    freelancerData?.service ||
    freelancerData?.title ||
    freelancerData?.serviceName ||
    freelancerData?.headline ||
    freelancerData?.category ||
    "Freelance Service"
  );

}


function getPrice(){

  const values = [

    freelancerData?.price,

    freelancerData?.amount,

    freelancerData?.rate,

    freelancerData?.hourlyRate,

    freelancerData?.startingPrice,

    freelancerData?.startingRate,

    freelancerData?.packagePrice

  ];


  for(
    const value of values
  ){

    if(
      value !== null &&
      value !== undefined &&
      value !== ""
    ){

      const number =
        Number(
          String(value)
            .replace(
              /[^0-9.-]/g,
              ""
            )
        );


      if(
        Number.isFinite(number) &&
        number > 0
      ){

        return number;

      }

    }

  }


  return null;

}


function getCurrency(){

  return (
    freelancerData?.currency ||
    "TZS"
  );

}


/* =====================================================
   FORMAT MONEY
===================================================== */

function formatMoney(
  amount,
  currency="TZS"
){

  if(
    amount === null ||
    amount === undefined
  ){

    return "Quote";

  }


  try{

    return new Intl.NumberFormat(
      "en-TZ",
      {
        style:"currency",
        currency,
        maximumFractionDigits:2
      }
    ).format(
      Number(amount)
    );

  }catch(error){

    return (
      Number(amount).toLocaleString(
        "en-TZ"
      ) +
      " " +
      currency
    );

  }

}


/* =====================================================
   RENDER FREELANCER
===================================================== */

function renderFreelancer(data){

  const name =
    getFreelancerName();

  const title =
    getServiceName();

  const price =
    getPrice();

  const currency =
    getCurrency();

  const photo =
    safeImage(
      data.photoURL ||
      data.photo ||
      data.avatar ||
      data.profileImage ||
      data.image ||
      data.imageUrl
    );


  const initial =
    String(name)
      .trim()
      .charAt(0)
      .toUpperCase() ||
    "F";


  freelancerBox.innerHTML = `

    <div class="avatar">

      ${
        photo

        ?

        `<img
          src="${photo}"
          alt="${escapeAttr(name)}"
        >`

        :

        escapeHTML(initial)
      }

    </div>

    <div>

      <div class="name">
        ${escapeHTML(name)}
      </div>

      <div class="title">
        ${escapeHTML(title)}
      </div>

    </div>

  `;


  document
    .getElementById(
      "summaryName"
    )
    .textContent =
      name;


  document
    .getElementById(
      "summaryService"
    )
    .textContent =
      title;


  document
    .getElementById(
      "summaryRate"
    )
    .textContent =
      formatMoney(
        price,
        currency
      );


  document
    .getElementById(
      "total"
    )
    .textContent =
      formatMoney(
        price,
        currency
      );


  document
    .getElementById(
      "service"
    )
    .value =
      title;

}


/* =====================================================
   CHECKOUT SUBMIT
===================================================== */

form.addEventListener(
  "submit",
  async event => {

    event.preventDefault();

    hideMessage();


    const customerName =
      document
        .getElementById(
          "customerName"
        )
        .value
        .trim();


    const customerEmail =
      document
        .getElementById(
          "customerEmail"
        )
        .value
        .trim()
        .toLowerCase();


    const phone =
      document
        .getElementById(
          "phone"
        )
        .value
        .trim();


    const country =
      document
        .getElementById(
          "country"
        )
        .value;


    const service =
      document
        .getElementById(
          "service"
        )
        .value
        .trim();


    const details =
      document
        .getElementById(
          "details"
        )
        .value
        .trim();


    const paymentMethod =
      document
        .getElementById(
          "paymentMethod"
        )
        .value;


    /* =========================================
       VALIDATION
    ========================================== */

    if(!customerName){

      showMessage(
        "Please enter your name.",
        "error"
      );

      return;

    }


    if(!customerEmail){

      showMessage(
        "Please enter your email.",
        "error"
      );

      return;

    }


    if(!phone){

      showMessage(
        "Please enter your phone number.",
        "error"
      );

      return;

    }


    if(!country){

      showMessage(
        "Please select your country.",
        "error"
      );

      return;

    }


    if(!service){

      showMessage(
        "Please enter the service you need.",
        "error"
      );

      return;

    }


    if(!details){

      showMessage(
        "Please describe your project.",
        "error"
      );

      return;

    }


    if(!paymentMethod){

      showMessage(
        "Please select a payment method.",
        "error"
      );

      return;

    }


    const amount =
      getPrice();


    const currency =
      getCurrency();


    if(
      amount === null ||
      amount <= 0
    ){

      showMessage(
        "This freelance service does not have a valid payment price yet.",
        "error"
      );

      return;

    }


    /* =========================================
       SPLIT NAME
    ========================================== */

    const nameParts =
      customerName
        .split(/\s+/)
        .filter(Boolean);


    const firstName =
      nameParts.shift() ||
      "Customer";


    const lastName =
      nameParts.join(" ") ||
      "Customer";


    /* =========================================
       CREATE INTERNAL ORDER ID
    ========================================== */

    const orderId =
      "FREELANCE-" +
      Date.now() +
      "-" +
      Math.random()
        .toString(36)
        .slice(2,8)
        .toUpperCase();


    /* =========================================
       UNIVERSAL ORDER ITEMS
    ========================================== */

    const item = {

      productId:
        freelancerId,

      productType:
        "freelance",

      title:
        service,

      quantity:
        1,

      price:
        amount

    };


    /* =========================================
       UNIVERSAL PAYMENT PAYLOAD
    ========================================== */

    const payload = {

      orderId,

      amount,

      currency,

      description:
        `LetsStudy Pro Freelance Service Order ${orderId}`,

      email:
        customerEmail,

      firstName,

      lastName,

      phoneNumber:
        phone,

      country,

      paymentMethod,

      productType:
        "freelance",

      freelancerId,

      freelancerName:
        getFreelancerName(),

      service,

      projectDetails:
        details,

      items:[
        item
      ]

    };


    submitButton.disabled =
      true;

    submitButton.textContent =
      "Creating Payment...";


    try{

      /* =========================================
         EXISTING UNIVERSAL API
      ========================================== */

      const response =
        await fetch(
          PAYMENT_API +
          "/api/pesapal/create-order",
          {

            method:
              "POST",

            headers:{
              "Content-Type":
                "application/json"
            },

            body:
              JSON.stringify(
                payload
              )

          }
        );


      let data = null;


      try{

        data =
          await response.json();

      }catch(error){

        data = null;

      }


      if(!response.ok){

        throw new Error(
          data?.message ||
          data?.error ||
          "Unable to create payment."
        );

      }


      if(
        data?.success === false
      ){

        throw new Error(
          data?.message ||
          "Unable to create payment."
        );

      }


      /* =========================================
         PAYMENT URL
      ========================================== */

      const redirectUrl =
        data?.redirectUrl ||
        data?.redirect_url ||
        data?.paymentUrl ||
        data?.payment_url ||
        data?.iframeUrl ||
        data?.iframe_url ||
        "";


      if(!redirectUrl){

        throw new Error(
          "Pesapal payment URL was not returned."
        );

      }


      /* =========================================
         PESAPAL TRACKING ID
      ========================================== */

      const orderTrackingId =
  data?.orderTrackingId ||
  data?.OrderTrackingId ||
  data?.trackingId ||
  "";


/* =========================================
   MERCHANT REFERENCE
========================================= */

const merchantReference =
  data?.merchantReference ||
  data?.merchant_reference ||
  orderId;


/* =========================================
   VALIDATE PAYMENT DATA
========================================= */

if(
  !redirectUrl &&
  !orderTrackingId
){

  throw new Error(
    "Pesapal payment information was not returned."
  );

}


/* =========================================
   SAVE PENDING ORDER
========================================= */

const pendingOrder = {

  ...payload,

  status:
    "PENDING",

  orderId:
    data?.orderId ||
    orderId,

  orderTrackingId,

  merchantReference,

  redirectUrl,

  createdAt:
    new Date()
      .toISOString()

};


localStorage.setItem(
  "pendingFreelanceOrder",
  JSON.stringify(
    pendingOrder
  )
);


/* =========================================
   BUILD UNIVERSAL PAYMENT URL
========================================= */

const paymentPage =
  new URL(
    "payment.html",
    window.location.href
  );


paymentPage.searchParams.set(
  "orderId",
  data?.orderId ||
  orderId
);


paymentPage.searchParams.set(
  "merchantReference",
  merchantReference
);


if(orderTrackingId){

  paymentPage.searchParams.set(
    "orderTrackingId",
    orderTrackingId
  );

}


if(redirectUrl){

  paymentPage.searchParams.set(
    "redirectUrl",
    redirectUrl
  );

}


/* =========================================
   SHOW STATUS
========================================= */

showMessage(
  "Payment created. Opening secure payment...",
  "success"
);


/* =========================================
   OPEN UNIVERSAL PAYMENT PAGE
========================================= */

setTimeout(
  () => {

    window.location.href =
      paymentPage.href;

  },
  500
);


}catch(error){

  console.error(
    "FREELANCE PAYMENT:",
    error
  );


  submitButton.disabled =
    false;


  submitButton.textContent =
    "Continue to Payment";


  showMessage(
    error?.message ||
    "Unable to create payment. Please try again.",
    "error"
  );

}

});


/* =====================================================
   MESSAGE
===================================================== */

function showMessage(
  text,
  type
){

  message.className =
    "message show " +
    type;

  message.textContent =
    text;

}


function hideMessage(){

  message.className =
    "message";

  message.textContent =
    "";

}


/* =====================================================
   FATAL ERROR
===================================================== */

function showFatalError(
  text
){

  loading.className =
    "card loading error";

  loading.innerHTML = `

    <h2>
      Checkout unavailable
    </h2>

    <p style="margin-top:8px;">
      ${escapeHTML(text)}
    </p>

  `;

}


/* =====================================================
   SAFE IMAGE
===================================================== */

function safeImage(url){

  if(!url){

    return "";

  }


  try{

    const parsed =
      new URL(
        String(url),
        window.location.origin
      );


    if(
      parsed.protocol === "https:" ||
      parsed.protocol === "http:"
    ){

      return escapeAttr(
        parsed.href
      );

    }

  }catch(error){

    console.warn(
      "Invalid image URL:",
      error
    );

  }


  return "";

}


/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHTML(value){

  return String(
    value ?? ""
  )
  .replace(
    /&/g,
    "&amp;"
  )
  .replace(
    /</g,
    "&lt;"
  )
  .replace(
    />/g,
    "&gt;"
  )
  .replace(
    /"/g,
    "&quot;"
  )
  .replace(
    /'/g,
    "&#039;"
  );

}


/* =====================================================
   ESCAPE ATTRIBUTE
===================================================== */

function escapeAttr(value){

  return escapeHTML(
    value
  ).replace(
    /`/g,
    "&#096;"
  );

}

</script>

</body>
</html>