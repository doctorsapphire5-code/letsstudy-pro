<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Freelancer Checkout | LetsStudy Pro</title>

<meta name="description"
content="Complete your freelancer hiring request on LetsStudy Pro.">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
*{box-sizing:border-box}

body{
 margin:0;
 background:#f6f8fb;
 color:#172033;
 font-family:Inter,Arial,sans-serif
}

a{
 text-decoration:none;
 color:inherit
}

.top{
 height:64px;
 background:#fff;
 border-bottom:1px solid #e5e7eb;
 display:flex;
 align-items:center;
 justify-content:space-between;
 padding:0 6%;
 position:sticky;
 top:0;
 z-index:20
}

.logo{
 color:#155eef;
 font-size:21px;
 font-weight:800
}

.nav{
 display:flex;
 gap:18px;
 font-size:13px;
 font-weight:700
}

.container{
 max-width:1000px;
 margin:30px auto;
 padding:0 20px
}

.back{
 display:inline-flex;
 gap:7px;
 align-items:center;
 color:#155eef;
 font-size:12px;
 font-weight:700;
 margin-bottom:18px
}

.grid{
 display:grid;
 grid-template-columns:1.5fr .8fr;
 gap:20px
}

.card{
 background:#fff;
 border:1px solid #e5e7eb;
 border-radius:16px;
 padding:22px
}

.card h2{
 margin:0 0 18px;
 font-size:19px
}

.freelancer{
 display:flex;
 gap:14px;
 align-items:center;
 padding-bottom:18px;
 border-bottom:1px solid #eef0f3
}

.avatar{
 width:70px;
 height:70px;
 border-radius:50%;
 overflow:hidden;
 background:#eef2f6;
 display:flex;
 align-items:center;
 justify-content:center;
 color:#155eef;
 font-size:25px;
 font-weight:800;
 flex-shrink:0
}

.avatar img{
 width:100%;
 height:100%;
 object-fit:cover
}

.name{
 font-size:18px;
 font-weight:800
}

.verified{
 color:#12b76a;
 font-size:12px
}

.headline{
 color:#667085;
 font-size:12px;
 margin-top:5px
}

label{
 display:block;
 font-size:12px;
 font-weight:800;
 margin:18px 0 7px
}

input,
textarea,
select{
 width:100%;
 padding:12px;
 border:1px solid #d9dee8;
 border-radius:9px;
 outline:none;
 font-family:inherit;
 background:#fff
}

textarea{
 min-height:125px;
 resize:vertical
}

input:focus,
textarea:focus,
select:focus{
 border-color:#155eef
}

.help{
 color:#667085;
 font-size:10px;
 margin-top:5px
}

.summary-row{
 display:flex;
 justify-content:space-between;
 gap:10px;
 padding:12px 0;
 border-bottom:1px solid #eef0f3;
 font-size:12px
}

.summary-row span{
 color:#667085
}

.total{
 display:flex;
 justify-content:space-between;
 margin-top:18px;
 font-size:20px;
 font-weight:800
}

.total small{
 font-size:11px;
 color:#667085;
 font-weight:500
}

.btn{
 width:100%;
 border:0;
 padding:13px;
 border-radius:9px;
 background:#155eef;
 color:#fff;
 font-size:13px;
 font-weight:800;
 cursor:pointer;
 margin-top:18px
}

.btn:disabled{
 opacity:.6;
 cursor:not-allowed
}

.notice{
 background:#eff6ff;
 color:#175cd3;
 border-radius:10px;
 padding:12px;
 font-size:11px;
 line-height:1.6;
 margin-top:15px
}

.loading{
 text-align:center;
 padding:100px 20px;
 color:#667085
}

.error{
 max-width:600px;
 margin:70px auto;
 background:#fff;
 border:1px solid #e5e7eb;
 border-radius:16px;
 padding:50px 20px;
 text-align:center;
 color:#667085
}

.hidden{
 display:none
}

@media(max-width:750px){

 .nav{
  display:none
 }

 .container{
  padding:0 15px
 }

 .grid{
  grid-template-columns:1fr
 }

}
</style>
</head>

<body>

<header class="top">

<a href="index.html" class="logo">
LetsStudy Pro
</a>

<nav class="nav">

<a href="course.html">Courses</a>
<a href="marketplace.html">Marketplace</a>
<a href="services.html">Services</a>
<a href="career.html">Careers</a>

</nav>

</header>


<main class="container">

<a
id="backLink"
href="freelance.html"
class="back">

<i class="fa fa-arrow-left"></i>

Back to Freelancer

</a>


<div
id="loading"
class="loading">

<i class="fa fa-spinner fa-spin"></i>

<p>
Loading checkout...
</p>

</div>


<div
id="error"
class="error hidden">

<i
class="fa fa-triangle-exclamation"
style="font-size:35px">
</i>

<h2>
Freelancer Not Found
</h2>

<p>
The freelancer information could not be loaded.
</p>

<a
href="freelance.html"
class="btn"
style="display:inline-block;max-width:220px">

Browse Freelancers

</a>

</div>


<div
id="checkout"
class="grid hidden">


<!-- LEFT -->

<section class="card">

<h2>
Hire Freelancer
</h2>


<div class="freelancer">

<div class="avatar">

<img
id="profileImage"
src=""
alt="Freelancer">

</div>


<div>

<div class="name">

<span id="name">
Freelancer
</span>

<i
id="verified"
class="fa fa-circle-check verified hidden">
</i>

</div>

<div
id="headline"
class="headline">

Professional Freelancer

</div>

</div>

</div>


<form id="checkoutForm">


<label>
Project / Job Title
</label>

<input
id="jobTitle"
type="text"
placeholder="e.g. Website Design"
required>


<label>
Describe Your Project
</label>

<textarea
id="description"
placeholder="Tell the freelancer what you need..."
required></textarea>


<label>
Budget Type
</label>

<select id="budgetType">

<option value="hourly">
Hourly
</option>

<option value="fixed">
Fixed Price
</option>

</select>


<label>
Your Budget
</label>

<input
id="budget"
type="number"
min="1"
placeholder="Enter your budget"
required>

<div class="help">
Enter the amount you are willing to pay for this project.
</div>


<label>
Deadline
</label>

<input
id="deadline"
type="date"
required>


<label>
Additional Requirements
</label>

<textarea
id="requirements"
placeholder="Files, instructions, preferred delivery details..."></textarea>


<button
id="continueBtn"
type="submit"
class="btn">

Continue to Payment

<i class="fa fa-arrow-right"></i>

</button>

</form>

</section>


<!-- RIGHT -->

<aside>

<section class="card">

<h2>
Order Summary
</h2>


<div class="summary-row">

<span>
Freelancer
</span>

<strong id="summaryName">
-
</strong>

</div>


<div class="summary-row">

<span>
Experience
</span>

<strong id="experience">
-
</strong>

</div>


<div class="summary-row">

<span>
Rating
</span>

<strong id="rating">
-
</strong>

</div>


<div class="summary-row">

<span>
Rate
</span>

<strong>

<span id="currency">
TZS
</span>

&nbsp;

<span id="hourlyRate">
0
</span>

 / hr

</strong>

</div>


<div class="summary-row">

<span>
Budget Type
</span>

<strong id="summaryBudgetType">
Hourly
</strong>

</div>


<div class="total">

<span>
Your Budget
</span>

<strong>

<span id="totalCurrency">
TZS
</span>

&nbsp;

<span id="total">
0
</span>

</strong>

</div>


<div class="notice">

<i class="fa fa-shield-halved"></i>

Your payment will be processed securely.
The freelancer will receive the project details
after the order is created.

</div>

</section>

</aside>

</div>

</main>


<script type="module">

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

import {
getFirestore,
doc,
getDoc
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


/* =========================
FIREBASE
========================= */

const firebaseConfig={

apiKey:
"AIzaSyBcOYDfAVKXbkljsYrgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};

const app=
initializeApp(firebaseConfig);

const db=
getFirestore(app);


/* =========================
PARAMETER
========================= */

const params=
new URLSearchParams(
location.search
);

const freelancerId=
params.get("id");


/* =========================
ELEMENTS
========================= */

const loading=
document.getElementById("loading");

const error=
document.getElementById("error");

const checkout=
document.getElementById("checkout");

const form=
document.getElementById("checkoutForm");

const budget=
document.getElementById("budget");

const budgetType=
document.getElementById("budgetType");

const total=
document.getElementById("total");


let freelancer=null;


/* =========================
HELPERS
========================= */

function setText(id,value){

document.getElementById(id)
.textContent=value ?? "-";

}


function money(value){

return Number(
value||0
).toLocaleString();

}


/* =========================
LOAD FREELANCER
========================= */

async function loadFreelancer(){

if(!freelancerId){

showError();
return;

}


try{

const snap=
await getDoc(
doc(
db,
"freelancers",
freelancerId
)
);


if(!snap.exists()){

showError();
return;

}


freelancer={
id:freelancerId,
...snap.data()
};


/* IMAGE */

document.getElementById(
"profileImage"
).src=
freelancer.profileImage||
"https://via.placeholder.com/100?text=F";


/* BASIC */

setText(
"name",
freelancer.name||
"Freelancer"
);


setText(
"summaryName",
freelancer.name||
"Freelancer"
);


setText(
"headline",
freelancer.headline||
"Professional Freelancer"
);


setText(
"experience",
freelancer.experienceLevel||
"-"
);


setText(
"rating",
`${Number(
freelancer.rating||0
).toFixed(1)} ★ (${Number(
freelancer.ratingCount||0
)})`
);


setText(
"currency",
freelancer.currency||
"TZS"
);


setText(
"totalCurrency",
freelancer.currency||
"TZS"
);


setText(
"hourlyRate",
money(
freelancer.hourlyRate
)
);


/* VERIFIED */

if(freelancer.verified===true){

document.getElementById(
"verified"
).classList.remove("hidden");

}


/* DEFAULT BUDGET */

if(freelancer.hourlyRate){

budget.value=
freelancer.hourlyRate;

updateTotal();

}


/* SHOW */

loading.style.display="none";

checkout.classList.remove("hidden");


}catch(err){

console.error(err);

showError();

}

}


/* =========================
TOTAL
========================= */

function updateTotal(){

const amount=
Number(budget.value||0);

total.textContent=
money(amount);

setText(
"summaryBudgetType",
budgetType.value==="fixed"
?"Fixed Price"
:"Hourly"
);

}


/* =========================
EVENTS
========================= */

budget.addEventListener(
"input",
updateTotal
);

budgetType.addEventListener(
"change",
updateTotal
);


/* =========================
CONTINUE PAYMENT
========================= */

form.addEventListener(
"submit",
function(e){

e.preventDefault();


const jobTitle=
document.getElementById(
"jobTitle"
).value.trim();


const description=
document.getElementById(
"description"
).value.trim();


const requirements=
document.getElementById(
"requirements"
).value.trim();


const deadline=
document.getElementById(
"deadline"
).value;


const amount=
Number(
budget.value||0
);


if(!jobTitle ||
!description ||
!deadline ||
amount<=0){

alert(
"Please complete all required fields."
);

return;

}


/*
 IMPORTANT:
 Only freelancerId is trusted by payment page.
 Other project information is encoded for
 the checkout/payment flow.
*/

const paymentUrl=

"payment.html"+
"?type=freelancer"+
"&freelancerId="+
encodeURIComponent(
freelancerId
)+
"&jobTitle="+
encodeURIComponent(
jobTitle
)+
"&description="+
encodeURIComponent(
description
)+
"&budgetType="+
encodeURIComponent(
budgetType.value
)+
"&budget="+
encodeURIComponent(
amount
)+
"&deadline="+
encodeURIComponent(
deadline
)+
"&requirements="+
encodeURIComponent(
requirements
);


location.href="payment.html;

}
);


/* =========================
ERROR
========================= */

function showError(){

loading.style.display="none";

error.classList.remove("hidden");

}


/* =========================
START
========================= */

loadFreelancer();

</script>

</body>
</html>