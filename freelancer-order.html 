<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Freelancer Order | LetsStudy Pro</title>
  <meta name="description" content="Place a freelancer project order on LetsStudy Pro.">
  <meta name="robots" content="noindex, follow">

  <link rel="icon" href="favicon.png">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Inter, Arial, sans-serif;
      background: #f5f7fb;
      color: #172033;
      line-height: 1.6;
    }

    .nav {
      position: sticky;
      top: 0;
      z-index: 20;
      background: #fff;
      border-bottom: 1px solid #e5eaf1;
      padding: 15px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      color: #2563eb;
      font-size: 22px;
      font-weight: 900;
      text-decoration: none;
    }

    .nav-links {
      display: flex;
      gap: 20px;
    }

    .nav-links a {
      color: #475569;
      text-decoration: none;
      font-weight: 700;
    }

    .container {
      width: min(1100px, 92%);
      margin: auto;
    }

    .breadcrumb {
      padding: 28px 0 15px;
      color: #64748b;
      font-size: 14px;
    }

    .breadcrumb a {
      color: #2563eb;
      text-decoration: none;
      font-weight: 700;
    }

    .header {
      margin-bottom: 25px;
    }

    .header h1 {
      font-size: clamp(30px, 5vw, 44px);
      line-height: 1.15;
      margin-bottom: 8px;
    }

    .header p {
      color: #64748b;
    }

    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 25px;
      margin-bottom: 60px;
    }

    .card {
      background: #fff;
      border: 1px solid #e5eaf1;
      border-radius: 18px;
      padding: 27px;
      box-shadow: 0 8px 25px rgba(15,23,42,.04);
    }

    .card + .card {
      margin-top: 20px;
    }

    .card h2 {
      font-size: 20px;
      margin-bottom: 18px;
    }

    .project-title {
      font-size: 26px;
      font-weight: 900;
      margin-bottom: 18px;
    }

    .status {
      display: inline-flex;
      padding: 6px 11px;
      border-radius: 999px;
      background: #ecfdf5;
      color: #047857;
      font-size: 12px;
      font-weight: 900;
      text-transform: uppercase;
      margin-bottom: 15px;
    }

    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .info {
      background: #f8fafc;
      padding: 15px;
      border-radius: 12px;
    }

    .info small {
      display: block;
      color: #64748b;
      font-size: 12px;
      margin-bottom: 4px;
    }

    .info strong {
      display: block;
      word-break: break-word;
    }

    .section {
      margin-top: 24px;
    }

    .section h3 {
      font-size: 16px;
      margin-bottom: 8px;
    }

    .text-box {
      background: #f8fafc;
      border-radius: 12px;
      padding: 16px;
      white-space: pre-wrap;
      color: #475569;
    }

    .form-group {
      margin-bottom: 17px;
    }

    label {
      display: block;
      margin-bottom: 7px;
      font-size: 14px;
      font-weight: 800;
      color: #334155;
    }

    input,
    textarea,
    select {
      width: 100%;
      padding: 13px 14px;
      border: 1px solid #dbe2ea;
      border-radius: 11px;
      outline: none;
      font: inherit;
      color: #172033;
      background: #fff;
    }

    input:focus,
    textarea:focus,
    select:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37,99,235,.1);
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    .summary {
      display: grid;
      gap: 13px;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      padding-bottom: 12px;
      border-bottom: 1px solid #edf0f4;
    }

    .summary-row:last-child {
      border-bottom: 0;
    }

    .summary-label {
      color: #64748b;
      font-size: 14px;
    }

    .summary-value {
      text-align: right;
      font-weight: 800;
    }

    .total {
      font-size: 21px;
      color: #172033;
    }

    .btn {
      display: block;
      width: 100%;
      border: 0;
      border-radius: 12px;
      padding: 14px 18px;
      font: inherit;
      font-weight: 900;
      cursor: pointer;
      text-align: center;
      text-decoration: none;
      margin-top: 12px;
    }

    .primary {
      background: #2563eb;
      color: #fff;
    }

    .primary:hover {
      background: #1d4ed8;
    }

    .secondary {
      background: #fff;
      color: #2563eb;
      border: 1px solid #dbe2ea;
    }

    .notice {
      background: #eff6ff;
      color: #1e40af;
      border-radius: 11px;
      padding: 14px;
      font-size: 13px;
      margin-top: 18px;
    }

    .agreement {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      color: #526174;
      font-size: 13px;
      margin-top: 18px;
    }

    .agreement input {
      width: auto;
      margin-top: 5px;
    }

    .loading,
    .error,
    .empty {
      background: #fff;
      border: 1px solid #e5eaf1;
      border-radius: 18px;
      padding: 60px 20px;
      text-align: center;
      margin: 30px 0 60px;
    }

    .error {
      color: #b91c1c;
    }

    .empty h2 {
      margin-bottom: 8px;
    }

    .empty p {
      color: #64748b;
    }

    footer {
      background: #fff;
      border-top: 1px solid #e5eaf1;
      padding: 28px;
      text-align: center;
      color: #7b8492;
      font-size: 14px;
    }

    @media(max-width:850px) {
      .layout {
        grid-template-columns: 1fr;
      }

      .info-grid {
        grid-template-columns: 1fr;
      }

      .nav-links {
        display: none;
      }
    }
  </style>
</head>

<body>

<nav class="nav">

  <a href="index.html" class="logo">
    LetsStudy Pro
  </a>

  <div class="nav-links">
    <a href="freelancers.html">Freelancers</a>
    <a href="services.html">Services</a>
    <a href="marketplace.html">Marketplace</a>
  </div>

</nav>

<main class="container">

  <div class="breadcrumb">
    <a href="freelancers.html">Freelancers</a>
    /
    <a id="freelancerLink" href="#">Freelancer</a>
    /
    <span>Order</span>
  </div>

  <div id="loading" class="loading">
    Loading freelancer order...
  </div>

  <div id="error" class="error" style="display:none;"></div>

  <div id="empty" class="empty" style="display:none;">

    <h2>No Accepted Contract</h2>

    <p>
      An accepted freelancer contract is required before creating an order.
    </p>

    <a
      href="freelancers.html"
      class="btn primary">
      Browse Freelancers
    </a>

  </div>

  <section id="content" style="display:none;">

    <div class="header">

      <h1>Place Freelancer Order</h1>

      <p>
        Confirm your project information and continue to payment.
      </p>

    </div>

    <div class="layout">

      <div>

        <div class="card">

          <span class="status">
            Contract Accepted
          </span>

          <div
            class="project-title"
            id="projectTitle">
            —
          </div>

          <div class="info-grid">

            <div class="info">
              <small>Freelancer</small>
              <strong id="freelancerName">—</strong>
            </div>

            <div class="info">
              <small>Client</small>
              <strong id="clientName">—</strong>
            </div>

            <div class="info">
              <small>Delivery Date</small>
              <strong id="deadline">—</strong>
            </div>

            <div class="info">
              <small>Payment Terms</small>
              <strong id="paymentTerms">—</strong>
            </div>

          </div>

          <div class="section">

            <h3>Project Scope</h3>

            <div
              class="text-box"
              id="scope">
              —
            </div>

          </div>

          <div class="section">

            <h3>Deliverables</h3>

            <div
              class="text-box"
              id="deliverables">
              —
            </div>

          </div>

        </div>

        <div class="card">

          <h2>Order Information</h2>

          <form id="orderForm">

            <div class="form-group">

              <label for="fullName">
                Full Name
              </label>

              <input
                id="fullName"
                type="text"
                required
                placeholder="Enter your full name">

            </div>

            <div class="form-group">

              <label for="email">
                Email Address
              </label>

              <input
                id="email"
                type="email"
                required
                placeholder="Enter your email address">

            </div>

            <div class="form-group">

              <label for="phone">
                Phone Number
              </label>

              <input
                id="phone"
                type="tel"
                required
                placeholder="Enter your phone number">

            </div>

            <div class="form-group">

              <label for="notes">
                Order Notes
              </label>

              <textarea
                id="notes"
                placeholder="Add any additional instructions or requirements..."></textarea>

            </div>

            <div class="form-group">

              <label for="paymentMethod">
                Payment Method
              </label>

              <select
                id="paymentMethod"
                required>

                <option value="">
                  Select payment method
                </option>

                <option value="mobile">
                  Mobile Payment
                </option>

                <option value="card">
                  Card
                </option>

                <option value="other">
                  Other
                </option>

              </select>

            </div>

            <label class="agreement">

              <input
                id="agreement"
                type="checkbox"
                required>

              <span>
                I confirm that the order information is accurate
                and I agree to proceed with the accepted contract terms.
              </span>

            </label>

            <button
              type="submit"
              class="btn primary">
              Continue to Payment
            </button>

          </form>

        </div>

      </div>

      <aside>

        <div class="card">

          <h2>Order Summary</h2>

          <div class="summary">

            <div class="summary-row">
              <span class="summary-label">
                Freelancer
              </span>

              <strong
                class="summary-value"
                id="summaryFreelancer">
                —
              </strong>
            </div>

            <div class="summary-row">
              <span class="summary-label">
                Project
              </span>

              <strong
                class="summary-value"
                id="summaryProject">
                —
              </strong>
            </div>

            <div class="summary-row">
              <span class="summary-label">
                Deadline
              </span>

              <strong
                class="summary-value"
                id="summaryDeadline">
                —
              </strong>
            </div>

            <div class="summary-row">
              <span class="summary-label">
                Payment Terms
              </span>

              <strong
                class="summary-value"
                id="summaryPayment">
                —
              </strong>
            </div>

            <div class="summary-row">

              <span class="summary-label">
                Contract Status
              </span>

              <strong
                class="summary-value">
                Accepted
              </strong>

            </div>

          </div>

          <div class="notice">
            Your order will remain pending until the payment
            provider confirms the transaction.
          </div>

          <a
            id="backBtn"
            href="#"
            class="btn secondary">
            Back to Freelancer
          </a>

        </div>

      </aside>

    </div>

  </section>

</main>

<footer>
  © 2026 LetsStudy Pro. All rights reserved.
</footer>

<script>

  const params =
    new URLSearchParams(
      window.location.search
    );

  const freelancerId =
    params.get("id");

  const loading =
    document.getElementById("loading");

  const errorBox =
    document.getElementById("error");

  const emptyBox =
    document.getElementById("empty");

  const content =
    document.getElementById("content");

  const contractKey =
    "pendingFreelancerContract";

  let contract = null;

  function formatDate(value) {

    if (!value) {
      return "Not specified";
    }

    const date =
      new Date(value);

    if (isNaN(date.getTime())) {
      return value;
    }

    return date.toLocaleDateString(
      undefined,
      {
        year: "numeric",
        month: "long",
        day: "numeric"
      }
    );

  }

  function paymentLabel(value) {

    const labels = {

      "full-upfront":
        "Full payment upfront",

      "milestone":
        "Milestone payments",

      "after-delivery":
        "Payment after delivery"

    };

    return labels[value] ||
      value ||
      "Not specified";

  }

  function showError(message) {

    loading.style.display =
      "none";

    content.style.display =
      "none";

    emptyBox.style.display =
      "none";

    errorBox.style.display =
      "block";

    errorBox.textContent =
      message;

  }

  function loadOrder() {

    try {

      const stored =
        localStorage.getItem(
          contractKey
        );

      if (!stored) {

        loading.style.display =
          "none";

        emptyBox.style.display =
          "block";

        return;
      }

      contract =
        JSON.parse(stored);

      if (!contract) {

        throw new Error(
          "Invalid contract."
        );

      }

      if (
        contract.status !==
        "accepted"
      ) {

        showError(
          "The freelancer contract must be accepted before placing an order."
        );

        return;
      }

      if (
        freelancerId &&
        contract.freelancer?.freelancerId &&
        contract.freelancer.freelancerId !==
          freelancerId
      ) {

        showError(
          "This contract does not belong to the selected freelancer."
        );

        return;
      }

      const freelancer =
        contract.freelancer?.name ||
        "Freelancer";

      const client =
        contract.client?.name ||
        "";

      const email =
        contract.client?.email ||
        "";

      const project =
        contract.project?.title ||
        "Untitled Project";

      const scope =
        contract.project?.scope ||
        "Not specified";

      const deliverables =
        contract.project?.deliverables ||
        "Not specified";

      const deadline =
        contract.project?.deadline ||
        "";

      const payment =
        paymentLabel(
          contract.paymentTerms
        );

      document.getElementById(
        "projectTitle"
      ).textContent =
        project;

      document.getElementById(
        "freelancerName"
      ).textContent =
        freelancer;

      document.getElementById(
        "clientName"
      ).textContent =
        client || "Client";

      document.getElementById(
        "deadline"
      ).textContent =
        formatDate(deadline);

      document.getElementById(
        "paymentTerms"
      ).textContent =
        payment;

      document.getElementById(
        "scope"
      ).textContent =
        scope;

      document.getElementById(
        "deliverables"
      ).textContent =
        deliverables;

      document.getElementById(
        "summaryFreelancer"
      ).textContent =
        freelancer;

      document.getElementById(
        "summaryProject"
      ).textContent =
        project;

      document.getElementById(
        "summaryDeadline"
      ).textContent =
        formatDate(deadline);

      document.getElementById(
        "summaryPayment"
      ).textContent =
        payment;

      document.getElementById(
        "fullName"
      ).value =
        client;

      document.getElementById(
        "email"
      ).value =
        email;

      const link =
        freelancerId
          ? `freelancer-details.html?id=${encodeURIComponent(freelancerId)}`
          : "freelancers.html";

      document.getElementById(
        "freelancerLink"
      ).href = link;

      document.getElementById(
        "backBtn"
      ).href = link;

      loading.style.display =
        "none";

      content.style.display =
        "block";

    } catch (error) {

      console.error(error);

      showError(
        "Unable to load the freelancer order."
      );

    }

  }

  document
    .getElementById("orderForm")
    .addEventListener(
      "submit",
      event => {

        event.preventDefault();

        if (!contract) {
          return;
        }

        const fullName =
          document.getElementById(
            "fullName"
          ).value.trim();

        const email =
          document.getElementById(
            "email"
          ).value.trim();

        const phone =
          document.getElementById(
            "phone"
          ).value.trim();

        const notes =
          document.getElementById(
            "notes"
          ).value.trim();

        const paymentMethod =
          document.getElementById(
            "paymentMethod"
          ).value;

        const freelancerName =
          contract.freelancer?.name ||
          "Freelancer";

        const project =
          contract.project?.title ||
          "Untitled Project";

        const orderId =
          "FRE-" +
          Date.now() +
          "-" +
          Math.random()
            .toString(36)
            .substring(2, 8)
            .toUpperCase();

        const order = {

          orderId,

          freelancer: {

            freelancerId:
              contract.freelancer?.freelancerId ||
              freelancerId ||
              "",

            name:
              freelancerName

          },

          contract: {

            contractId:
              contract.contractId ||
              "",

            status:
              "accepted",

            projectTitle:
              project

          },

          client: {

            name:
              fullName,

            email:
              email,

            phone:
              phone

          },

          project: {

            title:
              project,

            scope:
              contract.project?.scope ||
              "",

            deliverables:
              contract.project?.deliverables ||
              "",

            deadline:
              contract.project?.deadline ||
              ""

          },

          notes,

          paymentTerms:
            contract.paymentTerms ||
            "",

          paymentMethod,

          status:
            "pending_payment",

          createdAt:
            new Date().toISOString()

        };

        /*
         * Temporary client-side order.
         * Production orders must be created and verified
         * through an authenticated backend/Firebase workflow.
         */

        localStorage.setItem(
  "pendingFreelancerOrder",
  JSON.stringify(order)
);

/*
 * Redirect to the payment page.
 * The order remains pending until payment is
 * verified by the payment provider/backend.
 */
if (freelancerId) {

  window.location.href =
    `freelancer-payment.html?id=${encodeURIComponent(freelancerId)}`;

} else {

  window.location.href =
    "payment.html";

}

      }
    );

  loadOrder();

</script>

</body>
</html>