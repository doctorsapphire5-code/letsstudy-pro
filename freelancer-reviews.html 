<!-- =========================
     TOAST
========================= -->

<div
id="toast"
class="toast">
</div>


<script>

/* =========================
   HELPERS
========================= */

const get =
    id =>
        document.getElementById(id);


function showToast(
    message
){

    const toast =
        get("toast");

    if(!toast)
        return;

    toast.textContent =
        message;

    toast.classList.add(
        "show"
    );

    clearTimeout(
        window.reviewToast
    );

    window.reviewToast =
        setTimeout(
            () => {

                toast.classList.remove(
                    "show"
                );

            },
            2200
        );

}


/* =========================
   FILTER ELEMENTS
========================= */

const search =
    get("search");

const ratingFilter =
    get("ratingFilter");

const serviceFilter =
    get("serviceFilter");

const sortFilter =
    get("sortFilter");

const resultCount =
    get("resultCount");

const empty =
    get("empty");

const reviewContainer =
    get("reviews");


let reviewItems =
    Array.from(
        document.querySelectorAll(
            ".review"
        )
    );


/* =========================
   FILTER REVIEWS
========================= */

function filterReviews(){

    const query =
        (
            search?.value ||
            ""
        )
        .trim()
        .toLowerCase();


    const rating =
        ratingFilter?.value ||
        "all";


    const service =
        serviceFilter?.value ||
        "all";


    let visible =
        reviewItems.filter(
            review => {

                const text =
                    (
                        review.dataset.search ||
                        review.textContent ||
                        ""
                    )
                    .toLowerCase();


                const matchesSearch =
                    !query ||
                    text.includes(
                        query
                    );


                const matchesRating =
                    rating === "all" ||
                    review.dataset.rating ===
                    rating;


                const matchesService =
                    service === "all" ||
                    review.dataset.service ===
                    service;


                return (
                    matchesSearch &&
                    matchesRating &&
                    matchesService
                );

            }
        );


    /* =========================
       SORT
    ========================= */

    const sort =
        sortFilter?.value ||
        "newest";


    if(sort === "highest"){

        visible.sort(
            (
                a,
                b
            ) =>
                Number(
                    b.dataset.rating ||
                    0
                ) -
                Number(
                    a.dataset.rating ||
                    0
                )
        );

    }


    if(sort === "lowest"){

        visible.sort(
            (
                a,
                b
            ) =>
                Number(
                    a.dataset.rating ||
                    0
                ) -
                Number(
                    b.dataset.rating ||
                    0
                )
        );

    }


    /* =========================
       HIDE ALL
    ========================= */

    reviewItems.forEach(
        review => {

            review.style.display =
                "none";

        }
    );


    /* =========================
       SHOW MATCHES
    ========================= */

    visible.forEach(
        review => {

            review.style.display =
                "block";

        }
    );


    /* =========================
       RESULT COUNT
    ========================= */

    if(resultCount){

        resultCount.textContent =
            visible.length +
            (
                visible.length === 1
                    ? " review"
                    : " reviews"
            );

    }


    /* =========================
       EMPTY STATE
    ========================= */

    if(empty){

        empty.style.display =
            visible.length
                ? "none"
                : "block";

    }

}


/* =========================
   EVENTS
========================= */

if(search){

    search.addEventListener(
        "input",
        filterReviews
    );

}


if(ratingFilter){

    ratingFilter.addEventListener(
        "change",
        filterReviews
    );

}


if(serviceFilter){

    serviceFilter.addEventListener(
        "change",
        filterReviews
    );

}


if(sortFilter){

    sortFilter.addEventListener(
        "change",
        filterReviews
    );

}


/* =========================
   HELPFUL BUTTONS
========================= */

document
.querySelectorAll(
    ".helpful"
)
.forEach(
    button => {

        button.addEventListener(
            "click",
            () => {

                if(
                    button.dataset.clicked ===
                    "true"
                ){

                    return;

                }


                button.dataset.clicked =
                    "true";

                button.textContent =
                    "👍 Helpful ✓";


                button.style.background =
                    "#f1f5f9";


                showToast(
                    "Thanks for your feedback."
                );

            }
        );

    }
);


/* =========================
   PAGINATION
========================= */

const pagination =
    get("pagination");


if(pagination){

    pagination
    .querySelectorAll(
        ".page-btn"
    )
    .forEach(
        button => {

            button.addEventListener(
                "click",
                () => {

                    const value =
                        button
                        .textContent
                        .trim();


                    if(
                        value ===
                        "→"
                    ){

                        showToast(
                            "Loading next page..."
                        );

                        return;

                    }


                    pagination
                    .querySelectorAll(
                        ".page-btn"
                    )
                    .forEach(
                        item =>
                            item.classList.remove(
                                "active"
                            )
                    );


                    button.classList.add(
                        "active"
                    );


                    showToast(
                        "Page " +
                        value
                    );

                }
            );

        }
    );

}


/* =========================
   URL SEARCH
========================= */

function loadUrlSearch(){

    const params =
        new URLSearchParams(
            window.location.search
        );


    const query =
        params.get("q");


    if(
        query &&
        search
    ){

        search.value =
            query;

        filterReviews();

    }

}


/* =========================
   INITIALIZE
========================= */

loadUrlSearch();

filterReviews();


/* =========================
   ESCAPE KEY
========================= */

document.addEventListener(
    "keydown",
    event => {

        if(
            event.key ===
            "Escape"
        ){

            if(search){

                search.value =
                    "";

                filterReviews();

            }

        }

    }
);


console.log(
    "LetsStudy Pro Freelancer Reviews loaded."
);

</script>

