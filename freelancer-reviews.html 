<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0
}

body{
    font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    background:#f6f8fc;
    color:#111827;
    line-height:1.5
}

button,
input,
select{
    font:inherit
}

button{
    cursor:pointer
}

a{
    text-decoration:none;
    color:inherit
}


/* =========================
   HEADER
========================= */

.header{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(255,255,255,.96);
    backdrop-filter:blur(12px);
    border-bottom:1px solid #e5e7eb
}

.header-inner{
    max-width:1250px;
    margin:auto;
    min-height:68px;
    padding:0 20px;
    display:flex;
    align-items:center;
    gap:18px
}

.logo{
    display:flex;
    align-items:center;
    gap:9px;
    min-width:max-content
}

.logo-box{
    width:39px;
    height:39px;
    border-radius:10px;
    background:#111827;
    color:#fff;
    display:grid;
    place-items:center;
    font-size:10px;
    font-weight:900
}

.logo-text strong{
    display:block;
    font-size:11px
}

.logo-text span{
    display:block;
    font-size:7px;
    color:#64748b
}

.nav{
    flex:1;
    display:flex;
    gap:4px
}

.nav a{
    padding:8px 9px;
    border-radius:7px;
    font-size:8px;
    font-weight:700;
    color:#475569
}

.nav a:hover,
.nav a.active{
    background:#f1f5f9;
    color:#111827
}

.header-actions{
    display:flex;
    gap:7px;
    align-items:center
}

.dashboard-btn{
    background:#111827;
    color:#fff;
    border-radius:8px;
    padding:10px 13px;
    font-size:8px;
    font-weight:800
}


/* =========================
   CONTAINER
========================= */

.container{
    max-width:1180px;
    margin:auto;
    padding:35px 20px
}


/* =========================
   PAGE HEADER
========================= */

.page-header{
    margin-bottom:25px
}

.breadcrumb{
    display:flex;
    gap:7px;
    color:#64748b;
    font-size:7px;
    margin-bottom:10px
}

.page-header h1{
    font-size:28px;
    letter-spacing:-1px
}

.page-header p{
    color:#64748b;
    font-size:9px;
    margin-top:5px
}


/* =========================
   SUMMARY
========================= */

.summary{
    background:#fff;
    border:1px solid #e5e7eb;
    border-radius:14px;
    padding:24px;
    display:grid;
    grid-template-columns:180px 1fr 220px;
    gap:25px;
    align-items:center;
    margin-bottom:18px
}

.average{
    text-align:center
}

.average-number{
    font-size:42px;
    line-height:1;
    font-weight:900
}

.stars{
    margin:7px 0;
    letter-spacing:2px;
    font-size:14px
}

.average small{
    color:#64748b;
    font-size:7px
}

.rating-bars{
    display:flex;
    flex-direction:column;
    gap:6px
}

.rating-row{
    display:grid;
    grid-template-columns:40px 1fr 35px;
    align-items:center;
    gap:7px;
    font-size:7px
}

.rating-row .bar{
    height:7px;
    border-radius:20px;
    background:#e5e7eb;
    overflow:hidden
}

.rating-row .fill{
    height:100%;
    border-radius:20px;
    background:#f59e0b
}

.review-stats{
    border-left:1px solid #e5e7eb;
    padding-left:20px
}

.stat{
    margin-bottom:11px
}

.stat:last-child{
    margin-bottom:0
}

.stat strong{
    display:block;
    font-size:14px
}

.stat span{
    color:#64748b;
    font-size:7px
}


/* =========================
   FILTERS
========================= */

.filters{
    background:#fff;
    border:1px solid #e5e7eb;
    border-radius:12px;
    padding:14px;
    display:grid;
    grid-template-columns:1.5fr 180px 160px 140px;
    gap:9px;
    margin-bottom:18px
}

.input,
.select{
    width:100%;
    border:1px solid #dbe2ea;
    background:#fff;
    border-radius:8px;
    padding:10px 11px;
    outline:0;
    font-size:8px
}

.input:focus,
.select:focus{
    border-color:#64748b
}


/* =========================
   REVIEW LIST
========================= */

.list-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:10px
}

.list-header strong{
    font-size:11px
}

.result-count{
    color:#64748b;
    font-size:7px
}

.reviews{
    display:flex;
    flex-direction:column;
    gap:10px
}

.review{
    background:#fff;
    border:1px solid #e5e7eb;
    border-radius:12px;
    padding:17px;
    transition:.2s
}

.review:hover{
    box-shadow:
        0 10px 25px
        rgba(15,23,42,.06)
}

.review-top{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:15px
}

.reviewer{
    display:flex;
    gap:10px;
    align-items:center
}

.avatar{
    width:38px;
    height:38px;
    border-radius:50%;
    background:#e2e8f0;
    display:grid;
    place-items:center;
    font-size:10px;
    font-weight:900
}

.reviewer strong{
    display:block;
    font-size:8px
}

.reviewer span{
    display:block;
    color:#64748b;
    font-size:7px;
    margin-top:2px
}

.review-rating{
    text-align:right
}

.review-rating .stars{
    font-size:10px;
    margin:0
}

.review-rating time{
    display:block;
    color:#94a3b8;
    font-size:6px;
    margin-top:3px
}

.review-title{
    margin-top:12px;
    font-size:9px;
    font-weight:900
}

.review-text{
    margin-top:5px;
    color:#475569;
    font-size:8px;
    line-height:1.7
}

.review-service{
    display:inline-flex;
    margin-top:11px;
    padding:5px 8px;
    border-radius:20px;
    background:#f1f5f9;
    color:#475569;
    font-size:6px;
    font-weight:800
}

.review-footer{
    margin-top:13px;
    padding-top:11px;
    border-top:1px solid #eef2f7;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px
}

.helpful{
    border:1px solid #e2e8f0;
    background:#fff;
    border-radius:7px;
    padding:7px 9px;
    font-size:7px
}

.verified{
    color:#16a34a;
    font-size:7px;
    font-weight:800
}


/* =========================
   EMPTY
========================= */

.empty{
    display:none;
    text-align:center;
    background:#fff;
    border:1px solid #e5e7eb;
    border-radius:12px;
    padding:45px 20px;
    color:#64748b;
    font-size:8px
}

.empty-icon{
    font-size:30px;
    margin-bottom:8px
}


/* =========================
   PAGINATION
========================= */

.pagination{
    display:flex;
    justify-content:center;
    gap:5px;
    margin-top:20px
}

.page-btn{
    min-width:32px;
    height:32px;
    border:1px solid #dbe2ea;
    background:#fff;
    border-radius:7px;
    font-size:7px;
    font-weight:800
}

.page-btn.active{
    background:#111827;
    color:#fff;
    border-color:#111827
}


/* =========================
   CTA
========================= */

.cta{
    margin-top:30px;
    border-radius:14px;
    padding:28px;
    background:#111827;
    color:#fff;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px
}

.cta h2{
    font-size:18px
}

.cta p{
    color:#cbd5e1;
    font-size:8px;
    margin-top:5px
}

.cta a{
    background:#fff;
    color:#111827;
    padding:10px 14px;
    border-radius:8px;
    font-size:8px;
    font-weight:900;
    white-space:nowrap
}


/* =========================
   FOOTER
========================= */

.footer{
    margin-top:30px;
    background:#111827;
    color:#fff;
    padding:35px 20px 20px
}

.footer-inner{
    max-width:1180px;
    margin:auto
}

.footer-grid{
    display:grid;
    grid-template-columns:2fr repeat(3,1fr);
    gap:25px
}

.footer h3{
    font-size:9px;
    margin-bottom:7px
}

.footer a,
.footer p{
    display:block;
    color:#94a3b8;
    font-size:7px;
    line-height:2
}

.footer-bottom{
    border-top:1px solid #263244;
    margin-top:25px;
    padding-top:14px;
    color:#64748b;
    font-size:7px;
    display:flex;
    justify-content:space-between
}


/* =========================
   TOAST
========================= */

.toast{
    position:fixed;
    left:50%;
    bottom:20px;
    transform:translate(-50%,20px);
    opacity:0;
    visibility:hidden;
    background:#111827;
    color:#fff;
    padding:10px 14px;
    border-radius:8px;
    font-size:8px;
    z-index:3000;
    transition:.2s
}

.toast.show{
    opacity:1;
    visibility:visible;
    transform:translate(-50%,0)
}


/* =========================
   RESPONSIVE
========================= */

@media(max-width:900px){

    .nav{
        display:none
    }

    .summary{
        grid-template-columns:1fr 1fr
    }

    .review-stats{
        grid-column:1/-1;
        border-left:0;
        border-top:1px solid #e5e7eb;
        padding:
            15px 0 0
    }

    .filters{
        grid-template-columns:1fr 1fr
    }

}

@media(max-width:600px){

    .container{
        padding:25px 12px
    }

    .summary{
        grid-template-columns:1fr
    }

    .average{
        padding-bottom:15px;
        border-bottom:1px solid #e5e7eb
    }

    .review-stats{
        display:grid;
        grid-template-columns:repeat(3,1fr);
        gap:10px
    }

    .filters{
        grid-template-columns:1fr
    }

    .review-top{
        display:block
    }

    .review-rating{
        text-align:left;
        margin-top:8px
    }

    .cta{
        display:block
    }

    .cta a{
        display:inline-block;
        margin-top:13px
    }

    .footer-grid{
        grid-template-columns:1fr 1fr
    }

    .footer-bottom{
        display:block
    }

}

</style>
</head>

