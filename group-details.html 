<script type="module">

import {
  initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";


import {
  getAuth,
  onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-auth.js";


import {
  getDatabase,
  ref,
  get,
  set,
  remove,
  push
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-database.js";


/* =========================
   FIREBASE CONFIG
========================= */

const firebaseConfig = {

  apiKey:
  "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
  "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
  "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
  "let-s-study-pro-course",

  storageBucket:
  "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
  "474928293390",

  appId:
  "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
  "G-85B7V5H5J0"

};


const app =
initializeApp(
  firebaseConfig
);

const auth =
getAuth(app);

const db =
getDatabase(app);


/* =========================
   ELEMENTS
========================= */

const loading =
document.getElementById(
  "loading"
);

const content =
document.getElementById(
  "content"
);

const message =
document.getElementById(
  "message"
);

const joinBtn =
document.getElementById(
  "joinBtn"
);

const postFormCard =
document.getElementById(
  "postFormCard"
);

const postText =
document.getElementById(
  "postText"
);

const postBtn =
document.getElementById(
  "postBtn"
);

const postsElement =
document.getElementById(
  "posts"
);

const membersElement =
document.getElementById(
  "members"
);


let currentUser =
null;

let currentGroup =
null;


/* =========================
   GROUP ID
========================= */

const params =
new URLSearchParams(
window.location.search
);

const groupId =
params.get(
"groupId"
) ||
params.get(
"id"
);


/* =========================
   MESSAGE
========================= */

function showMessage(
text,
type
){

  message.textContent =
  text;

  message.className =
  "message " +
  type;

  setTimeout(
    () => {

      message.className =
      "message";

    },
    3500
  );

}


/* =========================
   ESCAPE
========================= */

function escapeHTML(
value
){

  return String(
    value ?? ""
  )
  .replace(
    /&/g,
    "&amp;"
  )
  .replace(
    /</g,
    "&lt;"
  )
  .replace(
    />/g,
    "&gt;"
  )
  .replace(
    /"/g,
    "&quot;"
  )
  .replace(
    /'/g,
    "&#039;"
  );

}


/* =========================
   FORMAT DATE
========================= */

function formatDate(
value
){

  if(!value){
    return "Recently";
  }

  const d =
  new Date(
    Number(value)
  );

  if(
    Number.isNaN(
      d.getTime()
    )
  ){

    return "Recently";

  }

  return d.toLocaleString(
    "en-TZ",
    {
      dateStyle:"medium",
      timeStyle:"short"
    }
  );

}


/* =========================
   LOAD GROUP
========================= */

async function loadGroup(){

  if(!groupId){

    loading.textContent =
    "Group ID is missing.";

    return;

  }


  try{

    const snapshot =
    await get(
      ref(
        db,
        "groups/" +
        groupId
      )
    );


    if(
      !snapshot.exists()
    ){

      loading.textContent =
      "Study group not found.";

      return;

    }


    currentGroup =
    snapshot.val();


    renderGroup();


    await loadPosts();

    await loadMembers();


    loading.style.display =
    "none";

    content.style.display =
    "block";


  }catch(error){

    console.error(
      error
    );

    loading.textContent =
    "Unable to load group.";

  }

}


/* =========================
   RENDER GROUP
========================= */

function renderGroup(){

  document.getElementById(
    "groupName"
  ).textContent =
  currentGroup.name ||
  "Study Group";


  document.getElementById(
    "groupDescription"
  ).textContent =
  currentGroup.description ||
  "Study and learn together.";


  document.getElementById(
    "groupCategory"
  ).textContent =
  currentGroup.category ||
  "General";


  document.getElementById(
    "privacyTag"
  ).textContent =
  currentGroup.isPrivate
  ? "Private"
  : "Public";


  document.getElementById(
    "memberCount"
  ).textContent =
  Number(
    currentGroup.membersCount ||
    currentGroup.memberCount ||
    0
  );


  updateJoinButton();

}


/* =========================
   JOIN STATUS
========================= */

function isMember(){

  if(
    !currentUser ||
    !currentGroup ||
    !currentGroup.members
  ){

    return false;

  }


  return Boolean(
    currentGroup.members[
      currentUser.uid
    ]
  );

}


/* =========================
   JOIN BUTTON
========================= */

function updateJoinButton(){

  if(
    isMember()
  ){

    joinBtn.textContent =
    "Leave Group";

    joinBtn.classList.add(
      "leave"
    );

    postFormCard.style.display =
    "block";

  }else{

    joinBtn.textContent =
    "Join Group";

    joinBtn.classList.remove(
      "leave"
    );

    postFormCard.style.display =
    "none";

  }

}


/* =========================
   JOIN / LEAVE
========================= */

joinBtn.addEventListener(
  "click",
  async function(){

    if(!currentUser){

      window.location.href =
      "/login.html?redirect=" +
      encodeURIComponent(
        "group-details.html?id=" +
        groupId
      );

      return;

    }


    try{

      const memberRef =
      ref(
        db,
        "groups/" +
        groupId +
        "/members/" +
        currentUser.uid
      );


      if(
        isMember()
      ){

        await remove(
          memberRef
        );


        const count =
        Math.max(
          0,
          Number(
            currentGroup.membersCount ||
            0
          ) - 1
        );


        await set(
          ref(
            db,
            "groups/" +
            groupId +
            "/membersCount"
          ),
          count
        );


        showMessage(
          "You left the group.",
          "success"
        );


      }else{

        await set(
          memberRef,
          {

            uid:
            currentUser.uid,

            email:
            currentUser.email ||
            "",

            joinedAt:
            Date.now()

          }
        );


        const count =
        Number(
          currentGroup.membersCount ||
          0
        ) + 1;


        await set(
          ref(
            db,
            "groups/" +
            groupId +
            "/membersCount"
          ),
          count
        );


        showMessage(
          "You joined the group successfully.",
          "success"
        );

      }


      const fresh =
      await get(
        ref(
          db,
          "groups/" +
          groupId
        )
      );


      if(
        fresh.exists()
      ){

        currentGroup =
        fresh.val();

        renderGroup();

        await loadMembers();

      }


    }catch(error){

      console.error(
        error
      );

      showMessage(
        "Unable to update group membership.",
        "error"
      );

    }

  }
);


/* =========================
   LOAD MEMBERS
========================= */

async function loadMembers(){

  const members =
  currentGroup.members ||
  {};


  const entries =
  Object.entries(
    members
  );


  membersElement.innerHTML =
  "";


  if(
    entries.length === 0
  ){

    membersElement.innerHTML =
    `<div class="empty">
       No members yet.
     </div>`;

    return;

  }


  const limited =
  entries.slice(
    0,
    20
  );


  limited.forEach(
    ([uid,member]) => {

      const item =
      document.createElement(
        "div"
      );

      item.className =
      "member";


      const email =
      member.email ||
      "Student";


      const name =
      email.split("@")[0];


      const initials =
      name
      .substring(0,2)
      .toUpperCase();


      const role =
      uid ===
      currentGroup.ownerId
      ? "Group Owner"
      : "Member";


      item.innerHTML = `

        <div class="member-avatar">
          ${escapeHTML(
            initials
          )}
        </div>

        <div class="member-info">

          <div class="member-name">
            ${escapeHTML(
              name
            )}
          </div>

          <div class="member-role">
            ${role}
          </div>

        </div>

      `;


      membersElement.appendChild(
        item
      );

    }
  );

}


/* =========================
   LOAD POSTS
========================= */

async function loadPosts(){

  const snapshot =
  await get(
    ref(
      db,
      "groups/" +
      groupId +
      "/posts"
    )
  );


  postsElement.innerHTML =
  "";


  if(
    !snapshot.exists()
  ){

    postsElement.innerHTML =
    `<div class="empty">
       No discussions yet.
     </div>`;

    document.getElementById(
      "postCount"
    ).textContent =
    "0";

    return;

  }


  const data =
  snapshot.val();


  const entries =
  Object.entries(
    data
  )
  .map(
    ([id,post]) => ({
      id,
      ...post
    })
  )
  .sort(
    (a,b) =>
    Number(
      b.createdAt || 0
    ) -
    Number(
      a.createdAt || 0
    )
  );


  document.getElementById(
    "postCount"
  ).textContent =
  entries.length;


  entries.forEach(
    post => {

      const item =
      document.createElement(
        "article"
      );

      item.className =
      "post";


      const email =
      post.userEmail ||
      "Student";


      const name =
      email.split("@")[0];


      const initials =
      name
      .substring(0,2)
      .toUpperCase();


      item.innerHTML = `

        <div class="post-head">

          <div class="avatar">
            ${escapeHTML(
              initials
            )}
          </div>

          <div>

            <div class="post-user">
              ${escapeHTML(
                name
              )}
            </div>

            <div class="post-date">
              ${escapeHTML(
                formatDate(
                  post.createdAt
                )
              )}
            </div>

          </div>

        </div>

        <div class="post-text">
          ${escapeHTML(
            post.text ||
            ""
          )}
        </div>

      `;


      postsElement.appendChild(
        item
      );

    }
  );

}


/* =========================
   CREATE POST
========================= */

postBtn.addEventListener(
  "click",
  async function(){

    if(!currentUser){

      showMessage(
        "Please login first.",
        "error"
      );

      return;

    }


    if(
      !isMember()
    ){

      showMessage(
        "Join the group before posting.",
        "error"
      );

      return;

    }


    const text =
    postText.value.trim();


    if(!text){

      showMessage(
        "Write something before posting.",
        "error"
      );

      return;

    }


    postBtn.disabled =
    true;

    postBtn.textContent =
    "Posting...";


    try{

      const postsRef =
  push(
    ref(
      db,
      "groups/" +
      groupId +
      "/posts"
    )
  );

await set(
  postsRef,
  {
    userId:
      currentUser.uid,

    userEmail:
      currentUser.email || "",

    text:
      text,

    createdAt:
      Date.now()
  }
);

postText.value = "";

showMessage(
  "Discussion posted successfully.",
  "success"
);

await loadPosts();

} catch(error) {

  console.error(
    "Post error:",
    error
  );

  showMessage(
    "Unable to post discussion. Please try again.",
    "error"
  );

}

postBtn.disabled = false;

postBtn.textContent =
  "Post Discussion";

});