<script type="module">


import {
  initializeApp
} from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";


import {
  getAuth,
  onAuthStateChanged
} from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";


import {
  getFirestore,
  collection,
  doc,
  getDoc,
  getDocs,
  query,
  where,
  orderBy,
  limit,
  addDoc,
  deleteDoc,
  serverTimestamp
} from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


/* ==========================================
   FIREBASE CONFIG
========================================== */

// For Firebase JS SDK v7.20.0 and later, measurementId is optional
const firebaseConfig = {
  apiKey: "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",
  authDomain: "let-s-study-pro-course.firebaseapp.com",
  databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
  projectId: "let-s-study-pro-course",
  storageBucket: "let-s-study-pro-course.firebasestorage.app",
  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
};

const app =
  initializeApp(
    firebaseConfig
  );


const auth =
  getAuth(app);


const db =
  getFirestore(app);



/* ==========================================
   STATE
========================================== */

let currentUser = null;

let currentGroup = null;

let currentGroupId = "";

let isMember = false;



/* ==========================================
   URL ROUTING
========================================== */

const params =
  new URLSearchParams(
    location.search
  );


let groupId =
  params.get("id") ||
  params.get("groupId") ||
  "";


let groupSlug =
  params.get("slug") ||
  "";



/*
 * Also supports:
 *
 * /group-details.html
 * /group-details.html?id=ABC
 * /group-details.html?groupId=ABC
 * /group-details.html?slug=biology
 * /biology-study-group.html
 */

if(!groupSlug){

  const parts =
    location.pathname
      .split("/")
      .filter(Boolean);


  const last =
    parts[
      parts.length - 1
    ] || "";


  if(
    last &&
    !last.includes(
      "group-details"
    ) &&
    last.endsWith(
      ".html"
    )
  ){

    groupSlug =
      last
        .replace(
          /\.html$/i,
          ""
        )
        .toLowerCase();

  }

}



/* ==========================================
   HELPERS
========================================== */

function escapeHtml(
  value
){

  return String(
    value ?? ""
  )
    .replace(
      /&/g,
      "&amp;"
    )
    .replace(
      /</g,
      "&lt;"
    )
    .replace(
      />/g,
      "&gt;"
    )
    .replace(
      /"/g,
      "&quot;"
    )
    .replace(
      /'/g,
      "&#039;"
    );

}


function createSlug(
  text
){

  return String(
    text || ""
  )
    .normalize(
      "NFD"
    )
    .replace(
      /[\u0300-\u036f]/g,
      ""
    )
    .toLowerCase()
    .trim()
    .replace(
      /[^a-z0-9]+/g,
      "-"
    )
    .replace(
      /^-+|-+$/g,
      "");

}


function formatNumber(
  value
){

  return new Intl.NumberFormat(
    "en-US"
  ).format(
    Number(
      value || 0
    )
  );

}


function formatDate(
  value
){

  if(!value){
    return "-";
  }

  try{

    const date =
      value.toDate
        ? value.toDate()
        : new Date(
            value
          );

    return date.toLocaleDateString(
      "en-US",
      {
        year:"numeric",
        month:"short",
        day:"numeric"
      }
    );

  }catch{

    return "-";

  }

}


function showToast(
  text
){

  const toast =
    document.getElementById(
      "toast"
    );

  toast.textContent =
    text;

  toast.style.display =
    "block";

  setTimeout(
    () => {

      toast.style.display =
        "none";

    },
    2500
  );

}



/* ==========================================
   LOAD GROUP
========================================== */

async function loadGroup(){

  try{

    let snap = null;


    /*
     * 1. Direct Firestore ID
     */

    if(groupId){

      snap =
        await getDoc(
          doc(
            db,
            "groups",
            groupId
          )
        );

    }


    /*
     * 2. Search by slug
     */

    if(
      (!snap || !snap.exists()) &&
      groupSlug
    ){

      const q =
        query(
          collection(
            db,
            "groups"
          ),
          where(
            "slug",
            "==",
            groupSlug
          ),
          limit(1)
        );


      const result =
        await getDocs(q);


      if(
        !result.empty
      ){

        snap =
          result.docs[0];

      }

    }


    /*
     * 3. Legacy fallback
     */

    if(
      (!snap || !snap.exists()) &&
      groupSlug
    ){

      const result =
        await getDocs(
          query(
            collection(
              db,
              "groups"
            ),
            limit(300)
          )
        );


      const wanted =
        groupSlug
          .toLowerCase();


      const found =
        result.docs.find(
          item => {

            const data =
              item.data();


            const savedSlug =
              String(
                data.slug ||
                ""
              )
              .toLowerCase();


            const nameSlug =
              createSlug(
                data.name ||
                data.title ||
                ""
              );


            return(
              savedSlug === wanted ||
              nameSlug === wanted
            );

          }
        );


      if(found){

        snap =
          found;

      }

    }


    if(
      !snap ||
      !snap.exists()
    ){

      throw new Error(
        "Group was not found."
      );

    }


    currentGroupId =
      snap.id;


    currentGroup =
      {
        id:snap.id,
        ...snap.data()
      };


    renderGroup();

    await loadPosts();

    await loadMembers();


  }catch(error){

    console.error(
      error
    );

    showError(
      error.message
    );

  }

}



/* ==========================================
   RENDER GROUP
========================================== */

function renderGroup(){

  const data =
    currentGroup;


  const name =
    data.name ||
    data.title ||
    "Community Group";


  const description =
    data.description ||
    "Welcome to this LetsStudy Pro community group.";


  const slug =
    data.slug ||
    createSlug(
      name
    );


  const category =
    data.category ||
    "General";


  const creator =
    data.creatorName ||
    data.ownerName ||
    "LetsStudy Member";


  const visibility =
    data.visibility ||
    "public";


  const cover =
    data.coverImage ||
    data.coverUrl ||
    "";


  const avatar =
    data.imageUrl |

      data.imageURL ||
    data.avatar ||
    data.photoURL ||
    "";

  const cover =
    data.coverImage ||
    data.coverUrl ||
    data.bannerUrl ||
    "";

  const slug =
    data.slug ||
    createSlug(
      name
    );

  const category =
    data.category ||
    "General";

  const creator =
    data.creatorName ||
    data.ownerName ||
    data.createdByName ||
    "LetsStudy Pro Member";

  const visibility =
    data.visibility ||
    "public";

  const status =
    data.status ||
    "Active";


  /* =====================================
     PAGE SEO
  ===================================== */

  document.title =
    `${name} | LetsStudy Pro Community`;


  const metaDescription =
    document.getElementById(
      "metaDescription"
    );

  if(metaDescription){

    metaDescription.content =
      description;

  }


  /* =====================================
     BASIC GROUP INFORMATION
  ===================================== */

  document
    .getElementById("groupName")
    .textContent =
      name;


  document
    .getElementById("groupSlug")
    .textContent =
      "/" + slug;


  document
    .getElementById("groupDescription")
    .textContent =
      description;


  document
    .getElementById("groupCategory")
    .textContent =
      category;


  document
    .getElementById("groupCreator")
    .textContent =
      creator;


  document
    .getElementById("groupCreated")
    .textContent =
      formatDate(
        data.createdAt
      );


  document
    .getElementById("groupVisibility")
    .textContent =
      visibility;


  document
    .getElementById("groupStatus")
    .textContent =
      status;


  /* =====================================
     COVER IMAGE
  ===================================== */

  const coverElement =
    document.getElementById(
      "cover"
    );


  if(
    coverElement &&
    cover
  ){

    coverElement.style.backgroundImage =
      `url("${cover}")`;

  }


  /* =====================================
     GROUP AVATAR
  ===================================== */

  const avatarElement =
    document.getElementById(
      "groupAvatar"
    );


  if(
    avatarElement
  ){

    if(avatar){

      avatarElement.innerHTML = `

        <img
          src="${escapeHtml(
            avatar
          )}"
          alt="${escapeHtml(
            name
          )}"
          loading="lazy"
        >

      `;

    }else{

      avatarElement.innerHTML = `

        <span>
          ${escapeHtml(
            name
              .charAt(0)
              .toUpperCase()
          )}
        </span>

      `;

    }

  }


  /* =====================================
     GROUP PAGE URL
  ===================================== */

  const cleanGroupUrl =
    `${location.origin}/${slug}.html`;


  /* =====================================
     OPEN GROUP SHARE URL
  ===================================== */

  const shareButton =
    document.getElementById(
      "shareBtn"
    );


  if(shareButton){

    shareButton.onclick =
      async () => {

        try{

          if(
            navigator.share
          ){

            await navigator.share({

              title:
                `${name} | LetsStudy Pro`,

              text:
                description,

              url:
                cleanGroupUrl

            });

          }else{

            await navigator.clipboard.writeText(
              cleanGroupUrl
            );

            showToast(
              "Group link copied."
            );

          }

        }catch(error){

          console.log(
            "Share cancelled:",
            error
          );

        }

      };

  }


  /* =====================================
     CREATE POST LINK
  ===================================== */

  const createPostLink =
    document.getElementById(
      "createPostLink"
    );


  if(createPostLink){

    createPostLink.href =
      `create-post.html?groupId=${encodeURIComponent(
        currentGroupId
      )}`;

  }


  /* =====================================
     SHOW PAGE
  ===================================== */

  const loading =
    document.getElementById(
      "loading"
    );

  const groupPage =
    document.getElementById(
      "groupPage"
    );


  if(loading){

    loading.style.display =
      "none";

  }


  if(groupPage){

    groupPage.style.display =
      "block";

  }


  /* =====================================
     CHECK MEMBERSHIP
  ===================================== */

  if(currentUser){

    await checkMembership();

  }else{

    isMember =
      false;

    updateJoinButton();

  }

}



/* =========================================
   CHECK GROUP MEMBERSHIP
========================================= */

async function checkMembership(){

  if(
    !currentUser ||
    !currentGroupId
  ){

    isMember =
      false;

    updateJoinButton();

    return;

  }


  try{

    const memberRef =
      doc(
        db,
        "groups",
        currentGroupId,
        "members",
        currentUser.uid
      );


    const memberSnap =
      await getDoc(
        memberRef
      );


    isMember =
      memberSnap.exists();


    updateJoinButton();


  }catch(error){

    console.error(
      "Membership error:",
      error
    );

    isMember =
      false;

    updateJoinButton();

  }

}



/* =========================================
   JOIN / LEAVE BUTTON
========================================= */

function updateJoinButton(){

  const button =
    document.getElementById(
      "joinBtn"
    );


  if(!button){

    return;

  }


  if(isMember){

    button.className =
      "btn btn-danger";

    button.innerHTML = `

      <i class="fa-solid fa-user-minus"></i>

      Leave Group

    `;

  }else{

    button.className =
      "btn btn-primary";

    button.innerHTML = `

      <i class="fa-solid fa-user-plus"></i>

      Join Group

    `;

  }

}



/* =========================================
   JOIN / LEAVE ACTION
========================================= */

const joinButton =
  document.getElementById(
    "joinBtn"
  );


if(joinButton){

  joinButton.addEventListener(
    "click",
    async () => {

      if(!currentUser){

        const redirect =
          encodeURIComponent(
            location.href
          );

        location.href =
          `login.html?redirect=${redirect}`;

        return;

      }


      try{

        const memberRef =
          doc(
            db,
            "groups",
            currentGroupId,
            "members",
            currentUser.uid
          );


        if(isMember){

          await deleteDoc(
            memberRef
          );

          isMember =
            false;

          showToast(
            "You left this group."
          );

        }else{

          await setDoc(
            memberRef,
            {

              uid:
                currentUser.uid,

              userId:
                currentUser.uid,

              displayName:
                currentUser.displayName ||
                "LetsStudy Member",

              photoURL:
                currentUser.photoURL ||
                "",

              role:
                "member",

              joinedAt:
                serverTimestamp()

            },
            {
              merge:true
            }
          );


          isMember =
            true;

          showToast(
            "You joined this group."
          );

        }


        updateJoinButton();

        await loadMembers();


      }catch(error){

        console.error(
          "Join/leave error:",
          error
        );

        showToast(
          "Unable to update membership."
        );

      }

    }
  );

}



/* =========================================
   LOAD MEMBERS
========================================= */

async function loadMembers(){

  const container =
    document.getElementById(
      "members"
    );


  if(!container){

    return;

  }


  try{

    const membersQuery =
      query(
        collection(
          db,
          "groups",
          currentGroupId,
          "members"
        ),
        limit(20)
      );


    const snapshot =
      await getDocs(
        membersQuery
      );


    const count =
      document.getElementById(
        "memberCount"
      );


    if(count){

      count.textContent =
        formatNumber(
          snapshot.size
        );

    }


    if(snapshot.empty){

      container.innerHTML = `

        <div class="empty">

          <i class="fa-solid fa-users"></i>

          <p>
            No members yet.
          </p>

        </div>

      `;

      return;

    }


    container.innerHTML =
      snapshot.docs
        .map(
          memberDoc => {

            const member =
              memberDoc.data();


            const memberName =
              member.displayName ||
              member.name ||
              "LetsStudy Member";


            const memberPhoto =
              member.photoURL ||
              member.imageUrl ||
              member.avatar ||
              "";


            return `

              <div class="member">

                <div class="member-avatar">

                  ${
                    memberPhoto
                      ? `
                        <img
                          src="${escapeHtml(
                            memberPhoto
                          )}"
                          alt="${escapeHtml(
                            memberName
                          )}"
                          loading="lazy"
                        >
                      `
                      : `
                        ${escapeHtml(
                          memberName
                            .charAt(0)
                            .toUpperCase()
                        )}
                      `
                  }

                </div>


                <div>

                  <div class="member-name">

                    ${escapeHtml(
                      memberName
                    )}

                  </div>


                  <div class="member-role">

                    ${escapeHtml(
                      member.role ||
                      "Member"
                    )}

                  </div>

                </div>

              </div>

            `;

          }
        )
        .join("");


  }catch(error){

    console.error(
      "Members error:",
      error
    );


    container.innerHTML = `

      <div class="empty">

        <i class="fa-solid fa-triangle-exclamation"></i>

        <p>
          Unable to load members.
        </p>

      </div>

    `;

  }

}



/* =========================================
   LOAD GROUP POSTS
========================================= */

async function loadPosts(){

  const container =
    document.getElementById(
      "posts"
    );


  if(!container){

    return;

  }


  try{

    let snapshot;


    try{

      snapshot =
        await getDocs(
          query(
            collection(
              db,
              "posts"
            ),
            where(
              "groupId",
              "==",
              currentGroupId
            ),
            orderBy(
              "createdAt",
              "desc"
            ),
            limit(30)
          )
        );

    }catch(error){

      console.warn(
        "Ordered posts query failed. Using fallback.",
        error
      );


      snapshot =
        await getDocs(
          query(
            collection(
              db,
              "posts"
            ),
            where(
              "groupId",
              "==",
              currentGroupId
            ),
            limit(30)
          )
        );

    }


    const postCount =
      document.getElementById(
        "postCount"
      );


    if(postCount){

      postCount.textContent =
        formatNumber(
          snapshot.size
        );

    }


    if(snapshot.empty){

      container.innerHTML = `

        <div class="empty">

          <i class="fa-solid fa-newspaper"></i>

          <p>
            No posts have been published
            in this group yet.
          </p>

        </div>

      `;

      return;

    }


    const posts =
      snapshot.docs
        .map(
          postDoc => ({
            id:
              postDoc.id,

            data:
              postDoc.data()
          })
        )
        .sort(
          (a,b) => {

            const aTime =
              a.data.createdAt?.seconds ||
              0;

            const bTime =
              b.data.createdAt?.seconds ||
              0;

            return bTime - aTime;

          }
        );


    container.innerHTML =
      posts
        .map(
          post => renderPost(
            post.id,
            post.data
          )
        )
        .join("");


  }catch(error){

    console.error(
      "Posts error:",
      error
    );


    container.innerHTML = `

      <div class="empty">

        <i class="fa-solid fa-triangle-exclamation"></i>

        <p>
          Unable to load group posts.
        </p>

      </div>

    `;

  }

}



/* =========================================
   RENDER POST
========================================= */

function renderPost(
  postId,
  data
){

  const title =
    data.title ||
    data.name ||
    "Untitled Post";


  const content =
    data.content ||
    data.description ||
    "";


  const author =
    data.authorName ||
    data.displayName ||
    data.userName ||
    "LetsStudy Member";


  const authorPhoto =
    data.authorPhotoURL ||
    data.authorPhoto ||
    data.photoURL ||
    data.avatar ||
    "";


  const image =
    data.imageUrl ||
    data.imageURL ||
    data.thumbnail ||
    "";


  const slug =
    data.slug ||
    createSlug(
      title
    );


  /*
   * IMPORTANT:
   * Post details supports both ID
   * and clean slug.
   */

  const postUrl =
    `post-details.html?postId=${encodeURIComponent(
      postId
    )}`;


  return `

    <article class="post">

      <div class="post-header">


        <div class="post-avatar">

          ${
            authorPhoto
              ? `
                <img
                  src="${escapeHtml(
                    authorPhoto
                  )}"
                  alt="${escapeHtml(
                    author
                  )}"
                >
              `
              : `
                ${escapeHtml(
                  author
                    .charAt(0)
                    .toUpperCase()
                )}
              `
          }

        </div>


        <div>

          <div class="post-author">

            ${escapeHtml(
              author
            )}

          </div>


          <div class="post-date">

            ${formatDate(
              data.createdAt
            )}

          </div>

        </div>

      </div>


      <a
        href="${postUrl}"
      >

        <h2 class="post-title">

          ${escapeHtml(
            title
          )}

        </h2>

      </a>


      <div class="post-content">

        ${escapeHtml(
          content.length > 600
            ? content.substring(
                0,
                600
              ) + "..."
            : content
        )}

      </div>


      ${
        image
          ? `

            <img
              class="post-image"
              src="${escapeHtml(
                image
              )}"
              alt="${escapeHtml(
                title
              )}"
              loading="lazy"
            >

          `
          : ""
      }


      <div class="post-actions">

        <span>

          <i class="fa-regular fa-heart"></i>

          ${formatNumber(
            data.likesCount ||
            data.likes
          )}

        </span>


        <span>

          <i class="fa-regular fa-comment"></i>

          ${formatNumber(
            data.commentsCount ||
            data.comments
          )}

        </span>


        <span>

          <i class="fa-solid fa-eye"></i>

          ${formatNumber(
            data.views
          )}

        </span>

      </div>

    </article>

  `;

}



/* =========================================
   TOAST
========================================= */

function showToast(
  message
){

  const toast =
    document.getElementById(
      "toast"
    );


  if(!toast){

    return;

  }


  toast.textContent =
    message;


  toast.style.display =
    "block";


  clearTimeout(
    window.__toastTimer
  );


  window.__toastTimer =
    setTimeout(
      () => {

        toast.style.display =
          "none";

      },
      3000
    );

}



/* =========================================
   ERROR
========================================= */

function showError(
  message
){

  const loading =
    document.getElementById(
      "loading"
    );


  const groupPage =
    document.getElementById(
      "groupPage"
    );


  const errorBox =
    document.getElementById(
      "error"
    );


  const errorText =
    document.getElementById(
      "errorText"
    );


  if(loading){

    loading.style.display =
      "none";

  }


  if(groupPage){

    groupPage.style.display =
      "none";

  }


  if(errorBox){

    errorBox.style.display =
      "block";

  }


  if(errorText){

    errorText.textContent =
      message ||
      "Group not found.";

  }

}



/* =========================================
   AUTH + START
========================================= */

onAuthStateChanged(
  auth,
  async user => {

    currentUser =
      user || null;


    try{

      await loadGroup();

      await loadPosts();

      await loadMembers();

      if(currentUser){

        await checkMembership();

      }

    }catch(error){

      console.error(
        error
      );

    }

  }
);

</script>

