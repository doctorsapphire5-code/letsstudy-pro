<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
>

<title>Group Members | Let'sStudy Pro Community</title>

<meta
  name="description"
  content="View members of a Let'sStudy Pro Community group."
>

<link
  rel="icon"
  href="/favicon.ico"
>

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

:root{
  --bg:#f6f8fb;
  --card:#fff;
  --text:#172033;
  --muted:#64748b;
  --border:#e2e8f0;
  --soft:#f1f5f9;
  --primary:#111827;
}

body{
  min-height:100vh;

  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  background:var(--bg);
  color:var(--text);
}


/* =========================
   HEADER
========================= */

.topbar{

  min-height:64px;

  position:sticky;
  top:0;
  z-index:100;

  display:flex;
  align-items:center;
  justify-content:space-between;

  gap:15px;

  padding:0 20px;

  background:
    rgba(255,255,255,.96);

  backdrop-filter:blur(12px);

  border-bottom:
    1px solid var(--border);

}

.brand{

  display:flex;
  align-items:center;
  gap:10px;

  font-weight:800;

}

.brand-icon{

  width:38px;
  height:38px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:11px;

  background:var(--primary);
  color:#fff;

}

.back-btn{

  border:0;

  padding:9px 13px;

  border-radius:10px;

  background:var(--soft);

  color:var(--text);

  font-size:12px;

  font-weight:750;

  cursor:pointer;

}


/* =========================
   MAIN
========================= */

.container{

  width:100%;
  max-width:850px;

  margin:auto;

  padding:28px 16px 70px;

}

.hero{

  margin-bottom:20px;

}

.hero h1{

  font-size:29px;
  font-weight:850;

}

.hero p{

  margin-top:6px;

  color:var(--muted);

  font-size:13px;

}


/* =========================
   GROUP INFO
========================= */

.group-info{

  display:flex;

  align-items:center;

  gap:13px;

  padding:15px;

  margin-bottom:15px;

  background:#fff;

  border:
    1px solid var(--border);

  border-radius:15px;

}

.group-icon{

  width:48px;
  height:48px;

  display:flex;

  align-items:center;
  justify-content:center;

  border-radius:13px;

  background:var(--soft);

  font-size:24px;

  flex-shrink:0;

}

.group-name{

  font-size:14px;
  font-weight:850;

}

.group-meta{

  margin-top:4px;

  color:var(--muted);

  font-size:10px;

}


/* =========================
   CONTROLS
========================= */

.controls{

  margin-bottom:16px;

}

.search{

  width:100%;

  height:44px;

  padding:
    0 13px;

  border:
    1px solid var(--border);

  border-radius:11px;

  outline:none;

  background:#fff;

  color:var(--text);

  font-family:inherit;

  font-size:13px;

}

.search:focus{

  border-color:#64748b;

}


/* =========================
   MEMBERS
========================= */

.members{

  display:flex;

  flex-direction:column;

  gap:9px;

}

.member{

  display:flex;

  align-items:center;

  gap:12px;

  padding:13px 14px;

  background:#fff;

  border:
    1px solid var(--border);

  border-radius:14px;

}

.avatar{

  width:48px;
  height:48px;

  flex-shrink:0;

  display:flex;

  align-items:center;
  justify-content:center;

  overflow:hidden;

  border-radius:50%;

  background:var(--soft);

  font-size:13px;

  font-weight:800;

}

.avatar img{

  width:100%;
  height:100%;

  object-fit:cover;

}

.member-info{

  min-width:0;

  flex:1;

}

.name{

  font-size:13px;

  font-weight:800;

  overflow:hidden;

  text-overflow:ellipsis;

  white-space:nowrap;

}

.username{

  margin-top:3px;

  color:var(--muted);

  font-size:10px;

}

.badges{

  display:flex;

  align-items:center;

  gap:6px;

  margin-top:6px;

  flex-wrap:wrap;

}

.badge{

  padding:
    3px 7px;

  border-radius:6px;

  background:var(--soft);

  color:var(--muted);

  font-size:9px;

  font-weight:800;

  text-transform:capitalize;

}

.badge.owner{

  background:#fef3c7;
  color:#92400e;

}

.badge.admin{

  background:#ede9fe;
  color:#6d28d9;

}

.badge.moderator{

  background:#dbeafe;
  color:#1d4ed8;

}

.badge.active{

  background:#dcfce7;
  color:#166534;

}

.badge.pending{

  background:#fef3c7;
  color:#92400e;

}

.badge.blocked{

  background:#fee2e2;
  color:#b91c1c;

}

.joined{

  color:var(--muted);

  font-size:10px;

  white-space:nowrap;

}


/* =========================
   LOADING
========================= */

.loading{

  text-align:center;

  padding:50px;

  color:var(--muted);

}

.spinner{

  width:31px;
  height:31px;

  margin:
    0 auto
    10px;

  border:
    3px solid var(--border);

  border-top-color:
    var(--primary);

  border-radius:50%;

  animation:
    spin .7s linear infinite;

}

@keyframes spin{

  to{
    transform:rotate(360deg);
  }

}


/* =========================
   EMPTY
========================= */

.empty{

  text-align:center;

  padding:55px 20px;

  background:#fff;

  border:
    1px solid var(--border);

  border-radius:15px;

  color:var(--muted);

}

.empty-icon{

  font-size:40px;

  margin-bottom:9px;

}

.empty h3{

  color:var(--text);

  margin-bottom:5px;

  font-size:16px;

}


/* =========================
   ERROR
========================= */

.error{

  display:none;

  padding:12px;

  margin-bottom:15px;

  border-radius:10px;

  background:#fef2f2;

  border:
    1px solid #fecaca;

  color:#b91c1c;

  font-size:12px;

}

.error.show{

  display:block;

}


/* =========================
   LOAD MORE
========================= */

.load-more{

  display:block;

  margin:20px auto 0;

  padding:10px 18px;

  border:0;

  border-radius:10px;

  background:var(--primary);

  color:#fff;

  font-size:12px;

  font-weight:750;

  cursor:pointer;

}

.load-more:disabled{

  opacity:.5;

}


/* =========================
   MOBILE
========================= */

@media(max-width:600px){

  .topbar{

    padding:0 12px;

  }

  .brand{

    font-size:13px;

  }

  .container{

    padding:
      22px 11px
      60px;

  }

  .hero h1{

    font-size:24px;

  }

  .member{

    padding:12px;

  }

  .joined{

    display:none;

  }

}

</style>

</head>


<body>


<!-- =========================
     HEADER
========================= -->

<header class="topbar">

  <div class="brand">

    <div class="brand-icon">
      👥
    </div>

    <span>
      Let'sStudy Pro Community
    </span>

  </div>


  <button
    class="back-btn"
    type="button"
    onclick="goBack()"
  >
    ← Back
  </button>

</header>


<!-- =========================
     MAIN
========================= -->

<main class="container">


  <section class="hero">

    <h1>
      Group Members
    </h1>

    <p>
      Connect with members of this
      Community Group.
    </p>

  </section>


  <div
    id="errorBox"
    class="error"
  ></div>


  <!-- GROUP INFO -->

  <section
    id="groupInfo"
    class="group-info"
    style="display:none"
  >

    <div
      id="groupIcon"
      class="group-icon"
    >
      👥
    </div>

    <div>

      <div
        id="groupName"
        class="group-name"
      >
        Community Group
      </div>

      <div
        id="groupMeta"
        class="group-meta"
      >
        Members
      </div>

    </div>

  </section>


  <!-- SEARCH -->

  <section class="controls">

    <input
      id="searchInput"
      class="search"
      type="search"
      placeholder="Search members..."
      autocomplete="off"
    >

  </section>


  <!-- LOADING -->

  <div
    id="loading"
    class="loading"
  >

    <div class="spinner"></div>

    <p>
      Loading members...
    </p>

  </div>


  <!-- MEMBERS -->

  <section
    id="members"
    class="members"
  ></section>


  <!-- EMPTY -->

  <section
    id="empty"
    class="empty"
    style="display:none"
  >

    <div class="empty-icon">
      👥
    </div>

    <h3>
      No members found
    </h3>

    <p>
      There are no members matching
      your search.
    </p>

  </section>


  <!-- LOAD MORE -->

  <button
    id="loadMore"
    class="load-more"
    type="button"
    style="display:none"
  >
    Load More
  </button>


</main>


<!-- =========================
     FIREBASE
========================= -->

<script src="https://www.gstatic.com/firebasejs/10.12.5/firebase-app-compat.js"></script>

<script src="https://www.gstatic.com/firebasejs/10.12.5/firebase-auth-compat.js"></script>

<script src="https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore-compat.js"></script>


<script>

/* =========================
   FIREBASE CONFIG
========================= */

const firebaseConfig = {

  apiKey:
    "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-85B7V5H5J0"

};


firebase.initializeApp(
  firebaseConfig
);


const db =
  firebase.firestore();


/* =========================
   URL
========================= */

const params =
  new URLSearchParams(
    window.location.search
  );


const groupId =
  params.get("groupId") ||
  params.get("id");


/* =========================
   STATE
========================= */

let members =
  [];

let lastDocument =
  null;

const PAGE_SIZE =
  25;


/* =========================
   HELPERS
========================= */

function escapeHTML(
  value
){

  return String(
    value ?? ""
  )
  .replaceAll(
    "&",
    "&amp;"
  )
  .replaceAll(
    "<",
    "&lt;"
  )
  .replaceAll(
    ">",
    "&gt;"
  )
  .replaceAll(
    '"',
    "&quot;"
  )
  .replaceAll(
    "'",
    "&#039;"
  );

}


function getInitials(
  name
){

  return String(
    name ||
    "Member"
  )
  .trim()
  .split(/\s+/)
  .slice(0,2)
  .map(
    word =>
      word
        .charAt(0)
        .toUpperCase()
  )
  .join("");

}


function formatDate(
  timestamp
){

  if(!timestamp){

    return "Recently";

  }


  try{

    const date =
      timestamp.toDate
        ? timestamp.toDate()
        : new Date(timestamp);


    return date.toLocaleDateString(
      undefined,
      {
        day:"numeric",
        month:"short",
        year:"numeric"
      }
    );

  }

  catch{

    return "Recently";

  }

}


/* =========================
   ERROR
========================= */

function showError(
  message
){

  const box =
    document.getElementById(
      "errorBox"
    );

  box.textContent =
    message;

  box.classList.add(
    "show"
  );

}


/* =========================
   LOAD GROUP
========================= */

async function loadGroup(){

  if(!groupId){

    return;

  }


  try{

    const snapshot =
      await db
        .collection("groups")
        .doc(groupId)
        .get();


    if(!snapshot.exists){

      return;

    }


    const data =
      snapshot.data();


    document.getElementById(
      "groupInfo"
    ).style.display =
      "flex";


    document.getElementById(
      "groupName"
    ).textContent =
      data.name ||
      "Community Group";


    document.getElementById(
      "groupIcon"
    ).textContent =
      data.icon ||
      "👥";


    const count =
      Number(
        data.memberCount || 0
      );


    document.getElementById(
      "groupMeta"
    ).textContent =
      `${count} ${
        count === 1
          ? "member"
          : "members"
      }`;

  }

  catch(error){

    console.error(
      "Group error:",
      error
    );

  }

}


/* =========================
   LOAD MEMBERS
========================= */

async function loadMembers(
  append = false
){

  const loading =
    document.getElementById(
      "loading"
    );


  try{

    if(!append){

      loading.style.display =
        "block";

    }


    let query =
      db
        .collection(
          "groupMembers"
        )
        .where(
          "groupId",
          "==",
          groupId
        )
        .where(
          "status",
          "==",
          "active"
        )
        .orderBy(
          "joinedAt",
          "asc"
        )
        .limit(
          PAGE_SIZE
        );


    if(
      append &&
      lastDocument
    ){

      query =
        query.startAfter(
          lastDocument
        );

    }


    const snapshot =
      await query.get();


    loading.style.display =
      "none";


    if(
      snapshot.empty &&
      !append
    ){

      document.getElementById(
        "empty"
      ).style.display =
        "block";

      return;

    }


    if(
      !snapshot.empty
    ){

      lastDocument =
        snapshot.docs[
          snapshot.docs.length - 1
        ];

    }


    for(
      const doc of snapshot.docs
    ){

      members.push({

        id:
          doc.id,

        ...doc.data()

      });

    }


    await renderMembers();


    if(
      snapshot.size <
      PAGE_SIZE
    ){

      document.getElementById(
        "loadMore"
      ).style.display =
        "none";

    }

    else{

      document.getElementById(
        "loadMore"
      ).style.display =
        "block";

    }

  }

  catch(error){

    console.error(
      "Members error:",
      error
    );


    loading.style.display =
      "none";


    showError(
      "Unable to load group members. Firestore may require a composite index."
    );

  }

}


/* =========================
   RENDER MEMBERS
========================= */

async function renderMembers(){

  const container =
    document.getElementById(
      "members"
    );


  const search =
    document
      .getElementById(
        "searchInput"
      )
      .value
      .trim()
      .toLowerCase();


  container.innerHTML =
    "";


  const filtered =
    members.filter(
      member => {

        const user =
          member.userData ||
          {};


        const name =
          String(
            user.displayName ||
            ""
          ).toLowerCase();


        const username =
          String(
            user.username ||
            ""
          ).toLowerCase();


        return (
          !search ||
          name.includes(search) ||
          username.includes(search)
        );

      }
    );


  if(!filtered.length){

    document.getElementById(
      "empty"
    ).style.display =
      "block";

    return;

  }


  document.getElementById(
    "empty"
  ).style.display =
    "none";


  for(
    const member of filtered
  ){

    if(
      !member.userData
    ){

      member.userData =
        await getUser(
          member.userId
        );

    }


    renderMember(
      member
    );

  }

}


/* =========================
   GET USER
========================= */

async function getUser(
  userId
){

  if(!userId){

    return {};

  }


  try{

    const snapshot =
      await db
        .collection("users")
        .doc(userId)
        .get();


    if(
      snapshot.exists
    ){

      return snapshot.data();

    }

  }

  catch(error){

    console.error(
      "User error:",
      error
    );

  }


  return {};

}


/* =========================
   RENDER MEMBER
========================= */

function renderMember(
  member
){

  const container =
    document.getElementById(
      "members"
    );


  const user =
    member.userData ||
    {};


  const name =
    user.displayName ||
    user.username ||
    "Community Member";


  const username =
    user.username
      ? `@${user.username}`
      : "Community Member";


  const photo =
    user.photoURL ||
    "";


  const role =
    member.role ||
    "member";


  const status =
    member.status ||
    "active";


  const element =
    document.createElement(
      "article"
    );


  element.className =
    "member";


  const avatar =
    photo

      ? `
        <img
          src="${escapeHTML(
            photo
          )}"
          alt="${escapeHTML(
            name
          )}"
          loading="lazy"
          referrerpolicy="no-referrer"
        >
      `

      : getInitials(
          name
        );


  element.innerHTML =
    `
      <div class="avatar">

        ${avatar}

      </div>


      <div class="member-info">

        <div class="name">

          ${escapeHTML(
            name
          )}

        </div>


        <div class="username">

          ${escapeHTML(
            username
          )}

        </div>


        <div class="badges">

          <span
            class="badge ${escapeHTML(
              role
            )}"
          >

            ${escapeHTML(
              role
            )}

          </span>


          <span
            class="badge ${escapeHTML(
              status
            )}"
          >

            ${escapeHTML(
              status
            )}

          </span>

        </div>

      </div>


      <div class="joined">

        Joined
        ${formatDate(
          member.joinedAt
        )}

      </div>
    `;


  container.appendChild(
    element
  );

}


/* =========================
   SEARCH
========================= */

document
  .getElementById(
    "searchInput"
  )
  .addEventListener(
    "input",
    () => {

      renderMembers();

    }
  );


/* =========================
   LOAD MORE
========================= */

document
  .getElementById(
    "loadMore"
  )
  .addEventListener(
    "click",
    async () => {

      const button =
        document.getElementById(
          "loadMore"
        );


      button.disabled =
        true;


      button.textContent =
        "Loading...";


      await loadMembers(
        true
      );


      button.disabled =
        false;


      button.textContent =
        "Load More";

    }
  );


/* =========================
   BACK
========================= */

function goBack(){

  if(
    document.referrer &&
    document.referrer.startsWith(
      window.location.origin
    )
  ){

    window.history.back();

  }

  else{

    window.location.href =
      "groups-community.html";

  }

}


/* =========================
   INIT
========================= */

async function init(){

  if(!groupId){

    document.getElementById(
      "loading"
    ).style.display =
      "none";

    showError(
      "Missing group ID. Use ?groupId=GROUP_ID"
    );

    return;

  }


  await loadGroup();

  await loadMembers();

}


init();


/* =========================
   GLOBAL ERROR
========================= */

window.addEventListener(
  "unhandledrejection",
  event => {

    console.error(
      "Unhandled Community error:",
      event.reason
    );

  }
);

</script>

</body>

</html>