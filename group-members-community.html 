<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Group Members | LetsStudy Pro</title>

<meta
  name="description"
  content="View community group members on LetsStudy Pro."
>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
}

header{
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  padding:15px 6%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  position:sticky;
  top:0;
  z-index:10;
}

.logo{
  font-size:21px;
  font-weight:800;
}

.logo span{
  color:#2563eb;
}

.back{
  border:0;
  background:#eef2f7;
  padding:10px 15px;
  border-radius:8px;
  cursor:pointer;
}

.container{
  width:92%;
  max-width:900px;
  margin:30px auto;
}

.card{
  background:#fff;
  border-radius:16px;
  padding:22px;
  box-shadow:0 5px 25px #0000000a;
}

.header-info{
  margin-bottom:20px;
}

h1{
  font-size:27px;
  margin-bottom:6px;
}

.subtitle{
  color:#64748b;
}

.search{
  margin:18px 0;
}

.search input{
  width:100%;
  padding:13px;
  border:1px solid #dbe2ea;
  border-radius:9px;
  outline:none;
  font-size:15px;
}

.count{
  color:#64748b;
  font-size:13px;
  margin-bottom:12px;
}

.list{
  display:flex;
  flex-direction:column;
  gap:10px;
}

.member{
  display:flex;
  align-items:center;
  gap:12px;
  padding:13px;
  border:1px solid #e5e7eb;
  border-radius:11px;
}

.avatar{
  width:50px;
  height:50px;
  border-radius:50%;
  background:#2563eb;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
  overflow:hidden;
  flex-shrink:0;
}

.avatar img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.info{
  flex:1;
  min-width:0;
}

.name{
  font-weight:700;
}

.username{
  color:#64748b;
  font-size:13px;
  margin-top:3px;
}

.role{
  display:inline-block;
  margin-top:5px;
  padding:4px 7px;
  border-radius:6px;
  background:#eff6ff;
  color:#2563eb;
  font-size:11px;
}

.view{
  border:0;
  background:#eef2f7;
  padding:8px 11px;
  border-radius:8px;
  cursor:pointer;
}

.loading,
.empty{
  text-align:center;
  padding:45px 15px;
  color:#64748b;
}

.error{
  color:#b91c1c;
}
</style>
</head>

<body>

<header>

  <div class="logo">
    LetsStudy <span>Pro</span>
  </div>

  <button
    class="back"
    onclick="history.back()"
  >
    Back
  </button>

</header>


<main class="container">

  <div class="card">

    <div class="header-info">

      <h1>
        Group Members
      </h1>

      <p class="subtitle">
        Members of this community group.
      </p>

    </div>


    <div class="search">

      <input
        id="search"
        type="search"
        placeholder="Search members..."
        autocomplete="off"
      >

    </div>


    <div
      id="count"
      class="count"
    >
      Loading...
    </div>


    <div
      id="list"
      class="list"
    >

      <div class="loading">
        Loading members...
      </div>

    </div>

  </div>

</main>


<script>

/*
==================================================
GROUP-MEMBERS-COMMUNITY.HTML

PUBLIC PAGE

URL:
group-members-community.html?groupId=GROUP_ID

The page first loads the selected group:

GET /api/data?collection=groups&id=GROUP_ID

Then it reads members from the public group
document when members are stored as an array.

Supported fields:

members
memberIds
users

Member object examples:

{
  id,
  uid,
  userId,
  name,
  displayName,
  username,
  photoURL,
  role
}

NO ADMIN
NO DIRECT FIRESTORE
==================================================
*/


const params =
  new URLSearchParams(
    location.search
  );


const groupId =
  params.get("groupId") ||
  params.get("id") ||
  params.get("documentId");


const list =
  document.getElementById(
    "list"
  );

const count =
  document.getElementById(
    "count"
  );

const search =
  document.getElementById(
    "search"
  );


let members = [];


/* =========================
   VALIDATE
========================= */

if(!groupId){

  list.innerHTML = `

    <div class="empty error">

      No group was selected.

    </div>

  `;

  count.textContent = "";

}else{

  loadGroup();

}


/* =========================
   LOAD GROUP
========================= */

async function loadGroup(){

  try{

    const response =
      await fetch(
        "/api/data?collection=groups&id=" +
        encodeURIComponent(
          groupId
        )
      );


    const result =
      await response.json();


    if(!response.ok){

      throw new Error(
        result.error ||
        "Unable to load group"
      );

    }


    if(!result.data){

      throw new Error(
        "Group not found"
      );

    }


    const group =
      result.data;


    /*
      Read members from the group
      document.
    */

    if(
      Array.isArray(
        group.members
      )
    ){

      members =
        group.members;

    }else if(
      Array.isArray(
        group.users
      )
    ){

      members =
        group.users;

    }else if(
      Array.isArray(
        group.memberIds
      )
    ){

      members =
        group.memberIds.map(
          id => ({
            id
          })
        );

    }else{

      members = [];

    }


    render();


  }catch(error){

    console.error(
      "GROUP MEMBERS:",
      error
    );


    list.innerHTML = `

      <div class="empty error">

        Unable to load members.

        <br><br>

        ${escapeHTML(
          error.message
        )}

      </div>

    `;

    count.textContent = "";

  }

}


/* =========================
   RENDER
========================= */

function render(){

  const keyword =
    search.value
      .trim()
      .toLowerCase();


  const filtered =
    members.filter(
      member => {

        const name =
          member.name ||
          member.displayName ||
          member.username ||
          "";


        const username =
          member.username ||
          "";


        const role =
          member.role ||
          "";


        const text =
          (
            name +
            " " +
            username +
            " " +
            role
          ).toLowerCase();


        return (
          !keyword ||
          text.includes(
            keyword
          )
        );

      }
    );


  count.textContent =
    filtered.length +
    (
      filtered.length === 1
      ? " member"
      : " members"
    );


  if(!filtered.length){

    list.innerHTML = `

      <div class="empty">

        ${
          members.length
          ? "No members match your search."
          : "This group has no public members."
        }

      </div>

    `;

    return;

  }


  list.innerHTML =
    filtered
      .map(
        createMember
      )
      .join("");

}


/* =========================
   MEMBER CARD
========================= */

function createMember(
  member
){

  const id =
    member.id ||
    member.uid ||
    member.userId ||
    "";


  const name =
    member.name ||
    member.displayName ||
    member.username ||
    "Member";


  const username =
    member.username
      ? "@" +
        String(
          member.username
        ).replace(/^@/,"")
      : "";


  const photo =
    safeImage(
      member.photoURL ||
      member.photo ||
      member.avatar
    );


  const role =
    member.role ||
    "";


  const initial =
    String(name)
      .trim()
      .charAt(0)
      .toUpperCase() ||
    "M";


  return `

    <article class="member">

      <div class="avatar">

        ${
          photo
          ? `

            <img
              src="${photo}"
              alt="${escapeAttr(name)}"
              loading="lazy"
            >

          `
          : escapeHTML(initial)
        }

      </div>


      <div class="info">

        <div class="name">

          ${escapeHTML(name)}

        </div>


        ${
          username
          ? `

            <div class="username">

              ${escapeHTML(username)}

            </div>

          `
          : ""
        }


        ${
          role
          ? `

            <span class="role">

              ${escapeHTML(role)}

            </span>

          `
          : ""
        }

      </div>


      ${
        id
        ? `

          <button
            class="view"
            data-id="${escapeAttr(id)}"
          >
            View
          </button>

        `
        : ""
      }

    </article>

  `;

}


/* =========================
   SEARCH
========================= */

search.addEventListener(
  "input",
  render
);


/* =========================
   PROFILE
========================= */

list.addEventListener(
  "click",
  event => {

    const button =
      event.target.closest(
        ".view"
      );


    if(!button) return;


    const id =
      button.dataset.id;


    if(!id) return;


    location.href =
      "profile.html?id=" +
      encodeURIComponent(id);

  }
);


/* =========================
   SECURITY
========================= */

function safeImage(url){

  if(!url) return "";


  try{

    const parsed =
      new URL(
        String(url),
        location.origin
      );


    if(
      parsed.protocol === "https:" ||
      parsed.protocol === "http:"
    ){

      return escapeAttr(
        parsed.href
      );

    }

  }catch(error){}


  return "";

}


function escapeHTML(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


function escapeAttr(value){

  return escapeHTML(value)
    .replace(/`/g,"&#096;");

}

</script>

</body>
</html>