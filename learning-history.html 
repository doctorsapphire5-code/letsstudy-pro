<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Learning History | LetsStudy Pro</title>

<meta name="description"
content="View your learning history, course progress and completed lessons on LetsStudy Pro.">

<meta name="theme-color"
content="#2563eb">

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:
  Inter,
  system-ui,
  -apple-system,
  "Segoe UI",
  sans-serif;

  background:#f8fafc;
  color:#0f172a;
}

a{
  text-decoration:none;
}

button{
  font:inherit;
  cursor:pointer;
}


/* =========================
   NAVBAR
========================= */

.navbar{
  background:#fff;
  border-bottom:1px solid #e2e8f0;

  position:sticky;
  top:0;
  z-index:1000;
}

.nav-container{
  max-width:1100px;
  min-height:68px;

  margin:auto;
  padding:0 20px;

  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  display:flex;
  align-items:center;
  gap:9px;

  color:#2563eb;

  font-size:19px;
  font-weight:800;
}

.logo-icon{
  width:38px;
  height:38px;

  display:flex;
  align-items:center;
  justify-content:center;

  background:#2563eb;
  color:#fff;

  border-radius:10px;

  font-size:13px;
  font-weight:900;
}

.nav-links{
  display:flex;
  gap:20px;
}

.nav-links a{
  color:#475569;
  font-size:13px;
  font-weight:600;
}

.menu-btn{
  display:none;

  border:0;
  background:none;

  font-size:25px;
}


/* =========================
   MAIN
========================= */

.container{
  max-width:1050px;

  margin:35px auto;

  padding:0 20px;
}

.page-header{
  margin-bottom:24px;
}

.page-header h1{
  font-size:28px;
  margin-bottom:7px;
}

.page-header p{
  color:#64748b;
  font-size:13px;
}


/* =========================
   SUMMARY
========================= */

.summary-grid{
  display:grid;

  grid-template-columns:
  repeat(
    3,
    1fr
  );

  gap:14px;

  margin-bottom:25px;
}

.summary-card{
  background:#fff;

  border:1px solid #e2e8f0;

  border-radius:14px;

  padding:18px;
}

.summary-icon{
  font-size:22px;
  margin-bottom:8px;
}

.summary-number{
  font-size:23px;
  font-weight:900;
}

.summary-label{
  color:#64748b;
  font-size:11px;
  margin-top:3px;
}


/* =========================
   HISTORY HEADER
========================= */

.history-header{
  display:flex;

  align-items:center;
  justify-content:space-between;

  margin-bottom:13px;
}

.history-header h2{
  font-size:18px;
}

.filter{
  border:
  1px solid #cbd5e1;

  background:#fff;

  padding:8px 10px;

  border-radius:8px;

  font-size:11px;

  outline:none;
}


/* =========================
   HISTORY LIST
========================= */

.history-list{
  display:flex;
  flex-direction:column;

  gap:13px;
}

.history-card{
  background:#fff;

  border:1px solid #e2e8f0;

  border-radius:15px;

  padding:18px;

  display:flex;

  gap:15px;

  align-items:center;
}

.course-icon{
  width:58px;
  height:58px;

  flex-shrink:0;

  border-radius:12px;

  background:#dbeafe;
  color:#2563eb;

  display:flex;
  align-items:center;
  justify-content:center;

  font-size:24px;
}

.course-info{
  flex:1;
  min-width:0;
}

.course-title{
  font-size:15px;
  font-weight:800;

  margin-bottom:4px;
}

.course-meta{
  color:#64748b;
  font-size:10px;

  display:flex;
  flex-wrap:wrap;

  gap:10px;

  margin-bottom:9px;
}

.progress-row{
  display:flex;

  align-items:center;

  gap:9px;
}

.progress{
  flex:1;

  height:7px;

  background:#e2e8f0;

  border-radius:999px;

  overflow:hidden;
}

.progress-bar{
  height:100%;

  background:#2563eb;

  border-radius:999px;
}

.progress-value{
  min-width:35px;

  text-align:right;

  font-size:10px;

  font-weight:800;
}

.history-action{
  border:0;

  background:#eff6ff;

  color:#2563eb;

  padding:9px 12px;

  border-radius:8px;

  font-size:10px;

  font-weight:800;
}

.history-action:hover{
  background:#dbeafe;
}


/* =========================
   COMPLETED
========================= */

.completed-badge{
  display:inline-block;

  margin-top:7px;

  padding:4px 8px;

  background:#dcfce7;

  color:#166534;

  border-radius:999px;

  font-size:9px;

  font-weight:900;
}


/* =========================
   EMPTY
========================= */

.empty{
  background:#fff;

  border:1px solid #e2e8f0;

  border-radius:15px;

  padding:45px 20px;

  text-align:center;
}

.empty-icon{
  font-size:40px;

  margin-bottom:10px;
}

.empty h3{
  font-size:17px;

  margin-bottom:6px;
}

.empty p{
  color:#64748b;

  font-size:12px;
}


/* =========================
   LOADING
========================= */

.loading{
  text-align:center;

  padding:35px;

  color:#64748b;

  font-size:13px;
}


/* =========================
   LOGIN
========================= */

.login-box{
  max-width:500px;

  margin:70px auto;

  padding:35px 20px;

  background:#fff;

  border:
  1px solid #e2e8f0;

  border-radius:16px;

  text-align:center;
}

.login-box h2{
  margin-bottom:7px;
}

.login-box p{
  color:#64748b;

  font-size:12px;

  margin-bottom:18px;
}

.login-btn{
  display:inline-block;

  background:#2563eb;

  color:#fff;

  padding:11px 20px;

  border-radius:8px;

  font-size:12px;

  font-weight:800;
}


/* =========================
   FOOTER
========================= */

footer{
  text-align:center;

  padding:30px;

  color:#94a3b8;

  font-size:11px;
}


/* =========================
   MOBILE
========================= */

@media(max-width:700px){

  .nav-links{
    display:none;
  }

  .menu-btn{
    display:block;
  }

  .summary-grid{
    grid-template-columns:1fr;
  }

  .history-card{
    align-items:flex-start;
  }

  .history-action{
    display:none;
  }

  .page-header h1{
    font-size:24px;
  }

}

</style>

</head>


