<!-- =========================
     FIREBASE
========================= -->

<script type="module">

import {
  initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";


import {
  getAuth,
  onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-auth.js";


import {
  getDatabase,
  ref,
  get
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-database.js";


/* =========================
   FIREBASE CONFIG
========================= */

const firebaseConfig = {

  apiKey:
  "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
  "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
  "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
  "let-s-study-pro-course",

  storageBucket:
  "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
  "474928293390",

  appId:
  "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
  "G-85B7V5H5J0"

};


const app =
initializeApp(
  firebaseConfig
);

const auth =
getAuth(app);

const db =
getDatabase(app);


/* =========================
   ELEMENTS
========================= */

const loginBox =
document.getElementById(
  "loginBox"
);

const mainContent =
document.getElementById(
  "mainContent"
);

const loading =
document.getElementById(
  "loading"
);

const historyList =
document.getElementById(
  "historyList"
);

const empty =
document.getElementById(
  "empty"
);

const filter =
document.getElementById(
  "filter"
);

const totalCourses =
document.getElementById(
  "totalCourses"
);

const completedCourses =
document.getElementById(
  "completedCourses"
);

const completedLessons =
document.getElementById(
  "completedLessons"
);


let historyData = [];


/* =========================
   ESCAPE HTML
========================= */

function escapeHTML(value){

  return String(
    value ?? ""
  )

  .replace(
    /&/g,
    "&amp;"
  )

  .replace(
    /</g,
    "&lt;"
  )

  .replace(
    />/g,
    "&gt;"
  )

  .replace(
    /"/g,
    "&quot;"
  )

  .replace(
    /'/g,
    "&#039;"
  );

}


/* =========================
   FORMAT DATE
========================= */

function formatDate(timestamp){

  if(!timestamp){

    return "Never";

  }

  const date =
  new Date(timestamp);

  if(
    Number.isNaN(
      date.getTime()
    )
  ){

    return "—";

  }

  return date.toLocaleDateString(
    "en-US",
    {
      year:"numeric",
      month:"short",
      day:"numeric"
    }
  );

}


/* =========================
   LOAD HISTORY
========================= */

async function loadHistory(user){

  loading.style.display =
  "block";

  historyList.innerHTML =
  "";

  empty.style.display =
  "none";


  try{

    /*
      Expected structure:

      learningHistory/
        USER_UID/
          COURSE_ID/
            courseTitle
            progress
            completedLessons
            totalLessons
            lastAccessed
            completed
    */

    const snapshot =
    await get(
      ref(
        db,
        "learningHistory/" +
        user.uid
      )
    );


    loading.style.display =
    "none";


    if(
      !snapshot.exists()
    ){

      historyData = [];

      updateSummary();

      empty.style.display =
      "block";

      return;

    }


    historyData = [];


    snapshot.forEach(
      child => {

        historyData.push({

          id:
          child.key,

          ...child.val()

        });

      }
    );


    historyData.sort(
      (a,b) =>
      (b.lastAccessed || 0) -
      (a.lastAccessed || 0)
    );


    updateSummary();

    renderHistory();


  }catch(error){

    console.error(
      "Learning history error:",
      error
    );

    loading.textContent =
    "Unable to load learning history.";

  }

}


/* =========================
   SUMMARY
========================= */

function updateSummary(){

  const total =
  historyData.length;


  const completed =
  historyData.filter(
    item =>
    item.completed === true ||
    Number(item.progress || 0) >= 100
  ).length;


  const lessons =
  historyData.reduce(
    (sum,item) =>
    sum +
    Number(
      item.completedLessons || 0
    ),
    0
  );


  totalCourses.textContent =
  total;


  completedCourses.textContent =
  completed;


  completedLessons.textContent =
  lessons;

}


/* =========================
   RENDER HISTORY
========================= */

function renderHistory(){

  historyList.innerHTML =
  "";


  let data =
  [...historyData];


  const selected =
  filter.value;


  if(
    selected ===
    "completed"
  ){

    data =
    data.filter(
      item =>
      item.completed === true ||
      Number(item.progress || 0) >= 100
    );

  }


  if(
    selected ===
    "progress"
  ){

    data =
    data.filter(
      item =>
      Number(item.progress || 0) < 100
    );

  }


  if(
    data.length === 0
  ){

    empty.style.display =
    "block";

    return;

  }


  empty.style.display =
  "none";


  data.forEach(
    item => {

      renderHistoryItem(
        item
      );

    }
  );

}


/* =========================
   RENDER ITEM
========================= */

function renderHistoryItem(item){

  const card =
  document.createElement(
    "article"
  );

  card.className =
  "history-card";


  let progress =
  Number(
    item.progress || 0
  );


  progress =
  Math.max(
    0,
    Math.min(
      100,
      progress
    )
  );


  const completed =
  item.completed === true ||
  progress >= 100;


  const courseTitle =
  item.courseTitle ||
  "Untitled Course";


  const completedLessonCount =
  Number(
    item.completedLessons || 0
  );


  const totalLessonCount =
  Number(
    item.totalLessons || 0
  );


  const lastAccessed =
  formatDate(
    item.lastAccessed
  );


  card.innerHTML = `

    <div class="course-icon">
      📘
    </div>


    <div class="course-info">

      <div class="course-title">

        ${escapeHTML(courseTitle)}

      </div>


      <div class="course-meta">

        <span>
          📖
          ${completedLessonCount}
          ${
            totalLessonCount
            ? " / " +
              totalLessonCount
            : ""
          }
          lessons
        </span>

        <span>
          🕒
          Last studied:
          ${escapeHTML(lastAccessed)}
        </span>

      </div>


      <div class="progress-row">

        <div class="progress">

          <div
          class="progress-bar"
          style="width:${progress}%">

          </div>

        </div>


        <div class="progress-value">

          ${progress}%

        </div>

      </div>


      ${
        completed

        ?

        `<span class="completed-badge">

          ✓ Course Completed

        </span>`

        :

        ""

      }

    </div>


    <button
    class="history-action">

      ${
        completed
        ? "View Certificate"
        : "Continue"
      }

    </button>

  `;


  const action =
  card.querySelector(
    ".history-action"
  );


  action.addEventListener(
    "click",
    () => {

      if(completed){

        window.location.href =
        "/student-certificate.html";

      }else{

        window.location.href =
        "/course-progress.html?id=" +
        encodeURIComponent(
          item.courseId ||
          item.id
        );

      }

    }
  );


  historyList.appendChild(
    card
  );

}


/* =========================
   FILTER
========================= */

filter.addEventListener(
  "change",
  renderHistory
);


/* =========================
   AUTH
========================= */

onAuthStateChanged(
  auth,
  async user => {

    if(!user){

      loginBox.style.display =
      "block";

      mainContent.style.display =
      "none";

      return;

    }


    loginBox.style.display =
    "none";

    mainContent.style.display =
    "block";


    await loadHistory(
      user
    );

  }
);


/* =========================
   MOBILE MENU
========================= */

document
.getElementById(
  "menuBtn"
)
.addEventListener(
  "click",
  () => {

    document
    .querySelector(
      ".nav-links"
    )
    .classList.toggle(
      "active"
    );

  }
);

</script>

</body>

