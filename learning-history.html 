<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Learning History | LetsStudy Pro</title>

<meta name="description"
content="View your learning history, course progress and completed lessons on LetsStudy Pro.">

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
}

header{
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  padding:15px 6%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  position:sticky;
  top:0;
  z-index:10;
}

.logo{
  font-size:21px;
  font-weight:800;
  text-decoration:none;
  color:#172033;
}

.logo span{
  color:#2563eb;
}

.back{
  border:0;
  background:#eef2f7;
  padding:10px 15px;
  border-radius:8px;
  cursor:pointer;
}

.container{
  width:92%;
  max-width:1000px;
  margin:30px auto;
}

.hero{
  background:#fff;
  padding:28px 22px;
  border-radius:16px;
  margin-bottom:20px;
}

.hero h1{
  font-size:29px;
  margin-bottom:7px;
}

.hero p{
  color:#64748b;
}

.stats{
  display:grid;
  grid-template-columns:
    repeat(3,1fr);
  gap:12px;
  margin-top:20px;
}

.stat{
  background:#fff;
  padding:18px;
  border-radius:13px;
  border:1px solid #e5e7eb;
}

.stat strong{
  display:block;
  font-size:23px;
  margin-bottom:4px;
}

.stat span{
  color:#64748b;
  font-size:12px;
}

.toolbar{
  background:#fff;
  padding:15px;
  border-radius:13px;
  margin-bottom:15px;
}

.search{
  width:100%;
  padding:12px;
  border:1px solid #dbe2ea;
  border-radius:8px;
  outline:none;
  font-size:15px;
}

.list{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.item{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:14px;
  padding:18px;
}

.top{
  display:flex;
  justify-content:space-between;
  gap:15px;
}

.title{
  font-size:17px;
  font-weight:800;
}

.meta{
  color:#64748b;
  font-size:12px;
  margin-top:5px;
}

.progress{
  height:8px;
  background:#e5e7eb;
  border-radius:20px;
  overflow:hidden;
  margin:15px 0 8px;
}

.progress-bar{
  height:100%;
  background:#2563eb;
  width:0;
}

.progress-text{
  display:flex;
  justify-content:space-between;
  font-size:12px;
  color:#64748b;
}

.status{
  padding:5px 8px;
  border-radius:7px;
  font-size:11px;
  white-space:nowrap;
  height:max-content;
  background:#eff6ff;
  color:#2563eb;
}

.status.completed{
  background:#ecfdf5;
  color:#047857;
}

.view{
  margin-top:14px;
  border:0;
  background:#2563eb;
  color:#fff;
  padding:9px 13px;
  border-radius:8px;
  cursor:pointer;
  font-weight:700;
}

.loading,
.empty{
  background:#fff;
  padding:50px 20px;
  border-radius:14px;
  text-align:center;
  color:#64748b;
}

.error{
  color:#b91c1c;
}

@media(max-width:650px){

  .stats{
    grid-template-columns:1fr;
  }

  .top{
    flex-direction:column;
  }

}
</style>
</head>

<body>

<header>

  <a
    href="index.html"
    class="logo"
  >
    LetsStudy <span>Pro</span>
  </a>

  <button
    class="back"
    onclick="history.back()"
  >
    Back
  </button>

</header>


<main class="container">

  <section class="hero">

    <h1>
      Learning History
    </h1>

    <p>
      Track your courses, lessons and learning progress.
    </p>


    <div class="stats">

      <div class="stat">
        <strong id="coursesCount">0</strong>
        <span>Courses</span>
      </div>

      <div class="stat">
        <strong id="completedCount">0</strong>
        <span>Completed</span>
      </div>

      <div class="stat">
        <strong id="lessonsCount">0</strong>
        <span>Lessons</span>
      </div>

    </div>

  </section>


  <section class="toolbar">

    <input
      id="search"
      class="search"
      type="search"
      placeholder="Search your learning history..."
      autocomplete="off"
    >

  </section>


  <section
    id="list"
    class="list"
  >

    <div class="loading">
      Loading learning history...
    </div>

  </section>

</main>


<script>

/*
==================================================
LEARNING-HISTORY.HTML

PUBLIC USER LEARNING HISTORY

USER ID:
?userId=USER_ID

API:
GET /api/data?collection=learningHistory
&userId=USER_ID&limit=100

SUPPORTED DOCUMENT FIELDS:

courseId
courseName
title
progress
completed
completedAt
lastAccessed
lessonCount
completedLessons
lessons

NO DIRECT FIREBASE
==================================================
*/


const params =
  new URLSearchParams(
    location.search
  );


const userId =
  params.get("userId") ||
  params.get("uid") ||
  params.get("id");


const list =
  document.getElementById(
    "list"
  );

const search =
  document.getElementById(
    "search"
  );


const coursesCount =
  document.getElementById(
    "coursesCount"
  );

const completedCount =
  document.getElementById(
    "completedCount"
  );

const lessonsCount =
  document.getElementById(
    "lessonsCount"
  );


let historyData = [];


/* =========================
   VALIDATE USER
========================= */

if(!userId){

  list.innerHTML = `

    <div class="empty error">

      No user was selected.

      <br><br>

      Open this page with:
      <br>

      learning-history.html?userId=USER_ID

    </div>

  `;

}else{

  loadHistory();

}


/* =========================
   LOAD HISTORY
========================= */

async function loadHistory(){

  try{

    const response =
      await fetch(
        "/api/data?collection=learningHistory&userId=" +
        encodeURIComponent(
          userId
        ) +
        "&limit=100"
      );


    const result =
      await response.json();


    if(!response.ok){

      throw new Error(
        result.error ||
        "Unable to load learning history."
      );

    }


    historyData =
      Array.isArray(
        result.results
      )
      ? result.results
      : [];


    updateStats();

    render();


  }catch(error){

    console.error(
      "LEARNING HISTORY:",
      error
    );


    list.innerHTML = `

      <div class="empty error">

        Unable to load learning history.

        <br><br>

        ${escapeHTML(
          error.message
        )}

      </div>

    `;

  }

}


/* =========================
   STATS
========================= */

function updateStats(){

  coursesCount.textContent =
    historyData.length;


  completedCount.textContent =
    historyData.filter(
      item =>
        item.completed === true ||
        Number(item.progress) >= 100
    ).length;


  lessonsCount.textContent =
    historyData.reduce(
      (total,item) => {

        const completed =
          item.completedLessons;


        if(
          Array.isArray(
            completed
          )
        ){

          return total +
            completed.length;

        }


        if(
          typeof completed === "number"
        ){

          return total +
            completed;

        }


        if(
          Array.isArray(
            item.lessons
          )
        ){

          return total +
            item.lessons.filter(
              lesson =>
                lesson.completed === true
            ).length;

        }


        return total;

      },
      0
    );

}


/* =========================
   RENDER
========================= */

function render(){

  const keyword =
    search.value
      .trim()
      .toLowerCase();


  const filtered =
    historyData.filter(
      item => {

        const title =
          item.courseName ||
          item.title ||
          item.courseTitle ||
          "Course";


        const text =
          String(
            title
          ).toLowerCase();


        return !keyword ||
          text.includes(
            keyword
          );

      }
    );


  if(!filtered.length){

    list.innerHTML = `

      <div class="empty">

        ${
          historyData.length
          ? "No matching learning history."
          : "No learning activity found yet."
        }

      </div>

    `;

    return;

  }


  list.innerHTML =
    filtered
      .map(
        createItem
      )
      .join("");

}


/* =========================
   ITEM
========================= */

function createItem(
  item
){

  const courseId =
    item.courseId ||
    item.courseID ||
    item.courseDocumentId ||
    item.id ||
    "";


  const title =
    item.courseName ||
    item.courseTitle ||
    item.title ||
    "Course";


  let progress =
    Number(
      item.progress ??
      item.progressPercent ??
      0
    );


  if(
    progress > 0 &&
    progress <= 1
  ){

    progress *= 100;

  }


  progress =
    Math.max(
      0,
      Math.min(
        100,
        Math.round(
          progress
        )
      )
    );


  const completed =
    item.completed === true ||
    progress >= 100;


  const lessonTotal =
    item.lessonCount ??
    (
      Array.isArray(
        item.lessons
      )
      ? item.lessons.length
      : 0
    );


  const completedLessons =
    Array.isArray(
      item.completedLessons
    )
    ? item.completedLessons.length
    : Number(
        item.completedLessons || 0
      );


  const date =
    formatDate(
      item.lastAccessed ||
      item.updatedAt ||
      item.completedAt
    );


  return `

    <article class="item">

      <div class="top">

        <div>

          <div class="title">

            ${escapeHTML(title)}

          </div>


          <div class="meta">

            ${
              date
              ? "Last activity: " +
                escapeHTML(date)
              : "Learning activity"
            }

          </div>

        </div>


        <div
          class="status ${
            completed
            ? "completed"
            : ""
          }"
        >

          ${
            completed
            ? "Completed"
            : "In Progress"
          }

        </div>

      </div>


      <div class="progress">

        <div
          class="progress-bar"
          style="width:${progress}%"
        ></div>

      </div>


      <div class="progress-text">

        <span>
          ${progress}% complete
        </span>

        <span>

          ${
            lessonTotal
            ? completedLessons +
              "/" +
              lessonTotal +
              " lessons"
            : ""
          }

        </span>

      </div>


      ${
        courseId
        ? `

          <button
            class="view"
            data-id="${escapeAttr(
              courseId
            )}"
          >

            Continue Course

          </button>

        `
        : ""
      }

    </article>

  `;

}


/* =========================
   SEARCH
========================= */

search.addEventListener(
  "input",
  render
);


/* =========================
   COURSE
========================= */

list.addEventListener(
  "click",
  event => {

    const button =
      event.target.closest(
        ".view"
      );


    if(!button) return;


    const id =
      button.dataset.id;


    if(!id) return;


    location.href =
      "course.html?courseId=" +
      encodeURIComponent(
        id
      );

  }
);


/* =========================
   DATE
========================= */

function formatDate(
  value
){

  if(!value) return "";


  try{

    const date =
      new Date(value);


    if(
      Number.isNaN(
        date.getTime()
      )
    ){

      return String(value);

    }


    return date.toLocaleDateString(
      undefined,
      {
        year:"numeric",
        month:"short",
        day:"numeric"
      }
    );

  }catch(error){

    return String(value);

  }

}


/* =========================
   SECURITY
========================= */

function escapeHTML(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


function escapeAttr(value){

  return escapeHTML(value)
    .replace(/`/g,"&#096;");

}

</script>

</body>
</html>