async function updateProgress() {

  const modules =
    window.courseModules || [];

  const totalModules =
    modules.length;

  const progress =
    totalModules
      ? Math.min(
          100,
          Math.round(
            (
              totalModules /
              totalModules
            ) * 100
          )
        )
      : 0;

  if ($("progressFill"))
    $("progressFill").style.width =
      `${progress}%`;

  if ($("progressPercent"))
    $("progressPercent").textContent =
      `${progress}%`;

  if ($("moduleProgress"))
    $("moduleProgress").textContent =
      `${totalModules} modules`;
}


