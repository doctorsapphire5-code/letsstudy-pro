<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="LetsStudy Pro Learning Progress Dashboard"
  >

  <title>
    Learning Progress | LetsStudy Pro
  </title>

  <!-- =====================================================
       FONT AWESOME
  ====================================================== -->

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

  <!-- =====================================================
       GOOGLE FONT
  ====================================================== -->

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >


  <!-- =====================================================
       STYLE
  ====================================================== -->

  <style>

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }


    body {

      font-family:
        "Inter",
        Arial,
        sans-serif;

      background:
        #f8fafc;

      color:
        #0f172a;

      min-height:
        100vh;

    }


    a {
      text-decoration: none;
      color: inherit;
    }


    button,
    input {
      font-family: inherit;
    }


    /* =====================================================
       HEADER
    ====================================================== */

    .topbar {

      height:
        70px;

      background:
        #ffffff;

      border-bottom:
        1px solid #e5e7eb;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      padding:
        0 28px;

      position:
        sticky;

      top:
        0;

      z-index:
        100;

    }


    .brand {

      display:
        flex;

      align-items:
        center;

      gap:
        10px;

      font-weight:
        800;

      font-size:
        18px;

    }


    .brand-icon {

      width:
        38px;

      height:
        38px;

      border-radius:
        10px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      background:
        #2563eb;

      color:
        #ffffff;

    }


    .brand span {
      color:
        #2563eb;
    }


    .top-actions {

      display:
        flex;

      align-items:
        center;

      gap:
        10px;

    }


    .top-btn {

      width:
        40px;

      height:
        40px;

      border:
        1px solid #e5e7eb;

      background:
        #ffffff;

      border-radius:
        10px;

      cursor:
        pointer;

      color:
        #475569;

    }


    .top-btn:hover {
      background:
        #f1f5f9;
    }


    /* =====================================================
       LAYOUT
    ====================================================== */

    .layout {

      display:
        flex;

      min-height:
        calc(100vh - 70px);

    }


    /* =====================================================
       SIDEBAR
    ====================================================== */

    .sidebar {

      width:
        245px;

      background:
        #ffffff;

      border-right:
        1px solid #e5e7eb;

      padding:
        22px 15px;

      flex-shrink:
        0;

    }


    .nav-title {

      font-size:
        10px;

      font-weight:
        800;

      color:
        #94a3b8;

      text-transform:
        uppercase;

      margin:
        14px 10px 8px;

      letter-spacing:
        .08em;

    }


    .nav-item {

      display:
        flex;

      align-items:
        center;

      gap:
        11px;

      padding:
        11px 12px;

      border-radius:
        9px;

      color:
        #64748b;

      font-size:
        12px;

      font-weight:
        600;

      margin-bottom:
        3px;

    }


    .nav-item:hover {

      background:
        #f1f5f9;

      color:
        #2563eb;

    }


    .nav-item.active {

      background:
        #eff6ff;

      color:
        #2563eb;

    }


    .nav-item i {

      width:
        18px;

      text-align:
        center;

    }


    /* =====================================================
       MAIN
    ====================================================== */

    .main {

      flex:
        1;

      padding:
        28px;

      min-width:
        0;

    }


    .page-header {

      display:
        flex;

      align-items:
        flex-start;

      justify-content:
        space-between;

      gap:
        20px;

      margin-bottom:
        25px;

    }


    .page-header h1 {

      font-size:
        26px;

      font-weight:
        800;

      margin-bottom:
        6px;

    }


    .page-header p {

      color:
        #64748b;

      font-size:
        12px;

    }


    .header-actions {

      display:
        flex;

      gap:
        8px;

    }


    .btn {

      border:
        0;

      border-radius:
        9px;

      padding:
        11px 15px;

      font-size:
        11px;

      font-weight:
        700;

      cursor:
        pointer;

      display:
        inline-flex;

      align-items:
        center;

      gap:
        7px;

    }


    .btn-primary {

      background:
        #2563eb;

      color:
        #ffffff;

    }


    .btn-primary:hover {
      background:
        #1d4ed8;
    }


    .btn-light {

      background:
        #ffffff;

      color:
        #475569;

      border:
        1px solid #e5e7eb;

    }


    /* =====================================================
       COURSE HERO
    ====================================================== */

    .course-card {

      background:
        #ffffff;

      border:
        1px solid #e5e7eb;

      border-radius:
        16px;

      overflow:
        hidden;

      margin-bottom:
        20px;

    }


    .course-content {

      padding:
        25px;

      display:
        grid;

      grid-template-columns:
        1fr 300px;

      gap:
        25px;

    }


    .course-label {

      display:
        inline-flex;

      align-items:
        center;

      gap:
        6px;

      background:
        #eff6ff;

      color:
        #2563eb;

      padding:
        6px 9px;

      border-radius:
        6px;

      font-size:
        10px;

      font-weight:
        800;

      margin-bottom:
        12px;

    }


    .course-title {

      font-size:
        23px;

      font-weight:
        800;

      line-height:
        1.3;

      margin-bottom:
        9px;

    }


    .course-description {

      font-size:
        12px;

      color:
        #64748b;

      line-height:
        1.7;

      max-width:
        700px;

      margin-bottom:
        18px;

    }


    .course-meta {

      display:
        flex;

      flex-wrap:
        wrap;

      gap:
        14px;

      color:
        #64748b;

      font-size:
        10px;

    }


    .course-meta span {

      display:
        flex;

      align-items:
        center;

      gap:
        5px;

    }


    .course-thumbnail {

      height:
        180px;

      border-radius:
        12px;

      overflow:
        hidden;

      background:
        #f1f5f9;

    }


    .course-thumbnail img {

      width:
        100%;

      height:
        100%;

      object-fit:
        cover;

    }


    /* =====================================================
       PROGRESS
    ====================================================== */

    .progress-panel {

      background:
        #ffffff;

      border:
        1px solid #e5e7eb;

      border-radius:
        16px;

      padding:
        22px;

      margin-bottom:
        20px;

    }


    .progress-header {

      display:
        flex;

      justify-content:
        space-between;

      align-items:
        center;

      margin-bottom:
        14px;

    }


    .progress-header h2 {

      font-size:
        15px;

      font-weight:
        800;

    }


    .progress-percent {

      font-size:
        20px;

      font-weight:
        800;

      color:
        #2563eb;

    }


    .progress-track {

      height:
        13px;

      background:
        #e2e8f0;

      border-radius:
        999px;

      overflow:
        hidden;

    }


    .progress-fill {

      height:
        100%;

      width:
        0%;

      background:
        #2563eb;

      border-radius:
        inherit;

      transition:
        width .5s ease;

    }


    .progress-info {

      display:
        flex;

      justify-content:
        space-between;

      gap:
        10px;

      margin-top:
        10px;

      font-size:
        10px;

      color:
        #64748b;

    }


    /* =====================================================
       STATS
    ====================================================== */

    .stats {

      display:
        grid;

      grid-template-columns:
        repeat(4, 1fr);

      gap:
        15px;

      margin-bottom:
        20px;

    }


    .stat {

      background:
        #ffffff;

      border:
        1px solid #e5e7eb;

      border-radius:
        13px;

      padding:
        18px;

    }


    .stat-icon {

      width:
        36px;

      height:
        36px;

      border-radius:
        9px;

      background:
        #eff6ff;

      color:
        #2563eb;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      margin-bottom:
        12px;

    }


    .stat-label {

      color:
        #64748b;

      font-size:
        10px;

      margin-bottom:
        5px;

    }


    .stat-value {

      font-size:
        19px;

      font-weight:
        800;

    }


    /* =====================================================
       CONTENT GRID
    ====================================================== */

    .content-grid {

      display:
        grid;

      grid-template-columns:
        1.4fr .8fr;

      gap:
        20px;

    }


    .content-card {

      background:
        #ffffff;

      border:
        1px solid #e5e7eb;

      border-radius:
        15px;

      padding:
        20px;

    }


    .content-card h2 {

      font-size:
        14px;

      font-weight:
        800;

      margin-bottom:
        15px;

    }


    /* =====================================================
       MODULES
    ====================================================== */

    .module {

      border:
        1px solid #e5e7eb;

      border-radius:
        11px;

      margin-bottom:
        10px;

      overflow:
        hidden;

    }


    .module-header {

      padding:
        14px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        12px;

      cursor:
        pointer;

      background:
        #ffffff;

    }


    .module-header:hover {
      background:
        #f8fafc;
    }


    .module-title {

      display:
        flex;

      align-items:
        center;

      gap:
        10px;

      min-width:
        0;

    }


    .module-number {

      width:
        30px;

      height:
        30px;

      border-radius:
        8px;

      background:
        #eff6ff;

      color:
        #2563eb;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      font-size:
        10px;

      font-weight:
        800;

      flex-shrink:
        0;

    }


    .module-title strong {

      display:
        block;

      font-size:
        11px;

      margin-bottom:
        3px;

    }


    .module-title span {

      font-size:
        9px;

      color:
        #94a3b8;

    }


    .module-progress {

      font-size:
        10px;

      color:
        #64748b;

      white-space:
        nowrap;

    }


    .lesson-list {

      display:
        none;

      border-top:
        1px solid #e5e7eb;

      background:
        #f8fafc;

    }


    .module.open .lesson-list {
      display:
        block;
    }


    .lesson {

      padding:
        11px 14px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        10px;

      border-bottom:
        1px solid #e5e7eb;

      font-size:
        10px;

    }


    .lesson:last-child {
      border-bottom:
        0;
    }


    .lesson-left {

      display:
        flex;

      align-items:
        center;

      gap:
        9px;

      min-width:
        0;

    }


    .lesson-left i {
      color:
        #64748b;
    }


    .lesson.completed
    .lesson-left i {

      color:
        #16a34a;

    }


    .lesson-name {

      overflow:
        hidden;

      text-overflow:
        ellipsis;

      white-space:
        nowrap;

    }


    .lesson-status {

      font-size:
        9px;

      color:
        #64748b;

    }


    /* =====================================================
       ACTIVITY
    ====================================================== */

    .activity {

      display:
        flex;

      gap:
        10px;

      padding:
        12px 0;

      border-bottom:
        1px solid #f1f5f9;

    }


    .activity:last-child {
      border-bottom:
        0;
    }


    .activity-icon {

      width:
        32px;

      height:
        32px;

      border-radius:
        50%;

      background:
        #eff6ff;

      color:
        #2563eb;

      display:
        flex;

      align-items:
        center;

      justify-content:
        center;

      flex-shrink:
        0;

      font-size:
        11px;

    }


    .activity-text {

      font-size:
        10px;

      line-height:
        1.5;

    }


    .activity-time {

      color:
        #94a3b8;

      font-size:
        9px;

      margin-top:
        3px;

    }


    /* =====================================================
       CERTIFICATE
    ====================================================== */

    .certificate {

      margin-top:
        18px;

      padding:
        17px;

      border-radius:
        12px;

      background:
        #f8fafc;

      border:
        1px solid #e5e7eb;

    }


    .certificate h3 {

      font-size:
        12px;

      margin-bottom:
        6px;

    }


    .certificate p {

      color:
        #64748b;

      font-size:
        10px;

      line-height:
        1.5;

    }


    /* =====================================================
       LOADING
    ====================================================== */

    .loading {

      min-height:
        300px;

      display:
        flex;

      flex-direction:
        column;

      align-items:
        center;

      justify-content:
        center;

      gap:
        10px;

      color:
        #64748b;

      font-size:
        12px;

    }


    .loading i {

      font-size:
        25px;

      color:
        #2563eb;

    }


    /* =====================================================
       EMPTY
    ====================================================== */

    .empty {

      text-align:
        center;

      padding:
        70px 20px;

    }


    .empty i {

      font-size:
        35px;

      color:
        #94a3b8;

      margin-bottom:
        15px;

    }


    .empty h2 {

      font-size:
        18px;

      margin-bottom:
        7px;

    }


    .empty p {

      font-size:
        11px;

      color:
        #64748b;

      margin-bottom:
        18px;

    }


    /* =====================================================
       TOAST
    ====================================================== */

    .toast {

      position:
        fixed;

      right:
        20px;

      bottom:
        20px;

      padding:
        12px 16px;

      background:
        #0f172a;

      color:
        #ffffff;

      border-radius:
        9px;

      font-size:
        11px;

      transform:
        translateY(100px);

      opacity:
        0;

      transition:
        .3s;

      z-index:
        9999;

    }


    .toast.show {

      transform:
        translateY(0);

      opacity:
        1;

    }


    .toast.error {
      background:
        #dc2626;
    }


    /* =====================================================
       RESPONSIVE
    ====================================================== */

    @media (
      max-width: 1000px
    ) {

      .sidebar {
        width:
          210px;
      }


      .course-content {

        grid-template-columns:
          1fr;

      }


      .course-thumbnail {
        height:
          220px;
      }


      .content-grid {

        grid-template-columns:
          1fr;

      }

    }


    @media (
      max-width: 750px
    ) {

      .sidebar {
        display:
          none;
      }


      .main {
        padding:
          18px;
      }


      .stats {

        grid-template-columns:
          repeat(2, 1fr);

      }


      .page-header {

        flex-direction:
          column;

      }


      .header-actions {
        width:
          100%;
      }


      .header-actions .btn {
        flex:
          1;

        justify-content:
          center;
      }

    }


    @media (
      max-width: 450px
    ) {

      .topbar {
        padding:
          0 15px;
      }


      .brand {
        font-size:
          15px;
      }


      .stats {

        grid-template-columns:
          1fr;

      }


      .course-title {
        font-size:
          20px;
      }


      .progress-info {
        flex-direction:
          column;

      }

    }

  .course-buttons{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
  gap:10px;
  margin:20px 0;
}

.course-buttons button{
  border:1px solid #e4e7ec;
  background:#fff;
  color:#344054;
  padding:13px 12px;
  border-radius:12px;
  font-weight:800;
  cursor:pointer;
  transition:.2s;
}

.course-buttons button:hover{
  transform:translateY(-2px);
  border-color:#155eef;
  color:#155eef;
  box-shadow:0 5px 15px #10182812;
}

.course-buttons button.active{
  background:#155eef;
  color:#fff;
  border-color:#155eef;
}

  </style>

</head>

<div class="course-buttons">

  <button onclick="goTo('modules.html')">
    📚 Modules
  </button>

  <button onclick="goTo('lesson.html')">
