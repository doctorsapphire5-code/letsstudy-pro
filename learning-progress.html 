<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Learning Progress | LetsStudy Pro</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>

*{
box-sizing:border-box;
}

body{
margin:0;
font-family:Arial,Helvetica,sans-serif;
background:#f5f7fb;
color:#172033;
}

.container{
width:100%;
max-width:850px;
margin:auto;
padding:15px;
}


/* HEADER */

.header{
background:#fff;
border-radius:16px;
padding:24px 20px;
text-align:center;
box-shadow:0 4px 18px rgba(0,0,0,.06);
margin-bottom:15px;
}

.header-icon{
width:60px;
height:60px;
margin:auto;
border-radius:50%;
background:#eff6ff;
color:#2563eb;
display:flex;
align-items:center;
justify-content:center;
font-size:26px;
}

.header h1{
margin:13px 0 5px;
font-size:24px;
}

.header p{
margin:0;
color:#64748b;
font-size:14px;
}

.course-title{
margin-top:12px;
font-weight:bold;
font-size:15px;
color:#2563eb;
}


/* PROGRESS */

.progress-card{
background:#fff;
border-radius:16px;
padding:19px;
margin-bottom:15px;
box-shadow:0 4px 18px rgba(0,0,0,.06);
}

.progress-top{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:9px;
font-size:14px;
font-weight:bold;
}

.progress-percent{
font-size:20px;
color:#2563eb;
}

.progress-bar{
width:100%;
height:10px;
background:#e2e8f0;
border-radius:20px;
overflow:hidden;
}

.progress-fill{
width:0%;
height:100%;
background:#2563eb;
border-radius:20px;
transition:.4s;
}

.progress-info{
margin-top:8px;
font-size:12px;
color:#64748b;
}


/* GRID */

.grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:12px;
}


/* CARD */

.card{
display:flex;
align-items:center;
gap:12px;
background:#fff;
padding:17px 14px;
border-radius:14px;
text-decoration:none;
color:#172033;
box-shadow:0 4px 18px rgba(0,0,0,.05);
transition:.2s;
min-height:78px;
}

.card:hover{
transform:translateY(-2px);
box-shadow:0 8px 20px rgba(0,0,0,.09);
}

.icon{
width:45px;
height:45px;
border-radius:11px;
background:#eff6ff;
color:#2563eb;
display:flex;
align-items:center;
justify-content:center;
font-size:19px;
flex-shrink:0;
}

.card-info{
flex:1;
}

.card-info strong{
display:block;
font-size:14px;
margin-bottom:4px;
}

.card-info small{
font-size:11px;
color:#64748b;
line-height:1.3;
}

.arrow{
color:#94a3b8;
font-size:12px;
}


/* LOADING */

.loading{
color:#64748b;
font-size:13px;
}


/* ERROR */

.error{
margin-top:15px;
padding:15px;
border-radius:10px;
background:#fee2e2;
color:#991b1b;
font-size:13px;
}


/* MOBILE */

@media(max-width:550px){

.container{
padding:10px;
}

.header{
padding:20px 15px;
}

.header h1{
font-size:21px;
}

.grid{
grid-template-columns:1fr;
gap:10px;
}

.card{
min-height:72px;
}

}

</style>
</head>

<body>

<div class="container">


<!-- =========================
     HEADER
========================= -->

<div class="header">

<div class="header-icon">

<i class="fa-solid fa-graduation-cap"></i>

</div>

<h1>
Learning Progress
</h1>

<p>
Continue your learning and track your course progress.
</p>

<div
id="courseTitle"
class="course-title">

<span class="loading">
Loading course...
</span>

</div>

</div>


<!-- =========================
     PROGRESS
========================= -->

<div class="progress-card">

<div class="progress-top">

<span>
Course Progress
</span>

<span
id="progressPercent"
class="progress-percent">

0%

</span>

</div>


<div class="progress-bar">

<div
id="progressFill"
class="progress-fill">
</div>

</div>


<div
id="progressInfo"
class="progress-info">

Loading your progress...

</div>

</div>


<!-- =========================
     BUTTONS
========================= -->

<div class="grid">


<!-- MODULES -->

<a
id="modulesBtn"
class="card"
href="course-modeles.html">

<div class="icon">

<i class="fa-solid fa-layer-group"></i>

</div>

<div class="card-info">

<strong>
Modules
</strong>

<small>
View course modules
</small>

</div>

<i class="fa-solid fa-chevron-right arrow"></i>

</a>


<!-- LESSONS -->

<a
id="lessonsBtn"
class="card"
href="lesson.html">

<div class="icon">

<i class="fa-solid fa-book-open"></i>

</div>

<div class="card-info">

<strong>
Lessons
</strong>

<small>
Learn course lessons
</small>

</div>

<i class="fa-solid fa-chevron-right arrow"></i>

</a>


<!-- QUIZZES -->

<a
id="quizzesBtn"
class="card"
href="#">

<div class="icon">

<i class="fa-solid fa-circle-question"></i>

</div>

<div class="card-info">

<strong>
Quizzes
</strong>

<small>
Test your knowledge
</small>

</div>

<i class="fa-solid fa-chevron-right arrow"></i>

</a>


<!-- ASSIGNMENTS -->

<a
id="assignmentsBtn"
class="card"
href="#">

<div class="icon">

<i class="fa-solid fa-file-pen"></i>

</div>

<div class="card-info">

<strong>
Assignments
</strong>

<small>
Complete and submit assignments
</small>

</div>

<i class="fa-solid fa-chevron-right arrow"></i>

</a>


<!-- COURSE RESOURCES -->

<a
id="resourcesBtn"
class="card"
href="#">

<div class="icon">

<i class="fa-solid fa-folder-open"></i>

</div>

<div class="card-info">

<strong>
Course Resources
</strong>

<small>
Notes, PDFs and learning materials
</small>

</div>

<i class="fa-solid fa-chevron-right arrow"></i>

</a>


<!-- ANNOUNCEMENTS -->

<a
id="announcementsBtn"
class="card"
href="#">

<div class="icon">

<i class="fa-solid fa-bullhorn"></i>

</div>

<div class="card-info">

<strong>
Announcements
</strong>

<small>
Course news and updates
</small>

</div>

<i class="fa-solid fa-chevron-right arrow"></i>

</a>


<!-- FAQ -->

<a
id="faqsBtn"
class="card"
href="#">

<div class="icon">

<i class="fa-solid fa-circle-info"></i>

</div>

<div class="card-info">

<strong>
Course FAQs
</strong>

<small>
Frequently asked questions
</small>

</div>

<i class="fa-solid fa-chevron-right arrow"></i>

</a>


<!-- CERTIFICATES -->

<a
id="certificatesBtn"
class="card"
href="#">

<div class="icon">

<i class="fa-solid fa-certificate"></i>

</div>

<div class="card-info">

<strong>
Certificates
</strong>

<small>
View your course certificates
</small>

</div>

<i class="fa-solid fa-chevron-right arrow"></i>

</a>


</div>


<div
id="errorBox"
class="error"
style="display:none">
</div>


</div>


<script type="module">


/* =====================================================
   FIREBASE
===================================================== */

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.7.0/firebase-app.js";


import {
getAuth,
onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.7.0/firebase-auth.js";


import {
getFirestore,
doc,
getDoc,
collection,
query,
where,
getDocs
}
from
"https://www.gstatic.com/firebasejs/12.7.0/firebase-firestore.js";


/* =====================================================
   FIREBASE CONFIG
===================================================== */

const firebaseConfig = {

apiKey:
"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};


/* =====================================================
   INITIALIZE
===================================================== */

const app =
initializeApp(
firebaseConfig
);

const auth =
getAuth(app);

const db =
getFirestore(app);


/* =====================================================
   COURSE ID
===================================================== */

const params =
new URLSearchParams(
window.location.search
);

const courseId =
params.get("courseId") ||
params.get("id");


/* =====================================================
   ELEMENTS
===================================================== */

const courseTitle =
document.getElementById(
"courseTitle"
);

const progressPercent =
document.getElementById(
"progressPercent"
);

const progressFill =
document.getElementById(
"progressFill"
);

const progressInfo =
document.getElementById(
"progressInfo"
);

const errorBox =
document.getElementById(
"errorBox"
);


/* =====================================================
   SHOW ERROR
===================================================== */

function showError(message){

errorBox.textContent =
message;

errorBox.style.display =
"block";

}


/* =====================================================
   ADD COURSE ID TO PAGE
===================================================== */

function setCourseLink(
elementId,
page
){

const element =
document.getElementById(
elementId
);

if(!element)
return;

element.href =
page +
"?courseId=" +
encodeURIComponent(
courseId || ""
);

}


/* =====================================================
   PAGE LINKS
===================================================== */

setCourseLink(
"modulesBtn",
"modules.html"
);

setCourseLink(
"lessonsBtn",
"lessons.html"
);

setCourseLink(
"quizzesBtn",
"quizzes.html"
);

setCourseLink(
"assignmentsBtn",
"assignments.html"
);

setCourseLink(
"resourcesBtn",
"course-resources.html"
);

setCourseLink(
"announcementsBtn",
"announcements.html"
);

setCourseLink(
"faqsBtn",
"courseFAQs.html"
);

setCourseLink(
"certificatesBtn",
"certificates.html"
);


/* =====================================================
   LOAD COURSE
===================================================== */

async function loadCourse(){

if(!courseId){

courseTitle.textContent =
"Course ID missing";

showError(
"Course ID haipo kwenye URL. Tumia learning-progress.html?courseId=COURSE_ID"
);

return;

}


const courseRef =
doc(
db,
"courses",
courseId
);


const courseSnap =
await getDoc(
courseRef
);


if(!courseSnap.exists()){

courseTitle.textContent =
"Course not found";

showError(
"Course hii haikupatikana kwenye Firestore."
);

return;

}


const course =
courseSnap.data();


courseTitle.textContent =
course.title ||
"Course";


}


/* =====================================================
   LOAD PROGRESS
===================================================== */

async function loadProgress(
user
){

if(!user || !courseId)
return;


/*
   Expected document:

   courseProgress/{userId_courseId}

   Example:

   courseProgress/
       abc123_course456
*/

const progressId =
user.uid +
"_" +
courseId;


const progressRef =
doc(
db,
"courseProgress",
progressId
);


const progressSnap =
await getDoc(
progressRef
);


let progress = 0;

let completedLessons = 0;

let totalLessons = 0;


if(progressSnap.exists()){

const data =
progressSnap.data();


if(
typeof data.progress ===
"number"
){

progress =
data.progress;

}


completedLessons =
Array.isArray(
data.completedLessons
)
?
data.completedLessons.length
:
0;

}


/* =====================================================
   COUNT LESSONS
===================================================== */

const lessonsQuery =
query(
collection(
db,
"lessons"
),
where(
"courseId",
"==",
courseId
)
);


const lessonsSnap =
await getDocs(
lessonsQuery
);


totalLessons =
lessonsSnap.size;


/* =====================================================
   CALCULATE IF NO SAVED PROGRESS
===================================================== */

if(
!progressSnap.exists() &&
totalLessons > 0
){

progress = 0;

}


/* =====================================================
   NORMALIZE
===================================================== */

progress =
Math.min(
100,
Math.max(
0,
Math.round(
Number(progress)
)
)
);


/* =====================================================
   UPDATE UI
===================================================== */

progressPercent.textContent =
progress + "%";


progressFill.style.width =
progress + "%";


progressInfo.textContent =
`${completedLessons} of ${totalLessons} lessons completed`;

}


/* =====================================================
   AUTH
===================================================== */

onAuthStateChanged(
auth,
async user => {

try{

await loadCourse();


if(user){

await loadProgress(
user
);

}else{

progressPercent.textContent =
"0%";

progressFill.style.width =
"0%";

progressInfo.textContent =
"Login to track your progress.";

}

}catch(error){

console.error(
"Learning Progress:",
error
);

showError(
error.message ||
"Failed to load learning progress."
);

}

});


</script>

</body>
</html>