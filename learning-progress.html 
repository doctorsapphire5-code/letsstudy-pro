<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Learning Progress | LetsStudy Pro</title>

<meta
  name="description"
  content="Track your learning progress, completed courses and lessons on LetsStudy Pro."
>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0
}

body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033
}

header{
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  padding:15px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:10
}

.logo{
  text-decoration:none;
  color:#172033;
  font-size:21px;
  font-weight:800
}

.logo span{
  color:#2563eb
}

.back{
  border:0;
  background:#eef2f7;
  padding:10px 15px;
  border-radius:8px;
  cursor:pointer
}

.container{
  width:92%;
  max-width:1050px;
  margin:30px auto
}

.hero{
  background:#fff;
  border-radius:18px;
  padding:28px 22px;
  margin-bottom:18px
}

.hero h1{
  font-size:29px;
  margin-bottom:6px
}

.hero p{
  color:#64748b
}

.overall{
  margin-top:22px
}

.overall-top{
  display:flex;
  justify-content:space-between;
  margin-bottom:8px
}

.overall-top strong{
  font-size:14px
}

.overall-top span{
  color:#2563eb;
  font-weight:800
}

.bar{
  width:100%;
  height:11px;
  background:#e5e7eb;
  border-radius:20px;
  overflow:hidden
}

.bar-fill{
  height:100%;
  width:0;
  background:#2563eb;
  transition:.4s
}

.stats{
  display:grid;
  grid-template-columns:
    repeat(4,1fr);
  gap:12px;
  margin-bottom:20px
}

.stat{
  background:#fff;
  padding:18px;
  border-radius:13px;
  border:1px solid #e5e7eb
}

.stat strong{
  display:block;
  font-size:23px;
  margin-bottom:4px
}

.stat span{
  color:#64748b;
  font-size:12px
}

.tools{
  background:#fff;
  padding:15px;
  border-radius:13px;
  margin-bottom:15px
}

.search{
  width:100%;
  padding:12px;
  border:1px solid #dbe2ea;
  border-radius:8px;
  outline:none;
  font-size:15px
}

.list{
  display:flex;
  flex-direction:column;
  gap:12px
}

.item{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:14px;
  padding:18px
}

.item-top{
  display:flex;
  justify-content:space-between;
  gap:15px
}

.title{
  font-size:17px;
  font-weight:800
}

.meta{
  color:#64748b;
  font-size:12px;
  margin-top:5px
}

.status{
  padding:5px 8px;
  border-radius:7px;
  background:#eff6ff;
  color:#2563eb;
  font-size:11px;
  white-space:nowrap;
  height:max-content
}

.status.done{
  background:#ecfdf5;
  color:#047857
}

.progress{
  margin-top:15px
}

.progress-label{
  display:flex;
  justify-content:space-between;
  font-size:12px;
  color:#64748b;
  margin-bottom:6px
}

.item-bar{
  height:8px;
  background:#e5e7eb;
  border-radius:20px;
  overflow:hidden
}

.item-fill{
  height:100%;
  background:#2563eb
}

.continue{
  margin-top:14px;
  border:0;
  background:#2563eb;
  color:#fff;
  padding:9px 13px;
  border-radius:8px;
  cursor:pointer;
  font-weight:700
}

.loading,
.empty{
  background:#fff;
  padding:50px 20px;
  border-radius:14px;
  text-align:center;
  color:#64748b
}

.error{
  color:#b91c1c
}

@media(max-width:700px){

  .stats{
    grid-template-columns:
      repeat(2,1fr)
  }

}

@media(max-width:450px){

  .stats{
    grid-template-columns:1fr
  }

  .item-top{
    flex-direction:column
  }

}
</style>
</head>

<body>

<header>

  <a
    href="index.html"
    class="logo"
  >
    LetsStudy <span>Pro</span>
  </a>

  <button
    class="back"
    onclick="history.back()"
  >
    Back
  </button>

</header>


<main class="container">

  <section class="hero">

    <h1>
      Learning Progress
    </h1>

    <p>
      Track your learning journey and keep moving forward.
    </p>


    <div class="overall">

      <div class="overall-top">

        <strong>
          Overall Progress
        </strong>

        <span id="overallText">
          0%
        </span>

      </div>


      <div class="bar">

        <div
          id="overallBar"
          class="bar-fill"
        ></div>

      </div>

    </div>

  </section>


  <section class="stats">

    <div class="stat">

      <strong id="courseTotal">
        0
      </strong>

      <span>
        Courses
      </span>

    </div>


    <div class="stat">

      <strong id="courseCompleted">
        0
      </strong>

      <span>
        Completed
      </span>

    </div>


    <div class="stat">

      <strong id="lessonCompleted">
        0
      </strong>

      <span>
        Lessons Completed
      </span>

    </div>


    <div class="stat">

      <strong id="inProgress">
        0
      </strong>

      <span>
        In Progress
      </span>

    </div>

  </section>


  <section class="tools">

    <input
      id="search"
      class="search"
      type="search"
      placeholder="Search courses..."
      autocomplete="off"
    >

  </section>


  <section
    id="list"
    class="list"
  >

    <div class="loading">
      Loading progress...
    </div>

  </section>

</main>


<script>

/*
==================================================
LEARNING-PROGRESS.HTML

URL:
learning-progress.html?userId=USER_ID

API:
GET /api/data?collection=learningProgress
&userId=USER_ID&limit=100

SUPPORTED FIELDS:

courseId
courseName
courseTitle
progress
progressPercent
completed
completedLessons
lessonCount
updatedAt
lastAccessed

NO DIRECT FIREBASE
==================================================
*/


const params =
  new URLSearchParams(
    location.search
  );


const userId =
  params.get("userId") ||
  params.get("uid") ||
  params.get("id");


const list =
  document.getElementById("list");

const search =
  document.getElementById("search");

const overallBar =
  document.getElementById("overallBar");

const overallText =
  document.getElementById("overallText");

const courseTotal =
  document.getElementById("courseTotal");

const courseCompleted =
  document.getElementById("courseCompleted");

const lessonCompleted =
  document.getElementById("lessonCompleted");

const inProgress =
  document.getElementById("inProgress");


let progressData = [];


/* =========================
   VALIDATE
========================= */

if(!userId){

  list.innerHTML = `

    <div class="empty error">

      No user was selected.

      <br><br>

      Open this page using:

      <br>

      learning-progress.html?userId=USER_ID

    </div>

  `;

}else{

  loadProgress();

}


/* =========================
   LOAD
========================= */

async function loadProgress(){

  try{

    const response =
      await fetch(
        "/api/data?collection=learningProgress&userId=" +
        encodeURIComponent(
          userId
        ) +
        "&limit=100"
      );


    const result =
      await response.json();


    if(!response.ok){

      throw new Error(
        result.error ||
        "Unable to load learning progress."
      );

    }


    progressData =
      Array.isArray(
        result.results
      )
      ? result.results
      : [];


    updateDashboard();

    render();

  }catch(error){

    console.error(
      "LEARNING PROGRESS:",
      error
    );


    list.innerHTML = `

      <div class="empty error">

        Unable to load learning progress.

        <br><br>

        ${escapeHTML(
          error.message
        )}

      </div>

    `;

  }

}


/* =========================
   NORMALIZE PROGRESS
========================= */

function getProgress(
  item
){

  let value =
    Number(
      item.progress ??
      item.progressPercent ??
      0
    );


  if(
    value > 0 &&
    value <= 1
  ){

    value *= 100;

  }


  if(
    item.completed === true
  ){

    value = 100;

  }


  return Math.max(
    0,
    Math.min(
      100,
      Math.round(
        value
      )
    )
  );

}


/* =========================
   DASHBOARD
========================= */

function updateDashboard(){

  courseTotal.textContent =
    progressData.length;


  const completed =
    progressData.filter(
      item =>
        getProgress(item) >= 100
    );


  courseCompleted.textContent =
    completed.length;


  inProgress.textContent =
    progressData.filter(
      item => {

        const p =
          getProgress(item);

        return p > 0 && p < 100;

      }
    ).length;


  const lessons =
    progressData.reduce(
      (total,item) => {

        if(
          Array.isArray(
            item.completedLessons
          )
        ){

          return total +
            item.completedLessons.length;

        }


        return total +
          Number(
            item.completedLessons || 0
          );

      },
      0
    );


  lessonCompleted.textContent =
    lessons;


  const overall =
    progressData.length
    ? Math.round(
        progressData.reduce(
          (sum,item) =>
            sum +
            getProgress(item),
          0
        ) /
        progressData.length
      )
    : 0;


  overallText.textContent =
    overall + "%";


  overallBar.style.width =
    overall + "%";

}


/* =========================
   RENDER
========================= */

function render(){

  const keyword =
    search.value
      .trim()
      .toLowerCase();


  const filtered =
    progressData.filter(
      item => {

        const title =
          item.courseName ||
          item.courseTitle ||
          item.title ||
          "Course";


        return (
          !keyword ||
          String(title)
            .toLowerCase()
            .includes(keyword)
        );

      }
    );


  if(!filtered.length){

    list.innerHTML = `

      <div class="empty">

        ${
          progressData.length
          ? "No matching courses."
          : "No learning progress available yet."
        }

      </div>

    `;

    return;

  }


  list.innerHTML =
    filtered
      .map(
        createItem
      )
      .join("");

}


/* =========================
   COURSE ITEM
========================= */

function createItem(
  item
){

  const id =
    item.courseId ||
    item.courseID ||
    item.courseDocumentId ||
    item.id ||
    "";


  const title =
    item.courseName ||
    item.courseTitle ||
    item.title ||
    "Course";


  const progress =
    getProgress(
      item
    );


  const completed =
    progress >= 100;


  const lessonTotal =
    Number(
      item.lessonCount ||
      0
    );


  const completedLessons =
    Array.isArray(
      item.completedLessons
    )
    ? item.completedLessons.length
    : Number(
        item.completedLessons ||
        0
      );


  return `

    <article class="item">

      <div class="item-top">

        <div>

          <div class="title">

            ${escapeHTML(title)}

          </div>


          <div class="meta">

            ${
              lessonTotal
              ? completedLessons +
                " of " +
                lessonTotal +
                " lessons completed"
              : "Course progress"
            }

          </div>

        </div>


        <div
          class="status ${
            completed
            ? "done"
            : ""
          }"
        >

          ${
            completed
            ? "Completed"
            : progress > 0
              ? "In Progress"
              : "Not Started"
          }

        </div>

      </div>


      <div class="progress">

        <div class="progress-label">

          <span>
            Progress
          </span>

          <strong>
            ${progress}%
          </strong>

        </div>


        <div class="item-bar">

          <div
            class="item-fill"
            style="width:${progress}%"
          ></div>

        </div>

      </div>


      ${
        id
        ? `

          <button
            class="continue"
            data-id="${escapeAttr(id)}"
          >

            ${
              completed
              ? "View Course"
              : progress > 0
                ? "Continue Learning"
                : "Start Course"
            }

          </button>

        `
        : ""
      }

    </article>

  `;

}


/* =========================
   SEARCH
========================= */

search.addEventListener(
  "input",
  render
);


/* =========================
   COURSE LINK
========================= */

list.addEventListener(
  "click",
  event => {

    const button =
      event.target.closest(
        ".continue"
      );


    if(!button) return;


    const id =
      button.dataset.id;


    if(!id) return;


    location.href =
      "course.html?courseId=" +
      encodeURIComponent(
        id
      );

  }
);


/* =========================
   SECURITY
========================= */

function escapeHTML(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


function escapeAttr(value){

  return escapeHTML(value)
    .replace(/`/g,"&#096;");

}

</script>

</body>
</html>