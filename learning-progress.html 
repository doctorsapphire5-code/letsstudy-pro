<!-- =====================================================
     FIREBASE
====================================================== -->

<script type="module">

import {
  initializeApp
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";


import {
  getFirestore,
  collection,
  query,
  where,
  getDocs,
  orderBy
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";


import {
  getAuth,
  onAuthStateChanged
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";


/* =====================================================
   FIREBASE CONFIG
===================================================== */

// For Firebase JS SDK v7.20.0 and later, measurementId is optional
const firebaseConfig = {
  apiKey: "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",
  authDomain: "let-s-study-pro-course.firebaseapp.com",
  databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
  projectId: "let-s-study-pro-course",
  storageBucket: "let-s-study-pro-course.firebasestorage.app",
  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
};

const app =
  initializeApp(
    firebaseConfig
  );


const db =
  getFirestore(
    app
  );


const auth =
  getAuth(
    app
  );


/* =====================================================
   STATE
===================================================== */

let currentUser = null;

let enrollments = [];

let filteredEnrollments = [];


/* =====================================================
   ELEMENTS
===================================================== */

const loading =
  document.getElementById(
    "progressLoading"
  );


const list =
  document.getElementById(
    "courseProgressList"
  );


const empty =
  document.getElementById(
    "emptyProgress"
  );


const filter =
  document.getElementById(
    "progressFilter"
  );


/* =====================================================
   AUTH
===================================================== */

onAuthStateChanged(
  auth,
  async user => {

    if (!user) {

      loading.style.display =
        "none";

      list.innerHTML = `

        <div class="login-required">

          <i class="fa-solid fa-lock"></i>

          <h3>
            Login Required
          </h3>

          <p>
            Please login to view your learning progress.
          </p>

          <a
            href="login.html"
            class="btn btn-primary"
          >
            Login
          </a>

        </div>

      `;

      return;

    }


    currentUser =
      user;


    await loadProgress();

  }
);


/* =====================================================
   LOAD ENROLLMENTS
===================================================== */

async function loadProgress() {

  try {

    loading.style.display =
      "flex";


    const q =
      query(
        collection(
          db,
          "enrollments"
        ),
        where(
          "userId",
          "==",
          currentUser.uid
        )
      );


    const snapshot =
      await getDocs(
        q
      );


    enrollments =
      snapshot.docs.map(
        doc => ({

          id:
            doc.id,

          ...doc.data()

        })
      );


    filteredEnrollments =
      [...enrollments];


    renderProgress();

    updateStatistics();


  }
  catch(error) {

    console.error(
      "Learning progress error:",
      error
    );


    list.innerHTML = `

      <div class="error-state">

        <i class="fa-solid fa-triangle-exclamation"></i>

        <h3>
          Unable to load progress
        </h3>

        <p>
          Please try again later.
        </p>

      </div>

    `;

  }
  finally {

    loading.style.display =
      "none";

  }

}


/* =====================================================
   RENDER PROGRESS
===================================================== */

function renderProgress() {

  if (
    !filteredEnrollments.length
  ) {

    list.innerHTML =
      "";

    empty.style.display =
      "block";

    return;

  }


  empty.style.display =
    "none";


  list.innerHTML =
    filteredEnrollments
      .map(
        enrollment =>
          createProgressCard(
            enrollment
          )
      )
      .join("");

}


/* =====================================================
   CREATE COURSE CARD
===================================================== */

function createProgressCard(
  enrollment
) {

  const progress =
    getProgress(
      enrollment
    );


  const title =
    enrollment.courseTitle ||
    enrollment.title ||
    "Untitled Course";


  const thumbnail =
    enrollment.courseThumbnail ||
    enrollment.thumbnail ||
    enrollment.imageUrl ||
    "https://via.placeholder.com/600x350";


  const completedLessons =
    Number(
      enrollment.completedLessons ||
      0
    );


  const totalLessons =
    Number(
      enrollment.totalLessons ||
      enrollment.lessonsCount ||
      0
    );


  const completedModules =
    Number(
      enrollment.completedModules ||
      0
    );


  const totalModules =
    Number(
      enrollment.totalModules ||
      enrollment.modulesCount ||
      0
    );


  const status =
    progress >= 100
      ? "Completed"
      : progress > 0
        ? "In Progress"
        : "Not Started";


  const statusClass =
    progress >= 100
      ? "completed"
      : progress > 0
        ? "progress"
        : "not-started";


  return `

    <article
      class="course-progress-card"
    >

      <img
        src="${escapeHTML(
          thumbnail
        )}"
        alt="${escapeHTML(
          title
        )}"
        class="course-progress-image"
      >


      <div class="course-progress-content">

        <div class="course-progress-top">

          <div>

            <span
              class="
                progress-status
                ${statusClass}
              "
            >
              ${status}
            </span>

            <h3>
              ${escapeHTML(
                title
              )}
            </h3>

          </div>


          <strong>
            ${progress}%
          </strong>

        </div>


        <div class="progress-track">

          <div
            class="progress-fill"
            style="
              width:${progress}%;
            "
          ></div>

        </div>


        <div
          class="course-progress-meta"
        >

          <span>

            <i
              class="
                fa-solid
                fa-play
              "
            ></i>

            ${completedLessons}
            /
            ${totalLessons}
            Lessons

          </span>


          <span>

            <i
              class="
                fa-solid
                fa-layer-group
              "
            ></i>

            ${completedModules}
            /
            ${totalModules}
            Modules

          </span>

        </div>


        <div
          class="course-progress-actions"
        >

          <a
            href="
              course.html?id=${encodeURIComponent(
                enrollment.courseId ||
                enrollment.id
              )}
            "
            class="btn btn-primary"
          >

            ${
              progress >= 100
                ? `
                  <i class="
                    fa-solid
                    fa-rotate-right
                  "></i>
                  Review Course
                `
                : `
                  <i class="
                    fa-solid
                    fa-play
                  "></i>
                  Continue Learning
                `
            }

          </a>

        </div>

      </div>

    </article>

  `;

}


/* =====================================================
   GET PROGRESS
===================================================== */

function getProgress(
  enrollment
) {

  let progress =
    Number(
      enrollment.progress ??
      enrollment.progressPercentage ??
      enrollment.completionPercentage ??
      0
    );


  if (
    progress <= 1 &&
    progress > 0
  ) {

    progress *=
      100;

  }


  if (
    progress === 0
  ) {

    const completed =
      Number(
        enrollment.completedLessons ||
        0
      );


    const total =
      Number(
        enrollment.totalLessons ||
        enrollment.lessonsCount ||
        0
      );


    if (
      total > 0
    ) {

      progress =
        (
          completed /
          total
        ) *
        100;

    }

  }


  return Math.min(
    100,
    Math.max(
      0,
      Math.round(
        progress
      )
    )
  );

}


/* =====================================================
   STATISTICS
===================================================== */

function updateStatistics() {

  const total =
    enrollments.length;


  const completed =
    enrollments.filter(
      enrollment =>
        getProgress(
          enrollment
        ) >= 100
    ).length;


  const active =
    enrollments.filter(
      enrollment => {

        const p =
          getProgress(
            enrollment
          );

        return (
          p > 0 &&
          p < 100
        );

      }
    ).length;


  let overall =
    0;


  if (
    total
  ) {

    overall =
      enrollments.reduce(
        (
          totalProgress,
          enrollment
        ) =>
          totalProgress +
          getProgress(
            enrollment
          ),
        0
      ) /
      total;

  }


  overall =
    Math.round(
      overall
    );


  document.getElementById(
    "totalCourses"
  ).textContent =
    total;


  document.getElementById(
    "activeCourses"
  ).textContent =
    active;


  document.getElementById(
    "completedCourses"
  ).textContent =
    completed;


  document.getElementById(
    "overallProgress"
  ).textContent =
    `${overall}%`;


  document.getElementById(
    "overallProgressLabel"
  ).textContent =
    `${overall}%`;


  document.getElementById(
    "overallProgressBar"
  ).style.width =
    `${overall}%`;


  const message =
    document.getElementById(
      "progressMessage"
    );


  if (
    overall >= 100
  ) {

    message.textContent =
      "Excellent! You have completed all your enrolled courses.";

  }
  else if (
    overall >= 75
  ) {

    message.textContent =
      "Great progress! You are almost there.";

  }
  else if (
    overall >= 40
  ) {

    message.textContent =
      "Good work! Keep learning consistently.";

  }
  else if (
    overall > 0
  ) {

    message.textContent =
      "You have started your learning journey. Keep going.";

  }
  else {

    message.textContent =
      "Start learning to build your progress.";

  }

}


/* =====================================================
   FILTER
===================================================== */

filter.addEventListener(
  "change",
  () => {

    const value =
      filter.value;


    if (
      value ===
      "all"
    ) {

      filteredEnrollments =
        [...enrollments];

    }
    else if (
      value ===
      "completed"
    ) {

      filteredEnrollments =
        enrollments.filter(
          enrollment =>
            getProgress(
              enrollment
            ) >= 100
        );

    }
    else if (
      value ===
      "progress"
    ) {

      filteredEnrollments =
        enrollments.filter(
          enrollment => {

            const p =
              getProgress(
                enrollment
              );

            return (
              p > 0 &&
              p < 100
            );

          }
        );

    }
    else if (
      value ===
      "notStarted"
    ) {

      filteredEnrollments =
        enrollments.filter(
          enrollment =>
            getProgress(
              enrollment
            ) === 0
        );

    }


    renderProgress();

  }
);


/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHTML(
  value
) {

  return String(
    value ??
    ""
  )
    .replaceAll(
      "&",
      "&amp;"
    )
    .replaceAll(
      "<",
      "&lt;"
    )
    .replaceAll(
      ">",
      "&gt;"
    )
    .replaceAll(
      '"',
      "&quot;"
    )
    .replaceAll(
      "'",
      "&#039;"
    );

}

</script>


