  <button onclick="goTo('quiz.html')">
    📝 Quizzes
  </button>

  <button onclick="goTo('assignments.html')">
    📋 Assignments
  </button>

  <button onclick="goTo('course-resources.html')">
    📁 Resources
  </button>

  <button onclick="goTo('announcements.html')">
    📢 Announcements
  </button>

  <button class="active">
    ❓ FAQs
  </button>

</div>

<script>
const courseId =
  new URLSearchParams(location.search).get("courseId");

function goTo(page){

  if(!courseId){
    alert("Course ID is missing.");
    return;
  }

  location.href =
    `${page}?courseId=${encodeURIComponent(courseId)}`;
}
</script>

