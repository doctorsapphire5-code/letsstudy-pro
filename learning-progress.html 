async function loadModuleLessons(moduleId) {

  const container =
    document.getElementById(
      `module-${moduleId}`
    );

  if (!container) return;

  try {

    const snapshot =
      await getDocs(
        query(
          collection(db, "lessons"),
          where("courseId", "==", courseId),
          where("moduleId", "==", moduleId),
          orderBy("order", "asc")
        )
      );

    if (snapshot.empty) {

      container.innerHTML = `
        <div class="lesson">
          <div class="lesson-left">
            <i class="fa-regular fa-circle"></i>
            <span class="lesson-name">
              No lessons available
            </span>
          </div>
        </div>
      `;

      return;
    }

    container.innerHTML =
      snapshot.docs.map(docSnap => {

        const lesson =
          docSnap.data();

        const type =
          String(
            lesson.type || "video"
          ).toLowerCase();

        let icon =
          "fa-play-circle";

        if (type === "pdf")
          icon = "fa-file-pdf";

        if (type === "text")
          icon = "fa-file-lines";

        if (type === "video")
          icon = "fa-circle-play";

        return `
          <div
            class="lesson"
            data-lesson-id="${docSnap.id}"
          >

            <div class="lesson-left">

              <i
                class="fa-solid ${icon}"
              ></i>

              <span class="lesson-name">
                ${escapeHTML(
                  lesson.title || "Lesson"
                )}
              </span>

            </div>

            <span class="lesson-status">
              ${formatDuration(
                lesson.duration
              )}
            </span>

          </div>
        `;

      }).join("");

  } catch (error) {

    console.error(
      "Lessons:",
      error
    );

    container.innerHTML = `
      <div class="lesson">
        <span class="lesson-status">
          Unable to load lessons
        </span>
      </div>
    `;
  }
}


function toggleModule(moduleId) {

  const element =
