    loadCollection(
      "assignments"
    ),

    loadCollection(
      "resources"
    ),

    loadCollection(
      "announcements"
    ),

    loadCollection(
      "courseFAQs"
    ),

    loadCollection(
      "certificates"
    )

  ]);

  renderData();

}


/* =====================================================
   RENDER
===================================================== */

function renderData() {

  const title =
    courseData?.title ||
    "Learning Progress";

  const titleElement =
    document.getElementById(
      "courseTitle"
    );

  if (titleElement) {
    titleElement.textContent =
      title;
  }


  const counters = {

    moduleCount:
      modules.length,

    lessonCount:
      lessons.length,

    quizCount:
      quizzes.length,

    assignmentCount:
      assignments.length,

    resourceCount:
      resources.length,

    announcementCount:
      announcements.length,

    faqCount:
      faqs.length,

    certificateCount:
      certificates.length

  };


  Object.entries(
    counters
  ).forEach(
    ([id, value]) => {

      const element =
        document.getElementById(id);

      if (element) {
        element.textContent =
          value;
      }

    }
  );

}


/* =====================================================
   AUTH STATE
===================================================== */

onAuthStateChanged(
  auth,
  async user => {

    currentUser =
      user || null;

    try {

      await loadAllData();

    } catch (error) {

      console.error(
        "Learning Progress Firebase error:",
        error
      );

      showToast(
        "Unable to load course data.",
        true
      );

    }

  }
);


/* =====================================================
   EXPOSE NAVIGATION
===================================================== */

window.goTo =
  function(page) {

    if (!courseId) {

      showToast(
        "Course ID is missing.",
        true
      );

      return;
    }

    window.location.href =
      `${page}?courseId=${encodeURIComponent(
        courseId
      )}`;

  };


/* =====================================================
   FINAL
===================================================== */

console.log(
  "LetsStudy Pro Learning Progress initialized."
);

console.log(
  "Course ID:",
  courseId
);

</script>

