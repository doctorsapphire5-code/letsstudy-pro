<section class="content-section">

  <div class="page-header">

    <div>
      <span class="page-kicker">
        LEARNING
      </span>

      <h1>
        Learning Progress
      </h1>

      <p>
        Track your courses, lessons, modules and overall
        learning progress.
      </p>
    </div>

    <a
      href="courses.html"
      class="btn btn-primary"
    >
      <i class="fa-solid fa-book-open"></i>
      Browse Courses
    </a>

  </div>


  <!-- ===================================================
       PROGRESS OVERVIEW
  ==================================================== -->

  <div class="stats-grid">

    <div class="stat-card">

      <div class="stat-icon">
        <i class="fa-solid fa-book"></i>
      </div>

      <div>
        <span>Enrolled Courses</span>
        <strong id="totalCourses">0</strong>
      </div>

    </div>


    <div class="stat-card">

      <div class="stat-icon">
        <i class="fa-solid fa-circle-play"></i>
      </div>

      <div>
        <span>Courses In Progress</span>
        <strong id="activeCourses">0</strong>
      </div>

    </div>


    <div class="stat-card">

      <div class="stat-icon">
        <i class="fa-solid fa-circle-check"></i>
      </div>

      <div>
        <span>Completed Courses</span>
        <strong id="completedCourses">0</strong>
      </div>

    </div>


    <div class="stat-card">

      <div class="stat-icon">
        <i class="fa-solid fa-chart-line"></i>
