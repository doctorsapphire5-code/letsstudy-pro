<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="description" content="LetsStudy Pro Learning Progress Dashboard">
<meta name="theme-color" content="#2563eb">

<title>Learning Progress | LetsStudy Pro</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Inter,Arial,sans-serif;
  background:#f8fafc;
  color:#0f172a;
  min-height:100vh;
}

a{
  text-decoration:none;
  color:inherit;
}

button{
  font-family:inherit;
}

.topbar{
  height:70px;
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 28px;
  position:sticky;
  top:0;
  z-index:100;
}

.brand{
  display:flex;
  align-items:center;
  gap:10px;
  font-weight:800;
  font-size:18px;
}

.brand-icon{
  width:38px;
  height:38px;
  border-radius:10px;
  background:#2563eb;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
}

.brand span{
  color:#2563eb;
}

.top-actions{
  display:flex;
  align-items:center;
  gap:10px;
}

.top-btn{
  width:40px;
  height:40px;
  border:1px solid #e5e7eb;
  background:#fff;
  border-radius:10px;
  cursor:pointer;
  color:#475569;
}

.top-btn:hover{
  background:#f1f5f9;
}

.layout{
  display:flex;
  min-height:calc(100vh - 70px);
}

.sidebar{
  width:245px;
  background:#fff;
  border-right:1px solid #e5e7eb;
  padding:22px 15px;
  flex-shrink:0;
}

.nav-title{
  font-size:10px;
  font-weight:800;
  color:#94a3b8;
  text-transform:uppercase;
  margin:14px 10px 8px;
  letter-spacing:.08em;
}

.nav-item{
  display:flex;
  align-items:center;
  gap:11px;
  padding:11px 12px;
  border-radius:9px;
  color:#64748b;
  font-size:12px;
  font-weight:600;
  margin-bottom:3px;
}

.nav-item:hover{
  background:#f1f5f9;
  color:#2563eb;
}

.nav-item.active{
  background:#eff6ff;
  color:#2563eb;
}

.nav-item i{
  width:18px;
  text-align:center;
}

.main{
  flex:1;
  padding:28px;
  min-width:0;
}

.page-header{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:20px;
  margin-bottom:25px;
}

.page-header h1{
  font-size:26px;
  font-weight:800;
  margin-bottom:6px;
}

.page-header p{
  color:#64748b;
  font-size:12px;
}

.header-actions{
  display:flex;
  gap:8px;
}

.btn{
  border:0;
  border-radius:9px;
  padding:11px 15px;
  font-size:11px;
  font-weight:700;
  cursor:pointer;
  display:inline-flex;
  align-items:center;
  gap:7px;
}

.btn-primary{
  background:#2563eb;
  color:#fff;
}

.btn-primary:hover{
  background:#1d4ed8;
}

.btn-light{
  background:#fff;
  color:#475569;
  border:1px solid #e5e7eb;
}

.course-card{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:16px;
  overflow:hidden;
  margin-bottom:20px;
}

.course-content{
  padding:25px;
  display:grid;
  grid-template-columns:1fr 300px;
  gap:25px;
}

.course-label{
  display:inline-flex;
  align-items:center;
  gap:6px;
  background:#eff6ff;
  color:#2563eb;
  padding:6px 9px;
  border-radius:6px;
  font-size:10px;
  font-weight:800;
  margin-bottom:12px;
}

.course-title{
  font-size:23px;
  font-weight:800;
  line-height:1.3;
  margin-bottom:9px;
}

.course-description{
  font-size:12px;
  color:#64748b;
  line-height:1.7;
  max-width:700px;
  margin-bottom:18px;
}

.course-meta{
  display:flex;
  flex-wrap:wrap;
  gap:14px;
  color:#64748b;
  font-size:10px;
}

.course-meta span{
  display:flex;
  align-items:center;
  gap:5px;
}

.course-thumbnail{
  height:180px;
  border-radius:12px;
  overflow:hidden;
  background:#f1f5f9;
}

.course-thumbnail img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.progress-panel{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:16px;
  padding:22px;
  margin-bottom:20px;
}

.progress-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:14px;
}

.progress-header h2{
  font-size:15px;
  font-weight:800;
}

.progress-percent{
  font-size:20px;
  font-weight:800;
  color:#2563eb;
}

.progress-track{
  height:13px;
  background:#e2e8f0;
  border-radius:999px;
  overflow:hidden;
}

.progress-fill{
  height:100%;
  width:0%;
  background:#2563eb;
  border-radius:inherit;
  transition:width .5s ease;
}

.progress-info{
  display:flex;
  justify-content:space-between;
  gap:10px;
  margin-top:10px;
  font-size:10px;
  color:#64748b;
}

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
  margin-bottom:20px;
}

.stat{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:13px;
  padding:18px;
}

.stat-icon{
  width:36px;
  height:36px;
  border-radius:9px;
  background:#eff6ff;
  color:#2563eb;
  display:flex;
  align-items:center;
  justify-content:center;
  margin-bottom:12px;
}

.stat-label{
  color:#64748b;
  font-size:10px;
  margin-bottom:5px;
}

.stat-value{
  font-size:19px;
  font-weight:800;
}

.content-grid{
  display:grid;
  grid-template-columns:1.4fr .8fr;
  gap:20px;
}

.content-card{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:15px;
  padding:20px;
}

.content-card h2{
  font-size:14px;
  font-weight:800;
  margin-bottom:15px;
}

.module{
  border:1px solid #e5e7eb;
  border-radius:11px;
  margin-bottom:10px;
  overflow:hidden;
}

.module-header{
  padding:14px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  cursor:pointer;
  background:#fff;
}

.module-header:hover{
  background:#f8fafc;
}

.module-title{
  display:flex;
  align-items:center;
  gap:10px;
  min-width:0;
}

.module-number{
  width:30px;
  height:30px;
  border-radius:8px;
  background:#eff6ff;
  color:#2563eb;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:10px;
  font-weight:800;
  flex-shrink:0;
}

.module-title strong{
  display:block;
  font-size:11px;
  margin-bottom:3px;
}

.module-title span{
  font-size:9px;
  color:#94a3b8;
}

.module-progress{
  font-size:10px;
  color:#64748b;
  white-space:nowrap;
}

.lesson-list{
  display:none;
  border-top:1px solid #e5e7eb;
  background:#f8fafc;
}

.module.open .lesson-list{
  display:block;
}

.lesson{
  padding:11px 14px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  border-bottom:1px solid #e5e7eb;
  font-size:10px;
  cursor:pointer;
}

.lesson:hover{
  background:#f1f5f9;
}

.lesson:last-child{
  border-bottom:0;
}

.lesson-left{
  display:flex;
  align-items:center;
  gap:9px;
  min-width:0;
}

.lesson-left i{
  color:#64748b;
}

.lesson.completed .lesson-left i{
  color:#16a34a;
}

.lesson-name{
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.lesson-status{
  font-size:9px;
  color:#64748b;
}

.activity{
  display:flex;
  gap:10px;
  padding:12px 0;
  border-bottom:1px solid #f1f5f9;
}

.activity:last-child{
  border-bottom:0;
}

.activity-icon{
  width:32px;
  height:32px;
  border-radius:50%;
  background:#eff6ff;
  color:#2563eb;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
  font-size:11px;
}

.activity-text{
  font-size:10px;
  line-height:1.5;
}

.activity-time{
  color:#94a3b8;
  font-size:9px;
  margin-top:3px;
}

.certificate{
  margin-top:18px;
  padding:17px;
  border-radius:12px;
  background:#f8fafc;
  border:1px solid #e5e7eb;
}

.certificate h3{
  font-size:12px;
  margin-bottom:6px;
}

.certificate p{
  color:#64748b;
  font-size:10px;
  line-height:1.5;
}

.certificate-card{
  border:1px solid #dbeafe;
  background:#eff6ff;
  border-radius:12px;
  padding:15px;
  margin-top:12px;
}

.certificate-number{
  font-size:9px;
  color:#64748b;
  margin-top:5px;
}

.status-badge{
  display:inline-flex;
  padding:5px 8px;
  border-radius:999px;
  background:#dcfce7;
  color:#15803d;
  font-size:9px;
  font-weight:800;
  margin-top:8px;
}

.course-buttons{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
  gap:10px;
  margin:0 0 20px;
}

.course-buttons button{
  border:1px solid #e4e7ec;
  background:#fff;
  color:#344054;
  padding:13px 12px;
  border-radius:12px;
  font-weight:800;
  cursor:pointer;
  transition:.2s;
}

.course-buttons button:hover{
  transform:translateY(-2px);
  border-color:#155eef;
  color:#155eef;
  box-shadow:0 5px 15px #10182812;
}

.loading{
  min-height:300px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:10px;
  color:#64748b;
  font-size:12px;
}

.loading i{
  font-size:25px;
  color:#2563eb;
}

.empty{
  text-align:center;
  padding:50px 20px;
}

.empty i{
  font-size:35px;
  color:#94a3b8;
  margin-bottom:15px;
}

.empty h2{
  font-size:18px;
  margin-bottom:7px;
}

.empty p{
  font-size:11px;
  color:#64748b;
  margin-bottom:18px;
}

.toast{
  position:fixed;
  right:20px;
  bottom:20px;
  padding:12px 16px;
  background:#0f172a;
  color:#fff;
  border-radius:9px;
  font-size:11px;
  transform:translateY(100px);
  opacity:0;
  transition:.3s;
  z-index:9999;
}

.toast.show{
  transform:translateY(0);
  opacity:1;
}

.toast.error{
  background:#dc2626;
}

@media(max-width:1000px){

  .sidebar{
    width:210px;
  }

  .course-content{
    grid-template-columns:1fr;
  }

  .course-thumbnail{
    height:220px;
  }

  .content-grid{
    grid-template-columns:1fr;
  }
}

@media(max-width:750px){

  .sidebar{
    display:none;
  }

  .main{
    padding:18px;
  }

  .stats{
    grid-template-columns:repeat(2,1fr);
  }

  .page-header{
    flex-direction:column;
  }

  .header-actions{
    width:100%;
  }

  .header-actions .btn{
    flex:1;
    justify-content:center;
  }
}

@media(max-width:450px){

  .topbar{
    padding:0 15px;
  }

  .brand{
    font-size:15px;
  }

  .stats{
    grid-template-columns:1fr;
  }

  .course-title{
    font-size:20px;
  }

  .progress-info{
    flex-direction:column;
  }
}
</style>
</head>

<body>

<header class="topbar">

  <a href="index.html" class="brand">

    <div class="brand-icon">
      <i class="fa-solid fa-graduation-cap"></i>
    </div>

    LetsStudy <span>Pro</span>

  </a>

  <div class="top-actions">

    <button
      class="top-btn"
      onclick="location.href='courses.html'"
      title="Courses"
    >
      <i class="fa-solid fa-book-open"></i>
    </button>

    <button
      class="top-btn"
      onclick="location.href='profile.html'"
      title="Profile"
    >
      <i class="fa-solid fa-user"></i>
    </button>

  </div>

</header>


<div class="layout">


<aside class="sidebar">

  <div class="nav-title">Learning</div>

  <a class="nav-item active" href="#">
    <i class="fa-solid fa-chart-line"></i>
    Learning Progress
  </a>

  <a class="nav-item" id="modulesLink" href="#">
    <i class="fa-solid fa-layer-group"></i>
    Modules
  </a>

  <a class="nav-item" id="lessonsLink" href="#">
    <i class="fa-solid fa-play"></i>
    Lessons
  </a>

  <a class="nav-item" id="quizLink" href="#">
    <i class="fa-solid fa-circle-question"></i>
    Quizzes
  </a>

  <a class="nav-item" id="assignmentsLink" href="#">
    <i class="fa-solid fa-file-pen"></i>
    Assignments
  </a>

  <div class="nav-title">Course</div>

  <a class="nav-item" id="resourcesLink" href="#">
    <i class="fa-solid fa-folder-open"></i>
    Resources
  </a>

  <a class="nav-item" id="announcementsLink" href="#">
    <i class="fa-solid fa-bullhorn"></i>
    Announcements
  </a>

  <a class="nav-item" id="faqLink" href="#">
    <i class="fa-solid fa-circle-info"></i>
    FAQs
  </a>

  <a class="nav-item" id="certificateLink" href="#">
    <i class="fa-solid fa-certificate"></i>
    Certificate
  </a>

</aside>


<main class="main">

  <div class="page-header">

    <div>

      <h1>Learning Progress</h1>

      <p>
        Track your progress and continue learning.
      </p>

    </div>

    <div class="header-actions">

      <button
        class="btn btn-light"
        onclick="history.back()"
      >
        <i class="fa-solid fa-arrow-left"></i>
        Back
      </button>

      <button
        class="btn btn-primary"
        id="continueBtn"
      >
        <i class="fa-solid fa-play"></i>
        Continue Learning
      </button>

    </div>

  </div>


  <!-- COURSE NAVIGATION BUTTONS -->

  <div class="course-buttons">

    <button onclick="goTo('modules.html')">
      📚 Modules
    </button>

    <button onclick="goTo('lesson.html')">
      🎬 Lessons
    </button>

    <button onclick="goTo('quiz.html')">
      📝 Quizzes
    </button>

    <button onclick="goTo('assignments.html')">
      📋 Assignments
    </button>

    <button onclick="goTo('course-resources.html')">
      📁 Resources
    </button>

    <button onclick="goTo('announcements.html')">
      📢 Announcements
    </button>

    <button onclick="goTo('course-faqs.html')">
      ❓ FAQs
    </button>

  </div>


  <!-- COURSE -->

  <section class="course-card">

    <div class="course-content">

      <div>

        <div class="course-label">
          <i class="fa-solid fa-graduation-cap"></i>
          CURRENT COURSE
        </div>

        <h2 class="course-title" id="courseTitle">
          Loading course...
        </h2>

        <p class="course-description" id="courseDescription">
          Loading course description...
        </p>

        <div class="course-meta">

          <span>
            <i class="fa-solid fa-layer-group"></i>
            <b id="metaModules">0</b> Modules
          </span>

          <span>
            <i class="fa-solid fa-play"></i>
            <b id="metaLessons">0</b> Lessons
          </span>

          <span>
            <i class="fa-solid fa-circle-question"></i>
            <b id="metaQuizzes">0</b> Quizzes
          </span>

          <span>
            <i class="fa-solid fa-file"></i>
            <b id="metaAssignments">0</b> Assignments
          </span>

        </div>

      </div>

      <div class="course-thumbnail">

        <img
          id="courseImage"
          src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1200&q=85"
          alt="Course"
        >

      </div>

    </div>

  </section>


  <!-- PROGRESS -->

  <section class="progress-panel">

    <div class="progress-header">

      <h2>Your Course Progress</h2>

      <div
        class="progress-percent"
        id="progressPercent"
      >
        0%
      </div>

    </div>

    <div class="progress-track">

      <div
        class="progress-fill"
        id="progressFill"
      ></div>

    </div>

    <div class="progress-info">

      <span id="progressText">
        0 of 0 lessons completed
      </span>

      <span id="progressRemaining">
        Start learning
      </span>

    </div>

  </section>


  <!-- STATS -->

  <section class="stats">

    <div class="stat">

      <div class="stat-icon">
        <i class="fa-solid fa-layer-group"></i>
      </div>

      <div class="stat-label">
        Modules
      </div>

      <div class="stat-value" id="statModules">
        0
      </div>

    </div>


    <div class="stat">

      <div class="stat-icon">
        <i class="fa-solid fa-play"></i>
      </div>

      <div class="stat-label">
        Lessons
      </div>

      <div class="stat-value" id="statLessons">
        0
      </div>

    </div>


    <div class="stat">

      <div class="stat-icon">
        <i class="fa-solid fa-circle-question"></i>
      </div>

      <div class="stat-label">
        Quizzes
      </div>

      <div class="stat-value" id="statQuizzes">
        0
      </div>

    </div>


    <div class="stat">

      <div class="stat-icon">
        <i class="fa-solid fa-file-pen"></i>
      </div>

      <div class="stat-label">
        Assignments
      </div>

      <div class="stat-value" id="statAssignments">
        0
      </div>

    </div>

  </section>


  <!-- CONTENT -->

  <section class="content-grid">


    <!-- MODULES -->

    <div class="content-card">

      <h2>
        Course Modules
      </h2>

      <div id="modulesContainer">

        <div class="loading">

          <i class="fa-solid fa-spinner fa-spin"></i>

          Loading modules...

        </div>

      </div>

    </div>


    <!-- RIGHT -->

    <div>


      <!-- ACTIVITY -->

      <div class="content-card">

        <h2>
          Course Overview
        </h2>

        <div id="overviewContainer">

          <div class="activity">

            <div class="activity-icon">
              <i class="fa-solid fa-book"></i>
            </div>

            <div class="activity-text">

              <strong id="overviewCourse">
                Loading course...
              </strong>

              <div class="activity-time">
                Course
              </div>

            </div>

          </div>


          <div class="activity">

            <div class="activity-icon">
              <i class="fa-solid fa-folder"></i>
            </div>

            <div class="activity-text">

              <strong id="overviewResources">
                0 Resources
              </strong>

              <div class="activity-time">
                Learning materials
              </div>

            </div>

          </div>


          <div class="activity">

            <div class="activity-icon">
              <i class="fa-solid fa-bullhorn"></i>
            </div>

            <div class="activity-text">

              <strong id="overviewAnnouncements">
                0 Announcements
              </strong>

              <div class="activity-time">
                Course updates
              </div>

            </div>

          </div>


          <div class="activity">

            <div class="activity-icon">
              <i class="fa-solid fa-circle-question"></i>
            </div>

            <div class="activity-text">

              <strong id="overviewFAQs">
                0 FAQs
              </strong>

              <div class="activity-time">
                Frequently asked questions
              </div>

            </div>

          </div>

        </div>


        <!-- CERTIFICATE -->

        <div class="certificate">

          <h3>
            <i class="fa-solid fa-certificate"></i>
            Certificate
          </h3>

          <p id="certificateMessage">
            Complete the required course activities
            to become eligible for your certificate.
          </p>

          <div id="certificateContainer"></div>

        </div>

      </div>

    </div>

  </section>

</main>

</div>


<div class="toast" id="toast"></div>


<script type="module">

import {
  initializeApp,
  getApps,
  getApp
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

import {
  getFirestore,
  collection,
  doc,
  getDoc,
  getDocs,
  query,
  where
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

import {
  getAuth,
