
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Loading | LetsStudy Pro</title>
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="#0f172a">

<style>
*{box-sizing:border-box}

body{
  margin:0;
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
  font-family:Arial,sans-serif;
  background:#f1f5f9;
  color:#0f172a;
}

.container{
  width:100%;
  max-width:480px;
  background:white;
  padding:45px 30px;
  border-radius:20px;
  text-align:center;
  box-shadow:0 10px 35px rgba(15,23,42,.08);
}

.logo{
  font-size:25px;
  font-weight:bold;
  color:#2563eb;
  margin-bottom:45px;
}

.loader{
  width:75px;
  height:75px;
  border:6px solid #dbeafe;
  border-top:6px solid #2563eb;
  border-radius:50%;
  margin:0 auto 30px;
  animation:spin 1s linear infinite;
}

@keyframes spin{
  to{transform:rotate(360deg)}
}

h1{
  font-size:25px;
  margin:10px 0;
}

.description{
  color:#64748b;
  font-size:14px;
  line-height:1.7;
  margin-bottom:25px;
}

.progress{
  width:100%;
  height:7px;
  background:#e2e8f0;
  border-radius:20px;
  overflow:hidden;
  margin:25px 0 12px;
}

.progress-bar{
  width:35%;
  height:100%;
  background:#2563eb;
  border-radius:20px;
  animation:progress 2s ease-in-out infinite;
}

@keyframes progress{
  0%{transform:translateX(-100%)}
  100%{transform:translateX(300%)}
}

.status{
  font-size:12px;
  color:#64748b;
}

footer{
  margin-top:40px;
  font-size:12px;
  color:#94a3b8;
}
</style>
</head>

<body>

<div class="container">

  <div class="logo">LetsStudy Pro</div>

  <div class="loader"></div>

  <h1 id="loadingTitle">Please Wait...</h1>

  <p class="description" id="loadingMessage">
    We are preparing your experience.
    Please wait while the system loads.
  </p>

  <div class="progress">
    <div class="progress-bar"></div>
  </div>

  <div class="status" id="loadingStatus">
    Initializing system...
  </div>

  <footer>
    LetsStudy Pro · The Digital Ecosystem<br>
    Learn. Build. Work. Grow.
  </footer>

</div>

<script>
const messages = [
  "Initializing system...",
  "Preparing your experience...",
  "Connecting services...",
  "Loading resources...",
  "Almost ready..."
];

let index = 0;

setInterval(()=>{
  index = (index + 1) % messages.length;
  document.getElementById("loadingStatus").textContent =
    messages[index];
},2500);

// Allow other pages to update the loading message.
window.setLoadingMessage = function(title,message,status){
  if(title){
    document.getElementById("loadingTitle").textContent = title;
  }

  if(message){
    document.getElementById("loadingMessage").textContent = message;
  }

  if(status){
    document.getElementById("loadingStatus").textContent = status;
  }
};
</script>

</body>
</html>
