
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#111827">
  <title>Admin Account | Vorix Market</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background: #f3f6fb;
      color: #172033;
    }

    header {
      background: #111827;
      color: white;
      padding: 17px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    header h2 {
      font-size: 19px;
    }

    header a {
      color: white;
      text-decoration: none;
      font-size: 13px;
    }

    .container {
      max-width: 950px;
      margin: 30px auto;
      padding: 0 16px;
    }

    .heading {
      margin-bottom: 20px;
    }

    .heading h1 {
      font-size: 25px;
      margin-bottom: 7px;
    }

    .heading p {
      font-size: 14px;
      color: #64748b;
    }

    .card {
      background: white;
      border-radius: 13px;
      padding: 23px;
      margin-bottom: 20px;
      box-shadow: 0 5px 25px rgba(0,0,0,.05);
    }

    .card h3 {
      font-size: 17px;
      margin-bottom: 17px;
    }

    .details {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .detail {
      background: #f8fafc;
      border: 1px solid #e8edf4;
      border-radius: 8px;
      padding: 14px;
      min-width: 0;
    }

    .detail label {
      display: block;
      color: #64748b;
      font-size: 12px;
      margin-bottom: 8px;
    }

    .detail p {
      font-size: 14px;
      font-weight: 600;
      overflow-wrap: anywhere;
    }

    .form-group {
      margin-bottom: 15px;
    }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 7px;
    }

    .form-group input {
      width: 100%;
      padding: 13px;
      border: 1px solid #d9e0ea;
      border-radius: 8px;
      outline: none;
      font-size: 14px;
      background: #fff;
    }

    .form-group input:focus {
      border-color: #1d4ed8;
    }

    .btn {
      display: inline-block;
      padding: 12px 17px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      text-decoration: none;
      font-size: 13px;
      font-weight: bold;
      text-align: center;
    }

    .primary {
      background: #1d4ed8;
      color: white;
    }

    .secondary {
      background: #e8edf5;
      color: #172033;
    }

    .danger {
      background: #fee2e2;
      color: #b91c1c;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 20px;
    }

    .message {
      display: none;
      padding: 13px;
      border-radius: 8px;
      margin-bottom: 16px;
      font-size: 14px;
    }

    .notice {
      color: #854d0e;
      background: #fef9c3;
      border: 1px solid #fde68a;
      padding: 12px;
      border-radius: 8px;
      font-size: 13px;
      line-height: 1.6;
      margin-bottom: 16px;
    }

    #loading {
      text-align: center;
      padding: 45px 10px;
      color: #64748b;
    }

    footer {
      text-align: center;
      padding: 25px;
      color: #64748b;
      font-size: 12px;
    }

    @media(max-width: 600px) {
      .details {
        grid-template-columns: 1fr;
      }

      .card {
        padding: 17px;
      }

      .actions .btn {
        flex: 1;
      }
    }
  </style>
</head>

<body>

<header>
  <h2>Vorix Market</h2>
  <a href="market-admin-dashboard.html">Dashboard</a>
</header>

<main class="container">

  <div class="heading">
    <h1>Account Management</h1>
    <p>Manage your administrator account and security.</p>
  </div>

  <div class="message" id="message"></div>

  <div id="loading">Loading account information...</div>

  <section id="accountContent" hidden>

    <div class="card">
      <h3>Account Information</h3>

      <div class="details">

        <div class="detail">
          <label>Admin ID</label>
          <p id="adminId">—</p>
        </div>

        <div class="detail">
          <label>Full Name</label>
          <p id="fullName">—</p>
        </div>

        <div class="detail">
          <label>Email Address</label>
          <p id="email">—</p>
        </div>

        <div class="detail">
          <label>Username</label>
          <p id="username">—</p>
        </div>

        <div class="detail">
          <label>Firebase UID</label>
          <p id="uid">—</p>
        </div>

        <div class="detail">
          <label>Phone Number</label>
          <p id="phoneNumber">—</p>
        </div>

        <div class="detail">
          <label>Account Role</label>
          <p id="role">—</p>
        </div>

        <div class="detail">
          <label>Admin Type</label>
          <p id="adminType">—</p>
        </div>

        <div class="detail">
          <label>Access Level</label>
          <p id="accessLevel">—</p>
        </div>

        <div class="detail">
          <label>Account Status</label>
          <p id="status">—</p>
        </div>

      </div>
    </div>

    <div class="card">
      <h3>Account Security</h3>

      <div class="details">

        <div class="detail">
          <label>Email Verification</label>
          <p id="emailVerified">—</p>
        </div>

        <div class="detail">
          <label>Phone Verification</label>
          <p id="phoneVerified">—</p>
        </div>

        <div class="detail">
          <label>Two-Factor Authentication</label>
          <p id="twoFactorEnabled">—</p>
        </div>

        <div class="detail">
          <label>Login Count</label>
          <p id="loginCount">—</p>
        </div>

        <div class="detail">
          <label>Last Login</label>
          <p id="lastLoginAt">—</p>
        </div>

        <div class="detail">
          <label>Last Login Device</label>
          <p id="lastLoginDevice">—</p>
        </div>

      </div>
    </div>

    <div class="card">
      <h3>Change Password</h3>

      <div class="notice">
        For security, Firebase may require you to sign in again before changing your password.
        Your password is managed by Firebase Authentication and is never stored in Firestore.
      </div>

      <form id="passwordForm">

        <div class="form-group">
          <label for="currentPassword">Current Password</label>
          <input
            type="password"
            id="currentPassword"
            autocomplete="current-password"
            required
          >
        </div>

        <div class="form-group">
          <label for="newPassword">New Password</label>
          <input
            type="password"
            id="newPassword"
            minlength="8"
            autocomplete="new-password"
            required
          >
        </div>

        <div class="form-group">
          <label for="confirmPassword">Confirm New Password</label>
          <input
            type="password"
            id="confirmPassword"
            minlength="8"
            autocomplete="new-password"
            required
          >
        </div>

        <button type="submit" class="btn primary" id="changePasswordBtn">
          Change Password
        </button>

      </form>
    </div>

    <div class="card">
      <h3>Account Actions</h3>

      <div class="actions">

        <a href="market-admin-profile.html" class="btn secondary">
          View Profile
        </a>

        <a href="market-admin-edit-profile.html" class="btn secondary">
          Edit Profile
        </a>

        <a href="market-admin-settings.html" class="btn secondary">
          Account Settings
        </a>

        <a href="market-admin-forgot-password.html" class="btn secondary">
          Forgot Password
        </a>

        <button type="button" class="btn danger" id="logoutBtn">
          Logout
        </button>

      </div>
    </div>

  </section>

</main>

<footer>
  Vorix Market Administrator Portal
</footer>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>

<script>
  // Firebase Configuration
  const firebaseConfig = {
    apiKey: "AIzaSyBTMnT-PhJ44Hamu2EHyqnbP5EBoiFwGqY",
    authDomain: "vorix-market.firebaseapp.com",
    databaseURL: "https://vorix-market-default-rtdb.firebaseio.com",
    projectId: "vorix-market",
    storageBucket: "vorix-market.firebasestorage.app",
    messagingSenderId: "686555609094",
    appId: "1:686555609094:web:61f3e1853c0fca143a2b87",
    measurementId: "G-2KNWRG4X08"
  };

  if (!firebase.apps.length) {
    firebase.initializeApp(firebaseConfig);
  }

  const auth = firebase.auth();
  const db = firebase.firestore();

  const $ = id => document.getElementById(id);

  let currentAdmin = null;
  let currentUser = null;

  function setText(id, value) {
    $(id).textContent =
      value === undefined || value === null || value === ""
        ? "—"
        : String(value);
  }

  function formatDate(value) {
    if (!value) return "—";

    let date;

    if (typeof value.toDate === "function") {
      date = value.toDate();
    } else {
      date = new Date(value);
    }

    if (isNaN(date.getTime())) return "—";

    return date.toLocaleString();
  }

  function showMessage(message, type = "error") {
    const box = $("message");

    box.textContent = message;
    box.style.display = "block";

    box.style.background =
      type === "success" ? "#dcfce7" : "#fee2e2";

    box.style.color =
      type === "success" ? "#166534" : "#991b1b";

    box.scrollIntoView({
      behavior: "smooth",
      block: "center"
    });
  }

  async function loadAccount(user) {
    const adminId = sessionStorage.getItem("adminId");

    if (!adminId) {
      throw new Error("Admin ID not found. Please log in again.");
    }

    const adminRef = db.collection("admins").doc(adminId);
    const snap = await adminRef.get();

    if (!snap.exists) {
      throw new Error("Administrator record not found.");
    }

    const admin = snap.data();

    if (
      admin.adminId !== adminId ||
      admin.status !== "active" ||
      admin.role !== "admin" ||
      (admin.uid && admin.uid !== user.uid) ||
      !admin.email ||
      admin.email.toLowerCase() !== user.email?.toLowerCase() ||
      !user.emailVerified
    ) {
      throw new Error("Administrator access denied.");
    }

    // Synchronize verified email status.
    if (admin.emailVerified !== true) {
      await adminRef.update({
        emailVerified: true,
        updatedAt: firebase.firestore.FieldValue.serverTimestamp()
      });
    }

    currentAdmin = admin;
    currentUser = user;

    setText("adminId", admin.adminId);
    setText("fullName", admin.fullName || admin.displayName);
    setText("email", user.email);
    setText("username", admin.username);
    setText("uid", user.uid);
    setText("phoneNumber", admin.phoneNumber);
    setText("role", admin.role);
    setText("adminType", admin.adminType);
    setText("accessLevel", admin.accessLevel);
    setText("status", admin.status);

    setText(
      "emailVerified",
      user.emailVerified ? "Verified" : "Not verified"
    );

    setText(
      "phoneVerified",
      admin.phoneVerified ? "Verified" : "Not verified"
    );

    setText(
      "twoFactorEnabled",
      admin.twoFactorEnabled ? "Enabled" : "Disabled"
    );

    setText("loginCount", admin.loginCount ?? 0);
    setText("lastLoginAt", formatDate(admin.lastLoginAt));
    setText("lastLoginDevice", admin.lastLoginDevice);

    $("loading").style.display = "none";
    $("accountContent").hidden = false;
  }

  // Change password using Firebase Authentication.
  $("passwordForm").addEventListener("submit", async event => {
    event.preventDefault();

    if (!currentUser || !currentAdmin) {
      showMessage("Account information is not ready.");
      return;
    }

    const currentPassword = $("currentPassword").value;
    const newPassword = $("newPassword").value;
    const confirmPassword = $("confirmPassword").value;

    if (newPassword.length < 8) {
      showMessage("New password must contain at least 8 characters.");
      return;
    }

    if (newPassword !== confirmPassword) {
      showMessage("New password and confirmation do not match.");
      return;
    }

    if (newPassword === currentPassword) {
      showMessage("New password must be different from current password.");
      return;
    }

    const button = $("changePasswordBtn");
    button.disabled = true;
    button.textContent = "Updating...";

    try {
      const credential = firebase.auth.EmailAuthProvider.credential(
        currentUser.email,
        currentPassword
      );

      await currentUser.reauthenticateWithCredential(credential);

      await currentUser.updatePassword(newPassword);

      $("passwordForm").reset();

      showMessage(
        "Your password has been changed successfully.",
        "success"
      );

    } catch (error) {
      console.error("Password update error:", error);

      let message = "Unable to change password.";

      if (error.code === "auth/wrong-password" ||
          error.code === "auth/invalid-credential") {
        message = "Your current password is incorrect.";
      } else if (error.code === "auth/weak-password") {
        message = "Your new password is too weak.";
      } else if (error.code === "auth/requires-recent-login") {
        message = "Please sign in again and retry this operation.";
      } else if (error.code === "auth/network-request-failed") {
        message = "Network error. Check your internet connection.";
      }

      showMessage(message);

    } finally {
      button.disabled = false;
      button.textContent = "Change Password";
    }
  });

  // Authentication listener.
  auth.onAuthStateChanged(async user => {
    if (!user) {
      sessionStorage.removeItem("adminId");
      window.location.replace("market-admin-login.html");
      return;
    }

    try {
      await loadAccount(user);

    } catch (error) {
      console.error("Account loading error:", error);

      $("loading").style.display = "none";
      showMessage(error.message || "Unable to load account.");

      sessionStorage.removeItem("adminId");

      await auth.signOut();

      setTimeout(() => {
        window.location.replace("market-admin-login.html");
      }, 2500);
    }
  });

  // Logout.
  $("logoutBtn").addEventListener("click", async () => {
    try {
      sessionStorage.removeItem("adminId");
      await auth.signOut();
      window.location.replace("market-admin-login.html");

    } catch (error) {
      console.error("Logout error:", error);
      showMessage("Unable to log out. Please try again.");
    }
  });
</script>

</body>
</html>
