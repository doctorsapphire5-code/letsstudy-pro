
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#111827">
  <title>Admin Profile | Vorix Market</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background: #f3f6fb;
      color: #172033;
    }

    header {
      background: #111827;
      color: #fff;
      padding: 17px 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    header h2 {
      font-size: 19px;
    }

    header a {
      color: #fff;
      text-decoration: none;
      font-size: 13px;
    }

    .container {
      width: 100%;
      max-width: 1000px;
      margin: 30px auto;
      padding: 0 16px;
    }

    .page-heading {
      margin-bottom: 20px;
    }

    .page-heading h1 {
      font-size: 25px;
      margin-bottom: 7px;
    }

    .page-heading p {
      color: #64748b;
      font-size: 14px;
    }

    .card {
      background: #fff;
      border-radius: 14px;
      padding: 25px;
      box-shadow: 0 5px 25px rgba(0,0,0,.05);
      margin-bottom: 20px;
    }

    .profile-header {
      display: flex;
      align-items: center;
      gap: 20px;
      padding-bottom: 24px;
      border-bottom: 1px solid #e5eaf1;
    }

    .avatar {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: #1d4ed8;
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 32px;
      font-weight: bold;
      overflow: hidden;
      flex-shrink: 0;
    }

    .avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .profile-header h2 {
      font-size: 23px;
      margin-bottom: 7px;
      overflow-wrap: anywhere;
    }

    .profile-header p {
      font-size: 14px;
      color: #64748b;
      overflow-wrap: anywhere;
    }

    .status {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 30px;
      background: #dcfce7;
      color: #166534;
      font-size: 11px;
      font-weight: bold;
      margin-top: 10px;
    }

    .section-title {
      font-size: 16px;
      margin: 25px 0 15px;
    }

    .details {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .detail {
      padding: 14px;
      border: 1px solid #e8edf4;
      background: #f8fafc;
      border-radius: 9px;
      min-width: 0;
    }

    .detail label {
      display: block;
      color: #64748b;
      font-size: 12px;
      margin-bottom: 8px;
    }

    .detail p {
      color: #172033;
      font-size: 14px;
      font-weight: 600;
      overflow-wrap: anywhere;
    }

    .permissions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .permission {
      background: #eaf0ff;
      color: #1d4ed8;
      padding: 7px 11px;
      border-radius: 20px;
      font-size: 12px;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 25px;
    }

    .btn {
      padding: 12px 17px;
      border: none;
      border-radius: 8px;
      font-size: 13px;
      font-weight: bold;
      cursor: pointer;
      text-decoration: none;
      text-align: center;
      display: inline-block;
    }

    .primary {
      background: #1d4ed8;
      color: white;
    }

    .secondary {
      background: #e8edf5;
      color: #172033;
    }

    .danger {
      background: #fee2e2;
      color: #b91c1c;
    }

    .message {
      display: none;
      padding: 13px;
      border-radius: 8px;
      margin-bottom: 18px;
      font-size: 14px;
    }

    #loading {
      text-align: center;
      padding: 55px 10px;
      color: #64748b;
    }

    footer {
      text-align: center;
      padding: 25px;
      color: #64748b;
      font-size: 12px;
    }

    @media(max-width: 600px) {
      .details {
        grid-template-columns: 1fr;
      }

      .card {
        padding: 17px;
      }

      .profile-header {
        align-items: flex-start;
        gap: 14px;
      }

      .avatar {
        width: 68px;
        height: 68px;
        font-size: 24px;
      }

      .profile-header h2 {
        font-size: 19px;
      }

      .actions .btn {
        flex: 1;
      }
    }
  </style>
</head>

<body>

<header>
  <h2>Vorix Market</h2>
  <a href="market-admin-dashboard.html">Dashboard</a>
</header>

<main class="container">

  <div class="page-heading">
    <h1>Admin Profile</h1>
    <p>View your administrator account information.</p>
  </div>

  <div class="message" id="message"></div>

  <div id="loading">Loading administrator profile...</div>

  <section id="profileContent" hidden>

    <div class="card">

      <div class="profile-header">

        <div class="avatar" id="avatar">A</div>

        <div>
          <h2 id="fullName">Administrator</h2>
          <p id="profileEmail">admin@example.com</p>
          <span class="status" id="profileStatus">ACTIVE</span>
        </div>

      </div>

      <h3 class="section-title">Personal Information</h3>

      <div class="details">

        <div class="detail">
          <label>Admin ID</label>
          <p id="adminId">—</p>
        </div>

        <div class="detail">
          <label>Username</label>
          <p id="username">—</p>
        </div>

        <div class="detail">
          <label>First Name</label>
          <p id="firstName">—</p>
        </div>

        <div class="detail">
          <label>Last Name</label>
          <p id="lastName">—</p>
        </div>

        <div class="detail">
          <label>Display Name</label>
          <p id="displayName">—</p>
        </div>

        <div class="detail">
          <label>Email Address</label>
          <p id="email">—</p>
        </div>

        <div class="detail">
          <label>Phone Number</label>
          <p id="phoneNumber">—</p>
        </div>

        <div class="detail">
          <label>Country</label>
          <p id="country">—</p>
        </div>

        <div class="detail">
          <label>Department</label>
          <p id="department">—</p>
        </div>

        <div class="detail">
          <label>Language</label>
          <p id="language">—</p>
        </div>

        <div class="detail">
          <label>Timezone</label>
          <p id="timezone">—</p>
        </div>

      </div>

      <h3 class="section-title">Administrator Access</h3>

      <div class="details">

        <div class="detail">
          <label>Role</label>
          <p id="role">—</p>
        </div>

        <div class="detail">
          <label>Admin Type</label>
          <p id="adminType">—</p>
        </div>

        <div class="detail">
          <label>Access Level</label>
          <p id="accessLevel">—</p>
        </div>

        <div class="detail">
          <label>Account Status</label>
          <p id="status">—</p>
        </div>

      </div>

      <h3 class="section-title">Permissions</h3>

      <div class="detail">
        <div class="permissions" id="permissions">
          <span class="permission">No permissions listed</span>
        </div>
      </div>

      <h3 class="section-title">Account Security</h3>

      <div class="details">

        <div class="detail">
          <label>Email Verification</label>
          <p id="emailVerified">—</p>
        </div>

        <div class="detail">
          <label>Phone Verification</label>
          <p id="phoneVerified">—</p>
        </div>

        <div class="detail">
          <label>Two-Factor Authentication</label>
          <p id="twoFactorEnabled">—</p>
        </div>

        <div class="detail">
          <label>Login Count</label>
          <p id="loginCount">—</p>
        </div>

        <div class="detail">
          <label>Last Login</label>
          <p id="lastLoginAt">—</p>
        </div>

        <div class="detail">
          <label>Last Login Device</label>
          <p id="lastLoginDevice">—</p>
        </div>

      </div>

      <h3 class="section-title">Account History</h3>

      <div class="details">

        <div class="detail">
          <label>Created At</label>
          <p id="createdAt">—</p>
        </div>

        <div class="detail">
          <label>Created By</label>
          <p id="createdBy">—</p>
        </div>

        <div class="detail">
          <label>Last Updated</label>
          <p id="updatedAt">—</p>
        </div>

      </div>

      <h3 class="section-title">Administrator Notes</h3>

      <div class="detail">
        <p id="notes">No notes available.</p>
      </div>

      <div class="actions">

        <a href="market-admin-edit-profile.html" class="btn primary">
          Edit Profile
        </a>

        <a href="market-admin-account.html" class="btn secondary">
          Manage Account
        </a>

        <a href="market-admin-settings.html" class="btn secondary">
          Settings
        </a>

        <button type="button" class="btn danger" id="logoutBtn">
          Logout
        </button>

      </div>

    </div>

  </section>

</main>

<footer>
  Vorix Market Administrator Portal
</footer>

<!-- Firebase SDK -->
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>

<script>
  // Firebase Configuration
  const firebaseConfig = {
    apiKey: "AIzaSyBTMnT-PhJ44Hamu2EHyqnbP5EBoiFwGqY",
    authDomain: "vorix-market.firebaseapp.com",
    databaseURL: "https://vorix-market-default-rtdb.firebaseio.com",
    projectId: "vorix-market",
    storageBucket: "vorix-market.firebasestorage.app",
    messagingSenderId: "686555609094",
    appId: "1:686555609094:web:61f3e1853c0fca143a2b87",
    measurementId: "G-2KNWRG4X08"
  };

  if (!firebase.apps.length) {
    firebase.initializeApp(firebaseConfig);
  }

  const auth = firebase.auth();
  const db = firebase.firestore();

  const $ = id => document.getElementById(id);

  function setText(id, value) {
    if (value === undefined || value === null || value === "") {
      $(id).textContent = "—";
    } else {
      $(id).textContent = String(value);
    }
  }

  function formatDate(value) {
    if (!value) return "—";

    let date;

    if (value && typeof value.toDate === "function") {
      date = value.toDate();
    } else if (value instanceof Date) {
      date = value;
    } else {
      date = new Date(value);
    }

    if (isNaN(date.getTime())) return "—";

    return date.toLocaleString();
  }

  function showMessage(message, type = "error") {
    const box = $("message");

    box.textContent = message;
    box.style.display = "block";
    box.style.background =
      type === "success" ? "#dcfce7" : "#fee2e2";
    box.style.color =
      type === "success" ? "#166534" : "#991b1b";
  }

  function displayPermissions(permissions) {
    const container = $("permissions");
    container.replaceChildren();

    let items = [];

    if (Array.isArray(permissions)) {
      items = permissions;
    } else if (
      permissions &&
      typeof permissions === "object"
    ) {
      items = Object.keys(permissions).filter(
        key => permissions[key] === true
      );
    }

    if (items.length === 0) {
      const span = document.createElement("span");
      span.className = "permission";
      span.textContent = "No permissions listed";
      container.appendChild(span);
      return;
    }

    items.forEach(permission => {
      const span = document.createElement("span");
      span.className = "permission";
      span.textContent = String(permission);
      container.appendChild(span);
    });
  }

  async function loadAdminProfile(user) {
    const adminId = sessionStorage.getItem("adminId");

    if (!adminId) {
      throw new Error("Admin ID not found. Please log in again.");
    }

    // Admin ID is the Firestore document ID.
    const adminRef = db.collection("admins").doc(adminId);
    const adminSnap = await adminRef.get();

    if (!adminSnap.exists) {
      throw new Error("Administrator record not found.");
    }

    const admin = adminSnap.data();

    // Verify administrator identity and access.
    if (
      admin.adminId !== adminId ||
      admin.status !== "active" ||
      admin.role !== "admin" ||
      (admin.uid && admin.uid !== user.uid) ||
      !admin.email ||
      admin.email.toLowerCase() !== user.email?.toLowerCase() ||
      !user.emailVerified
    ) {
      throw new Error(
        "Access denied. Check your administrator account and email verification."
      );
    }

    // Update Firestore verification status from Firebase Auth.
    if (admin.emailVerified !== true) {
      await adminRef.update({
        emailVerified: true,
        updatedAt: firebase.firestore.FieldValue.serverTimestamp()
      });
    }

    const name =
      admin.fullName ||
      admin.displayName ||
      user.displayName ||
      "Administrator";

    $("fullName").textContent = name;
    $("profileEmail").textContent = user.email || "";
    $("profileStatus").textContent =
      String(admin.status || "Unknown").toUpperCase();

    // Profile photo.
    const avatar = $("avatar");

    if (admin.photoURL) {
      const image = document.createElement("img");
      image.src = admin.photoURL;
      image.alt = "Administrator profile";

      image.onerror = () => {
        avatar.textContent = name.charAt(0).toUpperCase();
      };

      avatar.replaceChildren(image);
    } else {
      avatar.textContent = name.charAt(0).toUpperCase();
    }

    // Personal information.
    setText("adminId", admin.adminId);
    setText("username", admin.username);
    setText("firstName", admin.firstName);
    setText("lastName", admin.lastName);
    setText("displayName", admin.displayName);
    setText("email", user.email);
    setText("phoneNumber", admin.phoneNumber);
    setText("country", admin.country);
    setText("department", admin.department);
    setText("language", admin.language);
    setText("timezone", admin.timezone);

    // Administrator access.
    setText("role", admin.role);
    setText("adminType", admin.adminType);
    setText("accessLevel", admin.accessLevel);
    setText("status", admin.status);

    // Permissions.
    displayPermissions(admin.permissions);

    // Account security.
    setText("emailVerified", user.emailVerified ? "Verified" : "Not verified");
    setText("phoneVerified", admin.phoneVerified ? "Verified" : "Not verified");
    setText("twoFactorEnabled", admin.twoFactorEnabled ? "Enabled" : "Disabled");
    setText("loginCount", admin.loginCount ?? 0);
    setText("lastLoginAt", formatDate(admin.lastLoginAt));
    setText("lastLoginDevice", admin.lastLoginDevice);

    // Account history.
    setText("createdAt", formatDate(admin.createdAt));
    setText("createdBy", admin.createdBy);
    setText("updatedAt", formatDate(admin.updatedAt));

    // Notes.
    setText("notes", admin.notes || "No notes available.");

    $("loading").style.display = "none";
    $("profileContent").hidden = false;
  }

  // Authentication state listener.
  auth.onAuthStateChanged(async user => {
    if (!user) {
      sessionStorage.removeItem("adminId");
      window.location.replace("market-admin-login.html");
      return;
    }

    try {
      await loadAdminProfile(user);
    } catch (error) {
      console.error("Admin profile error:", error);

      $("loading").style.display = "none";
      showMessage(
        error.message || "Unable to load administrator profile."
      );

      sessionStorage.removeItem("adminId");

      await auth.signOut();

      setTimeout(() => {
        window.location.replace("market-admin-login.html");
      }, 2500);
    }
  });

  // Logout.
  $("logoutBtn").addEventListener("click", async () => {
    try {
      sessionStorage.removeItem("adminId");
      await auth.signOut();
      window.location.replace("market-admin-login.html");
    } catch (error) {
      console.error("Logout error:", error);
      showMessage("Unable to log out. Please try again.");
    }
  });
</script>

</body>
</html>
