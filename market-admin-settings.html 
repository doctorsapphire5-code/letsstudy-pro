
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#111827">
  <title>Admin Settings | Vorix Market</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      background: #f3f6fb;
      color: #172033;
    }

    header {
      background: #111827;
      color: white;
      padding: 17px 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    header h2 {
      font-size: 19px;
    }

    header a {
      color: white;
      text-decoration: none;
      font-size: 13px;
    }

    .container {
      max-width: 900px;
      margin: 30px auto;
      padding: 0 16px;
    }

    .heading {
      margin-bottom: 22px;
    }

    .heading h1 {
      font-size: 25px;
      margin-bottom: 7px;
    }

    .heading p {
      color: #64748b;
      font-size: 14px;
    }

    .card {
      background: white;
      border-radius: 13px;
      padding: 23px;
      margin-bottom: 20px;
      box-shadow: 0 5px 25px rgba(0,0,0,.05);
    }

    .card h3 {
      font-size: 17px;
      margin-bottom: 8px;
    }

    .description {
      color: #64748b;
      font-size: 13px;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 8px;
    }

    input,
    select,
    textarea {
      width: 100%;
      padding: 13px;
      border: 1px solid #d9e0ea;
      border-radius: 8px;
      background: white;
      font-size: 14px;
      outline: none;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: #1d4ed8;
    }

    .toggle-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      padding: 15px 0;
      border-bottom: 1px solid #edf0f5;
    }

    .toggle-row:last-child {
      border-bottom: none;
    }

    .toggle-info {
      min-width: 0;
    }

    .toggle-info strong {
      display: block;
      font-size: 14px;
      margin-bottom: 5px;
    }

    .toggle-info p {
      color: #64748b;
      font-size: 12px;
      line-height: 1.5;
    }

    .switch {
      width: 46px;
      height: 25px;
      position: relative;
      flex-shrink: 0;
    }

    .switch input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .slider {
      position: absolute;
      inset: 0;
      background: #cbd5e1;
      border-radius: 30px;
      cursor: pointer;
      transition: .2s;
    }

    .slider:before {
      content: "";
      position: absolute;
      width: 19px;
      height: 19px;
      left: 3px;
      top: 3px;
      background: white;
      border-radius: 50%;
      transition: .2s;
    }

    .switch input:checked + .slider {
      background: #1d4ed8;
    }

    .switch input:checked + .slider:before {
      transform: translateX(21px);
    }

    .notice {
      padding: 13px;
      background: #fef9c3;
      border: 1px solid #fde68a;
      color: #854d0e;
      border-radius: 8px;
      font-size: 13px;
      line-height: 1.6;
      margin-bottom: 18px;
    }

    .message {
      display: none;
      padding: 13px;
      border-radius: 8px;
      margin-bottom: 17px;
      font-size: 14px;
    }

    .btn {
      padding: 13px 18px;
      border: none;
      border-radius: 8px;
      font-size: 13px;
      font-weight: bold;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      text-align: center;
    }

    .primary {
      background: #1d4ed8;
      color: white;
    }

    .secondary {
      background: #e8edf5;
      color: #172033;
    }

    .danger {
      background: #fee2e2;
      color: #b91c1c;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 20px;
    }

    #loading {
      text-align: center;
      padding: 45px 10px;
      color: #64748b;
    }

    footer {
      text-align: center;
      padding: 25px;
      color: #64748b;
      font-size: 12px;
    }

    @media(max-width: 600px) {
      .card {
        padding: 17px;
      }

      .actions .btn {
        flex: 1;
      }
    }
  </style>
</head>

<body>

<header>
  <h2>Vorix Market</h2>
  <a href="market-admin-dashboard.html">Dashboard</a>
</header>

<main class="container">

  <div class="heading">
    <h1>Admin Settings</h1>
    <p>Manage your administrator preferences and account settings.</p>
  </div>

  <div class="message" id="message"></div>

  <div id="loading">Loading settings...</div>

  <section id="settingsContent" hidden>

    <form id="settingsForm">

      <div class="card">
        <h3>General Preferences</h3>
        <p class="description">
          Customize your language and regional preferences.
        </p>

        <div class="form-group">
          <label for="language">Preferred Language</label>
          <select id="language">
            <option value="English">English</option>
            <option value="Swahili">Swahili</option>
            <option value="French">French</option>
            <option value="Arabic">Arabic</option>
            <option value="Spanish">Spanish</option>
          </select>
        </div>

        <div class="form-group">
          <label for="timezone">Timezone</label>
          <select id="timezone">
            <option value="Africa/Dar_es_Salaam">Africa/Dar_es_Salaam</option>
            <option value="Africa/Nairobi">Africa/Nairobi</option>
            <option value="Africa/Kampala">Africa/Kampala</option>
            <option value="Africa/Lagos">Africa/Lagos</option>
            <option value="UTC">UTC</option>
            <option value="Europe/London">Europe/London</option>
            <option value="America/New_York">America/New_York</option>
            <option value="Asia/Dubai">Asia/Dubai</option>
          </select>
        </div>
      </div>

      <div class="card">
        <h3>Notifications</h3>
        <p class="description">
          Choose which account notifications you want to receive.
        </p>

        <div class="toggle-row">
          <div class="toggle-info">
            <strong>Email Notifications</strong>
            <p>Receive administrator notifications by email.</p>
          </div>
          <label class="switch">
            <input type="checkbox" id="emailNotifications">
            <span class="slider"></span>
          </label>
        </div>

        <div class="toggle-row">
          <div class="toggle-info">
            <strong>Order Notifications</strong>
            <p>Receive notifications about new market orders.</p>
          </div>
          <label class="switch">
            <input type="checkbox" id="orderNotifications">
            <span class="slider"></span>
          </label>
        </div>

        <div class="toggle-row">
          <div class="toggle-info">
            <strong>Security Notifications</strong>
            <p>Receive alerts about important account security events.</p>
          </div>
          <label class="switch">
            <input type="checkbox" id="securityNotifications">
            <span class="slider"></span>
          </label>
        </div>
      </div>

      <div class="card">
        <h3>Account Security</h3>
        <p class="description">
          Review your account security preferences.
        </p>

        <div class="notice">
          The two-factor authentication preference below is saved as a setting only.
          It does not activate actual two-factor authentication. Configure a real
          second-factor authentication flow before relying on it for account security.
        </div>

        <div class="toggle-row">
          <div class="toggle-info">
            <strong>Two-Factor Authentication Preference</strong>
            <p>Save whether you want two-factor authentication enabled.</p>
          </div>
          <label class="switch">
            <input type="checkbox" id="twoFactorEnabled">
            <span class="slider"></span>
          </label>
        </div>

        <div class="actions">
          <a href="market-admin-account.html" class="btn secondary">
            Manage Password
          </a>

          <a href="market-admin-forgot-password.html" class="btn secondary">
            Reset Password
          </a>
        </div>
      </div>

      <div class="card">
        <h3>Additional Information</h3>

        <div class="form-group">
          <label for="notes">Administrator Notes</label>
          <textarea id="notes" rows="4" placeholder="Your account notes..."></textarea>
        </div>

        <div class="form-group">
          <label>Admin ID</label>
          <input type="text" id="displayAdminId" readonly>
        </div>

        <div class="form-group">
          <label>Account Email</label>
          <input type="email" id="displayEmail" readonly>
        </div>
      </div>

      <div class="actions">
        <button type="submit" class="btn primary" id="saveBtn">
          Save Settings
        </button>

        <button type="button" class="btn secondary" id="reloadBtn">
          Reload Settings
        </button>
      </div>

    </form>

    <div class="card" style="margin-top:22px">
      <h3>Navigation</h3>

      <div class="actions">
        <a href="market-admin-dashboard.html" class="btn secondary">
          Dashboard
        </a>

        <a href="market-admin-profile.html" class="btn secondary">
          Admin Profile
        </a>

        <a href="market-admin-account.html" class="btn secondary">
          Account Management
        </a>

        <a href="market-admin-edit-profile.html" class="btn secondary">
          Edit Profile
        </a>

        <button type="button" class="btn danger" id="logoutBtn">
          Logout
        </button>
      </div>
    </div>

  </section>

</main>

<footer>
  Vorix Market Administrator Portal
</footer>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>

<script>
  // Firebase Configuration
  const firebaseConfig = {
    apiKey: "AIzaSyBTMnT-PhJ44Hamu2EHyqnbP5EBoiFwGqY",
    authDomain: "vorix-market.firebaseapp.com",
    databaseURL: "https://vorix-market-default-rtdb.firebaseio.com",
    projectId: "vorix-market",
    storageBucket: "vorix-market.firebasestorage.app",
    messagingSenderId: "686555609094",
    appId: "1:686555609094:web:61f3e1853c0fca143a2b87",
    measurementId: "G-2KNWRG4X08"
  };

  if (!firebase.apps.length) {
    firebase.initializeApp(firebaseConfig);
  }

  const auth = firebase.auth();
  const db = firebase.firestore();

  const $ = id => document.getElementById(id);

  let adminRef = null;
  let currentUser = null;
  let loadedSettings = {};

  function showMessage(message, type = "error") {
    const box = $("message");

    box.textContent = message;
    box.style.display = "block";

    box.style.background =
      type === "success" ? "#dcfce7" : "#fee2e2";

    box.style.color =
      type === "success" ? "#166534" : "#991b1b";

    box.scrollIntoView({
      behavior: "smooth",
      block: "center"
    });
  }

  function setCheckbox(id, value) {
    $(id).checked = value === true;
  }

  function setSelect(id, value) {
    const select = $(id);
    const exists = [...select.options].some(
      option => option.value === value
    );

    if (exists) {
      select.value = value;
    }
  }

  async function loadSettings(user) {
    const adminId = sessionStorage.getItem("adminId");

    if (!adminId) {
      throw new Error("Admin ID not found. Please log in again.");
    }

    adminRef = db.collection("admins").doc(adminId);

    const snap = await adminRef.get();

    if (!snap.exists) {
      throw new Error("Administrator record not found.");
    }

    const admin = snap.data();

    if (
      admin.adminId !== adminId ||
      admin.status !== "active" ||
      admin.role !== "admin" ||
      (admin.uid && admin.uid !== user.uid) ||
      !admin.email ||
      admin.email.toLowerCase() !== user.email?.toLowerCase() ||
      !user.emailVerified
    ) {
      throw new Error("Administrator access denied.");
    }

    if (admin.emailVerified !== true) {
      await adminRef.update({
        emailVerified: true,
        updatedAt: firebase.firestore.FieldValue.serverTimestamp()
      });
    }

    currentUser = user;
    loadedSettings = admin;

    setSelect("language", admin.language || "English");
    setSelect("timezone", admin.timezone || "Africa/Dar_es_Salaam");

    const preferences = admin.settings || {};

    setCheckbox(
      "emailNotifications",
      preferences.emailNotifications
    );

    setCheckbox(
      "orderNotifications",
      preferences.orderNotifications
    );

    setCheckbox(
      "securityNotifications",
      preferences.securityNotifications
    );

    // This is a preference flag, not actual 2FA activation.
    setCheckbox(
      "twoFactorEnabled",
      admin.twoFactorEnabled
    );

    $("notes").value = admin.notes || "";
    $("displayAdminId").value = admin.adminId || adminId;
    $("displayEmail").value = user.email || "";

    $("loading").style.display = "none";
    $("settingsContent").hidden = false;
  }

  // Save administrator preferences.
  $("settingsForm").addEventListener("submit", async event => {
    event.preventDefault();

    if (!currentUser || !adminRef) {
      showMessage("Account information is not ready.");
      return;
    }

    const button = $("saveBtn");

    button.disabled = true;
    button.textContent = "Saving...";

    try {
      const updates = {
        language: $("language").value,
        timezone: $("timezone").value,

        settings: {
          emailNotifications: $("emailNotifications").checked,
          orderNotifications: $("orderNotifications").checked,
          securityNotifications: $("securityNotifications").checked
        },

        // Saved as a preference only. It does not enable actual 2FA.
        twoFactorEnabled: $("twoFactorEnabled").checked,

        notes: $("notes").value.trim(),

        updatedAt: firebase.firestore.FieldValue.serverTimestamp()
      };

      await adminRef.update(updates);

      loadedSettings = {
        ...loadedSettings,
        ...updates
      };

      showMessage("Settings saved successfully.", "success");

    } catch (error) {
      console.error("Save settings error:", error);

      showMessage(
        error.message || "Unable to save settings. Please try again."
      );

    } finally {
      button.disabled = false;
      button.textContent = "Save Settings";
    }
  });

  // Reload settings from Firestore.
  $("reloadBtn").addEventListener("click", async () => {
    if (!currentUser) return;

    $("reloadBtn").disabled = true;

    try {
      await loadSettings(currentUser);
      showMessage("Settings reloaded successfully.", "success");
    } catch (error) {
      console.error(error);
      showMessage("Unable to reload settings.");
    } finally {
      $("reloadBtn").disabled = false;
    }
  });

  // Authentication listener.
  auth.onAuthStateChanged(async user => {
    if (!user) {
      sessionStorage.removeItem("adminId");
      window.location.replace("market-admin-login.html");
      return;
    }

    try {
      await loadSettings(user);
    } catch (error) {
      console.error("Settings loading error:", error);

      $("loading").style.display = "none";
      showMessage(error.message || "Unable to load settings.");

      sessionStorage.removeItem("adminId");
      await auth.signOut();

      setTimeout(() => {
        window.location.replace("market-admin-login.html");
      }, 2500);
    }
  });

  // Logout.
  $("logoutBtn").addEventListener("click", async () => {
    try {
      sessionStorage.removeItem("adminId");
      await auth.signOut();
      window.location.replace("market-admin-login.html");
    } catch (error) {
      console.error("Logout error:", error);
      showMessage("Unable to log out. Please try again.");
    }
  });
</script>

</body>
</html>
