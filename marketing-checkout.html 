<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Marketing Checkout | LetsStudy Pro</title>

<meta
  name="description"
  content="Complete your marketing service order on LetsStudy Pro."
>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
}

header{
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  padding:15px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo{
  color:#172033;
  text-decoration:none;
  font-size:21px;
  font-weight:800;
}

.logo span{
  color:#2563eb;
}

.back{
  border:0;
  background:#eef2f7;
  padding:9px 14px;
  border-radius:8px;
}

.container{
  width:92%;
  max-width:900px;
  margin:30px auto;
}

.grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:18px;
}

.box{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:16px;
  padding:22px;
}

h1{
  font-size:28px;
  margin-bottom:7px;
}

h2{
  font-size:19px;
  margin-bottom:16px;
}

.muted{
  color:#64748b;
  font-size:13px;
}

.product{
  padding-bottom:18px;
  border-bottom:1px solid #e5e7eb;
  margin-bottom:18px;
}

.product h2{
  margin-bottom:6px;
}

.price{
  font-size:24px;
  font-weight:800;
  margin-top:12px;
}

label{
  display:block;
  font-size:13px;
  font-weight:700;
  margin:13px 0 6px;
}

input,
textarea,
select{
  width:100%;
  padding:12px;
  border:1px solid #dbe2ea;
  border-radius:8px;
  outline:none;
  font:inherit;
}

textarea{
  min-height:100px;
  resize:vertical;
}

.row{
  display:flex;
  justify-content:space-between;
  gap:12px;
  padding:9px 0;
  font-size:14px;
}

.total{
  border-top:1px solid #e5e7eb;
  margin-top:12px;
  padding-top:15px;
  font-size:18px;
  font-weight:800;
}

.pay{
  width:100%;
  border:0;
  background:#2563eb;
  color:#fff;
  padding:13px;
  border-radius:9px;
  font-weight:800;
  cursor:pointer;
  margin-top:18px;
}

.pay:disabled{
  opacity:.6;
  cursor:not-allowed;
}

.message{
  display:none;
  margin-top:14px;
  padding:12px;
  border-radius:8px;
  font-size:13px;
}

.success{
  background:#ecfdf5;
  color:#047857;
}

.error{
  background:#fef2f2;
  color:#b91c1c;
}

@media(max-width:700px){
  .grid{
    grid-template-columns:1fr;
  }
}
</style>
</head>

<body>

<header>

  <a
    href="index.html"
    class="logo"
  >
    LetsStudy <span>Pro</span>
  </a>

  <button
    class="back"
    onclick="history.back()"
  >
    Back
  </button>

</header>


<main class="container">

  <div class="grid">

    <!-- CUSTOMER -->

    <section class="box">

      <h1>
        Marketing Checkout
      </h1>

      <p class="muted">
        Enter your details to place your marketing service order.
      </p>


      <form id="checkoutForm">

        <label for="name">
          Full Name
        </label>

        <input
          id="name"
          name="name"
          type="text"
          required
          autocomplete="name"
          placeholder="Your full name"
        >


        <label for="email">
          Email
        </label>

        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
        >


        <label for="phone">
          Phone
        </label>

        <input
          id="phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          placeholder="Phone number"
        >


        <label for="payment">
          Payment Method
        </label>

        <select
          id="payment"
          name="paymentMethod"
          required
        >

          <option value="">
            Select payment method
          </option>

          <option value="mobile_money">
            Mobile Money
          </option>

          <option value="card">
            Card
          </option>

          <option value="bank">
            Bank Transfer
          </option>

        </select>


        <label for="notes">
          Marketing Requirements
        </label>

        <textarea
          id="notes"
          name="notes"
          placeholder="Describe what you need..."
        ></textarea>


        <button
          id="submitBtn"
          class="pay"
          type="submit"
        >
          Place Marketing Order
        </button>

      </form>


      <div
        id="message"
        class="message"
      ></div>

    </section>


    <!-- ORDER -->

    <section class="box">

      <h2>
        Order Summary
      </h2>


      <div class="product">

        <h2 id="productName">
          Marketing Service
        </h2>

        <p
          id="productDescription"
          class="muted"
        >
          Professional marketing service.
        </p>

        <div
          id="productPrice"
          class="price"
        >
          0
        </div>

      </div>


      <div class="row">

        <span>
          Service
        </span>

        <strong id="subtotal">
          0
        </strong>

      </div>


      <div class="row">

        <span>
          Processing
        </span>

        <strong>
          0
        </strong>

      </div>


      <div class="row total">

        <span>
          Total
        </span>

        <span id="total">
          0
        </span>

      </div>

    </section>

  </div>

</main>


<script>

/*
==================================================
CHECKOUT-MARKETING.HTML

EXAMPLE:

checkout-marketing.html
?id=MARKETING_ID
&name=Marketing%20Campaign
&price=50000

API:

GET
/api/data?collection=marketing&id=MARKETING_ID

POST
/api/orders

NO DIRECT FIREBASE
==================================================
*/


const params =
  new URLSearchParams(
    location.search
  );


const marketingId =
  params.get("id") ||
  params.get("marketingId") ||
  "";


const urlName =
  params.get("name") ||
  "";


const urlPrice =
  Number(
    params.get("price") ||
    0
  );


const productName =
  document.getElementById(
    "productName"
  );

const productDescription =
  document.getElementById(
    "productDescription"
  );

const productPrice =
  document.getElementById(
    "productPrice"
  );

const subtotal =
  document.getElementById(
    "subtotal"
  );

const total =
  document.getElementById(
    "total"
  );

const form =
  document.getElementById(
    "checkoutForm"
  );

const button =
  document.getElementById(
    "submitBtn"
  );

const message =
  document.getElementById(
    "message"
  );


let service = {
  id:marketingId,
  name:urlName || "Marketing Service",
  description:"Professional marketing service.",
  price:urlPrice
};


/* =========================
   LOAD SERVICE
========================= */

if(marketingId){

  loadService();

}else{

  renderService();

}


async function loadService(){

  try{

    const response =
      await fetch(
        "/api/data?collection=marketing&id=" +
        encodeURIComponent(
          marketingId
        )
      );


    const result =
      await response.json();


    if(
      response.ok &&
      (
        result.data ||
        result.item
      )
    ){

      const data =
        result.data ||
        result.item;


      service = {
        id:
          data.documentId ||
          data.id ||
          marketingId,

        name:
          data.name ||
          data.title ||
          "Marketing Service",

        description:
          data.description ||
          data.summary ||
          "Professional marketing service.",

        price:
          Number(
            data.price ||
            data.amount ||
            0
          )
      };

    }


    renderService();

  }catch(error){

    console.error(
      "MARKETING SERVICE:",
      error
    );

    renderService();

  }

}


/* =========================
   RENDER
========================= */

function renderService(){

  productName.textContent =
    service.name;


  productDescription.textContent =
    service.description;


  const formatted =
    formatMoney(
      service.price
    );


  productPrice.textContent =
    formatted;


  subtotal.textContent =
    formatted;


  total.textContent =
    formatted;

}


/* =========================
   SUBMIT ORDER
========================= */

form.addEventListener(
  "submit",
  async event => {

    event.preventDefault();


    button.disabled = true;

    button.textContent =
      "Processing...";


    hideMessage();


    const data =
      new FormData(
        form
      );


    const order = {

      type:
        "marketing",

      itemId:
        service.id,

      itemName:
        service.name,

      amount:
        service.price,

      currency:
        "TZS",

      customer:{

        name:
          data.get("name"),

        email:
          data.get("email"),

        phone:
          data.get("phone")

      },

      paymentMethod:
        data.get(
          "paymentMethod"
        ),

      notes:
        data.get("notes"),

      createdAt:
        new Date().toISOString()

    };


    try{

      const response =
        await fetch(
          "/api/orders",
          {
            method:"POST",

            headers:{
              "Content-Type":
                "application/json"
            },

            body:
              JSON.stringify(
                order
              )
          }
        );


      const result =
        await response.json();


      if(!response.ok){

        throw new Error(
          result.error ||
          "Unable to place order."
        );

      }


      showMessage(
        "success",
        result.message ||
        "Order created successfully."
      );


      if(
        result.checkoutUrl
      ){

        setTimeout(
          () => {

            location.href =
              result.checkoutUrl;

          },
          700
        );

      }else if(
        result.orderId
      ){

        setTimeout(
          () => {

            location.href =
              "checkout-success.html?orderId=" +
              encodeURIComponent(
                result.orderId
              );

          },
          700
        );

      }


      form.reset();


    }catch(error){

      console.error(
        "MARKETING CHECKOUT:",
        error
      );


      showMessage(
        "error",
        error.message
      );


      button.disabled = false;

      button.textContent =
        "Place Marketing Order";

    }

  }
);


/* =========================
   MONEY
========================= */

function formatMoney(
  amount
){

  return new Intl.NumberFormat(
    undefined,
    {
      style:"currency",
      currency:"TZS",
      maximumFractionDigits:0
    }
  ).format(
    Number(amount) || 0
  );

}


/* =========================
   MESSAGE
========================= */

function showMessage(
  type,
  text
){

  message.className =
    "message " +
    type;

  message.textContent =
    text;

  message.style.display =
    "block";

}


function hideMessage(){

  message.style.display =
    "none";

}


/* =========================
   SECURITY
========================= */

function safeText(
  value
){

  return String(
    value ?? ""
  );

}

</script>

</body>
</html>