<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Marketing Checkout | LetsStudy Pro</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
*{box-sizing:border-box}

body{
 margin:0;
 background:#f6f8fb;
 color:#172033;
 font-family:Inter,Arial,sans-serif
}

a{
 text-decoration:none;
 color:inherit
}

.top{
 height:64px;
 background:#fff;
 border-bottom:1px solid #e5e7eb;
 display:flex;
 align-items:center;
 justify-content:space-between;
 padding:0 6%;
 position:sticky;
 top:0;
 z-index:10
}

.logo{
 color:#155eef;
 font-size:21px;
 font-weight:800
}

.container{
 max-width:1000px;
 margin:35px auto;
 padding:0 20px
}

.layout{
 display:grid;
 grid-template-columns:1.4fr .8fr;
 gap:20px
}

.card{
 background:#fff;
 border:1px solid #e5e7eb;
 border-radius:16px;
 padding:22px
}

.card h2{
 margin-top:0;
 font-size:20px
}

.campaign{
 display:flex;
 gap:15px;
 padding-bottom:18px;
 border-bottom:1px solid #eee
}

.campaign img{
 width:130px;
 height:90px;
 object-fit:cover;
 border-radius:10px
}

.campaign h3{
 margin:0 0 7px;
 font-size:17px
}

.muted{
 color:#667085;
 font-size:12px;
 line-height:1.6
}

.price{
 font-size:22px;
 font-weight:800;
 margin-top:12px
}

.field{
 margin-top:16px
}

label{
 display:block;
 font-size:12px;
 font-weight:700;
 margin-bottom:6px
}

input{
 width:100%;
 padding:12px;
 border:1px solid #d9dee8;
 border-radius:9px;
 outline:none
}

.summary-row{
 display:flex;
 justify-content:space-between;
 padding:10px 0;
 font-size:13px
}

.total{
 border-top:1px solid #e5e7eb;
 margin-top:10px;
 padding-top:15px;
 font-size:19px;
 font-weight:800
}

.btn{
 width:100%;
 border:0;
 padding:13px;
 border-radius:9px;
 background:#155eef;
 color:#fff;
 font-weight:800;
 cursor:pointer;
 margin-top:15px
}

.btn:disabled{
 opacity:.6;
 cursor:not-allowed
}

.back{
 display:inline-block;
 margin-bottom:15px;
 color:#155eef;
 font-size:12px;
 font-weight:700
}

.error{
 color:#b42318;
 background:#fef3f2;
 padding:10px;
 border-radius:8px;
 font-size:12px;
 margin-top:12px;
 display:none
}

.loading{
 text-align:center;
 padding:70px;
 color:#667085
}

@media(max-width:750px){
 .layout{
  grid-template-columns:1fr
 }
 .campaign{
  flex-direction:column
 }
 .campaign img{
  width:100%;
  height:180px
 }
}
</style>
</head>

<body>

<header class="top">

<a href="index.html" class="logo">
LetsStudy Pro
</a>

<a href="marketing.html">
<i class="fa fa-arrow-left"></i>
 Back
</a>

</header>


<main class="container">

<a
id="backView"
class="back"
href="marketing.html">

← Back to Marketing

</a>


<div
id="loading"
class="loading">

<i class="fa fa-spinner fa-spin"></i>

<p>Loading checkout...</p>

</div>


<div
id="checkout"
style="display:none">


<div class="layout">


<section class="card">

<h2>
Order Details
</h2>


<div class="campaign">

<img
id="campaignImage"
src=""
alt="Promotion">


<div>

<h3 id="campaignTitle">
Promotion
</h3>

<div
id="campaignType"
class="muted">
Promotion
</div>

<div
id="campaignDescription"
class="muted">
</div>

<div
id="campaignPrice"
class="price">
TZS 0
</div>

</div>

</div>


<div class="field">

<label>
Full Name
</label>

<input
id="name"
placeholder="Enter your full name">

</div>


<div class="field">

<label>
Email Address
</label>

<input
id="email"
type="email"
placeholder="Enter your email">

</div>


<div class="field">

<label>
Phone Number
</label>

<input
id="phone"
placeholder="07XXXXXXXX">

</div>


<div
id="error"
class="error">
</div>

</section>


<aside class="card">

<h2>
Order Summary
</h2>


<div class="summary-row">

<span>
Promotion
</span>

<strong id="summaryTitle">
-
</strong>

</div>


<div class="summary-row">

<span>
Price
</span>

<strong id="summaryPrice">
TZS 0
</strong>

</div>


<div class="summary-row total">

<span>
Total
</span>

<strong id="total">
TZS 0
</strong>

</div>


<button
id="payBtn"
class="btn">

Continue to Payment
<i class="fa fa-arrow-right"></i>

</button>


<p class="muted"
style="margin-top:12px;text-align:center">

You will be redirected to the secure payment page.

</p>

</aside>

</div>

</div>

</main>


<script type="module">

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

import {
getFirestore,
doc,
getDoc
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


const firebaseConfig={

apiKey:
"AIzaSyBcOYDfAVKXbkljsYrgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};

const app=
initializeApp(firebaseConfig);

const db=
getFirestore(app);


const params=
new URLSearchParams(
location.search
);

const id=
params.get("id");


const loading=
document.getElementById("loading");

const checkout=
document.getElementById("checkout");

const errorBox=
document.getElementById("error");

const payBtn=
document.getElementById("payBtn");


let campaign=null;


function esc(value=""){
return String(value)
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");
}


function showError(message){

errorBox.textContent=message;
errorBox.style.display="block";

}


async function loadCampaign(){

if(!id){

loading.innerHTML=`

<i class="fa fa-triangle-exclamation"></i>

<p>
Marketing campaign not found.
</p>

`;

return;

}


try{

const snap=
await getDoc(
doc(
db,
"marketingCampaigns",
id
)
);


if(!snap.exists()){

loading.innerHTML=`

<i class="fa fa-triangle-exclamation"></i>

<p>
This promotion does not exist.
</p>

`;

return;

}


campaign={
id:snap.id,
...snap.data()
};


if(campaign.status!=="published"){

loading.innerHTML=`

<i class="fa fa-lock"></i>

<p>
This promotion is no longer available.
</p>

`;

return;

}


renderCampaign();


}catch(error){

console.error(error);

loading.innerHTML=`

<i class="fa fa-triangle-exclamation"></i>

<p>
Unable to load checkout.
</p>

`;

}

}


function renderCampaign(){

const price=
Number(
campaign.price||0
);


document.getElementById(
"campaignImage"
).src=
campaign.imageUrl||
"https://via.placeholder.com/700x400?text=Promotion";


document.getElementById(
"campaignTitle"
).textContent=
campaign.title||
"Promotion";


document.getElementById(
"campaignType"
).textContent=
campaign.type||
"Promotion";


document.getElementById(
"campaignDescription"
).textContent=
campaign.description||
"Complete your order to continue.";


document.getElementById(
"campaignPrice"
).textContent=
`${campaign.currency||"TZS"} ${price.toLocaleString()}`;


document.getElementById(
"summaryTitle"
).textContent=
campaign.title||
"Promotion";


document.getElementById(
"summaryPrice"
).textContent=
`${campaign.currency||"TZS"} ${price.toLocaleString()}`;


document.getElementById(
"total"
).textContent=
`${campaign.currency||"TZS"} ${price.toLocaleString()}`;


document.getElementById(
"backView"
).href=
`marketing-view.html?id=${encodeURIComponent(campaign.id)}`;


loading.style.display="none";

checkout.style.display="block";

}


payBtn.addEventListener(
"click",
()=>{

errorBox.style.display="none";


const name=
document.getElementById("name")
.value.trim();

const email=
document.getElementById("email")
.value.trim();

const phone=
document.getElementById("phone")
.value.trim();


if(!name){

showError("Please enter your full name.");

return;

}


if(!email){

showError("Please enter your email address.");

return;

}


if(!phone){

showError("Please enter your phone number.");

return;

}


const orderId=
"MK-"+Date.now();


const params=
new URLSearchParams({

id:campaign.id,

orderId:orderId,

name:name,

email:email,

phone:phone

});


/*
 NEXT STEP:
 marketing-payment.html
*/

location.href=
`payment.html?${params.toString()}`;

});


loadCampaign();

</script>

</body>
</html>