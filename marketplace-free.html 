<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Free Marketplace | LetsStudy Pro</title>
  <meta name="description" content="Access free marketplace items on LetsStudy Pro.">
  <meta name="robots" content="index, follow">

  <link rel="icon" href="favicon.png">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Inter, Arial, sans-serif;
      background: #f6f8fb;
      color: #172033;
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(255,255,255,.96);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid #e7ebf2;
      padding: 15px 6%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .logo {
      font-size: 22px;
      font-weight: 800;
      color: #2563eb;
    }

    .nav-links {
      display: flex;
      gap: 20px;
      align-items: center;
    }

    .nav-links a {
      font-weight: 600;
      color: #4b5563;
    }

    .nav-links a:hover {
      color: #2563eb;
    }

    .container {
      width: min(1180px, 92%);
      margin: auto;
    }

    .breadcrumb {
      padding: 28px 0 15px;
      color: #6b7280;
      font-size: 14px;
    }

    .breadcrumb a {
      color: #2563eb;
      font-weight: 600;
    }

    .hero {
      background: #fff;
      border: 1px solid #e5eaf1;
      border-radius: 22px;
      overflow: hidden;
      box-shadow: 0 10px 35px rgba(15,23,42,.06);
    }

    .cover {
      width: 100%;
      height: 360px;
      background: #e9eef6;
      overflow: hidden;
    }

    .cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hero-content {
      padding: 34px;
    }

    .badges {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-bottom: 18px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      padding: 7px 13px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 800;
    }

    .free-badge {
      background: #dcfce7;
      color: #166534;
    }

    .status-badge {
      background: #eef2ff;
      color: #3730a3;
    }

    h1 {
      font-size: clamp(30px, 5vw, 48px);
      line-height: 1.15;
      margin-bottom: 12px;
    }

    .tagline {
      color: #64748b;
      font-size: 18px;
      margin-bottom: 16px;
    }

    .description {
      color: #475569;
      font-size: 16px;
      max-width: 850px;
    }

    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 25px;
      margin: 25px 0 60px;
    }

    .card {
      background: #fff;
      border: 1px solid #e5eaf1;
      border-radius: 18px;
      padding: 27px;
      box-shadow: 0 8px 25px rgba(15,23,42,.04);
    }

    .card + .card {
      margin-top: 20px;
    }

    .card h2 {
      font-size: 22px;
      margin-bottom: 16px;
    }

    .card p {
      color: #536174;
    }

    .list {
      list-style: none;
      display: grid;
      gap: 12px;
    }

    .list li {
      position: relative;
      padding-left: 28px;
      color: #465366;
    }

    .list li::before {
      content: "✓";
      position: absolute;
      left: 0;
      top: 0;
      color: #16a34a;
      font-weight: 900;
    }

    .info {
      display: grid;
      gap: 13px;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      padding-bottom: 12px;
      border-bottom: 1px solid #edf0f4;
    }

    .info-row:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }

    .label {
      color: #7a8494;
      font-size: 14px;
    }

    .value {
      font-weight: 700;
      text-align: right;
      color: #263247;
    }

    .price {
      font-size: 30px;
      font-weight: 900;
      color: #16a34a;
      margin: 18px 0;
    }

    .free-text {
      font-size: 14px;
      color: #64748b;
      margin-bottom: 18px;
    }

    .btn {
      width: 100%;
      border: 0;
      border-radius: 12px;
      padding: 14px 20px;
      background: #2563eb;
      color: #fff;
      font-size: 16px;
      font-weight: 800;
      cursor: pointer;
      transition: .2s;
    }

    .btn:hover {
      background: #1d4ed8;
      transform: translateY(-1px);
    }

    .back-btn {
      display: inline-block;
      margin-top: 12px;
      width: 100%;
      text-align: center;
      padding: 13px 18px;
      border: 1px solid #dbe1ea;
      border-radius: 12px;
      color: #475569;
      font-weight: 700;
    }

    .back-btn:hover {
      background: #f8fafc;
    }

    .loading,
    .error {
      padding: 70px 20px;
      text-align: center;
      background: #fff;
      border-radius: 18px;
      border: 1px solid #e5eaf1;
      margin: 30px 0;
    }

    .error {
      color: #b91c1c;
    }

    footer {
      border-top: 1px solid #e5eaf1;
      background: #fff;
      padding: 28px 6%;
      text-align: center;
      color: #7b8492;
      font-size: 14px;
    }

    @media (max-width: 850px) {
      .layout {
        grid-template-columns: 1fr;
      }

      .nav-links {
        display: none;
      }

      .cover {
        height: 250px;
      }

      .hero-content {
        padding: 24px;
      }
    }

    @media (max-width: 500px) {
      .container {
        width: 94%;
      }

      h1 {
        font-size: 30px;
      }

      .cover {
        height: 210px;
      }

      .card {
        padding: 21px;
      }
    }
  </style>
</head>

<body>

  <nav class="nav">
    <a href="index.html" class="logo">LetsStudy Pro</a>

    <div class="nav-links">
      <a href="marketplace.html">Marketplace</a>
      <a href="resources.html">Resources</a>
      <a href="courses.html">Courses</a>
    </div>
  </nav>

  <main class="container">

    <div class="breadcrumb">
      <a href="marketplace.html">Marketplace</a>
      <span> / Free Item</span>
    </div>

    <div id="loading" class="loading">
      Loading marketplace item...
    </div>

    <div id="error" class="error" style="display:none;"></div>

    <section id="content" style="display:none;">

      <div class="hero">

        <div class="cover">
          <img id="coverImage" alt="Marketplace item">
        </div>

        <div class="hero-content">

          <div class="badges">
            <span class="badge free-badge">FREE MARKETPLACE</span>
            <span id="statusBadge" class="badge status-badge"></span>
          </div>

          <h1 id="title"></h1>

          <div id="tagline" class="tagline"></div>

          <p id="description" class="description"></p>

        </div>
      </div>

      <div class="layout">

        <div>

          <article id="aboutCard" class="card">
            <h2>About This Item</h2>
            <p id="about"></p>
          </article>

          <article id="featuresCard" class="card">
            <h2>What's Included</h2>
            <ul id="features" class="list"></ul>
          </article>

          <article id="requirementsCard" class="card">
            <h2>Requirements</h2>
            <ul id="requirements" class="list"></ul>
          </article>

        </div>

        <aside>

          <div class="card">

            <div class="info">

              <div class="info-row">
                <span class="label">Category</span>
                <span id="category" class="value">—</span>
              </div>

              <div class="info-row">
                <span class="label">Type</span>
                <span id="type" class="value">—</span>
              </div>

              <div class="info-row">
                <span class="label">Seller</span>
                <span id="seller" class="value">—</span>
              </div>

              <div class="info-row">
                <span class="label">Availability</span>
                <span id="availability" class="value">Available</span>
              </div>

            </div>

            <div class="price">FREE</div>

            <p class="free-text">
              This marketplace item is available at no cost.
            </p>

            <button id="getBtn" class="btn">
              Get Free Item
            </button>

            <a href="marketplace.html" class="back-btn">
              Browse Marketplace
            </a>

          </div>

        </aside>

      </div>

    </section>

  </main>

  <footer>
    © 2026 LetsStudy Pro. All rights reserved.
  </footer>

  <script type="module">

    import {
      initializeApp
    } from "https://www.gstatic.com/firebasejs/10.12.5/firebase-app.js";

    import {
      getFirestore,
      doc,
      getDoc
    } from "https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore.js";

    const firebaseConfig = {
      apiKey: "AIzaSyBcOYDfAVK5XbkljsyRgI_0rj0odBn678tCc",
      authDomain: "let-s-study-pro-course.firebaseapp.com",
      databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
      projectId: "let-s-study-pro-course",
      storageBucket: "let-s-study-pro-course.firebasestorage.app",
      messagingSenderId: "474928293390",
      appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
      measurementId: "G-85B7V5H5J0"
    };

    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);

    const params = new URLSearchParams(window.location.search);
    const itemId = params.get("id");

    const loading = document.getElementById("loading");
    const errorBox = document.getElementById("error");
    const content = document.getElementById("content");

    function firstValue(data, fields, fallback = "") {
      for (const field of fields) {
        const value = data?.[field];

        if (
          value !== undefined &&
          value !== null &&
          String(value).trim() !== ""
        ) {
          return value;
        }
      }

      return fallback;
    }

    function toArray(value) {
      if (Array.isArray(value)) {
        return value
          .map(item => {
            if (typeof item === "string") return item;
            if (item && typeof item === "object") {
              return firstValue(
                item,
                ["title", "name", "text", "label", "description"],
                ""
              );
            }
            return String(item);
          })
          .filter(Boolean);
      }

      if (typeof value === "string") {
        return value
          .split(/\n|,/)
          .map(x => x.trim())
          .filter(Boolean);
      }

      return [];
    }

    function escapeHtml(value) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function setText(id, value) {
      const el = document.getElementById(id);
      if (!el) return;

      el.textContent =
        value !== undefined &&
        value !== null &&
        String(value).trim() !== ""
          ? value
          : "—";
    }

    function renderList(id, values) {
      const el = document.getElementById(id);
      if (!el) return;

      el.innerHTML = "";

      values.forEach(value => {
        const li = document.createElement("li");
        li.textContent = value;
        el.appendChild(li);
      });
    }

    function hideIfEmpty(cardId, values) {
      const card = document.getElementById(cardId);

      if (!card) return;

      if (!values || values.length === 0) {
        card.style.display = "none";
      } else {
        card.style.display = "";
      }
    }

    function isPlan(data) {

      const access = String(
        firstValue(
          data,
          ["access", "accessType", "membership", "plan"],
          ""
        )
      ).toLowerCase().trim();

      return (
        data?.isPremium === true ||
        data?.premium === true ||
        data?.paid === true ||
        ["plan", "premium", "paid", "pro"].includes(access)
      );
    }

    async function loadItem() {

      if (!itemId) {
        loading.style.display = "none";
        errorBox.style.display = "block";
        errorBox.textContent =
          "Marketplace item could not be found.";
        return;
      }

      try {

        const ref = doc(db, "marketplace", itemId);
        const snap = await getDoc(ref);

        if (!snap.exists()) {
          throw new Error("Marketplace item not found.");
        }

        const data = snap.data();

        /*
         * This page is for FREE items only.
         * If the item is Plan, redirect to details/cart.
         */
        if (isPlan(data)) {
          window.location.href =
            `marketplace-details.html?id=${encodeURIComponent(itemId)}`;
          return;
        }

        const title = firstValue(
          data,
          ["title", "name", "productTitle", "productName", "itemTitle"],
          "Marketplace Item"
        );

        const tagline = firstValue(
          data,
          ["tagline", "slogan", "shortDescription", "summary"],
          ""
        );

        const description = firstValue(
          data,
          [
            "description",
            "summary",
            "shortDescription",
            "overview",
            "content"
          ],
          ""
        );

        const about = firstValue(
          data,
          [
            "about",
            "overview",
            "description",
            "details",
            "content"
          ],
          ""
        );

        const category = firstValue(
          data,
          [
            "category",
            "marketplaceCategory",
            "productCategory",
            "type",
            "field"
          ],
          "General"
        );

        const type = firstValue(
          data,
          ["productType", "itemType", "type"],
          "Marketplace Item"
        );

        const seller = firstValue(
          data,
          [
            "seller",
            "sellerName",
            "vendor",
            "vendorName",
            "provider",
            "providerName"
          ],
          "Marketplace Seller"
        );

        const availability = firstValue(
          data,
          ["availability", "stock", "status", "itemStatus"],
          "Available"
        );

        const status = firstValue(
          data,
          ["status", "itemStatus"],
          "Available"
        );

        const image = firstValue(
          data,
          [
            "image",
            "imageUrl",
            "thumbnail",
            "thumbnailUrl",
            "cover",
            "coverImage"
          ],
          ""
        );

        const features = toArray(
          firstValue(
            data,
            [
              "features",
              "included",
              "benefits",
              "highlights",
              "whatYouGet"
            ],
            []
          )
        );

        const requirements = toArray(
          firstValue(
            data,
            [
              "requirements",
              "needed",
              "prerequisites"
            ],
            []
          )
        );

        document.title =
          `${title} | Free Marketplace | LetsStudy Pro`;

        setText("title", title);
        setText("tagline", tagline);
        setText("description", description);
        setText("about", about);
        setText("category", category);
        setText("type", type);
        setText("seller", seller);
        setText("availability", availability);
        setText("statusBadge", status);

        const taglineEl =
          document.getElementById("tagline");

        if (!tagline) {
          taglineEl.style.display = "none";
        }

        const coverImage =
          document.getElementById("coverImage");

        if (image) {
          coverImage.src = image;

          coverImage.onerror = () => {
            coverImage.style.display = "none";
          };
        } else {
          coverImage.style.display = "none";
        }

        renderList("features", features);
        renderList("requirements", requirements);

        hideIfEmpty("featuresCard", features);
        hideIfEmpty("requirementsCard", requirements);

        document.getElementById("getBtn").onclick = () => {

          const downloadUrl = firstValue(
            data,
            [
              "downloadUrl",
              "downloadURL",
              "fileUrl",
              "fileURL",
              "url",
              "link",
              "resourceUrl",
              "resourceURL"
            ],
            ""
          );

          if (downloadUrl) {
            window.open(downloadUrl, "_blank", "noopener");
            return;
          }

          /*
           * If there is no direct download,
           * open the item's external link if available.
           */
          const externalUrl = firstValue(
            data,
            ["website", "websiteUrl", "externalUrl", "externalURL"],
            ""
          );

          if (externalUrl) {
            window.open(externalUrl, "_blank", "noopener");
            return;
          }

          /*
           * No file/link available.
           */
          alert(
            "This free item is currently available without a direct download link. Please check back soon."
          );
        };

        loading.style.display = "none";
        content.style.display = "block";

      } catch (error) {

        console.error(error);

        loading.style.display = "none";
        errorBox.style.display = "block";
        errorBox.textContent =
          "Unable to load this marketplace item. Please try again.";
      }
    }

    loadItem();

  </script>

</body>
</html>