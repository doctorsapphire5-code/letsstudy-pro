<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Marketplace Order | LetsStudy Pro</title>
  <meta name="description" content="Order a marketplace item on LetsStudy Pro.">

  <link rel="icon" href="favicon.png">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Inter, Arial, sans-serif;
      background: #f6f8fb;
      color: #172033;
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(255,255,255,.96);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid #e5eaf1;
      padding: 15px 6%;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      color: #2563eb;
      font-size: 22px;
      font-weight: 900;
    }

    .nav-links {
      display: flex;
      gap: 20px;
      color: #475569;
      font-weight: 700;
    }

    .container {
      width: min(1150px, 92%);
      margin: auto;
    }

    .breadcrumb {
      padding: 28px 0 18px;
      color: #64748b;
      font-size: 14px;
    }

    .breadcrumb a {
      color: #2563eb;
      font-weight: 700;
    }

    .page-title {
      margin-bottom: 25px;
    }

    .page-title h1 {
      font-size: clamp(30px, 5vw, 44px);
      line-height: 1.15;
      margin-bottom: 8px;
    }

    .page-title p {
      color: #64748b;
    }

    .layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 360px;
      gap: 25px;
      margin-bottom: 60px;
    }

    .card {
      background: #fff;
      border: 1px solid #e5eaf1;
      border-radius: 20px;
      padding: 28px;
      box-shadow: 0 10px 30px rgba(15,23,42,.05);
    }

    .card + .card {
      margin-top: 20px;
    }

    .card h2 {
      font-size: 21px;
      margin-bottom: 20px;
    }

    .item {
      display: flex;
      gap: 18px;
      padding-bottom: 22px;
      border-bottom: 1px solid #edf0f4;
      margin-bottom: 22px;
    }

    .item-image {
      width: 125px;
      height: 95px;
      border-radius: 13px;
      object-fit: cover;
      background: #edf2f7;
      flex-shrink: 0;
    }

    .item-info h3 {
      font-size: 19px;
      margin-bottom: 5px;
    }

    .item-info p {
      color: #64748b;
      font-size: 14px;
    }

    .badge {
      display: inline-flex;
      padding: 5px 10px;
      border-radius: 999px;
      background: #fef3c7;
      color: #92400e;
      font-size: 12px;
      font-weight: 900;
      margin-bottom: 8px;
    }

    .price {
      font-size: 26px;
      font-weight: 900;
      color: #2563eb;
      margin-top: 7px;
    }

    .form-group {
      margin-bottom: 17px;
    }

    label {
      display: block;
      margin-bottom: 7px;
      font-size: 14px;
      font-weight: 800;
      color: #334155;
    }

    input,
    textarea,
    select {
      width: 100%;
      border: 1px solid #dbe2ea;
      border-radius: 11px;
      padding: 13px 14px;
      font: inherit;
      color: #172033;
      background: #fff;
      outline: none;
    }

    input:focus,
    textarea:focus,
    select:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37,99,235,.1);
    }

    textarea {
      min-height: 125px;
      resize: vertical;
    }

    .summary {
      display: grid;
      gap: 13px;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      color: #64748b;
    }

    .summary-row strong {
      color: #172033;
      text-align: right;
    }

    .total {
      border-top: 1px solid #e5eaf1;
      padding-top: 17px;
      margin-top: 7px;
      display: flex;
      justify-content: space-between;
      font-size: 21px;
      font-weight: 900;
    }

    .total strong {
      color: #2563eb;
    }

    .btn {
      width: 100%;
      border: 0;
      border-radius: 12px;
      padding: 15px;
      background: #2563eb;
      color: #fff;
      font-size: 16px;
      font-weight: 900;
      cursor: pointer;
      margin-top: 20px;
    }

    .btn:hover {
      background: #1d4ed8;
    }

    .back {
      display: block;
      text-align: center;
      margin-top: 13px;
      padding: 12px;
      border: 1px solid #dbe2ea;
      border-radius: 11px;
      color: #475569;
      font-weight: 700;
    }

    .notice {
      margin-top: 18px;
      padding: 14px;
      border-radius: 11px;
      background: #eff6ff;
      color: #1e40af;
      font-size: 13px;
    }

    .loading,
    .error {
      background: #fff;
      border: 1px solid #e5eaf1;
      border-radius: 18px;
      padding: 65px 20px;
      text-align: center;
      margin: 30px 0 60px;
    }

    .error {
      color: #b91c1c;
    }

    footer {
      background: #fff;
      border-top: 1px solid #e5eaf1;
      text-align: center;
      padding: 28px;
      color: #7b8492;
      font-size: 14px;
    }

    @media (max-width: 850px) {
      .layout {
        grid-template-columns: 1fr;
      }

      .nav-links {
        display: none;
      }
    }

    @media (max-width: 520px) {
      .item {
        flex-direction: column;
      }

      .item-image {
        width: 100%;
        height: 190px;
      }

      .card {
        padding: 21px;
      }
    }
  </style>
</head>

<body>

<nav class="nav">
  <a href="index.html" class="logo">LetsStudy Pro</a>

  <div class="nav-links">
    <a href="marketplace.html">Marketplace</a>
    <a href="resources.html">Resources</a>
    <a href="courses.html">Courses</a>
  </div>
</nav>

<main class="container">

  <div class="breadcrumb">
    <a href="marketplace.html">Marketplace</a>
    <span> / Order</span>
  </div>

  <div id="loading" class="loading">
    Loading marketplace item...
  </div>

  <div id="error" class="error" style="display:none;"></div>

  <section id="content" style="display:none;">

    <div class="page-title">
      <h1>Place Your Order</h1>
      <p>Complete your details to continue with this marketplace order.</p>
    </div>

    <div class="layout">

      <!-- LEFT -->
      <div>

        <div class="card">

          <h2>Marketplace Item</h2>

          <div class="item">

            <img
              id="itemImage"
              class="item-image"
              alt="Marketplace item"
            >

            <div class="item-info">

              <span class="badge">PLAN MARKETPLACE</span>

              <h3 id="itemTitle"></h3>

              <p id="itemDescription"></p>

              <div id="itemPrice" class="price"></div>

            </div>

          </div>

        </div>

        <div class="card">

          <h2>Customer Information</h2>

          <form id="orderForm">

            <div class="form-group">
              <label for="fullName">Full Name</label>
              <input
                id="fullName"
                type="text"
                placeholder="Enter your full name"
                required
              >
            </div>

            <div class="form-group">
              <label for="email">Email Address</label>
              <input
                id="email"
                type="email"
                placeholder="Enter your email"
                required
              >
            </div>

            <div class="form-group">
              <label for="phone">Phone Number</label>
              <input
                id="phone"
                type="tel"
                placeholder="Enter your phone number"
                required
              >
            </div>

            <div class="form-group">
              <label for="requirements">
                Order Requirements / Notes
              </label>

              <textarea
                id="requirements"
                placeholder="Describe what you need, preferred format, delivery instructions, or other important details..."
              ></textarea>
            </div>

            <div class="form-group">
              <label for="paymentMethod">
                Payment Method
              </label>

              <select id="paymentMethod" required>
                <option value="">Select payment method</option>
                <option value="mobile">Mobile Payment</option>
                <option value="card">Card</option>
                <option value="other">Other</option>
              </select>
            </div>

            <button
              type="submit"
              class="btn"
            >
              Continue to Payment
            </button>

          </form>

        </div>

      </div>

      <!-- RIGHT -->
      <aside>

        <div class="card">

          <h2>Order Summary</h2>

          <div class="summary">

            <div class="summary-row">
              <span>Item</span>
              <strong id="summaryTitle">—</strong>
            </div>

            <div class="summary-row">
              <span>Category</span>
              <strong id="summaryCategory">—</strong>
            </div>

            <div class="summary-row">
              <span>Seller</span>
              <strong id="summarySeller">—</strong>
            </div>

            <div class="summary-row">
              <span>Availability</span>
              <strong id="summaryAvailability">—</strong>
            </div>

            <div class="summary-row">
              <span>Price</span>
              <strong id="summaryPrice">—</strong>
            </div>

            <div class="total">
              <span>Total</span>
              <strong id="totalPrice">—</strong>
            </div>

          </div>

          <div class="notice">
            Your order will remain pending until payment is
            successfully verified by the payment system.
          </div>

          <a
            id="backBtn"
            href="marketplace.html"
            class="back"
          >
            Back to Marketplace
          </a>

        </div>

      </aside>

    </div>

  </section>

</main>

<footer>
  © 2026 LetsStudy Pro. All rights reserved.
</footer>

<script type="module">

  import {
    initializeApp
  } from "https://www.gstatic.com/firebasejs/10.12.5/firebase-app.js";

  import {
    getFirestore,
    doc,
    getDoc
  } from "https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyBcOYDfAVK5XbkljsyRgI_0rj0odBn678tCc",
    authDomain: "let-s-study-pro-course.firebaseapp.com",
    databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
    projectId: "let-s-study-pro-course",
    storageBucket: "let-s-study-pro-course.firebasestorage.app",
    messagingSenderId: "474928293390",
    appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
    measurementId: "G-85B7V5H5J0"
  };

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);

  const params = new URLSearchParams(
    window.location.search
  );

  const itemId = params.get("id");

  const loading =
    document.getElementById("loading");

  const errorBox =
    document.getElementById("error");

  const content =
    document.getElementById("content");

  let marketplaceItem = null;

  function firstValue(data, fields, fallback = "") {

    for (const field of fields) {

      const value = data?.[field];

      if (
        value !== undefined &&
        value !== null &&
        String(value).trim() !== ""
      ) {
        return value;
      }

    }

    return fallback;
  }

  function getTitle(data) {

    return firstValue(
      data,
      [
        "title",
        "name",
        "productTitle",
        "productName",
        "itemTitle"
      ],
      "Marketplace Item"
    );

  }

  function getPrice(data) {

    const value = firstValue(
      data,
      [
        "price",
        "amount",
        "cost",
        "marketplacePrice"
      ],
      0
    );

    const number = Number(value);

    return Number.isFinite(number)
      ? number
      : 0;

  }

  function formatPrice(value) {

    const number = Number(value);

    if (!Number.isFinite(number)) {
      return "0";
    }

    return new Intl.NumberFormat(
      undefined,
      {
        maximumFractionDigits: 2
      }
    ).format(number);

  }

  function getAccess(data) {

    const access = String(
      firstValue(
        data,
        [
          "access",
          "accessType",
          "membership",
          "plan"
        ],
        ""
      )
    ).toLowerCase().trim();

    const isPlan =
      data?.isPremium === true ||
      data?.premium === true ||
      data?.paid === true ||
      [
        "plan",
        "premium",
        "paid",
        "pro"
      ].includes(access);

    return isPlan
      ? "plan"
      : "free";

  }

  async function loadItem() {

    if (!itemId) {

      loading.style.display = "none";

      errorBox.style.display = "block";

      errorBox.textContent =
        "Marketplace item could not be found.";

      return;
    }

    try {

      const ref = doc(
        db,
        "marketplace",
        itemId
      );

      const snap = await getDoc(ref);

      if (!snap.exists()) {
        throw new Error(
          "Marketplace item not found."
        );
      }

      const data = snap.data();

      /*
       * This page is intended for Plan Marketplace items.
       * Free items are redirected to the free page.
       */

      if (getAccess(data) !== "plan") {

        window.location.href =
          `marketplace-free.html?id=${encodeURIComponent(itemId)}`;

        return;
      }

      marketplaceItem = {
        id: itemId,
        data,
        title: getTitle(data),
        price: getPrice(data)
      };

      const description =
        firstValue(
          data,
          [
            "description",
            "summary",
            "shortDescription",
            "overview",
            "content"
          ],
          ""
        );

      const category =
        firstValue(
          data,
          [
            "category",
            "marketplaceCategory",
            "productCategory",
            "type",
            "field"
          ],
          "General"
        );

      const seller =
        firstValue(
          data,
          [
            "seller",
            "sellerName",
            "vendor",
            "vendorName",
            "provider",
            "providerName"
          ],
          "Marketplace Seller"
        );

      const availability =
        firstValue(
          data,
          [
            "availability",
            "stock",
            "status",
            "itemStatus"
          ],
          "Available"
        );

      const image =
        firstValue(
          data,
          [
            "image",
            "imageUrl",
            "thumbnail",
            "thumbnailUrl",
            "cover",
            "coverImage"
          ],
          ""
        );

      document.title =
        `${marketplaceItem.title} | Marketplace Order | LetsStudy Pro`;

      document.getElementById("itemTitle")
        .textContent =
        marketplaceItem.title;

      document.getElementById("itemDescription")
        .textContent =
        description;

      document.getElementById("itemPrice")
        .textContent =
        formatPrice(marketplaceItem.price);

      document.getElementById("summaryTitle")
        .textContent =
        marketplaceItem.title;

      document.getElementById("summaryCategory")
        .textContent =
        category;

      document.getElementById("summarySeller")
        .textContent =
        seller;

      document.getElementById("summaryAvailability")
        .textContent =
        availability;

      document.getElementById("summaryPrice")
        .textContent =
        formatPrice(marketplaceItem.price);

      document.getElementById("totalPrice")
        .textContent =
        formatPrice(marketplaceItem.price);

      const itemImage =
        document.getElementById("itemImage");

      if (image) {

        itemImage.src = image;

        itemImage.onerror = () => {
          itemImage.style.display = "none";
        };

      } else {

        itemImage.style.display = "none";

      }

      document.getElementById("backBtn").href =
        `marketplace-details.html?id=${encodeURIComponent(itemId)}`;

      loading.style.display = "none";

      content.style.display = "block";

    } catch (error) {

      console.error(error);

      loading.style.display = "none";

      errorBox.style.display = "block";

      errorBox.textContent =
        "Unable to load this marketplace item. Please try again.";

    }

  }

  document
    .getElementById("orderForm")
    .addEventListener("submit", event => {

      event.preventDefault();

      if (!marketplaceItem) {
        return;
      }

      const fullName =
        document.getElementById("fullName")
          .value.trim();

      const email =
        document.getElementById("email")
          .value.trim();

      const phone =
        document.getElementById("phone")
          .value.trim();

      const requirements =
        document.getElementById("requirements")
          .value.trim();

      const paymentMethod =
        document.getElementById("paymentMethod")
          .value;

      if (
        !fullName ||
        !email ||
        !phone ||
        !paymentMethod
      ) {

        alert(
          "Please complete all required fields."
        );

        return;
      }

      const orderId =
        "MKT-" +
        Date.now() +
        "-" +
        Math.random()
          .toString(36)
          .substring(2, 8)
          .toUpperCase();

      const pendingOrder = {

        orderId,

        marketplaceItem: {
          marketplaceId:
            marketplaceItem.id,

          title:
            marketplaceItem.title,

          price:
            marketplaceItem.price
        },

        customer: {
          name: fullName,
          email,
          phone
        },

        requirements,

        paymentMethod,

        total:
          marketplaceItem.price,

        status: "pending",

        createdAt:
          new Date().toISOString()

      };

      /*
       * Temporary client-side order state.
       * Payment must NOT be considered successful here.
       */
      localStorage.setItem(
        "pendingMarketplaceOrder",
        JSON.stringify(pendingOrder)
      );

      /*
       * Continue to the payment page.
       */
      window.location.href =
        "payment.html";

    });

  loadItem();

</script>

</body>
</html>