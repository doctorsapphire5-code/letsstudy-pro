<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Marketplace Search | LetsStudy Pro</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#f5f7fb;
    color:#172033;
}

header{
    height:64px;
    background:#fff;
    border-bottom:1px solid #e2e8f0;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 18px;
    position:sticky;
    top:0;
    z-index:20;
}

.brand{
    display:flex;
    align-items:center;
    gap:9px;
    font-weight:900;
}

.logo{
    width:39px;
    height:39px;
    border-radius:10px;
    background:#172033;
    color:#fff;
    display:grid;
    place-items:center;
    font-size:10px;
}

.btn{
    border:0;
    padding:10px 13px;
    border-radius:8px;
    font-weight:800;
    cursor:pointer;
}

.light{
    background:#eef2f7;
    color:#172033;
}

.primary{
    background:#2563eb;
    color:#fff;
}

.container{
    max-width:1200px;
    margin:auto;
    padding:25px 17px;
}

.hero{
    background:#172033;
    color:#fff;
    padding:40px 20px;
    text-align:center;
}

.hero h1{
    font-size:31px;
    margin-bottom:7px;
}

.hero p{
    color:#cbd5e1;
    font-size:12px;
}

.search-box{
    background:#fff;
    padding:15px;
    border:1px solid #e2e8f0;
    border-radius:12px;
    display:flex;
    gap:8px;
    margin-top:-25px;
    position:relative;
}

.search-box input{
    flex:1;
    min-width:0;
    padding:12px;
    border:1px solid #dbe2ea;
    border-radius:8px;
    outline:none;
}

.search-box select{
    width:160px;
    border:1px solid #dbe2ea;
    border-radius:8px;
    padding:8px;
}

.results-bar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin:20px 0 12px;
}

.results-count{
    font-size:12px;
    color:#64748b;
}

.products{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.card{
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:12px;
    overflow:hidden;
    transition:.2s;
}

.card:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 25px rgba(0,0,0,.07);
}

.thumb{
    height:175px;
    background:#eef2ff;
    display:grid;
    place-items:center;
    overflow:hidden;
    font-size:55px;
    position:relative;
}

.thumb img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.featured{
    position:absolute;
    top:8px;
    left:8px;
    background:#f59e0b;
    color:#fff;
    padding:5px 8px;
    border-radius:6px;
    font-size:9px;
    font-weight:900;
}

.card-body{
    padding:13px;
}

.type{
    color:#2563eb;
    text-transform:uppercase;
    font-size:9px;
    font-weight:900;
}

.title{
    font-size:14px;
    font-weight:900;
    margin-top:5px;
}

.short{
    color:#64748b;
    font-size:11px;
    line-height:1.5;
    margin-top:5px;
    min-height:32px;
}

.price{
    margin-top:10px;
    font-size:17px;
    font-weight:900;
}

.old-price{
    text-decoration:line-through;
    color:#94a3b8;
    font-size:10px;
    margin-left:5px;
}

.rating{
    margin-top:7px;
    font-size:10px;
    color:#64748b;
}

.card-actions{
    display:flex;
    gap:6px;
    margin-top:11px;
}

.card-actions button,
.card-actions a{
    flex:1;
    text-align:center;
}

.loading,
.empty{
    text-align:center;
    padding:55px 15px;
    color:#64748b;
}

.empty{
    display:none;
}

@media(max-width:950px){
    .products{
        grid-template-columns:repeat(3,1fr);
    }
}

@media(max-width:700px){
    .products{
        grid-template-columns:repeat(2,1fr);
    }

    .search-box{
        flex-direction:column;
    }

    .search-box select{
        width:100%;
    }
}

@media(max-width:450px){
    .products{
        grid-template-columns:1fr;
    }
}
</style>
</head>

<body>

<header>

<a href="marketplace.html"
   class="brand">

    <div class="logo">
        LSP
    </div>

    LetsStudy Pro

</a>

<a href="marketplace.html"
   class="btn light">

    Marketplace

</a>

</header>


<section class="hero">

<h1>
Marketplace Search
</h1>

<p>
Search courses, digital products,
physical products and more.
</p>

</section>


<main class="container">


<div class="search-box">

<input
    id="search"
    type="search"
    placeholder="Search marketplace...">


<select id="category">

<option value="all">
All Categories
</option>

</select>


<select id="type">

<option value="all">
All Types
</option>

</select>

</div>


<div class="results-bar">

<strong>
Search Results
</strong>

<span
    id="count"
    class="results-count">

    0 products

</span>

</div>


<div
    id="loading"
    class="loading">

    Loading marketplace...

</div>


<div
    id="products"
    class="products">
</div>


<div
    id="empty"
    class="empty">

    <h3>
        No products found
    </h3>

    <p>
        Try another search term or category.
    </p>

</div>

</main>


<script type="module">

import {
    initializeApp
}
from
"https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";

import {
    getFirestore,
    collection,
    getDocs
}
from
"https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";


/* =========================
   FIREBASE
========================= */

const firebaseConfig = {

    apiKey:
        "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

    authDomain:
        "let-s-study-pro-course.firebaseapp.com",

    databaseURL:
        "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

    projectId:
        "let-s-study-pro-course",

    messagingSenderId:
        "474928293390",

    appId:
        "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

    measurementId:
        "G-85B7V5H5J0"

};

const app =
    initializeApp(
        firebaseConfig
    );

const db =
    getFirestore(app);


/* =========================
   STATE
========================= */

let marketplace = [];


/* =========================
   HELPERS
========================= */

function get(id){

    return document.getElementById(id);

}


function escapeHTML(value){

    return String(value ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


function money(
    price,
    currency="TZS"
){

    return (
        currency +
        " " +
        Number(price || 0)
        .toLocaleString()
    );

}


/* =========================
   LOAD MARKETPLACE
========================= */

async function loadMarketplace(){

    try{

        const snapshot =
            await getDocs(
                collection(
                    db,
                    "marketplace"
                )
            );


        marketplace = [];


        snapshot.forEach(
            docSnap => {

                const data =
                    docSnap.data();


                /*
                 * Only published products
                 */

                if(
                    data.status &&
                    data.status !==
                    "published"
                ){

                    return;

                }


                marketplace.push({

                    id:
                        docSnap.id,

                    title:
                        data.title ||
                        "Untitled Product",

                    slug:
                        data.slug ||
                        docSnap.id,

                    description:
                        data.description ||
                        "",

                    shortDescription:
                        data.shortDescription ||
                        data.description ||
                        "",

                    type:
                        data.type ||
                        "product",

                    category:
                        data.category ||
                        "other",

                    price:
                        Number(
                            data.price || 0
                        ),

                    currency:
                        data.currency ||
                        "TZS",

                    discountPrice:
                        data.discountPrice != null
                        ? Number(
                            data.discountPrice
                        )
                        : null,

                    thumbnail:
                        data.thumbnail ||
                        "",

                    imageUrl:
                        data.imageUrl ||
                        "",

                    productUrl:
                        data.productUrl ||
                        "",

                    courseId:
                        data.courseId ||
                        "",

                    status:
                        data.status ||
                        "published",

                    featured:
                        Boolean(
                            data.featured
                        ),

                    rating:
                        Number(
                            data.rating || 0
                        ),

                    ratingCount:
                        Number(
                            data.ratingCount || 0
                        ),

                    salesCount:
                        Number(
                            data.salesCount || 0
                        ),

                    createdAt:
                        data.createdAt ||
                        null,

                    updatedAt:
                        data.updatedAt ||
                        null,

                    publishedAt:
                        data.publishedAt ||
                        null

                });

            }
        );


        /*
         * Featured first
         */

        marketplace.sort(
            (a,b) =>
                Number(b.featured) -
                Number(a.featured)
        );


        buildFilters();

        render();


    }catch(error){

        console.error(
            "Marketplace error:",
            error
        );

        get("loading")
            .textContent =
            "Unable to load marketplace.";

    }

}


/* =========================
   FILTER OPTIONS
========================= */

function buildFilters(){

    const categories =
        [
            ...new Set(
                marketplace
                    .map(
                        item =>
                            item.category
                    )
                    .filter(Boolean)
            )
        ];


    const types =
        [
            ...new Set(
                marketplace
                    .map(
                        item =>
                            item.type
                    )
                    .filter(Boolean)
            )
        ];


    get("category").innerHTML =

        `<option value="all">
            All Categories
        </option>` +

        categories
            .map(
                category => `

                <option
                    value="${escapeHTML(
                        category
                    )}">

                    ${escapeHTML(
                        category
                    )}

                </option>

                `
            )
            .join("");


    get("type").innerHTML =

        `<option value="all">
            All Types
        </option>` +

        types
            .map(
                type => `

                <option
                    value="${escapeHTML(
                        type
                    )}">

                    ${escapeHTML(
                        type
                    )}

                </option>

                `
            )
            .join("");

}


/* =========================
   SEARCH
========================= */

function searchProducts(){

    const query =
        get("search")
            .value
            .toLowerCase()
            .trim();


    const category =
        get("category")
            .value;


    const type =
        get("type")
            .value;


    const results =
        marketplace.filter(
            product => {

                const searchable = (

                    product.title +
                    " " +
                    product.slug +
                    " " +
                    product.description +
                    " " +
                    product.shortDescription +
                    " " +
                    product.category +
                    " " +
                    product.type

                ).toLowerCase();


                const matchesSearch =
                    !query ||
                    searchable.includes(
                        query
                    );


                const matchesCategory =
                    category === "all" ||
                    product.category ===
                    category;


                const matchesType =
                    type === "all" ||
                    product.type ===
                    type;


                return (
                    matchesSearch &&
                    matchesCategory &&
                    matchesType
                );

            }
        );


    render(
        results
    );

}


/* =========================
   RENDER
========================= */

function render(
    list = marketplace
){

    get("loading")
        .style.display =
        "none";


    get("count")
        .textContent =
        list.length +
        (
            list.length === 1
            ? " product"
            : " products"
        );


    get("empty")
        .style.display =
        list.length
        ? "none"
        : "block";


    get("products")
        .innerHTML =

        list.map(
            product => {

                const image =
                    product.thumbnail ||
                    product.imageUrl;


                const finalPrice =
                    product.discountPrice !== null
                    ? product.discountPrice
                    : product.price;


                const hasDiscount =
                    product.discountPrice !== null &&
                    product.discountPrice <
                    product.price;


                const link =
                    product.productUrl ||
                    (
                        "product.html?id=" +
                        encodeURIComponent(
                            product.id
                        )
                    );


                return `

                <article
                    class="card">


                    <div
                        class="thumb">


                        ${
                            image

                            ?

                            `
                            <img
                                src="${escapeHTML(
                                    image
                                )}"
                                alt="${escapeHTML(
                                    product.title
                                )}"
                                loading="lazy">
                            `

                            :

                            "🛍️"
                        }


                        ${
                            product.featured

                            ?

                            `
                            <span
                                class="featured">

                                FEATURED

                            </span>
                            `

                            :

                            ""
                        }

                    </div>


                    <div
                        class="card-body">


                        <div
                            class="type">

                            ${escapeHTML(
                                product.type
                            )}

                        </div>


                        <div
                            class="title">

                            ${escapeHTML(
                                product.title
                            )}

                        </div>


                        <div
                            class="short">

                            ${escapeHTML(
                                product.shortDescription
                            )}

                        </div>


                        <div
                            class="price">

                            ${money(
                                finalPrice,
                                product.currency
                            )}

                            ${
                                hasDiscount

                                ?

                                `
                                <span
                                    class="old-price">

                                    ${money(
                                        product.price,
                                        product.currency
                                    )}

                                </span>
                                `

                                :

                                ""
                            }

                        </div>


                        <div
                            class="rating">

                            ⭐
                            ${product.rating.toFixed(1)}

                            ·

                            ${product.ratingCount}
                            reviews

                            ·

                            ${product.salesCount}
                            sales

                        </div>


                        <div
                            class="card-actions">


                            <a
                                href="${escapeHTML(
                                    link
                                )}"
                                class="btn primary">

                                View

                            </a>


                            <button
                                class="btn light"
                                onclick="
                                    shareProduct(
                                        '${escapeHTML(
                                            product.id
                                        )}'
                                    )
                                ">

                                ↗

                            </button>

                        </div>

                    </div>

                </article>

                `;

            }
        )
        .join("");

}


/* =========================
   SHARE
========================= */

async function shareProduct(id){

    const product =
        marketplace.find(
            item =>
                item.id === id
        );


    if(!product){

        return;

    }


    const url =
        product.productUrl ||

        (
            window.location.origin +
            "/product.html?id=" +
            encodeURIComponent(
                id
            )
        );


    const text =
        product.title +
        "\n\n" +
        product.shortDescription +
        "\n\n" +
        url;


    if(
        navigator.share
    ){

        try{

            await navigator.share({

                title:
                    product.title,

                text:
                    text,

                url:
                    url

            });

            return;

        }catch(error){

            if(
                error.name ===
                "AbortError"
            ){

                return;

            }

        }

    }


    try{

                await navigator.clipboard
            .writeText(url);

        alert(
            "Product link copied."
        );

    } catch(error) {

        console.error(
            "Copy failed:",
            error
        );

        alert(
            "Copy failed. Please copy the URL manually."
        );

    }

}


/* =========================
   EVENTS
========================= */

get("search")
    .addEventListener(
        "input",
        searchProducts
    );

get("category")
    .addEventListener(
        "change",
        searchProducts
    );

get("type")
    .addEventListener(
        "change",
        searchProducts
    );


/* =========================
   ENTER KEY
========================= */

get("search")
    .addEventListener(
        "keydown",
        function(event) {

            if(
                event.key === "Enter"
            ){

                event.preventDefault();

                searchProducts();

            }

        }
    );


/* =========================
   START
========================= */

loadMarketplace();


/* =========================
   GLOBAL FUNCTIONS
========================= */

window.searchProducts =
    searchProducts;

window.shareProduct =
    shareProduct;

window.loadMarketplace =
    loadMarketplace;

</script>

</body>
</html>