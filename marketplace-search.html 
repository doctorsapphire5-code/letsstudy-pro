<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Marketplace | LetsStudy Pro</title>

<meta name="description"
      content="Shop courses, digital products and physical products on LetsStudy Pro.">

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#f5f7fb;
    color:#172033;
}

button,
input,
select{
    font:inherit;
}

button,
a{
    -webkit-tap-highlight-color:transparent;
}

a{
    text-decoration:none;
    color:inherit;
}

/* =========================
   HEADER
========================= */

header{
    height:66px;
    background:#fff;
    border-bottom:1px solid #e2e8f0;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 18px;
    position:sticky;
    top:0;
    z-index:100;
}

.brand{
    display:flex;
    align-items:center;
    gap:9px;
    font-weight:900;
}

.logo{
    width:40px;
    height:40px;
    border-radius:10px;
    background:#172033;
    color:#fff;
    display:grid;
    place-items:center;
    font-size:10px;
}

.header-actions{
    display:flex;
    align-items:center;
    gap:8px;
}

.header-btn{
    border:0;
    background:#eef2f7;
    color:#172033;
    padding:9px 12px;
    border-radius:8px;
    font-weight:800;
    cursor:pointer;
}

.cart-button{
    position:relative;
}

.cart-count{
    position:absolute;
    top:-7px;
    right:-7px;
    min-width:20px;
    height:20px;
    border-radius:50%;
    background:#ef4444;
    color:#fff;
    font-size:10px;
    display:grid;
    place-items:center;
    font-weight:900;
    padding:0 4px;
}

/* =========================
   HERO
========================= */

.hero{
    background:#172033;
    color:#fff;
    padding:42px 18px 65px;
    text-align:center;
}

.hero h1{
    font-size:32px;
    margin-bottom:8px;
}

.hero p{
    color:#cbd5e1;
    font-size:13px;
}

/* =========================
   CONTAINER
========================= */

.container{
    max-width:1200px;
    margin:auto;
    padding:0 17px 35px;
}

/* =========================
   SEARCH
========================= */

.search-panel{
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:14px;
    padding:14px;
    margin-top:-30px;
    position:relative;
    z-index:5;
    box-shadow:0 8px 25px rgba(0,0,0,.05);
}

.search-row{
    display:flex;
    gap:8px;
}

.search-input{
    flex:1;
    min-width:0;
    border:1px solid #dbe2ea;
    border-radius:9px;
    padding:13px 14px;
    outline:none;
}

.search-input:focus{
    border-color:#2563eb;
}

.category-select{
    width:190px;
    border:1px solid #dbe2ea;
    border-radius:9px;
    padding:10px;
    background:#fff;
    outline:none;
}

/* =========================
   CATEGORY CHIPS
========================= */

.category-list{
    display:flex;
    gap:8px;
    overflow-x:auto;
    padding:15px 0 3px;
}

.category-list::-webkit-scrollbar{
    height:3px;
}

.category-btn{
    border:1px solid #dbe2ea;
    background:#fff;
    padding:8px 14px;
    border-radius:999px;
    white-space:nowrap;
    cursor:pointer;
    font-size:11px;
    font-weight:800;
}

.category-btn.active{
    background:#2563eb;
    color:#fff;
    border-color:#2563eb;
}

/* =========================
   RESULTS
========================= */

.results-bar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin:20px 0 12px;
}

.results-title{
    font-size:17px;
    font-weight:900;
}

.results-count{
    color:#64748b;
    font-size:11px;
}

/* =========================
   PRODUCTS
========================= */

.products{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.product-card{
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:13px;
    overflow:hidden;
    transition:.2s;
}

.product-card:hover{
    transform:translateY(-2px);
    box-shadow:0 12px 30px rgba(0,0,0,.07);
}

.product-image{
    height:180px;
    background:#eef2ff;
    display:grid;
    place-items:center;
    position:relative;
    overflow:hidden;
}

.product-image img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.product-placeholder{
    font-size:55px;
}

.featured{
    position:absolute;
    left:8px;
    top:8px;
    background:#f59e0b;
    color:#fff;
    padding:5px 8px;
    border-radius:6px;
    font-size:9px;
    text-transform:uppercase;
    font-weight:900;
}

.discount{
    position:absolute;
    right:8px;
    top:8px;
    background:#ef4444;
    color:#fff;
    padding:5px 8px;
    border-radius:6px;
    font-size:9px;
    font-weight:900;
}

.product-body{
    padding:13px;
}

.product-type{
    color:#2563eb;
    text-transform:uppercase;
    font-size:9px;
    font-weight:900;
}

.product-title{
    font-size:14px;
    line-height:1.3;
    margin-top:5px;
    font-weight:900;
}

.product-description{
    color:#64748b;
    font-size:11px;
    line-height:1.5;
    margin-top:6px;
    min-height:34px;
}

.product-price{
    margin-top:10px;
    font-size:17px;
    font-weight:900;
}

.old-price{
    color:#94a3b8;
    text-decoration:line-through;
    font-size:10px;
    margin-left:5px;
}

.rating{
    color:#64748b;
    font-size:10px;
    margin-top:7px;
}

.product-actions{
    display:grid;
    grid-template-columns:1fr 42px;
    gap:6px;
    margin-top:12px;
}

.view-btn,
.cart-btn,
.share-btn{
    border:0;
    border-radius:8px;
    padding:9px;
    text-align:center;
    cursor:pointer;
    font-weight:800;
    font-size:11px;
}

.view-btn{
    background:#172033;
    color:#fff;
}

.cart-btn{
    background:#2563eb;
    color:#fff;
}

.share-btn{
    background:#eef2f7;
    color:#172033;
}

/* =========================
   STATES
========================= */

.loading,
.empty{
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:12px;
    text-align:center;
    padding:55px 15px;
    color:#64748b;
}

.empty{
    display:none;
}

/* =========================
   CART DRAWER
========================= */

.cart-overlay{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.45);
    z-index:200;
    display:none;
}

.cart-overlay.show{
    display:block;
}

.cart-drawer{
    position:absolute;
    right:0;
    top:0;
    height:100%;
    width:min(430px,100%);
    background:#fff;
    display:flex;
    flex-direction:column;
}

.cart-header{
    padding:17px;
    border-bottom:1px solid #e2e8f0;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.cart-header h2{
    font-size:18px;
}

.close-cart{
    border:0;
    background:#eef2f7;
    width:35px;
    height:35px;
    border-radius:8px;
    cursor:pointer;
}

.cart-items{
    flex:1;
    overflow-y:auto;
    padding:12px;
}

.cart-empty{
    text-align:center;
    color:#64748b;
    padding:45px 15px;
}

.cart-item{
    display:grid;
    grid-template-columns:65px 1fr;
    gap:10px;
    padding:11px 0;
    border-bottom:1px solid #edf1f5;
}

.cart-item-image{
    width:65px;
    height:65px;
    border-radius:9px;
    background:#eef2ff;
    overflow:hidden;
    display:grid;
    place-items:center;
}

.cart-item-image img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.cart-item-title{
    font-size:12px;
    font-weight:900;
}

.cart-item-price{
    font-size:11px;
    margin-top:4px;
    font-weight:800;
}

.quantity{
    display:flex;
    align-items:center;
    gap:7px;
    margin-top:8px;
}

.quantity button{
    width:27px;
    height:27px;
    border:0;
    border-radius:6px;
    background:#eef2f7;
    cursor:pointer;
    font-weight:900;
}

.quantity span{
    min-width:18px;
    text-align:center;
    font-size:11px;
}

.remove-item{
    border:0;
    background:none;
    color:#ef4444;
    cursor:pointer;
    font-size:10px;
    margin-top:5px;
}

.cart-footer{
    border-top:1px solid #e2e8f0;
    padding:15px;
}

.total-row{
    display:flex;
    justify-content:space-between;
    font-size:15px;
    font-weight:900;
    margin-bottom:12px;
}

.checkout-btn{
    width:100%;
    border:0;
    background:#2563eb;
    color:#fff;
    padding:13px;
    border-radius:9px;
    cursor:pointer;
    font-weight:900;
}

/* =========================
   TOAST
========================= */

.toast{
    position:fixed;
    left:50%;
    bottom:20px;
    transform:translate(-50%,20px);
    background:#172033;
    color:#fff;
    padding:11px 15px;
    border-radius:8px;
    font-size:11px;
    opacity:0;
    pointer-events:none;
    transition:.25s;
    z-index:500;
}

.toast.show{
    opacity:1;
    transform:translate(-50%,0);
}

/* =========================
   MOBILE
========================= */

@media(max-width:950px){

    .products{
        grid-template-columns:repeat(3,1fr);
    }

}

@media(max-width:700px){

    .products{
        grid-template-columns:repeat(2,1fr);
    }

    .search-row{
        flex-direction:column;
    }

    .category-select{
        width:100%;
    }

    .hero h1{
        font-size:27px;
    }

}

@media(max-width:450px){

    .products{
        grid-template-columns:1fr;
    }

    .product-image{
        height:210px;
    }

}
</style>
</head>

<body>

<!-- =========================
     HEADER
========================= -->

<header>

<a href="index.html" class="brand">

    <div class="logo">
        LSP
    </div>

    <span>
        LetsStudy Pro
    </span>

</a>


<div class="header-actions">

    <button
        class="header-btn cart-button"
        onclick="openCart()">

        🛒 Cart

        <span
            id="cartCount"
            class="cart-count">

            0

        </span>

    </button>

</div>

</header>


<!-- =========================
     HERO
========================= -->

<section class="hero">

<h1>
    Marketplace
</h1>

<p>
    Discover courses, digital products,
    physical products and more.
</p>

</section>


<main class="container">

<!-- =========================
     SEARCH PANEL
========================= -->

<section class="search-panel">

<div class="search-row">

    <input
        id="productSearch"
        class="search-input"
        type="search"
        placeholder="🔎 Search products..."
        autocomplete="off">

    <select
        id="productCategory"
        class="category-select">

        <option value="all">
            All Categories
        </option>

    </select>

</div>


<div
    id="categoryList"
    class="category-list">

</div>

</section>


<!-- =========================
     RESULTS BAR
========================= -->

<div class="results-bar">

<div class="results-title">
    Products
</div>

<div
    id="productCount"
    class="results-count">

    0 Products

</div>

</div>


<!-- =========================
     LOADING
========================= -->

<div
    id="loading"
    class="loading">

    Loading marketplace...

</div>


<!-- =========================
     PRODUCTS
========================= -->

<div
    id="products"
    class="products">

</div>


<!-- =========================
     EMPTY
========================= -->

<div
    id="noProducts"
    class="empty">

    <h3>
        No products found
    </h3>

    <p style="margin-top:6px">

        Try another search or category.

    </p>

</div>

</main>


<!-- =========================
     CART
========================= -->

<div
    id="cartOverlay"
    class="cart-overlay"
    onclick="closeCart(event)">


<div
    class="cart-drawer"
    onclick="event.stopPropagation()">


<div class="cart-header">

<h2>
    🛒 Your Cart
</h2>

<button
    class="close-cart"
    onclick="closeCart()">

    ✕

</button>

</div>


<div
    id="cartItems"
    class="cart-items">

</div>


<div class="cart-footer">

<div class="total-row">

<span>
    Total
</span>

<span id="cartTotal">
    TZS 0
</span>

</div>


<button
    class="checkout-btn"
    onclick="goCheckout()">

    Proceed to Checkout →

</button>

</div>

</div>

</div>


<div
    id="toast"
    class="toast">

</div>


<script type="module">

import {
    initializeApp
}
from
"https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";

import {
    getFirestore,
    collection,
    getDocs
}
from
"https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";


/* =========================
   FIREBASE
========================= */

const firebaseConfig = {

    apiKey:
        "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

    authDomain:
        "let-s-study-pro-course.firebaseapp.com",

    databaseURL:
        "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

    projectId:
        "let-s-study-pro-course",

    storageBucket:
        "let-s-study-pro-course.firebasestorage.app",

    messagingSenderId:
        "474928293390",

    appId:
        "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

    measurementId:
        "G-85B7V5H5J0"

};


const app =
    initializeApp(
        firebaseConfig
    );


const db =
    getFirestore(app);


/* =========================
   STATE
========================= */

let marketplaceProducts = [];

let cart =
    JSON.parse(
        localStorage.getItem(
            "letsstudy_marketplace_cart"
        ) || "[]"
    );


/* =========================
   HELPERS
========================= */

function get(id){

    return document.getElementById(id);

}


function escapeHTML(value){

    return String(value ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


function money(
    price,
    currency = "TZS"
){

    return (
        currency +
        " " +
        Number(price || 0)
            .toLocaleString()
    );

}


function showToast(message){

    const toast =
        get("toast");

    toast.textContent =
        message;

    toast.classList.add(
        "show"
    );

    clearTimeout(
        window.toastTimer
    );

    window.toastTimer =
        setTimeout(
            () => {

                toast.classList.remove(
                    "show"
                );

            },
            2200
        );

}


/* =========================
   LOAD MARKETPLACE
========================= */

async function loadMarketplace(){

    try{

        const snapshot =
            await getDocs(
                collection(
                    db,
                    "marketplace"
                )
            );


        marketplaceProducts = [];


        snapshot.forEach(
            docSnap => {

                const data =
                    docSnap.data();


                /*
                 * Show published products.
                 * If status is missing,
                 * product is also allowed.
                 */

                if(
                    data.status &&
                    data.status !==
                    "published"
                ){

                    return;

                }


                marketplaceProducts.push({

                    id:
                        docSnap.id,

                    title:
                        data.title ||
                        "Untitled Product",

                    slug:
                        data.slug ||
                        docSnap.id,

                    description:
                        data.description ||
                        "",

                    shortDescription:
                        data.shortDescription ||
                        data.description ||
                        "",

                    type:
                        data.type ||
                        "product",

                    category:
                        data.category ||
                        "Other",

                    price:
                        Number(
                            data.price || 0
                        ),

                    currency:
                        data.currency ||
                        "TZS",

                    discountPrice:
                        data.discountPrice != null
                        ? Number(
                            data.discountPrice
                        )
                        : null,

                    thumbnail:
                        data.thumbnail ||
                        data.imageUrl ||
                        "",

                    imageUrl:
                        data.imageUrl ||
                        "",

                    productUrl:
                        data.productUrl ||
                        "",

                    courseId:
                        data.courseId ||
                        "",

                    featured:
                        Boolean(
                            data.featured
                        ),

                    rating:
                        Number(
                            data.rating || 0
                        ),

                    ratingCount:
                        Number(
                            data.ratingCount || 0
                        ),

                    salesCount:
                        Number(
                            data.salesCount || 0
                        )

                });

            }
        );


        /*
         * Featured products first
         */

        marketplaceProducts.sort(
            (a,b) =>
                Number(b.featured) -
                Number(a.featured)
        );


        createCategories();

        renderProducts(
            marketplaceProducts
        );


    }catch(error){

        console.error(
            "Marketplace error:",
            error
        );

        get("loading")
            .textContent =
            "Unable to load marketplace.";

    }

}


/* =========================
   CATEGORIES
========================= */

function createCategories(){

    const categories =
        [
            ...new Set(
                marketplaceProducts
                    .map(
                        product =>
                            product.category
                    )
                    .filter(Boolean)
            )
        ]
        .sort();


    const select =
        get("productCategory");


    select.innerHTML = `

        <option value="all">
            All Categories
        </option>

    `;


    categories.forEach(
        category => {

            const option =
                document.createElement(
                    "option"
                );

            option.value =
                category;

            option.textContent =
                category;

            select.appendChild(
                option
            );

        }
    );


    const list =
        get("categoryList");


    list.innerHTML = `

        <button
            class="category-btn active"
            data-category="all">

            All

        </button>

    `;


    categories.forEach(
        category => {

            list.innerHTML += `

                <button
                    class="category-btn"
                    data-category="${escapeHTML(
                        category
                    )}">

                    ${escapeHTML(
                        category
                    )}

                </button>

            `;

        }
    );


    list
        .querySelectorAll(
            ".category-btn"
        )
        .forEach(
            button => {

                button.addEventListener(
                    "click",
                    () => {

                        list
                            .querySelectorAll(
                                ".category-btn"
                            )
                            .forEach(
                                item =>
                                    item.classList
                                        .remove(
    "active"
);

button.classList.add(
    "active"
);

select.value =
    button.dataset.category;

filterProducts();

                }
            );

}


/* =========================
   SEARCH EVENTS
========================= */

get("productSearch")
    .addEventListener(
        "input",
        filterProducts
    );


get("productCategory")
    .addEventListener(
        "change",
        function(){

            const category =
                this.value;


            get("categoryList")
                .querySelectorAll(
                    ".category-btn"
                )
                .forEach(
                    button => {

                        button.classList.toggle(
                            "active",
                            button.dataset.category ===
                            category
                        );

                    }
                );


            filterProducts();

        }
    );


/* =========================
   INITIALIZE
========================= */

updateCartUI();

loadMarketplace();


/* =========================
   GLOBAL FUNCTIONS
========================= */

window.openCart =
    openCart;

window.closeCart =
    closeCart;

window.addToCart =
    addToCart;

window.changeQuantity =
    changeQuantity;

window.removeFromCart =
    removeFromCart;

window.shareProduct =
    shareProduct;

window.goCheckout =
    goCheckout;

window.filterProducts =
    filterProducts;

</script>

</body>
</html>        