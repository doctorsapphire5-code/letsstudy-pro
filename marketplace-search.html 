<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Marketplace Search | LetsStudy Pro</title>

<meta name="description"
content="Search courses, digital products and learning resources on LetsStudy Pro Marketplace.">

<style>
*{box-sizing:border-box}

:root{
  --primary:#059669;
  --dark:#172033;
  --muted:#667085;
  --bg:#f5f7fa;
  --card:#fff;
  --border:#e5e9ee;
}

body{
  margin:0;
  font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;
  background:var(--bg);
  color:var(--dark);
}

a{
  text-decoration:none;
  color:inherit;
}

button,input,select{
  font:inherit;
}

.header{
  height:68px;
  background:#fff;
  border-bottom:1px solid var(--border);
  position:sticky;
  top:0;
  z-index:50;
}

.nav{
  max-width:1200px;
  height:100%;
  margin:auto;
  padding:0 18px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  color:var(--primary);
  font-size:20px;
  font-weight:950;
}

.nav-links{
  display:flex;
  gap:7px;
  align-items:center;
}

.nav-links a{
  padding:9px 11px;
  border-radius:8px;
  color:#475467;
  font-size:10px;
  font-weight:900;
}

.nav-links a:hover{
  background:#ecfdf5;
  color:#047857;
}

.cart{
  background:#ecfdf5;
  color:#047857!important;
}

.container{
  max-width:1200px;
  margin:auto;
  padding:25px 18px 70px;
}

.hero{
  background:
    radial-gradient(circle at 90% 10%,#d1fae5,transparent 35%),
    linear-gradient(135deg,#fff,#f0fdf4);
  border:1px solid var(--border);
  border-radius:20px;
  padding:30px;
  margin-bottom:18px;
}

.hero h1{
  margin:0 0 8px;
  font-size:29px;
  letter-spacing:-.8px;
}

.hero p{
  margin:0;
  color:var(--muted);
  font-size:11px;
}

.search-row{
  display:flex;
  gap:8px;
  margin-top:20px;
}

.search-box{
  position:relative;
  flex:1;
}

.search-icon{
  position:absolute;
  left:13px;
  top:50%;
  transform:translateY(-50%);
}

.search{
  width:100%;
  height:45px;
  padding:0 40px;
  border:1px solid var(--border);
  border-radius:9px;
  outline:none;
  font-size:10px;
  background:#fff;
}

.search:focus{
  border-color:var(--primary);
}

.search-btn{
  border:0;
  border-radius:9px;
  padding:0 18px;
  background:var(--primary);
  color:#fff;
  font-size:10px;
  font-weight:950;
}

.filters{
  background:#fff;
  border:1px solid var(--border);
  border-radius:13px;
  padding:11px;
  display:grid;
  grid-template-columns:1fr 1fr 1fr 1fr;
  gap:8px;
  margin-bottom:18px;
}

.filter{
  width:100%;
  padding:10px;
  border:1px solid #dce1e7;
  border-radius:8px;
  outline:none;
  background:#fff;
  font-size:9px;
}

.results-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:12px;
}

.results-head h2{
  margin:0;
  font-size:17px;
}

.results-count{
  color:var(--muted);
  font-size:9px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
}

.product{
  position:relative;
  overflow:hidden;
  background:#fff;
  border:1px solid var(--border);
  border-radius:14px;
  transition:.2s;
}

.product:hover{
  transform:translateY(-3px);
  box-shadow:0 12px 28px #17203312;
}

.thumbnail{
  width:100%;
  height:155px;
  object-fit:cover;
  background:#ecfdf5;
}

.product-body{
  padding:13px;
}

.badges{
  display:flex;
  gap:5px;
  flex-wrap:wrap;
  margin-bottom:7px;
}

.badge{
  display:inline-block;
  padding:5px 7px;
  border-radius:6px;
  background:#f2f4f7;
  color:#475467;
  font-size:7px;
  font-weight:950;
}

.featured{
  background:#fff7ed;
  color:#c2410c;
}

.discount{
  background:#ecfdf3;
  color:#027a48;
}

.product h3{
  margin:0 0 6px;
  font-size:12px;
  line-height:1.4;
}

.description{
  min-height:35px;
  margin:0 0 10px;
  color:var(--muted);
  font-size:8px;
  line-height:1.6;
}

.rating{
  color:#f59e0b;
  font-size:9px;
  font-weight:900;
}

.rating span{
  color:var(--muted);
  font-size:8px;
}

.price-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-top:10px;
}

.price{
  color:var(--primary);
  font-size:14px;
  font-weight:950;
}

.old-price{
  margin-left:5px;
  color:#98a2b3;
  text-decoration:line-through;
  font-size:8px;
}

.view{
  padding:8px 10px;
  border-radius:7px;
  background:#ecfdf5;
  color:#047857;
  font-size:8px;
  font-weight:950;
}

.empty{
  grid-column:1/-1;
  padding:55px 20px;
  background:#fff;
  border:1px dashed #d0d5dd;
  border-radius:14px;
  text-align:center;
  color:var(--muted);
  font-size:10px;
}

.loading{
  grid-column:1/-1;
  padding:55px;
  text-align:center;
  color:var(--muted);
  font-size:10px;
}

.load-more{
  display:block;
  margin:22px auto 0;
  padding:11px 18px;
  border:1px solid var(--border);
  background:#fff;
  border-radius:9px;
  color:#475467;
  font-size:9px;
  font-weight:950;
}

.footer{
  margin-top:40px;
  padding-top:20px;
  border-top:1px solid var(--border);
  display:flex;
  justify-content:space-between;
  color:#98a2b3;
  font-size:9px;
}

@media(max-width:1000px){
  .grid{
    grid-template-columns:repeat(3,1fr);
  }

  .filters{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:700px){
  .grid{
    grid-template-columns:repeat(2,1fr);
  }

  .nav-links a:not(.cart){
    display:none;
  }

  .hero{
    padding:23px;
  }
}

@media(max-width:500px){
  .container{
    padding-left:12px;
    padding-right:12px;
  }

  .grid{
    grid-template-columns:1fr;
  }

  .filters{
    grid-template-columns:1fr;
  }

  .search-row{
    flex-direction:column;
  }

  .search-btn{
    height:42px;
  }

  .footer{
    flex-direction:column;
    gap:10px;
  }
}
</style>
</head>

<body>

<header class="header">

<nav class="nav">

<a href="index.html" class="logo">
LetsStudy Pro
</a>

<div class="nav-links">

<a href="courses.html">
Courses
</a>

<a href="marketplace.html">
Marketplace
</a>

<a href="marketplace-search.html" class="cart">
Search
</a>

<a href="cart.html">
Cart 🛒
</a>

</div>

</nav>

</header>


<main class="container">

<section class="hero">

<h1>
Find what you need.
</h1>

<p>
Search courses, digital products, learning resources and other products available on LetsStudy Pro Marketplace.
</p>

<div class="search-row">

<div class="search-box">

<span class="search-icon">
🔎
</span>

<input
id="searchInput"
class="search"
type="search"
placeholder="Search courses, products, categories..."
autocomplete="off">

</div>

<button
id="searchBtn"
class="search-btn">
Search
</button>

</div>

</section>


<section class="filters">

<select id="categoryFilter" class="filter">
<option value="all">
All Categories
</option>
</select>

<select id="typeFilter" class="filter">

<option value="all">
All Product Types
</option>

<option value="course">
Courses
</option>

<option value="ebook">
eBooks
</option>

<option value="template">
Templates
</option>

<option value="resource">
Resources
</option>

<option value="digital">
Digital Products
</option>

</select>


<select id="priceFilter" class="filter">

<option value="all">
All Prices
</option>

<option value="free">
Free
</option>

<option value="paid">
Paid
</option>

<option value="discount">
On Sale
</option>

</select>


<select id="sortFilter" class="filter">

<option value="featured">
Featured
</option>

<option value="newest">
Newest
</option>

<option value="rating">
Highest Rated
</option>

<option value="sales">
Best Selling
</option>

<option value="priceLow">
Price: Low to High
</option>

<option value="priceHigh">
Price: High to Low
</option>

</select>

</section>


<div class="results-head">

<h2>
Marketplace
</h2>

<span
id="resultsCount"
class="results-count">
Loading...
</span>

</div>


<section
id="productsGrid"
class="grid">

<div class="loading">
Loading marketplace...
</div>

</section>


<button
id="loadMore"
class="load-more"
style="display:none">
Load More
</button>


<footer class="footer">

<span>
© 2026 LetsStudy Pro
</span>

<div>
<a href="about.html">About</a>
&nbsp; · &nbsp;
<a href="help-center.html">Help</a>
&nbsp; · &nbsp;
<a href="contact.html">Contact</a>
</div>

</footer>

</main>


<script type="module">

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";

import {
getFirestore,
collection,
getDocs
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-firestore.js";


/* =====================================
FIREBASE
===================================== */

const firebaseConfig={

apiKey:
"AIzaSyBcOYDfAVKXbkljsyRgI_0rj0odBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f"

};


const app=
initializeApp(firebaseConfig);

const db=
getFirestore(app);


/* =====================================
STATE
===================================== */

let products=[];

let filteredProducts=[];

let visibleCount=12;


/* =====================================
ELEMENTS
===================================== */

const $=
id=>document.getElementById(id);


/* =====================================
ESCAPE
===================================== */

function escapeHTML(value){

return String(value ?? "")
.replaceAll("&","&amp;")
.replaceAll("<","&lt;")
.replaceAll(">","&gt;")
.replaceAll('"',"&quot;")
.replaceAll("'","&#039;");

}


/* =====================================
MONEY
===================================== */

function money(
amount,
currency="USD"
){

const value=
Number(amount||0);

if(
value===0
){

return "Free";

}

try{

return new Intl.NumberFormat(
undefined,
{
style:"currency",
currency:currency||"USD",
maximumFractionDigits:2
}
).format(value);

}catch{

return `${currency||""} ${value}`;

}

}


/* =====================================
DATE
===================================== */

function timestampValue(
value
){

if(
!value
)return 0;

if(
typeof value.seconds==="number"
){

return value.seconds*1000;

}

const date=
new Date(value);

return Number.isNaN(
date.getTime()
)
?0
:date.getTime();

}


/* =====================================
LOAD PRODUCTS
===================================== */

async function loadProducts(){

try{

const snap=
await getDocs(
collection(
db,
"marketplace"
)
);


products=
snap.docs
.map(
doc=>({

id:doc.id,
...doc.data()

})
)
.filter(
product=>
product.status==="published"
);


buildCategories();

applyFilters();


}catch(error){

console.error(
"Marketplace loading error:",
error
);

$("productsGrid").innerHTML=`

<div class="empty">

Unable to load marketplace products.

</div>

`;

$("resultsCount")
.textContent=
"Error";

}

}


/* =====================================
CATEGORIES
===================================== */

function buildCategories(){

const categories=[
...new Set(
products
.map(
p=>p.category
)
.filter(Boolean)
)
.sort();


$("categoryFilter").innerHTML=`

<option value="all">
All Categories
</option>

`+
categories
.map(
category=>`

<option value="${escapeHTML(category)}">
${escapeHTML(category)}
</option>

`
)
.join("");

}


/* =====================================
FILTERS
===================================== */

function applyFilters(){

const query=
$("searchInput")
.value
.toLowerCase()
.trim();

const category=
$("categoryFilter").value;

const type=
$("typeFilter").value;

const price=
$("priceFilter").value;

const sort=
$("sortFilter").value;


filteredProducts=
products.filter(
product=>{

const text=`

${product.title||""}
${product.description||""}
${product.shortDescription||""}
${product.category||""}
${product.type||""}

`
.toLowerCase();


const matchesSearch=
!query ||
text.includes(query);


const matchesCategory=
category==="all" ||
String(
product.category||""
)
===category;


const matchesType=
type==="all" ||
String(
product.type||""
)
.toLowerCase()
===type;


const normalPrice=
Number(
product.price||0
);

const discountPrice=
Number(
product.discountPrice||0
);


let matchesPrice=true;


if(
price==="free"
){

matchesPrice=
normalPrice===0 &&
discountPrice===0;

}

if(
price==="paid"
){

matchesPrice=
normalPrice>0 ||
discountPrice>0;

}

if(
price==="discount"
){

matchesPrice=
discountPrice>0 &&
discountPrice<normalPrice;

}


return(
matchesSearch &&
matchesCategory &&
matchesType &&
matchesPrice
);

});


/* =================================
SORT
================================= */

filteredProducts.sort(
(a,b)=>{

if(
sort==="rating"
){

return Number(
b.rating||0
)-
Number(
a.rating||0
);

}

if(
sort==="sales"
){

return Number(
b.salesCount||0
)-
Number(
a.salesCount||0
);

}

if(
sort==="priceLow"
){

return Number(
a.discountPrice ??
a.price ??
0
)-
Number(
b.discountPrice ??
b.price ??
0
);

}

if(
sort==="priceHigh"
){

return Number(
b.discountPrice ??
b.price ??
0
)-
Number(
a.discountPrice ??
a.price ??
0
);

}


/* newest / featured */

if(
sort==="featured"
){

const featured=
Number(
Boolean(b.featured)
)-
Number(
Boolean(a.featured)
);

if(featured!==0)
return featured;

}


return(
timestampValue(
b.createdAt
)-
timestampValue(
a.createdAt
)
);

}
);


visibleCount=12;

renderProducts();

}


/* =====================================
RENDER
===================================== */

function renderProducts(){

const visible=
filteredProducts
.slice(
0,
visibleCount
);


$("resultsCount")
.textContent=
`${filteredProducts.length} product${
filteredProducts.length===1?"":"s"
}`;


if(
!filteredProducts.length
){

$("productsGrid").innerHTML=`

<div class="empty">

<div style="font-size:25px;margin-bottom:8px">
🔎
</div>

No products found.

<br>

Try another search or filter.

</div>

`;

$("loadMore").style.display=
"none";

return;

}


$("productsGrid").innerHTML=
visible
.map(
product=>
productCard(product)
)
.join("");


$("loadMore").style.display=
visible.length<
filteredProducts.length
?"block"
:"none";

}


/* =====================================
PRODUCT CARD
===================================== */

function productCard(product){

const price=
Number(
product.price||0
);

const discount=
Number(
product.discountPrice||0
);

const hasDiscount=
discount>0 &&
discount<price;


const currentPrice=
hasDiscount
?discount
:price;


const rating=
Number(
product.rating||0
);

const ratingCount=
Number(
product.ratingCount||0
);


const image=
product.thumbnail ||
product.imageUrl ||
"";


return `

<a
href="marketplace-product.html?productId=${encodeURIComponent(product.id)}"
class="product">


${
image
?
`
<img
class="thumbnail"
src="${escapeHTML(image)}"
alt="${escapeHTML(product.title||"Product")}"
loading="lazy"
onerror="this.style.display='none'">
`
:
`
<div
class="thumbnail"
style="
display:flex;
align-items:center;
justify-content:center;
font-size:40px;">
🛍️
</div>
`
}


<div class="product-body">


<div class="badges">

${
product.featured
?
`
<span class="badge featured">
★ Featured
</span>
`
:""
}


${
hasDiscount
?
`
<span class="badge discount">
Sale
</span>
`
:""
}


${
product.type
?
`
<span class="badge">
${escapeHTML(product.type)}
</span>
`
:""
}

</div>


<h3>

${escapeHTML(
product.title||
"Untitled Product"
)}

</h3>


<p class="description">

${escapeHTML(
product.shortDescription ||
product.description ||
"Explore this product."
)}

</p>


<div class="rating">

${rating>0
?`★ ${rating.toFixed(1)}`
:"No rating"
}

<span>

(${ratingCount})

</span>

</div>


<div class="price-row">

<div>

<span class="price">

${money(
currentPrice,
product.currency
)}

</span>


${
hasDiscount
?
`
<span class="old-price">

${money(
price,
product.currency
)}

</span>
`
:""
}

</div>


<span class="view">
View →
</span>

</div>


</div>

</a>

`;

}


/* =====================================
SEARCH EVENTS
===================================== */

$("searchBtn")
.addEventListener(
"click",
applyFilters
);

$("searchInput")
.addEventListener(
"input",
applyFilters
);

$("categoryFilter")
.addEventListener(
"change",
applyFilters
);

$("typeFilter")
.addEventListener(
"change",
applyFilters
);

$("priceFilter")
.addEventListener(
"change",
applyFilters
);

$("sortFilter")
.addEventListener(
"change",
applyFilters
);


/* =====================================
ENTER SEARCH
===================================== */

$("searchInput")
.addEventListener(
"keydown",
event=>{

if(
event.key==="Enter"
){

applyFilters();

}

});


/* =====================================
LOAD MORE
===================================== */

$("loadMore")
.addEventListener(
"click",
()=>{

visibleCount+=12;

renderProducts();

});


/* =====================================
URL SEARCH
===================================== */

const params=
new URLSearchParams(
location.search
);

const urlQuery=
params.get("q");

if(urlQuery){

$("searchInput").value=
urlQuery;

}


/* =====================================
START
===================================== */

loadProducts();

</script>

</body>
</html>