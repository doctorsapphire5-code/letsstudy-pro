
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#101828">
  <title>My Career Applications | Vorix Career</title>
  <meta name="description" content="Manage and track your career applications on Vorix Career.">

  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --background: #f4f7fb;
      --surface: #ffffff;
      --text: #172033;
      --muted: #667085;
      --border: #e5eaf2;
      --success: #15803d;
      --warning: #b45309;
      --danger: #dc2626;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--background);
      color: var(--text);
      min-height: 100vh;
    }

    a {
      text-decoration: none;
    }

    .navbar {
      background: #101828;
      color: white;
      padding: 16px 5%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      flex-wrap: wrap;
    }

    .brand {
      font-size: 21px;
      font-weight: 800;
      color: white;
    }

    .brand span {
      color: #60a5fa;
    }

    .nav-links {
      display: flex;
      gap: 18px;
      align-items: center;
      flex-wrap: wrap;
    }

    .nav-links a {
      color: #d0d5dd;
      font-size: 13px;
    }

    .nav-links a:hover {
      color: white;
    }

    .container {
      width: min(1100px, 92%);
      margin: 35px auto;
    }

    .page-heading {
      margin-bottom: 25px;
    }

    .page-heading h1 {
      font-size: 29px;
      margin-bottom: 8px;
    }

    .page-heading p {
      color: var(--muted);
      line-height: 1.6;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
      margin-bottom: 25px;
    }

    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 13px;
      padding: 20px;
    }

    .stat-card p {
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 10px;
    }

    .stat-card h2 {
      font-size: 27px;
    }

    .toolbar {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 13px;
      padding: 17px;
      display: flex;
      gap: 12px;
      margin-bottom: 20px;
    }

    input,
    select {
      width: 100%;
      padding: 12px 13px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: white;
      font-size: 14px;
      outline: none;
      color: var(--text);
    }

    input:focus,
    select:focus {
      border-color: var(--primary);
    }

    .application-list {
      display: grid;
      gap: 16px;
    }

    .application-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 13px;
      padding: 22px;
    }

    .application-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 15px;
      margin-bottom: 16px;
    }

    .application-card h2 {
      font-size: 19px;
      margin-bottom: 7px;
    }

    .company {
      color: var(--muted);
      font-size: 14px;
    }

    .details {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 20px;
      color: var(--muted);
      font-size: 13px;
      border-top: 1px solid var(--border);
      padding-top: 15px;
      margin-bottom: 17px;
    }

    .status {
      padding: 7px 11px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
      text-transform: capitalize;
      white-space: nowrap;
      background: #eef2ff;
      color: #3730a3;
    }

    .status.pending {
      background: #fff7ed;
      color: #c2410c;
    }

    .status.reviewed {
      background: #eff6ff;
      color: #1d4ed8;
    }

    .status.shortlisted {
      background: #f3e8ff;
      color: #7e22ce;
    }

    .status.accepted {
      background: #dcfce7;
      color: #166534;
    }

    .status.rejected {
      background: #fee2e2;
      color: #b91c1c;
    }

    .status.withdrawn {
      background: #f2f4f7;
      color: #475467;
    }

    .card-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 11px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 700;
      border: none;
      cursor: pointer;
      text-align: center;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      background: var(--primary-dark);
    }

    .empty,
    .loading,
    .error {
      background: white;
      padding: 45px 20px;
      text-align: center;
      border: 1px solid var(--border);
      border-radius: 13px;
      line-height: 1.7;
    }

    .empty h2,
    .error h2 {
      margin-bottom: 10px;
    }

    .empty p,
    .error p {
      color: var(--muted);
      margin-bottom: 18px;
    }

    .footer {
      text-align: center;
      color: var(--muted);
      font-size: 13px;
      padding: 30px 15px;
    }

    @media (max-width: 700px) {
      .stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .toolbar {
        flex-direction: column;
      }

      .application-top {
        flex-direction: column;
      }

      .page-heading h1 {
        font-size: 24px;
      }
    }

    @media (max-width: 380px) {
      .stats {
        grid-template-columns: 1fr 1fr;
      }

      .stat-card {
        padding: 14px;
      }
    }
  </style>
</head>

<body>

  <header class="navbar">
    <a href="dashboard.html" class="brand">
      Vorix <span>Career</span>
    </a>

    <nav class="nav-links">
      <a href="dashboard.html">Dashboard</a>
      <a href="careers.html">Find Careers</a>
      <a href="career-profile.html">My Profile</a>
      <a href="career-settings.html">Settings</a>
    </nav>
  </header>

  <main class="container">

    <section class="page-heading">
      <h1>My Career Applications</h1>
      <p>Track your job applications and monitor their progress in one place.</p>
    </section>

    <section class="stats">
      <div class="stat-card">
        <p>Total Applications</p>
        <h2 id="totalCount">0</h2>
      </div>

      <div class="stat-card">
        <p>Pending</p>
        <h2 id="pendingCount">0</h2>
      </div>

      <div class="stat-card">
        <p>Shortlisted</p>
        <h2 id="shortlistedCount">0</h2>
      </div>

      <div class="stat-card">
        <p>Accepted</p>
        <h2 id="acceptedCount">0</h2>
      </div>
    </section>

    <section class="toolbar">
      <input
        type="search"
        id="searchInput"
        placeholder="Search by career title or organization..."
        aria-label="Search applications"
      >

      <select id="statusFilter" aria-label="Filter by status">
        <option value="all">All Applications</option>
        <option value="pending">Pending</option>
        <option value="reviewed">Reviewed</option>
        <option value="shortlisted">Shortlisted</option>
        <option value="accepted">Accepted</option>
        <option value="rejected">Rejected</option>
        <option value="withdrawn">Withdrawn</option>
      </select>
    </section>

    <section id="applicationList" class="application-list">
      <div class="loading">Loading your applications...</div>
    </section>

  </main>

  <footer class="footer">
    <p>Vorix Career — Career Opportunities and Professional Growth</p>
  </footer>

  <script type="module">
    import {
      initializeApp
    } from "https://www.gstatic.com/firebasejs/11.6.0/firebase-app.js";

    import {
      getAuth,
      onAuthStateChanged,
      signOut
    } from "https://www.gstatic.com/firebasejs/11.6.0/firebase-auth.js";

    import {
      getFirestore,
      collection,
      query,
      where,
      getDocs,
      doc,
      getDoc
    } from "https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js";

    // For Firebase JS SDK v7.20.0 and later, measurementId is optional
const firebaseConfig = {
  apiKey: "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",
  authDomain: "let-s-study-pro-course.firebaseapp.com",
  databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
  projectId: "let-s-study-pro-course",
  storageBucket: "let-s-study-pro-course.firebasestorage.app",
  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
};

    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);

    const applicationList = document.getElementById("applicationList");
    const searchInput = document.getElementById("searchInput");
    const statusFilter = document.getElementById("statusFilter");

    let allApplications = [];

    function escapeHTML(value) {
      return String(value ?? "").replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;"
      })[char]);
    }

    function getDate(value) {
      if (!value) return "Not available";

      let date;

      if (typeof value.toDate === "function") {
        date = value.toDate();
      } else {
        date = new Date(value);
      }

      if (isNaN(date.getTime())) return "Not available";

      return date.toLocaleDateString("en", {
        year: "numeric",
        month: "short",
        day: "numeric"
      });
    }

    function getTimestamp(value) {
      if (!value) return 0;

      if (typeof value.toMillis === "function") {
        return value.toMillis();
      }

      const date = new Date(value);
      return isNaN(date.getTime()) ? 0 : date.getTime();
    }

    function normalizeStatus(status) {
      return String(status || "pending").trim().toLowerCase();
    }

    function updateStats(applications) {
      document.getElementById("totalCount").textContent =
        applications.length;

      document.getElementById("pendingCount").textContent =
        applications.filter(app =>
          normalizeStatus(app.status) === "pending"
        ).length;

      document.getElementById("shortlistedCount").textContent =
        applications.filter(app =>
          normalizeStatus(app.status) === "shortlisted"
        ).length;

      document.getElementById("acceptedCount").textContent =
        applications.filter(app =>
          normalizeStatus(app.status) === "accepted"
        ).length;
    }

    async function loadMyApplications(userId) {
      applicationList.innerHTML =
        '<div class="loading">Loading your applications...</div>';

      try {
        const applicationsQuery = query(
          collection(db, "applications"),
          where("userId", "==", userId)
        );

        const snapshot = await getDocs(applicationsQuery);

        const applicationRecords = snapshot.docs.map(applicationDoc => ({
          applicationId: applicationDoc.id,
          ...applicationDoc.data()
        }));

        const results = await Promise.all(
          applicationRecords.map(async application => {
            let career = {};

            if (application.careerId) {
              try {
                const careerRef = doc(
                  db,
                  "careers",
                  application.careerId
                );

                const careerSnapshot = await getDoc(careerRef);

                if (careerSnapshot.exists()) {
                  career = careerSnapshot.data();
                }
              } catch (error) {
                console.error(
                  "Could not load career:",
                  application.careerId,
                  error
                );
              }
            }

            return {
              ...application,
              career
            };
          })
        );

        allApplications = results.sort((a, b) =>
          getTimestamp(b.appliedAt || b.createdAt) -
          getTimestamp(a.appliedAt || a.createdAt)
        );

        updateStats(allApplications);
        renderApplications();

      } catch (error) {
        console.error("Applications error:", error);

        applicationList.innerHTML = `
          <div class="error">
            <h2>Unable to Load Applications</h2>
            <p>Please check your internet connection and Firestore security rules.</p>
            <button class="btn btn-primary" onclick="location.reload()">
              Try Again
            </button>
          </div>
        `;
      }
    }

    function renderApplications() {
      const search = searchInput.value.trim().toLowerCase();
      const selectedStatus = statusFilter.value;

      const filtered = allApplications.filter(application => {
        const career = application.career || {};

        const title =
          career.title ||
          career.jobTitle ||
          career.careerTitle ||
          "";

        const company =
          career.organizationName ||
          career.company ||
          career.companyName ||
          "";

        const matchesSearch =
          String(title).toLowerCase().includes(search) ||
          String(company).toLowerCase().includes(search) ||
          String(application.careerId || "").toLowerCase().includes(search);

        const matchesStatus =
          selectedStatus === "all" ||
          normalizeStatus(application.status) === selectedStatus;

        return matchesSearch && matchesStatus;
      });

      if (!filtered.length) {
        applicationList.innerHTML = `
          <div class="empty">
            <h2>No Applications Found</h2>
            <p>No applications match your search or selected filter.</p>
            <a href="careers.html" class="btn btn-primary">
              Explore Careers
            </a>
          </div>
        `;
        return;
      }

      applicationList.innerHTML = filtered.map(application => {
        const career = application.career || {};

        const title =
          career.title ||
          career.jobTitle ||
          career.careerTitle ||
          "Career Opportunity";

        const company =
          career.organizationName ||
          career.company ||
          career.companyName ||
          "Organization not specified";

        const location =
          career.location ||
          career.city ||
          "Location not specified";

        const status = normalizeStatus(application.status);

        const allowedStatuses = [
          "pending",
          "reviewed",
          "shortlisted",
          "accepted",
          "rejected",
          "withdrawn"
        ];

        const statusClass = allowedStatuses.includes(status)
          ? status
          : "pending";

        const careerId = application.careerId || "";

        const careerLink = careerId
          ? `career-details.html?id=${encodeURIComponent(careerId)}`
          : "careers.html";

        const appliedDate = getDate(
          application.appliedAt || application.createdAt
        );

        return `
          <article class="application-card">
            <div class="application-top">
              <div>
                <h2>${escapeHTML(title)}</h2>
                <p class="company">${escapeHTML(company)}</p>
              </div>

              <span class="status ${statusClass}">
                ${escapeHTML(status)}
              </span>
            </div>

            <div class="details">
              <span>Location: ${escapeHTML(location)}</span>
              <span>Application date: ${escapeHTML(appliedDate)}</span>
              <span>Career ID: ${escapeHTML(careerId || "Unavailable")}</span>
            </div>

            <div class="card-actions">
              <a
                href="${careerLink}"
                class="btn btn-primary"
              >
                View Career
              </a>
            </div>
          </article>
        `;
      }).join("");
    }

    searchInput.addEventListener("input", renderApplications);
    statusFilter.addEventListener("change", renderApplications);

    onAuthStateChanged(auth, async user => {
      if (!user) {
        window.location.href = "login.html";
        return;
      }

      try {
        const userRef = doc(db, "users", user.uid);
        const userSnapshot = await getDoc(userRef);

        if (!userSnapshot.exists()) {
          await signOut(auth);
          window.location.href = "login.html";
          return;
        }

        const userData = userSnapshot.data();

        if (
          userData.role !== "user" ||
          userData.status !== "active"
        ) {
          await signOut(auth);
          window.location.href = "login.html";
          return;
        }

        await loadMyApplications(user.uid);

      } catch (error) {
        console.error("Authentication error:", error);

        applicationList.innerHTML = `
          <div class="error">
            <h2>Account Verification Failed</h2>
            <p>Please sign in again or contact support.</p>
            <a href="login.html" class="btn btn-primary">
              Login
            </a>
          </div>
        `;
      }
    });
  </script>

</body>
</html>
