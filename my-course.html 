
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0f172a">

  <title>My Courses | Vorix Course</title>
  <meta name="description" content="Manage enrolled courses, access course details and track your learning progress on Vorix Course.">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f8fafc;
      color: #0f172a;
    }

    header {
      background: #0f172a;
      color: white;
      padding: 17px 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
    }

    .brand {
      font-size: 21px;
      font-weight: bold;
    }

    .brand span {
      color: #60a5fa;
    }

    .header-actions {
      display: flex;
      gap: 9px;
    }

    .header-actions a,
    .header-actions button {
      text-decoration: none;
      color: white;
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 7px;
      padding: 10px 12px;
      font-size: 13px;
      cursor: pointer;
    }

    main {
      width: 92%;
      max-width: 1200px;
      margin: 32px auto;
    }

    .welcome {
      margin-bottom: 25px;
    }

    .welcome h1 {
      font-size: 28px;
      margin-bottom: 9px;
    }

    .welcome p {
      color: #64748b;
      font-size: 14px;
      line-height: 1.6;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
      margin-bottom: 32px;
    }

    .stat-card {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 20px;
    }

    .stat-card p {
      color: #64748b;
      font-size: 13px;
      margin-bottom: 10px;
    }

    .stat-card h2 {
      font-size: 28px;
      color: #2563eb;
    }

    .section-heading {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }

    .section-heading h2 {
      font-size: 21px;
    }

    .section-heading a {
      color: #2563eb;
      text-decoration: none;
      font-size: 13px;
      font-weight: bold;
    }

    .filters {
      display: flex;
      gap: 10px;
      margin-bottom: 22px;
    }

    .filters input,
    .filters select {
      padding: 12px;
      border: 1px solid #cbd5e1;
      background: white;
      border-radius: 8px;
      font-size: 14px;
      outline: none;
    }

    .filters input {
      flex: 1;
      min-width: 150px;
    }

    .course-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .course-card {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 13px;
      overflow: hidden;
      transition: .2s;
    }

    .course-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(0,0,0,.07);
    }

    .course-image {
      width: 100%;
      height: 175px;
      object-fit: cover;
      background: #e2e8f0;
      display: block;
    }

    .course-content {
      padding: 17px;
    }

    .top-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .badge {
      display: inline-block;
      padding: 6px 9px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: bold;
      background: #dbeafe;
      color: #1d4ed8;
      text-transform: capitalize;
    }

    .badge.completed {
      background: #dcfce7;
      color: #166534;
    }

    .badge.pending {
      background: #fef3c7;
      color: #92400e;
    }

    .category {
      color: #64748b;
      font-size: 11px;
    }

    .course-content h3 {
      font-size: 17px;
      line-height: 1.4;
      margin: 13px 0 8px;
    }

    .description {
      font-size: 13px;
      color: #64748b;
      line-height: 1.6;
      min-height: 42px;
    }

    .details {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 16px;
      padding: 13px 0;
      border-top: 1px solid #e2e8f0;
      border-bottom: 1px solid #e2e8f0;
    }

    .detail-item small {
      display: block;
      color: #94a3b8;
      font-size: 11px;
      margin-bottom: 5px;
    }

    .detail-item strong {
      font-size: 12px;
      overflow-wrap: anywhere;
    }

    .progress-info {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      margin: 15px 0 8px;
    }

    .progress-info span {
      color: #64748b;
    }

    .progress-bar {
      width: 100%;
      height: 7px;
      background: #e2e8f0;
      border-radius: 20px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: #2563eb;
      border-radius: 20px;
    }

    .course-footer {
      margin-top: 17px;
    }

    .continue-btn {
      display: block;
      width: 100%;
      text-align: center;
      text-decoration: none;
      background: #2563eb;
      color: white;
      padding: 12px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: bold;
    }

    .continue-btn:hover {
      background: #1d4ed8;
    }

    .loading,
    .empty-state,
    .error-state {
      background: white;
      padding: 35px 20px;
      text-align: center;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      color: #64748b;
      line-height: 1.7;
      grid-column: 1 / -1;
    }

    .empty-state h3 {
      color: #0f172a;
      margin-bottom: 8px;
    }

    .empty-state a {
      display: inline-block;
      margin-top: 15px;
      padding: 11px 18px;
      background: #2563eb;
      color: white;
      text-decoration: none;
      border-radius: 8px;
    }

    .error-state button {
      margin-top: 15px;
      padding: 11px 18px;
      border: 0;
      border-radius: 8px;
      color: white;
      background: #2563eb;
      cursor: pointer;
    }

    footer {
      text-align: center;
      padding: 25px;
      color: #94a3b8;
      font-size: 12px;
      margin-top: 40px;
    }

    @media(max-width: 900px) {
      .course-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media(max-width: 600px) {
      header {
        padding: 14px 4%;
      }

      .brand {
        font-size: 17px;
      }

      .header-actions a,
      .header-actions button {
        padding: 8px;
        font-size: 11px;
      }

      main {
        margin-top: 23px;
      }

      .welcome h1 {
        font-size: 24px;
      }

      .stats {
        gap: 8px;
      }

      .stat-card {
        padding: 14px 10px;
      }

      .stat-card h2 {
        font-size: 23px;
      }

      .stat-card p {
        font-size: 11px;
      }

      .course-grid {
        grid-template-columns: 1fr;
      }

      .filters {
        flex-direction: column;
      }

      .filters input,
      .filters select {
        width: 100%;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="brand">VORIX <span>COURSE</span></div>

  <div class="header-actions">
    <a href="course-dashboard.html">Dashboard</a>
    <button id="logoutBtn">Logout</button>
  </div>
</header>

<main>

  <section class="welcome">
    <h1>My Courses</h1>
    <p id="welcomeText">
      Access your enrolled courses and continue learning.
    </p>
  </section>

  <section class="stats">

    <div class="stat-card">
      <p>Enrolled Courses</p>
      <h2 id="totalCourses">0</h2>
    </div>

    <div class="stat-card">
      <p>In Progress</p>
      <h2 id="inProgress">0</h2>
    </div>

    <div class="stat-card">
      <p>Completed</p>
      <h2 id="completedCourses">0</h2>
    </div>

  </section>

  <section>

    <div class="section-heading">
      <h2>Your Learning</h2>
      <a href="courses.html">Explore Courses →</a>
    </div>

    <div class="filters">
      <input
        type="search"
        id="searchInput"
        placeholder="Search course title, category or instructor..."
      >

      <select id="statusFilter">
        <option value="all">All Courses</option>
        <option value="active">In Progress</option>
        <option value="completed">Completed</option>
        <option value="pending">Pending</option>
      </select>
    </div>

    <div id="courseGrid" class="course-grid">
      <div class="loading">Loading your courses...</div>
    </div>

  </section>

</main>

<footer>
  © <span id="year"></span> Vorix Course. All rights reserved.
</footer>


<script type="module">

  import { initializeApp }
    from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

  import {
    getAuth,
    onAuthStateChanged,
    signOut
  } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

  import {
    getFirestore,
    doc,
    getDoc,
    collection,
    query,
    where,
    getDocs
  } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


  // FIREBASE CONFIGURATION
  const firebaseConfig = {
    apiKey: "AIzaSyDaJ0LKede-fz0MTZl-V1SxZ4Ps0IETepE",
    authDomain: "vorix-course.firebaseapp.com",
    projectId: "vorix-course",
    storageBucket: "vorix-course.firebasestorage.app",
    messagingSenderId: "277814413742",
    appId: "1:277814413742:web:fb4515f03591ea07c7603f",
    measurementId: "G-SQ6PN704M7"
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);

  const courseGrid = document.getElementById("courseGrid");

  let allCourses = [];


  document.getElementById("year").textContent =
    new Date().getFullYear();


  // SAFE HTML OUTPUT
  function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, char => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#039;"
    })[char]);
  }


  // FORMAT DATE
  function formatDate(value) {
    if (!value) return "Not available";

    const date = value.toDate
      ? value.toDate()
      : new Date(value);

    return isNaN(date.getTime())
      ? "Not available"
      : date.toLocaleDateString();
  }


  // ENROLLMENT STATUS
  function normalizeStatus(status) {
    const value = String(status || "active").toLowerCase();

    if (["completed", "complete"].includes(value)) {
      return "completed";
    }

    if (["pending", "awaiting_payment"].includes(value)) {
      return "pending";
    }

    return "active";
  }


  // PRICE FORMAT
  function formatPrice(price) {
    if (price === undefined || price === null || price === "") {
      return "Not specified";
    }

    if (Number(price) === 0) return "Free";

    if (typeof price === "number") {
      return price.toLocaleString();
    }

    return String(price);
  }


  // RENDER COURSE CARDS
  function renderCourses() {

    const search = document.getElementById("searchInput")
      .value.toLowerCase().trim();

    const filter = document.getElementById("statusFilter").value;

    const filtered = allCourses.filter(course => {

      const searchable = [
        course.title,
        course.description,
        course.category,
        course.instructorName,
        course.level
      ].join(" ").toLowerCase();

      const matchesSearch = searchable.includes(search);

      const matchesStatus =
        filter === "all" || course.status === filter;

      return matchesSearch && matchesStatus;
    });


    if (!filtered.length) {
      courseGrid.innerHTML = `
        <div class="empty-state">
          <h3>No Courses Found</h3>
          <p>No enrolled courses match your search or filter.</p>
          <a href="courses.html">Explore Courses</a>
        </div>
      `;
      return;
    }


    courseGrid.innerHTML = filtered.map(course => {

      const progress = Math.max(
        0,
        Math.min(100, Number(course.progress) || 0)
      );

      const badgeClass =
        course.status === "completed"
          ? "completed"
          : course.status === "pending"
            ? "pending"
            : "";

      const buttonText =
        course.status === "completed"
          ? "Review Course"
          : course.status === "pending"
            ? "View Course"
            : "Continue Learning";

      const image = course.imageURL ||
        "https://placehold.co/600x350/e2e8f0/334155?text=Course";

      const courseURL =
        "course-details.html?id=" +
        encodeURIComponent(course.courseId);

      return `

        <article class="course-card">

          <img
            class="course-image"
            src="${escapeHTML(image)}"
            alt="${escapeHTML(course.title)}"
            loading="lazy"
            onerror="this.onerror=null;this.src='https://placehold.co/600x350/e2e8f0/334155?text=Course';"
          >

          <div class="course-content">

            <div class="top-meta">
              <span class="badge ${badgeClass}">
                ${escapeHTML(course.status)}
              </span>

              <span class="category">
                ${escapeHTML(course.category)}
              </span>
            </div>

            <h3>${escapeHTML(course.title)}</h3>

            <p class="description">
              ${escapeHTML(course.description)}
            </p>

            <div class="details">

              <div class="detail-item">
                <small>Instructor</small>
                <strong>${escapeHTML(course.instructorName)}</strong>
              </div>

              <div class="detail-item">
                <small>Level</small>
                <strong>${escapeHTML(course.level)}</strong>
              </div>

              <div class="detail-item">
                <small>Duration</small>
                <strong>${escapeHTML(course.duration)}</strong>
              </div>

              <div class="detail-item">
                <small>Price</small>
                <strong>${escapeHTML(formatPrice(course.price))}</strong>
              </div>

            </div>

            <div class="progress-info">
              <span>Learning Progress</span>
              <strong>${progress}%</strong>
            </div>

            <div class="progress-bar">
              <div class="progress-fill"
                style="width:${progress}%">
              </div>
            </div>

            <div class="progress-info">
              <span>Enrolled Date</span>
              <span>${escapeHTML(formatDate(course.enrolledAt))}</span>
            </div>

            <div class="course-footer">
              <a class="continue-btn" href="${courseURL}">
                ${buttonText}
              </a>
            </div>

          </div>

        </article>

      `;

    }).join("");

  }


  // LOAD ENROLLED COURSES FROM FIRESTORE
  async function loadMyCourses(user) {

    courseGrid.innerHTML =
      '<div class="loading">Loading your enrolled courses...</div>';

    try {

      // 1. READ USER PROFILE
      const userRef = doc(db, "users", user.uid);
      const userSnap = await getDoc(userRef);

      if (userSnap.exists()) {

        const profile = userSnap.data();

        if (
          profile.status &&
          !["active", "approved"].includes(
            String(profile.status).toLowerCase()
          )
        ) {
          await signOut(auth);
          window.location.replace("course-login.html");
          return;
        }

        const displayName =
          profile.fullName ||
          profile.displayName ||
          user.displayName ||
          "Learner";

        document.getElementById("welcomeText").textContent =
          `Welcome, ${displayName}. Continue your learning journey.`;

      }


      // 2. READ USER ENROLLMENTS
      const enrollmentQuery = query(
        collection(db, "enrollments"),
        where("userId", "==", user.uid)
      );

      const enrollmentSnapshot =
        await getDocs(enrollmentQuery);


      // 3. GET COURSE DETAILS USING courseId
      const results = await Promise.all(
        enrollmentSnapshot.docs.map(async enrollmentDoc => {

          const enrollment = enrollmentDoc.data();

          const courseId = enrollment.courseId;

          if (!courseId) return null;

          const courseRef = doc(db, "courses", courseId);

          const courseSnap = await getDoc(courseRef);

          if (!courseSnap.exists()) return null;

          const courseData = courseSnap.data();

          return {

            enrollmentId: enrollmentDoc.id,

            courseId: courseId,

            // COURSE COLLECTION DATA
            title:
              courseData.title ||
              courseData.courseTitle ||
              courseData.name ||
              "Untitled Course",

            description:
              courseData.description ||
              courseData.shortDescription ||
              "No course description available.",

            imageURL:
              courseData.imageURL ||
              courseData.thumbnailURL ||
              courseData.thumbnail ||
              courseData.coverImage ||
              "",

            category:
              courseData.category ||
              courseData.categoryName ||
              "General",

            level:
              courseData.level ||
              courseData.difficulty ||
              "All Levels",

            instructorName:
              courseData.instructorName ||
              courseData.instructor ||
              courseData.teacherName ||
              "Instructor",

            duration:
              courseData.duration ||
              courseData.courseDuration ||
              "Not specified",

            price:
              courseData.price ?? 0,

            courseStatus:
              courseData.status || "published",

            // ENROLLMENT COLLECTION DATA
            progress:
              enrollment.progress ?? 0,

            status:
              normalizeStatus(enrollment.status),

            enrolledAt:
              enrollment.enrolledAt || null

          };

        })
      );


      allCourses = results.filter(Boolean);


      // 4. UPDATE STATISTICS
      document.getElementById("totalCourses").textContent =
        allCourses.length;

      document.getElementById("inProgress").textContent =
        allCourses.filter(
          course => course.status === "active"
        ).length;

      document.getElementById("completedCourses").textContent =
        allCourses.filter(
          course => course.status === "completed"
        ).length;


      // 5. DISPLAY RESULTS
      if (allCourses.length === 0) {

        courseGrid.innerHTML = `
          <div class="empty-state">
            <h3>Start Your Learning Journey</h3>
            <p>
              You have not enrolled in any available courses yet.
              Explore our courses and start learning today.
            </p>
            <a href="courses.html">Explore Courses</a>
          </div>
        `;

        return;
      }

      renderCourses();

    } catch (error) {

      console.error("My Courses Error:", error);

      courseGrid.innerHTML = `
        <div class="error-state">
          <strong>Unable to Load Your Courses</strong>
          <p>
            Please check your internet connection,
            Firestore permissions and course data.
          </p>
          <button id="retryBtn">Try Again</button>
        </div>
      `;

      document.getElementById("retryBtn")
        ?.addEventListener("click", () => loadMyCourses(user));

    }

  }


  // SEARCH AND FILTER
  document.getElementById("searchInput")
    .addEventListener("input", renderCourses);

  document.getElementById("statusFilter")
    .addEventListener("change", renderCourses);


  // LOGOUT
  document.getElementById("logoutBtn")
    .addEventListener("click", async () => {

      try {
        await signOut(auth);
        window.location.replace("course-login.html");

      
catch (error) {
  console.error("Logout Error:", error);
  alert("Unable to sign out. Please try again.");
}

});

// AUTHENTICATION
onAuthStateChanged(auth, async (user) => {

  if (!user) {
    window.location.replace("course-login.html");
    return;
  }

  await loadMyCourses(user);

});

</script>

</body>
</html>
