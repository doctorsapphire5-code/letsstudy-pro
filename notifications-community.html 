<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Notifications | LetsStudy Pro</title>

<meta name="description"
content="View and manage your LetsStudy Pro community notifications.">

<meta name="robots" content="noindex,nofollow">

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0
}

body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
  line-height:1.5
}

header{
  background:#fff;
  border-bottom:1px solid #e5e7eb;
  padding:15px 6%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  position:sticky;
  top:0;
  z-index:20
}

.logo{
  color:#172033;
  text-decoration:none;
  font-size:21px;
  font-weight:800
}

.logo span{
  color:#2563eb
}

.back{
  border:0;
  background:#eef2f7;
  padding:9px 14px;
  border-radius:8px;
  cursor:pointer
}

.container{
  width:92%;
  max-width:850px;
  margin:28px auto
}

.hero{
  background:#fff;
  border-radius:17px;
  padding:25px;
  margin-bottom:15px
}

.hero h1{
  font-size:29px;
  margin-bottom:6px
}

.hero p{
  color:#64748b;
  font-size:13px
}

.toolbar{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:13px;
  padding:12px;
  display:flex;
  gap:8px;
  margin-bottom:15px
}

.search{
  flex:1;
  padding:11px 13px;
  border:1px solid #dbe2ea;
  border-radius:8px;
  outline:none
}

select{
  padding:10px;
  border:1px solid #dbe2ea;
  border-radius:8px;
  background:#fff
}

.mark-all{
  border:0;
  background:#2563eb;
  color:#fff;
  padding:10px 13px;
  border-radius:8px;
  cursor:pointer;
  font-weight:700;
  white-space:nowrap
}

.list{
  display:flex;
  flex-direction:column;
  gap:9px
}

.notification{
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:13px;
  padding:15px;
  display:flex;
  gap:12px;
  position:relative
}

.notification.unread{
  border-left:4px solid #2563eb;
  background:#f8fbff
}

.icon{
  width:40px;
  height:40px;
  min-width:40px;
  border-radius:50%;
  background:#eff6ff;
  color:#2563eb;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:18px
}

.body{
  flex:1;
  min-width:0
}

.title{
  font-size:14px;
  font-weight:800;
  margin-bottom:4px
}

.message{
  font-size:13px;
  color:#64748b;
  overflow-wrap:anywhere
}

.time{
  display:block;
  color:#94a3b8;
  font-size:10px;
  margin-top:7px
}

.actions{
  display:flex;
  gap:6px;
  margin-top:9px
}

.action{
  border:0;
  background:#eef2f7;
  color:#172033;
  padding:6px 9px;
  border-radius:7px;
  font-size:10px;
  cursor:pointer;
  text-decoration:none
}

.action.primary{
  background:#2563eb;
  color:#fff
}

.loading,
.empty,
.error{
  background:#fff;
  border-radius:15px;
  padding:55px 20px;
  text-align:center;
  color:#64748b
}

.error{
  color:#b91c1c
}

@media(max-width:650px){

  .toolbar{
    flex-direction:column
  }

  .mark-all,
  select{
    width:100%
  }

  .hero h1{
    font-size:25px
  }
}
</style>
</head>

<body>

<header>

  <a href="index.html" class="logo">
    LetsStudy <span>Pro</span>
  </a>

  <button
    class="back"
    onclick="history.back()"
  >
    Back
  </button>

</header>


<main class="container">

  <section class="hero">

    <h1>
      Notifications
      <span
        id="unreadCount"
        style="color:#2563eb"
      >
        0
      </span>
    </h1>

    <p>
      Stay updated with your community activity,
      messages, groups and learning activity.
    </p>

  </section>


  <section class="toolbar">

    <input
      id="search"
      class="search"
      type="search"
      placeholder="Search notifications..."
      autocomplete="off"
    >


    <select id="filter">

      <option value="all">
        All
      </option>

      <option value="unread">
        Unread
      </option>

      <option value="read">
        Read
      </option>

    </select>


    <button
      id="markAll"
      class="mark-all"
    >
      Mark all read
    </button>

  </section>


  <section
    id="list"
    class="list"
  >

    <div class="loading">
      Loading notifications...
    </div>

  </section>

</main>


<script>

/*
==================================================
NOTIFICATIONS-COMMUNITY.HTML

USER:

localStorage.userId

OR:

notifications-community.html?userId=USER_ID


GET:

/api/community/notifications?userId=USER_ID


PATCH:

/api/community/notifications/:id/read


POST:

/api/community/notifications/read-all


EXPECTED NOTIFICATION:

{
  id:"",
  title:"",
  message:"",
  type:"message",
  read:false,
  createdAt:"",
  link:"",
  senderName:"",
  senderId:""
}

NO DIRECT FIREBASE
==================================================
*/


const params =
  new URLSearchParams(
    location.search
  );


const userId =
  params.get("userId") ||
  localStorage.getItem(
    "userId"
  ) ||
  "";


const list =
  document.getElementById(
    "list"
  );

const search =
  document.getElementById(
    "search"
  );

const filter =
  document.getElementById(
    "filter"
  );

const unreadCount =
  document.getElementById(
    "unreadCount"
  );

const markAll =
  document.getElementById(
    "markAll"
  );


let notifications = [];


/* =========================
   START
========================= */

if(!userId){

  showError(
    "Please sign in to view your notifications."
  );

}else{

  loadNotifications();

}


/* =========================
   LOAD
========================= */

async function loadNotifications(){

  try{

    const response =
      await fetch(
        "/api/community/notifications?userId=" +
        encodeURIComponent(
          userId
        )
      );


    const result =
      await response.json();


    if(!response.ok){

      throw new Error(
        result.error ||
        "Unable to load notifications."
      );

    }


    notifications =
      Array.isArray(
        result.notifications
      )
      ? result.notifications
      : Array.isArray(
          result.results
        )
        ? result.results
        : [];


    render();

  }catch(error){

    console.error(
      "NOTIFICATIONS:",
      error
    );


    showError(
      error.message
    );

  }

}


/* =========================
   RENDER
========================= */

function render(){

  const keyword =
    search.value
      .trim()
      .toLowerCase();


  const selected =
    filter.value;


  const unread =
    notifications.filter(
      notification =>
        !isRead(
          notification
        )
    ).length;


  unreadCount.textContent =
    unread;


  const filtered =
    notifications.filter(
      notification => {

        const title =
          notification.title ||
          "";


        const message =
          notification.message ||
          notification.body ||
          "";


        const text =
          (
            title +
            " " +
            message
          ).toLowerCase();


        const read =
          isRead(
            notification
          );


        return (

          (
            !keyword ||
            text.includes(
              keyword
            )
          )

          &&

          (
            selected === "all" ||
            (
              selected === "unread" &&
              !read
            ) ||
            (
              selected === "read" &&
              read
            )
          )

        );

      }
    );


  if(!filtered.length){

    list.innerHTML = `

      <div class="empty">

        ${
          notifications.length
          ? "No matching notifications."
          : "You have no notifications yet."
        }

      </div>

    `;

    return;

  }


  list.innerHTML =
    filtered
      .map(
        createNotification
      )
      .join("");


  bindActions();

}


/* =========================
   CREATE
========================= */

function createNotification(
  notification
){

  const id =
    notification.id ||
    notification.documentId ||
    "";


  const title =
    notification.title ||
    notification.type ||
    "Notification";


  const message =
    notification.message ||
    notification.body ||
    "";


  const read =
    isRead(
      notification
    );


  const icon =
    getIcon(
      notification.type
    );


  const link =
    notification.link ||
    "";


  return `

    <article
      class="notification ${
        read
        ? ""
        : "unread"
      }"
      data-id="${escapeAttr(id)}"
    >

      <div class="icon">

        ${icon}

      </div>


      <div class="body">

        <div class="title">

          ${escapeHTML(
            title
          )}

        </div>


        <div class="message">

          ${escapeHTML(
            message
          )}

        </div>


        ${
          notification.senderName
          ? `

            <div
              style="
                font-size:10px;
                color:#64748b;
                margin-top:5px
              "
            >

              From:
              ${escapeHTML(
                notification.senderName
              )}

            </div>

          `
          : ""
        }


        <span class="time">

          ${escapeHTML(
            formatDate(
              notification.createdAt ||
              notification.timestamp
            )
          )}

        </span>


        <div class="actions">

          ${
            link
            ? `

              <a
                class="action primary open"
                href="${safeLink(
                  link
                )}"
                data-id="${escapeAttr(id)}"
              >
                Open
              </a>

            `
            : ""
          }


          ${
            !read
            ? `

              <button
                class="action mark-read"
                data-id="${escapeAttr(id)}"
              >
                Mark as read
              </button>

            `
            : ""
          }

        </div>

      </div>

    </article>

  `;

}


/* =========================
   ACTIONS
========================= */

function bindActions(){

  document
    .querySelectorAll(
      ".mark-read"
    )
    .forEach(
      button => {

        button.addEventListener(
          "click",
          () => {

            markRead(
              button.dataset.id
            );

          }
        );

      }
    );


  document
    .querySelectorAll(
      ".open"
    )
    .forEach(
      link => {

        link.addEventListener(
          "click",
          () => {

            markRead(
              link.dataset.id,
              true
            );

          }
        );

      }
    );

}


/* =========================
   MARK READ
========================= */

async function markRead(
  id,
  silent = false
){

  if(!id)
    return;


  try{

    const response =
      await fetch(
        "/api/community/notifications/" +
        encodeURIComponent(id) +
        "/read",
        {
          method:"PATCH",
          headers:{
            "Content-Type":
              "application/json"
          },
          body:JSON.stringify({
            userId:userId
          })
        }
      );


    if(!response.ok){

      throw new Error(
        "Unable to mark notification as read."
      );

    }


    const notification =
      notifications.find(
        item =>
          (
            item.id ||
            item.documentId
          ) === id
      );


    if(notification){

      notification.read =
        true;

    }


    render();

  }catch(error){

    console.error(
      error
    );

    if(!silent){

      alert(
        error.message
      );

    }

  }

}


/* =========================
   MARK ALL
========================= */

markAll.addEventListener(
  "click",
  async () => {

    markAll.disabled =
      true;


    try{

      const response =
        await fetch(
          "/api/community/notifications/read-all",
          {
            method:"POST",
            headers:{
              "Content-Type":
                "application/json"
            },
            body:JSON.stringify({
              userId:userId
            })
          }
        );


      if(!response.ok){

        throw new Error(
          "Unable to mark all notifications as read."
        );

      }


      notifications.forEach(
        notification => {

          notification.read =
            true;

        }
      );


      render();

    }catch(error){

      alert(
        error.message
      );

    }finally{

      markAll.disabled =
        false;

    }

  }
);


/* =========================
   FILTER
========================= */

search.addEventListener(
  "input",
  render
);

filter.addEventListener(
  "change",
  render
);


/* =========================
   REFRESH
========================= */

setInterval(
  loadNotifications,
  30000
);


/* =========================
   READ CHECK
========================= */

function isRead(
  notification
){

  return (
    notification.read === true ||
    notification.isRead === true ||
    notification.status === "read"
  );

}


/* =========================
   ICON
========================= */

function getIcon(
  type
){

  switch(
    String(
      type || ""
    ).toLowerCase()
  ){

    case "message":
      return "💬";

    case "comment":
      return "💭";

    case "like":
      return "♥";

    case "follow":
      return "👤";

    case "group":
      return "👥";

    case "course":
      return "📚";

    case "event":
      return "📅";

    case "assignment":
      return "📝";

    case "certificate":
      return "🏆";

    default:
      return "🔔";

  }

}


/* =========================
   DATE
========================= */

function formatDate(
  value
){

  if(!value)
    return "";


  const date =
    new Date(value);


  if(
    Number.isNaN(
      date.getTime()
    )
  ){

    return "";

  }


  return date.toLocaleString(
    undefined,
    {
      month:"short",
      day:"numeric",
      hour:"2-digit",
      minute:"2-digit"
    }
  );

}


/* =========================
   SAFE LINK
========================= */

function safeLink(
  url
){

  try{

    const parsed =
      new URL(
        url,
        location.origin
      );


    if(
      parsed.protocol ===
      "http:" ||
      parsed.protocol ===
      "https:"
    ){

      return escapeAttr(
        parsed.href
      );

    }

  }catch{}

  return "#";

}


/* =========================
   ERROR
========================= */

function showError(
  message
){

  list.className =
    "error";


  list.innerHTML = `

    <h2>
      Notifications
    </h2>

    <p style="margin-top:10px">

      ${escapeHTML(
        message
      )}

    </p>

  `;

}


/* =========================
   SECURITY
========================= */

function escapeHTML(
  value
){

  return String(
    value ?? ""
  )
  .replace(/&/g,"&amp;")
  .replace(/</g,"&lt;")
  .replace(/>/g,"&gt;")
  .replace(/"/g,"&quot;")
  .replace(/'/g,"&#039;");

}


function escapeAttr(
  value
){

  return escapeHTML(
    value
  ).replace(
    /`/g,
    "&#096;"
  );

}

</script>

</body>
</html>