<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
>

<title>Notifications | Let'sStudy Pro Community</title>

<meta
  name="description"
  content="Community notifications on Let'sStudy Pro."
>

<link
  rel="icon"
  href="/favicon.ico"
>

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

:root{
  --bg:#f6f8fb;
  --card:#ffffff;
  --text:#172033;
  --muted:#64748b;
  --border:#e2e8f0;
  --soft:#f1f5f9;
  --primary:#111827;
  --unread:#eff6ff;
}

body{
  min-height:100vh;

  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  background:var(--bg);
  color:var(--text);
}


/* =========================
   HEADER
========================= */

.topbar{
  position:sticky;
  top:0;
  z-index:100;

  min-height:64px;

  display:flex;
  align-items:center;
  justify-content:space-between;

  padding:0 18px;

  background:
    rgba(255,255,255,.96);

  backdrop-filter:blur(12px);

  border-bottom:
    1px solid var(--border);
}

.brand{
  display:flex;
  align-items:center;

  gap:10px;

  font-size:14px;
  font-weight:850;
}

.brand-icon{
  width:38px;
  height:38px;

  display:flex;
  align-items:center;
  justify-content:center;

  border-radius:11px;

  background:var(--primary);
  color:#fff;
}

.back-btn{
  border:0;

  padding:9px 13px;

  border-radius:9px;

  background:var(--soft);

  color:var(--text);

  font-family:inherit;

  font-size:11px;
  font-weight:800;

  cursor:pointer;
}


/* =========================
   MAIN
========================= */

.container{
  width:100%;
  max-width:800px;

  margin:auto;

  padding:
    28px 15px
    70px;
}

.heading{
  display:flex;
  align-items:center;
  justify-content:space-between;

  gap:15px;

  margin-bottom:20px;
}

.heading h1{
  font-size:27px;
  font-weight:850;
}

.heading p{
  margin-top:5px;

  color:var(--muted);

  font-size:12px;
}

.read-all{
  border:0;

  padding:9px 11px;

  border-radius:9px;

  background:var(--primary);

  color:#fff;

  font-family:inherit;

  font-size:10px;
  font-weight:800;

  cursor:pointer;
}

.read-all:disabled{
  opacity:.5;
  cursor:not-allowed;
}


/* =========================
   LIST
========================= */

.notifications{
  display:flex;

  flex-direction:column;

  gap:8px;
}

.notification{
  width:100%;

  display:flex;

  align-items:flex-start;

  gap:12px;

  padding:14px;

  border:
    1px solid var(--border);

  border-radius:14px;

  background:var(--card);

  cursor:pointer;

  transition:
    transform .15s ease,
    box-shadow .15s ease;
}

.notification:hover{
  transform:translateY(-1px);

  box-shadow:
    0 5px 18px
    rgba(15,23,42,.05);
}

.notification.unread{
  background:var(--unread);

  border-color:
    #dbeafe;
}

.actor{
  width:44px;
  height:44px;

  flex-shrink:0;

  display:flex;

  align-items:center;
  justify-content:center;

  overflow:hidden;

  border-radius:50%;

  background:var(--soft);

  font-size:12px;
  font-weight:850;
}

.actor img{
  width:100%;
  height:100%;

  object-fit:cover;
}

.content{
  min-width:0;

  flex:1;
}

.top{
  display:flex;

  align-items:flex-start;

  justify-content:space-between;

  gap:10px;
}

.title{
  font-size:12px;
  font-weight:850;

  line-height:1.4;
}

.time{
  flex-shrink:0;

  color:var(--muted);

  font-size:8px;
}

.message{
  margin-top:4px;

  color:var(--muted);

  font-size:11px;

  line-height:1.5;
}

.type{
  display:inline-block;

  margin-top:7px;

  padding:
    3px 7px;

  border-radius:6px;

  background:var(--soft);

  color:var(--muted);

  font-size:8px;

  font-weight:800;

  text-transform:capitalize;
}

.dot{
  width:7px;
  height:7px;

  flex-shrink:0;

  margin-top:5px;

  border-radius:50%;

  background:#2563eb;
}


/* =========================
   EMPTY
========================= */

.empty{
  display:none;

  padding:60px 20px;

  text-align:center;

  border:
    1px solid var(--border);

  border-radius:15px;

  background:#fff;
}

.empty-icon{
  margin-bottom:10px;

  font-size:42px;
}

.empty h2{
  font-size:16px;
}

.empty p{
  margin-top:5px;

  color:var(--muted);

  font-size:11px;
}


/* =========================
   LOADING
========================= */

.loading{
  padding:55px;

  text-align:center;

  color:var(--muted);

  font-size:11px;
}

.spinner{
  width:30px;
  height:30px;

  margin:
    0 auto
    10px;

  border:
    3px solid var(--border);

  border-top-color:
    var(--primary);

  border-radius:50%;

  animation:
    spin .7s linear infinite;
}

@keyframes spin{

  to{
    transform:rotate(360deg);
  }

}


/* =========================
   ERROR
========================= */

.error{
  display:none;

  margin-bottom:15px;

  padding:11px 13px;

  border:
    1px solid #fecaca;

  border-radius:10px;

  background:#fef2f2;

  color:#b91c1c;

  font-size:11px;
}

.error.show{
  display:block;
}


/* =========================
   MOBILE
========================= */

@media(max-width:600px){

  .topbar{
    padding:0 11px;
  }

  .brand{
    font-size:12px;
  }

  .container{
    padding:
      22px 10px
      60px;
  }

  .heading{
    align-items:flex-start;
  }

  .heading h1{
    font-size:24px;
  }

  .read-all{
    font-size:9px;
  }

  .notification{
    padding:12px;
  }

  .actor{
    width:42px;
    height:42px;
  }

}

</style>

</head>


<body>


<header class="topbar">

  <div class="brand">

    <div class="brand-icon">
      🔔
    </div>

    <span>
      Let'sStudy Pro Community
    </span>

  </div>


  <button
    class="back-btn"
    type="button"
    onclick="goBack()"
  >
    ← Back
  </button>

</header>


<main class="container">


  <section class="heading">

    <div>

      <h1>
        Notifications
      </h1>

      <p>
        Your Community activity and updates.
      </p>

    </div>


    <button
      id="readAllBtn"
      class="read-all"
      type="button"
      onclick="markAllAsRead()"
    >
      Mark all read
    </button>

  </section>


  <div
    id="error"
    class="error"
  ></div>


  <div
    id="loading"
    class="loading"
  >

    <div class="spinner"></div>

    <p>
      Loading notifications...
    </p>

  </div>


  <section
    id="notifications"
    class="notifications"
  ></section>


  <section
    id="empty"
    class="empty"
  >

    <div class="empty-icon">
      🔔
    </div>

    <h2>
      No notifications
    </h2>

    <p>
      Community notifications will appear here.
    </p>

  </section>


</main>


<script src="https://www.gstatic.com/firebasejs/10.12.5/firebase-app-compat.js"></script>

<script src="https://www.gstatic.com/firebasejs/10.12.5/firebase-auth-compat.js"></script>

<script src="https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore-compat.js"></script>


<script>

/* =========================
   FIREBASE CONFIG
========================= */

const firebaseConfig = {

  apiKey:
    "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-85B7V5H5J0"

};


firebase.initializeApp(
  firebaseConfig
);


const db =
  firebase.firestore();

const auth =
  firebase.auth();


/* =========================
   STATE
========================= */

let currentUser =
  null;

let notifications =
  [];

let unsubscribe =
  null;


/* =========================
   HELPERS
========================= */

function escapeHTML(
  value
){

  return String(
    value ?? ""
  )
  .replaceAll(
    "&",
    "&amp;"
  )
  .replaceAll(
    "<",
    "&lt;"
  )
  .replaceAll(
    ">",
    "&gt;"
  )
  .replaceAll(
    '"',
    "&quot;"
  )
  .replaceAll(
    "'",
    "&#039;"
  );

}


function getInitials(
  name
){

  return String(
    name ||
    "Member"
  )
  .trim()
  .split(/\s+/)
  .slice(0,2)
  .map(
    word =>
      word
        .charAt(0)
        .toUpperCase()
  )
  .join("");

}


function formatTime(
  timestamp
){

  if(!timestamp){

    return "Recently";

  }


  try{

    const date =
      timestamp.toDate
        ? timestamp.toDate()
        : new Date(timestamp);


    const now =
      new Date();


    const diff =
      now.getTime() -
      date.getTime();


    const minute =
      60 * 1000;

    const hour =
      60 * minute;

    const day =
      24 * hour;


    if(diff < minute){

      return "Now";

    }


    if(diff < hour){

      return `${Math.floor(
        diff / minute
      )}m`;

    }


    if(diff < day){

      return `${Math.floor(
        diff / hour
      )}h`;

    }


    if(diff < 7 * day){

      return `${Math.floor(
        diff / day
      )}d`;

    }


    return date.toLocaleDateString(
      undefined,
      {
        day:"numeric",
        month:"short"
      }
    );

  }

  catch{

    return "Recently";

  }

}


function showError(
  message
){

  const element =
    document.getElementById(
      "error"
    );

  element.textContent =
    message;

  element.classList.add(
    "show"
  );

}


/* =========================
   AUTH
========================= */

auth.onAuthStateChanged(
  user => {

    currentUser =
      user;


    if(!user){

      document.getElementById(
        "loading"
      ).style.display =
        "none";

      showError(
        "Please sign in to view notifications."
      );

      return;

    }


    listenForNotifications();

  }
);


/* =========================
   REALTIME LISTENER
========================= */

function listenForNotifications(){

  if(unsubscribe){

    unsubscribe();

  }


  unsubscribe =
    db
      .collection(
        "notifications"
      )
      .where(
        "userId",
        "==",
        currentUser.uid
      )
      .orderBy(
        "createdAt",
        "desc"
      )
      .onSnapshot(

        snapshot => {

          notifications =
            snapshot.docs.map(
              doc => ({

                id:
                  doc.id,

                ...doc.data()

              })
            );


          document.getElementById(
            "loading"
          ).style.display =
            "none";


          renderNotifications();

        },

        error => {

          console.error(
            "Notifications error:",
            error
          );


          document.getElementById(
            "loading"
          ).style.display =
            "none";


          showError(
            "Unable to load notifications."
          );

        }

      );

}


/* =========================
   RENDER
========================= */

function renderNotifications(){

  const container =
    document.getElementById(
      "notifications"
    );

  const empty =
    document.getElementById(
      "empty"
    );


  container.innerHTML =
    "";


  if(
    !notifications.length
  ){

    empty.style.display =
      "block";

    return;

  }


  empty.style.display =
    "none";


  notifications.forEach(
    notification => {

      createNotification(
        notification
      );

    }
  );

}


/* =========================
   CREATE NOTIFICATION
========================= */

function createNotification(
  notification
){

  const container =
    document.getElementById(
      "notifications"
    );


  const item =
    document.createElement(
      "article"
    );


  item.className =
    "notification";


  if(
    notification.isRead === false
  ){

    item.classList.add(
      "unread"
    );

  }


  const actorName =
    notification.actorName ||
    "Community Member";


  const actorPhoto =
    notification.actorPhoto ||
    "";


  const avatar =
    actorPhoto

      ? `
        <img
          src="${escapeHTML(
            actorPhoto
          )}"
          alt="${escapeHTML(
            actorName
          )}"
          loading="lazy"
          referrerpolicy="no-referrer"
        >
      `

      : escapeHTML(
          getInitials(
            actorName
          )
        );


  item.innerHTML =
    `

      <div class="actor">

        ${avatar}

      </div>


      <div class="content">

        <div class="top">

          <div class="title">

            ${escapeHTML(
              notification.title ||
              "Community notification"
            )}

          </div>


          <div class="time">

            ${escapeHTML(
              formatTime(
                notification.createdAt
              )
            )}

          </div>

        </div>


        <div class="message">

          ${escapeHTML(
            notification.message ||
            ""
          )}

        </div>


        <div class="type">

          ${escapeHTML(
            notification.type ||
            "activity"
          )}

        </div>

      </div>


      ${
        notification.isRead === false

          ? `<div class="dot"></div>`

          : ""
      }

    `;


  item.addEventListener(
    "click",
    () => {

      openNotification(
        notification
      );

    }
  );


  container.appendChild(
    item
  );

}


/* =========================
   OPEN NOTIFICATION
========================= */

async function openNotification(
  notification
){

  try{

    if(
      notification.isRead === false
    ){

      await db
        .collection(
          "notifications"
        )
        .doc(
          notification.id
        )
        .update({

          isRead:
            true

        });

    }


    const targetId =
      notification.targetId;


    const targetType =
      notification.targetType;


    if(!targetId){

      return;

    }


    if(
      targetType ===
      "post"
    ){

      window.location.href =
        `post-community.html?id=${encodeURIComponent(
          targetId
        )}`;

      return;

    }


    if(
      targetType ===
      "comment"
    ){

      window.location.href =
        `post-community.html?id=${encodeURIComponent(
          targetId
        )}`;

      return;

    }


    if(
      targetType ===
      "group"
    ){

      window.location.href =
        `group-community.html?id=${encodeURIComponent(
          targetId
        )}`;

      return;

    }


    if(
      targetType ===
      "profile"
    ){

      window.location.href =
        `profile-community.html?id=${encodeURIComponent(
          targetId
        )}`;

      return;

    }


    if(
      targetType ===
      "connection"
    ){

      window.location.href =
        `people.html?id=${encodeURIComponent(
          targetId
        )}`;

      return;

    }

  }

  catch(error){

    console.error(
      "Open notification error:",
      error
    );

  }

}


/* =========================
   MARK ALL READ
========================= */

async function markAllAsRead(){

  if(!currentUser){

    return;

  }


  const unread =
    notifications.filter(
      notification =>
        notification.isRead === false
    );


  if(!unread.length){

    return;

  }


  const button =
    document.getElementById(
      "readAllBtn"
    );


  button.disabled =
    true;


  try{

    const batch =
      db.batch();


    unread.forEach(
      notification => {

        const ref =
          db
            .collection(
              "notifications"
            )
            .doc(
              notification.id
            );


        batch.update(
          ref,
          {

            isRead:
              true

          }
        );

      }
    );


    await batch.commit();

  }

  catch(error){

    console.error(
      "Mark all read error:",
      error
    );


    showError(
      "Unable to mark notifications as read."
    );

  }

  finally{

    button.disabled =
      false;

  }

}


/* =========================
   BACK
========================= */

function goBack(){

  if(unsubscribe){

    unsubscribe();

  }


  if(
    document.referrer &&
    document.referrer.startsWith(
      window.location.origin
    )
  ){

    window.history.back();

  }

  else{

    window.location.href =
      "community.html";

  }

}


/* =========================
   CLEANUP
========================= */

window.addEventListener(
  "beforeunload",
  () => {

    if(unsubscribe){

      unsubscribe();

    }

  }
);


/* =========================
   GLOBAL ERROR
========================= */

window.addEventListener(
  "unhandledrejection",
  event => {

    console.error(
      "Unhandled Community error:",
      event.reason
    );

  }
);

</script>

</body>

</html>