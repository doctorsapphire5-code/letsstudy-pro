
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>You're Offline | LetsStudy Pro</title>
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="#0f172a">

<style>
*{box-sizing:border-box}

body{
  margin:0;
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
  font-family:Arial,sans-serif;
  background:#f1f5f9;
  color:#0f172a;
}

.container{
  width:100%;
  max-width:600px;
  padding:45px 30px;
  background:white;
  border-radius:20px;
  text-align:center;
  box-shadow:0 10px 35px rgba(15,23,42,.08);
}

.logo{
  font-size:24px;
  font-weight:bold;
  color:#2563eb;
  margin-bottom:35px;
}

.icon{
  width:100px;
  height:100px;
  display:flex;
  align-items:center;
  justify-content:center;
  margin:0 auto 25px;
  border-radius:50%;
  background:#fee2e2;
  color:#dc2626;
  font-size:45px;
}

.status{
  display:inline-block;
  padding:8px 15px;
  background:#fee2e2;
  color:#991b1b;
  border-radius:30px;
  font-size:12px;
  font-weight:bold;
  margin-bottom:15px;
}

h1{
  font-size:28px;
  margin:10px 0 15px;
}

.description{
  color:#64748b;
  font-size:15px;
  line-height:1.8;
}

.info{
  background:#eff6ff;
  border:1px solid #dbeafe;
  padding:17px;
  border-radius:12px;
  color:#1e40af;
  font-size:13px;
  line-height:1.8;
  margin:25px 0;
}

.connection{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:9px;
  font-size:13px;
  color:#64748b;
  margin:20px 0;
}

.dot{
  width:10px;
  height:10px;
  border-radius:50%;
  background:#dc2626;
}

.dot.online{background:#16a34a}

button{
  border:none;
  background:#2563eb;
  color:white;
  padding:14px 25px;
  border-radius:9px;
  font-size:14px;
  font-weight:bold;
  cursor:pointer;
}

button:hover{background:#1d4ed8}

button:disabled{
  opacity:.6;
  cursor:not-allowed;
}

.links{
  margin-top:20px;
  font-size:13px;
}

.links a{
  color:#2563eb;
  text-decoration:none;
}

footer{
  margin-top:35px;
  font-size:12px;
  color:#94a3b8;
}

@media(max-width:480px){
  .container{padding:35px 20px}
  h1{font-size:24px}
  .icon{width:85px;height:85px;font-size:38px}
}
</style>
</head>

<body>

<div class="container">

  <div class="logo">LetsStudy Pro</div>

  <div class="icon">📡</div>

  <div class="status" id="statusBadge">NO INTERNET CONNECTION</div>

  <h1>You're Offline!</h1>

  <p class="description">
    It looks like your device is not connected to the internet.
    Please check your connection and try again.
  </p>

  <div class="info">
    <strong>What can you do?</strong><br>
    • Check your Wi-Fi or mobile data.<br>
    • Turn airplane mode off.<br>
    • Move to an area with better network coverage.<br>
    • Try reconnecting to LetsStudy Pro.
  </div>

  <div class="connection">
    <span class="dot" id="connectionDot"></span>
    <span id="connectionText">Checking connection...</span>
  </div>

  <button id="retryBtn" onclick="retryConnection()">
    Try Again
  </button>

  <div class="links">
    <p><a href="/">Go to Homepage</a></p>
  </div>

  <footer>
    LetsStudy Pro · The Digital Ecosystem<br>
    Learn. Build. Work. Grow.
  </footer>

</div>

<script>
const statusBadge = document.getElementById("statusBadge");
const connectionText = document.getElementById("connectionText");
const connectionDot = document.getElementById("connectionDot");
const retryBtn = document.getElementById("retryBtn");

function updateConnectionStatus(){

  if(navigator.onLine){

    statusBadge.textContent = "NETWORK AVAILABLE";
    statusBadge.style.background = "#dcfce7";
    statusBadge.style.color = "#166534";

    connectionText.textContent = "Network connection detected";
    connectionDot.classList.add("online");

  }else{

    statusBadge.textContent = "NO INTERNET CONNECTION";
    statusBadge.style.background = "#fee2e2";
    statusBadge.style.color = "#991b1b";

    connectionText.textContent = "You are currently offline";
    connectionDot.classList.remove("online");

  }
}

function retryConnection(){

  retryBtn.disabled = true;
  retryBtn.textContent = "Checking...";

  updateConnectionStatus();

  if(navigator.onLine){
    location.reload();
  }else{
    connectionText.textContent = "Still offline. Check your internet connection.";
    retryBtn.disabled = false;
    retryBtn.textContent = "Try Again";
  }
}

window.addEventListener("online",()=>{
  updateConnectionStatus();
  location.reload();
});

window.addEventListener("offline",updateConnectionStatus);

updateConnectionStatus();
</script>

</body>
</html>
