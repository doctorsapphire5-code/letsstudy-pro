  margin-bottom:7px;
}

.paper-description{
  color:#64748b;

  font-size:9px;

  line-height:1.6;

  min-height:43px;

  margin-bottom:13px;
}

.paper-meta{
  color:#94a3b8;

  font-size:8px;

  margin-bottom:13px;
}

.download{
  display:block;

  text-align:center;

  padding:10px;

  border-radius:8px;

  background:#2563eb;

  color:#fff;

  font-size:9px;
  font-weight:800;
}

.download:hover{
  background:#1d4ed8;
}

.empty{
  grid-column:1/-1;

  background:#fff;

  border:1px solid #e2e8f0;

  border-radius:15px;

  padding:55px 20px;

  text-align:center;

  color:#94a3b8;

  font-size:10px;
}

.loading{
  grid-column:1/-1;

  text-align:center;

  padding:60px;

  color:#64748b;

  font-size:10px;
}

footer{
  text-align:center;

  padding:30px;

  color:#94a3b8;

  font-size:9px;
}

@media(max-width:850px){

  .grid{
    grid-template-columns:
    repeat(2,1fr);
  }

