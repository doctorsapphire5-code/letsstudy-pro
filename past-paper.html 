<script type="module">

import {
  initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";


import {
  getFirestore,
  collection,
  getDocs,
  query,
  orderBy
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


const firebaseConfig = {

  apiKey:
    "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
    "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
    "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
    "let-s-study-pro-course",

  storageBucket:
    "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
    "474928293390",

  appId:
    "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
    "G-M7Z6SPNH1N"

};


const app =
  initializeApp(
    firebaseConfig
  );


const db =
  getFirestore(
    app
  );


/* =====================================================
   ELEMENTS
===================================================== */

const grid =
  document.getElementById(
    "papersGrid"
  );

const loader =
  document.getElementById(
    "loader"
  );

const empty =
  document.getElementById(
    "empty"
  );

const count =
  document.getElementById(
    "count"
  );

const search =
  document.getElementById(
    "search"
  );

const level =
  document.getElementById(
    "level"
  );

const form =
  document.getElementById(
    "form"
  );

const subject =
  document.getElementById(
    "subject"
  );


let papers = [];


/* =====================================================
   LOAD PAPERS
===================================================== */

async function loadPapers(){

  loader.style.display =
    "block";

  grid.innerHTML =
    "";

  empty.style.display =
    "none";


  try{

    const ref =
      collection(
        db,
        "pastPapers"
      );


    const snap =
      await getDocs(
        ref
      );


    papers =
      snap.docs.map(
        doc => ({

          id:
            doc.id,

          ...doc.data()

        })
      );


    /*
     * Sort newest first.
     */

    papers.sort(
      (
        a,
        b
      ) =>
        Number(
          b.year || 0
        ) -
        Number(
          a.year || 0
        )
    );


    applyFilters();


  }catch(error){

    console.error(
      "Past papers error:",
      error
    );


    loader.style.display =
      "none";

    count.textContent =
      "Unable to load";

    empty.style.display =
      "block";

    empty.querySelector(
      "h3"
    ).textContent =
      "Unable to load papers";

    empty.querySelector(
      "p"
    ).textContent =
      "Please try again later.";

  }

}


/* =====================================================
   FILTER
===================================================== */

function applyFilters(){

  const keyword =
    search.value
      .trim()
      .toLowerCase();


  const selectedLevel =
    level.value
      .toLowerCase();


  const selectedForm =
    form.value
      .toLowerCase();


  const selectedSubject =
    subject.value
      .toLowerCase();


  const filtered =
    papers.filter(
      paper => {

        const title =
          String(
            paper.title || ""
          ).toLowerCase();


        const paperLevel =
          String(
            paper.level || ""
          ).toLowerCase();


        const paperForm =
          String(
            paper.form || ""
          ).toLowerCase();


        const paperSubject =
          String(
            paper.subject || ""
          ).toLowerCase();


        const year =
          String(
            paper.year || ""
          ).toLowerCase();


        const exam =
          String(
            paper.exam || ""
          ).toLowerCase();


        const matchesSearch =
          !keyword ||
          title.includes(
            keyword
          ) ||
          paperSubject.includes(
            keyword
          ) ||
          year.includes(
            keyword
          ) ||
          exam.includes(
            keyword
          );


        const matchesLevel =
          !selectedLevel ||
          paperLevel ===
            selectedLevel;


        const matchesForm =
          !selectedForm ||
          paperForm ===
            selectedForm;


        const matchesSubject =
          !selectedSubject ||
          paperSubject ===
            selectedSubject;


        return (
          matchesSearch &&
          matchesLevel &&
          matchesForm &&
          matchesSubject
        );

      }
    );


  renderPapers(
    filtered
  );

}


/* =====================================================
   RENDER
===================================================== */

function renderPapers(
  data
){

  loader.style.display =
    "none";

  grid.innerHTML =
    "";


  count.textContent =
    data.length +
    (
      data.length === 1
        ? " paper"
        : " papers"
    );


  if(
    data.length === 0
  ){

    empty.style.display =
      "block";

    return;

  }


  empty.style.display =
    "none";


  data.forEach(
    paper => {

      const card =
        document.createElement(
          "article"
        );


      card.className =
        "paper-card";


      const premium =
        paper.premium === true ||
        paper.access ===
          "premium";


      const title =
        escapeHTML(
          paper.title ||
          "Untitled Past Paper"
        );


      const paperSubject =
        escapeHTML(
          paper.subject ||
          "General"
        );


      const paperLevel =
        escapeHTML(
          paper.level ||
          "—"
        );


      const paperForm =
        escapeHTML(
          paper.form ||
          "—"
        );


      const year =
        escapeHTML(
          paper.year ||
          "—"
        );


      const exam =
        escapeHTML(
          paper.exam ||
          "Past Paper"
        );


      const viewUrl =
        paper.viewUrl ||
        paper.url ||
        paper.fileUrl ||
        "#";


      const downloadUrl =
        paper.downloadUrl ||
        paper.fileUrl ||
        paper.url ||
        "#";


      card.innerHTML = `

        <div class="paper-top">

          <div class="paper-icon">
            📄
          </div>

          ${
            premium
              ? `
                <span class="premium">
                  ⭐ PREMIUM
                </span>
              `
              : ""
          }

        </div>


        <h3>
          ${title}
        </h3>


        <div class="paper-meta">

          <span class="tag">
            ${paperSubject}
          </span>

          <span class="tag">
            ${paperForm}
          </span>

          <span class="tag">
            ${year}
          </span>

        </div>


        <p>
          ${exam}
          examination paper.
          Practice questions and prepare
          effectively for your exams.
        </p>


        <div class="actions">

          <a
            class="action view"
            href="${safeUrl(viewUrl)}"
            target="_blank"
            rel="noopener"
          >
            👁 View
          </a>

          <a
            class="action download"
            href="${safeUrl(downloadUrl)}"
            target="_blank"
            rel="noopener"
            download
          >
            ↓ Download
          </a>

        </div>

      `;


      grid.appendChild(
        card
      );

    }
  );

}


/* =====================================================
   SEARCH
===================================================== */

search.addEventListener(
  "input",
  applyFilters
);


document
  .getElementById(
    "searchBtn"
  )
  .addEventListener(
    "click",
    applyFilters
  );


/* =====================================================
   FILTERS
===================================================== */

level.addEventListener(
  "change",
  applyFilters
);

form.addEventListener(
  "change",
  applyFilters
);

subject.addEventListener(
  "change",
  applyFilters
);


/* =====================================================
   RESET
===================================================== */

document
  .getElementById(
    "resetBtn"
  )
  .addEventListener(
    "click",
    () => {

      search.value =
        "";

      level.value =
        "";

      form.value =
        "";

      subject.value =
        "";

      applyFilters();

    }
  );


/* =====================================================
   MOBILE MENU
===================================================== */

document
  .getElementById(
    "menuBtn"
  )
  .addEventListener(
    "click",
    () => {

      const nav =
        document.querySelector(
          ".nav"
        );


      if(
        nav.style.display ===
        "flex"
      ){

        nav.style.display =
          "";

      }else{

        nav.style.display =
          "flex";

        nav.style.position =
          "absolute";

        nav.style.top =
          "68px";

        nav.style.right =
          "15px";

        nav.style.background =
          "#fff";

        nav.style.padding =
          "15px";

        nav.style.borderRadius =
          "12px";

        nav.style.boxShadow =
          "0 15px 35px rgba(0,0,0,.12)";

        nav.style.flexDirection =
          "column";

      }

    }
  );


/* =============
/* =====================================================
   FOOTER YEAR
===================================================== */

const yearElement =
  document.getElementById(
    "year"
  );

if(yearElement){

  yearElement.textContent =
    new Date().getFullYear();

}


/* =====================================================
   CLOSE MOBILE MENU
   WHEN A LINK IS CLICKED
===================================================== */

document
  .querySelectorAll(
    ".nav a"
  )
  .forEach(
    link => {

      link.addEventListener(
        "click",
        () => {

          const nav =
            document.querySelector(
              ".nav"
            );


          if(
            window.innerWidth <=
            800
          ){

            nav.style.display =
              "none";

          }

        }
      );

    }
  );


/* =====================================================
   SEARCH WITH ENTER
===================================================== */

search.addEventListener(
  "keydown",
  event => {

    if(
      event.key ===
      "Enter"
    ){

      event.preventDefault();

      applyFilters();

    }

  }
);


/* =====================================================
   ESCAPE KEY
===================================================== */

document.addEventListener(
  "keydown",
  event => {

    if(
      event.key ===
      "Escape"
    ){

      const nav =
        document.querySelector(
          ".nav"
        );


      if(
        window.innerWidth <=
        800
      ){

        nav.style.display =
          "none";

      }

    }

  }
);


/* =====================================================
   WINDOW RESIZE
===================================================== */

window.addEventListener(
  "resize",
  () => {

    const nav =
      document.querySelector(
        ".nav"
      );


    if(
      window.innerWidth >
      800
    ){

      nav.style.display =
        "flex";

      nav.style.position =
        "";

      nav.style.top =
        "";

      nav.style.right =
        "";

      nav.style.background =
