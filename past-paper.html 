<script type="module">

import {
  initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";


import {
  getDatabase,
  ref,
  get,
  update
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-database.js";


/* =========================
   FIREBASE CONFIG
========================= */

const firebaseConfig = {

  apiKey:
  "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
  "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
  "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
  "let-s-study-pro-course",

  storageBucket:
  "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
  "474928293390",

  appId:
  "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
  "G-85B7V5H5J0"

};


const app =
initializeApp(
  firebaseConfig
);

const db =
getDatabase(app);


/* =========================
   ELEMENTS
========================= */

const papersContainer =
document.getElementById(
  "papers"
);

const searchInput =
document.getElementById(
  "search"
);

const levelFilter =
document.getElementById(
  "level"
);

const subjectFilter =
document.getElementById(
  "subject"
);

const yearFilter =
document.getElementById(
  "year"
);

const status =
document.getElementById(
  "status"
);


let allPapers = [];


/* =========================
   LOAD PAPERS
========================= */

async function loadPapers(){

  try{

    const snapshot =
    await get(
      ref(
        db,
        "pastPapers"
      )
    );


    if(
      !snapshot.exists()
    ){

      renderPapers([]);

      return;

    }


    const data =
    snapshot.val();


    allPapers =
    Object.entries(
      data
    )
    .map(
      ([id,paper]) => ({

        id,

        ...paper

      })
    )
    .sort(
      (a,b) =>
      Number(
        b.year || 0
      ) -
      Number(
        a.year || 0
      )
    );


    renderPapers(
      allPapers
    );


  }catch(error){

    console.error(
      "Past papers error:",
      error
    );


    papersContainer.innerHTML = `

      <div class="empty">

        Unable to load past papers.
        Please try again.

      </div>

    `;

  }

}


/* =========================
   RENDER
========================= */

function renderPapers(
papers
){

  papersContainer.innerHTML =
  "";


  if(
    papers.length === 0
  ){

    papersContainer.innerHTML = `

      <div class="empty">

        <div style="font-size:30px;margin-bottom:10px;">
          📚
        </div>

        No past papers found.

      </div>

    `;

    return;

  }


  papers.forEach(
    paper => {

      const card =
      document.createElement(
        "article"
      );


      card.className =
      "paper-card";


      const title =
      paper.title ||
      (
        paper.subject
        ? paper.subject +
          " Past Paper"
        : "Past Paper"
      );


      const level =
      paper.level ||
      paper.form ||
      "All Levels";


      const subject =
      paper.subject ||
      "General";


      const year =
      paper.year ||
      "N/A";


      const description =
      paper.description ||
      "Practice this past examination paper to improve your preparation.";


      const downloads =
      Number(
        paper.downloads ||
        0
      );


      card.innerHTML = `

        <div class="paper-icon">
          📄
        </div>


        <div class="badges">

          <span class="badge">
            ${escapeHTML(level)}
          </span>

          <span class="badge">
            ${escapeHTML(subject)}
          </span>

          <span class="badge">
            ${escapeHTML(String(year))}
          </span>

        </div>


        <h2 class="paper-title">

          ${escapeHTML(title)}

        </h2>


        <p class="paper-description">

          ${escapeHTML(description)}

        </p>


        <div class="paper-meta">

          Downloads:
          ${downloads}

        </div>


        <a
          class="download"
          href="/download.html?id=${encodeURIComponent(paper.id)}"
          data-id="${escapeHTML(paper.id)}">

          ⬇ Download PDF

        </a>

      `;


      papersContainer.appendChild(
        card
      );

    }
  );


  document
  .querySelectorAll(
    ".download"
  )
  .forEach(
    link => {

      link.addEventListener(
        "click",
        () => {

          incrementDownload(
            link.dataset.id
          );

        }
      );

    }
  );

}


/* =========================
   FILTER
========================= */

function filterPapers(){

  const search =
  searchInput.value
  .toLowerCase()
  .trim();


  const level =
  levelFilter.value
  .toLowerCase();


  const subject =
  subjectFilter.value
  .toLowerCase();


  const year =
  yearFilter.value;


  const filtered =
  allPapers.filter(
    paper => {

      const searchable = (

        paper.title ||
        "" +

        " " +

        paper.subject ||
        "" +

        " " +

        paper.level ||
        "" +

        " " +

        paper.form ||
        "" +

        " " +

        paper.year ||
        "" +

        " " +

        paper.description ||
        ""

      ).toLowerCase();


      const paperLevel =
      (
        paper.level ||
        paper.form ||
        ""
      ).toLowerCase();


      const paperSubject =
      (
        paper.subject ||
        ""
      ).toLowerCase();


      const paperYear =
      String(
        paper.year ||
        ""
      );


      return (

        (!search ||
        searchable.includes(
          search
        ))

        &&

        (!level ||
        paperLevel === level)

        &&

        (!subject ||
        paperSubject === subject)

        &&

        (!year ||
        paperYear === year)

      );

    }
  );


  renderPapers(
    filtered
  );

}


/* =========================
   DOWNLOAD COUNTER
========================= */

async function incrementDownload(
id
){

  try{

    const paper =
    allPapers.find(
      item =>
      item.id === id
    );


    if(!paper){
      return;
    }


    const current =
    Number(
      paper.downloads ||
      0
    );


    paper.downloads =
    current + 1;


    await update(
      ref(
        db,
        "pastPapers/" +
        id
      ),
      {
        downloads:
        current + 1
      }
    );


  }catch(error){

    console.error(
      "Download counter error:",
      error
    );

  }

}


/* =========================
   ESCAPE HTML
========================= */

function escapeHTML(
value
){

  return String(
    value ?? ""
  )
  .replace(
    /&/g,
    "&amp;"
  )
  .replace(
    /</g,
    "&lt;"
  )
  .replace(
    />/g,
    "&gt;"
  )
  .replace(
    /"/g,
    "&quot;"
  )
  .replace(
    /'/g,
    "&#039;"
  );

}


/* =========================
   FILTER EVENTS
========================= */

searchInput.addEventListener(
  "input",
  filterPapers
);

levelFilter.addEventListener(
  "change",
  filterPapers
);

subjectFilter.addEventListener(
  "change",
  filterPapers
);

yearFilter.addEventListener(
  "change",
  filterPapers
);


/* =========================
   MOBILE MENU
========================= */

document
.getElementById(
"menuBtn"
)
.addEventListener(
"click",
function(){

  document
  .querySelector(
    ".nav-links"
  )
  .classList.toggle(
    "active"
  );

});


/* =========================
   START
========================= */

loadPapers();

</script>

</body>

