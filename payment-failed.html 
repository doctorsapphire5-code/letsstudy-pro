<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Payment Failed | LetsStudy Pro</title>

<meta name="description"
content="Your LetsStudy Pro payment could not be completed.">

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0
}

body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px
}

.card{
  width:100%;
  max-width:540px;
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:18px;
  padding:34px 25px;
  text-align:center;
  box-shadow:0 8px 30px rgba(15,23,42,.06)
}

.logo{
  font-size:21px;
  font-weight:800;
  margin-bottom:25px
}

.logo span{
  color:#2563eb
}

.icon{
  width:72px;
  height:72px;
  border-radius:50%;
  background:#fef2f2;
  color:#dc2626;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:34px;
  margin:0 auto 18px
}

h1{
  font-size:27px;
  margin-bottom:8px
}

.message{
  color:#64748b;
  font-size:14px;
  line-height:1.6
}

.details{
  background:#f8fafc;
  border-radius:11px;
  padding:15px;
  margin-top:20px;
  text-align:left
}

.row{
  display:flex;
  justify-content:space-between;
  gap:15px;
  padding:7px 0;
  font-size:13px
}

.label{
  color:#64748b
}

.value{
  font-weight:700;
  text-align:right;
  overflow-wrap:anywhere
}

.reason{
  margin-top:15px;
  padding:12px;
  background:#fff7ed;
  color:#9a3412;
  border-radius:9px;
  font-size:12px;
  text-align:left
}

.actions{
  display:flex;
  gap:9px;
  margin-top:22px
}

.btn{
  flex:1;
  padding:12px;
  border-radius:9px;
  text-decoration:none;
  font-size:13px;
  font-weight:800
}

.primary{
  background:#2563eb;
  color:#fff
}

.secondary{
  background:#eef2f7;
  color:#172033
}

.support{
  display:block;
  margin-top:17px;
  color:#2563eb;
  text-decoration:none;
  font-size:12px
}

.note{
  margin-top:17px;
  color:#94a3b8;
  font-size:11px;
  line-height:1.5
}

@media(max-width:500px){
  .actions{
    flex-direction:column
  }
}
</style>
</head>

<body>

<main class="card">

  <div class="logo">
    LetsStudy <span>Pro</span>
  </div>

  <div class="icon">
    ✕
  </div>

  <h1>
    Payment Failed
  </h1>

  <p class="message">
    We couldn't complete your payment.
    Please check your payment details and try again.
  </p>


  <section class="details">

    <div class="row">

      <span class="label">
        Transaction
      </span>

      <span
        id="transaction"
        class="value"
      >
        —
      </span>

    </div>


    <div class="row">

      <span class="label">
        Amount
      </span>

      <span
        id="amount"
        class="value"
      >
        —
      </span>

    </div>


    <div class="row">

      <span class="label">
        Payment method
      </span>

      <span
        id="method"
        class="value"
      >
        —
      </span>

    </div>


    <div class="row">

      <span class="label">
        Status
      </span>

      <span
        class="value"
        style="color:#dc2626"
      >
        Failed
      </span>

    </div>


    <div
      id="reasonBox"
      class="reason"
      style="display:none"
    >

      <strong>
        Reason:
      </strong>

      <span id="reason"></span>

    </div>

  </section>


  <div class="actions">

    <a
      id="retry"
      href="payment-method.html"
      class="btn primary"
    >
      Try Again
    </a>


    <a
      id="checkout"
      href="checkout.html"
      class="btn secondary"
    >
      Back to Checkout
    </a>

  </div>


  <a
    href="contact.html"
    class="support"
  >
    Need help? Contact Support
  </a>


  <p class="note">
    If your account was charged even though this
    payment failed, keep your transaction ID and
    contact support. Do not make another payment
    until the payment status is confirmed.
  </p>

</main>


<script>

/*
==================================================
PAYMENT-FAILED.HTML

SUPPORTED:

payment-failed.html

payment-failed.html?
type=course&
id=COURSE_ID&
amount=30000&
currency=TZS&
transactionId=XXXX&
method=mobile_money&
reason=Insufficient%20funds

TYPES:

course
marketplace
service
marketing
checkout
==================================================
*/


const params =
  new URLSearchParams(
    location.search
  );


const type =
  params.get("type") ||
  localStorage.getItem(
    "checkoutType"
  ) ||
  "checkout";


const id =
  params.get("id") ||
  params.get("documentId") ||
  localStorage.getItem(
    "checkoutId"
  ) ||
  "";


const transactionId =
  params.get("transactionId") ||
  params.get("transaction_id") ||
  localStorage.getItem(
    "transactionId"
  ) ||
  "";


const amount =
  params.get("amount") ||
  localStorage.getItem(
    "checkoutAmount"
  ) ||
  "";


const currency =
  params.get("currency") ||
  localStorage.getItem(
    "checkoutCurrency"
  ) ||
  "TZS";


const method =
  params.get("method") ||
  localStorage.getItem(
    "paymentMethod"
  ) ||
  "";


const reason =
  params.get("reason") ||
  "";


const transaction =
  document.getElementById(
    "transaction"
  );

const amountBox =
  document.getElementById(
    "amount"
  );

const methodBox =
  document.getElementById(
    "method"
  );

const reasonBox =
  document.getElementById(
    "reasonBox"
  );

const reasonText =
  document.getElementById(
    "reason"
  );

const retry =
  document.getElementById(
    "retry"
  );

const checkout =
  document.getElementById(
    "checkout"
  );


/* =========================
   DISPLAY
========================= */

if(transactionId){

  transaction.textContent =
    transactionId;

}


if(amount){

  amountBox.textContent =
    formatMoney(
      amount,
      currency
    );

}


if(method){

  methodBox.textContent =
    formatMethod(
      method
    );

}


if(reason){

  reasonBox.style.display =
    "block";

  reasonText.textContent =
    reason;

}


/* =========================
   BUILD RETRY
========================= */

const retryParams =
  new URLSearchParams();


retryParams.set(
  "type",
  type
);


if(id){

  retryParams.set(
    "id",
    id
  );

}


if(amount){

  retryParams.set(
    "amount",
    amount
  );

}


if(currency){

  retryParams.set(
    "currency",
    currency
  );

}


retry.href =
  "payment-method.html?" +
  retryParams.toString();


/* =========================
   CHECKOUT ROUTE
========================= */

let checkoutPage =
  "checkout.html";


if(type === "course"){

  checkoutPage =
    "checkout-course.html";

}else if(
  type === "marketplace"
){

  checkoutPage =
    "checkout-marketplace.html";

}else if(
  type === "service"
){

  checkoutPage =
    "checkout-service.html";

}else if(
  type === "marketing"
){

  checkoutPage =
    "checkout-marketing.html";

}


const checkoutParams =
  new URLSearchParams();


if(id){

  checkoutParams.set(
    "id",
    id
  );

}


if(amount){

  checkoutParams.set(
    "amount",
    amount
  );

}


if(currency){

  checkoutParams.set(
    "currency",
    currency
  );

}


checkout.href =
  checkoutPage +
  (
    checkoutParams.toString()
      ? "?" +
        checkoutParams.toString()
      : ""
  );


/* =========================
   METHOD NAME
========================= */

function formatMethod(
  value
){

  const methods = {

    mobile_money:
      "Mobile Money",

    card:
      "Debit / Credit Card",

    bank:
      "Bank Transfer",

    paypal:
      "PayPal"

  };


  return (
    methods[value] ||
    value
  );

}


/* =========================
   MONEY
========================= */

function formatMoney(
  value,
  currency
){

  const number =
    Number(
      String(value)
        .replace(
          /[^0-9.-]/g,
          ""
        )
    );


  if(
    Number.isNaN(
      number
    )
  ){

    return (
      String(value) +
      " " +
      currency
    );

  }


  return (
    new Intl.NumberFormat(
      undefined,
      {
        maximumFractionDigits:0
      }
    ).format(
      number
    ) +
    " " +
    currency
  );

}


/* =========================
   CLEAR PENDING STATE
========================= */

localStorage.removeItem(
  "paymentPending"
);

</script>

</body>
</html>