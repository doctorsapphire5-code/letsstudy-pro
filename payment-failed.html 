<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
>

<title>Payment Failed | LetsStudy Pro</title>

<meta
  name="description"
  content="Your LetsStudy Pro payment was not completed."
>

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#0f172a;
  min-height:100vh;
}

a{
  text-decoration:none;
  color:inherit;
}

header{
  position:sticky;
  top:0;
  z-index:1000;
  background:#fff;
  border-bottom:1px solid #e2e8f0;
  padding:14px 18px;

  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
}

.logo{
  font-size:20px;
  font-weight:900;
  color:#2563eb;
}

.logo span{
  color:#7c3aed;
}

nav{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
}

nav a{
  background:#f1f5f9;
  padding:8px 10px;
  border-radius:8px;
  font-size:8px;
  font-weight:900;
}

nav a:hover{
  background:#e0e7ff;
  color:#2563eb;
}

.container{
  max-width:700px;
  margin:auto;
  padding:35px 15px 50px;
}

.card{
  background:#fff;
  border:1px solid #e2e8f0;
  border-radius:22px;
  padding:30px 22px;
  text-align:center;

  box-shadow:
    0 12px 35px
    rgba(15,23,42,.05);
}

.icon{
  width:82px;
  height:82px;

  margin:0 auto 17px;

  border-radius:50%;

  background:#fee2e2;
  color:#dc2626;

  display:flex;
  align-items:center;
  justify-content:center;

  font-size:38px;
}

.badge{
  display:inline-block;

  background:#fee2e2;
  color:#991b1b;

  padding:7px 10px;

  border-radius:20px;

  font-size:7px;
  font-weight:900;

  margin-bottom:10px;
}

h1{
  font-size:25px;
  margin-bottom:8px;
}

.description{
  max-width:520px;

  margin:auto;

  color:#64748b;

  font-size:9px;

  line-height:1.8;
}

.error-box{
  margin-top:20px;

  padding:15px;

  border-radius:12px;

  background:#fef2f2;

  border:1px solid #fecaca;

  text-align:left;
}

.error-row{
  display:flex;

  justify-content:space-between;

  gap:12px;

  padding:9px 0;

  border-bottom:1px solid #fee2e2;

  font-size:8px;
}

.error-row:last-child{
  border-bottom:0;
}

.error-row span:first-child{
  color:#64748b;
}

.error-row strong{
  text-align:right;
  word-break:break-word;
}

.failed{
  color:#dc2626;
}

.message{
  display:none;

  margin-top:17px;

  padding:11px;

  border-radius:9px;

  font-size:8px;

  line-height:1.6;
}

.message.show{
  display:block;
}

.message.info{
  background:#eff6ff;
  color:#1d4ed8;
}

.message.warning{
  background:#fef3c7;
  color:#92400e;
}

.message.error{
  background:#fee2e2;
  color:#991b1b;
}

.actions{
  display:grid;

  grid-template-columns:
    1fr 1fr;

  gap:9px;

  margin-top:20px;
}

.btn{
  display:block;

  padding:12px;

  border-radius:9px;

  font-size:8px;

  font-weight:900;

  text-align:center;
}

.primary{
  background:#2563eb;
  color:#fff;
}

.secondary{
  background:#f1f5f9;
  color:#334155;
}

.support{
  margin-top:10px;

  width:100%;

  display:block;

  text-align:center;

  padding:11px;

  border-radius:9px;

  background:#7c3aed;

  color:#fff;

  font-size:8px;

  font-weight:900;
}

.note{
  margin-top:18px;

  color:#64748b;

  font-size:7px;

  line-height:1.7;
}

footer{
  text-align:center;

  padding:30px 15px;

  color:#64748b;

  font-size:8px;
}

.footer-links{
  display:flex;

  justify-content:center;

  gap:12px;

  flex-wrap:wrap;

  margin-bottom:9px;
}

.footer-links a{
  font-weight:900;
}

@media(max-width:600px){

  header{
    flex-direction:column;
    align-items:flex-start;
  }

  nav{
    width:100%;
  }

  nav a{
    flex:1;
    text-align:center;
  }

  .actions{
    grid-template-columns:1fr;
  }

  .card{
    padding:25px 17px;
  }

}

</style>

</head>

<body>


<header>

<a
  href="dashboard.html"
  class="logo"
>
  LetsStudy <span>Pro</span>
</a>

<nav>

<a href="checkout.html">
Checkout
</a>

<a href="payment.html">
Payment
</a>

<a href="order.html">
Orders
</a>

<a href="dashboard.html">
Dashboard
</a>

</nav>

</header>


<main class="container">

<section class="card">


<div class="icon">
✕
</div>


<div class="badge">
PAYMENT FAILED
</div>


<h1>
Payment Was Not Completed
</h1>


<p class="description">

We could not confirm a successful payment for this
transaction. No course or premium access will be activated
until the payment is successfully verified.

</p>


<div class="error-box">


<div class="error-row">

<span>
Payment Status
</span>

<strong class="failed">
Failed
</strong>

</div>


<div class="error-row">

<span>
Order Tracking ID
</span>

<strong id="trackingId">
Not available
</strong>

</div>


<div class="error-row">

<span>
Order ID
</span>

<strong id="orderId">
Not available
</strong>

</div>


<div class="error-row">

<span>
Reason
</span>

<strong id="reason">
Payment was not completed
</strong>

</div>


</div>


<div
  id="message"
  class="message"
></div>


<div class="actions">


<a
  id="retryButton"
  href="checkout.html"
  class="btn primary"
>
Try Payment Again
</a>


<a
  href="pricing.html"
  class="btn secondary"
>
Back to Pricing
</a>


</div>


<a
  href="order.html"
  id="orderButton"
  class="support"
>
View Order
</a>


<p class="note">

If money was deducted from your account despite this
message, do not immediately make another payment.
Check your transaction status or contact support so the
payment can be verified before retrying.

</p>


</section>

</main>


<footer>


<div class="footer-links">

<a href="pricing.html">
Pricing
</a>

<a href="checkout.html">
Checkout
</a>

<a href="payment.html">
Payment
</a>

<a href="order.html">
Orders
</a>

<a href="dashboard.html">
Dashboard
</a>

</div>


© <span id="year"></span> LetsStudy Pro


</footer>


<script type="module">

import {
  initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";


import {
  getAuth,
  onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";


/* =========================================
FIREBASE
========================================= */

const firebaseConfig = {

  apiKey:
  "AIzaSyBcOYDfAVKXKbljsyRgI_0rjodBn678tCc",

  authDomain:
  "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
  "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
  "let-s-study-pro-course",

  storageBucket:
  "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
  "474928293390",

  appId:
  "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
  "G-85B7V5H5J0"

};


const app =
  initializeApp(
    firebaseConfig
  );


const auth =
  getAuth(app);


/* =========================================
URL PARAMETERS
========================================= */

const params =
  new URLSearchParams(
    window.location.search
  );


const trackingId =
  params.get(
    "OrderTrackingId"
  ) ||
  params.get(
    "orderTrackingId"
  ) ||
  params.get(
    "trackingId"
  );


const orderId =
  params.get(
    "orderId"
  ) ||
  params.get(
    "OrderId"
  );


const reason =
  params.get(
    "reason"
  ) ||
  params.get(
    "message"
  ) ||
  "Payment was not completed";


/* =========================================
ELEMENTS
========================================= */

const trackingEl =
  document.getElementById(
    "trackingId"
  );

const orderEl =
  document.getElementById(
    "orderId"
  );

const reasonEl =
  document.getElementById(
    "reason"
  );

const retryButton =
  document.getElementById(
    "retryButton"
  );

const orderButton =
  document.getElementById(
    "orderButton"
  );

const messageEl =
  document.getElementById(
    "message"
  );


/* =========================================
DISPLAY DATA
========================================= */

trackingEl.textContent =
  trackingId ||
  "Not available";


orderEl.textContent =
  orderId ||
  "Not available";


reasonEl.textContent =
  cleanReason(
    reason
  );


/* =========================================
RETRY URL
========================================= */

if(
  orderId
){

  retryButton.href =
    "checkout.html?orderId=" +
    encodeURIComponent(
      orderId
    );

}


if(
  orderId
){

  orderButton.href =
    "order.html?orderId=" +
    encodeURIComponent(
      orderId
    );

}


/* =========================================
AUTH
========================================= */

onAuthStateChanged(
  auth,
  user => {

    if(
      !user
    ){

      showMessage(
        "You are not currently signed in. You can login and then retry the payment.",
        "warning"
      );

    }

  }
);


/* =========================================
CLEAN REASON
========================================= */

function cleanReason(
  value
){

  if(
    !value
  ){

    return "Payment was not completed";

  }


  return String(
    value
  )
  .replace(
    /</g,
    "&lt;"
  )
  .replace(
    />/g,
    "&gt;"
  );

}


/* =========================================
MESSAGE
========================================= */

function showMessage(
  text,
  type
){

  messageEl.textContent =
    text;

  messageEl.className =
    "message show " +
    type;

}


/* =========================================
YEAR
========================================= */

document.getElementById(
  "year"
).textContent =
  new Date()
    .getFullYear();

</script>


</body>
</html>