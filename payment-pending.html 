<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
>

<title>Payment Pending | LetsStudy Pro</title>

<meta
  name="description"
  content="Your LetsStudy Pro payment is currently pending verification."
>

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#0f172a;
  min-height:100vh;
}

a{
  text-decoration:none;
  color:inherit;
}

header{
  background:#fff;
  border-bottom:1px solid #e2e8f0;
  padding:14px 18px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
}

.logo{
  font-size:20px;
  font-weight:900;
  color:#2563eb;
}

.logo span{
  color:#7c3aed;
}

nav{
  display:flex;
  gap:6px;
  flex-wrap:wrap;
}

nav a{
  background:#f1f5f9;
  padding:8px 10px;
  border-radius:8px;
  font-size:8px;
  font-weight:900;
}

nav a:hover{
  background:#e0e7ff;
  color:#2563eb;
}

.container{
  max-width:700px;
  margin:auto;
  padding:35px 15px 50px;
}

.card{
  background:#fff;
  border:1px solid #e2e8f0;
  border-radius:22px;
  padding:30px 22px;
  text-align:center;
  box-shadow:0 12px 35px rgba(15,23,42,.05);
}

.icon{
  width:80px;
  height:80px;
  margin:0 auto 17px;
  border-radius:50%;
  background:#fef3c7;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:38px;
  animation:pulse 2s infinite;
}

@keyframes pulse{

  0%{
    transform:scale(1);
  }

  50%{
    transform:scale(1.06);
  }

  100%{
    transform:scale(1);
  }

}

.badge{
  display:inline-block;
  background:#fef3c7;
  color:#92400e;
  padding:7px 10px;
  border-radius:20px;
  font-size:7px;
  font-weight:900;
  margin-bottom:10px;
}

h1{
  font-size:25px;
  margin-bottom:8px;
}

.description{
  max-width:500px;
  margin:auto;
  color:#64748b;
  font-size:9px;
  line-height:1.8;
}

.status-box{
  margin-top:20px;
  padding:15px;
  border-radius:12px;
  background:#f8fafc;
  text-align:left;
}

.status-row{
  display:flex;
  justify-content:space-between;
  gap:12px;
  padding:9px 0;
  border-bottom:1px solid #e2e8f0;
  font-size:8px;
}

.status-row:last-child{
  border-bottom:0;
}

.status-row span:first-child{
  color:#64748b;
}

.status-row strong{
  text-align:right;
  word-break:break-word;
}

.pending{
  color:#d97706;
}

.actions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:9px;
  margin-top:20px;
}

.btn{
  display:block;
  padding:11px;
  border-radius:9px;
  font-size:8px;
  font-weight:900;
  text-align:center;
}

.primary{
  background:#2563eb;
  color:#fff;
}

.secondary{
  background:#f1f5f9;
  color:#334155;
}

.retry{
  margin-top:9px;
  width:100%;
  border:0;
  cursor:pointer;
  padding:11px;
  border-radius:9px;
  background:#7c3aed;
  color:#fff;
  font-size:8px;
  font-weight:900;
}

.retry:disabled{
  opacity:.6;
  cursor:not-allowed;
}

.message{
  margin-top:17px;
  padding:11px;
  border-radius:9px;
  font-size:8px;
  line-height:1.6;
  display:none;
}

.message.show{
  display:block;
}

.message.info{
  background:#eff6ff;
  color:#1d4ed8;
}

.message.error{
  background:#fee2e2;
  color:#991b1b;
}

.message.success{
  background:#dcfce7;
  color:#166534;
}

.note{
  margin-top:17px;
  color:#64748b;
  font-size:7px;
  line-height:1.7;
}

footer{
  text-align:center;
  padding:30px 15px;
  color:#64748b;
  font-size:8px;
}

.footer-links{
  display:flex;
  justify-content:center;
  gap:12px;
  flex-wrap:wrap;
  margin-bottom:9px;
}

.footer-links a{
  font-weight:900;
}

@media(max-width:600px){

  header{
    flex-direction:column;
    align-items:flex-start;
  }

  nav{
    width:100%;
  }

  nav a{
    flex:1;
    text-align:center;
  }

  .actions{
    grid-template-columns:1fr;
  }

  .card{
    padding:25px 17px;
  }

}

</style>

</head>

<body>


<header>

<a
  href="dashboard.html"
  class="logo"
>
  LetsStudy <span>Pro</span>
</a>

<nav>

<a href="checkout.html">
Checkout
</a>

<a href="payment.html">
Payment
</a>

<a href="order.html">
Orders
</a>

<a href="dashboard.html">
Dashboard
</a>

</nav>

</header>


<main class="container">

<section class="card">

<div class="icon">
⏳
</div>

<div class="badge">
PAYMENT PENDING
</div>

<h1>
Payment Is Being Verified
</h1>

<p class="description">
We received your payment request, but the payment has
not yet been confirmed. Please wait while the payment
provider completes the transaction.
</p>


<div class="status-box">

<div class="status-row">

<span>
Payment Status
</span>

<strong class="pending">
Pending
</strong>

</div>


<div class="status-row">

<span>
Order Tracking ID
</span>

<strong id="trackingId">
Checking...
</strong>

</div>


<div class="status-row">

<span>
Order ID
</span>

<strong id="orderId">
Checking...
</strong>

</div>


<div class="status-row">

<span>
Last Checked
</span>

<strong id="lastChecked">
--
</strong>

</div>

</div>


<div
  id="message"
  class="message"
></div>


<div class="actions">

<a
  href="order.html"
  id="orderButton"
  class="btn primary"
>
View Order
</a>

<a
  href="dashboard.html"
  class="btn secondary"
>
Dashboard
</a>

</div>


<button
  id="checkButton"
  class="retry"
>
Check Payment Status
</button>


<p class="note">
Do not make another payment while this transaction is
still being verified. If money has already been deducted,
allow the payment provider time to confirm the transaction.
</p>

</section>

</main>


<footer>

<div class="footer-links">

<a href="checkout.html">
Checkout
</a>

<a href="payment.html">
Payment
</a>

<a href="order.html">
Orders
</a>

<a href="dashboard.html">
Dashboard
</a>

</div>

© <span id="year"></span> LetsStudy Pro

</footer>


<script type="module">

import {
  initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";


import {
  getAuth,
  onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";


/* =========================================
FIREBASE CONFIG
========================================= */

const firebaseConfig = {

  apiKey:
  "AIzaSyBcOYDfAVKXKbljsyRgI_0rjodBn678tCc",

  authDomain:
  "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
  "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
  "let-s-study-pro-course",

  storageBucket:
  "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
  "474928293390",

  appId:
  "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
  "G-85B7V5H5J0"

};


const app =
  initializeApp(
    firebaseConfig
  );


const auth =
  getAuth(app);


/* =========================================
PAYMENT API
========================================= */

/*
 Replace with your deployed
 letsstudy-payment-api URL.
*/

const PAYMENT_API =
  "https://YOUR-PAYMENT-API-DOMAIN.com";


/* =========================================
URL PARAMETERS
========================================= */

const params =
  new URLSearchParams(
    window.location.search
  );


const trackingId =
  params.get(
    "OrderTrackingId"
  ) ||
  params.get(
    "orderTrackingId"
  ) ||
  params.get(
    "trackingId"
  );


const orderId =
  params.get(
    "orderId"
  ) ||
  params.get(
    "OrderId"
  );


/* =========================================
ELEMENTS
========================================= */

const trackingEl =
  document.getElementById(
    "trackingId"
  );

const orderEl =
  document.getElementById(
    "orderId"
  );

const lastCheckedEl =
  document.getElementById(
    "lastChecked"
  );

const checkButton =
  document.getElementById(
    "checkButton"
  );

const messageEl =
  document.getElementById(
    "message"
  );


/* =========================================
DISPLAY PARAMETERS
========================================= */

trackingEl.textContent =
  trackingId ||
  "Not provided";

orderEl.textContent =
  orderId ||
  "Not provided";


/* =========================================
AUTH
========================================= */

onAuthStateChanged(
  auth,
  user => {

    if(
      !user
    ){

      showMessage(
        "Please login to view your payment status.",
        "error"
      );

      return;

    }

  }
);


/* =========================================
CHECK PAYMENT
========================================= */

checkButton.addEventListener(
  "click",
  checkPayment
);


async function checkPayment(){

  if(
    !trackingId
  ){

    showMessage(
      "No Pesapal OrderTrackingId was found.",
      "error"
    );

    return;

  }


  checkButton.disabled =
    true;

  checkButton.textContent =
    "Checking Payment...";


  showMessage(
    "Checking the latest payment status...",
    "info"
  );


  try{

    const user =
      auth.currentUser;


    if(
      !user
    ){

      throw new Error(
        "Please login first."
      );

    }


    const token =
      await user.getIdToken();


    /*
     * Backend should verify the Firebase
     * token before returning payment data.
     */

    const response =
      await fetch(

        PAYMENT_API +
        "/payment-status" +
        "?OrderTrackingId=" +
        encodeURIComponent(
          trackingId
        ),

        {

          method:"GET",

          headers:{

            "Authorization":
              "Bearer " +
              token

          }

        }

      );


    if(
      !response.ok
    ){

      throw new Error(
        "Payment server returned HTTP " +
        response.status
      );

    }


    const result =
      await response.json();


    const status =
      String(
        result.status ||
        result.paymentStatus ||
        "PENDING"
      ).toUpperCase();


    lastCheckedEl.textContent =
      new Date()
        .toLocaleTimeString();


    /* =====================================
       SUCCESS
    ===================================== */

    if(
      status === "COMPLETED" ||
      status === "PAID" ||
      status === "SUCCESS"
    ){

      showMessage(
        "Payment confirmed successfully. Redirecting to your order...",
        "success"
      );


      setTimeout(
        () => {

          let url =
            "order.html";


          if(
            orderId
          ){

            url +=
              "?orderId=" +
              encodeURIComponent(
                orderId
              );

          }


          window.location.href =
            url;

        },
        1200
      );


      return;

    }


    /* =====================================
       FAILED
    ===================================== */

    if(
      status === "FAILED" ||
      status === "INVALID" ||
      status === "CANCELLED"
    ){

      showMessage(
        "The payment was not completed. You can return to checkout and try again.",
        "error"
      );


      setTimeout(
        () => {

          window.location.href =
            "payment.html?status=failed" +
            "&OrderTrackingId=" +
            encodeURIComponent(
              trackingId
            );

        },
        1800
      );


      return;

    }


    /* =====================================
       STILL PENDING
    ===================================== */

    showMessage(
      "The payment is still pending. Please wait and check again.",
      "info"
    );


  }catch(error){

    console.error(
      "Payment status error:",
      error
    );


    showMessage(
      error.message ||
      "Unable to check payment status.",
      "error"
    );

  }


  checkButton.disabled =
    false;

  checkButton.textContent =
    "Check Payment Status";

}


/* =========================================
MESSAGE
========================================= */

function showMessage(
  text,
  type
){

  messageEl.textContent =
    text;

  messageEl.className =
    "message show " +
    type;

}


/* =========================================
AUTO CHECK
========================================= */

/*
 Do one automatic check after loading
 if an OrderTrackingId exists.
*/

if(
  trackingId
){

  setTimeout(
    () => {

      checkPayment();

    },
    1500
  );

}


/* =========================================
YEAR
========================================= */

document.getElementById(
  "year"
).textContent =
  new Date()
    .getFullYear();

</script>

</body>
</html>