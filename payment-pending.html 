<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Payment Pending | LetsStudy Pro</title>

<meta name="description"
content="Your LetsStudy Pro payment is currently pending confirmation.">

<meta name="theme-color"
content="#f59e0b">

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:
  Inter,
  system-ui,
  -apple-system,
  "Segoe UI",
  sans-serif;

  background:#f8fafc;
  color:#0f172a;

  min-height:100vh;

  display:flex;
  flex-direction:column;
}

a{
  text-decoration:none;
}


/* =========================
   NAVBAR
========================= */

.navbar{
  background:#fff;

  border-bottom:
  1px solid #e2e8f0;

  position:sticky;

  top:0;

  z-index:1000;
}

.nav-container{
  max-width:1100px;

  min-height:68px;

  margin:auto;

  padding:0 20px;

  display:flex;

  align-items:center;

  justify-content:space-between;
}

.logo{
  display:flex;

  align-items:center;

  gap:9px;

  color:#2563eb;

  font-size:19px;

  font-weight:800;
}

.logo-icon{
  width:38px;
  height:38px;

  background:#2563eb;

  color:#fff;

  border-radius:10px;

  display:flex;

  align-items:center;
  justify-content:center;

  font-size:13px;

  font-weight:900;
}

.nav-links{
  display:flex;

  gap:20px;
}

.nav-links a{
  color:#475569;

  font-size:13px;

  font-weight:600;
}

.menu-btn{
  display:none;

  border:0;

  background:none;

  font-size:25px;

  cursor:pointer;
}


/* =========================
   MAIN
========================= */

main{
  flex:1;

  display:flex;

  align-items:center;

  justify-content:center;

  padding:40px 20px;
}

.payment-card{
  width:100%;

  max-width:560px;

  background:#fff;

  border:
  1px solid #e2e8f0;

  border-radius:20px;

  padding:35px 25px;

  text-align:center;

  box-shadow:
  0 10px 35px
  rgba(15,23,42,.06);
}


/* =========================
   PENDING ICON
========================= */

.pending-icon{
  width:78px;
  height:78px;

  margin:0 auto 20px;

  border-radius:50%;

  background:#fef3c7;

  color:#d97706;

  display:flex;

  align-items:center;
  justify-content:center;

  font-size:34px;

  font-weight:900;
}

h1{
  font-size:25px;

  margin-bottom:9px;
}

.subtitle{
  color:#64748b;

  font-size:12px;

  line-height:1.7;

  margin-bottom:25px;
}


/* =========================
   STATUS
========================= */

.status-box{
  background:#fffbeb;

  border:
  1px solid #fde68a;

  border-radius:12px;

  padding:15px;

  margin-bottom:22px;

  color:#92400e;

  font-size:11px;

  line-height:1.6;
}


/* =========================
   DETAILS
========================= */

.details{
  background:#f8fafc;

  border:
  1px solid #e2e8f0;

  border-radius:12px;

  padding:15px;

  margin-bottom:24px;

  text-align:left;
}

.detail-row{
  display:flex;

  justify-content:space-between;

  gap:15px;

  padding:9px 0;

  border-bottom:
  1px solid #e2e8f0;

  font-size:11px;
}

.detail-row:last-child{
  border-bottom:0;
}

.detail-label{
  color:#64748b;
}

.detail-value{
  font-weight:800;

  text-align:right;

  word-break:break-word;
}

.pending-text{
  color:#d97706;
}


/* =========================
   BUTTONS
========================= */

.actions{
  display:flex;

  flex-direction:column;

  gap:10px;
}

.btn{
  display:block;

  width:100%;

  padding:12px 18px;

  border:0;

  border-radius:9px;

  font-size:11px;

  font-weight:800;

  cursor:pointer;

  text-align:center;
}

.primary{
  background:#2563eb;

  color:#fff;
}

.primary:hover{
  background:#1d4ed8;
}

.secondary{
  background:#f1f5f9;

  color:#334155;
}

.secondary:hover{
  background:#e2e8f0;
}

.btn:disabled{
  opacity:.65;

  cursor:not-allowed;
}


/* =========================
   AUTO CHECK
========================= */

.checking{
  margin-top:18px;

  color:#64748b;

  font-size:10px;
}

.dot{
  display:inline-block;

  width:6px;
  height:6px;

  margin:0 2px;

  border-radius:50%;

  background:#94a3b8;

  animation:pulse 1.2s infinite;
}

.dot:nth-child(2){
  animation-delay:.2s;
}

.dot:nth-child(3){
  animation-delay:.4s;
}

@keyframes pulse{

  0%,100%{
    opacity:.3;
  }

  50%{
    opacity:1;
  }

}


/* =========================
   SUPPORT
========================= */

.support{
  margin-top:20px;

  color:#94a3b8;

  font-size:10px;

  line-height:1.5;
}

.support a{
  color:#2563eb;

  font-weight:700;
}


/* =========================
   FOOTER
========================= */

footer{
  text-align:center;

  padding:25px;

  color:#94a3b8;

  font-size:10px;
}


/* =========================
   MOBILE
========================= */

@media(max-width:700px){

  .nav-links{
    display:none;
  }

  .menu-btn{
    display:block;
  }

  main{
    padding:25px 15px;
  }

  .payment-card{
    padding:30px 18px;
  }

  .detail-row{
    align-items:flex-start;

    flex-direction:column;

    gap:3px;
  }

  .detail-value{
    text-align:left;
  }

}

</style>

</head>


<body>


<!-- =========================
     NAVBAR
========================= -->

<header class="navbar">

<div class="nav-container">

<a href="/" class="logo">

<div class="logo-icon">
LS
</div>

LetsStudy Pro

</a>


<nav class="nav-links">

<a href="/">
Home
</a>

<a href="/courses.html">
Courses
</a>

<a href="/cart.html">
Cart
</a>

<a href="/profile.html">
Profile
</a>

</nav>


<button
id="menuBtn"
class="menu-btn">

☰

</button>

</div>

</header>



<!-- =========================
     MAIN
========================= -->

<main>

<section class="payment-card">


<div class="pending-icon">
⏳
</div>


<h1>
Payment Pending
</h1>


<p class="subtitle">

Your payment has been received but is still waiting for confirmation.

</p>



<!-- =========================
     STATUS
========================= -->

<div class="status-box">

<strong>
Please don't make another payment.
</strong>

<br>

We are checking the payment status. Your course access will be activated automatically once the payment is confirmed.

</div>



<!-- =========================
     DETAILS
========================= -->

<div class="details">

<div class="detail-row">

<span class="detail-label">
Order Reference
</span>

<span
id="orderReference"
class="detail-value">

—

</span>

</div>


<div class="detail-row">

<span class="detail-label">
Payment Status
</span>

<span
class="detail-value pending-text">

Pending

</span>

</div>


<div class="detail-row">

<span class="detail-label">
Payment Method
</span>

<span
id="paymentMethod"
class="detail-value">

—

</span>

</div>


<div class="detail-row">

<span class="detail-label">
Date
</span>

<span
id="paymentDate"
class="detail-value">

—

</span>

</div>

</div>



<!-- =========================
     ACTIONS
========================= -->

<div class="actions">

<button
id="checkBtn"
class="btn primary">

Check Payment Status

</button>


<a
href="/courses.html"
class="btn secondary">

Back to Courses

</a>


<a
href="/"
class="btn secondary">

Return Home

</a>

</div>



<div
id="checking"
class="checking"
style="display:none;">

Checking payment status

<span class="dot"></span>

<span class="dot"></span>

<span class="dot"></span>

</div>



<div class="support">

If your payment remains pending for a long time, contact LetsStudy Pro support and provide your order reference.

<br><br>

<a href="/support.html">
Contact Support
</a>

</div>


</section>

</main>



<footer>

© 2026 LetsStudy Pro.
All rights reserved.

</footer>



<script>

/* =========================
   URL PARAMETERS
========================= */

const params =
new URLSearchParams(
window.location.search
);


const orderId =
params.get(
"orderId"
) ||
params.get(
"reference"
) ||
localStorage.getItem(
"lastOrderId"
) ||
"Not available";


const paymentMethod =
params.get(
"method"
) ||
localStorage.getItem(
"paymentMethod"
) ||
"Not available";


/* =========================
   DISPLAY DATA
========================= */

document.getElementById(
"orderReference"
).textContent =
orderId;


document.getElementById(
"paymentMethod"
).textContent =
paymentMethod;


document.getElementById(
"paymentDate"
).textContent =
new Date().toLocaleString(
"en-TZ",
{
  dateStyle:"medium",
  timeStyle:"short"
}
);


/* =========================
   CHECK PAYMENT
========================= */

const checkBtn =
document.getElementById(
"checkBtn"
);

const checking =
document.getElementById(
"checking"
);


checkBtn.addEventListener(
"click",
async () => {

  if(
    !orderId ||
    orderId ===
    "Not available"
  ){

    alert(
      "Order reference is not available."
    );

    return;

  }


  checkBtn.disabled =
  true;

  checkBtn.textContent =
  "Checking...";

  checking.style.display =
  "block";


  try{

    /*
     * Replace this endpoint with
     * your deployed payment API.
     *
     * Example:
     *
     * /api/payment-status?orderId=...
     */

    const response =
    await fetch(
      "/api/payment-status?orderId=" +
      encodeURIComponent(
        orderId
      )
    );


    if(
      response.ok
    ){

      const data =
      await response.json();


      const status =
      String(
        data.status ||
        ""
      ).toLowerCase();


      if(
        status ===
        "completed" ||
        status ===
        "success" ||
        status ===
        "paid"
      ){

        window.location.href =
        "/payment-success.html?orderId=" +
        encodeURIComponent(
          orderId
        );

        return;

      }


      if(
        status ===
        "failed" ||
        status ===
        "cancelled"
      ){

        window.location.href =
        "/payment-failed.html?orderId=" +
        encodeURIComponent(
          orderId
        );

        return;

      }

    }


    alert(
      "Your payment is still pending. Please wait for confirmation."
    );


  }catch(error){

    console.error(
      "Payment status error:",
      error
    );


    alert(
      "Unable to check payment status right now. Please try again."
    );


  }finally{

    checkBtn.disabled =
    false;

    checkBtn.textContent =
    "Check Payment Status";

    checking.style.display =
    "none";

  }

});


/* =========================
   MOBILE MENU
========================= */

document
.getElementById(
"menuBtn"
)
.addEventListener(
"click",
function(){

  document
  .querySelector(
    ".nav-links"
  )
  .classList.toggle(
    "active"
  );

});

</script>


</body>

</html>