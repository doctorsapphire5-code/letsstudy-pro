<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Payment Pending | LetsStudy Pro</title>

<meta name="description"
content="Your LetsStudy Pro payment is currently pending confirmation.">

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#f5f7fb;
  color:#111827;
  min-height:100vh;
}

/* HEADER */

.header{
  height:65px;
  background:#ffffff;
  border-bottom:1px solid #e5e7eb;

  display:flex;
  align-items:center;
  justify-content:space-between;

  padding:0 20px;

  position:sticky;
  top:0;
  z-index:100;
}

.logo{
  font-size:20px;
  font-weight:700;
  color:#111827;
  text-decoration:none;
}

.menu-btn{
  border:0;
  background:#111827;
  color:#fff;

  width:42px;
  height:42px;

  border-radius:8px;

  font-size:22px;
  cursor:pointer;
}

/* SIDEBAR */

.sidebar{
  position:fixed;

  top:0;
  left:0;

  width:270px;
  height:100vh;

  background:#fff;

  transform:translateX(-100%);

  transition:.3s;

  z-index:1000;

  box-shadow:4px 0 20px #0002;

  overflow-y:auto;
}

.sidebar.open{
  transform:translateX(0);
}

.sidebar-head{
  height:65px;

  display:flex;
  align-items:center;
  justify-content:space-between;

  padding:0 18px;

  border-bottom:1px solid #eee;
}

.close-btn{
  border:0;
  background:none;

  font-size:30px;

  cursor:pointer;
}

.sidebar-links{
  padding:15px;
}

.sidebar-links a{
  display:block;

  padding:13px 14px;

  margin-bottom:5px;

  color:#374151;

  text-decoration:none;

  border-radius:8px;
}

.sidebar-links a:hover{
  background:#f3f4f6;
}

/* OVERLAY */

.overlay{
  position:fixed;

  inset:0;

  background:#0007;

  display:none;

  z-index:999;
}

.overlay.show{
  display:block;
}

/* MAIN */

.main{
  max-width:700px;

  margin:40px auto;

  padding:20px;
}

/* CARD */

.card{
  background:#fff;

  border-radius:18px;

  padding:40px 25px;

  text-align:center;

  box-shadow:0 5px 25px #0000000d;
}

/* ICON */

.pending-icon{
  width:80px;
  height:80px;

  margin:0 auto 20px;

  border-radius:50%;

  background:#fff7ed;

  display:flex;
  align-items:center;
  justify-content:center;

  font-size:42px;
}

/* TITLE */

.card h1{
  font-size:28px;

  margin-bottom:10px;
}

.description{
  color:#6b7280;

  line-height:1.6;

  max-width:500px;

  margin:0 auto 20px;
}

/* STATUS */

.status{
  display:inline-block;

  padding:8px 18px;

  border-radius:30px;

  background:#fff7ed;

  color:#c2410c;

  font-size:13px;

  font-weight:bold;

  margin-bottom:25px;
}

/* DETAILS */

.details{
  text-align:left;

  border:1px solid #e5e7eb;

  border-radius:12px;

  overflow:hidden;

  margin-top:20px;
}

.detail{
  display:flex;

  justify-content:space-between;

  gap:20px;

  padding:14px 16px;

  border-bottom:1px solid #e5e7eb;
}

.detail:last-child{
  border-bottom:0;
}

.label{
  color:#6b7280;
}

.value{
  font-weight:600;

  text-align:right;

  word-break:break-word;
}

/* BUTTONS */

.actions{
  margin-top:25px;

  display:flex;

  justify-content:center;

  gap:10px;

  flex-wrap:wrap;
}

.btn{
  display:inline-block;

  padding:12px 20px;

  border-radius:8px;

  text-decoration:none;

  font-weight:600;

  cursor:pointer;

  border:0;
}

.primary{
  background:#111827;

  color:#fff;
}

.secondary{
  background:#f3f4f6;

  color:#111827;
}

/* INFO */

.info{
  margin-top:25px;

  padding:15px;

  background:#f9fafb;

  border-radius:10px;

  color:#6b7280;

  font-size:14px;

  line-height:1.5;
}

/* FOOTER */

.footer{
  text-align:center;

  padding:30px 20px;

  color:#6b7280;

  font-size:13px;
}

/* MOBILE */

@media(max-width:600px){

  .main{
    margin:20px auto;
    padding:15px;
  }

  .card{
    padding:30px 18px;
  }

  .card h1{
    font-size:24px;
  }

  .detail{
    flex-direction:column;
    gap:5px;
  }

  .value{
    text-align:left;
  }

}

</style>

</head>


<body>


<!-- HEADER -->

<header class="header">

  <a href="index.html" class="logo">
    LetsStudy Pro
  </a>

  <button
    class="menu-btn"
    onclick="openSidebar()"
    aria-label="Open menu"
  >
    ☰
  </button>

</header>


<!-- SIDEBAR -->

<aside id="sidebar" class="sidebar">

  <div class="sidebar-head">

    <strong>LetsStudy Pro</strong>

    <button
      class="close-btn"
      onclick="closeSidebar()"
      aria-label="Close menu"
    >
      ×
    </button>

  </div>


  <nav class="sidebar-links">

    <!-- WEKA LINKS ZAKO HAPA -->

    <a href="dashboard.html">
      Dashboard
    </a>

    <a href="courses.html">
      Courses
    </a>

    <a href="cart.html">
      Cart
    </a>

    <a href="orders.html">
      Orders
    </a>

    <a href="payment-pending.html">
      Payment Pending
    </a>

    <a href="account.html">
      My Account
    </a>

  </nav>

</aside>


<!-- OVERLAY -->

<div
  id="overlay"
  class="overlay"
  onclick="closeSidebar()"
></div>


<!-- MAIN -->

<main class="main">

  <div class="card">


    <!-- ICON -->

    <div class="pending-icon">
      ⏳
    </div>


    <!-- TITLE -->

    <h1>
      Payment Pending
    </h1>


    <div class="status">
      PAYMENT PENDING
    </div>


    <p class="description">

      Your payment has been received and is
      currently being processed.

      Please wait while we confirm your
      transaction.

    </p>


    <!-- PAYMENT DETAILS -->

    <div class="details">

      <div class="detail">

        <span class="label">
          Order ID
        </span>

        <span
          class="value"
          id="orderId"
        >
          —
        </span>

      </div>


      <div class="detail">

        <span class="label">
          Payment Status
        </span>

        <span
          class="value"
          id="paymentStatus"
        >
          Pending
        </span>

      </div>


      <div class="detail">

        <span class="label">
          Amount
        </span>

        <span
          class="value"
          id="amount"
        >
          —
        </span>

      </div>


      <div class="detail">

        <span class="label">
          Payment Method
        </span>

        <span
          class="value"
          id="paymentMethod"
        >
          —
        </span>

      </div>


      <div class="detail">

        <span class="label">
          Date
        </span>

        <span
          class="value"
          id="paymentDate"
        >
          —
        </span>

      </div>

    </div>


    <!-- ACTIONS -->

    <div class="actions">

      <a
        href="dashboard.html"
        class="btn primary"
      >
        Back to Dashboard
      </a>


      <button
        class="btn secondary"
        onclick="checkPayment()"
      >
        Check Payment
      </button>

    </div>


    <!-- INFORMATION -->

    <div class="info">

      <strong>Please note:</strong>

      Payment confirmation may take a few
      moments. Do not make another payment
      while this transaction is still pending.

    </div>

  </div>

</main>


<!-- FOOTER -->

<footer class="footer">

  © 2026 LetsStudy Pro. All rights reserved.

</footer>


<script>

/* =========================
   SIDEBAR
========================= */

const sidebar =
  document.getElementById("sidebar");

const overlay =
  document.getElementById("overlay");


function openSidebar(){

  sidebar.classList.add("open");

  overlay.classList.add("show");

}


function closeSidebar(){

  sidebar.classList.remove("open");

  overlay.classList.remove("show");

}


/* =========================
   ESC KEY
========================= */

document.addEventListener(
  "keydown",
  function(event){

    if(event.key === "Escape"){

      closeSidebar();

    }

  }
);


/* =========================
   PAYMENT DATA
========================= */

const params =
  new URLSearchParams(
    window.location.search
  );


const orderId =
  params.get("orderId");

const amount =
  params.get("amount");

const method =
  params.get("method");


if(orderId){

  document.getElementById(
    "orderId"
  ).textContent = orderId;

}


if(amount){

  document.getElementById(
    "amount"
  ).textContent = amount;

}


if(method){

  document.getElementById(
    "paymentMethod"
  ).textContent = method;

}


/* =========================
   DATE
========================= */

document.getElementById(
  "paymentDate"
).textContent =
  new Date().toLocaleString();


/* =========================
   CHECK PAYMENT
========================= */

function checkPayment(){

  alert(
    "Your payment is still pending. Please wait for confirmation."
  );

}

</script>


</body>
</html>

