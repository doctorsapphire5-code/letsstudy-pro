<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Payment Pending | LetsStudy Pro</title>

<meta name="description"
content="Your LetsStudy Pro payment is pending confirmation.">

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0
}

body{
  font-family:Arial,sans-serif;
  background:#f5f7fb;
  color:#172033;
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px
}

.card{
  width:100%;
  max-width:540px;
  background:#fff;
  border:1px solid #e5e7eb;
  border-radius:18px;
  padding:35px 25px;
  text-align:center;
  box-shadow:0 8px 30px rgba(15,23,42,.06)
}

.logo{
  font-size:21px;
  font-weight:800;
  margin-bottom:25px
}

.logo span{
  color:#2563eb
}

.icon{
  width:72px;
  height:72px;
  border-radius:50%;
  background:#fff7ed;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:31px;
  margin:0 auto 18px;
  animation:pulse 1.8s infinite
}

@keyframes pulse{
  0%,100%{
    transform:scale(1)
  }
  50%{
    transform:scale(1.06)
  }
}

h1{
  font-size:27px;
  margin-bottom:8px
}

.message{
  color:#64748b;
  font-size:14px;
  line-height:1.6
}

.status{
  display:inline-block;
  margin-top:14px;
  background:#fff7ed;
  color:#c2410c;
  padding:6px 11px;
  border-radius:20px;
  font-size:11px;
  font-weight:800
}

.details{
  background:#f8fafc;
  border-radius:11px;
  padding:15px;
  margin-top:20px;
  text-align:left
}

.row{
  display:flex;
  justify-content:space-between;
  gap:15px;
  padding:7px 0;
  font-size:13px
}

.label{
  color:#64748b
}

.value{
  font-weight:700;
  text-align:right;
  overflow-wrap:anywhere
}

.actions{
  display:flex;
  gap:9px;
  margin-top:22px
}

.btn{
  flex:1;
  border:0;
  padding:12px;
  border-radius:9px;
  text-decoration:none;
  font-size:13px;
  font-weight:800;
  cursor:pointer
}

.primary{
  background:#2563eb;
  color:#fff
}

.secondary{
  background:#eef2f7;
  color:#172033
}

.message-status{
  margin-top:13px;
  color:#64748b;
  font-size:11px;
  min-height:16px
}

.note{
  margin-top:17px;
  color:#94a3b8;
  font-size:11px;
  line-height:1.5
}

@media(max-width:500px){

  .actions{
    flex-direction:column
  }
}
</style>
</head>

<body>

<main class="card">

  <div class="logo">
    LetsStudy <span>Pro</span>
  </div>


  <div class="icon">
    ⏳
  </div>


  <h1>
    Payment Pending
  </h1>


  <p class="message">
    Your payment has been received for processing.
    We are waiting for the payment provider to
    confirm the final status.
  </p>


  <span class="status">
    WAITING FOR CONFIRMATION
  </span>


  <section class="details">

    <div class="row">

      <span class="label">
        Transaction
      </span>

      <span
        id="transaction"
        class="value"
      >
        —
      </span>

    </div>


    <div class="row">

      <span class="label">
        Amount
      </span>

      <span
        id="amount"
        class="value"
      >
        —
      </span>

    </div>


    <div class="row">

      <span class="label">
        Payment method
      </span>

      <span
        id="method"
        class="value"
      >
        —
      </span>

    </div>


    <div class="row">

      <span class="label">
        Status
      </span>

      <span
        class="value"
        style="color:#c2410c"
      >
        Pending
      </span>

    </div>

  </section>


  <div class="actions">

    <button
      id="check"
      class="btn primary"
    >
      Check Payment Status
    </button>


    <a
      id="checkout"
      href="checkout.html"
      class="btn secondary"
    >
      Back to Checkout
    </a>

  </div>


  <div
    id="message"
    class="message-status"
  ></div>


  <p class="note">
    Please do not make another payment while this
    transaction is pending. If the payment remains
    pending, contact support using your transaction ID.
  </p>

</main>


<script>

/*
==================================================
PAYMENT-PENDING.HTML

SUPPORTED:

payment-pending.html

payment-pending.html?
type=course&
id=COURSE_ID&
amount=30000&
currency=TZS&
transactionId=XXXX&
method=mobile_money


STATUS API:

GET
/api/payments/status?transactionId=XXXX


EXPECTED:

{
  "status":"pending"
}

OR:

{
  "status":"success"
}

OR:

{
  "status":"failed"

}

OR:

{
  "status":"cancelled"
}

IMPORTANT:

Never trust a browser-only success state.
Final payment confirmation must come from
your secure backend/payment provider.
==================================================
*/


const params =
  new URLSearchParams(
    location.search
  );


const type =
  params.get("type") ||
  localStorage.getItem(
    "checkoutType"
  ) ||
  "checkout";


const id =
  params.get("id") ||
  params.get("documentId") ||
  localStorage.getItem(
    "checkoutId"
  ) ||
  "";


const transactionId =
  params.get("transactionId") ||
  params.get("transaction_id") ||
  localStorage.getItem(
    "transactionId"
  ) ||
  "";


const amount =
  params.get("amount") ||
  localStorage.getItem(
    "checkoutAmount"
  ) ||
  "";


const currency =
  params.get("currency") ||
  localStorage.getItem(
    "checkoutCurrency"
  ) ||
  "TZS";


const method =
  params.get("method") ||
  localStorage.getItem(
    "paymentMethod"
  ) ||
  "";


const transaction =
  document.getElementById(
    "transaction"
  );

const amountBox =
  document.getElementById(
    "amount"
  );

const methodBox =
  document.getElementById(
    "method"
  );

const checkButton =
  document.getElementById(
    "check"
  );

const message =
  document.getElementById(
    "message"
  );

const checkout =
  document.getElementById(
    "checkout"
  );


/* =========================
   DISPLAY
========================= */

if(transactionId){

  transaction.textContent =
    transactionId;

}


if(amount){

  amountBox.textContent =
    formatMoney(
      amount,
      currency
    );

}


if(method){

  methodBox.textContent =
    formatMethod(
      method
    );

}


/* =========================
   CHECK STATUS
========================= */

checkButton.addEventListener(
  "click",
  checkPaymentStatus
);


async function checkPaymentStatus(){

  if(!transactionId){

    message.textContent =
      "Transaction ID is not available.";

    return;

  }


  checkButton.disabled =
    true;

  checkButton.textContent =
    "Checking...";

  message.textContent =
    "Checking payment status...";


  try{

    const response =
      await fetch(
        "/api/payments/status?transactionId=" +
        encodeURIComponent(
          transactionId
        )
      );


    const result =
      await response.json();


    if(!response.ok){

      throw new Error(
        result.error ||
        "Unable to check payment status."
      );

    }


    const status =
      String(
        result.status ||
        "pending"
      ).toLowerCase();


    if(
      status ===
      "success" ||
      status ===
      "successful" ||
      status ===
      "completed" ||
      status ===
      "paid"
    ){

      goToResult(
        "success"
      );

      return;

    }


    if(
      status ===
      "failed" ||
      status ===
      "failure"
    ){

      goToResult(
        "failed"
      );

      return;

    }


    if(
      status ===
      "cancelled" ||
      status ===
      "canceled"
    ){

      goToResult(
        "cancel"
      );

      return;

    }


    message.textContent =
      "Payment is still pending. Please wait for confirmation.";

  }catch(error){

    console.error(
      error
    );

    message.textContent =
      error.message;

  }finally{

    checkButton.disabled =
      false;

    checkButton.textContent =
      "Check Payment Status";

  }

}


/* =========================
   REDIRECT RESULT
========================= */

function goToResult(
  result
){

  const query =
    new URLSearchParams();


  query.set(
    "type",
    type
  );


  if(id){

    query.set(
      "id",
      id
    );

  }


  if(transactionId){

    query.set(
      "transactionId",
      transactionId
    );

  }


  if(amount){

    query.set(
      "amount",
      amount
    );

  }


  query.set(
    "currency",
    currency
  );


  if(method){

    query.set(
      "method",
      method
    );

  }


  let page;


  if(result === "success"){

    page =
      "payment-success.html";

  }else if(
    result === "failed"
  ){

    page =
      "payment-failed.html";

  }else{

    page =
      "payment-cancel.html";

  }


  location.href =
    page +
    "?" +
    query.toString();

}


/* =========================
   CHECKOUT LINK
========================= */

let checkoutPage =
  "checkout.html";


if(type === "course"){

  checkoutPage =
    "checkout-course.html";

}else if(
  type === "marketplace"
){

  checkoutPage =
    "checkout-marketplace.html";

}else if(
  type === "service"
){

  checkoutPage =
    "checkout-service.html";

}else if(
  type === "marketing"
){

  checkoutPage =
    "checkout-marketing.html";

}


const checkoutParams =
  new URLSearchParams();


if(id){

  checkoutParams.set(
    "id",
    id
  );

}


if(amount){

  checkoutParams.set(
    "amount",
    amount
  );

}


if(currency){

  checkoutParams.set(
    "currency",
    currency
  );

}


checkout.href =
  checkoutPage +
  (
    checkoutParams.toString()
      ? "?" +
        checkoutParams.toString()
      : ""
  );


/* =========================
   METHOD
========================= */

function formatMethod(
  value
){

  const methods = {

    mobile_money:
      "Mobile Money",

    card:
      "Debit / Credit Card",

    bank:
      "Bank Transfer",

    paypal:
      "PayPal"

  };


  return (
    methods[value] ||
    value
  );

}


/* =========================
   MONEY
========================= */

function formatMoney(
  value,
  currency
){

  const number =
    Number(
      String(value)
        .replace(
          /[^0-9.-]/g,
          ""
        )
    );


  if(
    Number.isNaN(
      number
    )
  ){

    return (
      String(value) +
      " " +
      currency
    );

  }


  return (
    new Intl.NumberFormat(
      undefined,
      {
        maximumFractionDigits:0
      }
    ).format(
      number
    ) +
    " " +
    currency
  );

}


/* =========================
   AUTO CHECK
========================= */

if(transactionId){

  setTimeout(
    checkPaymentStatus,
    5000
  );

}


/* =========================
   AUTO POLL
========================= */

let polling =
  null;


if(transactionId){

  polling =
    setInterval(
      checkPaymentStatus,
      15000
    );

}

</script>

</body>
</html>