<script type="module">

import {
  initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";


import {
  getAuth,
  onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-auth.js";


import {
  getDatabase,
  ref,
  get
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-database.js";


/* =========================
   FIREBASE CONFIG
========================= */

const firebaseConfig = {

  apiKey:
  "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

  authDomain:
  "let-s-study-pro-course.firebaseapp.com",

  databaseURL:
  "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

  projectId:
  "let-s-study-pro-course",

  storageBucket:
  "let-s-study-pro-course.firebasestorage.app",

  messagingSenderId:
  "474928293390",

  appId:
  "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

  measurementId:
  "G-85B7V5H5J0"

};


const app =
initializeApp(
  firebaseConfig
);

const auth =
getAuth(app);

const db =
getDatabase(app);


/* =========================
   ELEMENTS
========================= */

const loginBox =
document.getElementById(
  "loginBox"
);

const mainContent =
document.getElementById(
  "mainContent"
);

const loading =
document.getElementById(
  "loading"
);

const message =
document.getElementById(
  "message"
);

const statusCard =
document.getElementById(
  "statusCard"
);

const detailsCard =
document.getElementById(
  "detailsCard"
);

const actionsCard =
document.getElementById(
  "actionsCard"
);


/* =========================
   URL
========================= */

const params =
new URLSearchParams(
window.location.search
);

const refundId =
params.get(
"refundId"
) ||
params.get(
"id"
) ||
localStorage.getItem(
"lastRefundId"
);


/* =========================
   HELPERS
========================= */

function money(
value
){

  return (
    "TZS " +
    Number(
      value || 0
    ).toLocaleString()
  );

}


function formatDate(
value
){

  if(!value){
    return "—";
  }


  const date =
  new Date(
    Number(value)
  );


  if(
    Number.isNaN(
      date.getTime()
    )
  ){

    return String(
      value
    );

  }


  return date.toLocaleString(
    "en-TZ",
    {
      dateStyle:"medium",
      timeStyle:"short"
    }
  );

}


/* =========================
   STATUS UI
========================= */

function updateStatus(
status
){

  const normalized =
  String(
    status ||
    "pending"
  ).toLowerCase();


  const container =
  document.getElementById(
    "statusContainer"
  );

  const icon =
  document.getElementById(
    "statusIcon"
  );

  const title =
  document.getElementById(
    "statusTitle"
  );

  const description =
  document.getElementById(
    "statusDescription"
  );


  container.className =
  "status " +
  normalized;


  /*
   * Reset steps
   */

  const steps = [

    "stepSubmitted",
    "stepReview",
    "stepDecision",
    "stepRefunded"

  ];


  steps.forEach(
    id => {

      document
      .getElementById(
        id
      )
      .classList.remove(
        "active"
      );

    }
  );


  document
  .getElementById(
    "line1"
  )
  .classList.remove(
    "active"
  );

  document
  .getElementById(
    "line2"
  )
  .classList.remove(
    "active"
  );

  document
  .getElementById(
    "line3"
  )
  .classList.remove(
    "active"
  );


  /*
   * Submitted is always
   * completed once request
   * exists.
   */

  document
  .getElementById(
    "stepSubmitted"
  )
  .classList.add(
    "active"
  );


  document
  .getElementById(
    "line1"
  )
  .classList.add(
    "active"
  );


  /* =========================
     PENDING
  ========================= */

  if(
    normalized ===
    "pending"
  ){

    icon.textContent =
    "⏳";

    title.textContent =
    "Refund Pending";

    description.textContent =
    "Your refund request has been submitted and is waiting for review.";

    return;

  }


  /* =========================
     REVIEW
  ========================= */

  if(
    normalized ===
    "review" ||
    normalized ===
    "under_review"
  ){

    document
    .getElementById(
      "stepReview"
    )
    .classList.add(
      "active"
    );

    icon.textContent =
    "🔎";

    title.textContent =
    "Under Review";

    description.textContent =
    "Our team is currently reviewing your refund request.";

    return;

  }


  /* =========================
     APPROVED
  ========================= */

  if(
    normalized ===
    "approved"
  ){

    document
    .getElementById(
      "stepReview"
    )
    .classList.add(
      "active"
    );

    document
    .getElementById(
      "stepDecision"
    )
    .classList.add(
      "active"
    );

    document
    .getElementById(
      "line2"
    )
    .classList.add(
      "active"
    );

    icon.textContent =
    "✓";

    title.textContent =
    "Refund Approved";

    description.textContent =
    "Your refund has been approved and is being processed.";

    return;

  }


  /* =========================
     REFUNDED
  ========================= */

  if(
    normalized ===
    "refunded" ||
    normalized ===
    "completed"
  ){

    steps.forEach(
      id => {

        document
        .getElementById(
          id
        )
        .classList.add(
          "active"
        );

      }
    );


    document
    .getElementById(
      "line2"
    )
    .classList.add(
      "active"
    );

    document
    .getElementById(
      "line3"
    )
    .classList.add(
      "active"
    );


    icon.textContent =
    "✓";

    title.textContent =
    "Refund Completed";

    description.textContent =
    "Your refund has been processed successfully.";

    return;

  }


  /* =========================
     REJECTED
  ========================= */

  if(
    normalized ===
    "rejected" ||
    normalized ===
    "denied"
  ){

    document
    .getElementById(
      "stepReview"
    )
    .classList.add(
      "active"
    );

    document
    .getElementById(
      "stepDecision"
    )
    .classList.add(
      "active"
    );

    document
    .getElementById(
      "line2"
    )
    .classList.add(
      "active"
    );

    icon.textContent =
    "×";

    title.textContent =
    "Refund Rejected";

    description.textContent =
    "Your refund request was not approved. Please review the refund decision or contact support.";

  }

}


/* =========================
   LOAD REFUND
========================= */

async function loadRefund(
user
){

  if(!refundId){

    loading.style.display =
    "none";

    message.textContent =
    "Refund ID is missing.";

    message.className =
    "message error";

    return;

  }


  try{

    const snapshot =
    await get(
      ref(
        db,
        "refundRequests/" +
        refundId
      )
    );


    if(
      !snapshot.exists()
    ){

      loading.style.display =
      "none";

      message.textContent =
      "Refund request was not found.";

      message.className =
      "message error";

      return;

    }


    const refund =
    snapshot.val();


    /*
     * Security:
     * only owner can see
     * refund request.
     */

    if(
      refund.userId &&
      refund.userId !==
      user.uid
    ){

      loading.style.display =
      "none";

      message.textContent =
      "You do not have permission to view this refund request.";

      message.className =
      "message error";

      return;

    }


    /* =========================
       DATA
    ========================= */

    document.getElementById(
      "refundId"
    ).textContent =
    refund.refundId ||
    refundId;


    document.getElementById(
      "orderId"
    ).textContent =
    refund.orderId ||
    "—";


    document.getElementById(
      "courseName"
    ).textContent =
    refund.courseName ||
    "—";


    document.getElementById(
      "originalAmount"
    ).textContent =
    money(
      refund.originalAmount
    );


    document.getElementById(
      "requestedAmount"
    ).textContent =
    money(
      refund.requestedAmount
    );


    document.getElementById(
      "reason"
    ).textContent =
    refund.reason ||
    "—";


    document.getElementById(
      "createdAt"
    ).textContent =
    formatDate(
      refund.createdAt
    );


    document.getElementById(
      "updatedAt"
    ).textContent =
    formatDate(
      refund.updatedAt
    );


    updateStatus(
      refund.status
    );


    /*
     * Link order details.
     */

    if(
      refund.orderId
    ){

      document.getElementById(
        "orderBtn"
      ).href =
      "/order-details.html?orderId=" +
      encodeURIComponent(
        refund.orderId
      );

    }


    loading.style.display =
    "none";

    statusCard.style.display =
    "block";

    detailsCard.style.display =
    "block";

    actionsCard.style.display =
    "block";


  }catch(error){

    console.error(
      "Refund status error:",
      error
    );


    loading.style.display =
    "none";

    message.textContent =
    "Unable to load refund status. Please try again.";

    message.className =
    "message error";

  }

}


/* =========================
   AUTH
========================= */

onAuthStateChanged(
  auth,
  user => {

    if(!user){

      loginBox.style.display =
      "block";

      mainContent.style.display =
      "none";

      return;

    }


    loginBox.style.display =
    "none";

    mainContent.style.display =
    "block";


    loadRefund(
      user
    );

  }
);


/* =========================
   MOBILE MENU
========================= */

document
.getElementById(
"menuBtn"
