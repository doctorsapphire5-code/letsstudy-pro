<style>
:root{--ink:#0f1b3d;--text:#1c2740;--muted:#5b6785;--line:#e3e8f1;--paper:#f4f6fb;--blue:#2563eb;--blue-d:#1d4ed8;--tint:#eaf1ff}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;background:var(--paper);color:var(--text);line-height:1.65;padding-bottom:88px}
a{color:inherit;text-decoration:none}
a:focus-visible,button:focus-visible{outline:3px solid var(--blue);outline-offset:3px}

header{background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:100}
.nav{max-width:1200px;margin:auto;min-height:64px;padding:0 20px;display:flex;justify-content:space-between;align-items:center;gap:16px}
.logo{font-size:21px;font-weight:800;color:var(--ink);letter-spacing:-.3px}
.logo span{color:var(--blue)}
.cart{background:var(--tint);color:var(--blue);padding:9px 16px;border-radius:10px;font-weight:700;font-size:14px}
.cart:hover{background:#dbe8ff}

main{max-width:1100px;margin:28px auto;padding:0 20px}
.back{display:inline-block;margin-bottom:18px;color:var(--blue);font-weight:700}

.error{display:none;background:#fff;border:1px solid #fecaca;border-radius:18px;padding:44px 24px;text-align:center;color:#991b1b}
.error h2{margin-bottom:8px}
.error button{margin-top:18px;padding:12px 20px;border:0;border-radius:12px;background:var(--blue);color:#fff;cursor:pointer;font:inherit;font-weight:800}

/* Skeleton shown instantly, no "Loading..." text */
.sk-wrap{display:none}
.is-loading .sk-wrap{display:block}
.is-loading .real{display:none!important}
.sk{height:14px;margin:10px 0;border-radius:8px;background:linear-gradient(90deg,#e6ebf4 25%,#f3f6fb 40%,#e6ebf4 60%);background-size:300% 100%;animation:shimmer 1.4s linear infinite}
.sk.w30{width:30%}.sk.w40{width:40%}.sk.w60{width:60%}.sk.w80{width:80%}.sk.h-title{height:38px;width:75%;margin:14px 0}.sk.h-pill{height:26px;width:80px;border-radius:999px}.sk.h-btn{height:50px;border-radius:12px;margin-top:22px}.sk.h-img{height:100%;min-height:340px;border-radius:0;margin:0}
@keyframes shimmer{from{background-position:100% 0}to{background-position:-100% 0}}

.resource-card{background:#fff;border:1px solid var(--line);border-radius:22px;overflow:hidden;box-shadow:0 14px 40px rgba(15,27,61,.08)}
.hero{display:grid;grid-template-columns:1fr 1.2fr}
.thumbnail{min-height:360px;background:#e9eef8;display:flex;align-items:center;justify-content:center;overflow:hidden}
.thumbnail img{width:100%;height:100%;object-fit:cover;display:block}
.thumbnail-placeholder{font-size:70px}
.content{padding:36px}
.badge{display:inline-block;padding:6px 14px;border-radius:999px;font-size:13px;font-weight:800;margin-bottom:14px}
.badge.free{background:#dcfce7;color:#15803d}
.badge.plan{background:#ede9fe;color:#5b21b6}
h1{font-family:Georgia,"Times New Roman",serif;font-size:clamp(28px,4.5vw,38px);line-height:1.15;letter-spacing:-.4px;color:var(--ink);margin-bottom:14px;overflow-wrap:anywhere}
.description{color:var(--muted);margin-bottom:22px;white-space:pre-line;overflow-wrap:anywhere}
.meta{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-bottom:22px}
.meta-item{background:var(--paper);padding:13px 14px;border-radius:12px}
.meta-label{display:block;color:var(--muted);font-size:13px}
.meta-value{font-weight:700;color:var(--ink);overflow-wrap:anywhere}
.price{font-size:30px;font-weight:800;margin-bottom:16px;color:var(--ink)}
.btn{display:block;width:100%;border:0;padding:15px 20px;border-radius:12px;font:inherit;font-size:16px;font-weight:800;cursor:pointer;text-align:center;transition:background .2s}
.download-btn{background:#16a34a;color:#fff}
.download-btn:hover{background:#15803d}
.download-btn[disabled]{background:#cbd5e1;color:#64748b;cursor:not-allowed}
.cart-btn{background:var(--blue);color:#fff}
.cart-btn:hover{background:var(--blue-d)}
.share-btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;margin-top:10px;padding:13px;border-radius:12px;border:1px solid var(--line);background:#fff;color:var(--ink);font:inherit;font-weight:700;font-size:15px;cursor:pointer}
.share-btn:hover{background:var(--tint)}
.share-btn svg{width:18px;height:18px}

.lsp-rtl-inner{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;margin:30px 0 18px}
.lsp-rtl-button{display:inline-flex;align-items:center;justify-content:center;min-width:150px;padding:13px 24px;border-radius:999px;font-size:15px;font-weight:800;transition:transform .2s,box-shadow .2s}
.lsp-rtl-button:hover{transform:translateY(-3px);box-shadow:0 10px 24px rgba(15,27,61,.15)}
.lsp-related-button{background:var(--ink);color:#fff}
.lsp-trending-button{background:#fff;color:var(--ink);border:1px solid var(--line)}
.whatsapp-channel-btn{display:flex;width:fit-content;margin:0 auto;padding:13px 24px;border-radius:999px;background:#25d366;color:#073b1d;font-weight:800}
.lsp-quick-buttons{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin:22px auto;max-width:1100px;padding:0 20px}
.lsp-btn{display:inline-flex;align-items:center;gap:7px;padding:11px 17px;border-radius:10px;background:#fff;color:var(--ink);border:1px solid var(--line);font-size:14px;font-weight:600;transition:transform .2s}
.lsp-btn:hover{transform:translateY(-2px)}
.lsp-bottom-bar{position:fixed;left:0;right:0;bottom:0;z-index:99999;display:flex;gap:10px;padding:10px 12px calc(10px + env(safe-area-inset-bottom,0px));background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-top:1px solid var(--line)}
.lsp-bottom-item{flex:1;min-height:50px;display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;border-radius:12px;color:#fff;background:#1565c0;font-size:14px;text-align:center}
.lsp-bottom-item:last-child{background:var(--ink)}
.lsp-bottom-item span{font-size:18px}

.toast{position:fixed;left:50%;bottom:96px;transform:translate(-50%,20px);background:var(--ink);color:#fff;padding:11px 18px;border-radius:12px;font-size:14px;font-weight:600;opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;z-index:100000}
.toast.show{opacity:1;transform:translate(-50%,0)}
.ready .resource-card{animation:rise .45s ease both}
@keyframes rise{from{opacity:.4;transform:translateY(10px)}to{opacity:1;transform:none}}

@media(max-width:750px){
