  if(["free","public","free resource"].includes(a)) return false;
  if(["plan","premium","paid","pro"].includes(a)) return true;
  return d?.isPremium === true || d?.premium === true || d?.paid === true;
}
function priceOf(d){
  const n = Number(d?.price ?? d?.amount ?? d?.cost ?? d?.planPrice ?? 0);
  return Number.isFinite(n) ? n : 0;
}
const formatTZS = n => n > 0 ? "TZS " + new Intl.NumberFormat("en").format(n) : "Plan price";

/* ---------- Cart (localStorage resourceCart = array of ids) ---------- */
function getCart(){
  try{ const c = JSON.parse(localStorage.getItem("resourceCart") || "[]"); return Array.isArray(c) ? c : []; }catch(e){ return []; }
}
function updateCartLink(){ const n = getCart().length; $("cartLink").textContent = n ? "Cart (" + n + ")" : "Cart"; }
function addToCart(){
  const cart = getCart();
  if(cart.includes(resourceId)){ location.href = "resources-cart.html"; return; }
  cart.push(resourceId);
  try{ localStorage.setItem("resourceCart", JSON.stringify(cart)); }catch(e){ notify("Could not save to cart"); return; }
  updateCartLink();
  document.querySelectorAll(".cart-btn").forEach(markInCart);
  notify("Added to resource cart");
}
function markInCart(b){
  if(getCart().includes(resourceId)){ b.textContent = "In cart · View cart"; b.classList.add("in"); }
}
function buildAction(box, plan, fileUrl){
  box.replaceChildren();
  let n;
  if(plan){
    n = el("button", "btn btn-primary cart-btn", "Add to resource cart");
    n.type = "button"; n.addEventListener("click", addToCart); markInCart(n);
  }else if(fileUrl){
    n = el("a", "btn btn-green", "Free download");
    n.href = fileUrl; n.target = "_blank"; n.rel = "noopener noreferrer"; n.setAttribute("download", "");
  }else{
    n = el("button", "btn btn-green", "Download unavailable"); n.type = "button"; n.disabled = true;
  }
  box.appendChild(n);
}

/* ---------- Discover ---------- */
const ctx = { pairs: [] };
const lists = {};
async function run(...c){
  try{
    const snap = await getDocs(query(col, ...c));
    return snap.docs.map(d => ({ id: d.id, data: d.data() })).filter(x => x.id !== resourceId);
  }catch(e){ console.warn("Discover query failed:", e.message); return []; }
}
const LOADERS = {
  related: async () => {
    for(const [k, v] of ctx.pairs){ const r = await run(where(k, "==", v), limit(13)); if(r.length) return r; }
    return [];
  },
  trending: async () => {
    const r = (await run(orderBy("weekViews", "desc"), limit(20))).filter(x => x.data.weekKey === WK && Number(x.data.weekViews) > 0);
    return r.length ? r : LOADERS.popular();
  },
  featured: () => run(where("featured", "==", true), limit(13)),
  recent: async () => { const r = await run(orderBy("createdAt", "desc"), limit(13)); return r.length ? r : run(limit(13)); },
  popular: () => run(orderBy("views", "desc"), limit(13))
};
const EMPTY = {
  related: "No related resources yet.",
  trending: "Nothing is trending yet. Check back soon.",
  featured: "No featured resources right now.",
  recent: "No resources have been added yet.",
  popular: "Popular resources will appear as people explore them."
};
function card(item){
  const d = item.data, title = pick(d, K.title) || item.id, plan = isPlan(d);
  const a = el("a", "c");
  a.href = "resource-details.html?id=" + encodeURIComponent(item.id);
  const img = safeUrl(pick(d, K.thumb));
  if(img){
    const i = el("img"); i.loading = "lazy"; i.decoding = "async"; i.alt = title; i.src = img;
    i.onerror = () => i.replaceWith(el("div", "ph"));
    a.appendChild(i);
  }else a.appendChild(el("div", "ph"));
  const b = el("div", "c-b");
  const cat = pick(d, K.category);
  if(cat) b.appendChild(el("div", "c-cat", cat));
  b.appendChild(el("div", "c-t", title));
  const desc = clip(pick(d, K.tagline) || pick(d, K.description), 110);
  if(desc) b.appendChild(el("div", "c-d", desc));
  b.appendChild(el("div", "c-m" + (plan ? " plan" : ""), plan ? formatTZS(priceOf(d)) : "Free"));
  a.appendChild(b);
  return a;
}
function skeletons(){
  const g = $("grid"); g.replaceChildren();
  for(let i = 0; i < 4; i++){
    const c = el("div", "c");
    c.innerHTML = '<div class="ph" style="background:#e6ebf4"></div><div class="c-b"><div class="sk w40"></div><div class="sk"></div><div class="sk w60"></div></div>';
    g.appendChild(c);
  }
}
let current = "";
async function show(kind){
  current = kind;
  document.querySelectorAll(".tab").forEach(t => t.setAttribute("aria-selected", String(t.dataset.k === kind)));
  if(!lists[kind]){ skeletons(); lists[kind] = await LOADERS[kind](); }
  if(current !== kind) return;
  const g = $("grid"); g.replaceChildren();
  const items = lists[kind].slice(0, 12);
  if(!items.length){ g.appendChild(el("div", "empty", EMPTY[kind])); return; }
  items.forEach(i => g.appendChild(card(i)));
}
document.querySelectorAll(".tab").forEach(t => t.addEventListener("click", () => show(t.dataset.k)));
let discoverStarted = false;
async function startDiscover(){
  if(discoverStarted) return;
  discoverStarted = true;
  lists.related = await LOADERS.related();
  show(lists.related.length ? "related" : "trending");
}

/* ---------- Count a view once per session (feeds Trending and Most popular) ---------- */
let lastData = null;
function countView(){
  const k = "lsp:seen:res:" + resourceId;
  try{ if(sessionStorage.getItem(k)) return; sessionStorage.setItem(k, "1"); }catch(e){}
  const cur = lastData || {};
  const u = { views: increment(1), lastViewedAt: serverTimestamp() };
  if(cur.weekKey === WK) u.weekViews = increment(1); else { u.weekKey = WK; u.weekViews = 1; }
  updateDoc(doc(db, "resources", resourceId), u).catch(() => {});
}

/* ---------- Render ---------- */
function render(data){
  lastData = data;
  const title = pick(data, K.title) || "Untitled resource";
  const tagline = pick(data, K.tagline);
  const description = pick(data, K.description) || "No description available yet.";
  const category = pick(data, K.category);
  const thumbnail = safeUrl(pick(data, K.thumb));
  const fileUrl = safeUrl(pick(data, K.file));
  const plan = isPlan(data);

  document.title = title + " | Resource | LetsStudy Pro";
  $("title").textContent = title;
  $("tagline").textContent = tagline;
  $("tagline").style.display = tagline ? "" : "none";
  $("description").textContent = description;

  const badge = $("badge");
  badge.textContent = plan ? "PLAN" : "FREE";
  badge.className = "badge " + (plan ? "plan" : "free");
  $("featuredBadge").style.display = (data.featured === true || data.featured === "true") ? "inline-block" : "none";
  $("categoryBadge").textContent = category;
  $("categoryBadge").style.display = category ? "inline-block" : "none";
  $("viewsBadge").textContent = fmt(data.views) + " views";
  $("viewsBadge").style.display = Number(data.views) > 0 ? "inline-block" : "none";

  const img = $("thumb");
  if(thumbnail){
    img.alt = title; img.onerror = () => { img.style.display = "none"; };
    img.src = thumbnail; img.style.display = "block";
  }else img.style.display = "none";

  $("price").textContent = plan ? formatTZS(priceOf(data)) : "Free";
  $("priceNote").textContent = plan ? "Included with your plan. Add it to your cart to continue." : "No payment needed. Download instantly.";
  buildAction($("heroAction"), plan, fileUrl);
  buildAction($("asideAction"), plan, fileUrl);

  /* What's included */
  const inc = data[pickKey(data, K.includes)];
  const items = (Array.isArray(inc) ? inc.map(text) : text(inc).split(/\n+/)).map(s => s.trim()).filter(Boolean);
  const ul = $("includes"); ul.replaceChildren();
  items.forEach(s => ul.appendChild(el("li", "", s)));
  $("includesCard").style.display = items.length ? "block" : "none";

  /* Information list */
  const ext = (fileUrl.split("?")[0].match(/\.([a-z0-9]{2,5})$/i) || [])[1];
  const rows = [
    ["Category", category], ["Access", plan ? "Plan" : "Free"], ["Level", pick(data, K.level)],
    ["File type", pick(data, K.fileType) || (ext ? ext.toUpperCase() : "")], ["File size", pick(data, K.fileSize)],
    ["Pages", pick(data, K.pages)], ["Language", pick(data, K.language)], ["Author", pick(data, K.author)],
    ["Updated", dateOf(data.updatedAt || data.createdAt)]
  ].filter(r => r[1]);
  const list = $("infoList"); list.replaceChildren();
  rows.forEach(([l, v]) => {
    const it = el("div", "info-item");
    it.append(el("div", "info-label", l), el("div", "info-value", v));
    list.appendChild(it);
  });

  /* SEO + structured data */
  const desc = clip(tagline || description, 155);
  const canonical = location.origin + location.pathname + "?id=" + encodeURIComponent(resourceId);
  setMeta('meta[name="description"]', "content", desc);
  setMeta('meta[property="og:title"]', "content", document.title);
  setMeta('meta[property="og:description"]', "content", desc);
  setMeta('meta[property="og:url"]', "content", canonical);
  if(thumbnail){ setMeta('meta[property="og:image"]', "content", thumbnail); setMeta('meta[name="twitter:image"]', "content", thumbnail); }
  setMeta("#canonicalLink", "href", canonical);
  let ld = $("resourceLd");
  if(!ld){ ld = document.createElement("script"); ld.type = "application/ld+json"; ld.id = "resourceLd"; document.head.appendChild(ld); }
  ld.textContent = JSON.stringify({ "@context": "https://schema.org", "@type": "LearningResource", name: title, description: desc, url: canonical,
    isAccessibleForFree: !plan, ...(category && { educationalUse: category }), ...(thumbnail && { image: thumbnail }) });

  const ck = pickKey(data, K.category);
  ctx.pairs = ck ? [[ck, text(data[ck])]] : [];

  errorBox.style.display = "none";
  page.classList.remove("is-loading");
  page.classList.add("ready");
  startDiscover();
}

function showError(message){
  page.style.display = "none";
  errorBox.replaceChildren(el("h2", "", "Resource unavailable"), el("p", "", message));
  const b = el("button", "", "Go back"); b.type = "button";
  b.addEventListener("click", () => { if(history.length > 1) history.back(); else location.href = "resources.html"; });
  errorBox.appendChild(b);
  errorBox.style.display = "block";
  startDiscover();
}

function readCache(){
  try{ const c = JSON.parse(localStorage.getItem(CACHE_KEY) || "null"); return c && c.data ? c : null; }catch(e){ return null; }
}
function writeCache(data){ try{ localStorage.setItem(CACHE_KEY, JSON.stringify({ t: Date.now(), data })); }catch(e){} }

async function init(){
  updateCartLink();
  if(!resourceId){ showError("No resource was selected."); return; }
  const cached = readCache();
  if(cached) render(cached.data);
  try{
    const snap = await getDoc(doc(db, "resources", resourceId));
    if(!snap.exists()){
      try{ localStorage.removeItem(CACHE_KEY); }catch(e){}
      showError("This resource does not exist.");
      return;
    }
    const data = JSON.parse(JSON.stringify(snap.data() || {}));
    if(!cached || JSON.stringify(cached.data) !== JSON.stringify(data)) render(data);
    lastData = data;
    writeCache(data);
    countView();
  }catch(err){
    console.error("Resource loading error:", err);
    if(!cached) showError("We could not load this resource. Check your connection and try again.");
  }
}

/* ---------- Toast + Share ---------- */
const toast = $("toast");
let toastTimer;
function notify(m){
  toast.textContent = m; toast.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove("show"), 2200);
}
async function copyLink(url){
  try{ await navigator.clipboard.writeText(url); }
  catch(e){
    const t = document.createElement("textarea");
    t.value = url; t.style.position = "fixed"; t.style.opacity = "0";
    document.body.appendChild(t); t.select();
    try{ document.execCommand("copy"); }catch(_){}
    t.remove();
  }
  notify("Link copied");
}
$("shareBtn").addEventListener("click", async () => {
  const url = location.origin + location.pathname + "?id=" + encodeURIComponent(resourceId || "");
  const data = { title: ($("title").textContent || "Resource") + " | LetsStudy Pro", text: $("tagline").textContent || "Explore this resource on LetsStudy Pro", url };
  if(navigator.share){
    try{ await navigator.share(data); }catch(e){ if(e.name !== "AbortError") copyLink(url); }
  }else copyLink(url);
});
window.addEventListener("storage", updateCartLink);

init();
</script>
