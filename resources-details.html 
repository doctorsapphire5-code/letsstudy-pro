<script type="module">

  import {
    initializeApp
  } from "https://www.gstatic.com/firebasejs/10.12.5/firebase-app.js";

  import {
    getFirestore,
    doc,
    getDoc
  } from "https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore.js";

  const firebaseConfig = {
    apiKey: "AIzaSyBcOYDfAVK5XbkljsyRgI_0rj0odBn678tCc",
    authDomain: "let-s-study-pro-course.firebaseapp.com",
    databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
    projectId: "let-s-study-pro-course",
    storageBucket: "let-s-study-pro-course.firebasestorage.app",
    messagingSenderId: "474928293390",
    appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
    measurementId: "G-85B7V5H5J0"
  };

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);

  const params = new URLSearchParams(window.location.search);
  const resourceId = params.get("id");

  const loading = document.getElementById("loading");
  const container = document.getElementById("resourceContainer");

  let resource = null;

  function getTitle(data) {
    return (
      data.title ||
      data.name ||
      data.resourceTitle ||
      "Learning Resource"
    );
  }

  function getDescription(data) {
    return (
      data.description ||
      data.summary ||
      data.content ||
      data.details ||
      "Explore this learning resource."
    );
  }

  function getAccess(data) {

    const value =
      data.access ||
      data.accessType ||
      data.membership ||
      data.plan ||
      "";

    const text = String(value).toLowerCase();

    if (
      text === "free" ||
      text === "public" ||
      text === "free resource"
    ) {
      return "free";
    }

    if (
      text === "plan" ||
      text === "premium" ||
      text === "paid" ||
      text === "pro"
    ) {
      return "plan";
    }

    if (
      data.isPremium === true ||
      data.premium === true ||
      data.paid === true
    ) {
      return "plan";
    }

    return "free";
  }

  function getPrice(data) {

    const price =
      data.price ??
      data.amount ??
      data.cost ??
      data.planPrice ??
      0;

    const number = Number(price);

    return Number.isFinite(number) ? number : 0;
  }

  function getFileUrl(data) {

    return (
      data.fileUrl ||
      data.fileURL ||
      data.downloadUrl ||
      data.downloadURL ||
      data.pdfUrl ||
      data.pdfURL ||
      data.url ||
      data.link ||
      ""
    );
  }

  function getThumbnail(data) {

    return (
      data.thumbnail ||
      data.thumbnailUrl ||
      data.image ||
      data.imageUrl ||
      data.cover ||
      ""
    );
  }

  function getCategory(data) {

    return (
      data.category ||
      data.subject ||
      data.type ||
      "Learning Resource"
    );
  }

  function formatPrice(price) {

    if (!price || price <= 0) {
      return "Included in Plan";
    }

    return `${price.toLocaleString()} TZS`;
  }

  function getCart() {

    try {

      const stored =
        JSON.parse(
          localStorage.getItem("resourceCart") || "[]"
        );

      if (!Array.isArray(stored)) {
        return [];
      }

      return stored
        .map(item => {

          if (typeof item === "string") {
            return item;
          }

          if (item && item.id) {
            return item.id;
          }

          if (item && item.resourceId) {
            return item.resourceId;
          }

          return null;

        })
        .filter(Boolean);

    } catch {

      return [];

    }
  }

  function saveCart(cart) {

    const unique =
      [...new Set(cart)];

    localStorage.setItem(
      "resourceCart",
      JSON.stringify(unique)
    );

  }

  function addToCart() {

    let cart = getCart();

    if (!cart.includes(resourceId)) {
      cart.push(resourceId);
      saveCart(cart);
    }

    const message =
      document.getElementById("cartMessage");

    message.textContent =
      "Resource added to your cart.";

    message.className =
      "message success";

    setTimeout(() => {

      window.location.href =
        "resources-cart.html";

    }, 700);

  }

  function renderResource() {

    const title =
      getTitle(resource);

    const description =
      getDescription(resource);

    const access =
      getAccess(resource);

    const price =
      getPrice(resource);

    const fileUrl =
      getFileUrl(resource);

    const thumbnail =
      getThumbnail(resource);

    const category =
      getCategory(resource);

    document.title =
      `${title} | LetsStudy Pro`;

    const thumbnailHTML =
      thumbnail
        ? `<img src="${thumbnail}"
                alt="${escapeHtml(title)}"
                loading="lazy">`
        : `<div class="thumbnail-placeholder">📚</div>`;

    let actionHTML = "";

    if (access === "free") {

      if (fileUrl) {

        actionHTML = `
          <a
            href="${fileUrl}"
            target="_blank"
            rel="noopener"
            class="btn download-btn"
            download
          >
            Free Download
          </a>
        `;

      } else {

        actionHTML = `
          <button
            class="btn download-btn"
            disabled
          >
            Download Unavailable
          </button>
        `;

      }

    } else {

      actionHTML = `
        <button
          id="addCartBtn"
          class="btn cart-btn"
        >
          Add to Resource Cart
        </button>

        <div
          id="cartMessage"
          class="message"
        ></div>
      `;

    }

    container.innerHTML = `

      <section class="resource-card">

        <div class="hero">

          <div class="thumbnail">
            ${thumbnailHTML}
          </div>

          <div class="content">

            <span class="badge ${access}">
              ${access === "free" ? "FREE" : "PLAN"}
            </span>

            <h1>
              ${escapeHtml(title)}
            </h1>

            <p class="description">
              ${escapeHtml(description)}
            </p>

            <div class="meta">

              <div class="meta-item">
                <span class="meta-label">
                  Category
                </span>

                <span class="meta-value">
                  ${escapeHtml(category)}
                </span>
              </div>

              <div class="meta-item">
                <span class="meta-label">
                  Access
                </span>

                <span class="meta-value">
                  ${access === "free"
                    ? "Free"
                    : "Plan"}
                </span>
              </div>

            </div>

            ${
              access === "plan"
                ? `
                  <div class="price">
                    ${formatPrice(price)}
                  </div>
                `
                : ""
            }

            ${actionHTML}

          </div>

        </div>

      </section>
    `;

    const addCartBtn =
      document.getElementById("addCartBtn");

    if (addCartBtn) {

      addCartBtn.addEventListener(
        "click",
        addToCart
      );

    }

  }

  function escapeHtml(value) {

    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

  }

  async function loadResource() {

    try {

      if (!resourceId) {
        throw new Error(
          "Resource not found."
        );
      }

      const resourceRef =
        doc(
          db,
          "resources",
          resourceId
        );

      const snapshot =
        await getDoc(resourceRef);

      if (!snapshot.exists()) {

        throw new Error(
          "This resource does not exist."
        );

      }

      resource = {
        id: snapshot.id,
        ...snapshot.data()
      };

      loading.style.display = "none";

      renderResource();

    } catch (error) {

      console.error(error);

      loading.style.display = "none";

      container.innerHTML = `

        <div class="error-page">

          <div class="error-card">

            <h2>
              Resource unavailable
            </h2>

            <p>
              We could not load this resource.
            </p>

            <button
              onclick="history.back()"
            >
              Go Back
            </button>

          </div>

        </div>

      `;

    }

  }

  loadResource();

</script>

</body>
</html>