<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getFirestore, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

const app = initializeApp({
  apiKey: "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",
  authDomain: "let-s-study-pro-course.firebaseapp.com",
  databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
  projectId: "let-s-study-pro-course",
  storageBucket: "let-s-study-pro-course.firebasestorage.app",
  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
});
const db = getFirestore(app);

const resourceId = new URLSearchParams(location.search).get("id");
const $ = id => document.getElementById(id);
const page = $("page"), errorBox = $("error");
const CACHE_KEY = "lsp:resource:" + resourceId;

const text = v => (v === undefined || v === null) ? "" : String(v).trim();
function el(tag, cls, txt){ const e = document.createElement(tag); if(cls) e.className = cls; if(txt !== undefined) e.textContent = txt; return e; }
function pick(d, keys){ for(const k of keys){ const v = text(d?.[k]); if(v) return v; } return ""; }
/* Only http(s) links are allowed for images and downloads */
function safeUrl(v){
  const s = text(v);
  if(!s) return "";
  try{ const u = new URL(s, location.href); return /^https?:$/.test(u.protocol) ? u.href : ""; }catch(e){ return ""; }
}
function setMeta(sel, attr, val){ const e = document.querySelector(sel); if(e && val) e.setAttribute(attr, val); }
function clip(s, n){ s = text(s).replace(/\s+/g," "); return s.length > n ? s.slice(0, n-1).trimEnd() + "…" : s; }

function isPlan(d){
  const a = pick(d,["access","accessType","membership","plan"]).toLowerCase();
  if(["free","public","free resource"].includes(a)) return false;
  if(["plan","premium","paid","pro"].includes(a)) return true;
  return d?.isPremium === true || d?.premium === true || d?.paid === true;
}
function priceOf(d){
  const n = Number(d?.price ?? d?.amount ?? d?.cost ?? d?.planPrice ?? 0);
  return Number.isFinite(n) ? n : 0;
}
/* Plan prices are shown in Tanzanian shillings: TZS 50,000 */
const formatTZS = n => n > 0 ? "TZS " + n.toLocaleString("en-US", { maximumFractionDigits: 2 }) : "Included in plan";

/* Cart */
function getCart(){
  try{
    const s = JSON.parse(localStorage.getItem("resourceCart") || "[]");
    return Array.isArray(s) ? s.map(i => typeof i === "string" ? i : (i && (i.id || i.resourceId)) || null).filter(Boolean) : [];
  }catch(e){ return []; }
}
function updateCartLink(){
  const n = getCart().length;
  $("cartLink").textContent = n ? "Resource Cart (" + n + ")" : "Resource Cart";
}
function addToCart(){
  const cart = getCart();
  if(!cart.includes(resourceId)){
    cart.push(resourceId);
    try{ localStorage.setItem("resourceCart", JSON.stringify([...new Set(cart)])); }catch(e){}
  }
  updateCartLink();
  notify("Added to your cart");
  setTimeout(() => { location.href = "resources-cart.html"; }, 700);
}

function render(r){
  const title = pick(r,["title","name","resourceTitle"]) || "Learning Resource";
  const description = pick(r,["description","summary","content","details"]) || "Explore this learning resource.";
  const category = pick(r,["category","subject","type"]) || "Learning Resource";
  const fileUrl = safeUrl(pick(r,["fileUrl","fileURL","downloadUrl","downloadURL","pdfUrl","pdfURL","url","link"]));
  const thumb = safeUrl(pick(r,["thumbnail","thumbnailUrl","image","imageUrl","cover"]));
  const plan = isPlan(r);

  document.title = title + " | LetsStudy Pro";
  $("title").textContent = title;
  $("description").textContent = description;
  $("category").textContent = category;
  $("access").textContent = plan ? "Plan" : "Free";

  const badge = $("badge");
  badge.textContent = plan ? "PLAN" : "FREE";
  badge.className = "badge " + (plan ? "plan" : "free");

  const tb = $("thumbBox");
  tb.replaceChildren();
  if(thumb){
    const img = document.createElement("img");
    img.alt = title; img.decoding = "async";
    img.onerror = () => { tb.replaceChildren(el("div","thumbnail-placeholder","📚")); };
    img.src = thumb;
    tb.appendChild(img);
  }else{
    tb.appendChild(el("div","thumbnail-placeholder","📚"));
  }

  const price = $("price");
  price.style.display = plan ? "block" : "none";
  price.textContent = plan ? formatTZS(priceOf(r)) : "";

  const area = $("actionArea");
  area.replaceChildren();
  if(plan){
    const b = el("button","btn cart-btn","Add to resource cart");
    b.type = "button";
    b.addEventListener("click", addToCart);
    area.appendChild(b);
  }else if(fileUrl){
    const a = el("a","btn download-btn","Free download");
    a.href = fileUrl; a.target = "_blank"; a.rel = "noopener noreferrer"; a.setAttribute("download","");
    area.appendChild(a);
  }else{
    const b = el("button","btn download-btn","Download unavailable");
    b.disabled = true;
    area.appendChild(b);
  }

  const desc = clip(description, 155);
  setMeta('meta[name="description"]',"content",desc);
  setMeta('meta[property="og:title"]',"content",document.title);
  setMeta('meta[property="og:description"]',"content",desc);
  if(thumb){
    setMeta('meta[property="og:image"]',"content",thumb);
    setMeta('meta[name="twitter:image"]',"content",thumb);
  }
  setMeta("#canonicalLink","href",location.origin + location.pathname + "?id=" + encodeURIComponent(resourceId));

  errorBox.style.display = "none";
  page.classList.remove("is-loading");
  page.classList.add("ready");
}

function showError(message){
  page.style.display = "none";
  errorBox.replaceChildren(el("h2","","Resource unavailable"), el("p","",message));
  const b = el("button","","Go back"); b.type = "button";
  b.addEventListener("click", () => { if(history.length > 1) history.back(); else location.href = "resources.html"; });
  errorBox.appendChild(b);
  errorBox.style.display = "block";
}

function readCache(){
  try{ const c = JSON.parse(localStorage.getItem(CACHE_KEY) || "null"); return c && c.data ? c : null; }catch(e){ return null; }
}
function writeCache(data){
  try{ localStorage.setItem(CACHE_KEY, JSON.stringify({ t: Date.now(), data })); }catch(e){}
}

async function init(){
  updateCartLink();
  if(!resourceId){ showError("No resource was selected."); return; }

  const cached = readCache();
  if(cached) render(cached.data);
  if(cached && Date.now() - cached.t < 60000) return;

  try{
    const snap = await getDoc(doc(db, "resources", resourceId));
    if(!snap.exists()){
      try{ localStorage.removeItem(CACHE_KEY); }catch(e){}
      showError("This resource does not exist.");
      return;
    }
    const data = JSON.parse(JSON.stringify(snap.data() || {}));
    if(!cached || JSON.stringify(cached.data) !== JSON.stringify(data)) render(data);
    writeCache(data);
  }catch(err){
    console.error("Resource loading error:", err);
    if(!cached) showError("We could not load this resource. Check your connection and try again.");
  }
}

/* Share: native sheet on phones, copy link elsewhere */
const toast = el("div","toast"); toast.setAttribute("role","status");
document.body.appendChild(toast);
let toastTimer;
function notify(msg){
  toast.textContent = msg; toast.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => toast.classList.remove("show"), 2200);
}
async function copyLink(url){
  try{ await navigator.clipboard.writeText(url); }
  catch(e){
    const t = document.createElement("textarea");
    t.value = url; t.style.position = "fixed"; t.style.opacity = "0";
    document.body.appendChild(t); t.select();
    try{ document.execCommand("copy"); }catch(_){}
    t.remove();
  }
  notify("Link copied");
}
$("shareBtn").addEventListener("click", async () => {
  const url = location.origin + location.pathname + "?id=" + encodeURIComponent(resourceId || "");
  const data = {
    title: ($("title").textContent || "Resource") + " | LetsStudy Pro",
    text: clip($("description").textContent || "Learning resource on LetsStudy Pro", 120),
    url
  };
  if(navigator.share){
    try{ await navigator.share(data); }
    catch(e){ if(e.name !== "AbortError") copyLink(url); }
  }else{
    copyLink(url);
  }
});

init();
</script>

