        "accessType",
        "membership",
        "plan"
      ]
    ).toLowerCase();


  if(
    [
      "free",
      "public",
      "free resource"
    ].includes(access)
  ){

    return false;

  }


  if(
    [
      "plan",
      "premium",
      "paid",
      "pro"
    ].includes(access)
  ){

    return true;

  }


  return (
    data?.isPremium === true ||
    data?.premium === true ||
    data?.paid === true
  );

}


/* =========================
   PRICE
========================= */

function priceOf(data){

  const number =
    Number(
      data?.price ??
      data?.amount ??
      data?.cost ??
      data?.planPrice ??
      0
    );

  return Number.isFinite(number)
    ? number
    : 0;

}


const formatTZS =
  number =>
    number > 0
      ? "TZS " +
        number.toLocaleString(
          "en-US",
          {
            maximumFractionDigits: 2
          }
        )
      : "Included in plan";


/* =========================
   CART
========================= */

function getCart(){

  try{

    const saved =
      JSON.parse(
        localStorage.getItem(
          "resourceCart"
        ) || "[]"
      );

    return Array.isArray(saved)

      ? saved
          .map(item =>
            typeof item === "string"
              ? item
              : (
                  item &&
                  (
                    item.id ||
                    item.resourceId
                  )
                ) || null
          )
          .filter(Boolean)

      : [];

  }catch(error){

    return [];

  }

}


function updateCartLink(){

  const count =
    getCart().length;

  $("cartLink").textContent =
    count
      ? "Resource Cart (" + count + ")"
      : "Resource Cart";

}


function addToCart(){

  const cart =
    getCart();

  if(!cart.includes(resourceId)){

    cart.push(resourceId);

    try{

      localStorage.setItem(
        "resourceCart",
        JSON.stringify(
          [...new Set(cart)]
        )
      );

    }catch(error){}

  }

  updateCartLink();

  notify(
    "Added to your cart"
  );

  setTimeout(
    () => {
      location.href =
        "resources-cart.html";
    },
    700
  );

}


/* =========================
   RENDER RESOURCE
========================= */

function render(data){

  const title =
    pick(
      data,
      [
        "title",
        "name",
        "resourceTitle"
      ]
    ) ||
    "Learning Resource";


  const description =
    pick(
      data,
      [
        "description",
        "summary",
        "content",
        "details"
      ]
    ) ||
    "Explore this learning resource.";


  const category =
    pick(
      data,
      [
        "category",
        "subject",
        "type"
      ]
    ) ||
    "Learning Resource";


  const fileUrl =
    safeUrl(
      pick(
        data,
        [
          "fileUrl",
          "fileURL",
          "downloadUrl",
          "downloadURL",
          "pdfUrl",
          "pdfURL",
          "url",
          "link"
        ]
      )
    );


  const thumbnail =
    safeUrl(
      pick(
        data,
        [
          "thumbnail",
          "thumbnailUrl",
          "image",
          "imageUrl",
          "cover"
        ]
      )
    );


  const plan =
    isPlan(data);


  /* =========================
     PAGE TITLE
  ========================= */

  document.title =
    title +
    " | LetsStudy Pro";


  /* =========================
     RESOURCE TEXT
  ========================= */

  $("title").textContent =
    title;

  $("description").textContent =
    description;

  $("category").textContent =
    category;

  $("access").textContent =
    plan
      ? "Plan"
      : "Free";


  /* =========================
     BADGE
  ========================= */

  const badge =
    $("badge");

  badge.textContent =
    plan
      ? "PLAN"
      : "FREE";

  badge.className =
    "badge " +
    (
      plan
        ? "plan"
        : "free"
    );


  /* =========================
     THUMBNAIL
  ========================= */

  const thumbBox =
    $("thumbBox");

  thumbBox.replaceChildren();


  if(thumbnail){

    const img =
      document.createElement(
        "img"
      );

    img.alt =
      title;

    img.decoding =
      "async";

    img.loading =
      "eager";

    img.onerror =
      () => {

        thumbBox.replaceChildren(
          el(
            "div",
            "thumbnail-placeholder",
            "📚"
          )
        );

      };

    img.src =
      thumbnail;

    thumbBox.appendChild(
      img
    );

  }else{

    thumbBox.appendChild(
      el(
        "div",
        "thumbnail-placeholder",
        "📚"
      )
    );

  }


  /* =========================
     PRICE
  ========================= */

  const price =
    $("price");

  price.style.display =
    plan
      ? "block"
      : "none";

  price.textContent =
    plan
      ? formatTZS(
          priceOf(data)
        )
      : "";


  /* =========================
     ACTION AREA
  ========================= */

  const actionArea =
    $("actionArea");

  actionArea.replaceChildren();


  if(plan){

    const button =
      el(
        "button",
        "btn cart-btn",
        "Add to resource cart"
      );

    button.type =
      "button";

    button.addEventListener(
      "click",
      addToCart
    );

    actionArea.appendChild(
      button
    );

  }else if(fileUrl){

    const link =
      el(
        "a",
        "btn download-btn",
        "Free download"
      );

    link.href =
      fileUrl;

    link.target =
      "_blank";

    link.rel =
      "noopener noreferrer";

    link.setAttribute(
      "download",
      ""
    );

    actionArea.appendChild(
      link
    );

  }else{

    const button =
      el(
        "button",
        "btn download-btn",
        "Download unavailable"
      );

    button.type =
      "button";

    button.disabled =
      true;

    actionArea.appendChild(
      button
    );

  }


  /* =========================
     SEO
  ========================= */

  const metaDescription =
    clip(
      description,
      155
    );


  setMeta(
    'meta[name="description"]',
    "content",
    metaDescription
  );


  setMeta(
    'meta[property="og:title"]',
    "content",
    document.title
  );


  setMeta(
    'meta[property="og:description"]',
    "content",
    metaDescription
  );


  if(thumbnail){

    setMeta(
      'meta[property="og:image"]',
      "content",
      thumbnail
    );

    setMeta(
      'meta[name="twitter:image"]',
      "content",
      thumbnail
    );

  }


  /* =========================
     CANONICAL
  ========================= */

  if(resourceId){

    setMeta(
      "#canonicalLink",
      "href",
      location.origin +
      location.pathname +
      "?id=" +
      encodeURIComponent(
        resourceId
      )
    );

  }


  /* =========================
     SHOW RESOURCE
  ========================= */

  errorBox.style.display =
    "none";

  page.style.display =
    "block";

}


/* =========================
   ERROR
========================= */

function showError(message){

  page.style.display =
    "none";


  errorBox.replaceChildren(

    el(
      "h2",
      "",
      "Resource unavailable"
    ),

    el(
      "p",
      "",
      message
    )

  );


  const button =
    el(
      "button",
      "",
      "Go back"
    );

  button.type =
    "button";


  button.addEventListener(
    "click",
    () => {

      if(history.length > 1){

        history.back();

      }else{

        location.href =
          "resources.html";

      }

    }
  );


  errorBox.appendChild(
    button
  );


  errorBox.style.display =
    "block";

}


/* =========================
   CACHE
========================= */

function readCache(){

  try{

    const cached =
      JSON.parse(
        localStorage.getItem(
          CACHE_KEY
        ) || "null"
      );

    return (
      cached &&
      cached.data
    )
      ? cached
      : null;

  }catch(error){

    return null;

  }

}


function writeCache(data){

  try{

    localStorage.setItem(
      CACHE_KEY,
      JSON.stringify({
        t: Date.now(),
        data: data
      })
    );

  }catch(error){}

}


/* =========================
   INIT
========================= */

async function init(){

  updateCartLink();


  if(!resourceId){

    showError(
      "No resource was selected."
    );

    return;

  }


  /* =========================
     READ CACHE FIRST
  ========================= */

  const cached =
    readCache();


  if(cached){

    render(
      cached.data
    );

  }


  /*
   * If cache is less than
   * 60 seconds old, use it.
   */

  if(
    cached &&
    Date.now() - cached.t < 60000
  ){

    return;

  }


  /* =========================
     FIRESTORE
  ========================= */

  try{

    const snapshot =
      await getDoc(
        doc(
          db,
          "resources",
          resourceId
        )
      );


    if(!snapshot.exists()){

      try{

        localStorage.removeItem(
          CACHE_KEY
        );

      }catch(error){}


      showError(
        "This resource does not exist."
      );

      return;

    }


    const data =
      JSON.parse(
        JSON.stringify(
          snapshot.data() || {}
        )
      );


    /*
     * Update page only when
     * Firestore data is different.
     */

    if(
      !cached ||
      JSON.stringify(
        cached.data
      ) !==
      JSON.stringify(data)
    ){

      render(data);

    }


    writeCache(data);


  }catch(error){

    console.error(
      "Resource loading error:",
      error
    );


    /*
     * If cached data exists,
     * keep showing it.
     */

    if(!cached){

      showError(
        "We could not load this resource. Check your connection and try again."
      );

    }

  }

}


/* =========================
   TOAST
========================= */

const toast =
  $("toast");


let toastTimer;


function notify(message){

  toast.textContent =
    message;

  toast.classList.add(
    "show"
  );


  clearTimeout(
    toastTimer
  );


  toastTimer =
    setTimeout(
      () => {

        toast.classList.remove(
          "show"
        );

      },
      2200
    );

}


/* =========================
   COPY LINK
========================= */

async function copyLink(url){

  try{

    await navigator.clipboard.writeText(
      url
    );

  }catch(error){

    const textarea =
      document.createElement(
        "textarea"
      );

    textarea.value =
      url;

    textarea.style.position =
      "fixed";

    textarea.style.opacity =
      "0";

    document.body.appendChild(
      textarea
    );

    textarea.select();


    try{

      document.execCommand(
        "copy"
      );

    }catch(_){}


    textarea.remove();

  }


  notify(
    "Link copied"
  );

}


/* =========================
   SHARE BUTTON
========================= */

$("shareBtn").addEventListener(
  "click",
  async () => {

    const url =
      location.origin +
      location.pathname +
      "?id=" +
      encodeURIComponent(
        resourceId || ""
      );


    const shareData = {

      title:
        (
          $("title").textContent ||
          "Resource"
        ) +
        " | LetsStudy Pro",

      text:
        clip(
          $("description").textContent ||
          "Learning resource on LetsStudy Pro",
          120
        ),

      url:
        url

    };


    if(
      navigator.share
    ){

      try{

        await navigator.share(
          shareData
        );

      }catch(error){

        if(
          error.name !==
          "AbortError"
        ){

          copyLink(url);

        }

      }

    }else{

      copyLink(url);

    }

  }
);


/* =========================
   START PAGE
========================= */

init();

