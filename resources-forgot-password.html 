<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0f172a">
<title>Forgot Password | Vorix Resources</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f1f5f9;
  color:#172033;
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
}
.container{
  width:100%;
  max-width:430px;
  background:white;
  padding:30px 25px;
  border-radius:16px;
  box-shadow:0 5px 25px #0f172a12;
}
.logo{
  width:60px;
  height:60px;
  border-radius:14px;
  background:#eff6ff;
  color:#2563eb;
  display:flex;
  justify-content:center;
  align-items:center;
  font-size:28px;
  margin:0 auto 18px;
}
h1{text-align:center;font-size:23px;margin:0 0 10px}
.subtitle{
  text-align:center;
  color:#64748b;
  font-size:14px;
  line-height:1.6;
  margin-bottom:25px;
}
label{
  display:block;
  font-size:13px;
  font-weight:bold;
  margin-bottom:8px;
}
input{
  width:100%;
  padding:14px;
  border:1px solid #cbd5e1;
  border-radius:9px;
  font-size:15px;
  margin-bottom:16px;
}
input:focus{
  outline:none;
  border-color:#2563eb;
  box-shadow:0 0 0 3px #2563eb15;
}
button{
  width:100%;
  padding:14px;
  background:#2563eb;
  color:white;
  border:0;
  border-radius:9px;
  font-weight:bold;
  font-size:15px;
  cursor:pointer;
}
button:disabled{opacity:.6;cursor:not-allowed}
.message{
  display:none;
  padding:12px;
  border-radius:8px;
  font-size:13px;
  line-height:1.5;
  margin-bottom:17px;
}
.success{display:block;background:#dcfce7;color:#166534}
.error{display:block;background:#fee2e2;color:#991b1b}
.links{text-align:center;margin-top:22px;font-size:13px}
.links a{color:#2563eb;text-decoration:none;font-weight:bold}
.links p{margin:12px 0}
footer{
  text-align:center;
  color:#94a3b8;
  font-size:11px;
  margin-top:25px;
}
</style>
</head>

<body>

<div class="container">

  <div class="logo">🔐</div>

  <h1>Forgot Password?</h1>

  <p class="subtitle">
    Enter your registered email address. We will send you a secure
    password reset link.
  </p>

  <div id="message" class="message" aria-live="polite"></div>

  <form id="forgotForm">

    <label for="email">Email Address</label>

    <input
      type="email"
      id="email"
      placeholder="Enter your email address"
      autocomplete="email"
      required
    >

    <button type="submit" id="submitBtn">
      Send Reset Link
    </button>

  </form>

  <div class="links">
    <p><a href="resources-login.html">← Back to Login</a></p>
    <p>Don't have an account?
      <a href="resources-register.html">Create Account</a>
    </p>
  </div>

  <footer>
    &copy; <span id="year"></span> Vorix Resources. All rights reserved.
  </footer>

</div>

<script type="module">

import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

import {
  getAuth,
  sendPasswordResetEmail
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

const firebaseConfig = {
  apiKey: "AIzaSyBuP13ggQsiZiZgoIf9nFK8hmw8Bx6KYr0",
  authDomain: "vorix-resources.firebaseapp.com",
  projectId: "vorix-resources",
  storageBucket: "vorix-resources.firebasestorage.app",
  messagingSenderId: "789688947048",
  appId: "1:789688947048:web:31598720b1e0cef9db06dd",
  measurementId: "G-VEYGNMJ6N1"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);

const form = document.getElementById("forgotForm");
const emailInput = document.getElementById("email");
const submitBtn = document.getElementById("submitBtn");
const messageBox = document.getElementById("message");

document.getElementById("year").textContent =
  new Date().getFullYear();

function showMessage(message,type){
  messageBox.textContent = message;
  messageBox.className = "message " + type;
}

form.addEventListener("submit",async event=>{

  event.preventDefault();

  const email = emailInput.value.trim().toLowerCase();

  if(!email){
    showMessage("Please enter your email address.","error");
    return;
  }

  submitBtn.disabled = true;
  submitBtn.textContent = "Sending...";

  try{

    const actionCodeSettings = {
      url: window.location.origin + "/resources-login.html",
      handleCodeInApp: false
    };

    await sendPasswordResetEmail(
      auth,
      email,
      actionCodeSettings
    );

    showMessage(
      "If an account exists for this email, a password reset link has been sent. Please check your inbox and spam folder.",
      "success"
    );

    form.reset();

  }catch(error){

    console.error("Password reset error:",error);

    // Generic response to avoid revealing registered emails.
    if(
      error.code === "auth/user-not-found" ||
      error.code === "auth/invalid-email" ||
      error.code === "auth/too-many-requests" ||
      error.code === "auth/network-request-failed"
    ){
      showMessage(
        "We could not complete the request. Check your email and internet connection, then try again.",
        "error"
      );
    }else{
      showMessage(
        "Unable to send the reset link right now. Please try again later.",
        "error"
      );
    }

  }finally{
    submitBtn.disabled = false;
    submitBtn.textContent = "Send Reset Link";
  }

});

</script>

</body>
</html>