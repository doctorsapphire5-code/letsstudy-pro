<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#101827">
<title>My Profile | Vorix Resources</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
  background:#f3f6fb;color:#182235;
  font-family:Arial,sans-serif;
}
header{
  background:#101827;color:#fff;
  padding:17px 20px;
  display:flex;justify-content:space-between;
  align-items:center;gap:12px;flex-wrap:wrap;
}
header h2{font-size:19px}
header a{color:#fff;text-decoration:none;font-size:13px}
.container{max-width:950px;margin:25px auto;padding:0 15px}
.card{
  background:#fff;border-radius:15px;
  padding:23px;margin-bottom:18px;
  box-shadow:0 5px 25px rgba(0,0,0,.045);
}
.profile-top{
  display:flex;align-items:center;
  gap:18px;flex-wrap:wrap;
}
.avatar{
  width:90px;height:90px;border-radius:50%;
  background:#eaf1ff;color:#2563eb;
  display:flex;align-items:center;
  justify-content:center;font-size:30px;
  font-weight:bold;overflow:hidden;
}
.avatar img{width:100%;height:100%;object-fit:cover}
.profile-info{flex:1;min-width:180px}
.profile-info h1{font-size:23px;margin-bottom:7px}
.profile-info p{font-size:13px;color:#718096;margin-bottom:5px}
.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:15px}
.btn{
  display:inline-block;padding:11px 15px;
  border-radius:8px;text-decoration:none;
  font-size:13px;font-weight:600;
}
.primary{background:#2563eb;color:#fff}
.secondary{background:#edf2f8;color:#263449}
.status{
  display:inline-block;padding:6px 10px;
  border-radius:20px;font-size:11px;
  font-weight:700;background:#e7f8ee;color:#16733b;
}
.status.inactive{background:#fff1e6;color:#a34d0a}
.status.suspended,.status.banned{background:#fff0f0;color:#bd2525}
.section-title{
  font-size:17px;margin-bottom:18px;
}
.grid{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:18px;
}
.item label{
  display:block;font-size:11px;
  color:#8490a1;margin-bottom:6px;
  text-transform:uppercase;letter-spacing:.4px;
}
.item p{
  font-size:14px;line-height:1.5;
  font-weight:600;overflow-wrap:anywhere;
}
.verification{
  display:flex;gap:8px;align-items:center;
  font-size:13px;font-weight:600;
}
.verified{color:#16834a}
.unverified{color:#b66b12}
.loading{text-align:center;padding:40px;color:#718096}
.message{
  display:none;padding:14px;border-radius:9px;
  margin-bottom:15px;font-size:13px;
}
.error{display:block;background:#fff0f0;color:#bd2525}
.empty{color:#8792a3;font-weight:400!important}
footer{text-align:center;padding:25px;color:#8792a3;font-size:12px}
@media(max-width:600px){
  .grid{grid-template-columns:1fr}
  .card{padding:18px}
  .profile-info h1{font-size:20px}
}
</style>
</head>

<body>

<header>
  <h2>Vorix Resources</h2>
  <a href="resources-dashboard.html">← Dashboard</a>
</header>

<main class="container">

  <div id="message" class="message"></div>

  <div id="loading" class="loading">
    Loading your profile...
  </div>

  <div id="profileContent" style="display:none">

    <section class="card">
      <div class="profile-top">

        <div class="avatar" id="avatar">U</div>

        <div class="profile-info">
          <h1 id="displayName">User</h1>
          <p id="email">Loading...</p>
          <p id="username">@username</p>
          <span id="status" class="status">Active</span>
        </div>

      </div>

      <div class="actions">
        <a href="resources-edit-profile.html" class="btn primary">
          Edit Profile
        </a>

        <a href="resources-account.html" class="btn secondary">
          Account Management
        </a>

        <a href="resources-settings.html" class="btn secondary">
          Settings
        </a>
      </div>
    </section>

    <section class="card">
      <h3 class="section-title">Personal Information</h3>

      <div class="grid">
        <div class="item">
          <label>First Name</label>
          <p id="firstName"></p>
        </div>

        <div class="item">
          <label>Last Name</label>
          <p id="lastName"></p>
        </div>

        <div class="item">
          <label>Full Name</label>
          <p id="fullName"></p>
        </div>

        <div class="item">
          <label>Username</label>
          <p id="usernameValue"></p>
        </div>

        <div class="item">
          <label>Date of Birth</label>
          <p id="dateOfBirth"></p>
        </div>

        <div class="item">
          <label>Gender</label>
          <p id="gender"></p>
        </div>

        <div class="item">
          <label>Phone Number</label>
          <p id="phoneNumber"></p>
        </div>

        <div class="item">
          <label>Account Type</label>
          <p id="accountType"></p>
        </div>
      </div>
    </section>

    <section class="card">
      <h3 class="section-title">Contact & Location</h3>

      <div class="grid">
        <div class="item">
          <label>Email Address</label>
          <p id="emailValue"></p>
        </div>

        <div class="item">
          <label>Country</label>
          <p id="country"></p>
        </div>

        <div class="item">
          <label>Region</label>
          <p id="region"></p>
        </div>

        <div class="item">
          <label>City</label>
          <p id="city"></p>
        </div>

        <div class="item">
          <label>Address</label>
          <p id="address"></p>
        </div>

        <div class="item">
          <label>Postal Code</label>
          <p id="postalCode"></p>
        </div>
      </div>
    </section>

    <section class="card">
      <h3 class="section-title">Professional Information</h3>

      <div class="grid">
        <div class="item">
          <label>Education Level</label>
          <p id="educationLevel"></p>
        </div>

        <div class="item">
          <label>Occupation</label>
          <p id="occupation"></p>
        </div>

        <div class="item">
          <label>Organization</label>
          <p id="organizationName"></p>
        </div>

        <div class="item">
          <label>Website</label>
          <p id="website"></p>
        </div>

        <div class="item">
          <label>Skills</label>
          <p id="skills"></p>
        </div>

        <div class="item">
          <label>Interests</label>
          <p id="interests"></p>
        </div>
      </div>

      <div class="item" style="margin-top:20px">
        <label>Biography</label>
        <p id="bio"></p>
      </div>
    </section>

    <section class="card">
      <h3 class="section-title">Account Verification</h3>

      <div class="grid">
        <div class="item">
          <label>Email Verification</label>
          <div id="emailVerification" class="verification"></div>
        </div>

        <div class="item">
          <label>Phone Verification</label>
          <div id="phoneVerification" class="verification"></div>
        </div>

        <div class="item">
          <label>Authentication Provider</label>
          <p id="provider"></p>
        </div>

        <div class="item">
          <label>Account Status</label>
          <p id="accountStatus"></p>
        </div>
      </div>
    </section>

    <section class="card">
      <h3 class="section-title">Account Activity</h3>

      <div class="grid">
        <div class="item">
          <label>Account Created</label>
          <p id="createdAt"></p>
        </div>

        <div class="item">
          <label>Last Login</label>
          <p id="lastLoginAt"></p>
        </div>

        <div class="item">
          <label>Login Count</label>
          <p id="loginCount"></p>
        </div>

        <div class="item">
          <label>Preferred Language</label>
          <p id="language"></p>
        </div>

        <div class="item">
          <label>Timezone</label>
          <p id="timezone"></p>
        </div>

        <div class="item">
          <label>Notifications</label>
          <p id="notificationsEnabled"></p>
        </div>
      </div>
    </section>

  </div>
</main>

<footer>
  © <span id="year"></span> Vorix Resources. All rights reserved.
</footer>

<script type="module">
import { initializeApp } from
  "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

import {
  getAuth,
  onAuthStateChanged
} from
  "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

import {
  getFirestore,
  doc,
  getDoc
} from
  "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

const firebaseConfig = {
  apiKey: "AIzaSyBuP13ggQsiZiZgoIf9nFK8hmw8Bx6KYr0",
  authDomain: "vorix-resources.firebaseapp.com",
  projectId: "vorix-resources",
  storageBucket: "vorix-resources.firebasestorage.app",
  messagingSenderId: "789688947048",
  appId: "1:789688947048:web:31598720b1e0cef9db06dd",
  measurementId: "G-VEYGNMJ6N1"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

const loading = document.getElementById("loading");
const content = document.getElementById("profileContent");
const message = document.getElementById("message");

document.getElementById("year").textContent =
  new Date().getFullYear();

function showError(text){
  loading.style.display = "none";
  message.textContent = text;
  message.className = "message error";
}

function display(id,value){
  const element = document.getElementById(id);

  if(value === null || value === undefined || value === ""){
    element.textContent = "Not provided";
    element.classList.add("empty");
  }else{
    element.textContent = String(value);
    element.classList.remove("empty");
  }
}

function formatDate(value){
  if(!value) return "Not available";

  let date;

  if(value.toDate && typeof value.toDate === "function"){
    date = value.toDate();
  }else if(typeof value === "string" || typeof value === "number"){
    date = new Date(value);
  }else{
    return "Not available";
  }

  if(Number.isNaN(date.getTime())) return "Not available";

  return new Intl.DateTimeFormat("en-GB",{
    dateStyle:"medium",
    timeStyle:"short"
  }).format(date);
}

function verification(id,verified){
  const element = document.getElementById(id);
  element.textContent = verified ? "✓ Verified" : "Not verified";
  element.className = "verification " +
    (verified ? "verified" : "unverified");
}

function formatList(value){
  if(Array.isArray(value)){
    return value.length ? value.join(", ") : "Not provided";
  }
  if(typeof value === "string"){
    return value || "Not provided";
  }
  return "Not provided";
}

onAuthStateChanged(auth,async(user)=>{

  if(!user){
    location.replace("resources-login.html");
    return;
  }

  try{
    const userRef = doc(db,"users",user.uid);
    const snapshot = await getDoc(userRef);

    if(!snapshot.exists()){
      showError(
        "Your user profile was not found. Please contact support."
      );
      return;
    }

    const data = snapshot.data();

    if(
      data.userId !== user.uid ||
      (data.email || "").toLowerCase() !==
      (user.email || "").toLowerCase()
    ){
      showError("Your account information could not be verified.");
      return;
    }

    const status = String(data.status || "unknown").toLowerCase();

    if(status !== "active"){
      showError(
        "Your account is not active. Please contact support."
      );
      return;
    }

    const name = data.displayName ||
      data.fullName ||
      user.displayName ||
      "User";

    display("displayName",name);
    display("email",user.email);
    display("username","@" + (data.username || "Not provided"));

    display("firstName",data.firstName);
    display("lastName",data.lastName);
    display("fullName",data.fullName);
    display("usernameValue",data.username);
    display("dateOfBirth",data.dateOfBirth);
    display("gender",data.gender);
    display("phoneNumber",data.phoneNumber);
    display("accountType",data.accountType);

    display("emailValue",user.email);
    display("country",data.country);
    display("region",data.region);
    display("city",data.city);
    display("address",data.address);
    display("postalCode",data.postalCode);

    display("educationLevel",data.educationLevel);
    display("occupation",data.occupation);
    display("organizationName",data.organizationName);
    display("website",data.website);
    display("skills",formatList(data.skills));
    display("interests",formatList(data.interests));
    display("bio",data.bio);

    display("provider",data.provider || "password");
    display("accountStatus",status);
    display("createdAt",formatDate(data.createdAt));
    display("lastLoginAt",formatDate(data.lastLoginAt));
    display("loginCount",data.loginCount ?? 0);
    display("language",data.language || "English");
    display("timezone",data.timezone || "Not provided");
    display(
      "notificationsEnabled",
      data.notificationsEnabled === false ? "Disabled" : "Enabled"
    );

    verification("emailVerification",user.emailVerified);
    verification("phoneVerification",data.phoneVerified === true);

    const avatar = document.getElementById("avatar");

    if(data.photoURL || user.photoURL){
      const img = document.createElement("img");
      img.src = data.photoURL || user.photoURL;
      img.alt = "Profile photo";
      img.onerror = ()=>{
        avatar.textContent = name.charAt(0).toUpperCase();
      };
      avatar.replaceChildren(img);
    }else{
      avatar.textContent = name.charAt(0).toUpperCase();
    }

    const statusElement = document.getElementById("status");
    statusElement.textContent =
      status.charAt(0).toUpperCase() + status.slice(1);
    statusElement.className = "status " +
      (status === "active" ? "" : status);

    loading.style.display = "none";
    content.style.display = "block";

  }catch(error){
    console.error("Profile error:",error);
    showError(
      "Unable to load your profile. Please refresh and try again."
    );
  }
});
</script>

</body>
</html>