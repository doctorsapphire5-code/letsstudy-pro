<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0f172a">
<title>Account Settings | Vorix Resources</title>

<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f1f5f9;color:#172033}
header{background:#0f172a;color:white;padding:20px}
header h1{font-size:21px;margin:0}
header p{color:#cbd5e1;font-size:13px;margin:6px 0 0}
main{max-width:850px;margin:25px auto;padding:0 15px}
.card{background:white;padding:22px;border-radius:14px;margin-bottom:18px;box-shadow:0 3px 15px #0f172a0d}
h2{font-size:18px;margin:0 0 17px}
.field{margin-bottom:17px}
label{display:block;font-size:13px;font-weight:bold;margin-bottom:8px}
select{width:100%;padding:13px;border:1px solid #cbd5e1;border-radius:8px;background:white;font-size:14px}
.toggle{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:13px 0;border-bottom:1px solid #e2e8f0}
.toggle:last-child{border:0}
.toggle span{font-size:14px}
.toggle small{display:block;color:#64748b;font-size:12px;margin-top:5px}
input[type=checkbox]{width:20px;height:20px;accent-color:#2563eb}
button,.btn{display:inline-block;padding:13px 17px;border:0;border-radius:8px;font-weight:bold;cursor:pointer;text-decoration:none;font-size:13px;margin:4px 4px 4px 0}
.primary{background:#2563eb;color:white}
.secondary{background:#e2e8f0;color:#172033}
.danger{background:#dc2626;color:white}
.muted{color:#64748b;font-size:13px;line-height:1.6}
#message{margin-bottom:15px}
.alert{padding:12px;border-radius:8px;font-size:13px;margin-bottom:10px}
.success{background:#dcfce7;color:#166534}
.error{background:#fee2e2;color:#991b1b}
footer{text-align:center;color:#64748b;padding:25px;font-size:12px}
button:disabled{opacity:.6;cursor:not-allowed}
</style>
</head>

<body>

<header>
  <h1>Vorix Resources</h1>
  <p>Account Settings</p>
</header>

<main>

<div id="message" aria-live="polite"></div>

<section class="card">
  <h2>General Preferences</h2>

  <div class="field">
    <label for="language">Language</label>
    <select id="language">
      <option value="English">English</option>
      <option value="Swahili">Swahili</option>
      <option value="French">French</option>
      <option value="Arabic">Arabic</option>
      <option value="Spanish">Spanish</option>
      <option value="Portuguese">Portuguese</option>
    </select>
  </div>

  <div class="field">
    <label for="timezone">Timezone</label>
    <select id="timezone">
      <option value="Africa/Dar_es_Salaam">Africa/Dar es Salaam (EAT)</option>
      <option value="Africa/Nairobi">Africa/Nairobi (EAT)</option>
      <option value="Africa/Lagos">Africa/Lagos (WAT)</option>
      <option value="Africa/Cairo">Africa/Cairo</option>
      <option value="Europe/London">Europe/London</option>
      <option value="Europe/Paris">Europe/Paris</option>
      <option value="America/New_York">America/New York</option>
      <option value="America/Los_Angeles">America/Los Angeles</option>
      <option value="Asia/Dubai">Asia/Dubai</option>
      <option value="Asia/Kolkata">Asia/Kolkata</option>
      <option value="Asia/Tokyo">Asia/Tokyo</option>
      <option value="Australia/Sydney">Australia/Sydney</option>
      <option value="UTC">UTC</option>
    </select>
  </div>

  <div class="field">
    <label for="dateFormat">Date Format</label>
    <select id="dateFormat">
      <option value="DD/MM/YYYY">DD/MM/YYYY</option>
      <option value="MM/DD/YYYY">MM/DD/YYYY</option>
      <option value="YYYY-MM-DD">YYYY-MM-DD</option>
    </select>
  </div>
</section>

<section class="card">
  <h2>Notifications</h2>

  <div class="toggle">
    <div>
      <span>Email Notifications</span>
      <small>Receive important account emails.</small>
    </div>
    <input type="checkbox" id="emailNotifications">
  </div>

  <div class="toggle">
    <div>
      <span>New Resources</span>
      <small>Updates when new resources are available.</small>
    </div>
    <input type="checkbox" id="newResources">
  </div>

  <div class="toggle">
    <div>
      <span>Submission Updates</span>
      <small>Notifications about resource submissions.</small>
    </div>
    <input type="checkbox" id="submissionUpdates">
  </div>

  <div class="toggle">
    <div>
      <span>System Notifications</span>
      <small>Important platform announcements.</small>
    </div>
    <input type="checkbox" id="systemNotifications">
  </div>
</section>

<section class="card">
  <h2>Security Preferences</h2>

  <div class="toggle">
    <div>
      <span>Two-Factor Authentication Preference</span>
      <small>This saves your preference only. It does not activate Firebase MFA.</small>
    </div>
    <input type="checkbox" id="twoFactor">
  </div>

  <div class="toggle">
    <div>
      <span>Login Alerts Preference</span>
      <small>Save your preference for login security alerts.</small>
    </div>
    <input type="checkbox" id="loginAlerts">
  </div>
</section>

<section class="card">
  <h2>Dashboard Preferences</h2>

  <div class="field">
    <label for="defaultView">Default Dashboard View</label>
    <select id="defaultView">
      <option value="overview">Overview</option>
      <option value="resources">My Resources</option>
      <option value="profile">My Profile</option>
    </select>
  </div>

  <div class="toggle">
    <div>
      <span>Show Recent Resources</span>
      <small>Display recent resources on your dashboard.</small>
    </div>
    <input type="checkbox" id="showRecent">
  </div>
</section>

<section class="card">
  <h2>Save Settings</h2>
  <p class="muted">Your preferences will be saved to your Vorix Resources account.</p>
  <button class="primary" id="saveBtn">Save Changes</button>
  <button class="secondary" id="resetBtn">Reset Form</button>
</section>

<section class="card">
  <h2>Account Navigation</h2>
  <a class="btn secondary" href="resources-dashboard.html">Dashboard</a>
  <a class="btn secondary" href="resources-profile.html">My Profile</a>
  <a class="btn secondary" href="resources-account.html">Account</a>
  <button class="danger" id="logoutBtn">Logout</button>
</section>

</main>

<footer>
  &copy; <span id="year"></span> Vorix Resources. All rights reserved.
</footer>

<script type="module">

import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

import {
  getAuth,
  onAuthStateChanged,
  signOut
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

import {
  getFirestore,
  doc,
  getDoc,
  setDoc,
  serverTimestamp
} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

const firebaseConfig = {
  apiKey: "AIzaSyBuP13ggQsiZiZgoIf9nFK8hmw8Bx6KYr0",
  authDomain: "vorix-resources.firebaseapp.com",
  projectId: "vorix-resources",
  storageBucket: "vorix-resources.firebasestorage.app",
  messagingSenderId: "789688947048",
  appId: "1:789688947048:web:31598720b1e0cef9db06dd",
  measurementId: "G-VEYGNMJ6N1"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

const $ = id => document.getElementById(id);

let currentUser = null;
let originalSettings = null;
let accountData = null;

$("year").textContent = new Date().getFullYear();

function showMessage(message,type="success"){
  $("message").innerHTML = "";
  const div = document.createElement("div");
  div.className = "alert " + type;
  div.textContent = message;
  $("message").appendChild(div);
  window.scrollTo({top:0,behavior:"smooth"});
}

function getFormSettings(){
  return {
    language: $("language").value,
    timezone: $("timezone").value,
    dateFormat: $("dateFormat").value,

    notifications: {
      email: $("emailNotifications").checked,
      newResources: $("newResources").checked,
      pending: $("submissionUpdates").checked,
      system: $("systemNotifications").checked
    },

    security: {
      twoFactorPreference: $("twoFactor").checked,
      loginAlerts: $("loginAlerts").checked
    },

    dashboard: {
      defaultView: $("defaultView").value,
      showRecent: $("showRecent").checked
    }
  };
}

function applySettings(settings){

  $("language").value = settings.language || "English";
  $("timezone").value = settings.timezone || "Africa/Dar_es_Salaam";
  $("dateFormat").value = settings.dateFormat || "DD/MM/YYYY";

  const notifications = settings.notifications || {};
  $("emailNotifications").checked = notifications.email ?? true;
  $("newResources").checked = notifications.newResources ?? true;
  $("submissionUpdates").checked = notifications.pending ?? true;
  $("systemNotifications").checked = notifications.system ?? true;

  const security = settings.security || {};
  $("twoFactor").checked = security.twoFactorPreference ?? false;
  $("loginAlerts").checked = security.loginAlerts ?? true;

  const dashboard = settings.dashboard || {};
  $("defaultView").value = dashboard.defaultView || "overview";
  $("showRecent").checked = dashboard.showRecent ?? true;
}

function validateSettings(settings){

  const validLanguages = [
    "English","Swahili","French","Arabic","Spanish","Portuguese"
  ];

  const validTimezones = [
    "Africa/Dar_es_Salaam","Africa/Nairobi","Africa/Lagos",
    "Africa/Cairo","Europe/London","Europe/Paris",
    "America/New_York","America/Los_Angeles","Asia/Dubai",
    "Asia/Kolkata","Asia/Tokyo","Australia/Sydney","UTC"
  ];

  if(!validLanguages.includes(settings.language)){
    throw new Error("Invalid language selection.");
  }

  if(!validTimezones.includes(settings.timezone)){
    throw new Error("Invalid timezone selection.");
  }

  if(!["DD/MM/YYYY","MM/DD/YYYY","YYYY-MM-DD"].includes(settings.dateFormat)){
    throw new Error("Invalid date format.");
  }

  if(!["overview","resources","profile"].includes(settings.dashboard.defaultView)){
    throw new Error("Invalid dashboard view.");
  }
}

async function loadSettings(user){

  const userRef = doc(db,"users",user.uid);
  const snapshot = await getDoc(userRef);

  if(!snapshot.exists()){
    throw new Error("User profile was not found.");
  }

  accountData = snapshot.data();

  if(accountData.userId !== user.uid){
    throw new Error("Account identity verification failed.");
  }

  if(accountData.email && user.email &&
    accountData.email.toLowerCase() !== user.email.toLowerCase()){
    throw new Error("Account email does not match your login.");
  }

  if(accountData.status !== "active"){
    throw new Error("Your account is not active.");
  }

  currentUser = user;

  originalSettings = accountData.settings || {
    language: accountData.language || "English",
    timezone: accountData.timezone || "Africa/Dar_es_Salaam",
    dateFormat: "DD/MM/YYYY",
    notifications: {
      email: true,
      newResources: true,
      pending: true,
      system: true
    },
    security: {
      twoFactorPreference: false,
      loginAlerts: true
    },
    dashboard: {
      defaultView: "overview",
      showRecent: true
    }
  };

  applySettings(originalSettings);
}

onAuthStateChanged(auth,async user=>{

  if(!user){
    window.location.replace("resources-login.html");
    return;
  }

  try{
    await loadSettings(user);
  }catch(error){
    console.error(error);
    showMessage(error.message || "Unable to load settings.","error");
  }
});

$("saveBtn").addEventListener("click",async()=>{

  if(!currentUser) return;

  const button = $("saveBtn");
  button.disabled = true;
  button.textContent = "Saving...";

  try{

    const settings = getFormSettings();
    validateSettings(settings);

    const userRef = doc(db,"users",currentUser.uid);

    // Re-check account ownership and status before saving.
    const latest = await getDoc(userRef);

    if(!latest.exists()){
      throw new Error("User account no longer exists.");
    }

    const latestData = latest.data();

    if(latestData.userId !== currentUser.uid ||
       latestData.status !== "active"){
      throw new Error("Account verification failed.");
    }

    await setDoc(userRef,{
      settings: settings,
      updatedAt: serverTimestamp()
    },{merge:true});

    originalSettings = settings;
    showMessage("Your settings have been saved successfully.");

  }catch(error){
    console.error(error);
    showMessage(error.message || "Unable to save settings.","error");
  }finally{
    button.disabled = false;
    button.textContent = "Save Changes";
  }
});

$("resetBtn").addEventListener("click",()=>{
  if(originalSettings){
    applySettings(originalSettings);
    showMessage("Form restored to your last saved settings.");
  }
});

$("logoutBtn").addEventListener("click",async()=>{
  try{
    await signOut(auth);
    window.location.replace("resources-login.html");
  }catch(error){
    showMessage("Logout failed: "+error.message,"error");
  }
});

</script>
</body>
</html>