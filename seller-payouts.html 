}

.brand{
    display:flex;
    align-items:center;
    gap:9px;
    font-weight:900;
}

.logo{
    width:40px;
    height:40px;
    border-radius:10px;
    background:#172033;
    color:#fff;
    display:grid;
    place-items:center;
    font-size:10px;
}

.header-actions{
    display:flex;
    gap:8px;
}

.header-btn{
    border:0;
    padding:9px 13px;
    border-radius:8px;
    background:#eef2f7;
    color:#172033;
    font-weight:800;
}

/* =========================
   MAIN
========================= */

.container{
    max-width:1200px;
    margin:auto;
    padding:25px 18px 50px;
}

.page-title{
    margin-bottom:20px;
}

.page-title h1{
    font-size:28px;
}

.page-title p{
    color:#64748b;
    font-size:12px;
    margin-top:5px;
}

/* =========================
   STATS
========================= */

.stats{
    display:grid;
    grid-template-columns:
        repeat(4,1fr);
    gap:14px;
    margin-bottom:20px;
}

.stat{
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:12px;
    padding:18px;
}

.stat-label{
    color:#64748b;
    font-size:11px;
    font-weight:700;
}

.stat-value{
    margin-top:7px;
    font-size:23px;
    font-weight:900;
}

.stat-sub{
    color:#94a3b8;
    font-size:10px;
    margin-top:4px;
}

/* =========================
   ACTIONS
========================= */

.toolbar{
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:12px;
    padding:13px;
    display:flex;
    gap:8px;
    margin-bottom:15px;
}

.search{
    flex:1;
    min-width:0;
    border:1px solid #dbe2ea;
    border-radius:8px;
    padding:11px;
    outline:none;
}

.filter{
    width:160px;
    border:1px solid #dbe2ea;
    border-radius:8px;
    padding:8px;
    background:#fff;
}

.primary{
    border:0;
    background:#2563eb;
    color:#fff;
    padding:10px 15px;
    border-radius:8px;
    font-weight:900;
}

.primary:hover{
    opacity:.92;
}

/* =========================
   TABLE
========================= */

.panel{
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:12px;
    overflow:hidden;
}

.panel-header{
    padding:15px;
    border-bottom:1px solid #e2e8f0;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.panel-header h2{
    font-size:16px;
}

.panel-header span{
    color:#64748b;
    font-size:10px;
}

.table-wrap{
    width:100%;
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:850px;
}

th,
td{
    padding:13px 15px;
    border-bottom:1px solid #edf1f5;
    text-align:left;
}

th{
    color:#64748b;
    background:#fafbfc;
    font-size:10px;
    text-transform:uppercase;
}

td{
    font-size:11px;
}

.amount{
    font-weight:900;
}

.status{
    display:inline-block;
    padding:5px 8px;
    border-radius:999px;
    font-size:9px;
    font-weight:900;
    text-transform:capitalize;
}

.status.pending{
    background:#fff7ed;
