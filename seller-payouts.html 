    padding:13px;
    border-radius:9px;
    margin-bottom:15px;
}

.balance-box small{
    color:#64748b;
    font-size:10px;
}

.balance-box strong{
    display:block;
    margin-top:4px;
    font-size:20px;
}

.modal-footer{
    padding:15px 18px;
    border-top:1px solid #e2e8f0;
    display:flex;
    gap:8px;
}

.modal-footer button{
    flex:1;
}

.secondary{
    border:0;
    background:#eef2f7;
    color:#172033;
    padding:11px;
    border-radius:8px;
    font-weight:800;
}

/* =========================
   TOAST
========================= */

.toast{
    position:fixed;
    left:50%;
    bottom:20px;
    transform:translate(-50%,20px);
    background:#172033;
    color:#fff;
    padding:11px 16px;
    border-radius:8px;
    font-size:11px;
    opacity:0;
    pointer-events:none;
    transition:.25s;
    z-index:500;
}

.toast.show{
    opacity:1;
    transform:translate(-50%,0);
}

/* =========================
   LOADING
========================= */

.loading{
    padding:35px;
    text-align:center;
    color:#64748b;
    font-size:12px;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:900px){

    .stats{
        grid-template-columns:
            repeat(2,1fr);
    }

}

@media(max-width:650px){

    .toolbar{
        flex-direction:column;
    }

    .filter{
        width:100%;
    }

    .stats{
        grid-template-columns:1fr 1fr;
    }

    .page-title h1{
        font-size:24px;
    }

}

@media(max-width:430px){

    header{
        padding:0 12px;
    }

    .brand span{
        display:none;
    }

    .container{
        padding:20px 12px 40px;
    }

    .stats{
        grid-template-columns:1fr;
    }

}
</style>
