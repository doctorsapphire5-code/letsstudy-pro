    border-radius:14px;
    overflow:hidden;
}

.modal-header{
    padding:17px;
    border-bottom:1px solid #e2e8f0;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.modal-header h2{
    font-size:17px;
}

.close{
    width:34px;
    height:34px;
    border:0;
    background:#eef2f7;
    border-radius:8px;
}

.modal-body{
    padding:18px;
}

.form-group{
    margin-bottom:14px;
}

.form-group label{
    display:block;
    font-size:11px;
    font-weight:800;
    margin-bottom:6px;
}

.form-group input,
.form-group select{
    width:100%;
    padding:11px;
    border:1px solid #dbe2ea;
    border-radius:8px;
    outline:none;
    background:#fff;
}

.balance-box{
    background:#f8fafc;
