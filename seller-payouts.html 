    color:#1d4ed8;
}

.status.failed{
    background:#fef2f2;
    color:#b91c1c;
}

.status.cancelled{
    background:#f1f5f9;
    color:#475569;
}

/* =========================
   EMPTY
========================= */

.empty{
    padding:50px 20px;
    text-align:center;
    color:#64748b;
}

.empty-icon{
    font-size:42px;
    margin-bottom:10px;
}

/* =========================
   MODAL
========================= */

.modal{
    position:fixed;
    inset:0;
    background:rgba(15,23,42,.55);
    display:none;
    align-items:center;
    justify-content:center;
    padding:15px;
