    color:inherit;
}

/* =========================
   HEADER
========================= */

header{
    height:66px;
    background:#fff;
    border-bottom:1px solid #e2e8f0;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 20px;
