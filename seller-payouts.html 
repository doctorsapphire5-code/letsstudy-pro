<script type="module">

import {
    initializeApp
}
from
"https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";

import {
    getAuth,
    onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js";

import {
    getFirestore,
    collection,
    query,
    where,
    getDocs,
    addDoc,
    serverTimestamp
}
from
"https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";


/* =========================
   FIREBASE
========================= */

const firebaseConfig = {

    apiKey:
        "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

    authDomain:
        "let-s-study-pro-course.firebaseapp.com",

    databaseURL:
        "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

    projectId:
        "let-s-study-pro-course",

    storageBucket:
        "let-s-study-pro-course.firebasestorage.app",

    messagingSenderId:
        "474928293390",

    appId:
        "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

    measurementId:
        "G-85B7V5H5J0"

};


const app =
    initializeApp(
        firebaseConfig
    );


const auth =
    getAuth(app);


const db =
    getFirestore(app);


/* =========================
   STATE
========================= */

let currentUser = null;

let payouts = [];

let availableBalance = 0;

let pendingBalance = 0;

let totalSales = 0;

let totalPaid = 0;


/* =========================
   HELPERS
========================= */

function get(id){

    return document.getElementById(id);

}


function money(
    amount,
    currency="TZS"
){

    return (
        currency +
        " " +
        Number(
            amount || 0
        ).toLocaleString()
    );

}


function escapeHTML(value){

    return String(value ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


function showToast(message){

    const toast =
        get("toast");

    toast.textContent =
        message;

    toast.classList.add(
        "show"
    );

    clearTimeout(
        window.toastTimer
    );

    window.toastTimer =
        setTimeout(
            () => {

                toast.classList.remove(
                    "show"
                );

            },
            2500
        );

}


/* =========================
   AUTH
========================= */

onAuthStateChanged(
    auth,
    async user => {

        if(!user){

            /*
             * If your public mode allows
             * this page without login,
             * remove the redirect and use
             * your seller ID system.
             */

            get("loading")
                .textContent =
                "Please sign in to view seller payouts.";

            return;

        }


        currentUser =
            user;


        await loadPayouts();

        await calculateEarnings();

    }
);


/* =========================
   LOAD PAYOUTS
========================= */

async function loadPayouts(){

    try{

        const ref =
            collection(
                db,
                "payouts"
            );


        const q =
            query(
                ref,
                where(
                    "sellerId",
                    "==",
                    currentUser.uid
                )
            );


        const snapshot =
            await getDocs(q);


        payouts = [];


        snapshot.forEach(
            docSnap => {

                const data =
                    docSnap.data();


                payouts.push({

                    id:
                        docSnap.id,

                    reference:
                        data.reference ||
                        docSnap.id,

                    amount:
                        Number(
                            data.amount || 0
                        ),

                    currency:
                        data.currency ||
                        "TZS",

                    method:
                        data.method ||
                        "mobile",

                    account:
                        data.account ||
                        "",

                    status:
                        data.status ||
                        "pending",

                    createdAt:
                        data.createdAt ||
                        null

                });

            }
        );


        payouts.sort(
            (a,b) => {

                const ad =
                    a.createdAt?.seconds ||
                    0;

                const bd =
                    b.createdAt?.seconds ||
                    0;

                return bd - ad;

            }
        );


        calculatePayoutTotals();

        renderPayouts(
            payouts
        );


    }catch(error){

        console.error(
            "Payout loading error:",
            error
        );


        get("loading")
            .textContent =
            "Unable to load payouts.";

    }

}


/* =========================
   CALCULATE PAYOUT TOTALS
========================= */

function calculatePayoutTotals(){

    pendingBalance = 0;

    totalPaid = 0;


    payouts.forEach(
        payout => {

            if(
                payout.status ===
                "pending" ||

                payout.status ===
                "processing"
            ){

                pendingBalance +=
                    payout.amount;

            }


            if(
                payout.status ===
                "paid"
            ){

                totalPaid +=
                    payout.amount;

            }

        }
    );


    updateStats();

}


/* =========================
   CALCULATE SALES
========================= */

async function calculateEarnings(){

    try{

        const ref =
            collection(
                db,
                "orders"
            );


        const q =
            query(
                ref,
                where(
                    "sellerId",
                    "==",
                    currentUser.uid
                )
            );


        const snapshot =
            await getDocs(q);


        totalSales = 0;


        snapshot.forEach(
            docSnap => {

                const data =
                    docSnap.data();


                /*
                 * Only completed/paid orders
                 */

                if(
                    data.paymentStatus &&
                    data.paymentStatus !==
                    "paid"
                ){

                    return;

                }


                totalSales +=
                    Number(
                        data.sellerAmount ??
                        data.sellerTotal ??
                        data.total ??
                        0
                    );

            }
        );


        /*
         * Available balance =
         * total sales - paid/pending payouts
         */

        availableBalance =
            Math.max(
                0,
                totalSales -
                totalPaid -
                pendingBalance
            );


        updateStats();


    }catch(error){

        console.error(
            "Sales calculation error:",
            error
        );

    }

}


/* =========================
   UPDATE STATS
========================= */

function updateStats(){

    get("availableBalance")
        .textContent =
        money(
            availableBalance
        );


    get("pendingBalance")
        .textContent =
        money(
            pendingBalance
        );


    get("totalSales")
        .textContent =
        money(
            totalSales
        );


    get("totalPaid")
        .textContent =
        money(
            totalPaid
        );


    get("modalBalance")
    .textContent =
    money(
        availableBalance
    );

}


/* =========================
   FILTER PAYOUTS
========================= */

function filterPayouts(){

    const search =
        get("search")
            .value
            .toLowerCase()
            .trim();

    const status =
        get("statusFilter")
            .value;

    const method =
        get("methodFilter")
            .value;

    const result =
        payouts.filter(
            payout => {

                const searchable = (

                    payout.reference +
                    " " +
                    payout.account +
                    " " +
                    payout.method +
                    " " +
                    payout.status

                ).toLowerCase();

                return (
                    (!search ||
                        searchable.includes(search)) &&

                    (status === "all" ||
                        payout.status === status) &&

                    (method === "all" ||
                        payout.method === method)
                );

            }
        );

    renderPayouts(result);

}


/* =========================
   SEARCH EVENTS
========================= */

get("search")
    .addEventListener(
        "input",
        filterPayouts
    );

get("statusFilter")
    .addEventListener(
        "change",
        filterPayouts
    );

get("methodFilter")
    .addEventListener(
        "change",
        filterPayouts
    );


/* =========================
   MODAL
========================= */

function openPayoutModal(){

    get("payoutAmount").value = "";

    get("payoutAccount").value = "";

    get("payoutMessage")
        .style.display = "none";

    updateStats();

    get("payoutModal")
        .classList.add("show");

}


function closePayoutModal(){

    get("payoutModal")
        .classList.remove("show");

}


/* =========================
   REQUEST PAYOUT
========================= */

async function requestPayout(){

    if(!currentUser){

        showFormError(
            "You must be signed in."
        );

        return;

    }

    const amount =
        Number(
            get("payoutAmount").value
        );

    const method =
        get("payoutMethod").value;

    const account =
        get("payoutAccount")
            .value
            .trim();

    if(
        !amount ||
        amount <= 0
    ){

        showFormError(
            "Enter a valid payout amount."
        );

        return;

    }

    if(
        amount > availableBalance
    ){

        showFormError(
            "Amount is greater than your available balance."
        );

        return;

    }

    if(!account){

        showFormError(
            "Enter your payout account."
        );

        return;

    }

    const button =
        get("submitPayout");

    button.disabled = true;

    button.textContent =
        "Submitting...";

    try{

        const reference =
            "PO-" + Date.now();

        await addDoc(
            collection(
                db,
                "payouts"
            ),
            {
                sellerId:
                    currentUser.uid,

                sellerEmail:
                    currentUser.email || "",

                reference:
                    reference,

                amount:
                    amount,

                currency:
                    "TZS",

                method:
                    method,

                account:
                    account,

                status:
                    "pending",

                createdAt:
                    serverTimestamp(),

                updatedAt:
                    serverTimestamp()
            }
        );

        closePayoutModal();

        showToast(
            "Payout request submitted."
        );

        await loadPayouts();

        await calculateEarnings();

    }catch(error){

        console.error(
            "Payout request error:",
            error
        );

        showFormError(
            "Unable to submit payout request."
        );

    }finally{

        button.disabled = false;

        button.textContent =
            "Submit Request";

    }

}


/* =========================
   FORM ERROR
========================= */

function showFormError(message){

    const box =
        get("payoutMessage");

    box.textContent =
        message;

    box.style.display =
        "block";

}


/* =========================
   GLOBAL FUNCTIONS
========================= */

window.openPayoutModal =
    openPayoutModal;

window.closePayoutModal =
    closePayoutModal;

window.requestPayout =
    requestPayout;

window.filterPayouts =
    filterPayouts;


/* =========================
   CLOSE MODAL OUTSIDE
========================= */

get("payoutModal")
    .addEventListener(
        "click",
        function(event){

            if(
                event.target ===
                this
            ){

                closePayoutModal();

            }

        }
    );


/* =========================
   INITIAL PAGE STATE
========================= */

updateStats();

renderPayouts([]);


/* =========================
   END
========================= */

</script>

