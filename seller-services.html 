<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Seller Services | LetsStudy Pro</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
    font-family:Arial,sans-serif;
    background:#f5f7fb;
    color:#172033
}

button,input,select,textarea{
    font:inherit
}

button{
    cursor:pointer
}

header{
    background:#fff;
    border-bottom:1px solid #e5e7eb;
    padding:12px 18px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
    position:sticky;
    top:0;
    z-index:20
}

.brand{
    display:flex;
    align-items:center;
    gap:9px;
    text-decoration:none;
    color:#172033;
    font-weight:900
}

.logo{
    width:38px;
    height:38px;
    border-radius:9px;
    background:#172033;
    color:#fff;
    display:grid;
    place-items:center;
    font-size:10px
}

.nav{
    display:flex;
    gap:7px;
    flex-wrap:wrap
}

.nav a{
    text-decoration:none;
    background:#eef2f7;
    color:#172033;
    padding:8px 10px;
    border-radius:7px;
    font-size:9px;
    font-weight:800
}

main{
    max-width:1200px;
    margin:auto;
    padding:25px 16px 60px
}

.title{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:15px;
    margin-bottom:18px
}

.title h1{
    font-size:27px
}

.title p{
    color:#64748b;
    font-size:12px;
    margin-top:5px
}

.primary{
    border:0;
    background:#172033;
    color:#fff;
    padding:11px 15px;
    border-radius:8px;
    font-weight:800
}

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
    margin-bottom:16px
}

.stat{
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:12px;
    padding:16px
}

.stat-label{
    color:#64748b;
    font-size:9px;
    font-weight:900
}

.stat-value{
    margin-top:7px;
    font-size:23px;
    font-weight:900
}

.toolbar{
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:12px;
    padding:12px;
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    margin-bottom:16px
}

.search{
    flex:1;
    min-width:220px
}

input,select,textarea{
    border:1px solid #dbe2ea;
    background:#fff;
    padding:10px;
    border-radius:8px;
    outline:none;
    width:100%
}

textarea{
    min-height:100px;
    resize:vertical
}

.secondary{
    border:0;
    background:#eef2f7;
    color:#172033;
    padding:10px 14px;
    border-radius:8px;
    font-weight:800
}

.grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:14px
}

.card{
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:12px;
    overflow:hidden
}

.card-image{
    height:145px;
    background:#eef2f7;
    display:grid;
    place-items:center;
    color:#64748b;
    font-size:11px;
    overflow:hidden
}

.card-image img{
    width:100%;
    height:100%;
    object-fit:cover
}

.card-body{
    padding:14px
}

.card h3{
    font-size:14px;
    margin-bottom:5px
}

.description{
    color:#64748b;
    font-size:10px;
    line-height:1.5;
    min-height:31px
}

.meta{
    display:flex;
    justify-content:space-between;
    gap:8px;
    margin-top:12px;
    align-items:center
}

.price{
    font-size:15px;
    font-weight:900
}

.badge{
    display:inline-block;
    padding:5px 8px;
    border-radius:6px;
    font-size:8px;
    font-weight:900
}

.active{
    background:#ecfdf5;
    color:#047857
}

.inactive{
    background:#fef2f2;
    color:#b91c1c
}

.card-actions{
    display:flex;
    gap:6px;
    margin-top:12px
}

.card-actions button{
    flex:1;
    padding:8px;
    border:1px solid #dbe2ea;
    background:#fff;
    border-radius:7px;
    font-size:8px;
    font-weight:800
}

.empty{
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:12px;
    padding:50px;
    text-align:center;
    color:#64748b;
    display:none
}

.modal{
    position:fixed;
    inset:0;
    background:rgba(15,23,42,.55);
    display:none;
    align-items:center;
    justify-content:center;
    padding:15px;
    z-index:100
}

.modal.show{
    display:flex
}

.modal-box{
    width:100%;
    max-width:600px;
    max-height:90vh;
    overflow:auto;
    background:#fff;
    border-radius:14px;
    padding:20px
}

.modal-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:15px
}

.modal-head h2{
    font-size:17px
}

.close{
    border:0;
    background:#eef2f7;
    width:30px;
    height:30px;
    border-radius:7px;
    font-size:17px
}

.form-group{
    margin-bottom:12px
}

.form-group label{
    display:block;
    font-size:9px;
    font-weight:900;
    margin-bottom:5px
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px
}

.form-actions{
    display:flex;
    justify-content:flex-end;
    gap:8px;
    margin-top:15px
}

.toast{
    position:fixed;
    left:50%;
    bottom:20px;
    transform:translate(-50%,20px);
    background:#172033;
    color:#fff;
    padding:11px 15px;
    border-radius:8px;
    font-size:10px;
    opacity:0;
    transition:.25s;
    z-index:200
}

.toast.show{
    opacity:1;
    transform:translate(-50%,0)
}

@media(max-width:850px){
    .grid{
        grid-template-columns:repeat(2,1fr)
    }

    .stats{
        grid-template-columns:repeat(2,1fr)
    }
}

@media(max-width:600px){
    header,
    .title{
        flex-direction:column;
        align-items:flex-start
    }

    .grid{
        grid-template-columns:1fr
    }

    .stats{
        grid-template-columns:1fr 1fr
    }

    .form-grid{
        grid-template-columns:1fr
    }

    .toolbar{
        flex-direction:column
    }

    .toolbar input,
    .toolbar select,
    .toolbar button{
        width:100%
    }
}
</style>
</head>

<body>

<header>

<a class="brand" href="marketplace.html">
<div class="logo">LSP</div>
<span>LetsStudy Pro</span>
</a>

<nav class="nav">
<a href="seller-dashboard.html">Dashboard</a>
<a href="seller-orders.html">Orders</a>
<a href="seller-customers.html">Customers</a>
<a href="seller-earnings.html">Earnings</a>
<a href="seller-analytics.html">Analytics</a>
</nav>

</header>

<main>

<div class="title">

<div>
<h1>Seller Services</h1>
<p>Create and manage professional services you offer.</p>
</div>

<button
class="primary"
id="addBtn">
+ Add Service
</button>

</div>


<section class="stats">

<div class="stat">
<div class="stat-label">TOTAL SERVICES</div>
<div id="totalServices" class="stat-value">0</div>
</div>

<div class="stat">
<div class="stat-label">ACTIVE</div>
<div id="activeServices" class="stat-value">0</div>
</div>

<div class="stat">
<div class="stat-label">SALES</div>
<div id="totalSales" class="stat-value">0</div>
</div>

<div class="stat">
<div class="stat-label">EARNINGS</div>
<div id="totalEarnings" class="stat-value">TZS 0</div>
</div>

</section>


<section class="toolbar">

<input
id="search"
class="search"
type="search"
placeholder="Search services...">

<select id="categoryFilter">
<option value="all">All Categories</option>
<option value="design">Design</option>
<option value="development">Development</option>
<option value="marketing">Marketing</option>
<option value="writing">Writing</option>
<option value="education">Education</option>
<option value="business">Business</option>
<option value="other">Other</option>
</select>

<select id="statusFilter">
<option value="all">All Status</option>
<option value="active">Active</option>
<option value="inactive">Inactive</option>
</select>

</section>


<div id="serviceGrid" class="grid"></div>

<div id="empty" class="empty">
No services found.
</div>

</main>


<div id="serviceModal" class="modal">

<div class="modal-box">

<div class="modal-head">

<h2 id="modalTitle">
Add Service
</h2>

<button
class="close"
onclick="closeModal()">
×
</button>

</div>


<form id="serviceForm">

<input
type="hidden"
id="serviceId">


<div class="form-group">

<label>
Service Title
</label>

<input
id="serviceTitle"
required
placeholder="e.g. Website Development">

</div>


<div class="form-group">

<label>
Description
</label>

<textarea
id="serviceDescription"
required
placeholder="Describe your service..."></textarea>

</div>


<div class="form-grid">

<div class="form-group">

<label>
Category
</label>

<select id="serviceCategory">

<option value="design">Design</option>
<option value="development">Development</option>
<option value="marketing">Marketing</option>
<option value="writing">Writing</option>
<option value="education">Education</option>
<option value="business">Business</option>
<option value="other">Other</option>

</select>

</div>


<div class="form-group">

<label>
Price
</label>

<input
id="servicePrice"
type="number"
min="0"
required
placeholder="50000">

</div>

</div>


<div class="form-group">

<label>
Currency
</label>

<select id="serviceCurrency">

<option value="TZS">TZS</option>
<option value="USD">USD</option>
<option value="KES">KES</option>
<option value="UGX">UGX</option>

</select>

</div>


<div class="form-group">

<label>
Image URL
</label>

<input
id="serviceImage"
type="url"
placeholder="https://...">

</div>


<div class="form-group">

<label>
Status
</label>

<select id="serviceStatus">

<option value="active">Active</option>
<option value="inactive">Inactive</option>

</select>

</div>


<div class="form-actions">

<button
type="button"
class="secondary"
onclick="closeModal()">
Cancel
</button>

<button
type="submit"
class="primary">
Save Service
</button>

</div>

</form>

</div>

</div>


<div id="toast" class="toast"></div>


<script type="module">

import {
    initializeApp
}
from
"https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";

import {
    getAuth,
    onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/10.14.1/firebase-auth.js";

import {
    getFirestore,
    collection,
    addDoc,
    getDocs,
    updateDoc,
    deleteDoc,
    doc,
    query,
    where,
    serverTimestamp
}
from
"https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore.js";


const firebaseConfig = {
    apiKey:"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",
    authDomain:"let-s-study-pro-course.firebaseapp.com",
    projectId:"let-s-study-pro-course",
    storageBucket:"let-s-study-pro-course.firebasestorage.app",
    messagingSenderId:"474928293390",
    appId:"1:474928293390:web:2bcc2aebf2351c12a9fe5f"
};


const app =
    initializeApp(
        firebaseConfig
    );

const auth =
    getAuth(app);

const db =
    getFirestore(app);


let currentUser = null;
let services = [];


const get =
id =>
document.getElementById(id);


function escapeHTML(value){

    return String(value ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


function money(
    value,
    currency="TZS"
){

    return `${currency} ${Number(
        value || 0
    ).toLocaleString()}`;

}


function slugify(value){

    return String(value)
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g,"-")
        .replace(/^-|-$/g,"");

}


function showToast(message){

    const toast =
        get("toast");

    toast.textContent =
        message;

    toast.classList.add("show");

    clearTimeout(
        window.toastTimer
    );

    window.toastTimer =
        setTimeout(
            () =>
            toast.classList.remove(
                "show"
            ),
            2500
        );

}


onAuthStateChanged(
    auth,
    async user => {

        if(!user){

            showToast(
                "Please sign in first."
            );

            return;

        }

        currentUser =
            user;

        await loadServices();

    }
);


/* LOAD */

async function loadServices(){

    try{

        const ref =
            collection(
                db,
                "services"
            );

        const q =
            query(
                ref,
                where(
                    "sellerId",
                    "==",
                    currentUser.uid
                )
            );

        const snap =
            await getDocs(q);

        services = [];

        snap.forEach(
            item => {

                services.push({
                    id:item.id,
                    ...item.data()
                });

            }
        );

        updateStats();

        renderServices();

    }catch(error){

        console.error(error);

        showToast(
            "Failed to load services."
        );

    }

}


/* STATS */

function updateStats(){

    const active =
        services.filter(
            service =>
                service.status ===
                "active"
        ).length;

    const sales =
        services.reduce(
            (sum,service) =>
                sum +
                Number(
                    service.salesCount ||
                    0
                ),
            0
        );

    const earnings =
        services.reduce(
            (sum,service) =>
                sum +
                Number(
                    service.earnings ||
                    0
                ),
            0
        );

    get("totalServices")
        .textContent =
        services.length;

    get("activeServices")
        .textContent =
        active;

    get("totalSales")
        .textContent =
        sales;

    get("totalEarnings")
        .textContent =
        money(earnings);

}


/* RENDER */

function renderServices(){

    const search =
        get("search")
        .value
        .toLowerCase()
        .trim();

    const category =
        get("categoryFilter")
        .value;

    const status =
        get("statusFilter")
        .value;


    const list =
        services.filter(
            service => {

                const text =
                    [
                        service.title,
                        service.description,
                        service.category
                    ]
                    .join(" ")
                    .toLowerCase();

                return (
                    (!search ||
                    text.includes(search)) &&

                    (
                        category === "all" ||
                        service.category ===
                        category
                    ) &&

                    (
                        status === "all" ||
                        service.status ===
                        status
                    )
                );

            }
        );


    get("serviceGrid")
        .innerHTML =
        list.map(
            renderCard
        ).join("");


    get("empty")
        .style.display =
        list.length
            ? "none"
            : "block";

}


function renderCard(service){

    const image =
        service.imageUrl ||
        service.thumbnail ||
        "";


    return `

<article class="card">

<div class="card-image">

${
    image
    ? `
    <img
        src="${escapeHTML(image)}"
        alt="${escapeHTML(service.title)}"
        onerror="this.style.display='none'">
    `
    : "Service"
}

</div>


<div class="card-body">

<h3>
${escapeHTML(
    service.title ||
    "Untitled Service"
)}
</h3>


<div class="description">

${escapeHTML(
    service.description ||
    "No description"
)}

</div>


<div class="meta">

<div class="price">

${money(
    service.price,
    service.currency
)}

</div>


<span class="badge ${
    service.status === "active"
    ? "active"
    : "inactive"
}">

${escapeHTML(
    service.status ||
    "inactive"
)}

</span>

</div>


<div class="card-actions">

<button
onclick="editService('${service.id}')">
Edit
</button>

<button
onclick="shareService('${service.id}')">
Share
</button>

<button
onclick="deleteService('${service.id}')">
Delete
</button>

</div>

</div>

</article>

`;

}


/* MODAL */

get("addBtn")
.addEventListener(
    "click",
    () => {

        get("serviceForm")
            .reset();

        get("serviceId")
            .value = "";

        get("modalTitle")
            .textContent =
            "Add Service";

        get("serviceModal")
            .classList.add(
                "show"
            );

    }
);


window.closeModal =
function(){

    get("serviceModal")
        .classList.remove(
            "show"
        );

};


/* SAVE */

get("serviceForm")
.addEventListener(
    "submit",
    async event => {

        event.preventDefault();

        if(!currentUser)
            return;


        const id =
            get("serviceId")
            .value;


        const title =
            get("serviceTitle")
            .value
            .trim();


        const data = {

            sellerId:
                currentUser.uid,

            title,

            slug:
                slugify(title),

            description:
                get("serviceDescription")
                .value
                .trim(),

            category:
                get("serviceCategory")
                .value,

            price:
                Number(
                    get("servicePrice")
                    .value
                ),

            currency:
                get("serviceCurrency")
                .value,

            imageUrl:
                get("serviceImage")
                .value
                .trim(),

            status:
                get("serviceStatus")
                .value,

            updatedAt:
                serverTimestamp()

        };


        try{

            if(id){

                await updateDoc(
                    doc(
                        db,
                        "services",
                        id
                    ),
                    data
                );

                showToast(
                    "Service updated."
                );

            }else{

                await addDoc(
                    collection(
                        db,
                        "services"
                    ),
                    {
                        ...data,

                        salesCount:0,

                        earnings:0,

                        rating:0,

                        ratingCount:0,

                        createdAt:
                            serverTimestamp(),

                        publishedAt:
                            data.status ===
                            "active"
                                ? serverTimestamp()
                                : null
                    }
                );

                showToast(
                    "Service created."
                );

            }


            closeModal();

            await loadServices();


        }catch(error){

            console.error(error);

            showToast(
                "Failed to save service."
            );

        }

    }
);


/* EDIT */

window.editService =
function(id){

    const service =
        services.find(
            item =>
                item.id === id
        );

    if(!service)
        return;


    get("serviceId")
        .value =
        service.id;

    get("serviceTitle")
        .value =
        service.title || "";

    get("serviceDescription")
        .value =
        service.description || "";

    get("serviceCategory")
        .value =
        service.category || "other";

    get("servicePrice")
        .value =
        service.price || 0;

    get("serviceCurrency")
        .value =
        service.currency || "TZS";

    get("serviceImage")
        .value =
        service.imageUrl || "";

    get("serviceStatus")
        .value =
        service.status || "active";

    get("modalTitle")
        .textContent =
        "Edit Service";

    get("serviceModal")
        .classList.add(
            "show"
        );

};


/* DELETE */

window.deleteService =
async function(id){

    const service =
    services.find(
        item =>
            item.id === id
    );

if(!service){

    showToast(
        "Service not found."
    );

    return;

}


const title =
    service.title ||
    "LetsStudy Pro Service";


const description =
    service.description ||
    "Check out this service on LetsStudy Pro.";


const url =
    `${window.location.origin}/service.html?id=${encodeURIComponent(
        service.id
    )}`;


try{

    if(
        navigator.share
    ){

        await navigator.share({

            title:

                title,

            text:

                description,

            url:

                url

        });

    }else{

        await navigator.clipboard
            .writeText(url);

        showToast(
            "Service link copied."
        );

    }

}catch(error){

    if(
        error?.name !==
        "AbortError"
    ){

        console.error(
            "Share failed:",
            error
        );

        try{

            await navigator.clipboard
                .writeText(url);

            showToast(
                "Service link copied."
            );

        }catch(copyError){

            console.error(
                "Copy failed:",
                copyError
            );

            showToast(
                "Unable to share service."
            );

        }

    }

}


/* =========================
   FILTER EVENTS
========================= */

get("search")
    .addEventListener(
        "input",
        renderServices
    );


get("categoryFilter")
    .addEventListener(
        "change",
        renderServices
    );


get("statusFilter")
    .addEventListener(
        "change",
        renderServices
    );


/* =========================
   MODAL CLOSE
========================= */

get("serviceModal")
    .addEventListener(
        "click",
        event => {

            if(
                event.target ===
                get("serviceModal")
            ){

                closeModal();

            }

        }
    );


document.addEventListener(
    "keydown",
    event => {

        if(
            event.key ===
            "Escape"
        ){

            closeModal();

        }

    }
);


/* =========================
   INITIAL STATE
========================= */

get("serviceGrid")
    .innerHTML = "";


get("empty")
    .style.display =
    "none";


/* =========================
   GLOBAL FUNCTIONS
========================= */

window.renderServices =
    renderServices;

window.loadServices =
    loadServices;

window.closeModal =
    closeModal;

window.editService =
    editService;

window.deleteService =
    deleteService;

window.shareService =
    shareService;


/* =========================
   END
========================= */

})();
</script>

</body>
</html>