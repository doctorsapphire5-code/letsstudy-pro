<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Seller Software | LetsStudy Pro</title>

<style>
*{box-sizing:border-box}

:root{
 --primary:#2563eb;
 --primary-dark:#1d4ed8;
 --dark:#172033;
 --muted:#667085;
 --bg:#f5f7fa;
 --card:#fff;
 --border:#e5e9ee;
}

body{
 margin:0;
 font-family:Inter,system-ui,sans-serif;
 background:var(--bg);
 color:var(--dark);
}

a{
 text-decoration:none;
 color:inherit;
}

button,
input,
select,
textarea{
 font:inherit;
}

.header{
 height:68px;
 background:#fff;
 border-bottom:1px solid var(--border);
 position:sticky;
 top:0;
 z-index:20;
}

.nav{
 max-width:1200px;
 height:100%;
 margin:auto;
 padding:0 18px;
 display:flex;
 align-items:center;
 justify-content:space-between;
}

.logo{
 color:var(--primary);
 font-size:20px;
 font-weight:950;
}

.navlinks{
 display:flex;
 gap:7px;
}

.navlinks a{
 padding:9px 11px;
 border-radius:8px;
 font-size:9px;
 font-weight:900;
 color:#475467;
}

.navlinks a:hover{
 background:#eff6ff;
 color:var(--primary-dark);
}

.container{
 max-width:1200px;
 margin:auto;
 padding:24px 18px 70px;
}

.hero{
 padding:30px;
 border-radius:18px;
 color:#fff;
 background:
 radial-gradient(
  circle at 90% 15%,
  #93c5fd,
  transparent 30%
 ),
 linear-gradient(
  135deg,
  #172554,
  #2563eb
 );
 animation:up .5s ease;
}

.hero h1{
 margin:0 0 7px;
 font-size:29px;
}

.hero p{
 margin:0;
 max-width:700px;
 color:#dbeafe;
 font-size:10px;
 line-height:1.7;
}

.hero-actions{
 margin-top:18px;
 display:flex;
 gap:8px;
}

.btn{
 border:0;
 border-radius:8px;
 padding:10px 14px;
 cursor:pointer;
 font-size:9px;
 font-weight:950;
}

.btn-light{
 background:#fff;
 color:var(--primary-dark);
}

.btn-dark{
 background:#172033;
 color:#fff;
}

.stats{
 display:grid;
 grid-template-columns:repeat(4,1fr);
 gap:10px;
 margin:15px 0;
}

.stat{
 background:#fff;
 border:1px solid var(--border);
 border-radius:12px;
 padding:16px;
}

.stat small{
 display:block;
 color:var(--muted);
 font-size:8px;
 font-weight:850;
}

.stat strong{
 display:block;
 margin-top:5px;
 font-size:20px;
}

.toolbar{
 display:flex;
 gap:8px;
 background:#fff;
 border:1px solid var(--border);
 border-radius:12px;
 padding:10px;
 margin-bottom:15px;
}

.search{
 flex:1;
 min-width:0;
 padding:10px;
 border:1px solid var(--border);
 border-radius:8px;
 outline:none;
 font-size:9px;
}

.select{
 padding:10px;
 border:1px solid var(--border);
 border-radius:8px;
 background:#fff;
 font-size:9px;
 outline:none;
}

.grid{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:13px;
}

.card{
 background:#fff;
 border:1px solid var(--border);
 border-radius:14px;
 overflow:hidden;
 transition:.25s;
 animation:up .45s ease;
}

.card:hover{
 transform:translateY(-4px);
 box-shadow:0 15px 35px #17203312;
}

.cover{
 width:100%;
 height:175px;
 object-fit:cover;
 background:#eff6ff;
}

.cover-empty{
 height:175px;
 display:flex;
 align-items:center;
 justify-content:center;
 background:#eff6ff;
 font-size:46px;
}

.body{
 padding:14px;
}

.badge{
 display:inline-block;
 background:#dbeafe;
 color:#1d4ed8;
 padding:5px 7px;
 border-radius:6px;
 font-size:7px;
 font-weight:950;
}

.title{
 margin:9px 0 5px;
 font-size:11px;
 font-weight:950;
}

.description{
 color:var(--muted);
 font-size:8px;
 line-height:1.6;
 min-height:30px;
}

.meta{
 display:flex;
 justify-content:space-between;
 align-items:center;
 margin-top:12px;
}

.price{
 color:#059669;
 font-size:10px;
 font-weight:950;
}

.sales{
 color:var(--muted);
 font-size:8px;
}

.status{
 margin-top:10px;
 font-size:7px;
 font-weight:950;
}

.published{
 color:#027a48;
}

.draft{
 color:#667085;
}

.actions{
 display:flex;
 gap:6px;
 margin-top:13px;
}

.action{
 flex:1;
 border:1px solid var(--border);
 background:#fff;
 border-radius:7px;
 padding:8px;
 cursor:pointer;
 font-size:8px;
 font-weight:900;
}

.action:hover{
 background:#eff6ff;
 color:var(--primary-dark);
}

.delete:hover{
 background:#fef2f2;
 color:#dc2626;
}

.empty{
 grid-column:1/-1;
 background:#fff;
 border:1px solid var(--border);
 border-radius:14px;
 padding:55px 20px;
 text-align:center;
 color:var(--muted);
 font-size:9px;
}

.toast{
 position:fixed;
 right:18px;
 bottom:18px;
 background:#172033;
 color:#fff;
 padding:11px 14px;
 border-radius:8px;
 font-size:9px;
 font-weight:900;
 opacity:0;
 transform:translateY(15px);
 transition:.25s;
 z-index:100;
}

.toast.show{
 opacity:1;
 transform:translateY(0);
}

@keyframes up{
 from{
  opacity:0;
  transform:translateY(15px);
 }
 to{
  opacity:1;
  transform:translateY(0);
 }
}

@media(max-width:900px){

.grid{
 grid-template-columns:repeat(2,1fr);
}

.stats{
 grid-template-columns:repeat(2,1fr);
}

}

@media(max-width:550px){

.container{
 padding:15px 10px 50px;
}

.grid{
 grid-template-columns:1fr;
}

.toolbar{
 flex-direction:column;
}

.hero{
 padding:22px;
}

.navlinks a:not(:last-child){
 display:none;
}

}
</style>
</head>

<body>

<header class="header">

<nav class="nav">

<a
href="seller.html"
class="logo">
LetsStudy Pro
</a>

<div class="navlinks">

<a href="seller.html">
Dashboard
</a>

<a href="products.html">
Products
</a>

<a href="seller-ebooks.html">
eBooks
</a>

<a href="cart.html">
🛒 Cart
</a>

</div>

</nav>

</header>


<main class="container">


<section class="hero">

<h1>
💻 Seller Software
</h1>

<p>
Create, publish and manage software, applications,
desktop tools, plugins, scripts and other digital software
products available through the LetsStudy Pro marketplace.
</p>

<div class="hero-actions">

<button
class="btn btn-light"
id="addBtn">
＋ Add Software
</button>

<a
href="marketplace-search.html"
class="btn btn-dark">
View Marketplace
</a>

</div>

</section>


<section class="stats">

<div class="stat">

<small>
Total Software
</small>

<strong id="total">
0
</strong>

</div>

<div class="stat">

<small>
Published
</small>

<strong id="published">
0
</strong>

</div>

<div class="stat">

<small>
Total Sales
</small>

<strong id="sales">
0
</strong>

</div>

<div class="stat">

<small>
Revenue
</small>

<strong id="revenue">
$0
</strong>

</div>

</section>


<section class="toolbar">

<input
id="search"
class="search"
placeholder="Search your software...">

<select
id="status"
class="select">

<option value="all">
All Status
</option>

<option value="published">
Published
</option>

<option value="draft">
Draft
</option>

</select>

<select
id="category"
class="select">

<option value="all">
All Categories
</option>

</select>

</section>


<section
id="grid"
class="grid">

<div class="empty">
Loading software...
</div>

</section>

</main>


<div
id="toast"
class="toast">
</div>


<script type="module">

import {
 initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-app.js";

import {
 getAuth,
 onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-auth.js";

import {
 getFirestore,
 collection,
 query,
 where,
 getDocs,
 doc,
 deleteDoc
}
from
"https://www.gstatic.com/firebasejs/12.0.0/firebase-firestore.js";


/* =====================================
FIREBASE
===================================== */

const firebaseConfig={

apiKey:
"AIzaSyBcOYDfAVKXbkljsYRgI_0rj0odBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f"

};


const app=
initializeApp(firebaseConfig);

const auth=
getAuth(app);

const db=
getFirestore(app);


/* =====================================
STATE
===================================== */

let currentUser=null;
let software=[];


/* =====================================
HELPERS
===================================== */

const $=
id=>document.getElementById(id);


function escapeHTML(value){

return String(value||"")
.replaceAll("&","&amp;")
.replaceAll("<","&lt;")
.replaceAll(">","&gt;")
.replaceAll('"',"&quot;")
.replaceAll("'","&#039;");

}


function money(
value,
currency
){

try{

return new Intl.NumberFormat(
undefined,
{
style:"currency",
currency:currency||"USD",
maximumFractionDigits:0
}
).format(
Number(value||0)
);

}catch{

return `${currency||""} ${value||0}`;

}

}


function toast(message){

const el=$("toast");

el.textContent=message;

el.classList.add("show");

setTimeout(
()=>{
el.classList.remove("show");
},
2500
);

}


/* =====================================
AUTH
===================================== */

onAuthStateChanged(
auth,
async user=>{

if(!user){

location.href=
"login.html?redirect=seller-software.html";

return;

}

currentUser=user;

await loadSoftware();

}
);


/* =====================================
LOAD SOFTWARE
===================================== */

async function loadSoftware(){

try{

const q=
query(
collection(
db,
"marketplace"
),
where(
"createdBy",
"==",
currentUser.uid
)
);


const snap=
await getDocs(q);


software=
snap.docs
.map(
d=>({
id:d.id,
...d.data()
})
)
.filter(
item=>
item.type==="software"
);


buildCategories();

render();

}catch(error){

console.error(error);

$("grid").innerHTML=`

<div class="empty">

Unable to load your software.

</div>

`;

}

}


/* =====================================
CATEGORIES
===================================== */

function buildCategories(){

const categories=
[
...new Set(
software
.map(
item=>item.category
)
.filter(Boolean)
)
].sort();


$("category").innerHTML=`

<option value="all">
All Categories
</option>

${
categories
.map(
category=>
`
<option value="${escapeHTML(category)}">
${escapeHTML(category)}
</option>
`
)
.join("")
}

`;

}


/* =====================================
RENDER
===================================== */

function render(){

const search=
$("search")
.value
.toLowerCase()
.trim();

const status=
$("status").value;

const category=
$("category").value;


const filtered=
software.filter(
item=>{

const text=`

${item.title||""}
${item.category||""}
${item.description||""}
${item.shortDescription||""}

`
.toLowerCase();


return(

(!search ||
text.includes(search))

&&

(status==="all" ||
item.status===status)

&&

(category==="all" ||
item.category===category)

);

});


/* STATS */

$("total")
.textContent=
software.length;


$("published")
.textContent=
software.filter(
item=>
item.status==="published"
).length;


const sales=
software.reduce(
(sum,item)=>
sum+
Number(item.salesCount||0),
0
);

$("sales")
.textContent=
sales.toLocaleString();


const revenue=
software.reduce(
(sum,item)=>{

const price=
Number(
item.discountPrice>0 &&
item.discountPrice<item.price
?
item.discountPrice
:
item.price||0
);

return sum+
price*
Number(item.salesCount||0);

},
0
);


$("revenue")
.textContent=
money(
revenue,
software[0]?.currency
);


/* EMPTY */

if(!filtered.length){

$("grid").innerHTML=`

<div class="empty">

💻

<br><br>

No software products found.

<br><br>

<button
class="btn btn-dark"
onclick="createSoftware()">

＋ Create Software

</button>

</div>

`;

return;

}


/* CARDS */

$("grid").innerHTML=
filtered
.map(
item=>{

const image=
item.thumbnail||
item.imageUrl||
"";


const price=
Number(
item.discountPrice>0 &&
item.discountPrice<item.price
?
item.discountPrice
:
item.price||0
);


return `

<article class="card">

${
image
?
`
<img
class="cover"
src="${escapeHTML(image)}"
alt="${escapeHTML(item.title)}"
loading="lazy">
`
:
`
<div class="cover-empty">
💻
</div>
`
}


<div class="body">

<span class="badge">
SOFTWARE
</span>


<div class="title">

${escapeHTML(
item.title||
"Untitled Software"
)}

</div>


<div class="description">

${escapeHTML(
item.shortDescription||
item.description||
"Digital software product."
)}

</div>


<div class="meta">

<span class="price">

${
price>0
?
money(
price,
item.currency
)
:
"FREE"
}

</span>


<span class="sales">

🛒 ${
Number(
item.salesCount||0
).toLocaleString()
}

</span>

</div>


<div
class="status ${
item.status==="published"
?
"published"
:
"draft"
}">

● ${
escapeHTML(
item.status||"draft"
)
}

</div>


<div class="actions">

<button
class="action"
onclick="viewSoftware('${item.id}')">

👁 View

</button>


<button
class="action"
onclick="editSoftware('${item.id}')">

✏️ Edit

</button>


<button
class="action delete"
onclick="deleteSoftware('${item.id}')">

🗑 Delete

</button>

</div>

</div>

</article>

`;

}
)
.join("");

}


/* =====================================
CREATE
===================================== */

window.createSoftware=
function(){

location.href=
"products.html?type=software";

};


/* =====================================
VIEW
===================================== */

window.viewSoftware=
function(id){

location.href=
"marketplace-product.html?productId="+
encodeURIComponent(id);

};


/* =====================================
EDIT
===================================== */

window.editSoftware=
function(id){

location.href=
"products.html?edit="+
encodeURIComponent(id);

};


/* =====================================
DELETE
===================================== */

window.deleteSoftware=
async function(id){

const item=
software.find(
product=>product.id===id
);

if(!item)
return;


const confirmed=
confirm(
`Delete "${item.title||"this software"}"?`
);

if(!confirmed)
return;


try{

await deleteDoc(
doc(
db,
"marketplace",
id
)
);

toast(
"Software deleted successfully."
);

await loadSoftware();

}catch(error){

console.error(error);

toast(
"Unable to delete software."
);

}

};


/* =====================================
EVENTS
===================================== */

$("addBtn")
.addEventListener(
"click",
createSoftware
);

$("search")
.addEventListener(
"input",
render
);

$("status")
.addEventListener(
"change",
render
);

$("category")
.addEventListener(
"change",
render
);

</script>

</body>
</html>