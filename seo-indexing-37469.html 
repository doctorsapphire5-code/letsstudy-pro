<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>Indexing Tracker – LetsStudy Pro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<!--
  DATA: Firestore collection  seoIndexing  (one document per URL, written by your GitHub Actions SEO job)
  { url, title, type: blog|courses|careers|scholarships|resources,
    status: indexed|pending|not_indexed|error, reason, lastCrawled, lastChecked (Timestamp or ISO string) }
  The newest 500 documents by lastChecked are shown. Protect the collection with Firestore rules (admins only).
-->
<style>
:root{--ink:#14213D;--paper:#F5F7FB;--surface:#fff;--line:#DCE1EC;--muted:#58627A;--blue:#2F5BEA;--good:#1F8A63;--warn:#B7791F;--bad:#C23B35;--hl:#FFE27A;color-scheme:light dark}
@media (prefers-color-scheme:dark){:root{--ink:#E8ECF7;--paper:#0F1626;--surface:#151E33;--line:#27324D;--muted:#9AA6C2;--blue:#8BA6FF;--good:#4CC79A;--warn:#E8B04A;--bad:#F0726B;--hl:#6B5A14}}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font:400 15px/1.55 Figtree,system-ui,-apple-system,"Segoe UI",sans-serif}
h1,h2{font-family:"Bricolage Grotesque",Figtree,system-ui,sans-serif;margin:0;line-height:1.15;letter-spacing:-.01em}
a{color:inherit}
:focus-visible{outline:3px solid var(--blue);outline-offset:2px;border-radius:4px}
.shell{display:grid;grid-template-columns:220px 1fr;min-height:100vh}
.side{position:sticky;top:0;align-self:start;height:100vh;padding:22px 14px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:4px}
.brand{font:700 18px "Bricolage Grotesque",sans-serif;text-decoration:none;padding:0 10px 16px}
.side a:not(.brand){padding:8px 10px;border-radius:6px;text-decoration:none;color:var(--muted);font-weight:500}
.side a:not(.brand):hover{color:var(--ink);background:var(--surface)}
.side a[aria-current]{background:var(--hl);color:var(--ink);font-weight:600}
main{padding:28px clamp(16px,4vw,44px) 56px;max-width:1120px;width:100%}
.top h1{font-size:clamp(1.5rem,3vw,2rem)}
.top p{margin:6px 0 24px;color:var(--muted)}
.tabs{display:flex;flex-wrap:wrap;border-bottom:1px solid var(--line)}
.tabs button{background:none;border:0;border-bottom:3px solid transparent;padding:12px 18px 12px 0;margin-right:18px;font:500 15px Figtree,sans-serif;color:var(--muted);cursor:pointer}
.tabs button b{display:block;font:700 1.7rem/1.1 "Bricolage Grotesque",sans-serif;color:var(--ink);font-variant-numeric:tabular-nums}
.tabs button[aria-pressed=true]{border-bottom-color:var(--blue);color:var(--ink)}
.tools{display:flex;flex-wrap:wrap;gap:10px;padding:18px 0}
input,select,button.t{padding:9px 11px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink);font:inherit}
input{flex:1;min-width:200px}
button.t{font-weight:600;cursor:pointer}
.wrap{overflow-x:auto;border-top:1px solid var(--line)}
table{border-collapse:collapse;width:100%;min-width:760px}
th{text-align:left;font-weight:600;color:var(--muted);font-size:13px;padding:10px 12px 10px 0}
td{padding:12px 12px 12px 0;border-top:1px dashed var(--line);vertical-align:top;font-size:14px}
td.u b{display:block;font-weight:600;max-width:34ch;overflow-wrap:anywhere}
td.u a,td.u span{color:var(--muted);font-size:13px;overflow-wrap:anywhere}
.pill::before{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;background:var(--c)}
.pill.good{--c:var(--good)}.pill.warn{--c:var(--warn)}.pill.bad{--c:var(--bad)}
.lnk{background:none;border:0;color:var(--blue);font:600 13px Figtree,sans-serif;padding:0;cursor:pointer}
.empty{padding:36px 0;color:var(--muted)}
@media (max-width:860px){
 .shell{grid-template-columns:1fr}
 .side{position:static;height:auto;flex-direction:row;overflow-x:auto;padding:10px 12px;border-right:0;border-bottom:1px solid var(--line)}
 .brand{padding:8px 12px 8px 4px;white-space:nowrap}.side a{white-space:nowrap}
}
</style>
</head>
<body>
<div class="shell">
  <nav class="side" aria-label="SEO sections">
    <a class="brand" href="/">LetsStudy Pro</a>
    <a href="seo-dashboard.html">Dashboard</a>
    <a href="seo-indexing.html" aria-current="page">Indexing</a>
    <a href="seo-sitemap.html">Sitemap</a>
    <a href="seo-audit.html">Technical audit</a>
    <a href="seo-schema.html">Structured data</a>
    <a href="seo-automation.html">Automation</a>
    <a href="seo-reports.html">Reports</a>
    <a href="seo-settings.html">Settings</a>
  </nav>
  <main>
    <header class="top">
      <h1>Indexing tracker</h1>
      <p id="stamp" aria-live="polite">Loading URLs…</p>
    </header>

    <div class="tabs" id="tabs" role="group" aria-label="Filter by status"></div>

    <div class="tools">
      <input type="search" id="q" placeholder="Search by address or title" aria-label="Search URLs">
      <select id="type" aria-label="Filter by section">
        <option value="">All sections</option><option value="blog">Blog posts</option><option value="courses">Courses</option><option value="careers">Careers</option><option value="scholarships">Scholarships</option><option value="resources">Resources</option>
      </select>
      <button type="button" class="t" id="csv">Export CSV</button>
    </div>

    <div class="wrap">
      <table>
        <thead><tr><th>Page</th><th>Section</th><th>Status</th><th>Why</th><th>Last crawled</th><th>Checked</th><th></th></tr></thead>
        <tbody id="body"></tbody>
      </table>
    </div>
    <p class="empty" id="empty" hidden></p>
  </main>
</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";
import { getFirestore, collection, query, orderBy, limit, onSnapshot } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";

// LETSSTUDY PRO FIREBASE CONFIG
  const firebaseConfig = {
    apiKey: "AIzaSyBcOYDfAVKXbKXjsyRgI_0rjodBn678tCc",
    authDomain: "let-s-study-pro-course.firebaseapp.com",
    databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
    projectId: "let-s-study-pro-course",
    storageBucket: "let-s-study-pro-course.firebasestorage.app",
    messagingSenderId: "474928293390",
    appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
    measurementId: "G-85B7V5H5J0"
  };

const $ = id => document.getElementById(id);
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const when = v => { if (!v) return "–"; const d = v.toDate ? v.toDate() : new Date(v); return isNaN(d) ? esc(v) : d.toLocaleDateString("en-GB", { dateStyle: "medium" }); };
const ST = { indexed: ["Indexed", "good"], pending: ["Waiting to be crawled", "warn"], not_indexed: ["Not indexed", "warn"], error: ["Error", "bad"] };
const TABS = [["all", "All URLs"], ["indexed", "Indexed"], ["pending", "Waiting"], ["not_indexed", "Not indexed"], ["error", "Errors"]];
const SECT = { blog: "Blog", courses: "Courses", careers: "Careers", scholarships: "Scholarships", resources: "Resources" };
let rows = [], flt = "all";

const shown = () => {
  const q = $("q").value.trim().toLowerCase(), t = $("type").value;
  return rows.filter(r => (flt === "all" || r.status === flt) && (!t || r.type === t) && (!q || (r.url + " " + (r.title || "")).toLowerCase().includes(q)));
};

function render() {
  const n = s => s === "all" ? rows.length : rows.filter(r => r.status === s).length;
  $("tabs").innerHTML = TABS.map(([k, l]) => `<button type="button" data-s="${k}" aria-pressed="${k === flt}"><b>${n(k).toLocaleString("en")}</b>${l}</button>`).join("");
  const list = shown();
  $("body").innerHTML = list.map((r, i) => {
    const [label, tone] = ST[r.status] || ["Unknown", ""];
    const link = /^https?:\/\//.test(r.url || "") ? `<a href="${esc(r.url)}" target="_blank" rel="noopener">${esc(r.url)}</a>` : `<span>${esc(r.url)}</span>`;
    return `<tr><td class="u"><b>${esc(r.title || "Untitled")}</b>${link}</td><td>${esc(SECT[r.type] || r.type || "–")}</td>
      <td><span class="pill ${tone}">${esc(label)}</span></td><td>${esc(r.reason || "–")}</td><td>${when(r.lastCrawled)}</td><td>${when(r.lastChecked)}</td>
      <td><button type="button" class="lnk" data-i="${i}">Copy link</button></td></tr>`;
  }).join("");
  const e = $("empty");
  e.hidden = list.length > 0;
  e.textContent = rows.length ? "No URLs match these filters." : "No URLs tracked yet. Your automation adds them to the seoIndexing collection.";
  view = list;
}
let view = [];

$("tabs").addEventListener("click", e => { const b = e.target.closest("button[data-s]"); if (b) { flt = b.dataset.s; render(); } });
$("q").addEventListener("input", render);
$("type").addEventListener("change", render);
$("body").addEventListener("click", async e => {
  const b = e.target.closest("button[data-i]"); if (!b) return;
  try { await navigator.clipboard.writeText(view[b.dataset.i].url); b.textContent = "Copied"; } catch { b.textContent = "Copy failed"; }
  setTimeout(() => { b.textContent = "Copy link"; }, 1500);
});
$("csv").addEventListener("click", () => {
  const cell = v => { v = String(v ?? ""); if (/^[=+\-@]/.test(v)) v = "'" + v; return '"' + v.replace(/"/g, '""') + '"'; };
  const d = v => v ? (v.toDate ? v.toDate() : new Date(v)).toISOString() : "";
  const lines = [["url", "title", "section", "status", "reason", "lastCrawled", "lastChecked"].join(",")]
    .concat(view.map(r => [r.url, r.title, r.type, r.status, r.reason, d(r.lastCrawled), d(r.lastChecked)].map(cell).join(",")));
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([lines.join("\n")], { type: "text/csv" }));
  a.download = "letsstudy-indexing-" + new Date().toISOString().slice(0, 10) + ".csv";
  a.click(); URL.revokeObjectURL(a.href);
});

render();

if (firebaseConfig.apiKey.startsWith("YOUR_")) {
  $("stamp").textContent = "Add your Firebase web config at the top of this page’s script to load URLs.";
} else {
  const db = getFirestore(initializeApp(firebaseConfig));
  onSnapshot(query(collection(db, "seoIndexing"), orderBy("lastChecked", "desc"), limit(500)), snap => {
    rows = snap.docs.map(d => d.data());
    $("stamp").textContent = `Showing the ${rows.length} most recently checked URLs. This page refreshes by itself.`;
    render();
  }, err => {
    $("stamp").textContent = "Can’t read seoIndexing (" + (err.code || "error") + "). Check you are signed in and that your Firestore rules allow it.";
  });
}
</script>
</body>
</html>
