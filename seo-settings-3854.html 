<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>SEO Settings – LetsStudy Pro</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<!--
  DATA: Firestore document  seoSettings/main  (read and written by this page; read by your GitHub Actions SEO job).
  Never put API secrets here. Keep Google and Bing credentials in GitHub Secrets.
  Protect this document with Firestore rules (admins only). This page does no client-side access checks.
-->
<style>
:root{--ink:#14213D;--paper:#F5F7FB;--surface:#fff;--line:#DCE1EC;--muted:#58627A;--blue:#2F5BEA;--good:#1F8A63;--bad:#C23B35;--hl:#FFE27A;color-scheme:light dark}
@media (prefers-color-scheme:dark){:root{--ink:#E8ECF7;--paper:#0F1626;--surface:#151E33;--line:#27324D;--muted:#9AA6C2;--blue:#8BA6FF;--good:#4CC79A;--bad:#F0726B;--hl:#6B5A14}}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font:400 15px/1.55 Figtree,system-ui,-apple-system,"Segoe UI",sans-serif}
h1,h2{font-family:"Bricolage Grotesque",Figtree,system-ui,sans-serif;margin:0;line-height:1.15;letter-spacing:-.01em}
a{color:inherit}
:focus-visible{outline:3px solid var(--blue);outline-offset:2px;border-radius:4px}
.shell{display:grid;grid-template-columns:220px 1fr;min-height:100vh}
.side{position:sticky;top:0;align-self:start;height:100vh;padding:22px 14px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:4px}
.brand{font:700 18px "Bricolage Grotesque",sans-serif;text-decoration:none;padding:0 10px 16px}
.side a:not(.brand){padding:8px 10px;border-radius:6px;text-decoration:none;color:var(--muted);font-weight:500}
.side a:not(.brand):hover{color:var(--ink);background:var(--surface)}
.side a[aria-current]{background:var(--hl);color:var(--ink);font-weight:600}
main{padding:28px clamp(16px,4vw,44px) 0;max-width:1120px;width:100%}
.top h1{font-size:clamp(1.5rem,3vw,2rem)}
.top p{margin:6px 0 24px;color:var(--muted);max-width:62ch}
.sec{display:grid;grid-template-columns:240px 1fr;gap:28px;padding:28px 0;border-top:1px solid var(--line)}
.sec h2{font-size:1.2rem}
.sec>div>p{margin:6px 0 0;color:var(--muted);font-size:14px}
.fields{display:grid;gap:16px;max-width:640px}
.pair{display:grid;grid-template-columns:1fr 1fr;gap:16px}
label{display:block;font-weight:600;font-size:14px}
label small{display:block;font-weight:400;color:var(--muted);margin-top:2px}
input[type=text],input[type=url],input[type=email],input[type=number],select,textarea{display:block;width:100%;margin-top:6px;padding:9px 11px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink);font:inherit}
textarea{min-height:110px;resize:vertical;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:13px;line-height:1.5}
input[aria-invalid=true]{border-color:var(--bad)}
.check{display:flex;gap:10px;align-items:flex-start;font-weight:500}
.check input{margin-top:4px;width:18px;height:18px;accent-color:var(--blue)}
.types{display:grid;gap:0}
.type{display:grid;grid-template-columns:150px 1fr 120px 80px;gap:12px;align-items:end;padding:12px 0}
.type+.type{border-top:1px dashed var(--line)}
.type label{font-weight:500}
.type .check{padding-bottom:9px}
.bar{position:sticky;bottom:0;margin:0 calc(-1*clamp(16px,4vw,44px));padding:14px clamp(16px,4vw,44px) calc(14px + env(safe-area-inset-bottom,0px));background:var(--paper);border-top:1px solid var(--line);display:flex;gap:12px;align-items:center;flex-wrap:wrap}
button{font:600 15px Figtree,sans-serif;padding:10px 18px;border-radius:6px;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer}
button.primary{background:var(--blue);border-color:var(--blue);color:#fff}
@media (prefers-color-scheme:dark){button.primary{color:#0F1626}}
button:disabled{opacity:.5;cursor:not-allowed}
#status{color:var(--muted);flex:1;min-width:180px}
#errors{margin:0 0 8px;padding:12px 16px;border-left:3px solid var(--bad);background:var(--surface);display:none}
#errors ul{margin:6px 0 0;padding-left:18px}
@media (max-width:860px){
 .shell{grid-template-columns:1fr}
 .side{position:static;height:auto;flex-direction:row;overflow-x:auto;padding:10px 12px;border-right:0;border-bottom:1px solid var(--line)}
 .brand{padding:8px 12px 8px 4px;white-space:nowrap}
 .side a{white-space:nowrap}
 .sec{grid-template-columns:1fr;gap:16px}
 .type{grid-template-columns:1fr 1fr}
 .type .wide{grid-column:1/-1}
}
@media (max-width:520px){.pair{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="shell">
  <nav class="side" aria-label="SEO sections">
    <a class="brand" href="/">LetsStudy Pro</a>
    <a href="seo-dashboard.html">Dashboard</a>
    <a href="seo-indexing.html">Indexing</a>
    <a href="seo-sitemap.html">Sitemap</a>
    <a href="seo-audit.html">Technical audit</a>
    <a href="seo-schema.html">Structured data</a>
    <a href="seo-automation.html">Automation</a>
    <a href="seo-reports.html">Reports</a>
    <a href="seo-settings.html" aria-current="page">Settings</a>
  </nav>

  <main>
    <header class="top">
      <h1>SEO settings</h1>
      <p>One place for the rules your SEO automation follows: how pages are titled, which content goes in the sitemap, and which search engines are told about changes.</p>
    </header>

    <form id="f" novalidate autocomplete="off">
      <div id="errors" role="alert"></div>

      <section class="sec" aria-labelledby="h1s">
        <div><h2 id="h1s">Site identity</h2><p>Used for titles, canonical URLs and social previews on every page.</p></div>
        <div class="fields">
          <div class="pair">
            <label>Site name<input type="text" name="site.name"></label>
            <label>Main language<select name="site.language"><option value="en">English</option><option value="sw">Swahili</option></select></label>
          </div>
          <label>Site address<small>Start with https:// and leave off the final slash.</small><input type="url" name="site.baseUrl" placeholder="https://letsstudy.pro"></label>
          <label>Title format<small>%title% is replaced with each page’s own title.</small><input type="text" name="site.titleTemplate"></label>
          <label>Default meta description<small>Used when a page has none. Aim for 120 to 160 characters.</small><textarea name="site.description" style="min-height:80px;font-family:inherit;font-size:15px"></textarea></label>
          <div class="pair">
            <label>Default share image<small>Full https:// link, 1200 × 630 works best.</small><input type="url" name="site.ogImage"></label>
            <label>X (Twitter) handle<input type="text" name="site.twitter" placeholder="@letsstudypro"></label>
          </div>
        </div>
      </section>

      <section class="sec" aria-labelledby="h2s">
        <div><h2 id="h2s">Content in the sitemap</h2><p>Turn a section off to keep it out of the sitemap. Use {id} or {slug} in the address pattern.</p></div>
        <div class="types" id="types"></div>
      </section>

      <section class="sec" aria-labelledby="h3s">
        <div><h2 id="h3s">Robots.txt</h2><p>The sitemap line is added automatically when the file is generated. Blocking a page here stops crawling, but does not remove it from search results.</p></div>
        <div class="fields"><label>Rules<textarea name="robots" spellcheck="false" style="min-height:160px"></textarea></label></div>
      </section>

      <section class="sec" aria-labelledby="h4s">
        <div><h2 id="h4s">Search engines</h2><p>Credentials such as API keys and service accounts belong in GitHub Secrets, not on this page.</p></div>
        <div class="fields">
          <div class="pair">
            <label>Google Search Console property<input type="url" name="engines.gscProperty"></label>
            <label>Bing Webmaster site<input type="url" name="engines.bingSite"></label>
          </div>
          <div class="pair">
            <label>Google verification code<small>The content value of the meta tag.</small><input type="text" name="engines.googleVerification"></label>
            <label>Bing verification code<input type="text" name="engines.bingVerification"></label>
          </div>
          <label class="check"><input type="checkbox" name="engines.indexnowEnabled"><span>Notify IndexNow when a page is added, changed or removed<small>Participating search engines hear about the change. Indexing is still their decision.</small></span></label>
          <label>IndexNow key<small>8 to 128 letters, numbers or dashes. The key file must be served at your site address as KEY.txt.</small><input type="text" name="engines.indexnowKey" spellcheck="false"></label>
        </div>
      </section>

      <section class="sec" aria-labelledby="h5s">
        <div><h2 id="h5s">Automation and alerts</h2><p>Decide how much the system does without you.</p></div>
        <div class="fields">
          <label>When new or changed pages are found<select name="automation.mode"><option value="approval">Wait for an admin to approve</option><option value="auto">Update sitemap and notify engines automatically</option></select></label>
          <label class="check"><input type="checkbox" name="automation.alertsEnabled"><span>Email me when something needs attention</span></label>
          <label>Alert email<input type="email" name="automation.alertEmail"></label>
        </div>
      </section>

      <section class="sec" aria-labelledby="h6s">
        <div><h2 id="h6s">Organization details</h2><p>Feeds the Organization structured data that helps search engines recognise LetsStudy Pro.</p></div>
        <div class="fields">
          <div class="pair">
            <label>Organization name<input type="text" name="org.name"></label>
            <label>Contact email<input type="email" name="org.email"></label>
          </div>
          <label>Logo link<small>Square image, at least 112 × 112 pixels.</small><input type="url" name="org.logo"></label>
          <label>Official profiles<small>One link per line (social pages, app stores).</small><textarea name="org.sameAs" style="min-height:90px"></textarea></label>
        </div>
      </section>

      <div class="bar">
        <button type="submit" class="primary" id="save" disabled>Save settings</button>
        <button type="button" id="discard" disabled>Discard changes</button>
        <span id="status" aria-live="polite">Loading settings…</span>
      </div>
    </form>
  </main>
</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";
import { getFirestore, doc, getDoc, setDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";

// LETSSTUDY PRO FIREBASE CONFIG
  const firebaseConfig = {
    apiKey: "AIzaSyBcOYDfAVKXbKXjsyRgI_0rjodBn678tCc",
    authDomain: "let-s-study-pro-course.firebaseapp.com",
    databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
    projectId: "let-s-study-pro-course",
    storageBucket: "let-s-study-pro-course.firebasestorage.app",
    messagingSenderId: "474928293390",
    appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
    measurementId: "G-85B7V5H5J0"
  };

const DEFAULTS = {
  site: { name: "LetsStudy Pro", language: "en", baseUrl: "https://letsstudy.pro", titleTemplate: "%title% – LetsStudy Pro", description: "", ogImage: "", twitter: "" },
  types: {
    blog:         { enabled: true, pattern: "/blog-details.html?id={id}",        changefreq: "weekly",  priority: 0.7 },
    courses:      { enabled: true, pattern: "/course-details.html?id={id}",      changefreq: "monthly", priority: 0.8 },
    careers:      { enabled: true, pattern: "/career-details.html?id={id}",      changefreq: "weekly",  priority: 0.6 },
    scholarships: { enabled: true, pattern: "/scholarship-details.html?id={id}", changefreq: "weekly",  priority: 0.7 },
    resources:    { enabled: true, pattern: "/resource-details.html?id={id}",    changefreq: "monthly", priority: 0.6 }
  },
  robots: "User-agent: *\nAllow: /\nDisallow: /admin-\nDisallow: /seo-\nDisallow: /login.html",
  engines: { gscProperty: "https://letsstudy.pro/", bingSite: "https://letsstudy.pro/", googleVerification: "", bingVerification: "", indexnowEnabled: true, indexnowKey: "" },
  automation: { mode: "approval", alertsEnabled: true, alertEmail: "support@letsstudy.pro" },
  org: { name: "LetsStudy Pro", logo: "", email: "support@letsstudy.pro", sameAs: [] }
};
const TYPE_LABELS = { blog: "Blog posts", courses: "Courses", careers: "Careers", scholarships: "Scholarships", resources: "Resources" };

const $ = id => document.getElementById(id);
const form = $("f");
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const getP = (o, p) => p.split(".").reduce((a, k) => (a == null ? a : a[k]), o);
const setP = (o, p, v) => { const k = p.split("."); const last = k.pop(); k.reduce((a, x) => (a[x] ??= {}), o)[last] = v; };
const merge = (base, over) => {
  if (Array.isArray(base) || typeof base !== "object" || base === null) return over === undefined ? base : over;
  const out = { ...base };
  for (const k in (over || {})) out[k] = merge(base[k], over[k]);
  return out;
};

/* Content type rows */
$("types").innerHTML = Object.keys(TYPE_LABELS).map(k => `
  <div class="type">
    <label class="check"><input type="checkbox" name="types.${k}.enabled"><span>${TYPE_LABELS[k]}</span></label>
    <label class="wide">Address pattern<input type="text" name="types.${k}.pattern" spellcheck="false"></label>
    <label>Change rate<select name="types.${k}.changefreq">${["daily","weekly","monthly","yearly"].map(v => `<option>${v}</option>`).join("")}</select></label>
    <label>Priority<input type="number" name="types.${k}.priority" min="0" max="1" step="0.1"></label>
  </div>`).join("");

const fields = () => [...form.elements].filter(e => e.name);
let saved = null;

function fill(data) {
  for (const el of fields()) {
    const v = getP(data, el.name);
    if (el.type === "checkbox") el.checked = !!v;
    else if (el.name === "org.sameAs") el.value = (v || []).join("\n");
    else el.value = v ?? "";
    el.removeAttribute("aria-invalid");
  }
}
function collect() {
  const out = {};
  for (const el of fields()) {
    let v;
    if (el.type === "checkbox") v = el.checked;
    else if (el.name === "org.sameAs") v = el.value.split("\n").map(s => s.trim()).filter(Boolean);
    else if (el.type === "number") v = Number(el.value);
    else if (el.name === "robots") v = el.value.replace(/\s+$/, "");
    else v = el.value.trim();
    setP(out, el.name, v);
  }
  return out;
}

function validate(d) {
  const bad = [];
  const flag = (name, msg) => { bad.push(msg); form.elements[name]?.setAttribute("aria-invalid", "true"); };
  fields().forEach(e => e.removeAttribute("aria-invalid"));
  const https = u => /^https:\/\/[^\s/]+(\/\S*)?$/.test(u);
  if (!/^https:\/\/[^\s/]+$/.test(d.site.baseUrl)) flag("site.baseUrl", "Site address must start with https:// and have no final slash.");
  if (!d.site.name) flag("site.name", "Enter a site name.");
  if (!d.site.titleTemplate.includes("%title%")) flag("site.titleTemplate", "Title format must contain %title%.");
  if (d.site.ogImage && !https(d.site.ogImage)) flag("site.ogImage", "Share image must be a full https:// link.");
  if (d.org.logo && !https(d.org.logo)) flag("org.logo", "Logo must be a full https:// link.");
  if (d.engines.gscProperty && !https(d.engines.gscProperty)) flag("engines.gscProperty", "Google Search Console property must be a full https:// link.");
  if (d.engines.bingSite && !https(d.engines.bingSite)) flag("engines.bingSite", "Bing site must be a full https:// link.");
  if (d.engines.indexnowKey && !/^[A-Za-z0-9-]{8,128}$/.test(d.engines.indexnowKey)) flag("engines.indexnowKey", "IndexNow key must be 8 to 128 letters, numbers or dashes.");
  if (d.engines.indexnowEnabled && !d.engines.indexnowKey) flag("engines.indexnowKey", "Add an IndexNow key, or turn IndexNow notifications off.");
  const mail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (d.automation.alertsEnabled && !mail.test(d.automation.alertEmail)) flag("automation.alertEmail", "Enter a valid alert email.");
  if (d.org.email && !mail.test(d.org.email)) flag("org.email", "Enter a valid contact email.");
  if (d.org.sameAs.some(u => !https(u))) flag("org.sameAs", "Every official profile must be a full https:// link.");
  for (const k in TYPE_LABELS) {
    const t = d.types[k];
    if (!t.pattern.startsWith("/")) flag(`types.${k}.pattern`, `${TYPE_LABELS[k]}: address pattern must start with /.`);
    else if (!/\{(id|slug)\}/.test(t.pattern)) flag(`types.${k}.pattern`, `${TYPE_LABELS[k]}: pattern needs {id} or {slug}.`);
    if (!(t.priority >= 0 && t.priority <= 1)) flag(`types.${k}.priority`, `${TYPE_LABELS[k]}: priority must be between 0 and 1.`);
  }
  return bad;
}

function showErrors(list) {
  const box = $("errors");
  box.style.display = list.length ? "block" : "none";
  box.innerHTML = list.length ? `<strong>Fix ${list.length === 1 ? "this" : "these"} before saving</strong><ul>${list.map(m => `<li>${esc(m)}</li>`).join("")}</ul>` : "";
  if (list.length) box.scrollIntoView({ block: "nearest" });
}

const setDirty = on => {
  $("save").disabled = !on; $("discard").disabled = !on;
  $("status").textContent = on ? "You have unsaved changes." : $("status").dataset.idle || "All changes saved.";
};
form.addEventListener("input", () => setDirty(true));
$("discard").addEventListener("click", () => { fill(saved); showErrors([]); setDirty(false); });
window.addEventListener("beforeunload", e => { if (!$("save").disabled) { e.preventDefault(); e.returnValue = ""; } });

fill(DEFAULTS);

if (firebaseConfig.apiKey.startsWith("YOUR_")) {
  $("status").textContent = "Add your Firebase web config at the top of this page’s script to load and save settings.";
  saved = DEFAULTS;
} else {
  const db = getFirestore(initializeApp(firebaseConfig));
  const ref = doc(db, "seoSettings", "main");
  getDoc(ref).then(snap => {
    saved = merge(DEFAULTS, snap.exists() ? snap.data() : {});
    fill(saved);
    $("status").dataset.idle = snap.exists() ? "All changes saved." : "No saved settings yet. Defaults are shown; save to create them.";
    setDirty(false);
  }).catch(err => {
    saved = DEFAULTS;
    $("status").textContent = "Can’t read seoSettings/main (" + (err.code || "error") + "). Check you are signed in and that your Firestore rules allow it.";
  });

  form.addEventListener("submit", async e => {
    e.preventDefault();
    const data = collect();
    const problems = validate(data);
    showErrors(problems);
    if (problems.length) return;
    $("save").disabled = true;
    $("status").textContent = "Saving…";
    try {
      await setDoc(ref, { ...data, updatedAt: serverTimestamp() }, { merge: true });
      saved = data;
      $("status").dataset.idle = "Settings saved.";
      setDirty(false);
    } catch (err) {
      $("save").disabled = false;
      $("status").textContent = "Couldn’t save (" + (err.code || "error") + "). Your changes are still on this page.";
    }
  });
}
</script>
</body>
</html>
