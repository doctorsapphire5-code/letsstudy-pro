<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Service Details · LetsStudy Pro</title>
  <meta name="description" content="Explore professional services available on LetsStudy Pro.">

  <link rel="icon" href="favicon.png">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f7fb;
      color: #172033;
      line-height: 1.6;
    }

    header {
      background: #fff;
      border-bottom: 1px solid #e5e7eb;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav {
      max-width: 1200px;
      margin: auto;
      padding: 16px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand {
      color: #2563eb;
      font-size: 21px;
      font-weight: 800;
      text-decoration: none;
    }

    .back {
      color: #475569;
      text-decoration: none;
      font-weight: 600;
    }

    main {
      max-width: 1200px;
      margin: 35px auto;
      padding: 0 20px;
    }

    .loading,
    .error {
      background: #fff;
      padding: 45px 20px;
      border-radius: 20px;
      text-align: center;
      box-shadow: 0 8px 30px rgba(0,0,0,.06);
    }

    .error {
      color: #dc2626;
    }

    .service-layout {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(290px, 1fr);
      gap: 28px;
    }

    .card {
      background: #fff;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 8px 30px rgba(0,0,0,.07);
    }

    .hero-image {
      width: 100%;
      aspect-ratio: 16 / 8;
      object-fit: cover;
      display: block;
      background: #e2e8f0;
    }

    .content {
      padding: 30px;
    }

    .category {
      display: inline-block;
      background: #eff6ff;
      color: #2563eb;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 14px;
    }

    h1 {
      font-size: clamp(28px, 4vw, 46px);
      line-height: 1.15;
      margin-bottom: 15px;
    }

    .description {
      color: #64748b;
      font-size: 16px;
      margin-bottom: 28px;
    }

    .section {
      margin-top: 30px;
    }

    .section h2 {
      font-size: 22px;
      margin-bottom: 12px;
    }

    .section p {
      color: #475569;
    }

    .list {
      list-style: none;
      display: grid;
      gap: 10px;
    }

    .list li {
      background: #f8fafc;
      border-radius: 10px;
      padding: 12px 14px;
    }

    .list li::before {
      content: "✓";
      color: #16a34a;
      font-weight: 800;
      margin-right: 9px;
    }

    .side {
      padding: 25px;
      height: fit-content;
      position: sticky;
      top: 90px;
    }

    .status {
      display: inline-block;
      background: #dcfce7;
      color: #15803d;
      padding: 6px 11px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 800;
      margin-bottom: 18px;
    }

    .price {
      font-size: 34px;
      font-weight: 900;
      color: #2563eb;
      margin: 8px 0 20px;
    }

    .meta {
      border-top: 1px solid #e5e7eb;
      padding-top: 18px;
    }

    .meta-row {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      padding: 11px 0;
      border-bottom: 1px solid #f1f5f9;
    }

    .meta-label {
      color: #64748b;
    }

    .meta-value {
      font-weight: 700;
      text-align: right;
    }

    .action {
      display: block;
      width: 100%;
      border: 0;
      border-radius: 12px;
      padding: 15px;
      margin-top: 20px;
      background: #2563eb;
      color: white;
      text-align: center;
      text-decoration: none;
      font-size: 16px;
      font-weight: 800;
      cursor: pointer;
    }

    .action:hover {
      background: #1d4ed8;
    }

    .secondary {
      background: #f1f5f9;
      color: #334155;
    }

    .secondary:hover {
      background: #e2e8f0;
    }

    footer {
      text-align: center;
      color: #64748b;
      padding: 50px 20px;
    }

    @media (max-width: 850px) {
      .service-layout {
        grid-template-columns: 1fr;
      }

      .side {
        position: static;
      }
    }
  </style>
</head>

<body>

<header>
  <nav class="nav">
    <a href="index.html" class="brand">LetsStudy Pro</a>
    <a href="services.html" class="back">← Services</a>
  </nav>
</header>

<main>

  <div id="loading" class="loading">
    Loading service...
  </div>

  <div id="error" class="error" style="display:none;"></div>

  <section id="serviceLayout"
           class="service-layout"
           style="display:none;">

    <article class="card">

      <img
        id="image"
        class="hero-image"
        src=""
        alt="Service"
      >

      <div class="content">

        <span id="category" class="category">
          Service
        </span>

        <h1 id="title"></h1>

        <p id="description" class="description"></p>


        <section id="overviewSection" class="section">
          <h2>Service Overview</h2>
          <p id="overview"></p>
        </section>


        <section id="featuresSection" class="section">
          <h2>What You Get</h2>
          <ul id="features" class="list"></ul>
        </section>


        <section id="requirementsSection" class="section">
          <h2>Requirements</h2>
          <ul id="requirements" class="list"></ul>
        </section>


        <section id="processSection" class="section">
          <h2>How It Works</h2>
          <ol id="process" class="list"></ol>
        </section>

      </div>

    </article>


    <aside class="card side">

      <span id="status" class="status">
        Available
      </span>

      <div id="price" class="price">
        Contact us
      </div>


      <div class="meta">

        <div class="meta-row">
          <span class="meta-label">Category</span>
          <span id="sideCategory" class="meta-value">—</span>
        </div>

        <div class="meta-row">
          <span class="meta-label">Provider</span>
          <span id="provider" class="meta-value">—</span>
        </div>

        <div class="meta-row">
          <span class="meta-label">Delivery</span>
          <span id="delivery" class="meta-value">—</span>
        </div>

        <div class="meta-row">
          <span class="meta-label">Location</span>
          <span id="location" class="meta-value">—</span>
        </div>

      </div>


      <a
        id="actionBtn"
        class="action"
        href="#"
      >
        Request Service
      </a>

      <a
        href="services.html"
        class="action secondary"
      >
        Browse More Services
      </a>

    </aside>

  </section>

</main>

<footer>
  © <span id="year"></span> LetsStudy Pro. All rights reserved.
</footer>


<script type="module">

  import {
    initializeApp
  } from "https://www.gstatic.com/firebasejs/10.12.5/firebase-app.js";

  import {
    getFirestore,
    doc,
    getDoc
  } from "https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore.js";


  /* =========================
     FIREBASE
  ========================= */

  const firebaseConfig = {
    apiKey: "AIzaSyBcOYDfAVK5XbkljsyRg4I_0rj0odBn678tCc",
    authDomain: "let-s-study-pro-course.firebaseapp.com",
    databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
    projectId: "let-s-study-pro-course",
    storageBucket: "let-s-study-pro-course.firebasestorage.app",
    messagingSenderId: "474928293390",
    appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
    measurementId: "G-85B7V5H5J0"
  };

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);


  /* =========================
     DOM
  ========================= */

  const loading =
    document.getElementById("loading");

  const errorBox =
    document.getElementById("error");

  const layout =
    document.getElementById("serviceLayout");

  const image =
    document.getElementById("image");

  const category =
    document.getElementById("category");

  const title =
    document.getElementById("title");

  const description =
    document.getElementById("description");

  const overview =
    document.getElementById("overview");

  const features =
    document.getElementById("features");

  const requirements =
    document.getElementById("requirements");

  const process =
    document.getElementById("process");

  const status =
    document.getElementById("status");

  const price =
    document.getElementById("price");

  const sideCategory =
    document.getElementById("sideCategory");

  const provider =
    document.getElementById("provider");

  const delivery =
    document.getElementById("delivery");

  const location =
    document.getElementById("location");

  const actionBtn =
    document.getElementById("actionBtn");

  document.getElementById("year").textContent =
    new Date().getFullYear();


  /* =========================
     HELPERS
  ========================= */

  function firstValue(obj, keys, fallback = "") {

    for (const key of keys) {

      const value = obj?.[key];

      if (
        value !== undefined &&
        value !== null &&
        String(value).trim() !== ""
      ) {
        return value;
      }

    }

    return fallback;
  }


  function toArray(value) {

    if (Array.isArray(value)) {
      return value;
    }

    if (typeof value === "string") {

      return value
        .split(/\r?\n|•|,/)
        .map(item => item.trim())
        .filter(Boolean);

    }

    if (
      value &&
      typeof value === "object"
    ) {

      return Object.values(value)
        .map(item => {

          if (
            typeof item === "string" ||
            typeof item === "number"
          ) {
            return String(item);
          }

          return firstValue(
            item,
            [
              "title",
              "name",
              "text",
              "description",
              "step"
            ],
            ""
          );

        })
        .filter(Boolean);

    }

    return [];

  }


  function escapeHtml(value) {

    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

  }


  function getPrice(data) {

    const value = firstValue(
      data,
      [
        "price",
        "amount",
        "cost",
        "servicePrice"
      ],
      ""
    );

    if (
      value === "" ||
      value === null ||
      value === undefined
    ) {
      return null;
    }

    const number =
      Number(
        String(value)
          .replace(/[^\d.-]/g, "")
      );

    return Number.isFinite(number)
      ? number
      : null;

  }


  function formatPrice(value) {

    if (
      value === null ||
      value === undefined
    ) {
      return "Contact us";
    }

    if (value <= 0) {
      return "Free";
    }

    return new Intl.NumberFormat(
      undefined,
      {
        style: "currency",
        currency: "TZS",
        maximumFractionDigits: 0
      }
    ).format(value);

  }


  function renderList(
    element,
    values,
    emptyText = "Details available on request."
  ) {

    element.innerHTML = "";


    if (!values.length) {

      const li =
        document.createElement("li");

      li.textContent =
        emptyText;

      element.appendChild(li);

      return;

    }


    values.forEach(value => {

      const li =
        document.createElement("li");

      li.textContent =
        value;

      element.appendChild(li);

    });

  }


  function setSectionVisibility(
    sectionId,
    hasContent
  ) {

    const section =
      document.getElementById(sectionId);

    if (section) {

      section.style.display =
        hasContent ? "block" : "none";

    }

  }


  function showError(message) {

    loading.style.display = "none";
    layout.style.display = "none";

    errorBox.textContent =
      message;

    errorBox.style.display =
      "block";

  }


  /* =========================
     URL
  ========================= */

  const params =
    new URLSearchParams(
      window.location.search
    );

  const serviceId =
    params.get("id");


  /* =========================
     LOAD SERVICE
  ========================= */

  async function loadService() {

    if (!serviceId) {

      showError(
        "Service not found. Please select a service first."
      );

      return;

    }


    try {

      const snap =
        await getDoc(
          doc(db, "services", serviceId)
        );


      if (!snap.exists()) {

        showError(
          "This service could not be found."
        );

        return;

      }


      const data =
        snap.data();


      /* =========================
         BASIC DATA
      ========================= */

      const serviceTitle =
        firstValue(
          data,
          [
            "title",
            "name",
            "serviceTitle",
            "serviceName"
          ],
          "Untitled Service"
        );


      const serviceDescription =
        firstValue(
          data,
          [
            "description",
            "summary",
            "shortDescription",
            "overview",
            "content"
          ],
          "Professional service available through LetsStudy Pro."
        );


      const serviceCategory =
        firstValue(
          data,
          [
            "category",
            "serviceCategory",
            "field",
            "sector",
            "type"
          ],
          "Professional Service"
        );


      const serviceImage =
        firstValue(
          data,
          [
            "image",
            "imageUrl",
            "thumbnail",
            "thumbnailUrl",
            "cover",
            "coverImage"
          ],
          "https://via.placeholder.com/1280x640?text=LetsStudy+Pro"
        );


      const serviceOverview =
        firstValue(
          data,
          [
            "overview",
            "about",
            "description",
            "details",
            "content"
          ],
          serviceDescription
        );


      const serviceProvider =
        firstValue(
          data,
          [
            "provider",
            "providerName",
            "seller",
            "sellerName",
            "company",
            "businessName",
            "author"
          ],
          "LetsStudy Pro"
        );


      const serviceDelivery =
        firstValue(
          data,
          [
            "delivery",
            "deliveryTime",
            "turnaround",
            "duration",
            "timeframe"
          ],
          "Flexible"
        );


      const serviceLocation =
        firstValue(
          data,
          [
            "location",
            "serviceLocation",
            "availability"
          ],
          "Online"
        );


      const serviceStatus =
        firstValue(
          data,
          [
            "status",
            "serviceStatus"
          ],
          "Available"
        );


      const servicePrice =
        getPrice(data);


      /* =========================
         ARRAYS
      ========================= */

      const serviceFeatures =
        toArray(
          firstValue(
            data,
            [
              "features",
              "benefits",
              "whatYouGet",
              "included"
            ],
            []
          )
        );


      const serviceRequirements =
        toArray(
          firstValue(
            data,
            [
              "requirements",
              "serviceRequirements",
              "needed"
            ],
            []
          )
        );


      const serviceProcess =
        toArray(
          firstValue(
            data,
            [
              "process",
              "steps",
              "howItWorks",
              "workflow"
            ],
            []
          )
        );


      /* =========================
         DISPLAY
      ========================= */

      document.title =
        `${serviceTitle} · LetsStudy Pro`;


      image.src =
        serviceImage;

      image.alt =
        `${serviceTitle} · LetsStudy Pro`;


      category.textContent =
        serviceCategory;

      title.textContent =
        serviceTitle;

      description.textContent =
        serviceDescription;

      overview.textContent =
        serviceOverview;


      sideCategory.textContent =
        serviceCategory;

      provider.textContent =
        serviceProvider;

      delivery.textContent =
        serviceDelivery;

      location.textContent =
        serviceLocation;

      status.textContent =
        serviceStatus;

      price.textContent =
        formatPrice(servicePrice);


      renderList(
        features,
        serviceFeatures,
        "Service details available on request."
      );


      renderList(
        requirements,
        serviceRequirements,
        "Requirements will be discussed before service delivery."
      );


      renderList(
        process,
        serviceProcess,
        "Contact the service provider for the delivery process."
      );


      setSectionVisibility(
        "featuresSection",
        serviceFeatures.length > 0
      );

      setSectionVisibility(
        "requirementsSection",
        serviceRequirements.length > 0
      );

      setSectionVisibility(
        "processSection",
        serviceProcess.length > 0
      );


      /* =========================
         ACTION
      ========================= */

      const contactUrl =
        firstValue(
          data,
          [
            "contactUrl",
            "contactURL",
            "requestUrl",
            "bookingUrl",
            "link",
            "url"
          ],
          ""
        );


      if (contactUrl) {

        actionBtn.href =
          contactUrl;

        actionBtn.target =
          "_blank";

        actionBtn.rel =
          "noopener noreferrer";

      } else {

        actionBtn.href =
          `service-request.html?id=${encodeURIComponent(serviceId)}`;

      }


      loading.style.display =
        "none";

      layout.style.display =
        "grid";


    } catch (error) {

      console.error(error);

      showError(
        "Unable to load this service. Please try again."
      );

    }

  }


  /* =========================
     START
  ========================= */

  loadService();

</script>

</body>
</html>