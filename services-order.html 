</h2><p>
Learn. Build. Grow.
</p><p>
Professional learning, careers and business ecosystem.
</p></footer><script type="module">

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

import {
getFirestore,
doc,
getDoc
}
from
"https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


/* =========================================
   FIREBASE
========================================= */

const firebaseConfig={

apiKey:
"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

databaseURL:
"https://let-s-study-pro-course-default-rtdb.firebaseio.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f",

measurementId:
"G-85B7V5H5J0"

};

const app=
initializeApp(firebaseConfig);

const db=
getFirestore(app);


/* =========================================
   READ SERVICE ID
========================================= */

const params =
new URLSearchParams(
window.location.search
);


/*
 IMPORTANT:
 Accept both:

 service-order.html?serviceId=ABC

 and

 service-order.html?id=ABC

 */

const serviceId =
params.get("serviceId")
||
params.get("id");


/* =========================================
   ELEMENTS
========================================= */

const loading =
document.getElementById("loading");

const error =
document.getElementById("error");

const page =
document.getElementById("page");

const errorText =
document.getElementById("errorText");


/* =========================================
   LOAD SERVICE
========================================= */

async function loadService(){

if(!serviceId){

showError(
"Service ID is missing. Open this page using service-order.html?serviceId=YOUR_SERVICE_ID"
);

return;

}


try{

const serviceRef =
doc(
db,
"services",
serviceId
);


const snap =
await getDoc(
serviceRef
);


if(!snap.exists()){

showError(
"Service ID was received, but this service does not exist in Firestore."
);

return;

}


const service = {

serviceId:snap.id,

...snap.data()

};


renderService(service);


}catch(err){

console.error(
"Service loading error:",
err
);

showError(
err.message
);

}

}


/* =========================================
   RENDER
========================================= */

function renderService(service){

const image =

service.thumbnail

||

(
Array.isArray(service.gallery)
&&
service.gallery.length > 0

?

service.gallery[0]

:

""

)

||

"https://via.placeholder.com/900x600?text=LetsStudy+Pro";


document.getElementById(
"serviceImage"
).src = image;


document.getElementById(
"title"
).textContent =

service.title
||
"Untitled Service";


document.getElementById(
"category"
).textContent =

service.category
||
"Service";


document.getElementById(
"description"
).textContent =

service.description
||

service.shortDescription
||

"Professional service.";


document.getElementById(
"freelancerName"
).textContent =

service.freelancerName
||
"LetsStudy Pro";


document.getElementById(
"verified"
).innerHTML =

service.verified

?

'<i class="fa fa-circle-check"></i> Verified Freelancer'

:

"";


document.getElementById(
"currency"
).textContent =

service.currency
||
"TZS";


document.getElementById(
"price"
).textContent =

Number(
service.price || 0
).toLocaleString();


/* RATING */

const rating =
Number(
service.rating || 0
);

const ratingCount =
Number(
service.ratingCount || 0
);

const stars =
Math.max(
0,
Math.min(
5,
Math.round(rating)
)
);


document.getElementById(
"rating"
).innerHTML =

`${"★".repeat(stars)}
${"☆".repeat(5-stars)}
<span>
${rating.toFixed(1)}
(${ratingCount.toLocaleString()} reviews)
</span>`;


/* FREELANCER IMAGE */

if(service.freelancerImage){

document.getElementById(
"freelancerImage"
).src =
service.freelancerImage;

}


/* =========================================
   FORM
========================================= */

document.getElementById(
"orderForm"
).addEventListener(
"submit",
function(event){

event.preventDefault();


const order = {

serviceId:
service.serviceId,

serviceTitle:
service.title || "",

freelancerId:
service.freelancerId || "",

freelancerName:
service.freelancerName || "",

price:
Number(service.price || 0),

currency:
service.currency || "TZS",

name:
document.getElementById(
"name"
).value.trim(),

email:
document.getElementById(
"email"
).value.trim(),

requirements:
document.getElementById(
"requirements"
).value.trim(),

quantity:1,

addedAt:
Date.now()

};


/* =========================================
   SERVICE CART
========================================= */

let cart = [];

try{

cart =
JSON.parse(
localStorage.getItem(
"letsStudyServiceCart"
)
|| "[]"
);

}catch{

cart=[];

}


const existing =
cart.find(
item =>
item.serviceId ===
service.serviceId
);


if(existing){

existing.quantity =
Number(
existing.quantity || 1
) + 1;

existing.requirements =
order.requirements;

existing.name =
order.name;

existing.email =
order.email;

}else{

cart.push(order);

}


localStorage.setItem(
"letsStudyServiceCart",
JSON.stringify(cart)
);


/*
 GO TO SERVICE CART
*/

window.location.href =
"cart-service.html";

});

}


/* =========================================
   ERROR
========================================= */

function showError(message){

loading.style.display =
"none";

page.style.display =
"none";

error.style.display =
"block";

errorText.textContent =
message;

}


/* =========================================
   START
========================================= */

loadService();

</script></body>
