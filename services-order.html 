<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Order Service | LetsStudy Pro</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
*{box-sizing:border-box}

body{
 margin:0;
 background:#f6f8fb;
 color:#172033;
 font-family:Inter,Arial,sans-serif
}

a{
 text-decoration:none;
 color:inherit
}

.top{
 height:64px;
 background:#fff;
 border-bottom:1px solid #e5e7eb;
 display:flex;
 align-items:center;
 justify-content:space-between;
 padding:0 6%;
 position:sticky;
 top:0;
 z-index:20
}

.logo{
 color:#155eef;
 font-size:21px;
 font-weight:800
}

.nav{
 display:flex;
 gap:18px;
 font-size:13px;
 font-weight:700
}

.container{
 max-width:1100px;
 margin:30px auto;
 padding:0 20px
}

.back{
 display:inline-flex;
 align-items:center;
 gap:7px;
 color:#155eef;
 font-size:13px;
 font-weight:700;
 margin-bottom:20px
}

.layout{
 display:grid;
 grid-template-columns:1.4fr .8fr;
 gap:22px
}

.card{
 background:#fff;
 border:1px solid #e5e7eb;
 border-radius:15px;
 overflow:hidden
}

.image{
 height:260px;
 background:#eef2f6
}

.image img{
 width:100%;
 height:100%;
 object-fit:cover
}

.body{
 padding:22px
}

.category{
 color:#155eef;
 font-size:11px;
 font-weight:800;
 text-transform:uppercase
}

h1{
 font-size:27px;
 margin:8px 0
}

.description{
 color:#667085;
 line-height:1.7;
 font-size:14px
}

.freelancer{
 display:flex;
 align-items:center;
 gap:10px;
 margin:18px 0;
 padding-top:15px;
 border-top:1px solid #eee
}

.avatar{
 width:42px;
 height:42px;
 border-radius:50%;
 background:#eef2ff;
 display:flex;
 align-items:center;
 justify-content:center;
 color:#155eef;
 font-weight:800
}

.verified{
 color:#12b76a;
 font-size:12px
}

.rating{
 color:#f59e0b;
 font-size:13px;
 margin:12px 0
}

.rating span{
 color:#667085
}

.tags{
 display:flex;
 flex-wrap:wrap;
 gap:7px;
 margin:15px 0
}

.tag{
 background:#f2f4f7;
 padding:6px 9px;
 border-radius:20px;
 font-size:11px;
 color:#475467
}

.meta{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:10px;
 margin-top:18px
}

.meta-item{
 background:#f8fafc;
 border:1px solid #eef2f6;
 border-radius:9px;
 padding:11px;
 font-size:11px;
 color:#667085
}

.meta-item strong{
 display:block;
 color:#172033;
 margin-top:4px
}

.order{
 padding:22px
}

.order h2{
 margin:0 0 18px;
 font-size:21px
}

.price{
 font-size:27px;
 font-weight:900;
 margin-bottom:4px
}

.price small{
 font-size:11px;
 color:#667085;
 font-weight:500
}

.note{
 color:#667085;
 font-size:11px;
 margin-bottom:20px
}

label{
 display:block;
 font-size:12px;
 font-weight:700;
 margin:14px 0 6px
}

input,
textarea,
select{
 width:100%;
 border:1px solid #d9dee8;
 border-radius:9px;
 padding:12px;
 outline:none;
 font:inherit;
 background:#fff
}

textarea{
 min-height:120px;
 resize:vertical
}

input:focus,
textarea:focus,
select:focus{
 border-color:#155eef
}

.total{
 display:flex;
 justify-content:space-between;
 margin-top:20px;
 padding-top:15px;
 border-top:1px solid #eee;
 font-weight:800
}

.btn{
 width:100%;
 border:0;
 background:#155eef;
 color:#fff;
 padding:13px;
 border-radius:9px;
 cursor:pointer;
 font-weight:800;
 margin-top:18px
}

.btn:hover{
 background:#073bba
}

.loading,
.empty{
 text-align:center;
 padding:80px 20px;
 color:#667085
}

.error{
 color:#d92d20
}

@media(max-width:800px){

 .layout{
  grid-template-columns:1fr
 }

 .nav{
  display:none
 }

 .image{
  height:220px
 }

}
</style>
</head>

<body>

<header class="top">

<a href="index.html" class="logo">
LetsStudy Pro
</a>

<nav class="nav">

<a href="course.html">Courses</a>

<a href="marketplace.html">Marketplace</a>

<a href="service.html">Services</a>

<a href="careers.html">Careers</a>

</nav>

</header>


<main class="container">

<a
href="service.html"
class="back">

<i class="fa fa-arrow-left"></i>

Back to Services

</a>


<div id="loading" class="loading">

<i class="fa fa-spinner fa-spin fa-2x"></i>

