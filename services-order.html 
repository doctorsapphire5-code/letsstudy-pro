</div>


<div
id="content"
style="display:none">

<div class="layout">


<!-- SERVICE -->

<section class="card">

<div class="image">

<img
id="serviceImage"
src=""
alt="Service">

</div>


<div class="body">

<div
id="serviceCategory"
class="category">
</div>


<h1 id="serviceTitle">
</h1>


<div
id="serviceDescription"
class="description">
</div>


<div class="freelancer">

<div
id="avatar"
class="avatar">
F
</div>

<div>

<strong id="freelancerName">
Freelancer
</strong>

<div
id="verified"
class="verified">
</div>

</div>

</div>


<div class="rating">

