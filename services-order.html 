}

.image{
width:100%;
height:300px;
}

.image img{
width:100%;
height:100%;
object-fit:cover;
}

.body{
padding:25px;
}

.badge{
display:inline-block;
background:#eff6ff;
color:#2563eb;
padding:7px 11px;
border-radius:20px;
font-size:12px;
