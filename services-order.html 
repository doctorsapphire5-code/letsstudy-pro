</main>



<script type="module">

import {
initializeApp
}
from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

import {
getFirestore,
doc,
getDoc
}
from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";


/* ================= FIREBASE ================= */

const firebaseConfig = {

apiKey:
"AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

authDomain:
"let-s-study-pro-course.firebaseapp.com",

projectId:
"let-s-study-pro-course",

storageBucket:
"let-s-study-pro-course.firebasestorage.app",

messagingSenderId:
"474928293390",

appId:
"1:474928293390:web:2bcc2aebf2351c12a9fe5f"

};

const app =
initializeApp(firebaseConfig);

const db =
getFirestore(app);


/* ================= SERVICE ID ================= */

const params =
new URLSearchParams(
location.search
);

const serviceId =
params.get("serviceId");


/*
Firestore:

services
└── {serviceId}

serviceId = document.id
*/


if(!serviceId){

showError(
"Service ID is missing. Open this page using service-order.html?serviceId=YOUR_SERVICE_ID"
);

}else{

loadService();

}


/* ================= DATA ================= */

let service = null;


/* ================= LOAD SERVICE ================= */

async function loadService(){

try{

const ref =
doc(
db,
"services",
serviceId
);

const snap =
await getDoc(ref);


if(!snap.exists()){

showError(
"Service was not found in Firebase."
);

return;

}


const d =
snap.data();


service = {

serviceId:snap.id,

freelancerId:d.freelancerId || "",

userId:d.userId || "",

freelancerName:
d.freelancerName || "",

title:
d.title || "",

slug:
d.slug || "",

description:
d.description || "",

shortDescription:
d.shortDescription || "",

category:
d.category || "",

subcategory:
d.subcategory || "",

skills:
Array.isArray(d.skills)
?d.skills
:[],

thumbnail:
d.thumbnail || "",

gallery:
Array.isArray(d.gallery)
?d.gallery
:[],

video:
d.video || "",

pricingType:
d.pricingType || "",

price:
Number(d.price || 0),

currency:
d.currency || "TZS",

deliveryTime:
d.deliveryTime || "",

revisions:
d.revisions || "",

packages:
Array.isArray(d.packages)
?d.packages
:[],

requirements:
Array.isArray(d.requirements)
?d.requirements
:[],

tags:
Array.isArray(d.tags)
?d.tags
:[],

ordersCount:
Number(d.ordersCount || 0),

views:
Number(d.views || 0),

likes:
Number(d.likes || 0),

rating:
Number(d.rating || 0),

ratingCount:
Number(d.ratingCount || 0),

featured:
d.featured === true,

verified:
d.verified === true,

status:
d.status || ""

};


renderService();


}catch(error){

console.error(error);

showError(error.message);

}

}


/* ================= RENDER ================= */

function renderService(){

document.getElementById("title")
.textContent =
service.title || "Untitled Service";


document.getElementById("description")
.textContent =
service.description ||
service.shortDescription ||
"";


document.getElementById("category")
.textContent =
service.category ||
"Service";


document.getElementById("freelancer")
.textContent =
service.freelancerName ||
"LetsStudy Pro";


document.getElementById("rating")
.textContent =
service.rating.toFixed(1) +
" (" +
service.ratingCount +
")";


document.getElementById("orders")
.textContent =
service.ordersCount;


document.getElementById("views")
.textContent =
service.views;


document.getElementById("delivery")
.textContent =
service.deliveryTime || "-";


document.getElementById("revisions")
.textContent =
service.revisions || "-";


document.getElementById("pricingType")
.textContent =
service.pricingType || "-";


document.getElementById("verified").innerHTML =
service.verified
? '<i class="fa fa-circle-check"></i> Verified Freelancer'
: "";


/* IMAGE */

document.getElementById("serviceImage")
.src =
service.thumbnail ||
"https://via.placeholder.com/900x500?text=LetsStudy+Pro";


/* PRICE */

document.getElementById("pricing")
.textContent =
formatMoney(
service.price,
service.currency
);


/* SUMMARY */

document.getElementById("summaryTitle")
.textContent =
service.title;


document.getElementById("summaryFreelancer")
.textContent =
service.freelancerName ||
"LetsStudy Pro";


document.getElementById("summaryDelivery")
.textContent =
service.deliveryTime || "-";


document.getElementById("summaryPrice")
.textContent =
formatMoney(
service.price,
service.currency
);


/* SKILLS */

const skills =
document.getElementById("skills");


if(service.skills.length){

skills.innerHTML =
service.skills.map(skill => `

<div style="
display:inline-block;
background:#f1f5f9;
padding:8px 12px;
border-radius:20px;
margin:4px;
font-size:13px;
">

<i class="fa fa-check"></i>

${esc(skill)}

</div>

`).join("");

}else{

document.getElementById("skillsSection")
.style.display="none";

}


/* REQUIREMENTS */

const requirements =
document.getElementById("requirements");


if(service.requirements.length){

requirements.innerHTML =
service.requirements.map(item => `

<div>
<i class="fa fa-circle-check"></i>
${esc(item)}
</div>

`).join("");

}else{

document.getElementById("requirementsSection")
.style.display="none";

}


/* TAGS */

const tags =
document.getElementById("tags");


if(service.tags.length){

tags.innerHTML =
service.tags.map(tag => `

<span style="
display:inline-block;
background:#eff6ff;
color:#2563eb;
padding:7px 10px;
border-radius:20px;
margin:4px;
font-size:12px;
">

#${esc(tag)}

</span>

`).join("");

}else{

document.getElementById("tagsSection")
.style.display="none";

}


/* PACKAGES */

loadPackages();


/* SHOW */

document.getElementById("loading")
.style.display="none";

document.getElementById("content")
.style.display="block";

}


/* ================= PACKAGES ================= */

function loadPackages(){

const select =
document.getElementById("package");


if(!service.packages.length)
return;


select.innerHTML = `

<option value="">
Select Package
</option>

`;


service.packages.forEach(
(packageItem,index)=>{

let name =
"Package " + (index + 1);

let price =
service.price;


if(typeof packageItem === "object"){

name =
packageItem.name ||
packageItem.title ||
name;

price =
Number(
packageItem.price ??
service.price
);

}else{

name =
String(packageItem);

}


const option =
document.createElement("option");


option.value =
index;


option.textContent =
name +
" — " +
formatMoney(
price,
service.currency
);


option.dataset.price =
price;


select.appendChild(option);

});

}


/* ================= PACKAGE CHANGE ================= */

document.getElementById("package")
.addEventListener(
"change",
function(){

const option =
this.options[this.selectedIndex];


if(option.dataset.price){

const price =
Number(option.dataset.price);


document.getElementById("summaryPrice")
.textContent =
formatMoney(
price,
service.currency
);

}

});


/* ================= SUBMIT ORDER ================= */

document.getElementById("orderForm")
.addEventListener(
"submit",
function(e){

e.preventDefault();


if(!service)
return;


const name =
document.getElementById("customerName")
.value.trim();


const email =
document.getElementById("customerEmail")
.value.trim();


const details =
document.getElementById("projectDetails")
.value.trim();


if(!name || !email || !details){

alert(
"Please complete all required fields."
);

return;

}


const packageSelect =
document.getElementById("package");


const selected =
packageSelect.options[
packageSelect.selectedIndex
];


const selectedPackage =
selected &&
selected.value
?selected.textContent
:"Default Service";


const selectedPrice =
selected &&
selected.dataset.price
?Number(selected.dataset.price)
:service.price;


const order = {

serviceId:

service.serviceId,

freelancerId:

service.freelancerId,

userId:

service.userId,

freelancerName:

service.freelancerName,

title:

service.title,

thumbnail:

service.thumbnail,

pricingType:

service.pricingType,

price:

selectedPrice,

currency:

service.currency,

deliveryTime:

service.deliveryTime,

revisions:

service.revisions,

package:

selectedPackage,

requirements:

service.requirements,

customerName:

name,

customerEmail:

email,

projectDetails:

details,

deadline:

document.getElementById("deadline")
.value,

reference:

document.getElementById("reference")
.value.trim(),

createdAt:

new Date().toISOString()

};


/*
SAVE SERVICE ORDER
*/

let orders = [];

try{

orders =
JSON.parse(
localStorage.getItem("serviceOrders")
|| "[]"
);

if(!Array.isArray(orders))
orders=[];

}catch{

orders=[];

}


orders.push(order);


localStorage.setItem(
"serviceOrders",
JSON.stringify(orders)
);


/*
ALSO KEEP CURRENT ORDER
*/

localStorage.setItem(
"currentServiceOrder",
JSON.stringify(order)
);


/* SUCCESS */

document.getElementById("content")
.style.display="none";

document.getElementById("success")
.style.display="block";

window.scrollTo({
top:0,
behavior:"smooth"
});

});


/* ================= ERROR ================= */

function showError(message){

document.getElementById("loading")
.style.display="none";

document.getElementById("content")
.style.display="none";

document.getElementById("error")
.style.display="block";

document.getElementById("errorText")
.textContent =
message;

}


/* ================= MONEY ================= */

function formatMoney(price,currency){

return (

currency ||
"TZS"

) +
" " +
Number(price || 0)
.toLocaleString();

}


/* ================= ESCAPE ================= */

function esc(value){

return String(value ?? "")

.replace(/&/g,"&amp;")

.replace(/</g,"&lt;")

.replace(/>/g,"&gt;")

.replace(/"/g,"&quot;")

.replace(/'/g,"&#039;");

}

</script>

</body>
</html>