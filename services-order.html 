}

.verified{
color:#16a34a;
font-size:13px;
font-weight:bold;
margin-left:8px;
}

h1{
font-size:32px;
margin:15px 0 10px;
}

h2{
margin-top:0;
}

.desc{
color:#64748b;
line-height:1.7;
}

.meta{
display:flex;
flex-wrap:wrap;
gap:15px;
padding:18px 0;
border-top:1px solid #eee;
border-bottom:1px solid #eee;
margin:20px 0;
color:#64748b;
font-size:13px;
}

.meta i{
color:#2563eb;
margin-right:5px;
}

.price{
font-size:28px;
font-weight:900;
margin:15px 0;
}

.form-card{
padding:25px;
}

label{
display:block;
font-weight:bold;
font-size:14px;
margin:17px 0 7px;
}

input,
textarea,
select{
width:100%;
padding:13px 14px;
border:1px solid #dbe1e8;
border-radius:10px;
outline:none;
font-size:14px;
background:white;
}

textarea{
min-height:130px;
resize:vertical;
}

input:focus,
textarea:focus,
select:focus{
border-color:#2563eb;
}

.requirements{
background:#f8fafc;
border-radius:12px;
padding:15px;
margin-top:20px;
}

.requirements div{
margin:9px 0;
color:#475569;
font-size:14px;
}

.requirements i{
color:#16a34a;
margin-right:7px;
}

.summary{
background:#f8fafc;
border-radius:12px;
padding:18px;
margin-top:20px;
}

.row{
display:flex;
justify-content:space-between;
gap:15px;
margin:10px 0;
font-size:14px;
}

.total{
border-top:1px solid #ddd;
padding-top:15px;
margin-top:15px;
font-size:20px;
font-weight:900;
}

button{
width:100%;
border:0;
padding:14px;
border-radius:10px;
background:#172033;
color:white;
font-weight:bold;
cursor:pointer;
font-size:15px;
margin-top:20px;
}

button:hover{
background:#2563eb;
}

button:disabled{
opacity:.6;
cursor:not-allowed;
}

.back{
display:inline-block;
margin-bottom:20px;
color:#2563eb;
text-decoration:none;
font-weight:bold;
}

.success{
display:none;
text-align:center;
padding:60px 20px;
}

.success i{
font-size:55px;
color:#16a34a;
}

.success h2{
margin:15px 0;
}

@media(max-width:800px){
.grid{
grid-template-columns:1fr;
}

.image{
height:240px;
}

h1{
font-size:26px;
}
}
</style>
</head>

<body>

<header>
<div class="nav">

<a href="index.html" class="logo">
LetsStudy <span>Pro</span>
</a>

<a href="services.html">
<i class="fa fa-arrow-left"></i>
 Services
