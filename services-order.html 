<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>Order Service | LetsStudy Pro</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
*{box-sizing:border-box}

body{
margin:0;
font-family:Arial,sans-serif;
background:#f5f7fb;
color:#172033;
}

header{
background:#07111f;
color:white;
padding:15px 5%;
position:sticky;
top:0;
z-index:10;
}

.nav{
max-width:1100px;
margin:auto;
display:flex;
align-items:center;
justify-content:space-between;
gap:20px;
}

.logo{
color:white;
text-decoration:none;
font-size:22px;
font-weight:900;
}

.logo span{
color:#22d3ee;
}

.nav a{
color:white;
text-decoration:none;
}

.wrap{
max-width:1100px;
margin:auto;
padding:35px 5%;
}

.loading{
text-align:center;
padding:100px 20px;
}

.error{
display:none;
text-align:center;
padding:80px 20px;
}

.grid{
display:grid;
grid-template-columns:1.5fr 1fr;
gap:25px;
}

.card{
background:white;
border:1px solid #e5e7eb;
border-radius:18px;
overflow:hidden;
