</div>

</div>


<div
id="error"
class="empty"
style="display:none">

<i class="fa fa-circle-exclamation fa-2x"></i>

<h2>Service not found</h2>

<p id="errorText">
Service ID is missing.
</p>

<a
href="service.html"
class="back">

Browse Services

</a>

</div>

</main>


<script type="module">

import {
 initializeApp
}
from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

import {
 getFirestore,
 doc,
 getDoc
}
from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";


/* =========================
 FIREBASE
========================= */

const firebaseConfig={

 apiKey:
 "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

 authDomain:
 "let-s-study-pro-course.firebaseapp.com",

 databaseURL:
 "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

 projectId:
 "let-s-study-pro-course",

 storageBucket:
 "let-s-study-pro-course.firebasestorage.app",

 messagingSenderId:
 "474928293390",

 appId:
 "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

 measurementId:
 "G-85B7V5H5J0"

};

const app=
initializeApp(firebaseConfig);

const db=
getFirestore(app);


/* =========================
 DOM
========================= */

const loading=
document.getElementById("loading");

const content=
document.getElementById("content");

const errorBox=
document.getElementById("error");

const errorText=
document.getElementById("errorText");


/* =========================
 ESCAPE
========================= */

function esc(value=""){

 return String(value)

 .replace(/&/g,"&amp;")
 .replace(/</g,"&lt;")
 .replace(/>/g,"&gt;")
 .replace(/"/g,"&quot;")
 .replace(/'/g,"&#039;");

}


/* =========================
 SERVICE ID
========================= */

const params=
new URLSearchParams(
window.location.search
);


/*
 Supports:

 services-order.html?id=SERVICE_ID

 and

 services-order.html?serviceId=SERVICE_ID
*/

const serviceId=
params.get("serviceId")
||
params.get("id");


/* =========================
 SERVICE
========================= */

let service=null;


/* =========================
 LOAD SERVICE
========================= */

async function loadService(){

 if(!serviceId){

  showError(
   "Service ID is missing. Open this page using services-order.html?id=YOUR_SERVICE_ID"
  );

  return;

 }


 try{

  const ref=
  doc(
   db,
   "services",
   serviceId
  );


  const snap=
  await getDoc(ref);


  if(!snap.exists()){

   showError(
    "The requested service does not exist."
   );

   return;

  }


  service={
   id:snap.id,
   ...snap.data()
  };


  renderService();


 }catch(error){

  console.error(error);

  showError(
   error.message ||
   "Unable to load service."
  );

 }

}


/* =========================
 RENDER SERVICE
========================= */

function renderService(){

 const s=service;


 document.title=
 `${s.title||"Service"} | LetsStudy Pro`;


 document.getElementById(
  "serviceImage"
 ).src=

 s.thumbnail ||

 "https://via.placeholder.com/700x400?text=Service";


 document.getElementById(
  "serviceImage"
 ).alt=
 s.title||"Service";


 document.getElementById(
  "serviceCategory"
 ).textContent=

 s.category||
 "Professional Service";


 document.getElementById(
  "serviceTitle"
 ).textContent=

 s.title||
 "Untitled Service";


 document.getElementById(
  "serviceDescription"
 ).textContent=

 s.description||
 s.shortDescription||
 "Professional service.";


 const name=
 s.freelancerName||
 "Freelancer";


 document.getElementById(
  "freelancerName"
 ).textContent=
 name;


 document.getElementById(
  "avatar"
 ).textContent=

 name
 .trim()
 .charAt(0)
 .toUpperCase();


 document.getElementById(
  "verified"
 ).innerHTML=

 s.verified

 ?

 `<i class="fa fa-circle-check"></i>
  Verified Freelancer`

 :

 "";


 document.getElementById(
  "rating"
 ).textContent=

 Number(
  s.rating||0
 ).toFixed(1);


 document.getElementById(
  "ratingCount"
 ).textContent=

 Number(
  s.ratingCount||0
 );


 document.getElementById(
  "delivery"
 ).textContent=

 s.deliveryTime||
 "Flexible";


 document.getElementById(
  "revisions"
 ).textContent=

 Number(
  s.revisions||0
 );


 document.getElementById(
  "orders"
 ).textContent=

 Number(
  s.ordersCount||0
 );


 document.getElementById(
  "views"
 ).textContent=

 Number(
  s.views||0
 );


 const currency=
 s.currency||
 "TZS";


 const price=
 Number(
  s.price||0
 );


 document.getElementById(
  "currency"
 ).textContent=
 currency;


 document.getElementById(
  "totalCurrency"
 ).textContent=
 currency;


 document.getElementById(
  "price"
 ).textContent=

 price.toLocaleString();


 document.getElementById(
  "total"
 ).textContent=

 price.toLocaleString();


 document.getElementById(
  "pricingType"
 ).textContent=

 s.pricingType
 ? " / "+s.pricingType
 : "";


 /* TAGS */

 const skills=
 Array.isArray(s.skills)
 ? s.skills
 : typeof s.skills==="string"
 ? s.skills.split(",")
 : [];


 const tags=
 Array.isArray(s.tags)
 ? s.tags
 : typeof s.tags==="string"
 ? s.tags.split(",")
 : [];


 const allTags=
 [
  ...skills,
  ...tags
 ]
 .map(x=>String(x).trim())
 .filter(Boolean)
 .slice(0,10);


 document.getElementById(
  "tags"
 ).innerHTML=

 allTags.map(
  tag=>
  `<span class="tag">
   ${esc(tag)}
   </span>`
 ).join("");


 /* PRICE UPDATE */

 document.getElementById(
  "quantity"
 ).addEventListener(
  "input",
  updateTotal
 );


 loading.style.display="none";

 content.style.display="block";

}


/* =========================
 TOTAL
========================= */

function updateTotal(){

 if(!service)return;


 const quantity=
 Math.max(
  1,
  Number(
   document.getElementById(
    "quantity"
   ).value||1
  )
 );


 const price=
 Number(
  service.price||0
 );


 document.getElementById(
  "total"
 ).textContent=

 (price*quantity)
 .toLocaleString();

}


/* =========================
 CHECKOUT
========================= */

document
.getElementById("orderForm")
.addEventListener(
 "submit",
 function(e){

  e.preventDefault();


  if(!service)return;


  const quantity=
  Math.max(
   1,
   Number(
    document.getElementById(
     "quantity"
    ).value||1
   )
  );


  const order={

   serviceId:
   service.id,

   serviceTitle:
   service.title||"",

   freelancerId:
   service.freelancerId||"",

   userId:
   service.userId||"",

   freelancerName:
   service.freelancerName||
   "Freelancer",

   thumbnail:
   service.thumbnail||"",

   price:
   Number(service.price||0),

   currency:
   service.currency||"TZS",

   pricingType:
   service.pricingType||"fixed",

   quantity:
   quantity,

   total:
   Number(service.price||0)*
   quantity,

   customerName:
   document.getElementById(
    "customerName"
   ).value.trim(),

   customerEmail:
   document.getElementById(
    "customerEmail"
   ).value.trim(),

   customerPhone:
   document.getElementById(
    "customerPhone"
   ).value.trim(),

   requirements:
   document.getElementById(
    "requirements"
   ).value.trim(),

   deliveryTime:
   service.deliveryTime||
   "",

   revisions:
   Number(
    service.revisions||0
   ),

   createdAt:
   Date.now()

  };


  /*
   Save service order
   information for checkout.
  */

  localStorage.setItem(
   "letsStudyServiceCheckout",
   JSON.stringify(order)
  );


  /*
   Go to cart.
  */

  window.location.href=
   "cart-service.html";

 }
);


/* =========================
 ERROR
========================= */

function showError(message){

 loading.style.display="none";

 content.style.display="none";

 errorBox.style.display="block";

 errorText.textContent=
 message;

}


/* =========================
 START
========================= */

loadService();

</script>

</body>
</html>