<style>

:root{
  --primary:#2563eb;
  --primary-dark:#1d4ed8;
  --text:#172033;
  --muted:#64748b;
  --bg:#f8fafc;
  --white:#fff;
  --border:#e2e8f0;
  --soft:#eff6ff;
  --green:#16a34a;
  --orange:#d97706;
  --red:#dc2626;
  --radius:20px;
  --shadow:0 15px 40px rgba(15,23,42,.08);
}

*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.6;
}

button,
input{
  font:inherit;
}

button{
  cursor:pointer;
}

.container{
  width:min(1160px,92%);
  margin:auto;
}

/* HEADER */

header{
  background:rgba(255,255,255,.97);
  border-bottom:1px solid var(--border);
  position:sticky;
  top:0;
  z-index:20;
  backdrop-filter:blur(12px);
}

.header{
  min-height:70px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.brand{
  display:flex;
  align-items:center;
  gap:11px;
  font-weight:900;
  font-size:18px;
}

.logo{
  width:43px;
  height:43px;
  display:grid;
  place-items:center;
  border-radius:13px;
  background:var(--primary);
  color:#fff;
  font-weight:900;
}

.badge{
  padding:8px 13px;
  border-radius:999px;
  background:var(--soft);
  color:var(--primary);
  font-size:11px;
  font-weight:900;
}

/* HERO */

.hero{
  padding:70px 0 55px;
  background:
    radial-gradient(
      circle at top left,
      #dbeafe,
      transparent 40%
    ),
    linear-gradient(
      135deg,
      #eff6ff,
      #fff
    );
}

.hero-content{
  max-width:850px;
  text-align:center;
  margin:auto;
}

.eyebrow{
  display:inline-flex;
  padding:8px 15px;
  border-radius:999px;
  background:#dbeafe;
  color:#1d4ed8;
  font-size:11px;
  font-weight:900;
  text-transform:uppercase;
}

h1{
  margin:18px 0;
  font-size:clamp(40px,7vw,65px);
  line-height:1.04;
  letter-spacing:-2.5px;
}

.hero p{
  margin:auto;
  max-width:730px;
  color:var(--muted);
  font-size:18px;
}

/* MAIN */

main{
  padding:50px 0 80px;
}

/* CARD */

.panel{
  background:#fff;
  border:1px solid var(--border);
  border-radius:24px;
  padding:28px;
  box-shadow:var(--shadow);
  margin-bottom:25px;
}

.panel-title{
  margin-bottom:22px;
}

.panel-title h2{
  margin:0 0 5px;
  font-size:26px;
}

.panel-title p{
  margin:0;
  color:var(--muted);
  font-size:14px;
}

/* SEARCH */

.search-box{
  position:relative;
}

.search{
  width:100%;
  padding:16px 18px;
  border:1px solid var(--border);
  border-radius:14px;
  outline:none;
  background:#fff;
}

.search:focus{
  border-color:var(--primary);
  box-shadow:0 0 0 3px #dbeafe;
}

/* SKILLS */

.skill-selection{
  display:flex;
  flex-wrap:wrap;
  gap:9px;
  margin-top:20px;
}

.skill-button{
  border:1px solid var(--border);
  background:#fff;
  color:var(--text);
  padding:10px 14px;
  border-radius:999px;
  font-size:13px;
  font-weight:800;
  transition:.18s ease;
}

.skill-button:hover{
  border-color:var(--primary);
  color:var(--primary);
}

.skill-button.selected{
  background:var(--primary);
  color:#fff;
  border-color:var(--primary);
}

.selection-info{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  margin-top:20px;
  padding-top:18px;
  border-top:1px solid var(--border);
}

.selection-count{
  color:var(--muted);
  font-size:14px;
}

.clear{
  border:0;
  background:#fee2e2;
  color:#b91c1c;
  padding:8px 13px;
  border-radius:9px;
  font-size:12px;
  font-weight:900;
}

/* RESULTS */

.results{
  display:grid;
  grid-template-columns:
    1fr 1fr;
  gap:22px;
}

.result-card{
  background:#fff;
  border:1px solid var(--border);
  border-radius:22px;
  padding:25px;
  box-shadow:var(--shadow);
}

.result-card h2{
  margin:0 0 7px;
  font-size:24px;
}

.result-card > p{
  color:var(--muted);
  font-size:14px;
  margin:0 0 20px;
}

/* SCORE */

.score-wrap{
  display:flex;
  align-items:center;
  gap:20px;
  margin-bottom:20px;
}

.score-circle{
  width:100px;
  height:100px;
  flex:0 0 100px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:
    conic-gradient(
      var(--primary)
      var(--score),
      #e2e8f0 0
    );
  position:relative;
}

.score-circle::after{
  content:"";
  position:absolute;
  width:76px;
  height:76px;
  border-radius:50%;
  background:#fff;
}

.score-number{
  position:relative;
  z-index:1;
  font-size:22px;
  font-weight:900;
}

.score-text strong{
  display:block;
  font-size:17px;
}

.score-text span{
  color:var(--muted);
  font-size:13px;
}

/* CAREERS */

.career-list{
  display:grid;
  gap:13px;
}

.career{
  padding:17px;
  border:1px solid var(--border);
  border-radius:15px;
}

.career-top{
  display:flex;
  justify-content:space-between;
  gap:12px;
  align-items:center;
}

.career-name{
  font-weight:900;
}

.career-score{
  color:var(--primary);
  font-weight:900;
}

.progress{
  height:8px;
  margin-top:10px;
  background:#e2e8f0;
  border-radius:999px;
  overflow:hidden;
}

.progress-bar{
  height:100%;
  width:0;
  background:var(--primary);
  border-radius:999px;
  transition:width .5s ease;
}

/* GAPS */

.gap-list{
  display:grid;
  gap:11px;
}

.gap{
  display:flex;
  align-items:center;
  gap:12px;
  padding:14px;
  border-radius:13px;
  background:#fff7ed;
  border:1px solid #fed7aa;
}

.gap-icon{
  width:35px;
  height:35px;
  display:grid;
  place-items:center;
  background:#ffedd5;
  border-radius:9px;
}

.gap strong{
  font-size:14px;
}

.gap span{
  display:block;
  color:var(--muted);
  font-size:12px;
}

/* STRENGTHS */

.strength-list{
  display:flex;
  flex-wrap:wrap;
  gap:9px;
}

.strength{
  padding:9px 13px;
  border-radius:999px;
  background:#dcfce7;
  color:#15803d;
  font-size:12px;
  font-weight:900;
}

/* EMPTY */

.empty{
  text-align:center;
  padding:30px;
  color:var(--muted);
}

.empty-icon{
  font-size:48px;
  margin-bottom:10px;
}

/* CTA */

.cta{
  margin-top:25px;
  padding:55px 25px;
  text-align:center;
  color:#fff;
  border-radius:25px;
  background:
    linear-gradient(
      135deg,
      #1d4ed8,
      #2563eb
    );
}

.cta h2{
  margin:0 0 10px;
  font-size:clamp(28px,5vw,42px);
}

.cta p{
  max-width:680px;
  margin:auto;
  opacity:.94;
}

/* FOOTER */

footer{
  background:#0f172a;
  color:#fff;
  padding:45px 0;
}

.footer{
  text-align:center;
}

.footer p{
  max-width:650px;
  margin:10px auto;
  color:#94a3b8;
  font-size:14px;
}

.copyright{
  margin-top:25px;
  padding-top:20px;
  border-top:1px solid #1e293b;
  color:#94a3b8;
  font-size:13px;
