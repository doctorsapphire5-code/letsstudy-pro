  </div></footer><script type="module">


  /* ======================================
     FIREBASE
  ====================================== */

  import {
    initializeApp
  }
  from
  "https://www.gstatic.com/firebasejs/10.14.1/firebase-app.js";


  import {
    getDatabase,
    ref,
    get
  }
  from
  "https://www.gstatic.com/firebasejs/10.14.1/firebase-database.js";


  const firebaseConfig = {

    apiKey:
      "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",

    authDomain:
      "let-s-study-pro-course.firebaseapp.com",

    databaseURL:
      "https://let-s-study-pro-course-default-rtdb.firebaseio.com",

    projectId:
      "let-s-study-pro-course",

    storageBucket:
      "let-s-study-pro-course.firebasestorage.app",

    messagingSenderId:
      "474928293390",

    appId:
      "1:474928293390:web:2bcc2aebf2351c12a9fe5f",

    measurementId:
      "G-85B7V5H5J0"

  };


  const app =
    initializeApp(
      firebaseConfig
    );


  const db =
    getDatabase(app);


  /* ======================================
     ELEMENTS
  ====================================== */

  const skillInput =
    document.getElementById(
      "skillInput"
    );

  const addSkillBtn =
    document.getElementById(
      "addSkillBtn"
    );

  const selectedSkillsEl =
    document.getElementById(
      "selectedSkills"
    );

  const categoryFilter =
    document.getElementById(
      "categoryFilter"
    );

  const locationFilter =
    document.getElementById(
      "locationFilter"
    );

  const matchBtn =
    document.getElementById(
      "matchBtn"
    );

  const clearBtn =
    document.getElementById(
      "clearBtn"
    );

  const jobGrid =
    document.getElementById(
      "jobGrid"
    );

  const resultsCount =
    document.getElementById(
      "resultsCount"
    );


  let jobs = [];

  let selectedSkills = [];


  /* ======================================
     HELPERS
  ====================================== */

  function normalize(value){

    return String(
      value ?? ""
    )
      .toLowerCase()
      .trim();

  }


  function escapeHTML(value){

    return String(
      value ?? ""
    )

    .replace(
      /&/g,
      "&amp;"
    )

    .replace(
      /</g,
      "&lt;"
    )

    .replace(
      />/g,
      "&gt;"
    )

    .replace(
      /"/g,
      "&quot;"
    )

    .replace(
      /'/g,
      "&#039;"
    );

  }


  function getJobSkills(job){

    if(
      Array.isArray(
        job.skills
      )
    ){

      return job.skills
        .map(
          skill =>
            String(skill)
        )
        .filter(Boolean);

    }


    if(
      typeof job.skills ===
      "string"
    ){

      return job.skills
        .split(",")
        .map(
          skill =>
            skill.trim()
        )
        .filter(Boolean);

    }


    if(
      Array.isArray(
        job.requirements
      )
    ){

      return job.requirements
        .map(
          skill =>
            String(skill)
        )
        .filter(Boolean);

    }


    return [];

  }


  function getMatchData(job){

    const jobSkills =
      getJobSkills(
        job
      );


    const normalizedJobSkills =
      jobSkills.map(
        skill =>
          normalize(skill)
      );


    const matchedSkills =
      selectedSkills.filter(
        skill => {

          const normalized =
            normalize(
              skill
            );


          return normalizedJobSkills.some(
            jobSkill => {

              return (
                jobSkill === normalized ||
                jobSkill.includes(normalized) ||
                normalized.includes(jobSkill)
              );

            }
          );

        }
      );


    const total =
      selectedSkills.length;


    const score =
      total === 0
        ? 0
        : Math.round(
            (
              matchedSkills.length /
              total
            ) * 100
          );


    return {
      jobSkills,
      matchedSkills,
      score
    };

  }


  /* ======================================
     SKILLS UI
  ====================================== */

  function renderSelectedSkills(){

    if(
      selectedSkills.length === 0
    ){

      selectedSkillsEl.innerHTML = "";

      return;

    }


    selectedSkillsEl.innerHTML =
      selectedSkills.map(
        skill => `

          <span class="skill-chip">

            ${escapeHTML(
              skill
            )}

            <button
              class="remove-skill"
              type="button"
              data-skill="${escapeHTML(
                skill
              )}"
              aria-label="Remove skill"
            >

              <i class="
                fa-solid
                fa-xmark
              "></i>

            </button>

          </span>

        `
      ).join("");


    document
      .querySelectorAll(
        ".remove-skill"
      )
      .forEach(
        button => {

          button.addEventListener(
            "click",
            function(){

              const skill =
                this.dataset.skill;


              selectedSkills =
                selectedSkills.filter(
                  item =>
                    normalize(item) !==
                    normalize(skill)
                );


              renderSelectedSkills();

              renderJobs();

            }
          );

        }
      );

  }


  function addSkill(value){

    const skill =
      String(
        value ?? ""
      ).trim();


    if(
      !skill
    ){

      return;

    }


    const exists =
      selectedSkills.some(
        item =>
          normalize(item) ===
          normalize(skill)
      );


    if(
      !exists
    ){

      selectedSkills.push(
        skill
      );

    }


    skillInput.value =
      "";


    renderSelectedSkills();

    renderJobs();

  }


  addSkillBtn.addEventListener(
    "click",
    function(){

      addSkill(
        skillInput.value
      );

    }
  );


  skillInput.addEventListener(
    "keydown",
    function(event){

      if(
        event.key ===
        "Enter"
      ){

        event.preventDefault();

        addSkill(
          skillInput.value
        );

      }

    }
  );


  addSkillBtn.addEventListener(
    "click",
    function(){

      addSkill(
        skillInput.value
      );

    }
  );


  document
    .querySelectorAll(
      ".suggestion"
    )
    .forEach(
      button => {

        button.addEventListener(
          "click",
          function(){

            addSkill(
              this.dataset.skill
            );

          }
        );

      }
    );


  renderSelectedSkills();

  loadJobs();

</script>

