const strengthList =
  document.getElementById(
    "strengthList"
  );


let selectedSkills =
  new Set();


/* =========================
   ESCAPE HTML
========================= */

function escapeHTML(value){

  return String(value)
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");

}


/* =========================
   RENDER SKILLS
========================= */

function renderSkills(){

  const query =
    skillSearch.value
      .trim()
      .toLowerCase();


  const filteredSkills =
    skills.filter(
      skill => {

        const name =
          skill.name
            .toLowerCase();

        const category =
          skill.category
            .toLowerCase();

        return (
          name.includes(query)
          ||
          category.includes(query)
        );

      }
    );


  skillSelection.innerHTML =
    "";


  if(
    filteredSkills.length === 0
  ){

    skillSelection.innerHTML = `
      <div class="empty">
        <div class="empty-icon">
          🔎
        </div>

        <strong>
          No skills found
        </strong>

        <p>
          Try another skill or category.
        </p>
      </div>
    `;

    updateSelectionCount();

    return;

  }


  filteredSkills.forEach(
    skill => {

      const button =
        document.createElement(
          "button"
        );


      button.type =
        "button";


      button.className =
        "skill-button";


      if(
        selectedSkills.has(
          skill.name
        )
      ){

        button.classList.add(
          "selected"
        );

      }


      button.textContent =
        skill.name;


      button.setAttribute(
        "aria-pressed",
        selectedSkills.has(
          skill.name
        )
          ? "true"
          : "false"
      );


      button.addEventListener(
        "click",
        () => {

          toggleSkill(
            skill.name
          );

        }
      );


      skillSelection.appendChild(
        button
      );

    }
  );


  updateSelectionCount();

}


/* =========================
   TOGGLE SKILL
========================= */

function toggleSkill(
  skillName
){

  if(
    selectedSkills.has(
      skillName
    )
  ){

    selectedSkills.delete(
      skillName
    );

  }else{

    selectedSkills.add(
      skillName
    );

  }


  renderSkills();

  calculateMatches();

}


/* =========================
   SELECTION COUNT
========================= */

function updateSelectionCount(){

  const count =
    selectedSkills.size;


  selectionCount.textContent =
    `${count} ${
      count === 1
        ? "skill"
        : "skills"
    } selected`;

}


/* =========================
   CALCULATE MATCHES
========================= */

function calculateMatches(){

  if(
    selectedSkills.size === 0
  ){

    resetResults();

    return;

  }


  const results =
    careers
      .map(
        career => {

          const matched =
            career.skills.filter(
              skill =>
                selectedSkills.has(
                  skill
                )
            );


          const missing =
            career.skills.filter(
              skill =>
                !selectedSkills.has(
                  skill
                )
            );


          const score =
            Math.round(
              (
                matched.length
                /
                career.skills.length
              ) * 100
            );


          return {

            ...career,

            matched,

            missing,

            score

          };

        }
      )
      .sort(
        (a,b) =>
          b.score - a.score
      );


  const topResults =
    results.slice(
      0,
      6
    );


  renderScore(
    topResults
  );


  renderCareers(
    topResults
  );


  renderGaps(
    topResults
  );


  renderDevelopment(
    topResults
  );


  renderStrengths();

}


/* =========================
   SCORE
========================= */

function renderScore(
  results
){

  if(
    !results.length
  ){

    return;

  }


  const average =
    Math.round(
      results.reduce(
        (total, result) =>
          total + result.score,
        0
      )
      /
      results.length
    );


  scoreCircle.style
    .setProperty(
      "--score",
      `${average}%`
    );


  scoreNumber.textContent =
    `${average}%`;


  if(
    average >= 80
  ){

    matchLevel.textContent =
      "Excellent Match";


    matchDescription.textContent =
      "Your selected skills strongly align with several career areas.";

  }
  else if(
    average >= 60
  ){

    matchLevel.textContent =
      "Strong Match";


    matchDescription.textContent =
      "You have a strong foundation for several career directions.";

  }
  else if(
    average >= 40
  ){

    matchLevel.textContent =
      "Developing Match";


    matchDescription.textContent =
      "You have useful skills with clear opportunities for development.";

  }
  else{

    matchLevel.textContent =
      "Early Match";


    matchDescription.textContent =
      "Add more relevant skills to improve your career matches.";

  }

}


/* =========================
   CAREER RESULTS
========================= */

function renderCareers(
  results
){

  careerList.innerHTML =
    "";


  results.forEach(
    career => {

      const card =
        document.createElement(
          "div"
        );


      card.className =
        "career";


      card.innerHTML = `

        <div class="career-top">

          <span class="career-name">
            ${escapeHTML(
              career.name
            )}
          </span>

          <span class="career-score">
            ${career.score}%
          </span>

        </div>


        <div class="progress">

          <div
            class="progress-bar"
            style="width:${career.score}%"
          ></div>

        </div>

      `;


      careerList.appendChild(
        card
      );

    }
  );

}


/* =========================
   SKILL GAPS
========================= */

function renderGaps(
  results
){

  gapList.innerHTML =
    "";


  const gaps = [];


  results.forEach(
    career => {

      career.missing.forEach(
        skill => {

          if(
            !gaps.includes(
              skill
            )
          ){

            gaps.push(
              skill
            );

          }

        }
      );

    }
  );


  gaps
    .slice(
      0,
      8
    )
    .forEach(
      skill => {

        const item =
          document.createElement(
            "div"
          );


        item.className =
          "gap";


        item.innerHTML = `

          <div class="gap-icon">
            🧩
          </div>

          <div>

            <strong>
              ${escapeHTML(
                skill
              )}
            </strong>

            <span>
              Recommended skill to develop
            </span>

          </div>

        `;


        gapList.appendChild(
          item
        );

      }
    );


  if(
    gaps.length === 0
  ){

    gapList.innerHTML = `

      <div class="empty">

        <div class="empty-icon">
          🎉
        </div>

        <strong>
          Excellent alignment
        </strong>

        <p>
          Your selected skills already cover
          the main requirements of your matches.
        </p>

      </div>

    `;

  }

}


/* =========================
   DEVELOPMENT PRIORITIES
========================= */

function renderDevelopment(
  results
){

  developmentList.innerHTML =
    "";


  const priorities = [];


  results.forEach(
    career => {

      career.missing
        .forEach(
          skill => {

            if(
              !priorities.includes(
                skill
              )
            ){

              priorities.push(
                skill
              );

            }

          }
        );

    }
  );


  priorities
    .slice(
      0,
      6
    )
    .forEach(
      skill => {

        const item =
          document.createElement(
            "div"
          );


        item.className =
          "gap";


        item.innerHTML = `

          <div class="gap-icon">
            🚀
          </div>

          <div>

            <strong>
              ${escapeHTML(
                skill
              )}
            </strong>

            <span>
              High-value development area
            </span>

          </div>

        `;


        developmentList.appendChild(
          item
        );

      }
    );


  if(
    priorities.length === 0
  ){

    developmentList.innerHTML = `

      <div class="empty">

        <div class="empty-icon">
          ⭐
        </div>

        <strong>
          Strong skill profile
        </strong>

        <p>
          Continue improving your existing
          skills and gaining practical experience.
        </p>

      </div>

    `;

  }

}


/* =========================
   STRENGTHS
========================= */

function renderStrengths(){

  strengthList.innerHTML =
    "";


  const selected =
    [...selectedSkills];


  selected
    .slice(
      0,
      12
    )
    .forEach(
      skill => {

        const item =
          document.createElement(
            "span"
          );


        item.className =
          "strength";


        item.textContent =
          skill;


        strengthList.appendChild(
          item
        );

      }
    );


}


/* =========================
   RESET RESULTS
========================= */

function resetResults(){

  scoreCircle.style
    .setProperty(
      "--score",
      "0%"
    );


  scoreNumber.textContent =
    "0%";


  matchLevel.textContent =
    "Start selecting skills";


  matchDescription.textContent =
    "Select skills to calculate your matching results.";


  strengthList.innerHTML =
    "";


  careerList.innerHTML = `

    <div class="empty">

      <div class="empty-icon">
        🎯
      </div>

      <strong>
        No results yet
      </strong>

      <p>
        Select some skills above to see
        your career matches.
      </p>

    </div>

  `;


  gapList.innerHTML = `

    <div class="empty">

      <div class="empty-icon">
        🧩
      </div>

      <strong>
        No skill gaps yet
      </strong>

      <p>
        Your recommendations will appear here.
      </p>

    </div>

  `;


  developmentList.innerHTML = `

    <div class="empty">

      <div class="empty-icon">
        🚀
      </div>

      <strong>
        Choose your skills
      </strong>

      <p>
        Recommendations will be generated automatically.
      </p>

    </div>

  `;

}


/* =========================
   SEARCH
========================= */

skillSearch.addEventListener(
  "input",
  function(){

    renderSkills();

  }
);


/* =========================
   CLEAR ALL
========================= */

clearSkills.addEventListener(
  "click",
  function(){

    selectedSkills.clear();

    skillSearch.value =
      "";

    renderSkills();

    calculateMatches();

  }
);


/* =========================
   ESCAPE KEY
========================= */

skillSearch.addEventListener(
  "keydown",
  function(event){

    if(
      event.key === "Escape"
    ){

      skillSearch.value =
        "";

      renderSkills();

      skillSearch.focus();

    }

  }
);


/* =========================
   CURRENT YEAR
========================= */

const yearElement =
  document.getElementById(
    "year"
  );


if(
  yearElement
){

  yearElement.textContent =
    new Date()
      .getFullYear();

}


/* =========================
   INITIALIZE
========================= */

renderSkills();

resetResults();

</script>

</body>

</html>