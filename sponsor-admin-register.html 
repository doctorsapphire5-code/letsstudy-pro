<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#0f172a">
<title>Admin Registration | Vorix Sponsor</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  min-height:100vh;
  padding:22px;
  display:flex;
  justify-content:center;
  align-items:center;
  background:#f1f5f9;
  font-family:Arial,sans-serif;
  color:#172033;
}
.container{
  width:100%;
  max-width:500px;
  padding:30px 25px;
  background:white;
  border-radius:16px;
  box-shadow:0 8px 35px #0f172a12;
}
.logo{
  width:62px;height:62px;
  display:flex;align-items:center;justify-content:center;
  margin:0 auto 17px;
  border-radius:15px;
  background:#eff6ff;
  color:#2563eb;
  font-size:29px;
}
h1{text-align:center;font-size:24px;margin:0 0 9px}
.subtitle{
  text-align:center;
  color:#64748b;
  font-size:14px;
  line-height:1.6;
  margin:0 0 24px;
}
label{
  display:block;
  font-size:13px;
  font-weight:bold;
  margin-bottom:7px;
}
input,select{
  width:100%;
  padding:13px;
  border:1px solid #cbd5e1;
  border-radius:8px;
  font-size:14px;
  margin-bottom:16px;
  background:white;
}
input:focus,select:focus{
  outline:none;
  border-color:#2563eb;
  box-shadow:0 0 0 3px #2563eb15;
}
.password-wrap{position:relative}
.password-wrap input{padding-right:65px}
.toggle{
  position:absolute;
  right:9px;
  top:9px;
  border:0;
  background:#e2e8f0;
  padding:7px 9px;
  border-radius:6px;
  font-size:11px;
  cursor:pointer;
}
.row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}
.primary{
  width:100%;
  padding:14px;
  border:0;
  border-radius:9px;
  background:#2563eb;
  color:white;
  font-size:15px;
  font-weight:bold;
  cursor:pointer;
}
.primary:disabled{opacity:.6;cursor:not-allowed}
.message{
  display:none;
  padding:12px;
  border-radius:8px;
  margin-bottom:17px;
  font-size:13px;
  line-height:1.6;
}
.error{display:block;background:#fee2e2;color:#991b1b}
.success{display:block;background:#dcfce7;color:#166534}
.info{display:block;background:#dbeafe;color:#1e40af}
.note{
  padding:12px;
  background:#f8fafc;
  border:1px solid #e2e8f0;
  border-radius:8px;
  color:#64748b;
  font-size:12px;
  line-height:1.6;
  margin-bottom:17px;
}
.links{
  text-align:center;
  margin-top:21px;
  font-size:13px;
}
a{color:#2563eb;text-decoration:none;font-weight:bold}
footer{
  text-align:center;
  color:#94a3b8;
  font-size:11px;
  margin-top:23px;
}
@media(max-width:420px){
  .row{grid-template-columns:1fr;gap:0}
  .container{padding:25px 18px}
}
</style>
</head>

<body>

<main class="container">

  <div class="logo">🛡️</div>

  <h1>Admin Registration</h1>

  <p class="subtitle">
    Create your authorized Vorix Sponsor administrator account.
  </p>

  <div id="message" class="message" aria-live="polite"></div>

  <div class="note">
    <strong>Authorized registration only.</strong>
    You must have a pre-created Admin ID and an authorized email address.
  </div>

  <form id="registerForm">

    <label for="adminId">Admin ID</label>
    <input
      id="adminId"
      type="text"
      placeholder="Enter your assigned Admin ID"
      required
    >

    <label for="email">Authorized Email</label>
    <input
      id="email"
      type="email"
      placeholder="Enter your authorized email"
      autocomplete="email"
      required
    >

    <div class="row">
      <div>
        <label for="firstName">First Name</label>
        <input
          id="firstName"
          type="text"
          placeholder="First name"
          autocomplete="given-name"
          required
        >
      </div>

      <div>
        <label for="lastName">Last Name</label>
        <input
          id="lastName"
          type="text"
          placeholder="Last name"
          autocomplete="family-name"
          required
        >
      </div>
    </div>

    <label for="username">Username</label>
    <input
      id="username"
      type="text"
      placeholder="Choose username"
      autocomplete="username"
      required
    >

    <label for="phoneNumber">Phone Number</label>
    <input
      id="phoneNumber"
      type="tel"
      placeholder="Enter phone number"
      autocomplete="tel"
    >

    <label for="country">Country</label>
    <input
      id="country"
      type="text"
      placeholder="Enter country"
    >

    <label for="department">Department</label>
    <input
      id="department"
      type="text"
      placeholder="Enter department"
    >

    <label for="password">Password</label>

    <div class="password-wrap">
      <input
        id="password"
        type="password"
        placeholder="Create password (minimum 8 characters)"
        minlength="8"
        autocomplete="new-password"
        required
      >
      <button type="button" class="toggle" data-target="password">
        Show
      </button>
    </div>

    <label for="confirmPassword">Confirm Password</label>

    <div class="password-wrap">
      <input
        id="confirmPassword"
        type="password"
        placeholder="Confirm your password"
        minlength="8"
        autocomplete="new-password"
        required
      >
      <button type="button" class="toggle" data-target="confirmPassword">
        Show
      </button>
    </div>

    <button class="primary" id="registerBtn" type="submit">
      Create Admin Account
    </button>

  </form>

  <div class="links">
    Already registered?
    <a href="sponsor-admin-login.html">Admin Login</a>
  </div>

  <footer>
    &copy; <span id="year"></span> Vorix Sponsor. All rights reserved.
  </footer>

</main>

<script type="module">

import { initializeApp } from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

import {
  getAuth,
  createUserWithEmailAndPassword,
  updateProfile,
  sendEmailVerification,
  signOut
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

import {
  getFirestore,
  collection,
  query,
  where,
  getDocs,
  updateDoc,
  serverTimestamp
} from
"https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

const firebaseConfig = {
  apiKey: "AIzaSyC_bGZrFXPTS_TBj4l0E3KJ42uQC6OG8y0",
  authDomain: "vorix-sponsor.firebaseapp.com",
  databaseURL: "https://vorix-sponsor-default-rtdb.firebaseio.com",
  projectId: "vorix-sponsor",
  storageBucket: "vorix-sponsor.firebasestorage.app",
  messagingSenderId: "595130943286",
  appId: "1:595130943286:web:a3c8d16b9bb5567f18d597",
  measurementId: "G-914TSCJ747"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

const $ = id => document.getElementById(id);

$("year").textContent = new Date().getFullYear();

function showMessage(text,type="error"){
  const box = $("message");
  box.textContent = text;
  box.className = "message " + type;
}

function firebaseError(code){

  const errors = {
    "auth/email-already-in-use":
      "This email already has a Firebase account. Please use Admin Login or contact support.",
    "auth/weak-password":
      "Your password is too weak. Use at least 8 characters.",
    "auth/invalid-email":
      "Please enter a valid email address.",
    "auth/network-request-failed":
      "Network error. Check your internet connection.",
    "auth/operation-not-allowed":
      "Email and Password authentication is not enabled in Firebase.",
    "permission-denied":
      "Registration is not authorized by Firestore security rules."
  };

  return errors[code] || "Registration failed. Please try again.";
}

// Show and hide passwords.
document.querySelectorAll(".toggle").forEach(button=>{

  button.addEventListener("click",()=>{

    const input = $(button.dataset.target);

    if(input.type === "password"){
      input.type = "text";
      button.textContent = "Hide";
    }else{
      input.type = "password";
      button.textContent = "Show";
    }

  });

});

$("registerForm").addEventListener("submit",async event=>{

  event.preventDefault();

  const adminId = $("adminId").value.trim();
  const email = $("email").value.trim().toLowerCase();

  const firstName = $("firstName").value.trim();
  const lastName = $("lastName").value.trim();
  const username = $("username").value.trim();

  const phoneNumber = $("phoneNumber").value.trim();
  const country = $("country").value.trim();
  const department = $("department").value.trim();

  const password = $("password").value;
  const confirmPassword = $("confirmPassword").value;

  const button = $("registerBtn");

  if(!adminId || !email || !firstName || !lastName || !username){
    showMessage("Please complete all required fields.");
    return;
  }

  if(password.length < 8){
    showMessage("Password must contain at least 8 characters.");
    return;
  }

  if(password !== confirmPassword){
    showMessage("Passwords do not match.");
    return;
  }

  button.disabled = true;
  button.textContent = "Verifying invitation...";

  let createdUser = null;

  try{

    // Find the pre-created admin invitation.
    const invitationQuery = query(
      collection(db,"admins"),
      where("adminId","==",adminId)
    );

    const invitationSnapshot = await getDocs(invitationQuery);

    if(invitationSnapshot.empty){
      showMessage("Invalid Admin ID. Contact your administrator.");
      return;
    }

    if(invitationSnapshot.size !== 1){
      showMessage("Admin ID is not unique. Contact support.");
      return;
    }

    const invitationDoc = invitationSnapshot.docs[0];
    const invitation = invitationDoc.data();

    const authorizedEmail =
      String(invitation.email || "").trim().toLowerCase();

    // Check the invitation details.
    if(authorizedEmail !== email){
      showMessage("This email is not authorized for the supplied Admin ID.");
      return;
    }

    if(invitation.status !== "invited"){
      showMessage(
        "This invitation is not available. Check its status with your administrator."
      );
      return;
    }

    if(invitation.uid){
      showMessage("This administrator invitation has already been used.");
      return;
    }

    if(invitation.role !== "admin"){
      showMessage("This invitation does not have administrator access.");
      return;
    }

    // Prevent a second registration attempt from an existing session.
    if(auth.currentUser){
      await signOut(auth);
    }

    button.textContent = "Creating account...";

    // Create Firebase Authentication account.
    const credential = await createUserWithEmailAndPassword(
      auth,
      email,
      password
    );

    createdUser = credential.user;

    const fullName = firstName + " " + lastName;

    await updateProfile(createdUser,{
      displayName:fullName
    });

    // Update the pre-created admin document.
    await updateDoc(invitationDoc.ref,{

      uid:createdUser.uid,

      adminId:adminId,

      email:email,

      firstName:firstName,
      lastName:lastName,
      fullName:fullName,
      displayName:fullName,
      username:username,

      phoneNumber:phoneNumber,
      country:country,
      department:department,

      emailVerified:false,
      phoneVerified:false,

      role:"admin",

      status:"active",

      language:invitation.language || "English",

      timezone:invitation.timezone || "Africa/Dar_es_Salaam",

      loginCount:0,

      lastLoginAt:null,

      updatedAt:serverTimestamp()

    });

    // Send Firebase verification email.
    await sendEmailVerification(createdUser);

    showMessage(
      "Your administrator account has been created. Check your email and verify your address before logging in.",
      "success"
    );

    $("registerForm").reset();

    button.textContent = "Registration Complete";

    // Keep account signed out until email is verified.
    await signOut(auth);

    setTimeout(()=>{
      window.location.href = "sponsor-admin-login.html";
    },4000);

  }catch(error){

    console.error("Admin registration error:",error);

    // If Auth creation succeeded but Firestore update failed,
    // the Auth account may exist without a completed admin record.
    if(createdUser){
      showMessage(
        "Your authentication account was created, but admin registration could not be completed. Do not register again. Contact support to reconcile the account.",
        "error"
      );
    }else{
      showMessage(firebaseError(error.code));
    }

  }finally{

    if(button.textContent !== "Registration Complete"){
      button.disabled = false;
      button.textContent = "Create Admin Account";
    }

  }

});

</script>

</body>
</html>