<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Teacher Profile | LetsStudy Pro</title>

  <meta
    name="description"
    content="View teacher profile, qualifications, subjects, experience, curricula, availability and tutoring services on LetsStudy Pro."
  >

  <meta name="theme-color" content="#0b1220">

  <style>
    *{
      box-sizing:border-box;
      margin:0;
      padding:0;
    }

    body{
      font-family:Arial,Helvetica,sans-serif;
      background:#f4f7fb;
      color:#172033;
      line-height:1.6;
    }

    a{
      text-decoration:none;
      color:inherit;
    }

    button{
      font-family:inherit;
    }

    .topbar{
      background:#0b1220;
      color:#fff;
      padding:14px 20px;
      position:sticky;
      top:0;
      z-index:1000;
    }

    .topbar-inner{
      max-width:1200px;
      margin:auto;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:15px;
    }

    .brand{
      font-size:20px;
      font-weight:800;
    }

    .brand span{
      color:#36c2ff;
    }

    .back-btn{
      border:1px solid rgba(255,255,255,.25);
      background:transparent;
      color:#fff;
      padding:9px 14px;
      border-radius:9px;
      cursor:pointer;
    }

    .page{
      max-width:1200px;
      margin:30px auto;
      padding:0 18px;
    }

    .loading,
    .error{
      background:#fff;
      border-radius:18px;
      padding:40px 25px;
      text-align:center;
      box-shadow:0 8px 30px rgba(0,0,0,.06);
    }

    .error{
      color:#b42318;
      display:none;
    }

    .profile-header{
      background:linear-gradient(135deg,#0b1220,#16294a);
      color:#fff;
      border-radius:22px;
      padding:30px;
      display:grid;
      grid-template-columns:150px 1fr auto;
      gap:25px;
      align-items:center;
      box-shadow:0 15px 45px rgba(10,25,50,.18);
    }

    .profile-photo{
      width:150px;
      height:150px;
      border-radius:50%;
      object-fit:cover;
      border:5px solid rgba(255,255,255,.3);
      background:#fff;
    }

    .teacher-name{
      font-size:32px;
      line-height:1.2;
      margin-bottom:6px;
    }

    .display-name{
      color:#b8d9ff;
      margin-bottom:10px;
    }

    .bio{
      color:#e5edf8;
      max-width:700px;
    }

    .badges{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin-top:15px;
    }

    .badge{
      display:inline-flex;
      align-items:center;
      gap:5px;
      background:rgba(255,255,255,.12);
      border:1px solid rgba(255,255,255,.15);
      padding:6px 10px;
      border-radius:999px;
      font-size:13px;
    }

    .verified{
      background:#087443;
      border-color:#087443;
    }

    .featured{
      background:#805b00;
      border-color:#805b00;
    }

    .header-actions{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .action-btn{
      border:0;
      padding:11px 17px;
      border-radius:10px;
      cursor:pointer;
      font-weight:700;
      white-space:nowrap;
    }

    .primary{
      background:#36c2ff;
      color:#06111d;
    }

    .light{
      background:#fff;
      color:#111827;
    }

    .outline{
      background:transparent;
      color:#fff;
      border:1px solid rgba(255,255,255,.35);
    }

    .grid{
      display:grid;
      grid-template-columns:2fr 1fr;
      gap:22px;
      margin-top:22px;
    }

    .card{
      background:#fff;
      border-radius:18px;
      padding:24px;
      box-shadow:0 8px 30px rgba(0,0,0,.055);
      margin-bottom:22px;
    }

    .card h2{
      font-size:20px;
      margin-bottom:18px;
      color:#101828;
    }

    .card h3{
      font-size:15px;
      margin-bottom:8px;
    }

    .section-title{
      display:flex;
      align-items:center;
      gap:10px;
    }

    .section-title::before{
      content:"";
      width:5px;
      height:22px;
      border-radius:4px;
      background:#36c2ff;
    }

    .info-grid{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:16px;
    }

    .info{
      background:#f7f9fc;
      border-radius:12px;
      padding:13px 15px;
    }

    .label{
      display:block;
      font-size:12px;
      color:#667085;
      margin-bottom:3px;
      text-transform:uppercase;
      letter-spacing:.04em;
    }

    .value{
      font-weight:600;
      color:#1d2939;
      word-break:break-word;
    }

    .chips{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
    }

    .chip{
      background:#eef7ff;
      color:#075985;
      border:1px solid #cfeaff;
      border-radius:999px;
      padding:7px 11px;
      font-size:13px;
    }

    .chip.green{
      background:#ecfdf3;
      color:#067647;
      border-color:#abefc6;
    }

    .chip.orange{
      background:#fff7ed;
      color:#c2410c;
      border-color:#fed7aa;
    }

    .list{
      display:flex;
      flex-direction:column;
      gap:10px;
    }

    .list-item{
      padding:12px 14px;
      background:#f7f9fc;
      border-radius:10px;
    }

    .price{
      font-size:32px;
      font-weight:800;
      color:#101828;
    }

    .price small{
      font-size:14px;
      font-weight:500;
      color:#667085;
    }

    .rating{
      font-size:26px;
      font-weight:800;
    }

    .stars{
      color:#f59e0b;
      letter-spacing:2px;
    }

    .video-box{
      position:relative;
      width:100%;
      aspect-ratio:16/9;
      overflow:hidden;
      border-radius:14px;
      background:#0b1220;
    }

    .video-box iframe,
    .video-box video{
      width:100%;
      height:100%;
      border:0;
    }

    .socials{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
    }

    .social{
      padding:9px 13px;
      border-radius:9px;
      background:#f2f4f7;
      color:#344054;
      font-weight:600;
    }

    .social:hover{
