    messagingSenderId: "474928293390",
    appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
    measurementId: "G-85B7V5H5J0"
  };


  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);


  /* =====================================================
     HELPERS
  ===================================================== */

  const $ = (id) => document.getElementById(id);


  function setText(id, value) {
    const element = $(id);

    if (!element) return;

    element.textContent =
      value !== undefined &&
      value !== null &&
      value !== ""
        ? value
        : "—";
  }


  function getArray(value) {

    if (!Array.isArray(value)) {
      return [];
    }

    return value.filter(
      item =>
        item !== null &&
        item !== undefined &&
        String(item).trim() !== ""
    );

  }


  function renderChips(id, value) {

    const container = $(id);

    if (!container) return;

    container.innerHTML = "";

    const items = getArray(value);

    if (!items.length) {

      container.innerHTML =
        `<span class="chip">Not specified</span>`;

      return;
    }


    items.forEach(item => {

      const chip =
        document.createElement("span");

      chip.className = "chip";

      chip.textContent = item;

      container.appendChild(chip);

    });

  }


  function renderList(id, value) {

    const container = $(id);

    if (!container) return;

    container.innerHTML = "";

    const items = getArray(value);

    if (!items.length) {

      container.innerHTML =
        `<div class="list-item">Not specified</div>`;

      return;
    }


    items.forEach(item => {

      const itemElement =
        document.createElement("div");

      itemElement.className =
        "list-item";

      if (
        typeof item === "object" &&
        item !== null
      ) {

        itemElement.textContent =
          Object.entries(item)
            .map(
              ([key, value]) =>
                `${key}: ${value}`
            )
            .join(" • ");

      } else {

        itemElement.textContent =
          item;

      }

      container.appendChild(
        itemElement
      );

    });

  }


  function formatDate(value) {

    if (!value) {
      return "—";
    }


    try {

      if (
        typeof value === "object" &&
        typeof value.toDate === "function"
      ) {

        return value
          .toDate()
          .toLocaleString();

      }


      const date =
        new Date(value);

      if (isNaN(date.getTime())) {
        return String(value);
      }

      return date.toLocaleString();

    } catch {

      return String(value);

    }

  }


  function safeUrl(value) {

    if (!value) {
      return "";
    }


    try {

      const url =
        new URL(value);

      if (
        url.protocol === "http:" ||
        url.protocol === "https:"
      ) {

        return url.href;

      }

    } catch {}

    return "";

  }


  function getYouTubeEmbed(url) {

    const safe =
      safeUrl(url);

    if (!safe) {
      return "";
    }


    try {

      const parsed =
        new URL(safe);

      let videoId = "";


      if (
        parsed.hostname.includes(
          "youtube.com"
        )
      ) {

        videoId =
          parsed.searchParams.get("v") ||
          "";


        if (
          parsed.pathname.startsWith(
            "/shorts/"
          )
        ) {

          videoId =
            parsed.pathname
              .split("/shorts/")[1]
              .split("/")[0];

        }


        if (
          parsed.pathname.startsWith(
            "/embed/"
          )
        ) {

          videoId =
            parsed.pathname
              .split("/embed/")[1]
              .split("/")[0];

        }

      }


      if (
        parsed.hostname ===
        "youtu.be"
      ) {

        videoId =
          parsed.pathname
            .replace("/", "")
            .split("/")[0];

      }


      if (videoId) {

        return (
          "https://www.youtube.com/embed/" +
          videoId
        );

      }


      return safe;

    } catch {

      return "";

    }

  }


  /* =====================================================
     URL
  ===================================================== */

  const params =
    new URLSearchParams(
      window.location.search
    );


  const teacherId =
    params.get("id");


  /* =====================================================
     ERROR HANDLER
  ===================================================== */

  function showError(message) {

    const loading =
      $("loading");

    const errorBox =
      $("errorBox");

    const messageBox =
      $("errorMessage");


    if (loading) {
      loading.classList.add(
        "hidden"
      );
    }


    if (errorBox) {
      errorBox.style.display =
        "block";
    }


    if (messageBox) {
      messageBox.textContent =
        message;
    }

  }


  /* =====================================================
     LOAD TEACHER
  ===================================================== */

  async function loadTeacher() {

    if (!teacherId) {

      showError(
        "Teacher ID is missing from the URL."
      );

      return;
    }


    try {

      const teacherRef =
        doc(
          db,
          "teachers",
          teacherId
        );


      const snapshot =
        await getDoc(
          teacherRef
        );


      if (!snapshot.exists()) {

        showError(
          "Teacher profile was not found."
        );

        return;
      }


      const teacher =
        snapshot.data();


      renderTeacher(
        teacher,
        teacherId
      );


    } catch (error) {

      console.error(
        "Firebase error:",
        error
      );


      showError(
        "Unable to load this teacher profile."
      );

    }

  }


  /* =====================================================
     RENDER TEACHER
  ===================================================== */

  function renderTeacher(
    teacher,
    documentId
  ) {

    $("loading")
      ?.classList.add(
        "hidden"
      );


    $("teacherContent")
      ?.classList.remove(
        "hidden"
      );


    /* =================================================
       BASIC PROFILE
    ================================================= */

    setText(
      "fullName",
      teacher.fullName
    );


    setText(
      "displayName",
      teacher.displayName
    );


    setText(
      "professionalBio",
      teacher.professionalBio
    );


    /* =================================================
       PROFILE PHOTO
    ================================================= */

    const photo =
      safeUrl(
        teacher.profilePhoto
      );


    if ($("profilePhoto")) {

      $("profilePhoto").src =
        photo ||
        "https://via.placeholder.com/300x300?text=Teacher";


      $("profilePhoto").alt =
        teacher.fullName ||
        "Teacher";

    }


    /* =================================================
       LOCATION
    ================================================= */

    setText(
      "country",
      teacher.country
    );

    setText(
      "city",
      teacher.city
    );

    setText(
      "region",
      teacher.region
    );

    setText(
      "timezone",
      teacher.timezone
    );


    renderChips(
      "languages",
      teacher.languages
    );


    /* =================================================
       TEACHING EXPERTISE
    ================================================= */

    renderChips(
      "subjects",
      teacher.subjects
    );


    renderChips(
      "teachingLevels",
      teacher.teachingLevels
    );


    renderChips(
      "ageGroups",
      teacher.ageGroups
    );


    renderChips(
      "specializations",
      teacher.specializations
    );


    /* =================================================
       CURRICULA
    ================================================= */

    renderChips(
      "curricula",
      teacher.curricula
    );


    renderChips(
      "boards",
      teacher.boards
    );


    /* =================================================
       QUALIFICATIONS
    ================================================= */

    setText(
      "yearsOfExperience",
      teacher.yearsOfExperience
        ? `${teacher.yearsOfExperience} years`
        : "—"
    );


    renderList(
      "qualifications",
      teacher.qualifications
    );


    renderList(
      "certifications",
      teacher.certifications
    );


    renderList(
      "institutions",
      teacher.institutions
    );


    /* =================================================
       SERVICES
    ================================================= */

    renderChips(
      "teachingMode",
      teacher.teachingMode
    );


    renderChips(
      "countriesServed",
      teacher.countriesServed
    );


    renderChips(
      "services",
      teacher.services
    );


    renderChips(
      "teachingMethods",
      teacher.teachingMethods
    );


    /* =================================================
       AVAILABILITY
    ================================================= */

    const availability =
      teacher.availability || {};


    renderChips(
      "availableDays",
      teacher.availableDays ||
      availability.days
    );


    let hours =
      teacher.availableHours;


    if (
      !hours &&
      availability.startTime &&
      availability.endTime
    ) {

      hours =
        `${availability.startTime} - ${availability.endTime}`;

    }


    setText(
      "availableHours",
      hours
    );


    /* =================================================
       PRICING
    ================================================= */

    setText(
      "hourlyRate",
      teacher.hourlyRate
    );


    setText(
      "currency",
      teacher.currency
    );


    if ($("trialLesson")) {

      $("trialLesson")
        .textContent =
        teacher.trialLesson === true
          ? "✓ Trial lesson available"
          : "Trial lesson not available";

    }


    renderList(
      "packagePricing",
      teacher.packagePricing
    );


    /* =================================================
       RATING
    ================================================= */

    setText(
      "rating",
      teacher.rating ?? 0
    );


    setText(
      "reviewCount",
      teacher.reviewCount ?? 0
    );


    setText(
      "studentCount",
      teacher.studentCount ?? 0
    );


    /* =================================================
       VERIFICATION
    ================================================= */

    const identityVerified =
      teacher.identityVerification === true;


    const qualificationVerified =
      teacher.qualificationVerification === true;


    if ($("identityVerification")) {

      $("identityVerification")
        .textContent =
        identityVerified
          ? "✓ Identity Verified"
          : "Identity Not Verified";

    }


    if ($("qualificationVerification")) {

      $("qualificationVerification")
        .textContent =
        qualificationVerified
          ? "✓ Qualification Verified"
          : "Qualification Not Verified";

    }


    setText(
      "verificationDate",
      formatDate(
        teacher.verificationDate
      )
    );


    setText(
      "verifiedBy",
      teacher.verifiedBy
    );


    /* =================================================
       VERIFICATION BADGE
    ================================================= */

    const verificationStatus =
      String(
        teacher.verificationStatus ||
        "pending"
      ).toLowerCase();


    if ($("verificationBadge")) {

      if (
        verificationStatus ===
        "verified"
      ) {

        $("verificationBadge")
          .textContent =
          "✓ Verified Teacher";

        $("verificationBadge")
          .classList.add(
            "verified"
          );

      } else {

        $("verificationBadge")
          .textContent =
          "Verification Pending";

      }

    }


    /* =================================================
       FEATURED
    ================================================= */

    if (
      teacher.featured === true &&
      $("featuredBadge")
    ) {

      $("featuredBadge")
        .classList.remove(
          "hidden"
        );

    }


    /* =================================================
       STATUS
    ================================================= */

    setText(
      "profileStatus",
      teacher.status
    );


    if ($("statusBadge")) {

      $("statusBadge")
        .textContent =
        teacher.status ||
        "Active";

    }


    /* =================================================
       VIDEO
    ================================================= */

    const introVideo =
      getYouTubeEmbed(
        teacher.introductionVideo
      );


    if (
      introVideo &&
      $("introSection") &&
      $("introductionVideo")
    ) {

      $("introSection")
        .classList.remove(
          "hidden"
        );

      $("introductionVideo")
        .src =
        introVideo;

    }


    const demoVideo =
      getYouTubeEmbed(
        teacher.teachingDemo
      );


    if (
      demoVideo &&
      $("demoSection") &&
      $("teachingDemo")
    ) {

      $("demoSection")
        .classList.remove(
          "hidden"
        );

      $("teachingDemo")
        .src =
        demoVideo;

    }


    /* =================================================
       SOCIAL LINKS
    ================================================= */

    setupLink(
      "websiteLink",
      teacher.website
    );


    setupLink(
      "linkedinLink",
      teacher.linkedin
    );


    setupLink(
      "youtubeLink",
      teacher.youtube
    );


    /* =================================================
       PROFILE INFORMATION
    ================================================= */

    setText(
      "teacherId",
      teacher.teacherId ||
      documentId
    );


    setText(
      "createdAt",
      formatDate(
        teacher.createdAt
      )
    );


    setText(
      "updatedAt",
      formatDate(
        teacher.updatedAt
      )
    );


    /* =================================================
       CONTACT
    ================================================= */

    setupContact(
      teacher
    );


    /* =================================================
       SHARE
    ================================================= */

    setupShare(
      teacher
    );


    /* =================================================
       PAGE TITLE
    ================================================= */

    const name =
      teacher.displayName ||
      teacher.fullName ||
      "Teacher";


    document.title =
      `${name} | LetsStudy Pro`;


    /* =================================================
       SEO META DESCRIPTION
    ================================================= */

    const description =
      teacher.professionalBio ||
      `${name} is a teacher on LetsStudy Pro.`;


    let meta =
      document.querySelector(
        'meta[name="description"]'
      );


    if (meta) {

      meta.setAttribute(
        "content",
        description
      );

    }

  }


  /* =====================================================
     SOCIAL LINKS
  ===================================================== */

  function setupLink(
    id,
    value
  ) {

    const element =
      $(id);


    if (!element) return;


    const url =
      safeUrl(value);


    if (url) {

      element.href =
        url;

      element.classList
        .remove(
          "hidden"
        );

    }

  }


  /* =====================================================
     CONTACT
  ===================================================== */

  function setupContact(
    teacher
  ) {

    const whatsapp =
      teacher.whatsapp ||
      teacher.phone ||
      "";


    if ($("whatsappBtn")) {

      $("whatsappBtn")
        .onclick = () => {

          if (!whatsapp) {

            alert(
              "WhatsApp number is not available."
            );

            return;
          }


          const cleanNumber =
            String(whatsapp)
              .replace(
                /[^\d]/g,
                ""
              );


          window.open(
            `https://wa.me/${cleanNumber}`,
            "_blank"
          );

        };

    }


    if ($("emailBtn")) {

      $("emailBtn")
        .onclick = () => {

          if (!teacher.email) {

            alert(
              "Teacher email is not available."
            );

            return;
          }


          window.location.href =
            `mailto:${teacher.email}`;

        };

    }


    if ($("contactBtn")) {

      $("contactBtn")
        .onclick = () => {

          const contactBox =
            document.querySelector(
              ".contact-box"
            );


          if (contactBox) {

            contactBox.scrollIntoView({
              behavior: "smooth",
              block: "center"
            });

          }

        };

    }

  }


  /* =====================================================
     SHARE PROFILE
  ===================================================== */

  function setupShare(
    teacher
  ) {

    if (!$("shareBtn")) {
      return;
    }


    $("shareBtn")
      .onclick = async () => {

        const name =
          teacher.displayName ||
          teacher.fullName ||
          "Teacher";


        const shareData = {

          title:
            `${name} | LetsStudy Pro`,

          text:
            `View ${name}'s teacher profile on LetsStudy Pro.`,

          url:
            window.location.href

        };


        try {

          if (
            navigator.share
          ) {

            await navigator.share(
              shareData
            );

          } else {

            await navigator
              .clipboard
              .writeText(
                window.location.href
              );


            alert(
              "Teacher profile link copied."
            );

          }

        } catch (error) {

          console.log(
            "Share cancelled:",
            error
          );

        }

      };

  }


  /* =====================================================
     BACK BUTTON
  ===================================================== */

  window.goBack =
    function() {

      if (
        document.referrer &&
        document.referrer.includes(
          window.location.hostname
        )
      ) {

        history.back();

      } else {

        window.location.href =
          "teachers.html";

      }

    };


  /* =====================================================
     YEAR
  ===================================================== */

  if ($("year")) {

    $("year").textContent =
      new Date().getFullYear();

  }


  /* =====================================================
     START
  ===================================================== */

  loadTeacher();

</script>

