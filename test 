<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>LetsStudy Pro</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:Arial,sans-serif;
  background:#f8fafc;
  color:#0f172a;
  overflow-x:hidden
}
section{
  min-height:100vh;
  padding:80px 20px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  opacity:0;
  transform:translateY(80px);
  transition:1s ease
}
section.show{
  opacity:1;
  transform:translateY(0)
}
.box{max-width:800px}
h1{font-size:45px;margin-bottom:20px}
h2{font-size:32px;margin-bottom:15px}
p{font-size:18px;line-height:1.7;color:#64748b}
.btn{
  display:inline-block;
  margin-top:25px;
  padding:14px 25px;
  border-radius:10px;
  background:#2563eb;
  color:white;
  text-decoration:none
}
nav{
  position:fixed;
  top:0;
  width:100%;
  padding:18px 25px;
  background:white;
  z-index:10;
  box-shadow:0 2px 10px #0001
}
nav b{font-size:20px}
</style>
</head>

<body>

<nav>
  <b>LetsStudy Pro</b>
</nav>

<section>
  <div class="box">
    <h1>Learn. Build. Work. Grow.</h1>
    <p>Global Digital Learning & Growth Ecosystem.</p>
    <a class="btn" href="search.html">Explore Now</a>
  </div>
</section>

<section>
  <div class="box">
    <h2>Courses</h2>
    <p>Learn practical skills and build your future.</p>
  </div>
</section>

<section>
  <div class="box">
    <h2>Scholarship</h2>
    <p>Discover education opportunities and scholarships.</p>
  </div>
</section>

<section>
  <div class="box">
    <h2>Career</h2>
    <p>Find opportunities to develop your career.</p>
  </div>
</section>

<section>
  <div class="box">
    <h2>Resources</h2>
    <p>Access useful learning materials and digital resources.</p>
  </div>
</section>

<section>
  <div class="box">
    <h2>Blog</h2>
    <p>Read useful ideas, updates and educational content.</p>
  </div>
</section>

<script>
const sections=document.querySelectorAll("section");

const observer=new IntersectionObserver(entries=>{
  entries.forEach(entry=>{
    entry.target.classList.toggle("show",entry.isIntersecting);
  });
},{threshold:.15});

sections.forEach(section=>observer.observe(section));
</script>

</body>
</html>