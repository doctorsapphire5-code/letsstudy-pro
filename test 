<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>LetsStudy Pro — Global Digital Learning & Growth Ecosystem</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0
}

html{
  scroll-behavior:smooth
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#f8fafc;
  color:#0f172a;
  overflow-x:hidden
}

/* NAVBAR */
nav{
  position:fixed;
  top:0;
  left:0;
  width:100%;
  padding:16px 22px;
  background:rgba(255,255,255,.92);
  backdrop-filter:blur(12px);
  z-index:1000;
  box-shadow:0 2px 15px #0001;
  display:flex;
  justify-content:space-between;
  align-items:center
}

.logo{
  font-size:21px;
  font-weight:800;
}

nav a{
  text-decoration:none;
  color:#2563eb;
  font-weight:600
}

/* SECTIONS */
section{
  min-height:100vh;
  padding:100px 20px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  opacity:0;
  transition:
    opacity .9s ease,
    transform 1s cubic-bezier(.2,.8,.2,1)
}

.from-bottom{
  transform:translateY(100px)
}

.from-top{
  transform:translateY(-100px)
}

.from-left{
  transform:translateX(-120px)
}

.from-right{
  transform:translateX(120px)
}

.zoom{
  transform:scale(.75)
}

.fade{
  transform:scale(.94)
}

section.show{
  opacity:1;
  transform:translate(0) scale(1)
}

.box{
  width:100%;
  max-width:950px
}

/* HERO */
.hero{
  background:
    radial-gradient(circle at top right,#dbeafe,transparent 35%),
    radial-gradient(circle at bottom left,#e0e7ff,transparent 35%),
    #f8fafc
}

.badge{
  display:inline-block;
  padding:8px 14px;
  border-radius:30px;
  background:#dbeafe;
  color:#1d4ed8;
  font-size:14px;
  font-weight:bold;
  margin-bottom:20px
}

h1{
  font-size:clamp(40px,8vw,72px);
  line-height:1.05;
  margin-bottom:22px
}

h2{
  font-size:clamp(30px,5vw,45px);
  margin-bottom:15px
}

p{
  font-size:18px;
  line-height:1.7;
  color:#64748b
}

.hero p{
  max-width:700px;
  margin:auto
}

/* BUTTONS */
.buttons{
  margin-top:30px;
  display:flex;
  justify-content:center;
  gap:12px;
  flex-wrap:wrap
}

.btn{
  display:inline-block;
  padding:14px 24px;
  border-radius:12px;
  background:#2563eb;
  color:white;
  text-decoration:none;
  font-weight:bold;
  transition:.3s
}

.btn:hover{
  transform:translateY(-4px);
  box-shadow:0 10px 25px #2563eb33
}

.btn.secondary{
  background:white;
  color:#2563eb;
  border:1px solid #bfdbfe
}

/* SEARCH */
.search{
  margin:30px auto 0;
  max-width:600px;
  display:flex;
  background:white;
  padding:7px;
  border-radius:14px;
  box-shadow:0 10px 35px #00000012
}

.search input{
  flex:1;
  border:0;
  outline:0;
  padding:13px;
  font-size:16px
}

.search button{
  border:0;
  background:#2563eb;
  color:white;
  padding:0 20px;
  border-radius:10px;
  cursor:pointer
}

/* CARDS */
.cards{
  margin-top:35px;
  display:grid;
  grid-template-columns:
    repeat(auto-fit,minmax(180px,1fr));
  gap:18px
}

.card{
  background:white;
  padding:28px 20px;
  border-radius:18px;
  box-shadow:0 8px 30px #0000000d;
  transition:.35s;
  text-align:left
}

.card:hover{
  transform:translateY(-8px);
  box-shadow:0 15px 35px #00000015
}

.icon{
  width:48px;
  height:48px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:12px;
  background:#eff6ff;
  color:#2563eb;
  font-size:22px;
  margin-bottom:18px
}

.card h3{
  margin-bottom:8px
}

.card p{
  font-size:15px
}

/* STATS */
.stats{
  margin-top:40px;
  display:grid;
  grid-template-columns:
    repeat(auto-fit,minmax(150px,1fr));
  gap:15px
}

.stat{
  padding:25px;
  background:white;
  border-radius:16px;
  box-shadow:0 8px 25px #0000000c
}

.stat strong{
  display:block;
  font-size:32px;
  color:#2563eb;
  margin-bottom:5px
}

/* CTA */
.cta{
  background:#0f172a;
  color:white
}

.cta p{
  color:#cbd5e1
}

/* FOOTER */
footer{
  padding:40px 20px;
  text-align:center;
  background:#020617;
  color:#cbd5e1
}

/* MOBILE */
@media(max-width:600px){

  nav{
    padding:14px 17px
  }

  nav a{
    font-size:14px
  }

  section{
    padding:90px 16px
  }

  .search{
    flex-direction:column;
    gap:7px
  }

  .search button{
    padding:13px
  }

}
</style>
</head>

<body>

<nav>
  <div class="logo">LetsStudy Pro</div>
  <a href="#explore">Explore</a>
</nav>


<!-- HERO -->
<section class="hero from-bottom">

  <div class="box">

    <span class="badge">
      THE DIGITAL ECOSYSTEM
    </span>

    <h1>
      Learn. Build.<br>
      Work. Grow.
    </h1>

    <p>
      A global digital learning and growth ecosystem
      connecting people with courses, opportunities,
      resources, careers and digital services.
    </p>

    <div class="buttons">
      <a class="btn" href="#explore">
        Explore LetsStudy Pro
      </a>

      <a class="btn secondary" href="search.html">
        Search
      </a>
    </div>

  </div>

</section>


<!-- SEARCH -->
<section class="from-left" id="explore">

  <div class="box">

    <span class="badge">DISCOVER</span>

    <h2>Find What You Need</h2>

    <p>
      Search courses, scholarships, careers,
      resources and blog content.
    </p>

    <div class="search">

      <input
        type="search"
        placeholder="Search LetsStudy Pro..."
      >

      <button onclick="searchPage()">
        Search
      </button>

    </div>

  </div>

</section>


<!-- MAIN SECTORS -->
<section class="from-right">

  <div class="box">

    <span class="badge">EXPLORE</span>

    <h2>Everything in One Ecosystem</h2>

    <p>
      Explore the main opportunities available
      through LetsStudy Pro.
    </p>

    <div class="cards">

      <div class="card">
        <div class="icon">01</div>
        <h3>Course</h3>
        <p>
          Learn practical and professional skills.
        </p>
      </div>

      <div class="card">
        <div class="icon">02</div>
        <h3>Scholarship</h3>
        <p>
          Discover education opportunities.
        </p>
      </div>

      <div class="card">
        <div class="icon">03</div>
        <h3>Career</h3>
        <p>
          Find career and professional opportunities.
        </p>
      </div>

      <div class="card">
        <div class="icon">04</div>
        <h3>Resources</h3>
        <p>
          Access useful learning materials.
        </p>
      </div>

      <div class="card">
        <div class="icon">05</div>
        <h3>Blog</h3>
        <p>
          Read useful articles and updates.
        </p>
      </div>

    </div>

  </div>

</section>


<!-- STATS -->
<section class="zoom">

  <div class="box">

    <span class="badge">GROW WITH US</span>

    <h2>One Platform. Many Possibilities.</h2>

    <p>
      Built to connect learning, opportunities
      and digital growth.
    </p>

    <div class="stats">

      <div class="stat">
        <strong>5+</strong>
        <span>Sectors</span>
      </div>

      <div class="stat">
        <strong>100+</strong>
        <span>Resources</span>
      </div>

      <div class="stat">
        <strong>24/7</strong>
        <span>Access</span>
      </div>

      <div class="stat">
        <strong>1</strong>
        <span>Ecosystem</span>
      </div>

    </div>

  </div>

</section>


<!-- CTA -->
<section class="cta from-top">

  <div class="box">

    <span class="badge">
      LET'S GET STARTED
    </span>

    <h2>
      Your Next Opportunity Starts Here.
    </h2>

    <p>
      Learn new skills, discover opportunities
      and grow with LetsStudy Pro.
    </p>

    <div class="buttons">

      <a class="btn" href="search.html">
        Start Exploring
      </a>

    </div>

  </div>

</section>


<footer>

  <strong>LetsStudy Pro</strong>

  <p style="margin-top:10px">
    Learn. Build. Work. Grow.
  </p>

  <p style="margin-top:15px;font-size:14px">
    © 2026 LetsStudy Pro. All rights reserved.
  </p>

</footer>


<script>

/* SCROLL ANIMATION */

const sections =
document.querySelectorAll("section");

const observer =
new IntersectionObserver((entries)=>{

  entries.forEach(entry=>{

    if(entry.isIntersecting){

      entry.target.classList.add("show");

    }else{

      entry.target.classList.remove("show");

    }

  });

},{
  threshold:.15
});

sections.forEach(section=>{
  observer.observe(section);
});


/* SEARCH */

function searchPage(){

  const input =
    document.querySelector(".search input");

  const value =
    input.value.trim();

  if(value){

    window.location.href =
      "search.html?q=" +
      encodeURIComponent(value);

  }else{

    window.location.href =
      "search.html";

  }

}

</script>

</body>
</html>