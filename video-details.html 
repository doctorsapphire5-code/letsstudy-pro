<script type="module">

import { initializeApp } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";
import { getFirestore, doc, getDoc, collection, query, where, limit, getDocs } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";

const firebaseConfig = {
  apiKey: "AIzaSyBcOYDfAVKXbkljsyRgI_0rjodBn678tCc",
  authDomain: "let-s-study-pro-course.firebaseapp.com",
  databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
  projectId: "let-s-study-pro-course",
  storageBucket: "let-s-study-pro-course.firebasestorage.app",
  messagingSenderId: "474928293390",
  appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
  measurementId: "G-85B7V5H5J0"
};
const db = getFirestore(initializeApp(firebaseConfig));

const $ = id => document.getElementById(id);
const FALLBACK_IMG = "data:image/svg+xml;utf8," + encodeURIComponent(
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 720"><rect width="1280" height="720" fill="#dbeafe"/>' +
  '<text x="640" y="390" font-family="Arial" font-size="72" font-weight="700" fill="#2563eb" text-anchor="middle">LetsStudy Pro</text></svg>');

$("year").textContent = new Date().getFullYear();

const videoId = new URLSearchParams(location.search).get("id");

/* ---------- helpers ---------- */
function first(obj, keys, fallback = ""){
  for (const k of keys){
    const v = obj?.[k];
    if (v !== undefined && v !== null && String(v).trim() !== "") return v;
  }
  return fallback;
}

const priceOf = d => { const n = Number(first(d, ["price","amount","cost","videoPrice"], 0)); return Number.isFinite(n) ? n : 0; };

function money(v){
  if (!v || v <= 0) return "Free";
  return new Intl.NumberFormat(undefined, { style: "currency", currency: "TZS", maximumFractionDigits: 0 }).format(v);
}

function isPlan(d){
  const a = String(first(d, ["access","accessType","membership","plan"], "")).toLowerCase().trim();
  if (a === "free") return false;
  if (["plan","paid","premium","pro","subscription","member","members"].includes(a)) return true;
  if (d.isPaid === true || d.premium === true) return true;
  return priceOf(d) > 0;
}

const httpUrl = u => /^https?:\/\//i.test(String(u || "")) ? String(u) : "";

function setMeta(sel, attr, value){
  const m = document.querySelector(sel);
  if (m) m.setAttribute(attr, value);
}

function showError(title, text){
  $("loading").hidden = true;
  $("videoPage").hidden = true;
  $("errorTitle").textContent = title;
  $("errorText").textContent = text;
  $("error").hidden = false;
}

/* ---------- load ---------- */
async function loadVideo(){
  if (!videoId) return showError("Video not found", "Please select a video first.");

  try{
    const snap = await getDoc(doc(db, "videos", videoId));
    if (!snap.exists()) return showError("Video not found", "This video could not be found. It may have been removed.");

    const d = snap.data();

    const name = String(first(d, ["title","name","videoTitle","videoName"], "Untitled Video"));
    const desc = String(first(d, ["description","summary","shortDescription","overview","content"], "Educational video from LetsStudy Pro."));
    const cat  = String(first(d, ["category","subject","field","topic"], "Educational Video"));
    const img  = httpUrl(first(d, ["thumbnail","thumbnailUrl","image","imageUrl","poster","posterUrl"])) || FALLBACK_IMG;

    const info = {
      duration:   first(d, ["duration","length","videoDuration"]),
      level:      first(d, ["level","class","form","grade"]),
      instructor: first(d, ["instructor","teacher","author","creator"]),
      language:   first(d, ["language","lang"])
    };

    /* content */
    document.title = `${name} · LetsStudy Pro`;
    const shortDesc = desc.replace(/\s+/g, " ").slice(0, 160);
    setMeta('meta[name="description"]', "content", shortDesc);
    setMeta('meta[property="og:title"]', "content", document.title);
    setMeta('meta[property="og:description"]', "content", shortDesc);
    if (img !== FALLBACK_IMG){
      setMeta('meta[property="og:image"]', "content", img);
      setMeta('meta[name="twitter:image"]', "content", img);
    }

    const thumb = $("thumbnail");
    thumb.src = img;
    thumb.alt = name;
    thumb.addEventListener("error", () => { thumb.src = FALLBACK_IMG; }, { once: true });

    $("title").textContent = name;
    $("description").textContent = desc;
    $("category").textContent = cat;

    let shown = 0;
    document.querySelectorAll("#meta .meta-item").forEach(el => {
      const v = info[el.dataset.k];
      el.hidden = !v;
      if (v){ el.querySelector(".meta-value").textContent = v; shown++; }
    });
    $("meta").hidden = !shown;

    /* structured data for search engines */
    const created = d.createdAt?.toDate ? d.createdAt.toDate() : null;
    const ld = { "@context": "https://schema.org", "@type": "VideoObject", name, description: shortDesc, thumbnailUrl: img === FALLBACK_IMG ? undefined : img };
    if (created) ld.uploadDate = created.toISOString();
    const s = document.createElement("script");
    s.type = "application/ld+json";
    s.textContent = JSON.stringify(ld);
    document.head.appendChild(s);

    /* access */
    const badge = $("accessBadge"), price = $("price"), btn = $("actionBtn");
    if (isPlan(d)){
      badge.textContent = "PLAN";
      badge.className = "access-badge plan";
      price.textContent = money(priceOf(d));
      price.className = "price plan-price";

      if (inCart(videoId)){
        btn.textContent = "In your cart · View cart";
        btn.className = "action cart-btn";
        btn.onclick = () => { location.href = `video-cart.html?id=${encodeURIComponent(videoId)}`; };
      }else{
        btn.textContent = "Add to Video Cart";
        btn.className = "action cart-btn";
        btn.onclick = () => addToCart(videoId);
      }
    }else{
      badge.textContent = "FREE";
      badge.className = "access-badge free";
      price.textContent = "Free";
      price.className = "price free-price";
      btn.textContent = "Watch Free";
      btn.className = "action watch-btn";
      btn.onclick = () => { location.href = `video-watch.html?id=${encodeURIComponent(videoId)}`; };
    }

    $("shareBtn").onclick = async () => {
      const url = location.href;
      try{
        if (navigator.share){ await navigator.share({ title: document.title, text: shortDesc, url }); return; }
        await navigator.clipboard.writeText(url);
        say("Link copied");
      }catch(err){
        if (err?.name !== "AbortError") say("Couldn't share this link");
      }
    };

    $("loading").hidden = true;
    $("videoPage").hidden = false;

    /* play button triggers the same action as the main button */
    const play = $("playBtn");
    play.setAttribute("aria-label", isPlan(d) ? "Unlock video" : "Watch video");
    play.onclick = () => btn.click();

    if (info.duration){
      $("durBadge").textContent = info.duration;
      $("durBadge").hidden = false;
    }

    const tags = (Array.isArray(d.tags) ? d.tags : String(d.tags || "").split(","))
      .map(t => String(t).trim().replace(/^#/, "")).filter(Boolean).slice(0, 8);
    if (tags.length){
      const box = $("tags");
      box.innerHTML = "";
      tags.forEach(t => { const s = document.createElement("span"); s.textContent = "#" + t; box.appendChild(s); });
      box.hidden = false;
    }

    if (d.category) loadRelated(String(d.category));

  }catch(err){
    console.error(err);
    showError("Unable to load this video", "Check your connection and try again.");
  }
}

/* ---------- related videos (same category) ---------- */
async function loadRelated(category){
  try{
    const snap = await getDocs(query(collection(db, "videos"), where("category", "==", category), limit(8)));
    const rows = [];
    snap.forEach(x => {
      const v = x.data() || {};
      const st = String(v.status || "").toLowerCase();
      if (x.id === videoId || v.published === false || ["draft","archived","hidden","private","pending"].includes(st)) return;
      rows.push({ id: x.id, v });
    });
    if (!rows.length) return;

    const grid = $("relGrid");
    grid.innerHTML = "";
    rows.slice(0, 6).forEach(({ id, v }) => {
      const a = document.createElement("a");
      a.className = "rel";
      a.href = "video-details.html?id=" + encodeURIComponent(id);

      const img = document.createElement("img");
      img.loading = "lazy";
      img.alt = "";
      img.src = httpUrl(first(v, ["thumbnail","thumbnailUrl","image","imageUrl","poster","posterUrl"])) || FALLBACK_IMG;
      img.addEventListener("error", () => { img.src = FALLBACK_IMG; }, { once: true });

      const box = document.createElement("div");
      const b = document.createElement("b");
      b.textContent = String(first(v, ["title","name","videoTitle","videoName"], "Untitled Video"));
      const sm = document.createElement("small");
      sm.textContent = [first(v, ["duration","length","videoDuration"]), isPlan(v) ? "Plan" : "Free"].filter(Boolean).join(" · ");
      box.append(b, sm);

      a.append(img, box);
      grid.appendChild(a);
    });
    $("related").hidden = false;
  }catch(err){
    console.warn("Related videos unavailable:", err);
  }
}

/* ---------- video cart ---------- */
function getCart(){
  try{
    const raw = JSON.parse(localStorage.getItem("videoCart") || "[]");
    if (!Array.isArray(raw)) return [];
    return raw.map(i => typeof i === "string" ? i : (i?.id || i?.videoId || null)).filter(Boolean);
  }catch{ return []; }
}
const inCart = id => getCart().includes(id);

function say(text){ $("cartMessage").textContent = text; }

function addToCart(id){
  const cart = getCart();
  if (!cart.includes(id)){
    cart.push(id);
    try{ localStorage.setItem("videoCart", JSON.stringify([...new Set(cart)])); }
    catch{ return say("Couldn't save to your cart. Check your browser storage settings."); }
    say("Video added to your cart.");
  }else{
    say("This video is already in your cart.");
  }
  setTimeout(() => { location.href = `video-cart.html?id=${encodeURIComponent(id)}`; }, 700);
}

