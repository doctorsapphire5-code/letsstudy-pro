    min-width: 130px;
    padding: 12px 16px;
    font-size: 14px;
  }

}

/* ACCESSIBILITY */

@media (prefers-reduced-motion: reduce) {

  .lsp-related-trending-links,
  .lsp-rtl-button {
    animation: none !important;
    transition: none !important;
  }

  .lsp-rtl-button:hover {
    transform: none;
  }

}

