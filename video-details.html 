  animation: lspFadeIn 0.8s ease both;
}

.lsp-rtl-inner {
  max-width: 1200px;
  margin: auto;

  display: flex;
  justify-content: center;
  align-items: center;

  gap: 14px;
  flex-wrap: wrap;
}

/* BUTTON */

.lsp-rtl-button {
  position: relative;
  overflow: hidden;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-width: 155px;
  padding: 13px 25px;

  border-radius: 999px;

  text-decoration: none;

  font-family: inherit;
  font-size: 15px;
  font-weight: 800;

  cursor: pointer;

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    background 0.3s ease;

  animation: lspButtonIn 0.7s ease both;
}

/* SHINE */

.lsp-rtl-button::before {
  content: "";

  position: absolute;

  top: 0;
  left: -130%;

  width: 70%;
  height: 100%;

  background: linear-gradient(
    110deg,
    transparent,
    rgba(255,255,255,0.4),
    transparent
  );

  transform: skewX(-20deg);

  transition: left 0.7s ease;
}

.lsp-rtl-button:hover::before {
  left: 140%;
}

/* HOVER */

.lsp-rtl-button:hover {
  transform:
    translateY(-5px)
    scale(1.03);

  box-shadow:
    0 12px 30px rgba(0,0,0,0.16);
}

/* CLICK */

.lsp-rtl-button:active {
  transform:
    translateY(-1px)
    scale(0.96);
}

/* RELATED */

.lsp-related-button {
  background: #111;
  color: #fff;

  animation-delay: 0.1s;
}

.lsp-related-button:hover {
  background: #222;
}

/* TRENDING */

.lsp-trending-button {
  background: #f3f3f3;
  color: #111;

  border: 1px solid #ddd;

  animation-delay: 0.25s;
}

.lsp-trending-button:hover {
  background: #fff;
}

/* TEXT */

.lsp-rtl-button span {
  position: relative;
  z-index: 2;

  transition:
    letter-spacing 0.3s ease;
}

.lsp-rtl-button:hover span {
  letter-spacing: 0.4px;
}

/* PAGE ANIMATION */

@keyframes lspFadeIn {

  from {
    opacity: 0;
    transform: translateY(25px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }

}

/* BUTTON ANIMATION */

@keyframes lspButtonIn {

  from {
    opacity: 0;
    transform:
      translateY(20px)
      scale(0.9);
  }

  to {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }

}

/* MOBILE */

@media (max-width: 600px) {

  .lsp-related-trending-links {
    margin: 25px 0;
    padding: 0 12px;
