.lsp-rtl-inner{max-width:1200px;margin:35px auto 10px;padding:0 15px;display:flex;justify-content:center;gap:14px;flex-wrap:wrap}
.lsp-rtl-button{position:relative;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;min-width:155px;padding:13px 25px;border-radius:999px;text-decoration:none;font-size:15px;font-weight:800;transition:transform .3s,box-shadow .3s,background .3s}
.lsp-rtl-button:hover{transform:translateY(-4px);box-shadow:0 12px 30px rgba(0,0,0,.16)}
.lsp-rtl-button:active{transform:scale(.96)}
.lsp-related-button{background:#111;color:#fff}
.lsp-trending-button{background:#f3f3f3;color:#111;border:1px solid #ddd}

.whatsapp-channel-btn{display:block;width:fit-content;margin:18px auto;padding:12px 22px;border-radius:999px;background:#25d366;color:#fff;font-weight:800;text-decoration:none}
