<style>
:root{--blue:#2563eb;--blue-d:#1d4ed8;--ink:#172033;--mute:#64748b;--line:#e5e7eb;--bg:#f5f7fb}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6;padding-bottom:85px;-webkit-font-smoothing:antialiased}
a{color:inherit}
[hidden]{display:none!important}
:focus-visible{outline:3px solid var(--blue);outline-offset:2px}

header{background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:100}
.nav{max-width:1200px;margin:auto;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{font-size:21px;font-weight:900;color:var(--blue);text-decoration:none;letter-spacing:-.02em}
.back{text-decoration:none;color:#475569;font-weight:700;padding:8px 14px;border-radius:999px}
.back:hover{background:#eff6ff;color:var(--blue-d)}

main{max-width:1200px;margin:32px auto;padding:0 20px}
.video-page{display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,1fr);gap:30px;align-items:start}
.card{background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 8px 30px rgba(15,23,42,.07)}
.hero-image{width:100%;aspect-ratio:16/9;object-fit:cover;display:block;background:#e2e8f0}
.content{padding:28px}
.category{display:inline-block;background:#eff6ff;color:var(--blue);padding:6px 12px;border-radius:999px;font-size:13px;font-weight:700;margin-bottom:14px}
h1{font-size:clamp(28px,4vw,44px);line-height:1.15;letter-spacing:-.02em;margin-bottom:14px;overflow-wrap:anywhere}
.description{color:var(--mute);font-size:16px;white-space:pre-line;overflow-wrap:anywhere}
.meta{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:25px}
.meta-item{background:#f8fafc;padding:15px;border-radius:12px}
.meta-label{display:block;font-size:12px;color:var(--mute);margin-bottom:4px}
.meta-value{font-weight:700;overflow-wrap:anywhere}
.features{margin-top:25px;border-top:1px solid var(--line);padding-top:20px}
.features h3{margin-bottom:10px}
.features p{color:var(--mute);margin:6px 0}

.side{padding:25px;position:sticky;top:90px}
.access-badge{display:inline-block;padding:7px 13px;border-radius:999px;font-size:13px;font-weight:800;margin-bottom:12px}
.free{background:#dcfce7;color:#15803d}
.plan{background:#fef3c7;color:#b45309}
.price{font-size:34px;font-weight:900;margin:6px 0 20px}
.price.free-price{color:#16a34a}
.price.plan-price{color:var(--blue)}
.action{display:block;width:100%;border:0;border-radius:12px;padding:15px 18px;font:inherit;font-size:16px;font-weight:800;cursor:pointer;transition:background .2s;text-align:center;text-decoration:none}
.watch-btn{background:#16a34a;color:#fff}.watch-btn:hover{background:#15803d}
.cart-btn{background:var(--blue);color:#fff}.cart-btn:hover{background:var(--blue-d)}
.share-btn{margin-top:10px;background:#f1f5f9;color:#334155;border:1px solid var(--line)}
.share-btn:hover{background:#e2e8f0}
.cart-message{margin-top:12px;color:#16a34a;font-size:14px;text-align:center;min-height:20px}

.state{background:#fff;padding:40px 20px;border-radius:18px;text-align:center;box-shadow:0 8px 30px rgba(15,23,42,.06)}
.state h2{margin-bottom:6px}
.state p{color:var(--mute);margin-bottom:16px}
.state.error h2{color:#dc2626}
.state .action{display:inline-block;width:auto;padding:12px 24px;background:var(--blue);color:#fff}

.sk i{display:block;border-radius:8px;background:linear-gradient(90deg,#eceff4 25%,#f6f8fb 37%,#eceff4 63%);background-size:400% 100%;animation:sh 1.3s ease infinite}
@keyframes sh{0%{background-position:100% 50%}100%{background-position:0 50%}}

.thumb-wrap{position:relative}
.play{position:absolute;inset:0;margin:auto;width:76px;height:76px;border:0;border-radius:50%;background:rgba(37,99,235,.92);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 10px 30px rgba(0,0,0,.3);transition:transform .2s,background .2s}
.play:hover{transform:scale(1.08);background:var(--blue-d)}
.play svg{width:34px;height:34px;margin-left:4px}
.dur{position:absolute;right:12px;bottom:12px;background:rgba(0,0,0,.78);color:#fff;font-size:13px;font-weight:700;padding:4px 9px;border-radius:7px}
.tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
.tags span{background:#f1f5f9;color:#475569;font-size:12px;font-weight:700;padding:5px 10px;border-radius:999px}
.related{margin:34px 0 0}
.related h2{font-size:22px;margin-bottom:14px;letter-spacing:-.01em}
.rel-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px}
.rel{display:block;background:#fff;border-radius:16px;overflow:hidden;text-decoration:none;box-shadow:0 4px 18px rgba(15,23,42,.06);transition:transform .2s,box-shadow .2s}
.rel:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(37,99,235,.14)}
.rel img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block;background:#e2e8f0}
.rel div{padding:12px 14px}
