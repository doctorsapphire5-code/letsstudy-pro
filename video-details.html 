.lsp-quick-buttons{max-width:1200px;margin:20px auto;padding:0 20px;display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
.lsp-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:11px 17px;border-radius:10px;background:#fff;color:#111827;border:1px solid var(--line);text-decoration:none;font-size:14px;font-weight:600;box-shadow:0 2px 8px rgba(0,0,0,.06);transition:transform .2s,box-shadow .2s}
.lsp-btn:hover{transform:translateY(-2px);box-shadow:0 5px 15px rgba(0,0,0,.12)}

.lsp-bottom-bar{position:fixed;left:0;right:0;bottom:0;z-index:99999;display:flex;gap:10px;padding:10px 12px;background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-top:1px solid #ddd;box-shadow:0 -5px 20px rgba(0,0,0,.12)}
.lsp-bottom-item{flex:1;min-height:52px;display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;border-radius:12px;text-decoration:none;color:#fff;background:#1565c0;font-size:14px;text-align:center}
.lsp-bottom-item:last-child{background:#111827}
.lsp-bottom-item span{font-size:19px}

footer{margin-top:40px;padding:30px 20px;text-align:center;color:var(--mute);font-size:14px}

@media(max-width:800px){
  .video-page{grid-template-columns:1fr}
  .side{position:static}
  .meta{grid-template-columns:1fr}
  main{margin-top:20px}
  .content{padding:22px}
  .lsp-quick-buttons{display:grid;grid-template-columns:repeat(2,1fr)}
}
@media(max-width:500px){.lsp-bottom-item{font-size:12px}.lsp-bottom-item span{font-size:17px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
