  import {
    getFirestore,
    doc,
    getDoc
  } from "https://www.gstatic.com/firebasejs/10.12.5/firebase-firestore.js";


  /* ================================
     FIREBASE
  ================================= */

  const firebaseConfig = {
    apiKey: "AIzaSyBcOYDfAVK5XbkljsyRgI_0rj0odBn678tCc",
    authDomain: "let-s-study-pro-course.firebaseapp.com",
    databaseURL: "https://let-s-study-pro-course-default-rtdb.firebaseio.com",
    projectId: "let-s-study-pro-course",
    storageBucket: "let-s-study-pro-course.firebasestorage.app",
    messagingSenderId: "474928293390",
    appId: "1:474928293390:web:2bcc2aebf2351c12a9fe5f",
    measurementId: "G-85B7V5H5J0"
  };

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);


  /* ================================
     DOM
  ================================= */

  const loading = document.getElementById("loading");
  const errorBox = document.getElementById("error");
  const videoPage = document.getElementById("videoPage");

  const thumbnail = document.getElementById("thumbnail");
  const title = document.getElementById("title");
  const description = document.getElementById("description");
  const category = document.getElementById("category");

  const duration = document.getElementById("duration");
  const level = document.getElementById("level");
  const instructor = document.getElementById("instructor");
  const language = document.getElementById("language");

  const accessBadge = document.getElementById("accessBadge");
  const price = document.getElementById("price");
  const actionBtn = document.getElementById("actionBtn");
  const cartMessage = document.getElementById("cartMessage");

  document.getElementById("year").textContent =
    new Date().getFullYear();


  /* ================================
     HELPERS
  ================================= */

  function firstValue(obj, keys, fallback = "") {

    for (const key of keys) {

      const value = obj?.[key];

      if (
        value !== undefined &&
        value !== null &&
        String(value).trim() !== ""
      ) {
        return value;
      }

    }

    return fallback;
  }


  function escapeHtml(value) {

    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }


  function getPrice(data) {

    const value = firstValue(
      data,
      [
        "price",
        "amount",
        "cost",
        "videoPrice"
      ],
      0
    );

    const number = Number(value);

    return Number.isFinite(number)
      ? number
      : 0;
  }


  function formatPrice(value) {

    if (!value || value <= 0) {
      return "Free";
    }

    return new Intl.NumberFormat(
      undefined,
      {
        style: "currency",
        currency: "TZS",
        maximumFractionDigits: 0
      }
    ).format(value);
  }


  function isPlanVideo(data) {

    const access = String(
      firstValue(
        data,
        [
          "access",
          "accessType",
          "membership",
          "plan"
        ],
        ""
      )
    ).toLowerCase().trim();

    if (
      access === "plan" ||
      access === "premium" ||
      access === "paid"
    ) {
      return true;
    }

    if (
      data?.isPremium === true ||
      data?.premium === true ||
      data?.paid === true
    ) {
      return true;
    }

    return false;
  }


  /* ================================
     GET VIDEO ID
  ================================= */

  const params = new URLSearchParams(
    window.location.search
  );

  const videoId = params.get("id");


  /* ================================
     ERROR
  ================================= */

  function showError(message) {

    loading.style.display = "none";
    videoPage.style.display = "none";

    errorBox.textContent = message;
    errorBox.style.display = "block";
  }


  /* ================================
     LOAD VIDEO
  ================================= */

  async function loadVideo() {

    if (!videoId) {

      showError(
        "Video not found. Please select a video first."
      );

      return;
    }

    try {

      const snap = await getDoc(
        doc(db, "videos", videoId)
      );

      if (!snap.exists()) {

        showError(
          "This video could not be found."
        );

        return;
      }

      const data = snap.data();

      const videoTitle = firstValue(
        data,
        [
          "title",
          "name",
          "videoTitle",
          "videoName"
        ],
        "Untitled Video"
      );

      const videoDescription = firstValue(
        data,
        [
          "description",
          "summary",
          "shortDescription",
          "overview",
          "content"
        ],
        "Educational video from LetsStudy Pro."
      );

      const videoCategory = firstValue(
        data,
        [
          "category",
          "subject",
          "field",
          "topic"
        ],
        "Educational Video"
      );

      const image = firstValue(
        data,
        [
          "thumbnail",
          "thumbnailUrl",
          "image",
          "imageUrl",
          "poster",
          "posterUrl"
        ],
        "https://via.placeholder.com/1280x720?text=LetsStudy+Pro"
      );

      const videoDuration = firstValue(
        data,
        [
          "duration",
          "length",
          "videoDuration"
        ],
        "—"
      );

      const videoLevel = firstValue(
        data,
        [
          "level",
          "class",
          "form",
          "grade"
        ],
        "—"
      );

      const videoInstructor = firstValue(
        data,
        [
          "instructor",
          "teacher",
          "author",
          "creator"
        ],
        "—"
      );

      const videoLanguage = firstValue(
        data,
        [
          "language",
          "lang"
        ],
        "—"
      );

      const planVideo = isPlanVideo(data);
      const videoPrice = getPrice(data);


      /* ================================
         DISPLAY
      ================================= */

      document.title =
        `${videoTitle} · LetsStudy Pro`;

      thumbnail.src = image;
      thumbnail.alt =
        `${videoTitle} · LetsStudy Pro`;

      title.textContent = videoTitle;

      description.textContent =
        videoDescription;

      category.textContent =
        videoCategory;

      duration.textContent =
        videoDuration;

      level.textContent =
        videoLevel;

      instructor.textContent =
        videoInstructor;

      language.textContent =
        videoLanguage;


      /* ================================
         ACCESS
      ================================= */

      if (planVideo) {

        accessBadge.textContent = "PLAN";
        accessBadge.className =
          "access-badge plan";

        price.textContent =
          formatPrice(videoPrice);

        price.className =
          "price plan-price";

        actionBtn.textContent =
          "Add to Video Cart";

        actionBtn.className =
          "action cart-btn";

        actionBtn.onclick = () => {

          addToVideoCart(videoId);

        };

      } else {

        accessBadge.textContent = "FREE";
        accessBadge.className =
          "access-badge free";

        price.textContent = "Free";

        price.className =
          "price free-price";

        actionBtn.textContent =
          "Watch Free";

        actionBtn.className =
          "action watch-btn";

        actionBtn.onclick = () => {

          window.location.href =
            `video-watch.html?id=${encodeURIComponent(videoId)}`;

        };

      }


      loading.style.display = "none";
      videoPage.style.display = "grid";

    } catch (error) {

      console.error(error);

      showError(
        "Unable to load this video. Please try again."
      );

    }

  }


  /* ================================
     VIDEO CART
  ================================= */

  function getVideoCart() {

    try {

      const cart =
        JSON.parse(
          localStorage.getItem("videoCart") || "[]"
        );

      if (!Array.isArray(cart)) {
        return [];
      }

      return cart
        .map(item => {

          if (typeof item === "string") {
            return item;
          }

          return item?.id ||
                 item?.videoId ||
                 null;

        })
        .filter(Boolean);

    } catch {

      return [];

    }

  }


  function saveVideoCart(cart) {

    const unique =
      [...new Set(cart)];

    localStorage.setItem(
      "videoCart",
      JSON.stringify(unique)
    );

  }


  function addToVideoCart(id) {

    const cart =
      getVideoCart();

    if (!cart.includes(id)) {

      cart.push(id);

      saveVideoCart(cart);

      cartMessage.textContent =
        "Video added to your cart.";

    } else {

      cartMessage.textContent =
        "This video is already in your cart.";

    }

    cartMessage.style.display =
      "block";


    setTimeout(() => {

      window.location.href =
        "video-cart.html";

    }, 700);

  }


  /* ================================
     START
  ================================= */

  loadVideo();

</script>

